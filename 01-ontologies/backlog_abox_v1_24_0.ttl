fw:CR_OEPackageConsolidation a backlog:ClosureReport ;
    backlog:closesForMission fw:Mission_OEPackageConsolidation ;
    backlog:reportGeneratedAt "2026-10-06T21:05:00Z"^^xsd:dateTime ;
    backlog:closureCommittedAt "backlog-roadmap-framework-v1.351.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasClosureSummary "Done: the package ships as one vocabulary, one data file and one shapes file, each with one ontology header (OE structure checker: 3 files, 0 violations, and OE's debt register holds no line for it). Every former subject is a module record; the archive is a folder of its own with one data file and one shapes file; the test drive and the strategy exercise register are fixtures with declared polarity; Lineage 17 was set down through the archiving ceremony; ten tools follow the new layout. The split proof over the whole lineage read 0 statements lost or changed, 176 added, all declared. Delivered by seven stories in releases v1.346.0 to v1.350.0. Cancelled: nothing in this lineage; its predecessor's three unfinished stories were carried into it (see that lineage's own report). Not done well, found after the work and carried to the next lineage: (1) the public copy cuts seven modules by a list of IRIs in the deriver, and a module that is missing is skipped silently, against what the changelog said; (2) the archive-reconcile tool derives folders by string substitution and is broken by the archive folder, which the story that repointed tools did not catch; (3) the archive tool did not mark the archived copy of a lineage as archived, leaving three warnings; (4) the archive tool accepted an abandoned mission without a closure report, which the owner has ruled wrong; (5) objective OC-O4 counted lines in another party's register, which only that party could change, so its story could not honestly close for hours after its own criterion was met." ;
    backlog:reportsOnObjective fw:Obj_OC_MissionMet , fw:Obj_OC_FilesDone , fw:Obj_OC_ToolsDone , fw:Obj_OC_EnforcementDone , fw:Obj_OC_Contained , fw:Obj_OC_NoStatementChange , fw:Obj_OC_NoRetroJudging , fw:Obj_OC_NoOtherPackages , fw:Obj_OC_NoModuleMembership .

# v9.115.0: Lineage 19, Mission stage (first of five releases). Lineage 18 is closed above as achieved, with a closure report that names
# five defects it leaves. This is a new lineage (G72), not a revival: it pursues those defects. One release per stage from here.
fw:L_RecordsTellTruth a backlog:Lineage ; rdfs:label "Lineage 19: Records That Tell the Truth"@en ;
    backlog:lineageOrdinal 19 ;
    backlog:lineageArchived false ;
    backlog:lineageForMission fw:Mission_RecordsTellTruth ;
    backlog:hasLineageStatus backlog:LS_Opened ;
    backlog:hasLineageDepthLevel backlog:Depth_StoryDirect ;
    backlog:hasLineageArtifactDomain backlog:Domain_Infrastructure ;
    backlog:memberOfContainer fw:Register .

fw:Mission_RecordsTellTruth a backlog:Mission ; rdfs:label "Mission: Records That Tell the Truth"@en ;
    backlog:hasMissionStatement "Everything this package records about ended work and everything it publishes says what is true, and a tool that cannot find what it was told to handle stops and says so instead of carrying on. A mission that ends, achieved or abandoned, has a closure report that proves what was done and names every item it delivered and every item it cancelled; the record of a retired lineage is marked archived; each module of the data file declares who may read it, and the public copy is cut by that declaration and refuses to build when a declared module is missing; the archive is judged only by the archive's own rules, by tools that read the archive folder; and what the package learned about designing an objective is recorded as a finding. No earlier statement is reworded: earlier records change only by additions and by the three archive markers, each declared in advance." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-10-06 23:51 and 2026-10-07 10:06: 'Abandoned lineage can have it closure report, cancellation should be reported. Closure report proves the completion of the work and provides details.' 'Can we make corrections and fill missing concepts to remedy the issues? What do we need to deal with the live rules over archive application problems? Why the story closure is dependent on an external object? Is this a well-designed story?' 'OK, open the Lineage 19 to fix the defects.' The defects are the five named in Lineage 18's closure report." ;
    backlog:hasMissionOutcome backlog:Out_InFlight ;
    backlog:producedByStage fw:Out_Mission_RecordsTellTruth ;
    backlog:decidedBy backlog:Owner .

fw:Out_Mission_RecordsTellTruth a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_RecordsTellTruth ;
    backlog:hasStateDigest "f1f072db0eb9e360db526f9aa2045b44510bf3d6535ffc576741289127e64668" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.352.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 19. Tag deterministic: VERSION.txt set before publishing. Stage 1 of 5, one release each." .

# v9.116.0: Lineage 19, Scope stage (second of five releases). Scope text, areas, deliverables and exclusions are written here, before any
# goal, objective or work item. Measured 2026-10-07 by reading the live and archive data files and the tools.
fw:Scope_RecordsTellTruth a backlog:ScopeStatement ; rdfs:label "Scope: Records That Tell the Truth"@en ;
    backlog:hasScopeStatementText "Make a closure report required for every ended mission, abandoned as well as achieved, and let it name the items delivered and the items cancelled; write the reports that are missing (Lineage 17's, abandoned, and the first-built lineage's, achieved) and add the cancelled and delivered items to the existing ones; mark the three archived records that are not marked archived, through the confirmation step built for it, which is repaired and pointed at the archive folder; add a module audience that each module declares and make the public copy follow it and stop with an error when a declared module cannot be found; give the archive's own shapes the three rules the live rules now carry, and make no tool judge the archive by the live rules or find its folders by string substitution; record the lesson about designing an objective as a finding; and prove nothing earlier was reworded and the public copy is unchanged apart from the declared edits." ;
    backlog:scopeForMission fw:Mission_RecordsTellTruth ;
    backlog:producedByStage fw:Out_Scope_RecordsTellTruth ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_DC_AbandonedReport , fw:Del_DC_CancelledReported , fw:Del_DC_ArchiveMarked , fw:Del_DC_AudienceDeclared , fw:Del_DC_ArchiveOwnRules , fw:Del_DC_ObjectiveLesson , fw:Del_DC_NothingLostAgain ;
    backlog:coversArea fw:Area_DC_Reports , fw:Area_DC_Marking , fw:Area_DC_Audience , fw:Area_DC_ArchiveRules , fw:Area_DC_Lesson , fw:Area_DC_Proof ;
    backlog:hasScopeExclusion fw:Ex_DC_StatementChange , fw:Ex_DC_RetroJudging , fw:Ex_DC_OtherPackages , fw:Ex_DC_PublicContent ;
    backlog:belongsToLineage fw:L_RecordsTellTruth .

