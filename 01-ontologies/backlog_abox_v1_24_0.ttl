    backlog:hasState backlog:Done ;
    backlog:hasDeploymentDate "2026-10-06T20:30:00Z"^^xsd:dateTime ;
    backlog:belongsToLineage fw:L_OEPackageConsolidation ;
    backlog:deploysFrom fw:It_OC_1 ; backlog:deploysItem fw:ST_OC_Fixtures , fw:ST_OC_LiveTriad , fw:ST_OC_ArchiveFolder , fw:ST_OC_NothingLost , fw:ST_OC_ToolsRepointed , fw:ST_OC_Ceremony , fw:ST_OC_DebtCleared ;
    backlog:decidedBy backlog:Owner ; backlog:hasSelectionBasis backlog:Sel_Committed .
