    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 03-tooling/make_public_distribution, 03-tooling/backlog_package_fold" ;
    backlog:belongsToLineage fw:L_RecordsTellTruth .
