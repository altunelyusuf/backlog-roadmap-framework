fw:DGovMit1 a backlog:DoDCriterion ; rdfs:label "DGovMit1 -- the shape fires on a real, planted negative case"@en ;
    backlog:hasCriterionText "A real, planted negative fixture -- an objective whose latest observation reaches target while every one of its metricMovableBy items stays Proposed -- is flagged." ;
    backlog:hasCheckQuery "backlog_validate against a fixture built for exactly this case." ;
    backlog:hasExpectedResult "a real violation on the objective" ;
    backlog:hasCriterionStatus backlog:Holds .
fw:DGovMit2 a backlog:DoDCriterion ; rdfs:label "DGovMit2 -- the shape stays silent on a real, planted positive case"@en ;
    backlog:hasCriterionText "A real, planted positive fixture -- the same shape of objective, but at least one metricMovableBy item has genuinely left Proposed -- passes cleanly." ;
    backlog:hasCheckQuery "backlog_validate against a fixture built for exactly this case." ;
    backlog:hasExpectedResult "no violation on the objective" ;
    backlog:hasCriterionStatus backlog:Holds .
