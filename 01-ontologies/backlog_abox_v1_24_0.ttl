#################################################################
#  v9.79.0 (2026-09-10, brsf-session) -- TWO ARCHIVE MECHANISMS, and
#  a defect one of them found on its first run.
#
#  1. The 13 LineageArchiveEntry records named archive files v1_0_0
#     and v1_1_0, retired when v1_2_0 was written: every pointer into
#     the archive was broken. Found by backlog_archive_integrity_v1_0_0
#     in under a second; corrected above.
#  2. ArchiveConformanceRecord: the settled archive's conformance as a
#     recorded VALUE (owner's design, test-driven). SEEDED, not
#     re-validated: measured 2026-09-10, validating the archive under
#     today's shapes reports 193 violations that come from shapes
#     shipped AFTER those lineages closed -- GoalTriangleShape arrived
#     from SCAMPS this same day and fires on chains gated clean days
#     earlier. Judging retired work under current rules is the
#     retroactive enforcement this framework refuses (G89, G91). The
#     ground of the value is the release record: each lineage was
#     gated clean, under the shapes of its own day, in the release
#     that closed it. Every lineage that retires from now on is
#     validated for real before it joins the value.
#################################################################
fw:ArchiveConformance_120 a backlog:ArchiveConformanceRecord ;
    backlog:recordForArchiveFile "01-ontologies/backlog_framework_archive_abox_v1_5_0.ttl" ;
    backlog:hasArchiveDigest "a732a801947be84c4a3e27146e242d60049b7f3b2391fa752ccd346f306583c5" ;
    backlog:clearedUnderShapes "seeded from the release record; each lineage was gated under the shapes of its own day" ;
    backlog:clearedAt "2026-09-10T15:00:00Z"^^xsd:dateTime ;
    backlog:includesRetiredLineage "http://example.org/backlog-framework-register#L7_Code" ,
        "http://example.org/backlog-framework-register#L7_Exec" ,
        "http://example.org/backlog-framework-register#L7_Export" ,
        "http://example.org/backlog-framework-register#L7_Gov" ,
        "http://example.org/backlog-framework-register#L7_Prose" ,
        "http://example.org/backlog-framework-register#L_Build" ,
        "http://example.org/backlog-framework-register#L_ChangeDiscipline" ,
        "http://example.org/backlog-framework-register#L_Dev" ,
        "http://example.org/backlog-framework-register#L_Executable" ,
        "http://example.org/backlog-framework-register#L_OntologyDriven" ,
        "http://example.org/backlog-framework-register#L_Ops" ,
