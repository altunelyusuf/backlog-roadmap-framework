    backlog:areaMeasure "Counted 2026-10-07 by search of 03-tooling: 1 tool (the archive reconcile) judges the archive by the live rules and finds its folders by replacing a folder name in a path; the archive's shapes file holds 2 node shapes." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/archive/ shapes file, 03-tooling/" ;
    backlog:belongsToLineage fw:L_RecordsTellTruth .
