@prefix pkg: <http://example.org/backlog-package#> .
@prefix prof: <http://rdodi.org/profiles#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix quality: <http://example.org/quality#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report: <http://example.org/report#> .
@prefix risk: <http://example.org/risk#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skos2: <http://www.w3.org/2004/02/skos/core#> .
@prefix testing: <http://example.org/testing#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/backlog> a owl:Ontology ;
    rdfs:label "Backlog & Roadmap Semantic Framework (ABox: controlled individuals, reference data and the live register)"@en ;
    owl:versionIRI <http://example.org/backlog/abox/1.24.0> ;
    owl:versionInfo "1.24.0" ;
    owl:priorVersion <http://example.org/backlog/abox/1.23.0> , <http://example.org/backlog/abox/1.22.0> , <http://example.org/backlog/abox/1.21.0> , <http://example.org/backlog/abox/1.20.0> , <http://example.org/backlog/abox/1.19.0> , <http://example.org/backlog/abox/1.17.0> , <http://example.org/backlog/abox/1.16.0> , <http://example.org/backlog/abox/1.15.0> , <http://example.org/backlog/abox/1.14.0> , <http://example.org/backlog/abox/1.13.0> , <http://example.org/backlog/abox/1.12.0> , <http://example.org/backlog/abox/1.11.0> , <http://example.org/backlog/abox/1.10.0> , <http://example.org/backlog/abox/1.9.0> , <http://example.org/backlog/abox/1.8.0> , <http://example.org/backlog-abox/1.7.0> , <http://example.org/backlog-abox/1.6.0> ,
        <http://example.org/backlog-abox/1.2.1> ,
                     <http://example.org/backlog-abox/1.2.0> ,
                     <http://example.org/backlog-abox/1.1.0> ,
                     <http://example.org/backlog-abox/1.0.0> ;
    dcterms:identifier "backlog" ;
    dcterms:created "2026-07-27T00:00:00"^^xsd:dateTime ;
    dcterms:modified "2026-07-27T00:00:00"^^xsd:dateTime ;
    dcterms:creator "Yusuf Altunel" ;
    dcterms:publisher "İstanbul Kültür Üniversitesi, Department of Computer Engineering" ;
    dcterms:rightsHolder "İstanbul Kültür Üniversitesi, Department of Computer Engineering" ;
    dcterms:rights "Copyright (c) 2025-2026 İstanbul Kültür Üniversitesi & Yusuf Altunel. Licensed under CC BY 4.0."@en ;
