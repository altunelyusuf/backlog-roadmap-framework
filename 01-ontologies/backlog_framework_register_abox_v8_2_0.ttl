    backlog:layerClass backlog:ScopeStatement ;
    backlog:layerOrdinal 2 ;
    backlog:layerAbsenceCost "No boundary; the backlog defines what was wanted." .
fw:Layer_ScopeExclusion a backlog:LineageLayer ;
    backlog:layerClass backlog:ScopeExclusion ;
    backlog:layerOrdinal 3 ;
    backlog:layerAbsenceCost "Nothing refused; the boundary admits whatever is proposed." .
fw:Layer_ScopeDeliverable a backlog:LineageLayer ;
    backlog:layerClass backlog:ScopeDeliverable ;
    backlog:layerOrdinal 4 ;
    backlog:layerAbsenceCost "No content; coverage is computed over the work that exists." .
fw:Layer_Goal a backlog:LineageLayer ;
    backlog:layerClass backlog:Goal ;
    backlog:layerOrdinal 5 ;
    backlog:layerAbsenceCost "Nothing derives the objectives; they measure whatever was convenient." .
fw:Layer_Objective a backlog:LineageLayer ;
