    backlog:hasBasisKind backlog:Basis_Judged .
fw:Obj_Grounded backlog:metricMovableBy fw:EP_GroundTwo .

fw:Inv_DeploymentAnchored a backlog:CrossCuttingInvariant ;
    backlog:hasInvariantStatus backlog:Violated ;
    rdfs:label "RC4 — development is anchored on packages, not iterations"@en ;
    backlog:hasCheckQuery "SELECT (COUNT(*) AS ?n) WHERE { ?i backlog:hasState backlog:Done . FILTER NOT EXISTS { ?d a backlog:DeploymentUnit ; backlog:deploysItem ?i } }" ;
    backlog:hasExpectedResult "0" ;
    backlog:tracksItem fw:EP_GroundTwo ;
    backlog:hasRationale "CLOSED at v1.80.0 by consolidating all completed work into one package. Previously: 49 of 53 Done items sat in no DeploymentUnit, while this package shipped 78 real releases through oe_publish that the register never recorded. Development was anchored on iterations and the packages were invisible to it. NotYetEnforceable rather than Fails, because closing it means reconstructing a delivery history from the git tags — real work, and work that must be done from the tags rather than from anyone's account of them." .

#  Goals under superseded missions derive from Scope_v2, the
