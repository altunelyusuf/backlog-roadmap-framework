#################################################################
#  A NEW EPIC, not a reopened one.
#
#  EP_CodeTables closed at It8 having delivered exactly what it
#  said: the first table exported and its reader changed. Adding
#  six stories to it would reopen a Done epic and make its
#  completion retroactively untrue — the register rejected it, and
#  the rejection is right. What was learned is that one epic could
#  not hold 23 tables; that is a new epic, at a new estimate.
#################################################################

fw:EP_TablesBatch a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP26" ;
    backlog:hasTitle "The remaining 22 classification tables, in batches" ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_TablesExported ;
    backlog:satisfiesDeliverable fw:Del_OntExport ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasApplicableConcern backlog:Concern_Data ;
    backlog:hasAcceptanceCriterion fw:AC_EP_TablesBatch ;
    backlog:hasPriorityScore fw:S_EP_TablesBatch ;
    backlog:hasCostEstimate fw:E_EP_TablesBatch ;
    backlog:appliesDefinitionOfDone fw:DoD_EP_TablesBatch ;
    backlog:rankedOnRoadmap fw:Roadmap ;
    backlog:scheduledInHorizon backlog:Now ;
    backlog:hasRationale "Created because EP_CodeTables was Done and reopening it would make its completion untrue. Subject: the 22 tables the first epic did not reach." .
fw:AC_EP_TablesBatch a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given 22 python classification tables, When this epic is Done, Then all 22 are ontology enumerations, all 22 literals are deleted, and Obj_TablesExported is observed at 0." ;
    backlog:coveredByCase fw:TC_EP_TablesBatch .
fw:TC_EP_TablesBatch a backlog:TestCase ;
    backlog:exercisesCriterion fw:AC_EP_TablesBatch ;
    backlog:runsOnData fw:TD_EP_TablesBatch .
