    backlog:hasObservationMethod "Counted from backlog_tbox_v1_18_0.ttl: ExecutionModality with three members, hasExecutionModality, SupervisionMode with three members, hasSupervisionMode, InteractionKind with six members, HumanInteraction, interactsWith, hasInteractionKind, interactedAt, interactedBy, gatesTransition. Estimate was 17; actual 19. The two extra are Sup_None and Int_Reject — the honest-negative members. Omitting them would have forced unsupervised work to be recorded as supervised and left a gate with no way to record a refusal." .

fw:Scope backlog:scopeOutcomeDecidedBy backlog:Owner ;
    backlog:hasScopeOutcomeStatement "All six epics admitted to this scope are Done with verified evidence: the product-backlog/execution-task split, derived flow and forecast, multi-dimensional cost, human in and on the loop, the classical views, and the time-phased baseline. The four exclusions held throughout — no estimation scale, no delivery method, no modality-specific predicate, and no baseline schedule until an owner-decided ScopeChange admitted one and recorded why." .

#################################################################
#  The objective metrics, MEASURED — not inferred from delivery.
#
#  The term-count observations above record how much VOCABULARY
#  each epic added. They were wrongly attached as observations of
#  the outcome metrics, which is a category error: terms delivered
#  is effort, not questions answered. Corrected here by measuring
#  the metric each objective actually names.
#################################################################

fw:Obs_CoverageMeasured a backlog:MetricObservation ;
    rdfs:label "Progress questions answerable from the register alone"@en ;
    backlog:observesMetric fw:Metric_DerivedCoverage ;
    backlog:observationFor fw:Obj_Derived ;
    backlog:hasObservedValue 75.0 ;
    backlog:observedAt "2026-08-09T17:30:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Ran backlog_views and backlog_roadmap_report against this register and counted which questions returned an answer rather than a refusal. Answerable: Gantt, burn-down, network with critical path, earned value with CPI, cycle time, velocity, item age, forecast — 6 of 8 view families. Not answerable: cumulative flow, because no TransitionEvent carries a timestamp in this register; and per-dimension cost, because this register records no DimensionalCost of its own. 6/8 = 75%. Target is 80, so this objective is NOT met and is not recorded as met." .

fw:Obs_SpreadsheetMeasured a backlog:MetricObservation ;
    rdfs:label "Adopter questions still needing an external tool"@en ;
    backlog:observesMetric fw:Metric_SpreadsheetFree ;
    backlog:observationFor fw:Obj_Adopter ;
    backlog:hasObservedValue 2.0 ;
    backlog:observedAt "2026-08-09T17:30:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the same run's refusals: a cumulative-flow diagram and a per-dimension cost report both require data this register does not carry, so an adopter wanting either must still assemble it elsewhere. Baseline was 4, target 0, observed 2 — improved, not achieved." .

#################################################################
#  v1.8.0 — a fourth mission: the roadmap as an executable plan.
#
#  Registered BEFORE any work item, per the lineage ceremony. The
#  as-is was measured first and each gap proven by construction,
#  so the objectives below have real baselines rather than
#  estimated ones.
#################################################################

fw:Mission_Executable a backlog:Mission ;
    backlog:hasMissionOrigin backlog:Origin_SessionDrafted ;
    rdfs:label "Executable roadmap mission"@en ;
    backlog:hasMissionStatement "A reader of the roadmap can see how far started work has actually got, every story fits the iteration it was committed to, and each release carries the most valuable work available rather than whatever shared a theme." ;
    backlog:missionFor fw:Register ;
    backlog:decidedBy backlog:Owner .

fw:Goal_Legible a backlog:Goal ;
    rdfs:label "Structure and progress are readable together"@en ;
    backlog:contributesToMission fw:Mission_Executable ;
    backlog:decidedBy backlog:Owner .

fw:Goal_Executable a backlog:Goal ;
    rdfs:label "Commitments are sized to be finishable and selected by value"@en ;
    backlog:contributesToMission fw:Mission_Executable ;
    backlog:decidedBy backlog:Owner .

fw:Metric_ProgressLegible a core:Metric ;
    rdfs:label "Views showing structure that also show progress"@en .
fw:Metric_UnfinishableCommitments a core:Metric ;
    rdfs:label "Commitments the suite permits but the definitions forbid"@en .

fw:Obj_ProgressInViews a backlog:Objective ;
    rdfs:label "Structural views carry progress"@en ;
    backlog:contributesToGoal fw:Goal_Legible ;
    backlog:hasSuccessMetric fw:Metric_ProgressLegible ;
    backlog:hasBaselineValue 0.0 ;
    backlog:hasTargetValue 1.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasObjectiveDeadline "2026-09-30T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

fw:Obj_Finishable a backlog:Objective ;
    rdfs:label "Unfinishable or value-blind commitments are rejected"@en ;
    backlog:contributesToGoal fw:Goal_Executable ;
    backlog:hasSuccessMetric fw:Metric_UnfinishableCommitments ;
    backlog:hasBaselineValue 3.0 ;
    backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:hasObjectiveDeadline "2026-09-30T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

fw:Obs_AsIs a backlog:MetricObservation ;
    rdfs:label "As-is: three gaps, each proven by construction"@en ;
    backlog:observesMetric fw:Metric_UnfinishableCommitments ;
    backlog:observationFor fw:Obj_Finishable ;
    backlog:hasObservedValue 3.0 ;
    backlog:observedAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Measured against the shipped suite at L4, not estimated. (1) The network view prints only dependsOn edges: grep of its function body for hasState, Done or any progress term returns nothing, so a started node and an untouched one render identically. (2) A story planned into two iterations by two planning events validated with 22 violations, none of which concerns the span — the one iteration message present is about an epic. Story's own definition says 'small enough to be completed within one iteration'; nothing enforces it, which is the assertion-versus-meaning gap G3 already names. (3) deploysItem ranges on ProductBacklogItem with no notion of selection: spansIterations, fitsIteration, selectedByScore and hasSelectionBasis are all absent, so a release grouped by theme and a release of the highest-scoring available work are indistinguishable in the record." .

fw:Obs_ProgressAsIs a backlog:MetricObservation ;
    rdfs:label "As-is: no structural view carries progress"@en ;
    backlog:observesMetric fw:Metric_ProgressLegible ;
    backlog:observationFor fw:Obj_ProgressInViews ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Ran backlog_views network against the framework's own register: the emitted Mermaid contains only graph LR and arrow edges. No node carries state, completion or any derived fraction." .

fw:SC_Executable a backlog:ScopeChange ;
    rdfs:label "Admit progress-bearing views, iteration fit, and value-based release selection"@en ;
    backlog:changesScope fw:Scope ;
    backlog:admitsItem   fw:EP_ValueRelease ;
    backlog:hasScopeChangeRationale "Owner request, 2026-08-11. Three additions, none reversing an existing exclusion: Ex_Scale, Ex_Method, Ex_Modality and Ex_Complexity are untouched. Value-based release selection in particular does NOT prescribe a delivery method — it constrains what a DeploymentUnit may claim about how its contents were chosen, not how a team runs planning." ;
    backlog:decidedBy backlog:Owner .
fw:Scope backlog:scopeRealizesObjective fw:Obj_ProgressInViews , fw:Obj_Finishable .

# ---------------- the three epics, scored from the measured as-is ----------------

fw:EP_Progress a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP7" ;
    backlog:hasTitle "Structural views carry completion, not only dependency" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-11T10:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-11T11:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 3.0 ;
    backlog:hasEvidence fw:Ev_Progress ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:lastAuditedAt "2026-08-11T11:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_ProgressInViews ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_Progress ;
    backlog:hasPriorityScore fw:S_Progress ;
    backlog:hasCostEstimate fw:E_Progress ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 7 ;
    backlog:scheduledInHorizon backlog:Now .
fw:AC_Progress a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a register whose items are partly complete, When the network view is rendered, Then each node shows a completion proportion derived from its children's states, an unstarted node is visually distinct from a finished one, and a node whose progress cannot be derived says so rather than showing zero." .
fw:S_Progress a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 6.0 ;
    backlog:hasUserBusinessValue 8.0 ; backlog:hasTimeCriticality 5.0 ;
    backlog:hasRiskReductionValue 5.0 ; backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Highest business value of the three: it makes work already recorded legible to someone who is not reading Turtle, and every input exists — hasState on children, decompositionState, and the derived roll-up. Smallest job for the same reason: nothing is stored, the fraction is computed." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_Progress a backlog:CostEstimate ;
    backlog:hasEffortEstimate 3.0 ; backlog:hasCostBasis "One view function; no new stored vocabulary, since progress is derivable from children's states" ;
    backlog:estimatedAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Judged .

fw:EP_Fit a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP8" ;
    backlog:hasTitle "A story is consumed whole within one iteration, or split until it is" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-11T12:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-11T13:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 2.0 ;
    backlog:hasEvidence fw:Ev_Fit ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:lastAuditedAt "2026-08-11T13:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Finishable ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_Fit ;
    backlog:hasPriorityScore fw:S_Fit ;
    backlog:hasCostEstimate fw:E_Fit ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 8 ;
    backlog:scheduledInHorizon backlog:Next .
fw:AC_Fit a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a story planned into an iteration, When the suite is run at L4, Then a story committed to more than one iteration is rejected, a story still open when its iteration closed is rejected, and the message names splitting as the remedy rather than extending the iteration." .
fw:S_Fit a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 4.0 ;
    backlog:hasUserBusinessValue 6.0 ; backlog:hasTimeCriticality 4.0 ;
    backlog:hasRiskReductionValue 6.0 ; backlog:hasJobSize 4.0 ;
    backlog:scoredAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Highest risk reduction: a story that outlives its iteration makes velocity meaningless, and velocity now feeds the forecast, so the error propagates into a claim about the future. Job size larger than EP7 because splitting must be expressible — a rule that rejects without a remedy gets bypassed." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_Fit a backlog:CostEstimate ;
    backlog:hasEffortEstimate 4.0 ; backlog:hasCostBasis "Two constraints plus a split relation; Story's definition already states the rule, so no term is redefined" ;
    backlog:estimatedAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Judged .

fw:EP_ValueRelease a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP9" ;
    backlog:hasTitle "A deployment carries the most valuable available work, and records that it did" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-11T14:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-11T15:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 7.0 ;
    backlog:hasEvidence fw:Ev_ValueRelease ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:lastAuditedAt "2026-08-11T15:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Finishable ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_ValueRelease ;
    backlog:hasPriorityScore fw:S_ValueRelease ;
    backlog:hasCostEstimate fw:E_ValueRelease ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 9 ;
    backlog:scheduledInHorizon backlog:Next ;
    backlog:dependsOn fw:EP_Fit .
fw:AC_ValueRelease a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a deployment and a backlog of scored candidates, When the suite is run at L4, Then the deployment records the basis on which its contents were selected, a deployment carrying a lower-scored item while a higher-scored deliverable one was available is rejected unless the exception is recorded with a reason, and the report shows what was left out." .
fw:S_ValueRelease a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 2.4 ;
    backlog:hasUserBusinessValue 6.0 ; backlog:hasTimeCriticality 3.0 ;
    backlog:hasRiskReductionValue 3.0 ; backlog:hasJobSize 5.0 ;
    backlog:scoredAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Depends on EP8: selecting the most valuable stories is meaningless while a story can span iterations, because what is available at a release boundary is then undefined. Largest job of the three, and the one most at risk of over-reaching — the exception path matters as much as the rule, since a release that must always take the top score would be bypassed the first time an ordering was wrong." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_ValueRelease a backlog:CostEstimate ;
    backlog:hasEffortEstimate 6.0 ; backlog:hasCostBasis "Selection basis, a recorded exception with rationale, and a report of what was excluded" ;
    backlog:estimatedAt "2026-08-11T07:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Judged .

fw:Ev_Progress a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_progress_v1_0_0.ttl" ;
    backlog:hasTestId "BRF-EP7" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-11T11:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Rendered the fixture through backlog_views --network and confirmed all five cases distinguishable: a 2-of-4 parent at 50%, a Done leaf full, a Proposed leaf empty, a Cancelled leaf full because work that will not be done is resolved rather than outstanding, and a started childless leaf reporting ? rather than 0" ;
    backlog:verifiedByTool "backlog_views_v1_5_0.py" ;
    backlog:attestsCriterion fw:AC_Progress .

fw:Obs_ProgressDelivered a backlog:MetricObservation ;
    rdfs:label "Structural views carrying progress"@en ;
    backlog:observesMetric fw:Metric_ProgressLegible ;
    backlog:observationFor fw:Obj_ProgressInViews ;
    backlog:hasObservedValue 1.0 ;
    backlog:observedAt "2026-08-11T11:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted by running backlog_views --network against the framework's own register: the emitted Mermaid now carries a filled bar and a percentage per node, and the text table lists a derived completion with its basis for every item. Baseline was 0. Nothing is stored — a percentage written into the register could disagree with the states it summarises." .

fw:Ev_Fit a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_l4_conformant_v1_0_0.ttl + fixture_l4_negative_v1_0_0.ttl" ;
    backlog:hasTestId "BRF-EP8" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-11T13:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Negative fixture plants a story planned into two iterations and left open after the first closed; both clauses fire, three violations in total. Conformant fixture carries a story too large for one iteration SPLIT into two that each fit, using decomposesInto, and validates at 0 — so the remedy each message names is demonstrated working rather than only described." ;
    backlog:verifiedByTool "backlog_validate + pyshacl" ;
    backlog:attestsCriterion fw:AC_Fit .

fw:Obs_FitDelivered a backlog:MetricObservation ;
    rdfs:label "Commitments the suite permits but the definitions forbid"@en ;
    backlog:observesMetric fw:Metric_UnfinishableCommitments ;
    backlog:observationFor fw:Obj_Finishable ;
    backlog:hasObservedValue 1.0 ;
    backlog:observedAt "2026-08-11T13:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Re-ran the three as-is probes. A story spanning iterations and a story outliving its iteration are now both rejected at L4, measured by construction. One of the original three remains: a deployment still cannot say how its contents were chosen, which is BRF-EP9. Baseline was 3, target 0." .

fw:Ev_ValueRelease a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_l4_conformant_v1_0_0.ttl + fixture_l4_negative_v1_0_0.ttl" ;
    backlog:hasTestId "BRF-EP9" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-11T15:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Negative fixture plants a deployment with no stated basis, one claiming Highest scored while a Done item scoring 99 waited unnamed, and one naming a pass-over with no rationale; all three clauses fire. Conformant fixture declares Sel_HighestScored and validates at 0." ;
    backlog:verifiedByTool "backlog_validate + pyshacl" ;
    backlog:attestsCriterion fw:AC_ValueRelease .

fw:Obs_FitFinal a backlog:MetricObservation ;
    rdfs:label "Commitments the suite permits but the definitions forbid — final"@en ;
    backlog:observesMetric fw:Metric_UnfinishableCommitments ;
    backlog:observationFor fw:Obj_Finishable ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-11T15:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Re-ran all three as-is probes against the current suite at L4. A story spanning iterations is rejected, a story outliving its iteration is rejected, and a deployment that cannot say how its contents were chosen is rejected. Baseline was 3, target 0, observed 0 — measured by construction on the negative fixture, not inferred from the work being Done." .

#################################################################
#  v1.12.0 — a fifth mission, and the FIRST built scope-first.
#
#  Per Lineage Operating Discipline v3.0.0: Mission -> Scope (with
#  exclusions) -> Goal -> Objective. The scope below was written
#  before any goal existed, so the goals had a boundary to be
#  argued against rather than a boundary drawn around them.
#
#  The four impacts were MEASURED before this was registered, not
#  inferred from the ruling.
#################################################################

fw:Mission_OrderRepair a backlog:Mission ;
    backlog:hasMissionOrigin backlog:Origin_SessionDrafted ;
    rdfs:label "Recorded-order mission"@en ;
    backlog:hasMissionStatement "A reader of any lineage in this store can tell whether its scope was fixed before its goals or drawn around them afterwards, without asking the session that wrote it." ;
    backlog:missionFor fw:Register ;
    backlog:decidedBy backlog:Owner .

# --- SCOPE SECOND, before any goal exists ---

fw:Scope_Order a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Make the v3.0.0 ceremony order recordable and checkable: a way to state when each element of an intent chain was fixed, a check that reports the order a lineage was actually built in, and the shipped artifacts that still teach the retired order corrected." ;
    backlog:hasScopeExclusion fw:Ex_NoRewrite , fw:Ex_NoOrderShape , fw:Ex_NoTimestampMandate .

fw:Ex_NoRewrite a backlog:ScopeExclusion ;
    backlog:excludesConcern "Re-deriving the scopes of lineages already built under the old order." ;
    backlog:hasExclusionRationale "Rewriting a scope from objectives that already exist produces exactly the self-confirming boundary v3.0.0 exists to prevent, and would destroy the record of a real past order. L-112: historical records are corrected by appending." ;
    backlog:decidedBy backlog:Owner .

fw:Ex_NoOrderShape a backlog:ScopeExclusion ;
    backlog:excludesConcern "A SHACL constraint that rejects a lineage built in the old order." ;
    backlog:hasExclusionRationale "Measured: both orders validate identically and drift fires in both, so a shape would have to key on declaration timestamps that do not exist. More importantly a lineage built old-order is not WRONG, only weaker in one respect; rejecting every existing register to make a point would be the kind of rule that gets bypassed." ;
    backlog:decidedBy backlog:Owner .

fw:Ex_NoTimestampMandate a backlog:ScopeExclusion ;
    backlog:excludesConcern "Requiring a fixed-at date on every intent element at any conformance level." ;
    backlog:hasExclusionRationale "A date nobody can verify is a claim, not a measurement, and mandating one would produce backfilled timestamps asserting an order that was never followed. Optional and honest beats required and fabricated." ;
    backlog:decidedBy backlog:Owner .

# --- GOALS AND OBJECTIVES, produced to FILL that scope ---

fw:Goal_OrderVisible a backlog:Goal ;
    rdfs:label "The order a lineage was built in is visible in the lineage"@en ;
    backlog:contributesToMission fw:Mission_OrderRepair ;
    backlog:decidedBy backlog:Owner .

fw:Metric_OrderRecordable a core:Metric ;
    rdfs:label "Intent elements able to state when they were fixed"@en .
fw:Metric_StaleOrderArtifacts a core:Metric ;
    rdfs:label "Shipped artifacts teaching the retired chain order"@en .

fw:Obj_OrderRecordable a backlog:Objective ;
    rdfs:label "An intent element can state when it was fixed"@en ;
    backlog:contributesToGoal fw:Goal_OrderVisible ;
    backlog:hasSuccessMetric fw:Metric_OrderRecordable ;
    backlog:hasBaselineValue 0.0 ;
    backlog:hasTargetValue 4.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasObjectiveDeadline "2026-10-31T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

fw:Obj_NoStaleOrder a backlog:Objective ;
    rdfs:label "No shipped artifact teaches the retired order"@en ;
    backlog:contributesToGoal fw:Goal_OrderVisible ;
    backlog:hasSuccessMetric fw:Metric_StaleOrderArtifacts ;
    backlog:hasBaselineValue 2.0 ;
    backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:hasObjectiveDeadline "2026-10-31T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

fw:Obs_OrderAsIs a backlog:MetricObservation ;
    rdfs:label "As-is: the order is unrecordable"@en ;
    backlog:observesMetric fw:Metric_OrderRecordable ;
    backlog:observationFor fw:Obj_OrderRecordable ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-11T16:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Enumerated every property domained on Mission, Goal, Objective and ScopeStatement in backlog_tbox: 2, 1, 7 and 5 properties respectively, and NONE carries a date. The ceremony order therefore exists only in prose — a lineage cannot state whether its scope preceded its goals, and no reader can tell without asking the session that wrote it." .

fw:Obs_StaleOrderAsIs a backlog:MetricObservation ;
    rdfs:label "As-is: artifacts still teaching the retired order"@en ;
    backlog:observesMetric fw:Metric_StaleOrderArtifacts ;
    backlog:observationFor fw:Obj_NoStaleOrder ;
    backlog:hasObservedValue 2.0 ;
    backlog:observedAt "2026-08-11T16:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Grepped the shipped package. backlog_lineage_completeness lists its LAYERS as Mission, Goal, Objective, ScopeStatement, ScopeExclusion — the retired order, presented to every reader who runs it. The standard's section on the intent chain likewise describes goals and objectives before scope. The changelog also matches the old order but is a historical record and is excluded from this count under L-112." .

fw:SC_OrderRepair a backlog:ScopeChange ;
    rdfs:label "Admit the order-recording work"@en ;
    backlog:changesScope fw:Scope ;
    backlog:admitsItem  fw:EP_OrderCorrect ;
    backlog:hasScopeChangeRationale "Owner request following the v3.0.0 ruling. Note the shape of this entry: the earlier scope fw:Scope had to be AMENDED to admit this work, which is the third such amendment and is precisely the pattern that motivated the reordering. The new work is scoped under fw:Scope_Order, written before its goals." ;
    backlog:decidedBy backlog:Owner .

fw:EP_OrderRecord a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP10" ;
    backlog:hasTitle "The chain records its own order through link direction" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-11T17:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-11T18:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 2.0 ;
    backlog:hasEvidence fw:Ev_OrderRecord ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_InTheLoop ;
    backlog:lastAuditedAt "2026-08-11T18:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_OrderRecordable ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_OrderRecord ;
    backlog:hasPriorityScore fw:S_OrderRecord ;
    backlog:hasCostEstimate fw:E_OrderRecord ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 10 ;
    backlog:scheduledInHorizon backlog:Now .
fw:AC_OrderRecord a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a lineage in which each objective names the scope it fills, When the suite is run, Then the order the lineage was built in is readable from the link direction alone, a lineage built the other way is reported as such rather than rejected, and a lineage asserting both directions is rejected because it records no order at all." .
fw:S_OrderRecord a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 5.0 ;
    backlog:hasUserBusinessValue 6.0 ; backlog:hasTimeCriticality 4.0 ;
    backlog:hasRiskReductionValue 5.0 ; backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-11T16:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Risk reduction is the largest component: a ruling that cannot be observed in the artifact decays into folklore, and this session has already seen a discipline claim drift from its suite. Job size small because the property is optional and the report derives the rest." ;
    backlog:hasBasisKind backlog:Basis_Judged .
