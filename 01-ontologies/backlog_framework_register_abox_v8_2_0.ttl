#################################################################
#  v7.0.0 — MAJOR. A story was Done and its work was not.
#
#  OWNER CHALLENGE, and the audit confirms it. EP_RuleExec_S1
#  specified an expected-polarity property on every fixture and a
#  gate reading it instead of the filename. The story was Done, had
#  a specification with two ordered steps, a test case, test data,
#  a planned task, evidence marked verified, and a complete
#  harness. The property did not exist.
#
#  ROOT CAUSE: one TestEvidence attested FIVE criteria across three
#  stories, and its verification method described what the
#  iteration did as a whole. Every clause in the suite was
#  satisfied. None asked whether the thing the criterion describes
#  exists — the framework could say testing HAPPENED and could not
#  say what testing FOUND, per criterion.
#
#  Measured: 24 of 49 evidence records attest more than one
#  criterion. Batching evidence is how a criterion comes to be
#  carried by a claim about its neighbours.
#
#  SECOND FINDING, from the same audit: the four batch stories
#  S_Tables_B1..B4 were closed with NO specification, NO test case
#  and NO test data. They were created during execution, after the
#  grooming that would have given them any. The ceremony was
#  followed for the nine stories groomed before the sprint and not
#  for the four invented during it.
#################################################################

fw:Ev_PolarityFixed a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_criterion_resolve_v1_0_0.py" ;
    backlog:hasTestId "AC_EP_RuleExec_S1" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T08:50:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "hasExpectedPolarity now exists on AdoptionProfile with a closed Positive/Negative enumeration, and all 22 fixtures declare theirs. Verified against the old filename inference: all 22 agree, so the migration is faithful and not a re-labelling. The resolver reports 13 of 13 criterion artefacts resolving, having reported exactly one unresolved before the work — the one this story promised." ;
    backlog:verifiedByTool "backlog_criterion_resolve" ;
    backlog:attestsCriterion fw:AC_EP_RuleExec_S1 .

fw:CS_EP_RuleExec_S1 a backlog:CriterionSatisfaction ;
    backlog:satisfiesCriterion fw:AC_EP_RuleExec_S1 ;
    backlog:artifactResolved true ;
    backlog:hasRationale "Resolved at v1.119.0. Recorded false between It8 and here would have been the honest state; the framework could not express it, which is why this class exists." .

fw:Obs_RulesFinal a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_Obj_RulesDecidedInCode ;
    backlog:observationFor fw:Obj_RulesDecidedInCode ;
    backlog:hasObservedValue 1.0 ;
    backlog:observedAt "2026-08-27T08:50:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Baseline 3. Manifest exemption moved at It8; fixture polarity moves here, having been reported Done at It8 and not done. One remains: reachability, which is a query over the TBox and cannot move to a register that holds no rule about classes not yet declared. Observed 1, and the honest floor is 1." .

fw:Inv_CriterionArtifactNamed a backlog:CrossCuttingInvariant ;
    rdfs:label "Every criterion on Done work names a resolving artefact"@en ;
    backlog:hasCheckQuery "Run 03-tooling/backlog_criterion_resolve_v1_0_0.py --strict" ;
    backlog:hasExpectedResult "0 unresolved" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_RuleExec ;
    backlog:hasRationale "13 criteria name an artefact and 13 resolve. The checker found exactly one unresolved on its first run — the criterion of the story closed without its work — and nothing else, which is the evidence that it discriminates rather than merely passing." .

#################################################################
#  The previous lineage's criteria, given the artefact each was
