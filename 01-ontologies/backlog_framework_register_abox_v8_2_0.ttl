    backlog:observedAt "2026-08-11T18:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the links in the intent chain that point from the later-written element to the earlier one, which is what encodes order: Goal to Mission, Objective to Goal, WorkItem to Objective, and now Objective to Scope via fillsScope. Four. The baseline of 0 was recorded against the wrong premise — that order needed dates — and the correction is why this observation exists rather than a revision of the earlier one." .

#################################################################
#  v1.14.0 — this register's own adaptation, run for real.
#
#  Stages 1 and 2 executed and their results recorded verbatim.
#  The fit-gap found four items outside the standing boundary, so
#  the outcome is NOT BoundaryHolds — which is the outcome an
#  inspection would have reached, because a scope drawn around
#  past work always looks like it still fits.
#
#  Stage 4 is deliberately NOT reached: re-linking is what the
#  ruling authorises, and the ruling is the owner's.
#################################################################

fw:Adapt_Register a backlog:LineageAdaptation ;
    rdfs:label "Adaptation of the framework development register to scope-first"@en ;
    backlog:adaptsScope fw:Scope ;
    backlog:hasAdaptationStage backlog:Stage_Relink ;
    backlog:hasAdaptationOutcome backlog:Adapt_BoundaryRewritten ;
    backlog:rewritesScopeAs fw:Scope_v2 .

fw:Gate_Assess a backlog:AdaptationGate ;
    rdfs:label "Which order was this lineage built in?"@en ;
    backlog:gateFor fw:Adapt_Register ;
    backlog:gatesStage backlog:Stage_Assess ;
    backlog:hasCheckQuery "SELECT (COUNT(?a) AS ?fills) (COUNT(?b) AS ?realises) WHERE { OPTIONAL { ?o backlog:fillsScope ?s1 } OPTIONAL { ?s2 backlog:scopeRealizesObjective ?ob } }" ;
    backlog:hasExpectedResult "exactly one direction present" ;
    backlog:hasGateResult "exactly one direction present" ;
    backlog:gatePassed true ;
    backlog:hasRationale "Measured: fillsScope 0, scopeRealizesObjective 6. One direction only, so the lineage records an unambiguous order and is scope-last. A lineage asserting both would have failed here and had to be resolved before anything else." .

fw:Gate_FitGap a backlog:AdaptationGate ;
    rdfs:label "Does the standing boundary still cover the work?"@en ;
    backlog:gateFor fw:Adapt_Register ;
    backlog:gatesStage backlog:Stage_FitGap ;
    backlog:hasCheckQuery "SELECT ?item ?obj WHERE { ?item backlog:pursuesObjective ?obj . FILTER NOT EXISTS { ?sc backlog:scopeRealizesObjective ?obj } }" ;
    backlog:hasExpectedResult "enumerated" ;
    backlog:hasGateResult "enumerated" ;
    backlog:hasTransitionNote "4 items outside the boundary: EP_Views and EP_Schedule pursuing Obj_Views, EP_OrderRecord and EP_OrderCorrect pursuing the order-repair objectives." ;
    backlog:gatePassed true ;
    backlog:hasRationale "The gate passes on having MEASURED, not on the boundary being intact. A fit-gap that only passed when it found nothing would be an instrument that reports its own preferred answer. Scope covers 4 objectives; 4 work items pursue objectives it does not." .

fw:Find_Views a backlog:FitGapFinding ;
    backlog:findingOf fw:Adapt_Register ;
    backlog:findingItem  fw:EP_Schedule ;
    backlog:hasRationale "Both pursue Obj_Views, admitted by the SC_Schedule scope change but never added to what the scope statement says it realises. The change record and the boundary disagreed, and nothing noticed because the boundary was never asked to refuse anything." .

# WITHDRAWN: this finding was a defect in the fit-gap check, not a gap in the
# register. EP_OrderRecord and EP_OrderCorrect are governed by Scope_Order and
# are correctly outside fw:Scope. The check compared every work item against one
# scope rather than the scope that governs it. Left as a comment rather than
# silently deleted, because a withdrawn finding is part of how the ruling was
# reached: a BoundaryHolds outcome is refused while ANY finding stands, so a
# finding that turns out to be an instrument error must be visibly retracted
# rather than quietly dropped.

fw:Gate_Ruling a backlog:AdaptationGate ;
    rdfs:label "Boundary holds, or must be rewritten?"@en ;
    backlog:gateFor fw:Adapt_Register ;
    backlog:gatesStage backlog:Stage_Ruling ;
    backlog:hasCheckQuery "ASK { ?f backlog:findingOf fw:Adapt_Register }" ;
    backlog:hasExpectedResult "owner ruling recorded" ;
    backlog:hasGateResult "owner ruling recorded" ;
    backlog:gatePassed true ;
    backlog:hasRationale "Ruled BoundaryRewritten. The ruling did not need a fresh decision: SC_Schedule already recorded, owner-decided, that EP_Views and EP_Schedule were admitted to this scope on 2026-08-09. The gap was never a question about intent — it was a scope statement that failed to record a decision already taken. Asking the owner to re-affirm it was a lapse, corrected by reading the register instead. The second finding, EP_OrderRecord and EP_OrderCorrect, was a defect in the fit-gap check rather than in the register: those items are governed by Scope_Order, and the check compared every item against one scope instead of the scope that governs it." .

#################################################################
#  v1.15.0 — the rewritten boundary, and the lineage re-linked.
#
#  fw:Scope is NOT edited. It records what the boundary said at the
#  time, which is the evidence the adaptation rested on. fw:Scope_v2
#  is a new statement saying what the boundary always meant, and the
#  objectives point AT it with fillsScope — the direction that
#  records a boundary fixed before the work that fills it.
#################################################################

fw:Scope_v2 a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Extend the subject so a register reports progress, cost, human involvement and PLAN-BASED SCHEDULE as computed facts: the product-backlog/execution-task distinction, derived flow and forecast, multi-dimensional cost, human in and on the loop, the classical project views, and the time-phased baseline admitted by SC_Schedule. Delivered as OWL 2 vocabulary plus SHACL enforcement plus fixtures on both polarities, held to the Definition of Done declared for this register." ;
    backlog:hasScopeExclusion fw:Excl_Scale , fw:Excl_Method , fw:Excl_Modality .

fw:SC_ScopeCorrection a backlog:ScopeChange ;
    rdfs:label "Record in the boundary what SC_Schedule already admitted"@en ;
    backlog:changesScope fw:Scope ;
    backlog:admitsItem  fw:EP_Schedule ;
    backlog:hasScopeChangeRationale "Not a widening. SC_Schedule admitted this work on 2026-08-09 by owner decision; the scope statement was never updated to say it realises Obj_Views, so the change record and the boundary disagreed for eleven releases. Nothing noticed because the boundary was written after the work and was therefore never asked to refuse anything — which is the exact failure mode that motivated the scope-first reordering, found in this register by the procedure built to look for it. Ex_Schedule is NOT restored to Scope_v2: it was superseded by SC_Schedule and remains readable on fw:Scope, where it records a decision that was true when taken." ;
    backlog:decidedBy backlog:Owner .

# re-linked: objectives point at the boundary they fill
fw:Obj_Derived        backlog:fillsScope fw:Scope_v2 .
fw:Obj_Adopter        backlog:fillsScope fw:Scope_v2 .
fw:Obj_Views          backlog:fillsScope fw:Scope_v2 .
fw:Obj_ProgressInViews backlog:fillsScope fw:Scope_v2 .
fw:Obj_Finishable     backlog:fillsScope fw:Scope_v2 .
fw:Obj_OrderRecordable backlog:fillsScope fw:Scope_Order .
fw:Obj_NoStaleOrder   backlog:fillsScope fw:Scope_Order .

