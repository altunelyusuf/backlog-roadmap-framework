    owl:priorVersion <http://example.org/backlog-framework-register/1.6.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.5.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.4.0> ;
