fw:Layer_Epic a backlog:LineageLayer ;
    backlog:layerClass backlog:Epic ;
    backlog:layerOrdinal 9 ;
    backlog:layerAbsenceCost "No theme; stories answer to nothing above them." .
fw:Layer_Story a backlog:LineageLayer ;
    backlog:layerClass backlog:Story ;
    backlog:layerOrdinal 10 ;
    backlog:layerAbsenceCost "No user-facing slice; work is tasks with no stated value." .
fw:Layer_ExecutionTask a backlog:LineageLayer ;
    backlog:layerClass backlog:ExecutionTask ;
    backlog:layerOrdinal 11 ;
    backlog:layerAbsenceCost "No executable step; a story is a wish." .
fw:Layer_PlanningEvent a backlog:LineageLayer ;
    backlog:layerClass backlog:PlanningEvent ;
    backlog:layerOrdinal 12 ;
