    backlog:hasTestId "BRF-EP11" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-11T20:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Re-measured both artifacts by inspection of the shipped bytes rather than by asserting the edit landed: the completeness reporter now lists ScopeStatement and ScopeExclusion BEFORE Goal and Objective, checked by string position in the LAYERS table; the standard now names fillsScope alongside scopeRealizesObjective and states the build order Mission then Scope then Goal then Objective explicitly. The changelog still describes the retired order and is deliberately untouched — it records a past state, and L-112 forbids editing history to match the present." ;
    backlog:verifiedByTool "backlog_lineage_completeness_v1_1_0.py + doc-coverage gate" ;
    backlog:attestsCriterion fw:AC_OrderCorrect .

