fw:S_EP_Model a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 7.0 ;
    backlog:hasUserBusinessValue 9.0 ; backlog:hasTimeCriticality 6.0 ;
