    backlog:hasHarnessEvidence fw:Ev_It8 ; backlog:harnessComplete true ;
    backlog:hasRationale "Attested by the reader running and by its refusal to fall back." .
fw:H_It8_EP_RuleExec a backlog:TestHarness ; backlog:harnessFor fw:EP_RuleExec ;
    backlog:hasHarnessEvidence fw:Ev_It8 ; backlog:harnessComplete true ;
    backlog:hasRationale "Attested by the reader running and by its refusal to fall back." .
fw:H_It8_EP_CodeTables_S2 a backlog:TestHarness ; backlog:harnessFor fw:EP_CodeTables_S2 ;
