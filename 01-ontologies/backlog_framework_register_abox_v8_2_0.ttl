#  RC3 CORRECTED — the mismatch the owner identified.
#
#  Obj_Grounded measures "framework-required practices with no
#  named external source", and the two ungrounded practices are the
#  story-fits-one-iteration rule and the deployment selection
#  basis. EP_TeamRoles cannot move that metric: it adds sourced
#  ROLES, which is a different thing entirely.
#
#  The epic completed, the metric stayed at 2, and nothing noticed
#  — which is precisely the mismatch MetricReachabilityShape now
#  catches. The backlog is adjusted rather than the objective
#  weakened: a new epic is registered for the work that WOULD move
#  it, and EP_TeamRoles is withdrawn as a mover.

fw:EP_GroundTwo a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP16" ;
    backlog:hasTitle "The two ungrounded practices are sourced or declared framework-original" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-24T21:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-24T22:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 3.0 ;
    backlog:hasEvidence fw:Ev_GroundTwo ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:lastAuditedAt "2026-08-24T22:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Grounded ;
    backlog:hasInvestmentCategory backlog:Cat_TechnicalDebt ;
    backlog:hasAcceptanceCriterion fw:AC_GroundTwo ;
    backlog:hasPriorityScore fw:S_GroundTwo ;
    backlog:hasCostEstimate fw:E_GroundTwo ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 16 ;
    backlog:scheduledInHorizon backlog:Now ;
    backlog:hasRationale "Registered because the objective's only mover could not move it. Adjusting the backlog is the correct response to a mismatch; re-targeting the objective would be moving the goalpost to meet the shot." .
fw:AC_GroundTwo a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the story-fits-one-iteration rule and the deployment selection basis, When the framework is read, Then each names an external source, or is declared framework-original with a rationale and the objective's target is changed deliberately rather than quietly." .
fw:S_GroundTwo a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 4.0 ;
    backlog:hasUserBusinessValue 5.0 ; backlog:hasTimeCriticality 3.0 ;
    backlog:hasRiskReductionValue 4.0 ; backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-24T20:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Risk reduction is the real component: an objective that no work can move is an objective that will read as failed forever, and a register carrying one teaches the next reader that unmet objectives are normal." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_GroundTwo a backlog:CostEstimate ;
    backlog:hasEffortEstimate 3.0 ; backlog:hasCostBasis "Literature search for two rules, or two declared exceptions with rationale" ;
