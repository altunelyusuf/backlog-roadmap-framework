fw:Ev_StoryDetail a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_storydetail_negative_v1_0_0.ttl" ;
    backlog:hasTestId "BRF-EP18-19" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-26T20:45:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Five cases verified individually. A specification with ordered steps, a real state change, and a test case exercising a criterion with named data is silent. Two steps claiming position 1 are rejected at L1. A state change from Locked to Locked is rejected at L1 — a change to the same state is not a change. A test case exercising nothing and naming no data is rejected twice at L3. A story groomed for Interaction with no specification raises an advisory. The reachability gate ran before release and the count held at 23: all six new classes are named as a range, which is why TestCase gained coveredByCase as well as exercisesCriterion." ;
    backlog:verifiedByTool "backlog_validate + backlog_reachability_gate" ;
    backlog:attestsCriterion fw:AC_EP_Model , fw:AC_EP_Model_S3 , fw:AC_EP_Spec , fw:AC_EP_Spec_S1 ,
        fw:AC_EP_Spec_S2 , fw:AC_EP_TestSpec , fw:AC_EP_TestSpec_S1 , fw:AC_EP_TestSpec_S2 .

