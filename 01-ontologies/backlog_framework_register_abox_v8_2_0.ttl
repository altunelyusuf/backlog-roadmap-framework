fw:Ev_It10 a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_pipeline_verify_v1_0_0.py reading stageRequiresType" ;
    backlog:hasTestId "It10" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T07:00:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "STAGE_TYPES was the most consequential table in the tooling: it defined the ceremony this framework ENFORCES, as a python dictionary no query could reach, so an adopter following the published ceremony and one checked by the verifier were reading two different specifications. Now stageRequiresType in the TBox, read by the verifier, which exits FATAL without it. The loud failure earned itself immediately — it located the statements in the wrong graph on the first run, because a statement about TBox individuals had been written into the register. Four stage digests recorded as pending-commit were backfilled from their real commits and all five now reproduce; the verifier reports the chain is a line." ;
    backlog:verifiedByTool "backlog_pipeline_verify + backlog_validate" ;
    backlog:attestsCriterion fw:AC_S_Tables_B1 , fw:AC_S_Tables_B2 , fw:AC_EP_TablesBatch .
fw:H_It10_S_Tables_B1 a backlog:TestHarness ; backlog:harnessFor fw:S_Tables_B1 ;
    backlog:hasHarnessEvidence fw:Ev_It10 ; backlog:harnessComplete true ;
    backlog:hasRationale "Each exported table verified per table, and the verifier runs from the ontology." .
fw:H_It10_S_Tables_B2 a backlog:TestHarness ; backlog:harnessFor fw:S_Tables_B2 ;
    backlog:hasHarnessEvidence fw:Ev_It10 ; backlog:harnessComplete true ;
    backlog:hasRationale "Each exported table verified per table, and the verifier runs from the ontology." .

