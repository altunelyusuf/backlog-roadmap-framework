fw:H_EP_TeamRoles_S1 a backlog:TestHarness ; backlog:harnessFor fw:EP_TeamRoles_S1 ;
    backlog:hasHarnessEvidence fw:Ev_Roles ; backlog:harnessComplete true ;
    backlog:hasRationale "As for the parent epic." .

