    backlog:forecastAssumption "EP4 stays blocked on EP3 only, and the Ex_Modality exclusion continues to settle the human-review question without further scope work." ;
    backlog:forecastAssumption "No ScopeChange admits further subjects; the four in the register are the whole of it." .

#################################################################
#  v1.3.0 — a third mission: the plan-based views.
#
#  Ex_Schedule refused a time-phased baseline. The owner has
#  reversed that. The exclusion is NOT deleted: it records a
#  decision that was true when taken, and L-112 forbids editing a
#  record of the past to match the present. A ScopeChange supersedes
#  it, and both remain readable.
#################################################################

fw:SC_Schedule a backlog:ScopeChange ;
    rdfs:label "Admit a time-phased baseline, reversing Ex_Schedule"@en ;
    backlog:changesScope fw:Scope ;
    backlog:admitsItem  fw:EP_Schedule ;
    backlog:hasScopeChangeRationale "Owner decision, 2026-08-09. Ex_Schedule refused planned dates on the grounds that horizons are ordinal and a baseline would change what a roadmap IS. That reasoning still holds for the ROADMAP and is unchanged: horizons stay ordinal and hasRoadmapRank stays an ordering. What is admitted is a PLAN alongside the roadmap, not instead of it — a separate artifact carrying dates, against which schedule performance is measured. The exclusion stands as the record of why this was refused; this change records why it no longer is." ;
    backlog:decidedBy backlog:Owner .

fw:Mission_Plan a backlog:Mission ;
    backlog:hasMissionOrigin backlog:Origin_SessionDrafted ;
    rdfs:label "Plan-based visibility mission"@en ;
    backlog:hasMissionStatement "A register can be read as a plan as well as a backlog: what was scheduled, what actually happened, and the difference — without exporting anything to a spreadsheet or a project tool." ;
    backlog:missionFor fw:Register ;
    backlog:decidedBy backlog:Owner .

fw:Goal_Views a backlog:Goal ;
    rdfs:label "The classical project views are computable from the register"@en ;
    backlog:contributesToMission fw:Mission_Plan ;
    backlog:decidedBy backlog:Owner .

fw:Metric_Views a core:Metric ; rdfs:label "Classical views computable from the register alone"@en .

fw:Obj_Views a backlog:Objective ;
    rdfs:label "Views computable without an external tool"@en ;
    backlog:contributesToGoal fw:Goal_Views ;
    backlog:hasSuccessMetric fw:Metric_Views ;
    backlog:hasBaselineValue 0.0 ;
    backlog:hasTargetValue 5.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasObjectiveDeadline "2026-09-30T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

fw:Obs_Views a backlog:MetricObservation ;
    rdfs:label "Views delivered by backlog_views v1.0.0"@en ;
    backlog:observesMetric fw:Metric_Views ;
    backlog:observationFor fw:Obj_Views ;
    backlog:hasObservedValue 5.0 ;
    backlog:observedAt "2026-08-09T00:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted by running backlog_views_v1_5_0.py against this register: Gantt, burn-down, cumulative flow, network/AON and earned value all execute. Gantt and SPI correctly REFUSE rather than assume when no KickOff is present, which is the behaviour under test as much as the drawing is." .

