fw:Layer_Iteration a backlog:LineageLayer ;
    backlog:layerClass backlog:Iteration ;
    backlog:layerOrdinal 13 ;
    backlog:layerAbsenceCost "No time box; cadence is unmeasurable." .
fw:Layer_Milestone a backlog:LineageLayer ;
    backlog:layerClass backlog:Milestone ;
    backlog:layerOrdinal 14 ;
    backlog:layerAbsenceCost "No external commitment; slippage is invisible to anyone outside." .
fw:Layer_CrossCuttingInvariant a backlog:LineageLayer ;
    backlog:layerClass backlog:CrossCuttingInvariant ;
    backlog:layerOrdinal 15 ;
    backlog:layerAbsenceCost "No standing condition; each release re-argues the same rules." .
fw:Layer_CostEstimate a backlog:LineageLayer ;
    backlog:layerClass backlog:CostEstimate ;
    backlog:layerOrdinal 16 ;
    backlog:layerAbsenceCost "No effort claim; capacity cannot be checked." .
fw:Layer_Evidence a backlog:LineageLayer ;
    backlog:layerClass backlog:Evidence ;
    backlog:layerOrdinal 17 ;
    backlog:layerAbsenceCost "No proof; Done is a claim." .
fw:Layer_Forecast a backlog:LineageLayer ;
    backlog:layerClass backlog:Forecast ;
    backlog:layerOrdinal 18 ;
    backlog:layerAbsenceCost "No projection; the future is unstated." .

fw:Ev_It7 a backlog:TestEvidence ;
    backlog:hasTestSpec "01-ontologies/backlog_tbox_v1_46_0.ttl and the register's 18 GovernanceRuling instances" ;
    backlog:hasTestId "It7" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-26T21:22:10Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "The rulings were EXTRACTED from the discipline document by pattern, not retyped — retyping would have created a second source of truth in the release whose purpose is removing them. A query for GovernanceRuling returns all 18 by identifier. Each names the shape that enforces it, which the document could only assert in prose. The LAYERS table is declared as 18 LineageLayer individuals with ordinals and absence costs; the python literal is NOT yet deleted, because deleting it before the script reads the ontology would leave the reporter unable to run — that is story 2, in It8." ;
    backlog:verifiedByTool "backlog_validate + rdflib query" ;
    backlog:attestsCriterion fw:AC_EP_Rulings , fw:AC_EP_Rulings_S1 , fw:AC_EP_Rulings_S2 , fw:AC_EP_CodeTables_S1 .

