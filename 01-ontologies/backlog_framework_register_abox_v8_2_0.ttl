fw:Ev_Cost a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_positive_v1_7_0.ttl + fixture_negative_v1_7_0.ttl" ;
    backlog:hasTestId "BRF-EP3" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-09T15:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Positive fixture carries one item with three dimensions at once — tokens, compute and unpriced review time — against two budgets, at 0 violations; the cost view reports each dimension separately and states plainly that the unpriced one contributes to no monetary total. Negative fixture plants a dimension with no unit, a rate with no currency, a bare cost, negative consumption, and a parent and child both costed on one dimension; all fire." ;
    backlog:verifiedByTool "backlog_validate_v1_4_0.py + backlog_views_v1_5_0.py" ;
    backlog:attestsCriterion fw:AC_Cost .

