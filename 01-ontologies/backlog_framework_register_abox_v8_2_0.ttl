#################################################################
#  v3.3.0 — BRF-EP16. Obj_Grounded moves 2 -> 0.
#################################################################

fw:Ev_GroundTwo a backlog:TestEvidence ;
    backlog:hasTestSpec "01-ontologies/backlog_tbox_v1_31_0.ttl dcterms:source and isFrameworkOriginal assertions" ;
    backlog:hasTestId "BRF-EP16" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-24T22:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Literature searched, not recalled. The story-fits-one-iteration rule is INVEST's S for Small — Bill Wake, 2003 — which states exactly that a story is sized to be completed within one iteration; the rule was correct and merely unattributed. Three of the four selection bases are grounded: highest-scored in the Next Release Problem (Bagnall et al. 2001), dependency-forced in the value-dependency literature (Carlshamre et al. 2001, Ngo-The and Ruhe 2008), previously-committed in release-planning practice. The fourth, Sel_Opportunistic, has NO source: the literature names value, dependency and commitment and does not name a category for a release that was not a prioritisation decision at all. Declared framework-original with its reason rather than attributed to a source it does not have. PracticeGroundingShape now checks the exclusion that was previously only a promise." ;
    backlog:verifiedByTool "web literature search + backlog_validate" ;
    backlog:attestsCriterion fw:AC_GroundTwo , fw:AC_S_GroundIteration , fw:AC_S_GroundSelection .

fw:H_EP_GroundTwo a backlog:TestHarness ; backlog:harnessFor fw:EP_GroundTwo ;
    backlog:hasHarnessEvidence fw:Ev_GroundTwo ; backlog:harnessComplete true ;
    backlog:hasRationale "Each term now carries a source or a declared exception, checked by shape." .
fw:H_S_GroundIteration a backlog:TestHarness ; backlog:harnessFor fw:S_GroundIteration ;
    backlog:hasHarnessEvidence fw:Ev_GroundTwo ; backlog:harnessComplete true ;
    backlog:hasRationale "As for the parent epic." .
fw:H_S_GroundSelection a backlog:TestHarness ; backlog:harnessFor fw:S_GroundSelection ;
    backlog:hasHarnessEvidence fw:Ev_GroundTwo ; backlog:harnessComplete true ;
    backlog:hasRationale "As for the parent epic." .

