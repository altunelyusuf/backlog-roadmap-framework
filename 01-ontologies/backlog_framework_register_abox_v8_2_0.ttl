fw:H_T_EP_Reach_S1 a backlog:TestHarness ; backlog:harnessFor fw:T_EP_Reach_S1 ;
    backlog:hasHarnessEvidence fw:Ev_Reach ; backlog:harnessComplete true ;
    backlog:hasRationale "As for the story." .

fw:Obs_Reach a backlog:MetricObservation ;
    rdfs:label "Classes unreferenceable and unused"@en ;
    backlog:observesMetric fw:Metric_UngroundedPractices ;
    backlog:observationFor fw:Obj_Grounded ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-25T17:40:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Three experiments. (1) The seven planned stories create seven classes and depend on none of the 23 unreachable ones — overlap zero, so the fit-gap cannot block the lineage. (2) Simulating those seven with the properties this session's grooming decided on, THREE are born unreachable: UseCase, Specification and TestCase. The current lineage would reproduce the defect the fit-gap just found. (3) A reachability gate over TBox plus register runs in under a second on 4338 triples and separates 45 classes reachable by rdf:type alone from 23 that are neither referenceable nor used. Obj_Grounded stays at 0: no framework-required practice lacks a source, and the reachability finding is a vocabulary gap rather than an ungrounded practice." .

#################################################################
#  v4.6.0 — BRF-EP17 delivered. The reachability gate is wired in.
#################################################################

fw:MA_TBox a backlog:ModelArtifact ;
    backlog:hasModelKind backlog:Kind_ClassDiagram ;
    backlog:describesItem fw:EP_Model ;
    backlog:hasRationale "The ModelArtifact / ModelKind / ModelCategory structure itself, as added to the TBox. Recorded as a class-diagram artefact because that is what it is — the framework's first use of its own artefact vocabulary is the vocabulary's own structure." .

fw:Ev_ModelArtifact a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_modelartifact_negative_v1_0_0.ttl" ;
    backlog:hasTestId "BRF-EP17" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-26T20:30:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Four cases verified individually. An artefact with kind and described item is silent; one with no kind is rejected at L2; one describing nothing is rejected at L2; a Done design-definition task producing no artefact raises an advisory rather than a violation, because a design task may legitimately conclude no model is needed. Built to the decisions the grooming refinements recorded and not redesigned: Diagram is not a separate class, artefacts hang off ExecutionTask, and the structure/behaviour split is a property so a query need not list seven kinds. The reachability gate ran before release and the count stayed at 23 — without it, measured beforehand, UseCase and Specification would have shipped unreferenceable." ;
    backlog:verifiedByTool "backlog_validate + backlog_reachability_gate" ;
    backlog:attestsCriterion fw:AC_EP_Model_S1 , fw:AC_EP_Model_S2 .

fw:H_EP_Model_S1 a backlog:TestHarness ; backlog:harnessFor fw:EP_Model_S1 ;
