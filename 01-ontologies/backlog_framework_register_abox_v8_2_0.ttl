    backlog:hasIdentifier "BRF-T-EP_Model_S3" ;
    backlog:hasTitle "Join RefinementEvent to the artefact it produced" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-26T20:35:00Z"^^xsd:dateTime ;
