    backlog:hasFixtureState "Twelve python modules holding the 22 tables that remain after It8." .
fw:DoD_EP_TablesBatch a backlog:DefinitionOfDone ;
    backlog:hasDoDCriterion "Every batch story is Done with hasBatchCompleted equal to hasBatchSize." ;
    backlog:hasDoDCriterion "Every changed reader fails loudly without its ontology data, verified per table." ;
    backlog:hasDoDCriterion "Obj_TablesExported is observed at 0 by the counting method it declares." .
fw:S_EP_TablesBatch a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 5.0 ;
    backlog:hasUserBusinessValue 6.0 ; backlog:hasTimeCriticality 6.0 ;
    backlog:hasRiskReductionValue 3.0 ; backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-27T07:50:00Z"^^xsd:dateTime ;
    backlog:hasScoreRationale "Time criticality raised to 6 from the original epic's 5: the checkpoint measurement showed the deadline unreachable on the old plan, which is evidence rather than pressure. Risk reduction lowered to 3 because batching ADDS concealment risk — an honest score does not credit a plan for a risk it creates." ;
    backlog:hasBasisKind backlog:Basis_Judged .
