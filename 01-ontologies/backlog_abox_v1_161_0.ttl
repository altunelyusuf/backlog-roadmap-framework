    backlog:areaMeasure "Counted 2026-11-02: three kinds of change are not seen by the digest behind the statement: the register, a git-ignored file and the old path of a renamed file." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_RecordIntegrity .
