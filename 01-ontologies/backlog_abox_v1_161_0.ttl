    backlog:relatesToWorkItem fw:ST_AA_IndependentReview ;
    backlog:hasRootCause "the independent reviewer agent (an Explore agent that did not write the work): said the probe judges a one-story register with the real validator but not the live register. True." ;
    backlog:hasRemedy "The live proof is the next lineage, opened under the agentic profile; the closure says so." .
fw:Find_AA_ReviewNotOwnProfile a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:relatesToWorkItem fw:ST_AA_IndependentReview ;
    backlog:hasRootCause "the independent reviewer agent (an Explore agent that did not write the work): said the lineage itself ran under the non-agentic profile and shows no runs. True and by design: a lineage cannot adopt a profile that does not yet exist." ;
    backlog:hasRemedy "The next lineage opens under the agentic profile." .
