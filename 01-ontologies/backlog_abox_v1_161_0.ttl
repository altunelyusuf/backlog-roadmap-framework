    backlog:lessonOfShape backlog:ScopeGapAdvisoryShape ;
    backlog:hasExperienceStatement "A declared scope boundary no goal derives from is wider than the real backlog, and cannot be tested against the mission; the reverse of scope creep."@en ;
    backlog:inLessonFamily backlog:LessonFamily_5 ;
    backlog:learnedInSegment backlog:Segment_Goal ;
