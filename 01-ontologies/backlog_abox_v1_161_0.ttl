    backlog:followsReview fw:Review_AP2_3 ; backlog:heldAt "2026-10-30T01:48:30Z"^^xsd:dateTime ; backlog:producesFinding fw:Find_AP2_StatusNotAdvanced , fw:Find_AP2_ReceiptReadAnotherRepository , fw:Find_AP2_RegisterNotValidatedByGate , fw:Find_AP2_GeneratorDoubledName , fw:Find_AP2_ReportRunLeaked , fw:Find_AP2_ToolsBeforeScope , fw:Find_AP2_NoteNamesRulingByIdentifier , fw:Find_AP2_OpenRefusedAfterToolChange , fw:Find_AP2_StageReleaseBlockedByOpenBox , fw:Find_AP2_ReleaseCountAndTime .
