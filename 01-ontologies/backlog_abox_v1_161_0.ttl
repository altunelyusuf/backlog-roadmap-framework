fw:Ev_GS_Probes a backlog:TestEvidence ; rdfs:label "The check for story Probes"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "Probes" ;
    backlog:hasTestSpec "03-tooling/backlog_validate_only_probe_v1_0_0.py" ;
    backlog:attestsCriterion fw:AC_GS_Probes ;
    backlog:hasVerificationMethod "The probe judges small registers whole and restricted and compares the violation lines; it checks that an unmatched text is refused, that a restricted and a whole run of the same data in one memo directory never replay each other, and that the gate unsets the variable. The fourteen slow probes and two more were each run and pass; the probe loop was run as the gate runs it, with an empty memo, and timed." ;
    backlog:verifiedAt "2026-11-03T15:57:48Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_validate_only_probe v1.0.0" ;
    backlog:satisfiedByArtifact "03-tooling/backlog_validate_only_probe_v1_0_0.py" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:AC_GS_Probes backlog:satisfiedByArtifact "03-tooling/backlog_validate_only_probe_v1_0_0.py" .
