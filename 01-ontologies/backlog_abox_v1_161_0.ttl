# ---- Lineage 24, box 1: the non-agentic and the agentic adaptive lineage (G181) ----
backlog:Profile_Adaptive skos:altLabel "NAAL"@en , "Non-agentic adaptive lineage"@en .
backlog:Pr_10 a owl:NamedIndividual , backlog:ProfileRevision ; rdfs:label "Profile revision 10"@en ; backlog:revisionNumber 10 ; skos:definition "Release 1.483.0 (G181) adds the agentic adaptive lineage profile (AAL) beside the adaptive profile, which is named the non-agentic adaptive lineage (NAAL) and is not changed. AAL includes every rule set of NAAL and the rule sets of agent accountability and independent verification, which the step tool now satisfies."@en .
backlog:Profile_AgenticAdaptive a owl:NamedIndividual , backlog:OpeningProfile ;
    rdfs:label "Agentic adaptive lineage profile"@en ; skos:altLabel "AAL"@en ;
    skos:definition "The profile for a lineage whose work is done by agents: every rule set of the non-agentic adaptive lineage (NAAL) is kept, and every move and every Done item records who made it and who oversaw, verified and approved it, by runs of four different agent definitions; a person approves only work at or above the stated integrity level."@en ;
    backlog:humanApprovalLevel 3 ;
    backlog:introducedInRevision backlog:Pr_10 ;
    backlog:profileIncludes backlog:RS_CancellationAssessed , backlog:RS_CeremonyKinds , backlog:RS_ChainBothWays , backlog:RS_ChangeSupportsMission , backlog:RS_ConcurrentLineages , backlog:RS_DecompositionStateAgrees , backlog:RS_DigestTable_v5 , backlog:RS_FlowPointsRecorded , backlog:RS_ImpedimentNamesWhatItBlocks , backlog:RS_ObligationsFollowStatus , backlog:RS_PlanBeforeStart , backlog:RS_ReadinessChecked , backlog:RS_RepairReprioritises , backlog:RS_ReviewNeedsControlRun , backlog:RS_StateReflectsEvidence , backlog:RS_StatusHistoryRecorded , backlog:RS_AgentAccountability , backlog:RS_IndependentVerification .
fw:Ruling_G181 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G181" ;
    rdfs:label "Two adaptive lineages: the non-agentic and the agentic, the second adding accountability"@en ;
    backlog:hasRulingStatement "The adaptive profile is the non-agentic adaptive lineage (NAAL) and is not changed. The agentic adaptive lineage (AAL) includes every rule set of NAAL and the rule sets of agent accountability and independent verification: every recorded move names the run that made it, and every Done item names runs of different agent definitions that did, oversaw, verified and approved it, a person approving at or above the stated integrity level. The step tool records these in a lineage that adopts the first of them." ;
    backlog:enforcedByShape backlog:TransitionNamesWhoShape , backlog:TransitionByRunShape , backlog:AgentRunIsInstanceShape , backlog:SeparateDutiesShape , backlog:DoneUnaccountedShape , backlog:HumanApprovalAboveLevelShape , backlog:DoneWithoutVerifierShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v145.0.0, section G181." .
fw:Ruling_G181 backlog:rulingDecides backlog:Pr_10 , backlog:Profile_AgenticAdaptive , backlog:RS_AgentAccountability , backlog:RS_IndependentVerification .
fw:Ckp_AA_1_1 a backlog:DailyCheckpoint ; rdfs:comment "MakerRecorded: The step tool records the run that made every move; a probe has the real validator judge the register the tool wrote."@en ; backlog:hasWorkKind backlog:WorkKind_Monitoring ; backlog:checkpointOfBox fw:It_AA_1 ; backlog:checkpointAt "2026-11-01T09:31:58Z"^^xsd:dateTime ;
    backlog:openItemCount 0 ; backlog:inProgressItemCount 3 ; backlog:doneItemCount 0 .
