fw:Ev_AP2_DigestCheck a backlog:TestEvidence ; rdfs:label "The check for story DigestCheck"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "DigestCheck" ;
    backlog:hasTestSpec "03-tooling/backlog_archived_digest_check_v1_1_0.py" ;
    backlog:attestsCriterion fw:AC_AP2_DigestCheck ;
    backlog:hasVerificationMethod "For every archived lineage that does not reproduce, the check measures with the verifier's own functions under which of the tables v1 to v5 it does. On the archive: Lineage 20 reproduces under v5 only, a lineage closed under the early tables under v1 to v3, eleven under none. The baseline v1.2.0 carries an appended correction of the cause given for Lineage 20. The verdict is unchanged: a table the lineage did not adopt never makes it pass." ;
    backlog:verifiedAt "2026-10-29T23:00:04Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_archived_digest_tables_probe_v1_0_0.py" ;
    backlog:satisfiedByArtifact "03-tooling/backlog_archived_digest_check_v1_1_0.py" ; backlog:belongsToLineage fw:L_AdaptiveProof2 .
