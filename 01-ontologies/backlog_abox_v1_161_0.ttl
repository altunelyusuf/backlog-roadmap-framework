fw:Demo_PD_DatesFollowTheWork a backlog:DemoRun ; backlog:hasWorkKind backlog:WorkKind_Control ; backlog:demonstratesItem fw:ST_PD_DatesFollowTheWork ; backlog:demonstratedAgainst fw:AC_PD_DatesFollowTheWork ; backlog:demoAt "2026-11-02T11:33:39Z"^^xsd:dateTime ;
