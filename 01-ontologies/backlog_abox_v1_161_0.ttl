fw:Ev_IK_RaiseAdviseClear a backlog:TestEvidence ; rdfs:label "The check for story RaiseAdviseClear"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "RaiseAdviseClear" ;
    backlog:hasTestSpec "03-tooling/backlog_impediment_probe_v1_0_0.py" ;
    backlog:attestsCriterion fw:AC_IK_RaiseAdviseClear ;
    backlog:hasVerificationMethod "The tool was run on a scratch register holding the real kinds and ways and on a copy of the real register, and the real validator was run on what it wrote, with a control that proves the check can fail. Parallel raises and clears, a write cut short by a size limit, killed processes, odd statements and malformed times were tried. The monitor and the report were run on planted registers with hand-computed hours. The one obstacle of the lineage met after the ways existed was entered with the tool." ;
    backlog:verifiedAt "2026-11-02T18:26:23Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_impediment with its probe, backlog_agent_monitor 1.3.0, backlog_date_report 1.1.0 with their probes, and four independent verifying agents (four reviews)" ;
    backlog:satisfiedByArtifact "03-tooling/backlog_impediment_probe_v1_0_0.py" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:AC_IK_RaiseAdviseClear backlog:satisfiedByArtifact "03-tooling/backlog_impediment_probe_v1_0_0.py" .
