    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_AgenticProof ;
    backlog:hasStateDigest "2398e91b078953e5af87b0e1692d194f32fd90abc75719fd5b12c1cacb78f4f8" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.485.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 25, opened under the agentic adaptive profile (AAL), profile revision 10. Stage 1 of 5, one release each." .

# ---- Lineage 25: Scope stage ----
