    backlog:areaMeasure "Counted 2026-11-02: the overseer's list at the close of a box names the box's own iteration as In Progress with no move; one box (Lineage 26 box 1) carries such findings that can no longer be corrected." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_RecordIntegrity .
