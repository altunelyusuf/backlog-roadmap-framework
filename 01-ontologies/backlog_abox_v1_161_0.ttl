    backlog:deliverableForArea fw:Area_AP_Proof ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "carried on real work from an immature mission" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
