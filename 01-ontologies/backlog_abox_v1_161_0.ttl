# The record each retired lineage leaves in the live register: a LineageArchiveEntry, not a
# Lineage -- no shape targeting Lineage, Mission or any stage element fires on retired work (G92).
fw:ArchiveEntry_L_AdaptiveCeremonies a backlog:LineageArchiveEntry ;
    backlog:entryForLineage <http://example.org/backlog-framework-register#L_AdaptiveCeremonies> ;
    backlog:entryForMission <http://example.org/backlog-framework-register#Mission_AdaptiveCeremonies> ;
    backlog:entryOutcome backlog:Out_Achieved ;
    backlog:entryOrdinal 20 ;
    backlog:archiveFile "01-ontologies/archive/backlog_framework_archive_abox_v1_15_0.ttl" ;
    backlog:archivedAt "2026-10-29T11:35:09Z"^^xsd:dateTime ;
    backlog:archivalTrigger "Retired whole by backlog_lineage_archive_v2_0_0: mission Out_Achieved, closure report present, every item Done or Cancelled, not frozen. Everything the lineage owned -- its Lineage individual, its Mission, its closure report, its stage outputs, findings and items -- moved to the archive file; this entry is the only thing that remains, and it is a record, not a lineage (G92)." .
fw:L_AdaptiveCeremonies backlog:lineageArchived true ; backlog:archiveFile "01-ontologies/archive/backlog_framework_archive_abox_v1_15_0.ttl" ;
    backlog:archivedAt "2026-10-29T11:35:09Z"^^xsd:dateTime ; backlog:hasLineageStatus backlog:LS_Archived ;
    backlog:archivalTrigger "Found achieved and un-archived by backlog_lineage_archive_v2_1_0: mission Out_Achieved, closure report present, every item Done or Cancelled, not frozen. Owner's rule 2026-09-09: an achieved lineage found triggers the archival activity." .

fw:L_AdaptiveProof a backlog:Lineage ; rdfs:label "Lineage 21: the adaptive profile proved on real work"@en ;
    backlog:lineageOrdinal 21 ;
    backlog:lineageArchived false ;
    backlog:lineageForMission fw:Mission_AdaptiveProof ;
    backlog:hasLineageStatus backlog:LS_Abandoned;
    backlog:hasLineageDepthLevel backlog:Depth_StoryDirect ;
    backlog:hasLineageArtifactDomain backlog:Domain_Infrastructure ;
    backlog:memberOfContainer fw:Register .
fw:L_AdaptiveProof backlog:openedWithProfile backlog:Profile_Adaptive ;
    backlog:openedUnderRevision backlog:Pr_7 ;
    backlog:adoptionRecordedAtOpen true ;
    backlog:adoptsRuleSet
        backlog:RS_CancellationAssessed ,
        backlog:RS_CeremonyKinds ,
        backlog:RS_ChainBothWays ,
        backlog:RS_ChangeSupportsMission ,
        backlog:RS_ConcurrentLineages ,
        backlog:RS_DecompositionStateAgrees ,
        backlog:RS_FlowPointsRecorded ,
        backlog:RS_ImpedimentNamesWhatItBlocks ,
        backlog:RS_ObligationsFollowStatus ,
        backlog:RS_PlanBeforeStart ,
        backlog:RS_ReadinessChecked ,
        backlog:RS_RepairReprioritises ,
        backlog:RS_ReviewNeedsControlRun ,
        backlog:RS_StatusHistoryRecorded .
fw:Mission_AdaptiveProof a backlog:Mission ; rdfs:label "Mission: the adaptive profile is proved on real work"@en ;
    backlog:hasMissionStatement "A lineage run under the adaptive profile is carried on real work from an immature mission, matured step by step in time-boxed iterations; its ceremonies are recorded and judged by the rules it adopted, and the faults that were made by hand are removed by a lineage-step tool." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-10-29 14:32: 'If you say the objectives are met, the scope is covered we can close the lineage rather than change management. For all remaining let's build an adaptive lineage and test it under real work.' Owner, 2026-10-29 13:01: what the adaptive lineage needs belongs in its own context and scope, and the lineage-step tool is needed for it to work correctly." ;
    backlog:hasMissionOutcome backlog:Out_Abandoned;
    backlog:producedByStage fw:Out_Mission_AdaptiveProof ;
    backlog:decidedBy backlog:Owner ;
    backlog:outcomeRationale "Closed as failed on the Owner's decision of 2026-10-29. The first application of the adaptive profile could not commit its first box: the profile adopted no digest table, so a planned task moved the recorded Backlog digest. The post-mortem records fourteen findings, among them the missed steps of the chain and of the opening of the box. Remedy built: profile revision 8, a shape and a probe (G177), and the step tool with its probe. The remaining scope passes to a successor lineage." .
fw:Out_Mission_AdaptiveProof a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_AdaptiveProof ;
    backlog:hasStateDigest "56ef4d971b2f239ca31ba4b74500cbdd8ef9991f0064054c6500323b386441ff" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.455.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 21, opened under the adaptive profile as the live proof that Lineage 20 did not give. Stage 1 of 5, one release each. The mission is stated immature on purpose: scope, goals, objectives and backlog mature in the following stages from the gaps Lineage 20 left on its closure report." .

# ---- Lineage 21: Scope stage ----

fw:Scope_AdaptiveProof a backlog:ScopeStatement ; rdfs:label "Scope: the adaptive profile proved on real work"@en ;
    backlog:hasScopeStatementText "Prove the adaptive profile on this lineage's own work, with five parts that the closure of Lineage 20 named as missing and nothing else: (1) the archive checks agree with the live gate and the archive tool leaves nothing behind; (2) a step tool that records a box in order with the clock and refuses the by-hand faults found in Lineage 20; (3) a decision for each of the eight opt-in rule sets and the profile revision that follows; (4) a gate that does not re-run what a record cannot change; (5) every box judged by the ceremony rule sets, and a post-mortem of this first application before the closure. Reuse the existing steps tool, probes and rulings; add no profile other than a revision of the adaptive one." ;
    backlog:scopeForMission fw:Mission_AdaptiveProof ;
    backlog:producedByStage fw:Out_Scope_AdaptiveProof ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_AP_D1 , fw:Del_AP_D2 , fw:Del_AP_D3 , fw:Del_AP_D4 , fw:Del_AP_D5 , fw:Del_AP_D6 , fw:Del_AP_D7 ;
    backlog:coversArea fw:Area_AP_Archive , fw:Area_AP_Step , fw:Area_AP_Profile , fw:Area_AP_Gate , fw:Area_AP_Proof ;
    backlog:hasScopeExclusion fw:Ex_AP_Default , fw:Ex_AP_Others , fw:Ex_AP_Validator , fw:Ex_AP_Closed , fw:Ex_AP_Teams ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Area_AP_Archive a backlog:ScopeArea ; rdfs:label "Area: Archive checks: what an archived lineage leaves behind and how it is judged"@en ;
    backlog:areaMeasure "Counted 2026-10-29: the archived-digest check lists 12 archived lineages as not reproducing, one of them (Lineage 20) only because the check reads the archive alone while the live gate reads the register's digest table; the archive tool left 59 statements of Lineage 20 in the live register because they were written in full-IRI form." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Area_AP_Step a backlog:ScopeArea ; rdfs:label "Area: Execution: the faults made by hand when a box is recorded"@en ;
    backlog:areaMeasure "Counted 2026-10-29: four classes of by-hand fault were found in boxes 4 to 9 of Lineage 20 (records composed in one pass, a record edited in place, work done before its box was opened, a name changed by hand); no tool refuses any of them. The step tool of the package has 4 commands (plan, assess, close, adapt) and none records a box." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Area_AP_Profile a backlog:ScopeArea ; rdfs:label "Area: Profile: the opt-in rule sets that no profile decides"@en ;
    backlog:areaMeasure "Counted 2026-10-29: 8 rule sets are in no profile; 2 are adopted by the register, 6 by nothing; the adaptive profile has a recorded decision on 0 of the 8." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Area_AP_Gate a backlog:ScopeArea ; rdfs:label "Area: Cost: what a release gate spends on records"@en ;
    backlog:areaMeasure "Counted 2026-10-29: the gate of release 1.455.0 spent 2195 s in its first attempt, 1720 s of them on probes that re-ran because the register file changed; 28 of 52 probes read that file and 8 are now keyed on its reference part." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Area_AP_Proof a backlog:ScopeArea ; rdfs:label "Area: Proof and learning: the profile judged on live work, and what the first run taught"@en ;
    backlog:areaMeasure "Counted 2026-10-29: 0 lineages opened under the adaptive profile after its last revision have closed a box; Lineage 20 adopted none of the five ceremony rule sets; no post-mortem of a first application exists." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Del_AP_D1 a backlog:ScopeDeliverable ; rdfs:label "An archived lineage's recorded stage digests are checked against the same digest table the live gate uses, so a lineage that reproduces live is not listed as failing in the archive"@en ;
    backlog:deliverableForArea fw:Area_AP_Archive ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "carried on real work from an immature mission" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Del_AP_D2 a backlog:ScopeDeliverable ; rdfs:label "The archive tool moves every statement of an archived lineage whatever its IRI form, and leaves none in the live register"@en ;
    backlog:deliverableForArea fw:Area_AP_Archive ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "carried on real work from an immature mission" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Del_AP_D3 a backlog:ScopeDeliverable ; rdfs:label "A step tool records each action of a box with the clock time of its run, in order, and refuses to close a box when a governed file was changed before the box was opened or when a record present at the last commit was changed or removed"@en ;
    backlog:deliverableForArea fw:Area_AP_Step ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "the faults that were made by hand are removed by a lineage-step tool" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
