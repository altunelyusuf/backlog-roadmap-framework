    backlog:closedAtCommit "backlog-roadmap-framework-v1.471.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 23, opened under profile revision 9. Stage 1 of 5, one release each." .

