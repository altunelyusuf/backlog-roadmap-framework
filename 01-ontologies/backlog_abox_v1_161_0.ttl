# ---- Lineage 31 (urgent): a release is as short as the change it carries: opening and Mission stage ----
fw:L_GateSpeed a backlog:Lineage ; rdfs:label "Lineage 31: a release is as short as the change it carries"@en ;
    backlog:lineageOrdinal 31 ;
    backlog:lineageArchived false ;
    backlog:lineageForMission fw:Mission_GateSpeed ;
    backlog:hasLineageStatus backlog:LS_InProgress ;
    backlog:hasLineageDepthLevel backlog:Depth_StoryDirect ;
    backlog:hasLineageArtifactDomain backlog:Domain_Infrastructure ;
    backlog:memberOfContainer fw:Register .
fw:L_GateSpeed backlog:openedWithProfile backlog:Profile_AgenticAdaptive ;
    backlog:openedUnderRevision backlog:Pr_13 ;
    backlog:humanApprovalLevel 3 ;
    backlog:adoptionRecordedAtOpen true ;
    backlog:adoptsRuleSet
        backlog:RS_AgentAccountability ,
        backlog:RS_CancellationAssessed ,
        backlog:RS_CeremonyKinds ,
        backlog:RS_ChainBothWays ,
        backlog:RS_ChangeSupportsMission ,
        backlog:RS_ConcurrentLineages ,
        backlog:RS_DecompositionStateAgrees ,
        backlog:RS_DigestTable_v5 ,
        backlog:RS_FlowPointsRecorded ,
        backlog:RS_ImpedimentNamesWhatItBlocks ,
        backlog:RS_ImpedimentsKnown ,
        backlog:RS_IndependentVerification ,
        backlog:RS_ObligationsFollowStatus ,
        backlog:RS_PlanBeforeStart ,
        backlog:RS_PlannedDates ,
        backlog:RS_ReadinessChecked ,
        backlog:RS_RepairReprioritises ,
        backlog:RS_ReviewNeedsControlRun ,
        backlog:RS_StateReflectsEvidence ,
        backlog:RS_StatusHistoryRecorded ,
        backlog:RS_VerifierSession .

fw:Mission_GateSpeed a backlog:Mission ; rdfs:label "Mission: a release is as short as the change it carries"@en ;
    backlog:hasMissionOutcome backlog:Out_InFlight ;
    backlog:hasMissionStatement "A release of the framework takes the time its change needs and no more: the checks run in full wherever a change can affect them and are not repeated where it cannot, where the time goes is recorded for every release, and no check is removed or weakened to save time." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-11-03 14:29 Istanbul: a solution is needed for such long work, it is a waste of time and resources; 14:47: add the remediation of long work as the next urgency; 15:50: pause the cost-saving lineage and finish the shortening first. Measured 2026-11-03 on three full releases: the gate took 1,752 s (4.2.0, cold cache; 39 probes run, 1,196 s), 866 s in total (4.2.1, warm cache; 17 probes, 303 s) and a light stage release 368 s; the checks that run on every gate, lineage order, register, flow points, Gate R and fixture coverage, took about 465 s in the cold gate; probes run two at a time on 2 cores." ;
    backlog:producedByStage fw:Out_Mission_GateSpeed ;
    backlog:decidedBy backlog:Owner .
fw:Out_Mission_GateSpeed a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_GateSpeed ;
    backlog:hasStateDigest "c4912f43e6e1797cf24d13cb35a36a173a3d7de4c57d9923ec1588dea77ca1fa" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v4.2.3 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 31, an urgent lineage of its own, opened under the agentic adaptive profile (AAL), profile revision 13. Stage 1 of 5." .

# ---- Lineage 31: Scope stage ----
fw:Scope_GateSpeed a backlog:ScopeStatement ; rdfs:label "Scope: where the release time goes and how little of it a change needs"@en ;
    backlog:hasScopeStatementText "Make the release gate spend its time only where a change can affect it, and record where the time goes: the time of every section and probe is kept per release; the probe loop and the checks that run on every release are shortened by running a check only when its inputs changed and by not repeating work between checks; no check is removed or weakened." ;
    backlog:scopeForMission fw:Mission_GateSpeed ; backlog:producedByStage fw:Out_Scope_GateSpeed ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_GS_D1 , fw:Del_GS_D2 , fw:Del_GS_D3 , fw:Del_GS_D4 ;
    backlog:coversArea fw:Area_GS_Know , fw:Area_GS_Probes , fw:Area_GS_Fixed , fw:Area_GS_Kept ;
    backlog:hasScopeExclusion fw:Ex_GS_Checks , fw:Ex_GS_Machine , fw:Ex_GS_Tools , fw:Ex_GS_Packages ;
    backlog:belongsToLineage fw:L_GateSpeed .
fw:Area_GS_Know a backlog:ScopeArea ; rdfs:label "Area 1 Know: where the time goes is recorded for every release"@en ;
    backlog:areaMeasure "Counted 2026-11-03: the gate writes a timing file per section outside the package; 34 sections and 63 probes, none of their times are kept in the package." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "03-tooling/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Area_GS_Probes a backlog:ScopeArea ; rdfs:label "Area 2 Probes: a probe runs when a change can affect it"@en ;
    backlog:areaMeasure "Counted 2026-11-03: 63 probes in the gate list; a full gate after a tool change ran 39 of them in 1,196 s; a shared shape or tool file invalidates many probes at once; probes run 2 at a time on 2 cores." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "03-tooling/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Area_GS_Fixed a backlog:ScopeArea ; rdfs:label "Area 3 Fixed: the checks that run on every release"@en ;
    backlog:areaMeasure "Counted 2026-11-03: lineage order 116 s, Gate R 79 s, flow points 52 s, register under test 48 s and fixture coverage 170 s, 465 s together, on every full gate, and lineage order about 105 s even on a light one." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "03-tooling/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Area_GS_Kept a backlog:ScopeArea ; rdfs:label "Area 4 Kept: no check is removed or weakened"@en ;
    backlog:areaMeasure "Every check of the release gate still runs on every change that can affect it." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "03-tooling/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Del_GS_D1 a backlog:ScopeDeliverable ; rdfs:label "1.1 The seconds of every gate section and of every probe are recorded in the package for each release"@en ;
    backlog:deliverableForArea fw:Area_GS_Know ; backlog:hasScopeLayer backlog:Layer_Product ; backlog:hasProductScopeKind backlog:Kind_Functional ;
    backlog:derivesFromMissionClause "a release takes the time its change needs and no more" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Del_GS_D2 a backlog:ScopeDeliverable ; rdfs:label "2.1 The probe loop of a full gate after a tool change, with a cold cache, takes at most the agreed number of seconds"@en ;
    backlog:deliverableForArea fw:Area_GS_Probes ; backlog:hasScopeLayer backlog:Layer_Product ; backlog:hasProductScopeKind backlog:Kind_NonFunctional ;
    backlog:derivesFromMissionClause "a release takes the time its change needs and no more" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Del_GS_D3 a backlog:ScopeDeliverable ; rdfs:label "3.1 The checks that run on every full gate take together at most the agreed number of seconds"@en ;
    backlog:deliverableForArea fw:Area_GS_Fixed ; backlog:hasScopeLayer backlog:Layer_Product ; backlog:hasProductScopeKind backlog:Kind_NonFunctional ;
    backlog:derivesFromMissionClause "a release takes the time its change needs and no more" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Del_GS_D4 a backlog:ScopeDeliverable ; rdfs:label "4.1 Every check still runs in full wherever a change can affect it, no check is removed or weakened, and a check is skipped only on a recorded proof that its inputs are unchanged"@en ;
    backlog:deliverableForArea fw:Area_GS_Kept ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "a release takes the time its change needs and no more" ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Ex_GS_Checks a backlog:ScopeExclusion ; rdfs:label "Exclusion: Removing, weakening or skipping a check without a proof that"@en ;
    backlog:excludesConcern "Removing, weakening or skipping a check without a proof that its inputs are unchanged." ; backlog:hasExclusionRationale "No check is traded for time." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Ex_GS_Machine a backlog:ScopeExclusion ; rdfs:label "Exclusion: Changing the machine, the number of cores or the network"@en ;
    backlog:excludesConcern "Changing the machine, the number of cores or the network." ; backlog:hasExclusionRationale "Outside the framework; the Owner decides it." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Ex_GS_Tools a backlog:ScopeExclusion ; rdfs:label "Exclusion: The cost tools of Lineage 30 and their probe"@en ;
    backlog:excludesConcern "The cost tools of Lineage 30 and their probe." ; backlog:hasExclusionRationale "They belong to the paused Lineage 30." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Ex_GS_Packages a backlog:ScopeExclusion ; rdfs:label "Exclusion: Any other package, and the work of Lineages 29 and 30"@en ;
    backlog:excludesConcern "Any other package, and the work of Lineages 29 and 30." ; backlog:hasExclusionRationale "One lineage at a time; the others are interrupted, not changed." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_GateSpeed .
fw:Out_Scope_GateSpeed a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Scope ; backlog:belongsToLineage fw:L_GateSpeed ;
    backlog:consumesOutput fw:Out_Mission_GateSpeed ;
    backlog:hasStateDigest "b7d2e150e4d813f61fc2acdabb733192d130f0faac78199412593e16c328a9a0" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v4.2.3 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Scope stage of Lineage 31: three areas of work and a kept area, four deliverables in two layers, four exclusions. Stage 2 of 5." .

