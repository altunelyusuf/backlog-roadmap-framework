    backlog:hasIdentifier "RI-S01" ; backlog:hasTitle "The monitor does not report the box being closed as stalled" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer fw:Register ; backlog:belongsToLineage fw:L_RecordIntegrity ;
    backlog:pursuesObjective fw:Obj_RI_Monitor ; backlog:satisfiesDeliverable fw:Del_RI_D1 ;
    backlog:hasInvestmentCategory backlog:Cat_Compliance ;
    backlog:hasAcceptanceCriterion fw:AC_RI_MonitorNotStalled ;
    backlog:hasReach 4.0 ; backlog:hasImpact 3.0 ; backlog:hasConfidence 0.9 ; backlog:hasEffort 2.0 ;
    backlog:hasPriorityScore 5.4 ;
    backlog:hasExecutionModality backlog:Mode_Automated ;
    backlog:producedByStage fw:Out_Backlog_RecordIntegrity .
fw:AC_RI_PlaceCovers a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a plan fixed by the digest, When only the register changes, or only a git-ignored file is added, or a file is renamed, Then the digest differs from the frozen one and the statement records the place as changed." .
