fw:Ev_AP2_GateKeys a backlog:TestEvidence ; rdfs:label "The check for story GateKeys"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "GateKeys" ;
    backlog:hasTestSpec "03-tooling/backlog_gate_v1_76_0.sh" ;
    backlog:attestsCriterion fw:AC_AP2_GateKeys ;
    backlog:hasVerificationMethod "Gate 1.76.0 keys four register-independent sections (cache proof, Gate R self-proof, register-path self-proof, lineage-order self-proof) on one key over every tool, fixture, shape and vocabulary file, not the register, and runs the archived-lineages check once. Three over-processing faults found by profiling were repaired with identical verdicts: the self-application check parsed two files about 200 times (103 s to 1.6 s), the lineage-order check parsed the register at a commit again for every probe of every adoption (95 s to 16 s), the flow-point trace parsed the register at every commit of its history (30 s to 16 s, kept on disk by blob hash). The release tool 1.9.0 also runs the link-control probe in its preflight." ;
    backlog:verifiedAt "2026-10-30T01:31:50Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_gate_keys_probe_v1_0_0.py + backlog_self_application_probe_v1_0_0.py" ;
