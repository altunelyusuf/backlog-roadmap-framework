#################################################################
#  v1.460.0 -- G177: a lineage that plans work adopts a digest table that does not count its tasks (found by Lineage 21, the first application of the adaptive profile).
#################################################################

backlog:Pr_8 a owl:NamedIndividual , backlog:ProfileRevision ; rdfs:label "Profile revision 8"@en ; backlog:revisionNumber 8 ; skos:definition "Release 1.460.0 (G177) adds to the adaptive profile the digest table v5, so that a lineage opened under it can plan work after its chain has closed without moving the recorded digests."@en .

backlog:Profile_Adaptive backlog:profileIncludes backlog:RS_DigestTable_v5 .
fw:Ruling_G177 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G177" ;
    rdfs:label "A lineage that plans work adopts a digest table that does not count its tasks"@en ;
    backlog:hasRulingStatement "A lineage that records its adoption at its opening and plans an execution task adopts digest table v4 or v5" ;
    backlog:enforcedByShape backlog:LineagePlansUnderDigestTableShape ;
    backlog:rulingSource "LINEAGE_RULING_NARRATIVES v141.0.0, section G177." .
fw:Ruling_G177 backlog:rulingDecides backlog:Pr_8 , backlog:RS_DigestTable_v5 .

fw:Ruling_G178 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G178" ;
    rdfs:label "A chain-stage release that only adds records passes a light gate"@en ;
    backlog:hasRulingStatement "A release of one chain stage that changes records alone passes the light gate with its own commit, and the fifth release of a batch runs the full gate" ;
    backlog:enforcedByShape backlog:StageOrderWitnessShape , backlog:StageOutputShape ;
    backlog:rulingSource "LINEAGE_RULING_NARRATIVES v142.0.0, section G178." .

# ---- Lineage 21: post-mortem of the first application of the adaptive profile (written before the closure) ----

fw:Find_AP_PM_StageObligationsUnread a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:hasRootCause "In three of the five stage records and in the first opening of the box, the shapes that bind at the status being entered were not read first: the Scope stage had no Blueprint and no domain entity, the Goal stage no containment goal, the Backlog stage an undeclared category and an empty-reading criterion, the Objective stage named stories that did not exist yet, and the first opening of the box left out the kick-off, the status, the concerns and the readiness of the tasks (ten violations). The validator or the gate caught each before the record was published, but each was found by being refused, not by reading what the status owes." ;
    backlog:hasRemedy "Not remedied. The step tool does the four obligations of the opening as code; it does not read the obligations of a status from the register. A later lineage should build that (the step tool prints, from the register, what the status being entered owes)." .
fw:Find_AP_PM_ProbeKeyStalePath a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:hasRootCause "The reference-only key of the gate (release 1.455.0) read the register path recorded in the probe's record. The register file is renamed every release, so the path was missing in the next release and all marked probes re-ran: 29 probes, 1,682 s in the gate of 1.456.0. The key's own probe renamed no file, so it could not see this." ;
    backlog:hasRemedy "Remedied in 1.457.0: the key reads the newest register file. The probe now uses the old path as a real record does after a release." .
fw:Find_AP_PM_ReferenceKeyHeaderVersion a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:hasRootCause "After that fix the marked probes still re-ran in 1.457.0 and 1.458.0 (1,234 s and 1,174 s of probes): the reference part of the register file included the version triples of its own header, which change in every release. The first records-only release that could have shown the saving (1.459.0) was the third attempt." ;
    backlog:hasRemedy "Remedied in 1.458.0 (backlog_probe_inputs 1.4.0 leaves the header version triples out); the gate of 1.459.0 then ran 11 probes, not 28." .
fw:Find_AP_PM_SavingClaimedUnmeasured a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "A gate time of 343 s was reported for release 1.455.0 as the new cost of a records-only release. It was a run in which most stamps happened to hold; the cost of that kind of release stayed 1,682 s. The claim was withdrawn when the next release showed it." ;
    backlog:hasRemedy "Remedied by disclosure. A cost is reported only from a release of the kind named." .
fw:Find_AP_PM_WrongCauseRecorded a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "Lineage 20 was put on the archived-digest baseline with the cause that the adaptive profile has no digest-table rule set. The register adopts the table; the archive check reads the archive alone and so chooses the table from the lineage's own adoption. The cause and the owed item (a profile rule set) were wrong, and the real fault was found only when this lineage met a related one." ;
    backlog:hasRemedy "Not remedied: the baseline entry still carries the wrong cause (deliverable D1 of this lineage, not built). To be corrected by appending." .
fw:Find_AP_PM_HelperInsertedAtWrongAnchor a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "A changelog helper inserted an entry at the first match of a heading text, in an old section. Found by reading the diff." ;
    backlog:hasRemedy "Remedied by placing text by a unique anchor." .
fw:Find_AP_PM_UnplannedWorkBetweenStages a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "The probe-key fix was released between the Scope stage and the Backlog stage as unplanned work, at the Owner's word that the gate-cost enhancement needed no lineage. It sits in the middle of the chain's releases, and the deliverable for gate cost then measured a fix made outside the box that was to build it." ;
    backlog:hasRemedy "Disclosed. Kept as the Owner decided; the changelog entries carry the unplanned-work line." .
fw:Find_AP_PM_ObjectiveNamedUnbornStories a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:hasRootCause "The Objective stage linked each objective to the stories that move its metric before the Backlog stage had created them; the archive-integrity gate refused the release (one 1,682 s gate spent). No shape says an objective may only name items that exist when its stage closes, and the digest ignores the link." ;
    backlog:hasRemedy "Remedied by moving the links to the Backlog stage. Not remedied: the order of stages and the links that need a later stage is not written down as a rule." .
fw:Find_AP_PM_ToolBeforeBox a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "A box cannot be opened with a tool that does not exist. The step tool, its probe and the gate wiring were drafted before box 1 opened, and three openings of the box were made and discarded uncommitted while the tool was finished (an identifier clash, a path of the published tree, a version header read as an edit, the lack of an identifier check)." ;
    backlog:hasRemedy "Disclosed in the record of the last opening. A tool a box needs is released before the box opens; the step tool is released with the closure of this lineage." .
fw:Find_AP_PM_ProbeNotRunAtUsageLevel a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:hasRootCause "The probe of the step tool put the package at the root of its repository; the real package sits one folder below, and the first live close failed on the path of the published tree. A check that was not run at the level at which the tool is used found nothing." ;
    backlog:hasRemedy "Remedied: the probe nests the package. The principle (run at the level you enforce) is already in the discipline and was not applied." .
fw:Find_AP_PM_DigestTableMissing a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:hasRootCause "The adaptive profile adopts no digest table, so a lineage opened under it reads table v1, which counts an execution task as Backlog-stage content. A planning event must produce a task, so the first box could not be committed: the recorded Backlog digest stopped reproducing. Adopting a table late is refused by the lineage-order check and a restart needs a bypass finding. The fault was in the profile from its first revision and was met at the first box close, after five stage releases." ;
    backlog:hasRemedy "Remedied for future lineages by G177: profile revision 8 adds the digest table v5, a shape refuses a lineage that plans under no table, and the open-lineage probe shows both outcomes. Not remedied for this lineage, which was closed as failed by the Owner's decision. The standard and agentic profiles carry the same gap and are left as they are." .
fw:Find_AP_PM_ChainCostWasFivefold a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "The chain of this lineage took five releases of about 17 to 33 minutes each before any box could start, and the fault above would have shown at the first planning event, which could have been tried on a scratch copy before the Scope stage. The lineage was opened on the strength of a profile that had been proved only on ceremonies, not on planning after a closed Backlog stage." ;
    backlog:hasRemedy "Not remedied. Before a profile is used for a live lineage, the whole path (open, chain, plan, close a box) is run once on a scratch copy of the register." .
fw:Find_AP_PM_GateFloorOfRecordsOnlyRelease a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "The gate of a release that only adds records took 647 s after the key fixes (target 400 s), plus 292 s for the publisher: 1,022 s in all. Eleven probes still re-ran because they read the register's own records, and about 430 s are sections that run in every release (self-application 96 s, shape reconcile 93 s, lineage order 86 s, archived lineages 36 s)." ;
    backlog:hasRemedy "Not remedied: deliverable D6 (the gate-cost target) was not reached. 647 s is the honest figure for a records-only release after 1.458.0; the 1,682 s of 1.456.0 was the cost of the key fault." .
fw:Find_AP_PM_ProfileCaughtFaults a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "What the adaptive profile did well: at the first opening of the box, the adopted rule sets refused ten faults that a by-hand box would have committed (no kick-off, a lineage status behind its work, no readiness check of the tasks, a start instant that was not the first move into In Progress). The refusals were specific and led straight to the fix." ;
    backlog:hasRemedy "Kept. This is the only part of the profile proved on real work in this lineage; the planning-after-close path, the review path and the closure of a box were not reached." .
backlog:RS_DigestTable_v5 backlog:introducedInRevision backlog:Pr_8 .

<http://example.org/backlog-framework-register#AsIs_1> a backlog:AsIsAssessment ; backlog:assessesLineage <http://example.org/backlog-framework-register#L_AdaptiveProof> ;
    backlog:assessedAt "2026-10-29T19:47:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasFitGapStatement "As-is: the chain (mission, scope, goals, objectives, backlog) is recorded and reproduces; none of the nine stories is started or done in the register; the step tool, its probe and the profile revision exist as released work outside any box. Gap: no box could be committed, because the adaptive profile adopts no digest table and so a planned task changes the closed Backlog stage's digest (G177). Eight objectives were measured at their baselines and none has moved." ;
    backlog:hasImpactStatement "Closing now loses nothing recorded: the nine stories, the objectives and the findings pass to a successor lineage. Continuing would need a late adoption that the lineage-order check refuses, or a restart that needs a bypass finding. The Owner decided on 2026-10-29 to close as failed and open a successor." ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_ArchiveForms> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_BoxesJudged> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_Decisions> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_DigestCheck> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_GateKeys> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_PostMortem> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_ProfileRevision> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_StepGuards> ;
    backlog:dueItem <http://example.org/backlog-framework-register#ST_AP_StepRecord> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_Boxes> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_Contained> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_Digest> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_Forms> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_Gate> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_MissionMet> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_PostMortem> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_Profile> ;
    backlog:gapsObjective <http://example.org/backlog-framework-register#Obj_AP_Step> .

<http://example.org/backlog-framework-register#Closure_1> a backlog:ClosureReport ; backlog:closesForMission <http://example.org/backlog-framework-register#Mission_AdaptiveProof> ; backlog:reportGeneratedAt "2026-10-29T19:47:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasClosureMark backlog:Cm_Failed ; backlog:citesAssessment <http://example.org/backlog-framework-register#AsIs_1> ; backlog:hasClosureSummary "Closed as failed on the Owner's decision of 2026-10-29. The first application of the adaptive profile could not commit its first box: the profile adopted no digest table, so a planned task moved the recorded Backlog digest. The post-mortem records fourteen findings, among them the missed steps of the chain and of the opening of the box. Remedy built: profile revision 8, a shape and a probe (G177), and the step tool with its probe. The remaining scope passes to a successor lineage." .

<http://example.org/backlog-framework-register#Closure_1> backlog:reportsOnObjective fw:Obj_AP_MissionMet , fw:Obj_AP_Digest , fw:Obj_AP_Forms , fw:Obj_AP_Step , fw:Obj_AP_Profile , fw:Obj_AP_Gate , fw:Obj_AP_Boxes , fw:Obj_AP_PostMortem , fw:Obj_AP_Contained ;
    backlog:citesFinding fw:Find_AP_PM_StageObligationsUnread , fw:Find_AP_PM_ProbeKeyStalePath , fw:Find_AP_PM_ReferenceKeyHeaderVersion , fw:Find_AP_PM_SavingClaimedUnmeasured , fw:Find_AP_PM_WrongCauseRecorded , fw:Find_AP_PM_HelperInsertedAtWrongAnchor , fw:Find_AP_PM_UnplannedWorkBetweenStages , fw:Find_AP_PM_ObjectiveNamedUnbornStories , fw:Find_AP_PM_ToolBeforeBox , fw:Find_AP_PM_ProbeNotRunAtUsageLevel , fw:Find_AP_PM_DigestTableMissing , fw:Find_AP_PM_ChainCostWasFivefold , fw:Find_AP_PM_GateFloorOfRecordsOnlyRelease , fw:Find_AP_PM_ProfileCaughtFaults ;
    backlog:statesBestPractice "Before a profile is used for a live lineage, run the whole path once on a scratch copy of the register: open, chain, plan a task after the Backlog stage, close a box. The path that failed here was the one the profile had not been proved on." ,
        "A measure of cost is reported only from a release of the kind it names; a run in which stamps happened to hold is not a measurement." ,
        "A tool that a box needs is released before the box opens, and its probe runs at the level at which the tool is used." .

# ---- Lineage 22: opening and Mission stage ----
fw:L_AdaptiveProof2 a backlog:Lineage ; rdfs:label "Lineage 22: the adaptive profile proved on real work, second attempt"@en ;
    backlog:lineageOrdinal 22 ;
    backlog:lineageArchived false ;
    backlog:lineageForMission fw:Mission_AdaptiveProof2 ;
    backlog:hasLineageStatus backlog:LS_Achieved ;
    backlog:hasLineageDepthLevel backlog:Depth_StoryDirect ;
    backlog:hasLineageArtifactDomain backlog:Domain_Infrastructure ;
    backlog:memberOfContainer fw:Register .
fw:L_AdaptiveProof2 backlog:openedWithProfile backlog:Profile_Adaptive ;
    backlog:openedUnderRevision backlog:Pr_8 ;
    backlog:adoptionRecordedAtOpen true ;
    backlog:adoptsRuleSet
        backlog:RS_CancellationAssessed ,
        backlog:RS_CeremonyKinds ,
        backlog:RS_ChainBothWays ,
        backlog:RS_ChangeSupportsMission ,
        backlog:RS_ConcurrentLineages ,
        backlog:RS_DecompositionStateAgrees ,
        backlog:RS_DigestTable_v5 ,
        backlog:RS_FlowPointsRecorded ,
        backlog:RS_ImpedimentNamesWhatItBlocks ,
        backlog:RS_ObligationsFollowStatus ,
        backlog:RS_PlanBeforeStart ,
        backlog:RS_ReadinessChecked ,
        backlog:RS_RepairReprioritises ,
        backlog:RS_ReviewNeedsControlRun ,
        backlog:RS_StatusHistoryRecorded .

fw:Mission_AdaptiveProof2 a backlog:Mission ;
    backlog:hasMissionOutcome backlog:Out_Achieved ;
    backlog:outcomeRationale "Achieved. All seven deliverables of the scope are satisfied by work that is Done and shipped in a package (D1 in an adapted form, its premise having been measured false), the nine objectives are at target, three boxes are recorded in order by the step tool and judged clean, and the post-mortem is written. See the closure report for what is not claimed." ; rdfs:label "Mission: the adaptive profile completes its proof on real work"@en ;
    backlog:hasMissionStatement "A lineage run under the revised adaptive profile carries real work from an immature mission through to a closure, its boxes recorded in order by the step tool and judged by the rules it adopted; the checks that judge archived and live lineages agree, and what the first application of the profile left undone is done." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-10-29, on the closure of Lineage 21 as failed: close it, release the step tool, add the digest table to the adaptive profile, and open a successor under the revised profile for the remaining deliverables. Gaps verified on the closure report of Lineage 21." ;
    backlog:producedByStage fw:Out_Mission_AdaptiveProof2 ;
    backlog:decidedBy backlog:Owner .
fw:Out_Mission_AdaptiveProof2 a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_AdaptiveProof2 ;
    backlog:hasStateDigest "a85397ae61bf41fb8a7b0f975b8c97c3dbe9574fde0aedb95742494f4bac8344" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.461.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 22, opened under profile revision 8 which adopts the digest table that lets planned work follow the Backlog stage. Stage 1 of 5, one release each." .

# ---- Lineage 22: Scope stage ----

fw:Scope_AdaptiveProof2 a backlog:ScopeStatement ; rdfs:label "Scope: the adaptive profile proved on real work"@en ;
    backlog:hasScopeStatementText "Finish the proof of the adaptive profile on this lineage's own work, with the parts that Lineage 21 left undone and nothing else: (1) the archive checks agree with the live gate and the archive tool leaves nothing behind; (2) the step tool reads the obligations of a status from the register; (3) a decision for each of the eight opt-in rule sets and the profile revision that follows; (4) a gate that does not re-run what a record cannot change; (5) every box recorded with the step tool and judged by the ceremony rule sets, and a post-mortem of this lineage before its closure. Reuse the existing step tool, probes and rulings; add no profile other than a revision of the adaptive one." ;
    backlog:scopeForMission fw:Mission_AdaptiveProof2 ;
    backlog:producedByStage fw:Out_Scope_AdaptiveProof2 ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
