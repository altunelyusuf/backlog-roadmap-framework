    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:relatesToWorkItem fw:ST_AA_IndependentReview ;
    backlog:hasRootCause "the independent reviewer agent (an Explore agent that did not write the work): said that with integrity level 2 and the level 3 no person approves this family of work, which sits uneasily with the profile's definition. True." ;
    backlog:hasRemedy "Stated in the narrative and handed to the Owner at the closure; not changed here." .
