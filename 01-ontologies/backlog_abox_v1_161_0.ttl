fw:Ev_AP2_StepObligations a backlog:TestEvidence ; rdfs:label "The check for story StepObligations"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "StepObligations" ;
    backlog:hasTestSpec "03-tooling/backlog_box_step_v1_1_0.py" ;
    backlog:attestsCriterion fw:AC_AP2_StepObligations ;
    backlog:hasVerificationMethod "The tool's owes command validates a copy of the register with the lineage moved to the named status and lists what is newly violated there; on the live register LS_Achieved lists the closure-report and open-item obligations, LS_InProgress lists nothing. open prints the same before it writes, and open and close validate what they wrote and put the register back and refuse on a new violation. The probe (17 expectations) plants a violation with a stub validator and shows the close refused with the register unchanged." ;
    backlog:verifiedAt "2026-10-29T23:00:02Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_box_step_probe_v1_1_0.py + backlog_validate_v1_17_0.py" ;
    backlog:satisfiedByArtifact "03-tooling/backlog_box_step_v1_1_0.py" ; backlog:belongsToLineage fw:L_AdaptiveProof2 .
fw:AC_AP2_StepObligations backlog:satisfiedByArtifact "03-tooling/backlog_box_step_v1_1_0.py" .
