fw:Mission_RecordIntegrity a backlog:Mission ;
    backlog:hasMissionOutcome backlog:Out_Achieved ;
    backlog:outcomeRationale "Achieved as worded, on three boxes, each checked by a fresh agent. The monitor no longer reports the box being closed, the place-unchanged statement covers the register, ignored files and renamed paths, and both returned answers are answered. Not claimed: that the digest sees every change (modes, bytecode paths, the reviews folder and empty directories are not seen), that the grant meets the Agentic-Systems rule that a person grants access (the Owner kept the builder agent as grantor below the approval level), or a stronger frozen record." ; rdfs:label "Mission: the record of a box in an agentic adaptive lineage is complete and true to what happened"@en ;
    backlog:hasMissionStatement "What an agentic adaptive lineage records of a box is complete and true to what happened: the agent monitor reports only what is stalled and not the box being closed, the statement that the place was unchanged covers every kind of change a box can make, and the answers returned by the two packages that hold the standard are answered." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-11-02 00:38: the handovers are answered; move on with the work from the returns plus the missing gaps the builder named, and upgrade the major version. Gaps verified: the monitor names the box being closed (five open findings on Lineage 26 box 1), the digest behind the place-unchanged statement leaves out the register, ignored files and the old path of a renamed file, and agentic-sdlc could not reproduce the count of 19 rule sets." ;
    backlog:producedByStage fw:Out_Mission_RecordIntegrity ;
    backlog:decidedBy backlog:Owner .
fw:Out_Mission_RecordIntegrity a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_RecordIntegrity ;
    backlog:hasStateDigest "ddbe0207486a3bfb7993764b77320b31ec8f3235e89f67c7bf478411f407de94" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.500.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 27, opened under the agentic adaptive profile (AAL), profile revision 11, as the default profile. Stage 1 of 5, one release each." .

# ---- Lineage 27: Scope stage ----
fw:Scope_RecordIntegrity a backlog:ScopeStatement ; rdfs:label "Scope: the record of a box"@en ;
    backlog:hasScopeStatementText "Do the work the returns and the verified gaps call for and nothing else: (1) the agent monitor does not report the box being closed as stalled; (2) the place-unchanged statement covers the register, git-ignored files and the old path of a renamed file; (3) a reply to each of the two returned answers; (4) the other profiles and closed lineages are not changed. Not built: a stronger frozen record and a witnessed start time, a person as grantor, a probe of the kick-off recording, the note filter beyond the step tool, the cost of the validator." ;
    backlog:scopeForMission fw:Mission_RecordIntegrity ;
    backlog:producedByStage fw:Out_Scope_RecordIntegrity ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_RI_D1 , fw:Del_RI_D2 , fw:Del_RI_D3 , fw:Del_RI_D4 ;
    backlog:coversArea fw:Area_RI_Monitor , fw:Area_RI_Place , fw:Area_RI_Handover , fw:Area_RI_Kept ;
    backlog:hasScopeExclusion fw:Ex_RI_Others , fw:Ex_RI_Packages , fw:Ex_RI_Person , fw:Ex_RI_Witness , fw:Ex_RI_Closed , fw:Ex_RI_Teams ;
    backlog:belongsToLineage fw:L_RecordIntegrity .
