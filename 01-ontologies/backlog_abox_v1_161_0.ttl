    backlog:areaMeasure "Counted 2026-11-01: the adaptive profile has no name that tells it is the non-agentic one, and no profile adds the two agentic rule sets to it." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_AgenticAdaptive .
