# ---- Lineage 27: Backlog stage ----
fw:Exec_Builder a backlog:Executor_SingleAgent ; rdfs:label "The builder agent: the session that does the work of a box"@en .
fw:Exec_Overseer a backlog:Executor_SingleAgent ; rdfs:label "The overseeing agent: the agent monitor, which reads the register and reports what needs attention"@en .
fw:Exec_Verifier a backlog:Executor_SingleAgent ; rdfs:label "The verifying agent: an agent that did not do the work and judges it against the evidence"@en .
fw:Exec_Approver a backlog:Executor_SingleAgent ; rdfs:label "The approving agent: the register validator, which accepts the box only if the register holds no new violation"@en .
fw:Run_RI_0_Builder a backlog:ExecutorInstance , backlog:Executor_SingleAgent ; backlog:instanceOf fw:Exec_Builder ; backlog:instantiatedFromVersion "1.7.0" ; backlog:instantiatedAt "2026-11-01T22:28:06Z"^^xsd:dateTime ; rdfs:comment "The run that wrote the backlog; the run of each box is added by the step tool when the box opens." .
fw:AC_RI_MonitorNotStalled a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a box being closed whose iteration is still In Progress, When the step tool asks the monitor, Then the monitor's list does not name the box's own items and still names a stalled item outside the box." .
