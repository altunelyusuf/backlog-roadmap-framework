fw:Ruling_G180 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G180" ;
    rdfs:label "A lineage whose status is behind its chain is refused"@en ;
    backlog:hasRulingStatement "A lineage that states Opened, Scoped, Goaled or Objectived while an active output of a later stage exists is refused: the status is a pointer to the chain and moves with it. The step tool opens a box with its deployment unit and refuses a checkpoint note that names a modelled thing by identifier (the tool and its probe enforce this; no shape can tell a note's words from a link)." ;
    backlog:enforcedByShape backlog:LineageStatusShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v144.0.0, section G180." .
