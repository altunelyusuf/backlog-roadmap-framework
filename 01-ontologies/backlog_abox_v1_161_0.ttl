    backlog:responsible fw:Run_CS_0_Builder ;
    backlog:coversEntity fw:Entity_IK_Lineage ; backlog:coversStage backlog:Stage_ActiveUse ;
    backlog:hasIdentifier "CS-S01" ; backlog:hasTitle "The three commands: a session start that says what changed, a first look at the changed probes, and a short reading of a gate log" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer fw:Register ; backlog:belongsToLineage fw:L_CostSaving ;
    backlog:pursuesObjective fw:Obj_CS_Start ; backlog:satisfiesDeliverable fw:Del_CS_D1 , fw:Del_CS_D2 , fw:Del_CS_D3 , fw:Del_CS_D4 ;
