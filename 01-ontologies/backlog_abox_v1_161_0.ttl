    backlog:belongsToLineage fw:L_VerifierSession .
fw:Area_VS_Gaps a backlog:ScopeArea ; rdfs:label "Area: Gaps: what the verifier of an AAL box does not record"@en ;
    backlog:areaMeasure "Counted 2026-11-01 by a test drive against the Agentic-Systems shapes (v0.78.0): eight gaps: no frozen plan, no grant, no start way, no session named, no place-unchanged statement, the configuration recorded is the tool version, the verifier run stamped after the review, the overseer escalation list not read." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_VerifierSession .
