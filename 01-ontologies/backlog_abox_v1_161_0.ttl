    backlog:closedAtCommit "backlog-roadmap-framework-v1.478.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 24, opened under profile revision 9 (NAAL). Stage 1 of 5, one release each." .

# ---- Lineage 24: Scope stage ----
fw:Scope_AgenticAdaptive a backlog:ScopeStatement ; rdfs:label "Scope: the agentic adaptive lineage beside the non-agentic one"@en ;
    backlog:hasScopeStatementText "Build the agentic adaptive lineage (AAL) beside the non-agentic adaptive lineage (NAAL) and nothing else: (1) name the adaptive profile NAAL, unchanged, and add the profile AAL as revision 10; (2) make the step tool record who made, oversaw, verified and approved, so that a box it records draws no violation of the two agentic rule sets; (3) let a profile be marked the default, with a shape and the opening tool; (4) have the post-mortem reviewed by an agent that did not write it. Each is carried out in boxes recorded with the step tool. Making AAL the default is the next lineage." ;
    backlog:scopeForMission fw:Mission_AgenticAdaptive ;
    backlog:producedByStage fw:Out_Scope_AgenticAdaptive ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_AA_D1 , fw:Del_AA_D2 , fw:Del_AA_D3 , fw:Del_AA_D4 ;
    backlog:coversArea fw:Area_AA_Profiles , fw:Area_AA_Accountability , fw:Area_AA_Default , fw:Area_AA_Review ;
    backlog:hasScopeExclusion fw:Ex_AA_Flip , fw:Ex_AA_Others , fw:Ex_AA_Human , fw:Ex_AA_Closed , fw:Ex_AA_Teams ;
    backlog:belongsToLineage fw:L_AgenticAdaptive .
