fw:Del_AP_D5 a backlog:ScopeDeliverable ; rdfs:label "Each of the eight opt-in rule sets has a recorded decision for the adaptive profile (included, or left opt-in with its reason), and the revision that includes the chosen ones is shown refusing a planted fault on a test register"@en ;
    backlog:deliverableForArea fw:Area_AP_Profile ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "its ceremonies are recorded and judged by the rules it adopted" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
fw:Del_AP_D6 a backlog:ScopeDeliverable ; rdfs:label "The release gate for a release that only adds records stays within a stated time, measured from the gate's own timing record on each release of this lineage"@en ;
    backlog:deliverableForArea fw:Area_AP_Gate ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "matured step by step in time-boxed iterations" ;
    backlog:belongsToLineage fw:L_AdaptiveProof .
