    backlog:hasStateDigest "66319123118853834543c5e0d1f04978cd379a8f93f3572983e1fb6c15a8d720" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v2.1.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 28, opened under the agentic adaptive profile (AAL), profile revision 11, as the default profile. Stage 1 of 5, one release each." .

# ---- Lineage 28: Scope stage ----
fw:Scope_PlannedDates a backlog:ScopeStatement ; rdfs:label "Scope: the plan of the dates"@en ;
    backlog:hasScopeStatementText "Plan the dates of the objectives and nothing else: (1) at planning each objective date is predicted from scope, effort and agent capacity, shown with its basis and kept as a base plan, and a date no base plan backs is refused; (2) the date is recomputed when stories are planned into iterations; (3) a report shows the base, updated and finished dates; (4) the other profiles and closed lineages are not changed. Not built: cost estimates, calendar pacing, dates of closed lineages." ;
