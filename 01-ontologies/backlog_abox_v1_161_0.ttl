    backlog:hasScopeExclusion fw:Ex_PD_Others , fw:Ex_PD_Packages , fw:Ex_PD_Past , fw:Ex_PD_Calendar , fw:Ex_PD_Cost ;
    backlog:belongsToLineage fw:L_PlannedDates .
