    backlog:areaMeasure "Counted 2026-10-30: adopting the agent-accountability rule set on the register adds 38 violations and the independent-verification rule set 6, because the step tool records no maker of a move and no verifier." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_AgenticAdaptive .
