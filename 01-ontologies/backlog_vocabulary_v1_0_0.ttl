# DERIVED FILE -- do not edit. Derived by 03-tooling/backlog_vocabulary_derive_v1_0_0.py: every individual the T-Box lists in an owl:oneOf list,
# with every statement the A-box makes about it. The gate refuses a release when this file differs from a fresh derivation.
@prefix backlog: <http://example.org/backlog#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos2: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/backlog-vocabulary> a owl:Ontology ;
    owl:versionIRI <http://example.org/backlog-vocabulary/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    rdfs:label "Backlog & Roadmap framework -- controlled vocabulary"@en ;
    rdfs:comment """The controlled individuals of the framework: the members of every closed enumeration the T-Box names (lifecycle states, investment categories, cost dimensions, and so on), without the framework's own register. A consumer pins this file beside the T-Box so the shapes that test membership with sh:class can find the individuals. Made for T-Box 1.124.0 and shapes 1.158.0; a new T-Box that adds or changes a member brings a new version of this file in the same release.""" .

backlog:AC_Confirmed a backlog:ArchivalConfirmationStatus,
        owl:NamedIndividual ;
    rdfs:label "Confirmed"@en ;
    skos2:definition "Checked once, against the shapes current at confirmation time, and found to hold its own era's standards. Once set, this lineage is permanently exempt from re-validation against any later rule -- the same principle as G89/G91's ruling that a rule change binds only work that declared it, applied per lineage rather than per file."@en .

backlog:AC_PendingConfirmation a backlog:ArchivalConfirmationStatus,
        owl:NamedIndividual ;
    rdfs:label "Pending confirmation"@en ;
    skos2:definition "Archived, but not yet checked against the shapes current at confirmation time -- honest, not wrong: the lineage's own content may well hold, this status only says nobody has checked yet."@en .

backlog:Ach_Met a backlog:AchievementStatus,
        owl:NamedIndividual ;
    rdfs:label "Met"@en ;
    skos2:definition "An observation exists on or after the deadline showing the target reached in the declared direction."@en .

backlog:Ach_Missed a backlog:AchievementStatus,
        owl:NamedIndividual ;
    rdfs:label "Missed"@en ;
    skos2:definition "The deadline has passed and the latest observation does not reach the target. A first-class outcome, because a framework in which nothing can be recorded as missed measures nothing."@en .

backlog:Ach_Pending a backlog:AchievementStatus,
        owl:NamedIndividual ;
    rdfs:label "Pending"@en ;
    skos2:definition "The deadline has not passed yet."@en .

backlog:Ach_Retrospective a backlog:AchievementStatus,
        owl:NamedIndividual ;
    rdfs:label "Retrospective"@en ;
    skos2:definition "The objective measures a fact about finished work and cannot move: the event it counts already happened. Distinct from Withdrawn, which says the measure was wrong — retrospective says it was right and can now only report. A retrospective objective must never read Met by having its number adjusted; it reads what it read, permanently."@en .

backlog:Ach_Withdrawn a backlog:AchievementStatus,
        owl:NamedIndividual ;
    rdfs:label "Withdrawn"@en ;
    skos2:definition "The objective was retired because it measured the wrong thing — normally a superseded mission's progress. Used in this register since v1.82.0 and never declared until v1.128.0, which is a term in use sitting outside its own closed enumeration."@en .

backlog:Adapt_BoundaryHolds a backlog:AdaptationOutcome,
        owl:NamedIndividual ;
    rdfs:label "Boundary holds"@en ;
    skos2:definition "The fit-gap found nothing outside the scope, so the boundary stands and only the link direction changes. Legitimate, and the outcome most likely to be claimed without the measurement: a scope drawn around past work fits that work by construction, so this outcome must rest on a recorded fit-gap and not on inspection."@en .

backlog:Adapt_BoundaryRewritten a backlog:AdaptationOutcome,
        owl:NamedIndividual ;
    rdfs:label "Boundary rewritten"@en ;
    skos2:definition "The fit-gap found work the boundary does not cover, so the scope is rewritten and the lineage beneath it revisited. Requires a ScopeChange recording what was admitted and why."@en .

backlog:Adapt_NotRequired a backlog:AdaptationOutcome,
        owl:NamedIndividual ;
    rdfs:label "Not required"@en ;
    skos2:definition "The lineage was already scope-first. Recorded rather than left silent, so a register can show that adaptation was considered and found unnecessary."@en .

backlog:Aud_Private a backlog:ModuleAudience,
        owl:NamedIndividual ;
    rdfs:label "Private"@en ;
    skos2:definition "The module is correspondence, an adopter's own material or a retired record: a public copy of the package leaves it out."@en .

backlog:Aud_Public a backlog:ModuleAudience,
        owl:NamedIndividual ;
    rdfs:label "Public"@en ;
    skos2:definition "The module may be published: a public copy of the package keeps it."@en .

backlog:AuditFacet a backlog:FrameworkFacet,
        owl:NamedIndividual ;
    rdfs:label "Audit Facet"@en ;
    skos2:definition "Per-item re-verification timestamps and audit notes, so coverage of a reconciliation pass is recorded item by item rather than implied. Required at conformance level L3."@en .

backlog:Basis_Analogous a backlog:EstimationBasisKind,
        owl:NamedIndividual ;
    rdfs:label "Analogous"@en ;
    skos2:definition "Derived from the recorded actuals of comparable completed work. Weaker than measurement because the comparison is a judgement, stronger than pure estimation because the reference figures are real. Should name the items it was drawn from."@en .

backlog:Basis_Judged a backlog:EstimationBasisKind,
        owl:NamedIndividual ;
    rdfs:label "Judged"@en ;
    skos2:definition "Arrived at by expertise and reasoning, with nothing executed. The honest default and the majority case. Recording it as such costs nothing and prevents a judgement being read as a measurement later, when whoever made it is no longer in the room."@en .

backlog:Basis_Measured a backlog:EstimationBasisKind,
        owl:NamedIndividual ;
    rdfs:label "Measured"@en ;
    skos2:definition "Produced by executing something against real artifacts — a trial run, a test drive, a spike, a query over the register itself. Must name the MetricObservation that produced it, so the figure is re-derivable rather than merely asserted to have been measured."@en .

backlog:Builder a backlog:Role,
        owl:NamedIndividual ;
    rdfs:label "Builder"@en ;
    skos2:definition "Performs the multi-factor scoring judgements with written rationale, maintains the gates and tooling, and surfaces every disclosed dependency and recorded gap for the owner's visibility rather than resolving them quietly."@en .

backlog:CScope_Framework a backlog:ContainerScope,
        owl:NamedIndividual ;
    rdfs:label "Framework-scoped"@en ;
    skos2:definition "Serves the framework across lineages and stays live. The Register is the case that forces this to exist: a register that archives with its contents cannot be read."@en .

backlog:CScope_Lineage a backlog:ContainerScope,
        owl:NamedIndividual ;
    rdfs:label "Lineage-scoped"@en ;
    skos2:definition "Serves one lineage and archives with it."@en .

backlog:Cancelled a backlog:LifecycleState,
        owl:NamedIndividual ;
    rdfs:label "Cancelled"@en ;
    skos2:definition "Withdrawn without delivery. A terminal state that carries no evidence obligation but must record a rationale, so abandoned scope stays visible instead of silently disappearing from the register."@en .

backlog:Cat_Compliance a backlog:InvestmentCategory,
        owl:NamedIndividual ;
    rdfs:label "Compliance"@en ;
    skos2:definition "Work required by an obligation external to the product's own goals. Ranks by deadline and consequence, not by value per unit effort."@en .

backlog:Cat_Maintenance a backlog:InvestmentCategory,
        owl:NamedIndividual ;
    rdfs:label "Maintenance"@en ;
    skos2:definition "Work that keeps what exists working: defect repair, dependency upkeep, operational support. Structurally disadvantaged by value-over-cost ranking, which is why it needs a policy share rather than a fair fight."@en .

backlog:Cat_NewCapability a backlog:InvestmentCategory,
        owl:NamedIndividual ;
    rdfs:label "New capability"@en ;
    skos2:definition "Work that adds something the product could not do before. Dominates before first launch and competes for capacity afterwards."@en .

backlog:Cat_TechnicalDebt a backlog:InvestmentCategory,
        owl:NamedIndividual ;
    rdfs:label "Technical debt"@en ;
    skos2:definition "Work that reduces the cost of future work rather than delivering user-visible value now. Its benefit is a change in someone else's job size, which no single item's score can express."@en .

backlog:Comp_APIDesign a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "API design"@en ;
    skos2:broader backlog:Comp_Design ;
    skos2:definition "Designing the interface a piece of software exposes to its callers."@en .

backlog:Comp_BacklogStewardship a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Backlog stewardship"@en ;
    skos2:broader backlog:Comp_Governance ;
    skos2:definition "Keeping a backlog's own register accurate, groomed and consistent with what is actually true."@en .

backlog:Comp_ClauseProof a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Clause proof"@en ;
    skos2:broader backlog:Comp_Verification ;
    skos2:definition "Writing the positive and negative fixtures that prove a constraint actually fires and actually stays silent on a correct twin."@en .

backlog:Comp_Coding a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Coding"@en ;
    skos2:broader backlog:Comp_Implementation ;
    skos2:definition "Writing the source code that implements a designed solution."@en .

backlog:Comp_ConceptualDataModeling a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Conceptual data modelling"@en ;
    skos2:broader backlog:Comp_Analysis ;
    skos2:definition "Modelling the entities and relations a domain involves, independent of any storage technology."@en .

backlog:Comp_DataMigration a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Data migration"@en ;
    skos2:broader backlog:Comp_Implementation ;
    skos2:definition "Moving data from one representation or store to another without losing or corrupting it."@en .

backlog:Comp_GovernanceRuling a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Governance ruling"@en ;
    skos2:broader backlog:Comp_Governance ;
    skos2:definition "Deciding a policy question for a framework or register and recording it as a checkable GovernanceRuling."@en .

backlog:Comp_ImpactAssessment a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Impact assessment"@en ;
    skos2:broader backlog:Comp_Analysis ;
    skos2:definition "Working out what a proposed change touches and what it breaks before it is made."@en .

backlog:Comp_IncidentResponse a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Incident response"@en ;
    skos2:broader backlog:Comp_Operations ;
    skos2:definition "Diagnosing and resolving a live problem once a development is in production."@en .

backlog:Comp_IntegrationBuild a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Integration build"@en ;
    skos2:broader backlog:Comp_Implementation ;
    skos2:definition "Connecting separately-built components or systems so they work together."@en .

backlog:Comp_LineageDiscipline a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Lineage discipline"@en ;
    skos2:broader backlog:Comp_Governance ;
    skos2:definition "Building and maintaining a lineage's Mission-to-Backlog chain in the order and ceremony this framework requires."@en .

backlog:Comp_OntologyModeling a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Ontology modelling"@en ;
    skos2:broader backlog:Comp_Design ;
    skos2:definition "Designing classes, properties and closed or open vocabularies that state what a domain's terms actually mean."@en .

backlog:Comp_QualityReview a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Quality review"@en ;
    skos2:broader backlog:Comp_Verification ;
    skos2:definition "Reviewing a finished piece of work against a stated quality bar before it is accepted."@en .

backlog:Comp_RankingDecision a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Ranking decision"@en ;
    skos2:broader backlog:Comp_Governance ;
    skos2:definition "Making or arbitrating a multi-factor priority judgement with a written rationale."@en .

backlog:Comp_ReleaseManagement a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Release management"@en ;
    skos2:broader backlog:Comp_Operations ;
    skos2:definition "Taking a change through its gate, manifest, publish and tag steps to a real, verified release."@en .

backlog:Comp_RequirementsElicitation a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Requirements elicitation"@en ;
    skos2:broader backlog:Comp_Analysis ;
    skos2:definition "Drawing out what stakeholders actually need, as distinct from what they first say."@en .

backlog:Comp_RetrospectiveFacilitation a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Retrospective facilitation"@en ;
    skos2:broader backlog:Comp_Operations ;
    skos2:definition "Running a retrospective that produces a real RetrospectiveFinding with a root cause, not a formality."@en .

backlog:Comp_ScopeDefinition a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Scope definition"@en ;
    skos2:broader backlog:Comp_Analysis ;
    skos2:definition "Stating what a piece of work does and does not cover, with content specific enough to be checked against later."@en .

backlog:Comp_ShaclAuthoring a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "SHACL authoring"@en ;
    skos2:broader backlog:Comp_Verification ;
    skos2:definition "Writing SHACL shapes that check a graph against a stated rule, in this framework's own house style."@en .

backlog:Comp_SoftwareArchitecture a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Software architecture"@en ;
    skos2:broader backlog:Comp_Design ;
    skos2:definition "Deciding the major structural parts of a system and how they relate."@en .

backlog:Comp_TestDesign a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Test design"@en ;
    skos2:broader backlog:Comp_Verification ;
    skos2:definition "Designing a test, or a test case, that actually exercises the behaviour it claims to check."@en .

backlog:Comp_ToolRunOperation a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Tool-run operation"@en ;
    skos2:broader backlog:Comp_Operations ;
    skos2:definition "Running this framework's own tooling correctly and reading what it reports."@en .

backlog:Comp_ToolScripting a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "Tool scripting"@en ;
    skos2:broader backlog:Comp_Implementation ;
    skos2:definition "Writing the scripts and small tools a development runs on itself, as distinct from the product it ships."@en .

backlog:Comp_UXDesign a backlog:Competency,
        owl:NamedIndividual ;
    rdfs:label "UX design"@en ;
    skos2:broader backlog:Comp_Design ;
    skos2:definition "Designing how a person experiences and operates a piece of software."@en .

backlog:Concern_Architecture a backlog:DesignConcern,
        owl:NamedIndividual ;
    rdfs:label "Architecture"@en ;
    backlog:coversTaskType backlog:Task_ArchitectureDefinition ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'architectural design' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en ;
    skos2:definition "Where the capability sits in the system's structure, and what it depends on. Applies wherever a story introduces a component, a dependency or a deployment boundary."@en .

backlog:Concern_Data a backlog:DesignConcern,
        owl:NamedIndividual ;
    rdfs:label "Data"@en ;
    backlog:coversTaskType backlog:Task_DesignDefinition ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'designing databases' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en ;
    skos2:definition "What persists, and its structure. Applies wherever a story creates, changes or retires stored state — the concern whose omission is cheapest to skip and most expensive to correct, because a schema in use is difficult to change."@en .

backlog:Concern_Interaction a backlog:DesignConcern,
        owl:NamedIndividual ;
    rdfs:label "Interaction"@en ;
    backlog:coversTaskType backlog:Task_DesignDefinition,
        backlog:Task_Validation ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'designing the user interface' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en ;
    skos2:definition "How a person uses the capability. Applies wherever a story changes what a user does, as distinct from what the system stores or exposes."@en .

backlog:Concern_Interface a backlog:DesignConcern,
        owl:NamedIndividual ;
    rdfs:label "Interface"@en ;
    backlog:coversTaskType backlog:Task_DesignDefinition,
        backlog:Task_Integration ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'designing system interfaces' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en ;
    skos2:definition "How the system is reached from outside: an API, a message contract, a file exchange. Applies wherever a story changes what another system may rely on."@en .

backlog:Concern_Security a backlog:DesignConcern,
        owl:NamedIndividual ;
    rdfs:label "Security"@en ;
    backlog:coversTaskType backlog:Task_DesignDefinition,
        backlog:Task_Verification ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'controls and security' design activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en ;
    skos2:definition "Who may do this, and what it exposes. Applies wherever a story touches identity, authorisation or data a policy governs."@en .

backlog:CoreFacet a backlog:FrameworkFacet,
        owl:NamedIndividual ;
    rdfs:label "Core Facet"@en ;
    skos2:definition "Work items, containers and the lifecycle enumeration. Mandatory: every adoption includes it."@en .

backlog:Dep_Knowledge a backlog:DependencyKind,
        owl:NamedIndividual ;
    rdfs:label "Knowledge dependency"@en ;
    skos2:definition "Work waits on information someone holds or must produce — a decision, a specification, expertise. Released by a conversation or a spike, not by scheduling."@en .

backlog:Dep_Resource a backlog:DependencyKind,
        owl:NamedIndividual ;
    rdfs:label "Resource dependency"@en ;
    skos2:definition "Work waits on a person, environment, licence or component being available. Released by allocation, not by completing anything."@en .

backlog:Dep_Task a backlog:DependencyKind,
        owl:NamedIndividual ;
    rdfs:label "Task dependency"@en ;
    skos2:definition "Work waits on other work being finished first. The only kind an ordering constraint alone can express, and the kind most tools assume is the only one."@en .

backlog:Depth_Brief a backlog:SpecificationDepth,
        owl:NamedIndividual ;
    rdfs:label "Brief"@en ;
    skos2:definition "A few sentences: who, what and why, enough to size and prioritise. Appropriate during analysis, when the set of use cases is still moving."@en .

backlog:Depth_Discovery a backlog:LineageDepthLevel,
        owl:NamedIndividual ;
    rdfs:label "Discovery"@en ;
    skos2:definition "The request cannot honestly support a Mission statement yet -- what exists is a wish or an expectation, not yet a stated intent. Real comprehensive elicitation work is owed before Mission-writing, not a shortcut through it. Named from the owner's own description, 2026-09-17: cases where 'even the epics cannot be written.'"@en .

backlog:Depth_FullChain a backlog:LineageDepthLevel,
        owl:NamedIndividual ;
    rdfs:label "Full chain"@en ;
    skos2:definition "The standard Mission then Scope then Goal then Objective then Backlog then Epic then Story then Task chain, as this package's own Lineage 9 actually used it -- appropriate when the work is itself a rule other lineages will depend on, or genuinely novel enough that the chain's own drift-catching (retrospective findings, scope amendments) is real, needed value rather than ceremony."@en .

backlog:Depth_FullyDeveloped a backlog:SpecificationDepth,
        owl:NamedIndividual ;
    rdfs:label "Fully developed"@en ;
    skos2:definition "Actor, goal, preconditions, trigger, the numbered main flow with its actors, the alternative and exception flows, and postconditions. Appropriate before implementation, because it is what someone builds from."@en .

backlog:Depth_MicroTask a backlog:LineageDepthLevel,
        owl:NamedIndividual ;
    rdfs:label "Micro-task"@en ;
    skos2:definition "A single, well-defined, testable task or story -- real work, but bounded enough that a Mission/Scope/Goal/Objective/Epic chain around it would outweigh the work itself. Named from the owner's own example, 2026-09-17: an in-line coding request such as listing every rule in a corpus, a limited number of source lines, well-defined and properly tested, not a comprehensive lineage."@en .

backlog:Depth_StoryDirect a backlog:LineageDepthLevel,
        owl:NamedIndividual ;
    rdfs:label "Story-direct"@en ;
    skos2:definition "The work is already known at story granularity -- an Epic-to-Story conversion step would be stale, since the decomposition it exists to produce is already the starting point. Named from the owner's own observation, 2026-09-17: 'if the stories are already available, possibly the epic-story conversion will be stale.'"@en .

backlog:Dir_Decrease a backlog:MetricDirection,
        owl:NamedIndividual ;
    rdfs:label "Decrease"@en ;
    skos2:definition "The objective is met when the observed value reaches or falls below the target."@en .

backlog:Dir_Hold a backlog:MetricDirection,
        owl:NamedIndividual ;
    rdfs:label "Hold"@en ;
    skos2:definition "The value must not move from its baseline. Used by an inverse goal, whose objective is a ceiling rather than a trajectory: the count of things that should not happen must stay where it is. Distinct from Dir_Decrease with a target already reached, which claims an improvement that never occurred."@en .

backlog:Dir_Increase a backlog:MetricDirection,
        owl:NamedIndividual ;
    rdfs:label "Increase"@en ;
    skos2:definition "The objective is met when the observed value reaches or exceeds the target."@en .

backlog:Direction_Grow a backlog:ChangeDirection,
        owl:NamedIndividual ;
    rdfs:label "Grow"@en ;
    skos2:definition "The change admits something not previously in scope."@en .

backlog:Direction_Shrink a backlog:ChangeDirection,
        owl:NamedIndividual ;
    rdfs:label "Shrink"@en ;
    skos2:definition "The change removes something previously in scope."@en .

backlog:Disp_Accepted a backlog:ChangeDisposition,
        owl:NamedIndividual ;
    rdfs:label "Accepted"@en ;
    skos2:definition "Decided in favour; a real ScopeChange should follow."@en .

backlog:Disp_Deferred a backlog:ChangeDisposition,
        owl:NamedIndividual ;
    rdfs:label "Deferred"@en ;
    skos2:definition "Neither accepted nor rejected; revisited at a stated later point or condition."@en .

backlog:Disp_KnownError a backlog:FindingDisposition,
        owl:NamedIndividual ;
    rdfs:label "Known error"@en ;
    dcterms:source "ITIL 4 / ISO/IEC 20000-1:2018 (known error: a problem with a documented root cause, not remediated, managed and monitored)" ;
    skos2:definition "The rule is broken, the cause is documented, and it is deliberately NOT remediated -- typically because the work has moved on and the past state cannot be reinvented, or because the remedy costs more than the fault. It must name its root cause, the decision to accept it, its owner, and how it is monitored. It is not an excuse: the finding keeps firing, and the record says why it is left standing."@en .

backlog:Disp_Nonconformity a backlog:FindingDisposition,
        owl:NamedIndividual ;
    rdfs:label "Nonconformity"@en ;
    dcterms:source "ISO 19011:2018, 3.21 (nonconformity: non-fulfilment of a requirement)" ;
    skos2:definition "A requirement is not fulfilled and must be. The default disposition of every violation: it needs no declaration, it needs fixing. A finding with no declared disposition is this one."@en .

backlog:Disp_Observation a backlog:FindingDisposition,
        owl:NamedIndividual ;
    rdfs:label "Observation"@en ;
    dcterms:source "ISO 19011:2018, 6.4.8 (observations recorded without a nonconformity being raised)" ;
    skos2:definition "Recorded because it may matter later; nothing is required of anyone. Reserved for findings whose rule is not yet written -- the case where a condition is certainly true and no obligation exists to breach."@en .

backlog:Disp_Pending a backlog:ChangeDisposition,
        owl:NamedIndividual ;
    rdfs:label "Pending"@en ;
    skos2:definition "Raised, not yet decided."@en .

backlog:Disp_Rejected a backlog:ChangeDisposition,
        owl:NamedIndividual ;
    rdfs:label "Rejected"@en ;
    skos2:definition "Decided against. Retained, not deleted -- a rejected request considered again later without record looks like a new idea rather than a repeat one."@en .

backlog:Disp_RiskAccepted a backlog:FindingDisposition,
        owl:NamedIndividual ;
    rdfs:label "Risk accepted"@en ;
    dcterms:source "ISO 31000:2018, 6.5.3 (risk retention as a treatment option); risk:RiskRetention" ;
    skos2:definition "The condition is real, the consequence is uncertain, and the owner has retained the risk rather than treating it. Must name a risk:Risk, its treatment decision and its monitoring; residual risk is risk:ResidualRisk."@en .

backlog:Domain_ContentTransformation a backlog:LineageArtifactDomain,
        owl:NamedIndividual ;
    rdfs:label "Content transformation"@en ;
    skos2:definition "Turning existing content into a different real form -- the owner's own example, a corpus converted into an interactive HTML page -- distinct even from authoring new content, and with no existing pib:ArtifactCategory match at the time this was named (2026-09-17); disclosed as a real gap rather than forced into GamificationProject or CapstoneReport."@en .

backlog:Domain_CrossPackage a backlog:LineageArtifactDomain,
        owl:NamedIndividual ;
    rdfs:label "Cross-package"@en ;
    skos2:definition "Work whose real completion is jointly owned by two or more packages, checkable from neither alone -- named from a real, disclosed case (a deferred handover, 2026-09-16): a deliverable's satisfying artifact moved to a different package with no scope-change recorded on the losing side."@en .

backlog:Domain_Infrastructure a backlog:LineageArtifactDomain,
        owl:NamedIndividual ;
    rdfs:label "Infrastructure"@en ;
    skos2:definition "Tooling, gate and pipeline work on the framework's own mechanisms -- real, necessary, and typically moving zero backlog items, the 'off-backlog, declared' case this same session's own real releases (the order-check rewrite, the archive-conformance seeding, the memoization default) demonstrated directly."@en .

backlog:Domain_Ontology a backlog:LineageArtifactDomain,
        owl:NamedIndividual ;
    rdfs:label "Ontology"@en ;
    skos2:definition "TBox, ABox and SHACL discipline -- a different rigor entirely from source-code structural/behavioural modelling. What backlog-roadmap-framework and the wider OE discipline use on themselves. Aligns with pib-hub's pib:OntologyBasedSystem and pib:OntologyDeliverable."@en .

backlog:Domain_SourceCode a backlog:LineageArtifactDomain,
        owl:NamedIndividual ;
    rdfs:label "Source code"@en ;
    skos2:definition "Structural and behavioral modelling: domain entities, interfaces, behaviour specifications -- what this package's own full SDLC obligation set (obligation set 2, the fourteen-process, six-concern expansion) was actually built for. Aligns with pib-hub's pib:CoreSoftwareDevelopment."@en .

backlog:Done a backlog:LifecycleState,
        owl:NamedIndividual ;
    rdfs:label "Done"@en ;
    skos2:definition "Complete AND backed by evidence. Under an evidence-bound profile (L2 or L3) the SHACL suite refuses this state to any item lacking at least one Evidence whose evidenceVerified flag is true, so 'done' can never be a prose claim."@en .

backlog:EvidenceFacet a backlog:FrameworkFacet,
        owl:NamedIndividual ;
    rdfs:label "Evidence Facet"@en ;
    skos2:definition "Evidence classes, the verification flag, and the Definition-of-Done criteria. Required at conformance level L2 and above."@en .

backlog:Ext_Customer a backlog:ExternalDependencyType,
        owl:NamedIndividual ;
    rdfs:label "Customer or client"@en ;
    skos2:definition "Data, decisions, access or acceptance that only the client can supply. Frequently on the critical path and rarely on the plan."@en .

backlog:Ext_Infrastructure a backlog:ExternalDependencyType,
        owl:NamedIndividual ;
    rdfs:label "Infrastructure or platform"@en ;
    skos2:definition "Hosting, network, identity, build or environment services the development runs on but does not control."@en .

backlog:Ext_PeerTeam a backlog:ExternalDependencyType,
        owl:NamedIndividual ;
    rdfs:label "Peer team"@en ;
    skos2:definition "Another team or product inside the same organisation. The most commonly mis-modelled type: organisational proximity tempts teams to write the other team's work into their own backlog, which is exactly the failure the proposal rule prevents."@en .

backlog:Ext_Regulatory a backlog:ExternalDependencyType,
        owl:NamedIndividual ;
    rdfs:label "Regulatory or standards body"@en ;
    skos2:definition "A regulator, certification authority or standards body. Its requirements are inputs, not negotiable scope, and its timelines are almost never responsive to a development's plan."@en .

backlog:Ext_UpstreamComponent a backlog:ExternalDependencyType,
        owl:NamedIndividual ;
    rdfs:label "Upstream component"@en ;
    skos2:definition "A library, framework, dataset, standard or ontology the development consumes but does not own. Changes are proposed to the upstream maintainers; forking is the fallback and is a scope decision in its own right."@en .

backlog:Ext_Vendor a backlog:ExternalDependencyType,
        owl:NamedIndividual ;
    rdfs:label "Vendor"@en ;
    skos2:definition "A commercial supplier or hosted service under contract. Changes are negotiated, priced and scheduled by someone else; the realistic lever is the contract, not the backlog."@en .

backlog:Facing_Containment a backlog:GoalFacing,
        owl:NamedIndividual ;
    rdfs:label "Containment-facing"@en ;
    skos2:definition "Holds when no work was done outside the areas the scope names. Without it a lineage can reach its mission and its scope while spending effort nobody asked for, and the register reports success — redundant work is invisible to any measure that only counts what was required."@en .

backlog:Facing_Exclusion a backlog:GoalFacing,
        owl:NamedIndividual ;
    rdfs:label "Exclusion-facing"@en ;
    dcterms:source "PMBOK: project exclusions as the safeguard against scope creep"@en ;
    skos2:definition "An INVERSE GOAL: it states what must not happen and is met by absence. Distinct from containment-facing, which asks whether work stayed inside the areas — an inverse goal names a specific thing the scope refused and can be measured against, so a preventive mechanism has something to attach to. PMBOK calls explicit exclusions the principal safeguard against scope creep; an exclusion nothing measures is a sentence rather than a safeguard."@en .

backlog:Facing_Mission a backlog:GoalFacing,
        owl:NamedIndividual ;
    rdfs:label "Mission-facing"@en ;
    skos2:definition "Holds when the mission's own condition is true, independently of how much of the scope was done. This is the goal that catches an insufficient boundary: if every area finishes and this goal is still unmet, the scope was wrong."@en .

backlog:Facing_Scope a backlog:GoalFacing,
        owl:NamedIndividual ;
    rdfs:label "Scope-facing"@en ;
    skos2:definition "Holds when every area the scope names has reached its finish condition. This is the goal that catches abandonment: a mission-facing goal can read met because the easy half was done."@en .

backlog:GoalOrigin_Carried a backlog:GoalOrigin,
        owl:NamedIndividual ;
    rdfs:label "Carried"@en ;
    skos2:definition "Continues work the predecessor out-scoped before it closed. Names the out-scoping declaration it continues (goalAnswersGap)."@en .

backlog:GoalOrigin_New a backlog:GoalOrigin,
        owl:NamedIndividual ;
    rdfs:label "New"@en ;
    skos2:definition "Covers something the predecessor never had in scope -- mentioned before, perhaps, but never part of its work. Names no gap."@en .

backlog:GoalOrigin_Repair a backlog:GoalOrigin,
        owl:NamedIndividual ;
    rdfs:label "Repair"@en ;
    skos2:definition "Repairs work the predecessor closed as done and was later found defective. Names the post-closure finding it answers (goalAnswersGap)."@en .

backlog:Goal_Correction a backlog:MaintenanceGoal,
        owl:NamedIndividual ;
    rdfs:label "Correction"@en ;
    skos2:definition "Restores behaviour that was already intended. Nothing new is promised."@en .

backlog:Goal_Enhancement a backlog:MaintenanceGoal,
        owl:NamedIndividual ;
    rdfs:label "Enhancement"@en ;
    skos2:definition "Implements a new requirement. 14764: an enhancement is not a software correction — which is why calling an enhancement a fix is the commonest way unbudgeted scope enters a maintenance stream."@en .

backlog:Holds a backlog:InvariantStatus,
        owl:NamedIndividual ;
    rdfs:label "Holds"@en ;
    skos2:definition "The check was executed in this pass and returned the expected result."@en .

backlog:IOrigin_Derived a backlog:IntentOrigin,
        owl:NamedIndividual ;
    rdfs:label "Derived"@en ;
    skos2:definition "Restated from something outside the register — a charter, a standard, or the element above it in the chain. Traceable, which is what separates it from a session draft."@en .

backlog:IOrigin_OwnerStated a backlog:IntentOrigin,
        owl:NamedIndividual ;
    rdfs:label "Owner stated"@en ;
    skos2:definition "The owner supplied the words. The only origin under which an intent element is evidence of intent rather than a record of what was built."@en .

backlog:IOrigin_SessionDrafted a backlog:IntentOrigin,
        owl:NamedIndividual ;
    rdfs:label "Session drafted"@en ;
    skos2:definition "A session wrote it, whoever it was attributed to. Legitimate as a working artifact and dangerous as a source: a session drafting intent for work it is already doing writes a summary of that work, and a summary cannot contradict its source."@en .

backlog:InProgress a backlog:LifecycleState,
        owl:NamedIndividual ;
    rdfs:label "In Progress"@en ;
    skos2:definition "Being worked; partial delivery may exist but completion evidence is absent or not yet verified."@en .

backlog:Int_Confirm a backlog:InteractionKind,
        owl:NamedIndividual ;
    rdfs:label "Confirm"@en ;
    skos2:definition "A person permitted the work to proceed. Gating."@en .

backlog:Int_Correct a backlog:InteractionKind,
        owl:NamedIndividual ;
    rdfs:label "Correct"@en ;
    skos2:definition "A person materially changed the output. Implies the item's modality is Hybrid rather than Automated."@en .

backlog:Int_Propose a backlog:InteractionKind,
        owl:NamedIndividual ;
    rdfs:label "Propose"@en ;
    skos2:definition "A person supplied direction the agent did not have."@en .

backlog:Int_Reject a backlog:InteractionKind,
        owl:NamedIndividual ;
    rdfs:label "Reject"@en ;
    skos2:definition "A person refused the work. Gating, and the one whose complete absence over a long register suggests confirmation is a formality."@en .

backlog:Int_Respond a backlog:InteractionKind,
        owl:NamedIndividual ;
    rdfs:label "Respond"@en ;
    skos2:definition "A person answered a question the agent raised."@en .

backlog:Int_Review a backlog:InteractionKind,
        owl:NamedIndividual ;
    rdfs:label "Review"@en ;
    skos2:definition "A person examined the output without deciding or changing it. Not gating; recording it as such is what keeps 'reviewed' from being read as 'approved'."@en .

backlog:InvariantFacet a backlog:FrameworkFacet,
        owl:NamedIndividual ;
    rdfs:label "Invariant Facet"@en ;
    skos2:definition "Cross-cutting invariants with executable checks and honest statuses. Required at conformance level L3."@en .

backlog:KickOff_Declared a backlog:KickOffMode,
        owl:NamedIndividual ;
    rdfs:label "Declared"@en ;
    skos2:definition "A person recorded the start. Must name who, through decidedBy."@en .

backlog:KickOff_Triggered a backlog:KickOffMode,
        owl:NamedIndividual ;
    rdfs:label "Triggered"@en ;
    skos2:definition "An automated event recorded the start — a pipeline run, a branch creation, a first commit. Must name the trigger through hasKickOffTrigger so the moment is re-derivable."@en .

backlog:Kind_ActivityDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Activity diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_ClassDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Class diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_CommunicationDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Communication diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_ComponentDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Component diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_CompositeStructure a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Composite structure diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_DeploymentDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Deployment diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_EvolutionaryDevelopment a backlog:InitiativeKind,
        owl:NamedIndividual ;
    rdfs:label "Evolutionary development"@en ;
    backlog:isFrameworkOriginal "Same finding as Kind_InitialDevelopment, which this term is the counterpart of: no external source classifies major-version, project-scale work on an existing product as its own initiative kind distinct from maintenance. Declared framework-original rather than attributed to a source it does not have."@en ;
    skos2:definition "A new version built after an earlier one is complete. Still project scale and still a major increment, but constrained where the first build was not: something already exists, is in use, and either has to keep working or has to be migrated deliberately. Calling this maintenance because it touches an existing product is the commonest miscategorisation, and the version increment is what settles it."@en .

backlog:Kind_Functional a backlog:ProductScopeKind,
        owl:NamedIndividual ;
    rdfs:label "Functional"@en ;
    skos2:definition "The deliverable names a capability the artifact has. Answers: does it do this?"@en .

backlog:Kind_InitialDevelopment a backlog:InitiativeKind,
        owl:NamedIndividual ;
    rdfs:label "Initial development"@en ;
    backlog:isFrameworkOriginal "No single converging source found for 'initial development' as a named initiative-kind category, distinct from evolutionary development, at this level of specificity. ISO/IEC/IEEE 14764 and 12207 name maintenance, migration and retirement as distinct processes but do not classify pre-maintenance development into 'initial' versus 'evolutionary' by version-increment size; that split is this framework's own, made to give the version-increment discriminator (major vs minor/patch) something to discriminate between at the initiative level, not only at the task level. Declared framework-original rather than attributed to a source it does not have."@en ;
    skos2:definition "The first build of a product. Distinguished from every later one because there is no installed base to preserve, no migration to plan and no compatibility to break — the decisions are unconstrained in a way they will never be again. Project scale; produces the first major version."@en .

backlog:Kind_InteractionOverview a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Interaction overview diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_Maintenance a backlog:InitiativeKind,
        owl:NamedIndividual ;
    rdfs:label "Maintenance"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.13 Maintenance process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "Sustains capability already delivered, per ISO/IEC/IEEE 12207's maintenance process. Smaller in granularity than a project and moves a minor or patch version, never a major — that is the discriminator, and it is a fact about what shipped rather than a judgement about how the work felt. Requires a maintenance category, because 'maintenance' alone conflates fixing what is broken with improving what works."@en .

backlog:Kind_Migration a backlog:InitiativeKind,
        owl:NamedIndividual ;
    rdfs:label "Migration"@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance, which names migration planning as a distinct maintainer activity outside the four/five maintenance types themselves. Clause number not yet confirmed against the primary paywalled standard text."@en ;
    skos2:definition "Moving a product to a new environment or platform while preserving its capability. A distinct process in ISO/IEC/IEEE 14764 rather than a maintenance type, and project scale here because it usually forces a major increment: what users can do is unchanged, but what they must do to keep using it is not."@en .

backlog:Kind_NonFunctional a backlog:ProductScopeKind,
        owl:NamedIndividual ;
    rdfs:label "Non-functional"@en ;
    skos2:definition "The deliverable names a quality the artifact exhibits while it does what it does — how reliably, transparently, or safely, not what. Answers: does it do this well?"@en .

backlog:Kind_ObjectDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Object diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_PackageDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Package diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_ProfileDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Profile diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_Retirement a backlog:InitiativeKind,
        owl:NamedIndividual ;
    rdfs:label "Retirement"@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance, which names retirement planning as a distinct maintainer activity. Clause number not yet confirmed against the primary paywalled standard text."@en ;
    skos2:definition "Withdrawing a product from service. A 14764 process in its own right, and modelled because a register with no way to say a thing is being switched off records its last release as though it were still alive."@en .

backlog:Kind_SequenceDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Sequence diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_StateMachineDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "State machine diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_TimingDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Timing diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_UseCaseDiagram a backlog:ModelKind,
        owl:NamedIndividual ;
    rdfs:label "Use case diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:L1_Core a backlog:ConformanceLevel,
        owl:NamedIndividual ;
    rdfs:label "L1 Core"@en ;
    skos2:definition "Every work item carries a unique identifier, exactly one lifecycle state, and well-typed container and dependency references. Structural integrity only: nothing is claimed about how completion is proven."@en .

backlog:L2_EvidenceBound a backlog:ConformanceLevel,
        owl:NamedIndividual ;
    rdfs:label "L2 Evidence-Bound"@en ;
    skos2:definition "L1 plus: no item may hold the Done state without at least one Evidence whose evidenceVerified flag is true, every Definition-of-Done criterion carries executable check text, and container state is derived rather than asserted. This is the level at which 'done' stops being prose."@en .

backlog:L3_Governed a backlog:ConformanceLevel,
        owl:NamedIndividual ;
    rdfs:label "L3 Governed"@en ;
    skos2:definition "L2 plus: Done items are anchored to a release carrying a package SHA-256 or to a named passing test (review evidence alone is insufficient), each item records when it was last individually re-verified, cross-cutting invariants are executable with honest statuses, and the reconciliation gate runs as a mandatory release gate rather than as an available script."@en .

backlog:L4_LineageEnforced a backlog:ConformanceLevel,
        owl:NamedIndividual ;
    rdfs:label "L4 Lineage Enforced"@en ;
    skos2:definition "L3 plus: the intent chain is complete and connected end to end, every objective carries a measurement rather than an intention, work is groomed to the granularity that can actually be executed, and an iteration connects to what ships. The checks that are advisory at lower levels become violations here. Adopted where a register must PROVE a mission was accomplished rather than report that work was done — the difference being that completion is a fact about effort and accomplishment is a fact about the world, and only the second requires a measurement. Deliberately a separate level and not a promotion inside L3: a level is a claim an adopter makes, and promoting checks inside an existing one would break every adopter who made a different claim."@en .

backlog:LS_Abandoned a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Abandoned"@en ;
    backlog:statusRank 7 ;
    skos2:definition "The mission outcome is Out_Abandoned. Archivable like Achieved."@en .

backlog:LS_Achieved a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Achieved"@en ;
    backlog:statusRank 7 ;
    skos2:definition "The mission outcome is Out_Achieved and a closure report closes it. Found in this status and not archived, the lineage triggers the archival activity."@en .

backlog:LS_Archived a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Archived"@en ;
    backlog:statusRank 8 ;
    skos2:definition "Set down into the archive ABox by backlog_lineage_archive; out of every processing path until consciously revived."@en .

backlog:LS_Backlogged a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Backlogged"@en ;
    backlog:statusRank 5 ;
    skos2:definition "The Backlog stage output is active: the chain is closed and work is planned, none of it started."@en .

backlog:LS_Goaled a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Goaled"@en ;
    backlog:statusRank 3 ;
    skos2:definition "The Goal stage output is active."@en .

backlog:LS_InProgress a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "In progress"@en ;
    backlog:statusRank 6 ;
    skos2:definition "The chain is closed and development is ongoing: at least one work item of the lineage has left Proposed/Ready, and the mission outcome is not yet settled. The status the owner asked for by name."@en .

backlog:LS_Objectived a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Objectived"@en ;
    backlog:statusRank 4 ;
    skos2:definition "The Objective stage output is active."@en .

backlog:LS_Opened a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Opened"@en ;
    backlog:statusRank 1 ;
    skos2:definition "The Mission stage output is active; nothing downstream."@en .

backlog:LS_Revived a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Revived"@en ;
    backlog:statusRank 6 ;
    skos2:definition "An archived lineage consciously brought back by the owner (lineageRevivedAt, decidedBy Owner); processed again as in progress."@en .

backlog:LS_Scoped a backlog:LineageStatus,
        owl:NamedIndividual ;
    rdfs:label "Scoped"@en ;
    backlog:statusRank 2 ;
    skos2:definition "The Scope stage output is active."@en .

backlog:Later a backlog:RoadmapHorizon,
        owl:NamedIndividual ;
    rdfs:label "Later"@en ;
    skos2:definition "Directional intent beyond the next increment; deliberately unrefined, and never to be reported to stakeholders as a schedule."@en .

backlog:LaunchScopedRanking a backlog:RankingModel,
        owl:NamedIndividual ;
    rdfs:label "Launch-scoped ranking"@en ;
    skos2:definition "Ranks only within the active launch-priority gate plus cross-cutting prerequisites, answering what must clear before first deployment. It collapses back to throughput ranking automatically once every launch gate is closed, so the scoping is a state of the register rather than a mode someone must remember to switch off."@en .

backlog:Layer_Product a backlog:ScopeLayer,
        owl:NamedIndividual ;
    rdfs:label "Product layer"@en ;
    skos2:definition "What functionality is or is not implemented. Answers: will the delivered thing do this?"@en .

backlog:Layer_Work a backlog:ScopeLayer,
        owl:NamedIndividual ;
    rdfs:label "Work layer"@en ;
    skos2:definition "Which work is or is not done. Answers: will effort go here? A capability may be in the product scope while the work to build it sits outside this project's work scope — bought, inherited, or deferred."@en .

backlog:Level_Analysis a backlog:ModelLevel,
        owl:NamedIndividual ;
    rdfs:label "Analysis level"@en ;
    skos2:definition "Describes the problem domain as it is, independent of any solution: domain classes as the business names them, the system seen from outside as a black box, business events, the workflow as people perform it."@en .

backlog:Level_Design a backlog:ModelLevel,
        owl:NamedIndividual ;
    rdfs:label "Design level"@en ;
    skos2:definition "Describes the solution as it will be built: software classes with methods, objects exchanging messages inside the system, states the implementation holds, components, packages and schemas."@en .

backlog:Live a backlog:DocumentStatus,
        owl:NamedIndividual ;
    rdfs:label "Live"@en ;
    skos2:definition "Current and safe to act on."@en .

backlog:Maint_Adaptive a backlog:MaintenanceCategory,
        owl:NamedIndividual ;
    rdfs:label "Adaptive"@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en ;
    skos2:definition "Reactive enhancement: modification to keep the product usable in a changed or changing environment (14764). The world moved; the software has to follow."@en .

backlog:Maint_Additive a backlog:MaintenanceCategory,
        owl:NamedIndividual ;
    rdfs:label "Additive"@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance, third edition. Additive is specifically the 2022 revision's own addition to the four classic types named in the 1999/2006 editions; confirmed via web search of secondary sources describing the 2022 edition, not against the primary paywalled standard text."@en ;
    skos2:definition "14764:2022's optional fifth type: an enhancement that adds function to existing software, distinguished from perfective by changing the existing product rather than improving its qualities. Offered because the standard names it; an adopter using only the classic four is conformant."@en .

backlog:Maint_Corrective a backlog:MaintenanceCategory,
        owl:NamedIndividual ;
    rdfs:label "Corrective"@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en ;
    skos2:definition "Reactive correction: modification after delivery to correct discovered problems (14764). Something is broken and has been noticed."@en .

backlog:Maint_Perfective a backlog:MaintenanceCategory,
        owl:NamedIndividual ;
    rdfs:label "Perfective"@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en ;
    skos2:definition "Proactive enhancement: modification to provide enhancements for users, or to improve performance, maintainability or other attributes (14764). Nothing forced it."@en .

backlog:Maint_Preventive a backlog:MaintenanceCategory,
        owl:NamedIndividual ;
    rdfs:label "Preventive"@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en ;
    skos2:definition "Proactive correction: modification to correct latent faults before they manifest as failures (14764). Nothing has failed yet, which is why this work is chronically deferred."@en .

backlog:Meas_Counted a backlog:MeasurementKind,
        owl:NamedIndividual ;
    rdfs:label "Counted"@en ;
    skos2:definition "Obtained by counting artefacts anyone can count: files, triples, rulings. Reproducible without trusting the counter."@en .

backlog:Meas_Derived a backlog:MeasurementKind,
        owl:NamedIndividual ;
    rdfs:label "Derived"@en ;
    skos2:definition "Computed by a named query over the register. Reproducible if the query is shipped, which is why the query must be."@en .

backlog:Meas_Judged a backlog:MeasurementKind,
        owl:NamedIndividual ;
    rdfs:label "Judged"@en ;
    skos2:definition "A person decided. Legitimate, and the weakest of the three: it cannot be reproduced, only agreed with or disputed."@en .

backlog:Mode_Automated a backlog:ExecutionModality,
        owl:NamedIndividual ;
    rdfs:label "Automated"@en ;
    skos2:definition "Carried out by an agent or a pipeline with no person in the execution path. Not a claim that nobody supervised it — supervision is recorded separately as an interaction, precisely so that unsupervised automation is distinguishable from supervised automation."@en .

backlog:Mode_Human a backlog:ExecutionModality,
        owl:NamedIndividual ;
    rdfs:label "Human"@en ;
    skos2:definition "Carried out by a person. Competes for capacity like any other work, which is the point of recording it: human time is finite and an automated backlog that hides it will over-commit the one resource it cannot scale."@en .

backlog:Mode_Hybrid a backlog:ExecutionModality,
        owl:NamedIndividual ;
    rdfs:label "Hybrid"@en ;
    skos2:definition "An agent produced the output and a person materially changed it. Distinct from automated-with-review, where the person accepted or rejected but did not author: the two carry different answers to who is responsible for what shipped."@en .

backlog:Next a backlog:RoadmapHorizon,
        owl:NamedIndividual ;
    rdfs:label "Next"@en ;
    skos2:definition "Intended for the increment after the current one; refined enough to be estimated but not committed."@en .

backlog:NotYetEnforceable a backlog:InvariantStatus,
        owl:NamedIndividual ;
    rdfs:label "Not Yet Enforceable"@en ;
    skos2:definition "The check cannot yet be executed meaningfully because the work item that would enforce the invariant is not Done. Must never be reported as passing."@en .

backlog:Now a backlog:RoadmapHorizon,
        owl:NamedIndividual ;
    rdfs:label "Now"@en ;
    skos2:definition "Committed and actively worked in the current increment; items here are expected to be Ready or InProgress."@en .

backlog:Num_Asserted a backlog:NumberOrigin,
        owl:NamedIndividual ;
    rdfs:label "Asserted"@en ;
    skos2:definition "A judgement someone recorded. Legitimate and the weakest: it cannot be recomputed, only disputed. Two asserted numbers agreeing with each other is the defect that let an iteration hold fifteen points while declaring nine."@en .

backlog:Num_Derived a backlog:NumberOrigin,
        owl:NamedIndividual ;
    rdfs:label "Derived"@en ;
    skos2:definition "Computable from other data in the register. Must ship its query, or it is an assertion wearing a derivation's clothes."@en .

backlog:Num_Measured a backlog:NumberOrigin,
        owl:NamedIndividual ;
    rdfs:label "Measured"@en ;
    skos2:definition "Taken from outside the register — a commit timestamp, a file count, a clock. Re-takeable by anyone with the same source, which is what distinguishes it from an assertion."@en .

backlog:Oblig_Advisory a backlog:ObligationSeverity,
        owl:NamedIndividual ;
    rdfs:label "Advisory"@en ;
    skos2:definition "Reported, not refused -- for an obligation whose absence can be legitimate and must then be explained (G46 test drive: severity is earned by watching a rule fire, not assumed). v1.115.0: the explanation is obligationWaivedBy naming the obligation with an obligationWaiverReason; for an advisory obligation that is an explanation, not a debt."@en .

backlog:Oblig_Required a backlog:ObligationSeverity,
        owl:NamedIndividual ;
    rdfs:label "Required"@en ;
    skos2:definition "The stage output cannot close without it (Violation)."@en .

backlog:Origin_Derived a backlog:MissionOrigin,
        owl:NamedIndividual ;
    rdfs:label "Derived"@en ;
    skos2:definition "Restated from a document outside the register — a charter, a contract, a standard. Traceable to something, which is what separates it from a session draft."@en .

backlog:Origin_OwnerStated a backlog:MissionOrigin,
        owl:NamedIndividual ;
    rdfs:label "Owner stated"@en ;
    skos2:definition "The owner supplied the words. The only origin under which a mission is evidence of intent rather than a record of what was built."@en .

backlog:Origin_SessionDrafted a backlog:MissionOrigin,
        owl:NamedIndividual ;
    rdfs:label "Session drafted"@en ;
    skos2:definition "A session wrote the statement, whoever it was attributed to. Legitimate as a working artifact and dangerous as a source: a session drafting a mission after the work exists writes a summary of that work, and a summary cannot contradict its source."@en .

backlog:Out_Abandoned a backlog:MissionOutcome,
        owl:NamedIndividual ;
    rdfs:label "Abandoned"@en ;
    skos2:definition "Work stopped without the goals being reached, and the reason is recorded. Named so that abandonment is a decision with an author rather than a lineage that quietly stopped being mentioned."@en .

backlog:Out_Achieved a backlog:MissionOutcome,
        owl:NamedIndividual ;
    rdfs:label "Achieved"@en ;
    skos2:definition "Every goal is reached or has a status saying why it no longer steers. A mission may only reach this state when NO goal is left unreached and unexplained — a lineage carrying a live unmet goal is not finished, it is stalled, and retiring it would bury the reason."@en .

backlog:Out_InFlight a backlog:MissionOutcome,
        owl:NamedIndividual ;
    rdfs:label "In flight"@en ;
    skos2:definition "Work continues. The default, and the only state in which a mission belongs in the live register."@en .

backlog:Outcome_Failure a backlog:Outcome,
        owl:NamedIndividual ;
    rdfs:label "Failure"@en ;
    skos2:definition "The Executor did not achieve what the Competency was exercised for. The negative outcome FailureRecord's own TBox definition names as its defining trait; a FailureRecord's hasOutcome is this individual."@en .

backlog:Outcome_PartialSuccess a backlog:Outcome,
        owl:NamedIndividual ;
    rdfs:label "Partial success"@en ;
    skos2:definition "The Executor achieved some, but not all, of what the Competency was exercised for -- real progress, with a real remainder."@en .

backlog:Outcome_Success a backlog:Outcome,
        owl:NamedIndividual ;
    rdfs:label "Success"@en ;
    skos2:definition "The Executor fully achieved what the Competency was exercised for, with nothing left unresolved."@en .

backlog:Owner a backlog:Role,
        owl:NamedIndividual ;
    rdfs:label "Owner"@en ;
    skos2:definition "Makes the calls that genuinely require business judgement — what is in launch scope, which live defect blocks launch versus can be deferred, single-tenant versus multi-tenant. These are never computed, and silence is never approval of a scope decision that was not actually given."@en .

backlog:Phase_Live a backlog:ProductLifecyclePhase,
        owl:NamedIndividual ;
    rdfs:label "Live"@en ;
    skos2:definition "The product is in real use; ongoing capacity is allocated by throughput ranking within the policy mix, and maintenance is no longer a residual category."@en .

backlog:Phase_PreLaunch a backlog:ProductLifecyclePhase,
        owl:NamedIndividual ;
    rdfs:label "Pre-launch"@en ;
    skos2:definition "Nothing has been deployed to real users yet; launch gates govern the order of work."@en .

backlog:Phase_Sunsetting a backlog:ProductLifecyclePhase,
        owl:NamedIndividual ;
    rdfs:label "Sunsetting"@en ;
    skos2:definition "The product is being withdrawn; new capability work requires an explicit owner decision, and compliance and migration work dominate."@en .

backlog:Polarity_Negative a backlog:FixturePolarity,
        owl:NamedIndividual ;
    rdfs:label "Negative"@en ;
    skos2:definition "The fixture is expected to be rejected. A negative fixture that PASSES is the more dangerous failure: it means the clause it was built to prove no longer fires."@en .

backlog:Polarity_Positive a backlog:FixturePolarity,
        owl:NamedIndividual ;
    rdfs:label "Positive"@en ;
    skos2:definition "The fixture is expected to validate with no violation. A positive fixture that fails is a regression."@en .

backlog:PrioritizationFacet a backlog:FrameworkFacet,
        owl:NamedIndividual ;
    rdfs:label "Prioritization Facet"@en ;
    skos2:definition "Method-parameterised priority scores and the next-item selection rule."@en .

backlog:Prop_Accepted a backlog:ProposalStatus,
        owl:NamedIndividual ;
    rdfs:label "Accepted"@en ;
    skos2:definition "The owning party has committed to the change. Dependent work becomes startable, and the external delivery becomes a tracked dependency rather than a hope."@en .

backlog:Prop_Rejected a backlog:ProposalStatus,
        owl:NamedIndividual ;
    rdfs:label "Rejected"@en ;
    skos2:definition "The owning party declined. The dependent item must be re-planned, cancelled, or brought into scope through an explicit owner-decided scope change — never left quietly waiting."@en .

backlog:Prop_Submitted a backlog:ProposalStatus,
        owl:NamedIndividual ;
    rdfs:label "Submitted"@en ;
    skos2:definition "Raised with the owning party, no decision yet. Dependent work stays unstartable."@en .

backlog:Prop_Withdrawn a backlog:ProposalStatus,
        owl:NamedIndividual ;
    rdfs:label "Withdrawn"@en ;
    skos2:definition "The development withdrew the request, usually because the need disappeared or a workaround was chosen."@en .

backlog:Proposed a backlog:LifecycleState,
        owl:NamedIndividual ;
    rdfs:label "Proposed"@en ;
    skos2:definition "Recorded and prioritisable, but not yet refined to the point where work could start; acceptance criteria may still be absent."@en .

backlog:Ready a backlog:LifecycleState,
        owl:NamedIndividual ;
    rdfs:label "Ready"@en ;
    skos2:definition "Refined and unblocked: acceptance criteria exist and every dependency is Done, so work can start without further clarification. The state the next-item selection query draws from."@en .

backlog:Reason_ImproperProcessing a backlog:ReactivationReason,
        owl:NamedIndividual ;
    rdfs:label "Improper processing result"@en .

backlog:Reason_NonConformantResult a backlog:ReactivationReason,
        owl:NamedIndividual ;
    rdfs:label "Non-conformant result"@en .

backlog:Reason_UnfinishedWork a backlog:ReactivationReason,
        owl:NamedIndividual ;
    rdfs:label "Unfinished work"@en .

backlog:Refined a backlog:LifecycleState,
        owl:NamedIndividual ;
    rdfs:label "Refined"@en ;
    skos2:definition "Decomposed into real Tasks, a genuine checkpoint reached before the full Ready bar, deliberately not after it. Distinct from Ready: Refined says decomposition happened; Ready additionally requires acceptance criteria and a recorded refinement event, ReadinessGateShape's own existing, unchanged bar. Positioned here rather than between Ready and InProgress precisely because InProgress is reachable only through Ready (T_Start is the sole real transition that targets it) -- placing Refined before Ready means every existing Ready-specific check keeps meaning exactly what it already meant, proven on a real fixture both ways before this was written: an exact-match check on hasState=Ready neither gains a false negative for a Refined item that never claimed to be Ready, nor loses coverage of a Ready item that still owes its real requirements."@en .

backlog:RoadmapFacet a backlog:FrameworkFacet,
        owl:NamedIndividual ;
    rdfs:label "Roadmap Facet"@en ;
    skos2:definition "Roadmaps, horizons and milestones as projections over the backlog."@en .

backlog:Role_EvidenceIndex a backlog:ArtifactRole,
        owl:NamedIndividual ;
    rdfs:label "Evidence index"@en ;
    skos2:definition "The record of what the execution bridge verified, when, and with which tool."@en .

backlog:Role_Manifest a backlog:ArtifactRole,
        owl:NamedIndividual ;
    rdfs:label "Manifest"@en ;
    skos2:definition "The SHA-256 listing that makes the package verifiable after transport. Exactly one per package."@en .

backlog:Role_ProfileDeclaration a backlog:ArtifactRole,
        owl:NamedIndividual ;
    rdfs:label "Adoption profile declaration"@en ;
    skos2:definition "The file carrying the AdoptionProfile, so a consumer can see which conformance level the package claims before validating it."@en .

backlog:Role_ProgressReport a backlog:ArtifactRole,
        owl:NamedIndividual ;
    rdfs:label "Progress report run"@en ;
    skos2:definition "A retained roadmap report run, kept as a file rather than a screenful. Progress is a sequence of dated computations, and a package that retains none can show a state but never a trajectory."@en .

backlog:Role_RegisterData a backlog:ArtifactRole,
        owl:NamedIndividual ;
    rdfs:label "Register data"@en ;
    skos2:definition "The backlog, roadmap and blueprint instances — the graph everything else is computed from."@en .

backlog:Scale_Bounded a backlog:FindingScale,
        owl:NamedIndividual ;
    rdfs:label "Bounded"@en ;
    skos2:definition "A substantial but contained piece; descoped from the closed lineage into a successor by the division ceremony."@en .

backlog:Scale_Isolated a backlog:FindingScale,
        owl:NamedIndividual ;
    rdfs:label "Isolated"@en ;
    skos2:definition "One small defect; a maintenance task or a change request under a live lineage is enough. The closed lineage is not reopened."@en .

backlog:Scale_Systemic a backlog:FindingScale,
        owl:NamedIndividual ;
    rdfs:label "Systemic"@en ;
    skos2:definition "Wide non-conformance across the lineage's work; the only scale that justifies reactivation, after which the lineage is bound by current rules."@en .

backlog:Scen_Absent a backlog:ScenarioKind,
        owl:NamedIndividual ;
    rdfs:label "Absent"@en ;
    skos2:definition "Nothing to work with: an empty set, a missing file, an unpopulated graph. Proves the feature fails loudly rather than silently returning nothing — the case that caught a malformed FILTER reporting zero violations and zero warnings."@en .

backlog:Scen_Boundary a backlog:ScenarioKind,
        owl:NamedIndividual ;
    rdfs:label "Boundary"@en ;
    skos2:definition "The edge of the allowed range. Proves the feature stops where it should."@en .

backlog:Scen_Nominal a backlog:ScenarioKind,
        owl:NamedIndividual ;
    rdfs:label "Nominal"@en ;
    skos2:definition "The expected path with expected input. Proves the feature works and nothing else."@en .

backlog:Scen_Rejection a backlog:ScenarioKind,
        owl:NamedIndividual ;
    rdfs:label "Rejection"@en ;
    skos2:definition "Input the feature must refuse. Proves a constraint fires — the case a negative fixture exists for."@en .

backlog:Scope_LineageLocal a backlog:FindingScope,
        owl:NamedIndividual ;
    rdfs:label "Lineage-local"@en ;
    skos2:definition "The remedy is a practice this lineage adopts for itself — no shared vocabulary or check is missing, the lineage's own discipline was."@en .

backlog:Scope_Methodology a backlog:FindingScope,
        owl:NamedIndividual ;
    rdfs:label "Methodology"@en ;
    skos2:definition "The remedy is, or should be, a change to the shared framework itself — a missing check, a missing vocabulary term, a real gap every adopting lineage would independently rediscover."@en .

backlog:Sel_Committed a backlog:SelectionBasis,
        owl:NamedIndividual ;
    rdfs:label "Previously committed"@en ;
    dcterms:source "Release planning practice: a commitment already given is honoured independently of current ranking"@en ;
    skos2:definition "Work carried because it was promised, independently of its current score. Honest, and worth distinguishing: a register where every release reads this way is one where scoring changes nothing."@en .

backlog:Sel_Dependency a backlog:SelectionBasis,
        owl:NamedIndividual ;
    rdfs:label "Dependency forced"@en ;
    dcterms:source "Carlshamre et al. (2001) and Ngo-The & Ruhe (2008) — value dependencies constrain selection independently of value"@en ;
    skos2:definition "Lower-scored work taken because higher-scored work depends on it. Value was consulted and overridden by structure, which is legitimate and different from not consulting it."@en .

backlog:Sel_HighestScored a backlog:SelectionBasis,
        owl:NamedIndividual ;
    rdfs:label "Highest scored"@en ;
    dcterms:source "Bagnall, Rayward-Smith & Whittley, The Next Release Problem (2001) — select the subset of highest value subject to constraint"@en ;
    skos2:definition "The highest-scoring deliverable work available at the release boundary. The default a value-driven roadmap should be able to claim, and the only basis under which a passed-over higher score is a defect rather than a choice."@en .

backlog:Sel_Opportunistic a backlog:SelectionBasis,
        owl:NamedIndividual ;
    rdfs:label "Opportunistic"@en ;
    backlog:isFrameworkOriginal "No source found. Release-planning literature names value, dependency and commitment as selection criteria and does NOT name a category for a release that was not a prioritisation decision at all. Declared framework-original rather than attributed to a source it does not have: the category exists because without it such a release must be recorded as though it had been prioritised, and that is the misreport the vocabulary is meant to prevent."@en ;
    skos2:definition "Whatever happened to be finished. The honest option for a release that was not a prioritisation decision, and the one whose absence from the vocabulary would force such a release to be recorded as though it had been."@en .

backlog:Snapshot_Baseline a backlog:ShapeSnapshot,
        owl:NamedIndividual ;
    rdfs:label "Baseline"@en ;
    skos2:definition "The last genuinely published shapes file, compared against."@en .

backlog:Snapshot_Current a backlog:ShapeSnapshot,
        owl:NamedIndividual ;
    rdfs:label "Current"@en ;
    skos2:definition "The shapes file currently shipping, being checked."@en .

backlog:Stage_ActiveUse a backlog:EntityLifecycleStage,
        owl:NamedIndividual ;
    rdfs:label "Active use"@en ;
    skos2:definition "The entity is operated on in the normal course of business."@en .

backlog:Stage_Assess a backlog:AdaptationStage,
        owl:NamedIndividual ;
    rdfs:label "Assess"@en ;
    skos2:definition "Establish which order the lineage was actually built in, from the link directions rather than from anyone's account of it. A lineage already scope-first needs no adaptation; one asserting both directions must be resolved before anything else, because it currently records no order at all."@en .

backlog:Stage_Backlog a backlog:LineageStage,
        owl:NamedIndividual ;
    rdfs:label "Backlog stage"@en ;
    backlog:stagePredecessor backlog:Stage_Objective ;
    backlog:stageRequiresType backlog:Epic,
        backlog:ExecutionTask,
        backlog:Goal,
        backlog:Initiative,
        backlog:Mission,
        backlog:Objective,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement,
        backlog:Story ;
    backlog:stageRequiresTypeV2 backlog:Defect,
        backlog:Enabler,
        backlog:Epic,
        backlog:ExecutionTask,
        backlog:Feature,
        backlog:Goal,
        backlog:Initiative,
        backlog:Mission,
        backlog:Objective,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement,
        backlog:Spike,
        backlog:Story,
        backlog:Task ;
    backlog:stageRequiresTypeV3 backlog:AcceptanceCriterion,
        backlog:Blueprint,
        backlog:Defect,
        backlog:DomainEntity,
        backlog:Enabler,
        backlog:Epic,
        backlog:ExecutionTask,
        backlog:Feature,
        backlog:Goal,
        backlog:Initiative,
        backlog:Mission,
        backlog:ModelArtifact,
        backlog:Objective,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement,
        backlog:Specification,
        backlog:Spike,
        backlog:Story,
        backlog:Task,
        backlog:TestScenario ;
    skos2:definition "Work items are chosen against deliverables that already exist."@en .

backlog:Stage_Creation a backlog:EntityLifecycleStage,
        owl:NamedIndividual ;
    rdfs:label "Creation"@en ;
    skos2:definition "The entity comes into existence: registration, intake, provisioning."@en .

backlog:Stage_FitGap a backlog:AdaptationStage,
        owl:NamedIndividual ;
    rdfs:label "Fit-gap"@en ;
    skos2:definition "Compare the standing boundary against the work actually underway and name every item that falls outside it. This is the measurement the ruling depends on, and it is the step a careful reader skips: a boundary drawn around past work usually LOOKS like it still fits, because it was built to."@en .

backlog:Stage_Relink a backlog:AdaptationStage,
        owl:NamedIndividual ;
    rdfs:label "Re-link"@en ;
    skos2:definition "Carry out what the ruling decided, and only then. Under an unchanged boundary the objectives are re-linked forward with fillsScope. Under a rewritten one the new boundary is written first and its goals and objectives are revisited beneath it, because a rewritten scope with the old goals hanging under it is the self-confirming boundary again."@en .

backlog:Stage_Ruling a backlog:AdaptationStage,
        owl:NamedIndividual ;
    rdfs:label "Ruling"@en ;
    skos2:definition "The owner decides, on the fit-gap evidence, whether the boundary is unchanged or must be rewritten. An owner decision and not a derivation: a gap is a fact, but whether it means the scope was wrong or the work was is a judgement about intent that no query can make."@en .

backlog:Stage_SuspensionException a backlog:EntityLifecycleStage,
        owl:NamedIndividual ;
    rdfs:label "Suspension / exception"@en ;
    skos2:definition "The entity is paused, blocked, cancelled, disputed or otherwise handled outside the happy path. The stage most often absent from a backlog, because titles describe the happy path."@en .

backlog:Stage_Termination a backlog:EntityLifecycleStage,
        owl:NamedIndividual ;
    rdfs:label "Termination / closure"@en ;
    skos2:definition "The entity leaves the system: deletion, archival, closure, settlement."@en .

backlog:Strat_DecreaseByFactor a backlog:RecoveryStrategy,
        owl:NamedIndividual ;
    rdfs:label "Decrease by a constant factor"@en ;
    skos2:definition "Each trial admits at least half of what the previous trial left unadmitted (reductionObserved >= 0.5, computed by the order check from the register, never hand-written). Converges in logarithmically many trials."@en .

backlog:Strat_DecreaseByOne a backlog:RecoveryStrategy,
        owl:NamedIndividual ;
    rdfs:label "Decrease by one"@en ;
    skos2:definition "Each trial admits at least one item the previous trial left unadmitted, and its bypass names at least one item no earlier bypass named. The default; tested by RestartRequiresNoveltyShape and RestartKeepsAdmissionsShape."@en .

backlog:Strat_DivideAndConquer a backlog:RecoveryStrategy,
        owl:NamedIndividual ;
    rdfs:label "Divide and conquer"@en ;
    skos2:definition "The bypassed lineage is partitioned into part lineages (parentLineage), one per scope deliverable its items satisfy; each part is rebuilt and converges on its own, a thrash freezes only its part, and the parent's rebuilt Stage_Backlog output combines (combinesOutput) every part's active Stage_Backlog output. Right for a lineage too large to restart as one."@en .

backlog:Strat_TransformReduce a backlog:RecoveryStrategy,
        owl:NamedIndividual ;
    rdfs:label "Transform: problem reduction"@en ;
    skos2:definition "The restart adopts another lineage's converged chain as its template (templateLineage): a lineage the order check reads as ORDERED, not this one. Rebuilding from nothing is reduced to instantiating a known-good structure."@en .

backlog:Strat_TransformRepresent a backlog:RecoveryStrategy,
        owl:NamedIndividual ;
    rdfs:label "Transform: representation change"@en ;
    skos2:definition "Before the restart, every bypassed Epic is decomposed (decomposesInto) so that admission is decided per Story, not per Epic (G1 granularity)."@en .

backlog:Strat_TransformSimplify a backlog:RecoveryStrategy,
        owl:NamedIndividual ;
    rdfs:label "Transform: instance simplification"@en ;
    skos2:definition "Before the restart, a ScopeChange (simplifiedBy) removes the deliverables the work never served, so the chain to rebuild is smaller than the chain that failed. The ScopeChange must first appear in git before the restart."@en .

backlog:Strat_VariableDecrease a backlog:RecoveryStrategy,
        owl:NamedIndividual ;
    rdfs:label "Variable-size decrease"@en ;
    skos2:definition "Each trial records the fraction it reduced (reductionObserved); the trial after it must reduce by no less. The reduction is the lineage's own measurement, and a shrinking reduction is the stop -- the same rule IneffectiveCorrectiveAttemptAdvisoryShape applies to objectives."@en .

backlog:Sup_InTheLoop a backlog:SupervisionMode,
        owl:NamedIndividual ;
    rdfs:label "In the loop"@en ;
    backlog:requiresIndependentEvidence false ;
    skos2:definition "The work cannot advance until a person acts. Must be evidenced by a gating interaction recorded before the transition it gates; a claim of in-the-loop supervision with no such interaction is a claim about intentions."@en .

backlog:Sup_None a backlog:SupervisionMode,
        owl:NamedIndividual ;
    rdfs:label "None"@en ;
    backlog:requiresIndependentEvidence true ;
    skos2:definition "No person supervises this work. The honest option, and the one whose absence from a vocabulary would force unsupervised work to be recorded as though supervised."@en .

backlog:Sup_OnTheLoop a backlog:SupervisionMode,
        owl:NamedIndividual ;
    rdfs:label "On the loop"@en ;
    backlog:requiresIndependentEvidence false ;
    skos2:definition "The work advances and a person may intervene afterwards. Weaker than in-the-loop and legitimately so — most automation should be on the loop — but recorded distinctly, because the two are indistinguishable in a register that only says a review happened."@en .

backlog:Superseded a backlog:DocumentStatus,
        owl:NamedIndividual ;
    rdfs:label "Superseded"@en ;
    skos2:definition "Retired but retained in place, carrying a pointer to what replaced it and the reason, so the trail from an old reference to the live source stays walkable."@en .

backlog:Table_Classification a backlog:TableKind,
        owl:NamedIndividual ;
    rdfs:label "Classification"@en ;
    skos2:definition "States what something IS — which task types exist, which metrics respond to population, which stages a pipeline has. Belongs in the ontology: an adopter cannot extend it by editing a script they do not ship."@en .

backlog:Table_Operational a backlog:TableKind,
        owl:NamedIndividual ;
    rdfs:label "Operational"@en ;
    skos2:definition "States how the tooling runs — paths, globs, file extensions, which directories a build drops. Belongs in the script: it describes the script's own behaviour, and moving it to the ontology would make the ontology answer questions about builds rather than about work."@en .

backlog:Task_Disposal a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Disposal"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.14 Disposal process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.14. Retires the element and deals with what it leaves behind."@en .

backlog:Task_Implementation a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Implementation"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.7 Implementation process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.7. Builds the element. The task type most registers record and often the only one, which is why a backlog can look full while every other process is invisible."@en .

backlog:Task_MaintenanceTask a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Maintenance"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.13 Maintenance process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.13. Sustains the delivered capability. The task-level counterpart of Kind_Maintenance at initiative level."@en .

backlog:Task_MissionAnalysis a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Mission analysis"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.1 Business or mission analysis process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.1 Business or mission analysis. Establishes what problem is being solved and why, before any solution is described. The process the owner called domain engineering: it defines the problem space, and a task here produces understanding rather than a component."@en .

backlog:Task_Operation a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Operation"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.12 Operation process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.12. Runs the system in service."@en .

backlog:Task_RequirementsDefinition a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "System/software requirements definition"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.3 System requirements definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.3. States what the system must do to meet the stakeholder requirements. The owner's business analysis sits across this and the previous process."@en .

backlog:Task_StakeholderNeeds a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Stakeholder needs and requirements"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.2 Stakeholder needs and requirements definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.2. Turns what people need into stated stakeholder requirements. Distinct from the next process because a stakeholder requirement says what someone needs, and a system requirement says what the system must therefore do — conflating them is how solutions get written into problems."@en .

backlog:Task_SystemAnalysis a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "System analysis"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.6 System analysis process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.6. Analytical work supporting a decision — trade studies, feasibility, performance modelling. The owner's technical analysis. Named separately because it produces a decision and its rationale, not a component, and is otherwise recorded as design or lost."@en .

backlog:Task_Transition a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Transition"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.10 Transition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.10. Moves the element into operation: deployment, migration, cutover, training. The owner's deployment."@en .

backlog:Thrash_AdmissionLost a backlog:ThrashKind,
        owl:NamedIndividual ;
    rdfs:label "Admission lost"@en ;
    skos2:definition "An item a rebuild admitted is bypassed again, or the output that admitted it is retracted with no re-admission: work lost in the loop."@en .

backlog:Thrash_NoNovelty a backlog:ThrashKind,
        owl:NamedIndividual ;
    rdfs:label "No novelty"@en ;
    skos2:definition "Every item the new bypass names was already named by an earlier bypass on the same lineage: the same finding again."@en .

backlog:Thrash_NotDeliberated a backlog:ThrashKind,
        owl:NamedIndividual ;
    rdfs:label "Not deliberated"@en ;
    skos2:definition "The restart, or the rebuilt Mission output, first appears in git in the same commit as the finding it answers: no separate act of deciding is witnessed."@en .

backlog:ThroughputRanking a backlog:RankingModel,
        owl:NamedIndividual ;
    rdfs:label "Throughput ranking"@en ;
    skos2:definition "Ranks the whole register by score under a named method, answering what the best next increment of capacity is for an already-live product. It divides value by cost, so a large essential capability can and will rank below a small cheap one — correct for this question, wrong for the launch question."@en .

backlog:Timing_Proactive a backlog:MaintenanceTiming,
        owl:NamedIndividual ;
    rdfs:label "Proactive"@en ;
    skos2:definition "The change anticipates. Nothing has failed and nothing has forced it, which is why proactive work is the first cut when a budget tightens and the reason it must be argued rather than assumed."@en .

backlog:Timing_Reactive a backlog:MaintenanceTiming,
        owl:NamedIndividual ;
    rdfs:label "Reactive"@en ;
    skos2:definition "The change answers something that has already occurred — a fault reported, an environment that has already moved."@en .

backlog:Ver_Major a backlog:VersionIncrement,
        owl:NamedIndividual ;
    rdfs:label "Major"@en ;
    skos2:definition "Breaking change or a new product generation. Project scale by definition — if a piece of work forces one, calling it maintenance is wrong regardless of how small it looked."@en .

backlog:Ver_Minor a backlog:VersionIncrement,
        owl:NamedIndividual ;
    rdfs:label "Minor"@en ;
    skos2:definition "Backwards-compatible addition. The normal increment for additive and adaptive maintenance."@en .

backlog:Ver_None a backlog:VersionIncrement,
        owl:NamedIndividual ;
    rdfs:label "None"@en ;
    skos2:definition "Ships nothing versioned. The honest answer for an initiative that never reaches users — a spike, an investigation, a retirement of something already dark — and its absence from the vocabulary would force such work to claim an increment it did not produce."@en .

backlog:Ver_Patch a backlog:VersionIncrement,
        owl:NamedIndividual ;
    rdfs:label "Patch"@en ;
    skos2:definition "Backwards-compatible fix, no vocabulary or interface change. The normal increment for corrective and preventive maintenance."@en .

backlog:Violated a backlog:InvariantStatus,
        owl:NamedIndividual ;
    rdfs:label "Violated"@en ;
    skos2:definition "The check was executed in this pass and returned an unexpected result; the invariant is currently broken."@en .

backlog:Stage_Goal a backlog:LineageStage,
        owl:NamedIndividual ;
    rdfs:label "Goal stage"@en ;
    backlog:stagePredecessor backlog:Stage_Scope ;
    backlog:stageRequiresType backlog:Goal,
        backlog:Mission,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement ;
    backlog:stageRequiresTypeV2 backlog:Goal,
        backlog:Mission,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement ;
    backlog:stageRequiresTypeV3 backlog:Blueprint,
        backlog:DomainEntity,
        backlog:Goal,
        backlog:Mission,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement,
        backlog:Specification,
        backlog:TestScenario ;
    skos2:definition "Goals are derived from the scope. Objectives do not exist yet."@en .

backlog:Stage_Mission a backlog:LineageStage,
        owl:NamedIndividual ;
    rdfs:label "Mission stage"@en ;
    backlog:stageRequiresType backlog:Mission ;
    backlog:stageRequiresTypeV2 backlog:Mission ;
    backlog:stageRequiresTypeV3 backlog:Mission ;
    skos2:definition "The mission is stated. Nothing below it exists yet."@en .

backlog:Stage_Objective a backlog:LineageStage,
        owl:NamedIndividual ;
    rdfs:label "Objective stage"@en ;
    backlog:stagePredecessor backlog:Stage_Goal ;
    backlog:stageRequiresType backlog:Goal,
        backlog:Mission,
        backlog:Objective,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement ;
    backlog:stageRequiresTypeV2 backlog:Goal,
        backlog:Mission,
        backlog:Objective,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement ;
    backlog:stageRequiresTypeV3 backlog:Blueprint,
        backlog:DomainEntity,
        backlog:Goal,
        backlog:Mission,
        backlog:ModelArtifact,
        backlog:Objective,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement,
        backlog:Specification,
        backlog:TestScenario ;
    skos2:definition "Objectives are set to measure the goals, with baselines taken before any work is chosen."@en .

backlog:Stage_Scope a backlog:LineageStage,
        owl:NamedIndividual ;
    rdfs:label "Scope stage"@en ;
    backlog:stagePredecessor backlog:Stage_Mission ;
    backlog:stageRequiresType backlog:Mission,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement ;
    backlog:stageRequiresTypeV2 backlog:Mission,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement ;
    backlog:stageRequiresTypeV3 backlog:Blueprint,
        backlog:DomainEntity,
        backlog:Mission,
        backlog:ScopeDeliverable,
        backlog:ScopeExclusion,
        backlog:ScopeStatement ;
    skos2:definition "The boundary and its deliverables and exclusions are written, against a mission that already exists and no goal that does not."@en .

backlog:Task_ArchitectureDefinition a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Architecture definition"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.4 System architecture definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.4. Establishes the structure: components, their responsibilities, and the boundaries between them. Separate from design definition because architecture fixes what may not change cheaply later."@en .

backlog:Task_Integration a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Integration"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.8 Integration process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.8. Assembles elements into a working whole. Distinct from implementation: a set of correct parts that do not compose is the failure this process exists to catch."@en .

backlog:Task_Validation a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Validation"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.11 Validation process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.11. Confirms the element serves its intended use in its intended environment — was the right thing built. The other half of testing, and the one skipped when verification passes and nobody asks whether the requirement was correct."@en .

backlog:Task_Verification a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Verification"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.9 Verification process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.9. Confirms the element meets its specified requirements — was it built right. Half of the owner's testing."@en .

backlog:Comp_Analysis a backlog:CompetencyCategory,
        owl:NamedIndividual ;
    rdfs:label "Analysis"@en ;
    skos2:definition "Understanding and bounding what a development must do before it is built: eliciting requirements, modelling the data conceptually, assessing impact, defining scope."@en .

backlog:Comp_Design a backlog:CompetencyCategory,
        owl:NamedIndividual ;
    rdfs:label "Design"@en ;
    skos2:definition "Deciding the shape of a solution before it is built: software architecture, ontology modelling, API design, UX design."@en .

backlog:Comp_Governance a backlog:CompetencyCategory,
        owl:NamedIndividual ;
    rdfs:label "Governance"@en ;
    skos2:definition "Deciding and maintaining how the development is run: backlog stewardship, ranking decisions, governance rulings, lineage discipline."@en .

backlog:Comp_Implementation a backlog:CompetencyCategory,
        owl:NamedIndividual ;
    rdfs:label "Implementation"@en ;
    skos2:definition "Building the thing: coding, tool scripting, data migration, integration build."@en .

backlog:Comp_Operations a backlog:CompetencyCategory,
        owl:NamedIndividual ;
    rdfs:label "Operations"@en ;
    skos2:definition "Keeping a released development running and improving: release management, tool-run operation, incident response, retrospective facilitation."@en .

backlog:Comp_Verification a backlog:CompetencyCategory,
        owl:NamedIndividual ;
    rdfs:label "Verification"@en ;
    skos2:definition "Checking that what was built is right: SHACL authoring, test design, clause proof, quality review."@en .

backlog:Task_DesignDefinition a backlog:TaskType,
        owl:NamedIndividual ;
    rdfs:label "Design definition"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.5 Design definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en ;
    skos2:definition "6.4.5. Provides detail sufficient to implement, within the architecture. Where the five DesignConcerns are analysed."@en .

backlog:Cat_Behaviour a backlog:ModelCategory,
        owl:NamedIndividual ;
    rdfs:label "Behaviour"@en ;
    skos2:definition "What the system does: its dynamics over time."@en .

backlog:Cat_Structure a backlog:ModelCategory,
        owl:NamedIndividual ;
    rdfs:label "Structure"@en ;
    skos2:definition "What the system is: its parts and their arrangement."@en .

