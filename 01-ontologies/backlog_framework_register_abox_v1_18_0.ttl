# --- the only genuine maintenance initiative in this register ---
fw:MR_OrderProblem a backlog:ModificationRequest ;
    backlog:hasRequestText "We had a mistake in the order of the lineage. Scope should be set after the mission, and goals and objectives produced to fill it." ;
    backlog:requestedAt "2026-08-11T00:00:00"^^xsd:dateTime .

fw:Init_OrderRepair a backlog:Initiative ;
    backlog:hasAcceptanceCriterion fw:AC_BRF_I5 ;
    backlog:pursuesObjective fw:Obj_OrderRecordable ;
    backlog:hasInvestmentCategory backlog:Cat_Maintenance ;
    backlog:hasIdentifier "BRF-I5" ;
    backlog:hasTitle "Scope-first lineage order" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer fw:Register ;
    backlog:hasInitiativeKind backlog:Kind_Maintenance ;
    backlog:hasMaintenanceTiming backlog:Timing_Reactive ;
    backlog:hasMaintenanceGoal backlog:Goal_Enhancement ;
    backlog:hasMaintenanceCategory backlog:Maint_Adaptive ;
    backlog:triggeredBy fw:MR_OrderProblem ;
    backlog:producesIncrement backlog:Ver_Minor ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Portfolio granularity; scored through EP10 and EP11." ;
    backlog:hasRationale "Reactive: the owner reported scope problems in applied lineages. Enhancement rather than correction: nothing was broken, a new requirement arrived about how lineages should be built. Minor increment throughout — fillsScope was added, nothing was removed or redefined, so the discriminator agrees with the label." .

fw:AC_BRF_I1 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the first build is complete, When the package is released, Then a register can express a backlog and roadmap with evidence-bound completion." .

fw:AC_BRF_I2 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a register of work, When the report is run, Then progress, cost and human involvement are reported as computed facts rather than claims." .

fw:AC_BRF_I3 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a register with a kick-off and a baseline, When the views are run, Then Gantt, earned value and the classical project views are produced from recorded facts." .

fw:AC_BRF_I4 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a register at L4, When the suite is run, Then structural views carry progress, stories fit their iterations, and deployments record how their contents were chosen." .

fw:AC_BRF_I5 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a lineage built scope-last, When the adaptation runs, Then the order it was built in is readable from link direction and a gated procedure converts it." .
