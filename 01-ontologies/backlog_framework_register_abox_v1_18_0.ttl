fw:S_Views a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 5.0 ;
    backlog:hasUserBusinessValue 7.0 ; backlog:hasTimeCriticality 4.0 ;
    backlog:hasRiskReductionValue 4.0 ; backlog:hasJobSize 3.0 ;
