    rdfs:label "No modality-specific cost predicate"@en ;
    backlog:hasCheckQuery "ASK { ?p a owl:DatatypeProperty . FILTER(REGEX(STR(?p),'tokenCost|gpuCost|humanHours')) }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_Cost .

# ---- a dated expectation that can be shown to have been optimistic ----
