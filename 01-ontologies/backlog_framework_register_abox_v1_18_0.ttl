@prefix backlog: <http://example.org/backlog#> .
@prefix skos2:   <http://www.w3.org/2004/02/skos/core#> .
@prefix core:    <http://example.org/core#> .
@prefix fw:      <http://example.org/backlog-framework-register#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/backlog-framework-register> a owl:Ontology ;
    rdfs:label "The framework's own development register"@en ;
    owl:versionIRI <http://example.org/backlog-framework-register/1.18.0> ;
    owl:versionInfo "1.18.0" ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.17.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.16.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.15.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.14.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.13.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.12.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.11.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.10.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.9.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.8.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.7.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.6.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.5.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.4.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.3.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.2.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.1.0> ;
    owl:priorVersion <http://example.org/backlog-framework-register/1.0.0> ;
    dcterms:created "2026-08-06T00:00:00"^^xsd:dateTime ;
    skos:definition "v1.1.0 completes what v1.0.0 called a lineage and was not: scope with five recorded exclusions, a Definition of Done with six executable criteria, and decomposition of the unbuilt epics into stories with acceptance criteria. v1.0.0 shipped as a FIXTURE, in 03-tooling/fixtures, while declaring its own ontology IRI and version — an ontology artifact filed as test data. Promoted here. backlog-roadmap-framework's own maintenance-and-progress work, registered under the framework itself rather than sequenced by opinion. Written because the owner asked for the lineage approach instead of an ad hoc ordering, which is what the previous turn's numbered list actually was. The ordering below is COMPUTED from declared score components, not asserted; where it disagrees with intuition the register wins or the components must be argued with."@en .

#################################################################
#  ADOPTION PROFILE — owner-decided, reasoned, dated, directional
#################################################################

fw:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "backlog-roadmap-framework's own development register" ;
    backlog:governsBacklog fw:Register ;
    backlog:hasConformanceLevel backlog:L2_EvidenceBound ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:hasLevelReviewDate "2026-11-06T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "L2 now, not L3: L3 requires verified evidence and a complete test harness on every Done item, and nothing here is Done yet, so declaring L3 today would claim a discipline no completed work has yet been held to. L3 is the target and the review date is the honest interval." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet , backlog:PrioritizationFacet ,
                        backlog:RoadmapFacet , backlog:InvariantFacet , backlog:AuditFacet .

fw:Register a backlog:Backlog ;
    backlog:hasIdentifier "BRF-REG" ;
    backlog:hasTitle "backlog-roadmap-framework development register" ;
    backlog:hasState backlog:InProgress ;
    backlog:appliesDefinitionOfDone backlog:DoD_Baseline ;
    backlog:hasCommitment fw:Commitment_Dev .

fw:Commitment_Dev a backlog:Commitment ;
    rdfs:label "Development commitment"@en ;
    backlog:commitsToGoal fw:Goal_Measurable .

#################################################################
#  TWO LINEAGES — the pattern this framework documents at 2.5c-ii
#################################################################

fw:Mission_Dev a backlog:Mission ;
    rdfs:label "Development mission"@en ;
    backlog:hasMissionStatement "Extend the framework so that a register can report its own progress, cost and human involvement as computed facts rather than as claims. Not attempted: prescribing a delivery method, an estimation scale, or a unit of value." ;
    backlog:missionFor fw:Register ;
    backlog:decidedBy backlog:Owner .

fw:Mission_Ops a backlog:Mission ;
    rdfs:label "Operational mission"@en ;
    backlog:hasMissionStatement "An adopting team can answer, from the register alone and without a spreadsheet beside it: what did this cost, how fast are we going, what will it take to finish, and where did a human decide." ;
    backlog:missionFor fw:Register ;
    backlog:decidedBy backlog:Owner .

fw:Goal_Measurable a backlog:Goal ;
    rdfs:label "Progress and cost are computed, not claimed"@en ;
    backlog:contributesToMission fw:Mission_Dev ;
    backlog:decidedBy backlog:Owner .

fw:Goal_Adopter a backlog:Goal ;
    rdfs:label "An adopter needs no spreadsheet beside the register"@en ;
    backlog:contributesToMission fw:Mission_Ops ;
    backlog:decidedBy backlog:Owner .

fw:Metric_DerivedCoverage a core:Metric ; rdfs:label "Share of progress questions answerable from the register"@en .
fw:Metric_SpreadsheetFree a core:Metric ; rdfs:label "Adopter questions needing an external tool"@en .

fw:Obj_Derived a backlog:Objective ;
    rdfs:label "Progress questions answerable without an external tool"@en ;
    backlog:contributesToGoal fw:Goal_Measurable ;
    backlog:hasSuccessMetric fw:Metric_DerivedCoverage ;
    backlog:hasBaselineValue 0.0 ;
    backlog:hasTargetValue 80.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasObjectiveDeadline "2027-02-06T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

fw:Obj_Adopter a backlog:Objective ;
    rdfs:label "Adopter questions requiring a spreadsheet"@en ;
    backlog:contributesToGoal fw:Goal_Adopter ;
    backlog:hasSuccessMetric fw:Metric_SpreadsheetFree ;
    backlog:hasBaselineValue 4.0 ;
    backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:hasObjectiveDeadline "2027-02-06T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

#################################################################
#  MEASURED INPUT — net-new term counts, actually counted
#################################################################

fw:Obs_TermCount a backlog:MetricObservation ;
    rdfs:label "Net-new terms each subject must add"@en ;
    backlog:observesMetric fw:Metric_DerivedCoverage ;
    backlog:observationFor fw:Obj_Derived ;
    backlog:hasObservedValue 47.0 ;
    backlog:observedAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Parsed backlog_tbox_v1_12_0.ttl with rdflib and tested each candidate term name for presence: S1 7 net-new, S2 11, S3 12, S4 17, total 47. A first probe was discarded as worthless because it tested only terms already known to exist and therefore returned 100% for every subject." .

#################################################################
#  THE FOUR SUBJECTS AS EPICS, each scored from declared components
#
#  WSJF = (user-business value + time criticality + risk reduction) / job size
#  Job size is the measured net-new term count, scaled to a 1-10 band
#  (7->2, 11->3, 12->4, 17->6) so the arithmetic shape stays readable while
#  the ORDERING of job sizes is the measured one, not an invented one.
#################################################################

fw:Roadmap a backlog:Roadmap ; backlog:roadmapOf fw:Register .

# ---------- S1 PBI / Task ----------
fw:EP_PbiTask a backlog:Epic ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:hasIdentifier "BRF-EP1" ;
    backlog:hasTitle "Distinguish product backlog items from execution tasks" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-06T11:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-06T13:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 9.0 ;
    backlog:hasEvidence fw:Ev_PbiTask ;
    backlog:lastAuditedAt "2026-08-06T13:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Derived ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_PbiTask ;
    backlog:hasPriorityScore fw:S_PbiTask ;
    backlog:hasCostEstimate fw:E_PbiTask ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 1 ;
    backlog:scheduledInHorizon backlog:Now .
fw:AC_PbiTask a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a register holding both stories and their execution tasks, When the report is run, Then task-level work is identifiable as subordinate and does not carry independent value, and a planning event records the conversion." .
fw:S_PbiTask a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 6.5 ;
    backlog:hasUserBusinessValue 5.0 ;
    backlog:hasTimeCriticality 4.0 ;
    backlog:hasRiskReductionValue 4.0 ;
    backlog:hasJobSize 2.0 ;
    backlog:scoredAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Time criticality is high because every other subject measures things that are counted PER ITEM, and until PBI and task are distinguished those counts double-count subordinate work. Risk reduction is high for the same reason: getting this wrong contaminates flow, cost and human-involvement figures alike." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_PbiTask a backlog:CostEstimate ;
    backlog:hasEffortEstimate 7.0 ;
    backlog:hasCostBasis "Net-new term count, measured" ;
    backlog:estimatedAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Measured ;
    backlog:basisObservation fw:Obs_TermCount .

# ---------- S2 Flow & progress ----------
fw:EP_Flow a backlog:Epic ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:hasIdentifier "BRF-EP2" ;
    backlog:hasTitle "Derive flow, velocity and forecast from recorded points" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-06T13:30:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-06T15:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 9.0 ;
    backlog:hasEvidence fw:Ev_Flow ;
    backlog:lastAuditedAt "2026-08-06T15:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Adopter ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_Flow ;
    backlog:hasPriorityScore fw:S_Flow ;
    backlog:hasCostEstimate fw:E_Flow ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 2 ;
    backlog:scheduledInHorizon backlog:Next .
fw:AC_Flow a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a register with started and finished points recorded, When the report is run, Then cycle time, item age and per-iteration velocity are computed, and any forecast states the assumptions it rests on." .
fw:S_Flow a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 4.0 ;
    backlog:hasUserBusinessValue 6.0 ;
    backlog:hasTimeCriticality 3.0 ;
    backlog:hasRiskReductionValue 3.0 ;
    backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Highest user-business value of the four: this is the subject an adopter asks for by name. Time criticality lower than EP1 because the inputs are already being recorded, so nothing is being lost while it waits." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_Flow a backlog:CostEstimate ;
    backlog:hasEffortEstimate 11.0 ;
    backlog:hasCostBasis "Net-new term count, measured" ;
    backlog:estimatedAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Measured ;
    backlog:basisObservation fw:Obs_TermCount .

# ---------- S3 Cost dimensions ----------
fw:EP_Cost a backlog:Epic ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:hasIdentifier "BRF-EP3" ;
    backlog:hasTitle "Multi-dimensional cost: tokens, environment, human time, complexity" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-09T13:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-09T15:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 13.0 ;
    backlog:hasEvidence fw:Ev_Cost ;
    backlog:lastAuditedAt "2026-08-09T15:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Adopter ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_Cost ;
    backlog:hasPriorityScore fw:S_Cost ;
    backlog:hasCostEstimate fw:E_Cost ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 3 ;
    backlog:scheduledInHorizon backlog:Next ;
    backlog:decomposesInto fw:S31 , fw:S32 , fw:S33 .
fw:AC_Cost a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given an item worked by an automated agent under human review, When its costs are recorded, Then token spend, environment cost and human time are each carried as separate named dimensions with their own units, and a budget can be compared against their sum." .
fw:S_Cost a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 2.75 ;
    backlog:hasUserBusinessValue 5.0 ;
    backlog:hasTimeCriticality 3.0 ;
    backlog:hasRiskReductionValue 3.0 ;
    backlog:hasJobSize 4.0 ;
    backlog:scoredAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Wide value but no urgency: cost dimensions are additive to an existing unit-neutral estimate, so nothing currently recorded becomes wrong while this waits. Complexity lands here as a dimension rather than a new property, per the literature split between task complexity (Wood 1986) and code complexity (McCabe 1976)." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_Cost a backlog:CostEstimate ;
    backlog:hasEffortEstimate 12.0 ;
    backlog:hasCostBasis "Net-new term count, measured" ;
    backlog:estimatedAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Measured ;
    backlog:basisObservation fw:Obs_TermCount .

# ---------- S4 Human in / on the loop ----------
fw:EP_Human a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP4" ;
    backlog:hasTitle "Human in-the-loop and on-the-loop as first-class register facts" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-09T15:30:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-09T17:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 19.0 ;
    backlog:hasEvidence fw:Ev_Human ;
    backlog:lastAuditedAt "2026-08-09T17:00:00"^^xsd:dateTime ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_InTheLoop ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Adopter ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_Human ;
    backlog:hasPriorityScore fw:S_Human ;
    backlog:hasCostEstimate fw:E_Human ;
    backlog:rankedOnRoadmap fw:Roadmap ; backlog:hasRoadmapRank 4 ;
    backlog:scheduledInHorizon backlog:Later ;
    backlog:dependsOn fw:EP_Cost ;
    backlog:decomposesInto fw:S41 , fw:S42 , fw:S43 .
fw:AC_Human a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given work executed by an agent with a human confirming before it proceeds, When the register is read, Then the execution modality is stated, the interaction is recorded as an event carrying its own cost, and in-the-loop is distinguishable from on-the-loop by whether the transition is gated." .
fw:S_Human a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 1.5 ;
    backlog:hasUserBusinessValue 4.0 ;
    backlog:hasTimeCriticality 2.0 ;
    backlog:hasRiskReductionValue 3.0 ;
    backlog:hasJobSize 6.0 ;
    backlog:scoredAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Largest job by a clear margin (17 net-new terms against 7 for EP1) and it depends on EP3, since human time is a cost dimension. Real risk reduction: an automated development with no record of where a human decided cannot be audited later. But it cannot start first." ;
    backlog:hasBasisKind backlog:Basis_Judged .
fw:E_Human a backlog:CostEstimate ;
    backlog:hasEffortEstimate 17.0 ;
    backlog:hasCostBasis "Net-new term count, measured" ;
    backlog:estimatedAt "2026-08-06T00:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Measured ;
    backlog:basisObservation fw:Obs_TermCount .

fw:Ev_PbiTask a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_positive_v1_7_0.ttl + fixture_negative_v1_7_0.ttl" ;
    backlog:hasTestId "BRF-EP1" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-06T13:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "backlog_gate_v1_1_16.sh: positive fixture carries a planned iteration with two subordinate execution tasks at 0 violations; negative fixture plants four EP1 defects (scored task, ranked task, empty planning event, parent Done over an open task) and all four fire" ;
    backlog:verifiedByTool "backlog_validate_v1_4_0.py + pyshacl 0.40.0" ;
    backlog:attestsCriterion fw:AC_PbiTask .

fw:Obs_EP1Actual a backlog:MetricObservation ;
    rdfs:label "BRF-EP1 actual: net-new terms delivered"@en ;
    backlog:observesMetric fw:Metric_DerivedCoverage ;
    backlog:observationFor fw:Obj_Derived ;
    backlog:hasObservedValue 9.0 ;
    backlog:observedAt "2026-08-06T13:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted from backlog_tbox_v1_13_0.ttl: ProductBacklogItem, ExecutionTask, PlanningEvent, plansItem, plannedInto, producesTask, plannedAt, plannedBy, plus the AllDisjointClasses axiom. Estimate was 7; actual 9. The two extra were not new scope but the disjointness axiom and plannedBy, neither of which the estimate enumerated." .

fw:Ev_Flow a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_positive_v1_7_0.ttl + fixture_negative_v1_7_0.ttl" ;
    backlog:hasTestId "BRF-EP2" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-06T15:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "backlog_roadmap_report_v1_5_0.py section 10 computes cycle time, item age and per-iteration velocity from the positive fixture and prints a recorded forecast with its three assumptions; the negative fixture plants a forecast with no assumptions and an iteration ending before it starts, and both fire" ;
    backlog:verifiedByTool "backlog_validate_v1_4_0.py + backlog_roadmap_report_v1_5_0.py" ;
    backlog:attestsCriterion fw:AC_Flow .

fw:Obs_EP2Actual a backlog:MetricObservation ;
    rdfs:label "BRF-EP2 actual: net-new terms delivered"@en ;
    backlog:observesMetric fw:Metric_SpreadsheetFree ;
    backlog:observationFor fw:Obj_Adopter ;
    backlog:hasObservedValue 9.0 ;
    backlog:observedAt "2026-08-06T15:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted from backlog_tbox_v1_14_0.ttl: iterationStart, iterationEnd, Forecast, forecastFor, forecastMadeAt, forecastCompletion, forecastAssumption, forecastObservedVelocity, forecastIterationsObserved, forecastOutcome — 10 declared, of which forecastOutcome is not yet derived by a rule, so 9 are load-bearing. Estimate was 11; actual 9. Under, because cycle time, item age, throughput and velocity needed no vocabulary at all: they are computed in the report from points the framework already recorded." .

#################################################################
#  SCOPE — declared boundary, with what is deliberately outside.
#  Absent from v1.0.0, which is precisely the omission
#  LineageCompletenessShape now refuses.
#################################################################

fw:Scope a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Vocabulary, constraints, derivations and report computations that let a register state its own progress, cost and human involvement as computed facts. Delivered as MINOR additions to the backlog subject with fixtures on both sides of every constraint and a gate that proves each can fail." ;
    backlog:scopeRealizesObjective fw:Obj_Derived , fw:Obj_Adopter ;
    backlog:hasScopeExclusion fw:Ex_Method , fw:Ex_Scale , fw:Ex_Schedule , fw:Ex_Complexity , fw:Ex_Modality .

fw:Ex_Method a backlog:ScopeExclusion ;
    backlog:excludesConcern "Prescribing a delivery method. The framework governs the register a method produces, not the method." ;
    backlog:hasExclusionRationale "Encoding Scrum, Kanban or any other cadence would privilege a practice the framework has no business choosing." ;
    backlog:decidedBy backlog:Owner .

fw:Ex_Scale a backlog:ScopeExclusion ;
    backlog:excludesConcern "Story points or any other estimation scale." ;
    backlog:hasExclusionRationale "CostEstimate is unit-neutral by design. A scale is a team convention; velocity is therefore reported in items per iteration, which is coarse and honest, rather than in a unit the framework invented." ;
    backlog:decidedBy backlog:Owner .

fw:Ex_Schedule a backlog:ScopeExclusion ;
    backlog:excludesConcern "A time-phased baseline schedule, and therefore SPI." ;
    backlog:hasExclusionRationale "Earned-value CPI is computable from estimates and actuals already recorded. SPI needs planned value against a dated baseline, and roadmap horizons are ordinal by design. Introducing one would change what a roadmap IS, which is a MAJOR decision and not part of this scope." ;
    backlog:decidedBy backlog:Owner .

fw:Ex_Complexity a backlog:ScopeExclusion ;
    backlog:excludesConcern "A dedicated complexity property on work items." ;
    backlog:hasExclusionRationale "Settled here rather than mid-build. Task complexity in the literature (Wood 1986: component, coordinative, dynamic) is largely derivable from dependsOn, DependencyKind, decomposesInto and refinement churn, all of which exist. Code complexity (McCabe 1976, cognitive complexity) belongs to an artifact, not a task, and enters as a MetricObservation with Basis_Measured. What remains — component complexity — is carried as a named CostDimension in BRF-EP3, not as a new property." ;
    backlog:decidedBy backlog:Owner .

fw:Ex_Modality a backlog:ScopeExclusion ;
    backlog:excludesConcern "Modelling human review as a WorkItem." ;
    backlog:hasExclusionRationale "Human WORK assigned to a person is a WorkItem with a human execution modality and competes for capacity. Human INTERACTION with work — confirm, review, correct, respond — is an event on that item carrying its own cost and does not compete, or every review needs a score and the backlog fills with process." ;
    backlog:decidedBy backlog:Owner .

fw:Register backlog:hasScopeStatement fw:Scope .

#################################################################
#  DEFINITION OF DONE — the bar this development is held to
#################################################################

fw:DoD a backlog:DefinitionOfDone ;
    rdfs:label "Definition of Done for framework increments"@en ;
    backlog:hasDoDCriterion fw:D1 , fw:D2 , fw:D3 , fw:D4 , fw:D5 , fw:D6 .

fw:D1 a backlog:DoDCriterion ;
    rdfs:label "D1 — Vocabulary added carries a skos:definition stating why the t"@en ;
    backlog:hasCriterionText "Vocabulary added carries a skos:definition stating why the term exists, not only what it denotes." ;
    backlog:hasCheckQuery "ASK { ?c a owl:Class . FILTER(STRSTARTS(STR(?c), \"http://example.org/backlog#\")) FILTER NOT EXISTS { ?c skos:definition ?d } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .
fw:D2 a backlog:DoDCriterion ;
    rdfs:label "D2 — Every new constraint has a planted defect in the negative fi"@en ;
    backlog:hasCriterionText "Every new constraint has a planted defect in the negative fixture that provably fires." ;
    backlog:hasCheckQuery "Gate R, negative fixture: the release gate aborts unless the known-bad fixture FAILS, so a constraint with no planted defect is invisible to it and a constraint that cannot fail blocks the release." ;
    backlog:hasExpectedResult "gate exits non-zero on the negative fixture" ;
    backlog:hasCriterionStatus backlog:Holds .
fw:D3 a backlog:DoDCriterion ;
    rdfs:label "D3 — The positive fixture demonstrates the intended pattern and v"@en ;
    backlog:hasCriterionText "The positive fixture demonstrates the intended pattern and validates at zero violations." ;
    backlog:hasCheckQuery "Gate R, positive fixture: backlog_validate reports 0 sh:Violation." ;
    backlog:hasExpectedResult "0 violations" ;
    backlog:hasCriterionStatus backlog:Holds .
fw:D4 a backlog:DoDCriterion ;
    rdfs:label "D4 — The full release gate passes from a clean extraction, includ"@en ;
    backlog:hasCriterionText "The full release gate passes from a clean extraction, including the three-fixture self-proof and the fixture-coverage gate." ;
    backlog:hasCheckQuery "backlog_gate_v1_1_16.sh run against a freshly extracted bundle." ;
    backlog:hasExpectedResult "RELEASE GATE: PASS" ;
    backlog:hasCriterionStatus backlog:Holds .
fw:D5 a backlog:DoDCriterion ;
    rdfs:label "D5 — The standard documents every class added; the doc-coverage g"@en ;
    backlog:hasCriterionText "The standard documents every class added; the doc-coverage gate enforces this." ;
    backlog:hasCheckQuery "backlog_doc_coverage_gate_v1_2_0.py: every owl:Class in the subject TBox is named in the standard." ;
    backlog:hasExpectedResult "classes declared == classes named" ;
    backlog:hasCriterionStatus backlog:Holds .
fw:D6 a backlog:DoDCriterion ;
    rdfs:label "D6 — Actual effort is recorded against the estimate, and any dive"@en ;
    backlog:hasCriterionText "Actual effort is recorded against the estimate, and any divergence carries its cause." ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState backlog:Done ; backlog:hasCostEstimate ?e . FILTER NOT EXISTS { ?i backlog:hasActualEffort ?a } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

fw:Register backlog:appliesDefinitionOfDone fw:DoD .

#################################################################
#  DECOMPOSITION — what the remaining epics actually consist of.
#  Absent from v1.0.0: four scored epics broken into nothing, which
#  is why a mid-build decision had nowhere to be settled in advance.
#  Each story is scoreable in its own right; per the framework's own
#  rule the parent epics carry scores and these do not, so nothing
#  double-counts. They are notYetScoreable with the reason recorded.
#################################################################

fw:S31 a backlog:Story ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:hasIdentifier "BRF-S31" ;
    backlog:hasTitle "CostDimension with unit and rate" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-09T13:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-09T15:00:00"^^xsd:dateTime ;
    backlog:hasEvidence fw:Ev_Cost ;
    backlog:lastAuditedAt "2026-08-09T15:00:00"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Adopter ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasAcceptanceCriterion fw:AC_S31 ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at epic level; scoring a decomposition child alongside its scored parent would double-count the parent's value, which the framework refuses." .
fw:AC_S31 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given an item worked partly by an agent and partly by a person, When its costs are recorded, Then token spend, environment cost and human minutes are each a named dimension carrying its own unit, and no dimension is assumed to be effort." .

