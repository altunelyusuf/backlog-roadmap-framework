    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:lastAuditedAt "2026-08-27T07:00:00Z"^^xsd:dateTime ;
    backlog:memberOfContainer fw:Register , fw:It10 , fw:Pkg_GovernanceQueryable ;
    backlog:pursuesObjective fw:Obj_TablesExported ;
    backlog:satisfiesDeliverable fw:Del_OntExport ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasApplicableConcern backlog:Concern_Data ;
    backlog:hasAcceptanceCriterion fw:AC_S_Tables_B1 ;
    backlog:hasEffortEstimate 3.0 ;
    backlog:hasBatchSize 4 ;
    backlog:hasBatchCompleted 4 ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at epic level." .
fw:AC_S_Tables_B1 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given 4 python classification tables, When this story is Done, Then each of the 4 is an ontology enumeration, each literal is deleted, and each reader fails loudly rather than falling back — verified per table, not per story." .
fw:R_S_Tables_B1 a backlog:RefinementEvent ; backlog:refines fw:S_Tables_B1 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:groomsForIteration fw:It10 ;
    backlog:refinedAt "2026-08-27T05:56:00Z"^^xsd:dateTime ; backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "Subject: Roadmap report: CONTAINER_TYPES, SECTIONS; pipeline verifier: STAGE_TYPES, ORDER. Batched at four because the concealment measurement puts the knee there. The acceptance criterion verifies PER TABLE — the It8 fallback trap recurs once per reader changed, and one criterion covering four readers would let three silent fallbacks pass." .
fw:EP_TablesBatch backlog:decomposesInto fw:S_Tables_B1 .

