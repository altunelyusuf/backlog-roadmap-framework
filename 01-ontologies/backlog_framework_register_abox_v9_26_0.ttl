    backlog:appliesDefinitionOfDone fw:DoD_EP_TablesBatch ;
    backlog:rankedOnRoadmap fw:Roadmap ;
    backlog:scheduledInHorizon backlog:Now ;
    backlog:hasRationale "Created because EP_CodeTables was Done and reopening it would make its completion untrue. Subject: the 22 tables the first epic did not reach." .
