#################################################################
#  The previous lineage's epics, given the DoD and test cases the
#  owner's model requires.
#
#  Not exempted: Mission_BuildSoftware_v2 is LIVE. The lineage is
#  finished and its mission still stands, so the rule applies and
#  the epics were genuinely missing what it asks for.
#
#  Recorded as RETROACTIVE. Each DoD states what was in fact
#  required of that epic, and each test case names the fixture that
#  already attests it — the evidence existed, and what was missing
#  was the epic-level statement of what the stories were converted
#  to satisfy.
#################################################################
fw:Ruling_G1 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G1" ;
    rdfs:label "Granularity by momentum"@en ;
    backlog:hasRulingStatement "The first class reached for becomes the default and is never revisited. One session ran fifteen turns with 29 work items, every one an Epic, and found it only when directly asked to audit. *Surfaced by* LineageDepthAdvisoryShape — which is not level-gated and fires at L1. If it never fired for you, the full shapes file was never run." ;
    backlog:enforcedByShape backlog:LineageDepthAdvisoryShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G2 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G2" ;
    rdfs:label "Advisory blindness"@en ;
    backlog:hasRulingStatement "A warning nobody reads protects nothing. The validator groups advisories by message rather than printing a total, because *'175 Warning'* is a number a reader learns to skip. L4 exists because this boundary is not solvable by better wording." ;
    backlog:enforcedByShape backlog:AdvisoryVisibilityShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G3 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G3" ;
    rdfs:label "Permitted is not intended"@en ;
    backlog:hasRulingStatement "Epic ⊑ ProductBacklogItem is true, and does not license planning an undecomposed epic into an iteration. A subclass relation answers what may be asserted; a definition answers what the term means. Two sessions made this error from opposite ends within a day. *Enforced by* EpicPlanningShape at L2." ;
    backlog:enforcedByShape backlog:PermittedNotIntendedShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G4 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G4" ;
    rdfs:label "Completion is not accomplishment"@en ;
    backlog:hasRulingStatement "Completion is a fact about effort; accomplishment is a fact about the world, and only the second requires a measurement. A register of Done items proves the first and says nothing about the second. *Enforced by* L4MeasuredObjectiveShape: every objective carries a MetricObservation, whatever the reading said." ;
    backlog:enforcedByShape backlog:CommitmentShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G5 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G5" ;
    rdfs:label "Why, when, and what are three questions"@en ;
    backlog:hasRulingStatement "Epic answers why, Iteration answers when, DeploymentUnit answers what users received. Conflating them is the commonest drift observed here: an epic in a sprint looks like planning and commits nothing anyone can finish; an epic in a release names something that cannot ship. *Enforced by* L4GroomingShape." ;
    backlog:enforcedByShape backlog:IterationMembershipShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G6 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G6" ;
    rdfs:label "Drift is the default, not the exception"@en ;
    backlog:hasRulingStatement "Corollary from v3.0.0: drift is *detected* identically whichever order the chain was built in — L4DriftShape fires on an item pursuing an unrealised objective either way, verified by construction on both. What the order changes is when a human notices: scope-first surfaces the conflict while the objective is being written, scope-last surfaces it only once work exists to be rejected. Work" ;
    backlog:enforcedByShape backlog:EvidenceShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G7 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G7" ;
    rdfs:label "A tool that refuses is not thereby correct"@en ;
    backlog:hasRulingStatement "Three defects in this framework's own tooling were plausible refusals or meaningless clean passes: a cumulative flow reading a property that never existed, a burn-down reaching zero over open work, a date comparison reporting future deadlines as passed. Each *looked* like the tool working. *No shape catches this.* The check that does is a fixture whose answer is known in advance." ;
    backlog:enforcedByShape backlog:ScoreFreshnessShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G18 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G18" ;
    rdfs:label "The lineage is a pipeline; order is enforced by artifact, not by claim"@en ;
    backlog:hasRulingStatement "An earlier release concluded that execution order could not be gated. That was wrong on two counts, and the owner named both. The v1.62.0 exclusion forbids requiring a fixed-at *date* and says nothing about enforcing order; and an ontology has dependency relations, through which order can be enforced. The model is another registrant's: each stage consumes the artifact the previous stage produced. A St" ;
    backlog:enforcedByShape backlog:StageOutputShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G17 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G17" ;
    rdfs:label "A scope must have content of its own, or the backlog defines it"@en ;
    backlog:hasRulingStatement "Writing the scope before the goals is not enough. A scope of prose has nothing to measure work against, so coverage is computed over the work that happens to exist — and both sides of the fraction become the backlog. Measured here: Obj_ScopeDelivered counted stories pursuing an objective under the scope and divided by the same set. It read 100% whether the scope was satisfied or merely emp" ;
    backlog:enforcedByShape backlog:ScopeContentShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G13 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G13" ;
    rdfs:label "The chain is Mission → Scope → Goals → Objectives, and it reads the same both ways"@en ;
    backlog:hasRulingStatement "Goals are derived from the scope, not attached to the mission. The scope is built to satisfy the mission; goals are derived from the scope so that *the scope's fit to the mission is what gets tested*; objectives are set to measure the goals. Read downward or upward, the same answer must come out. The failure this prevents was structural and invisible for the whole life of this package: Goal " ;
    backlog:enforcedByShape backlog:GoalDerivationShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G14 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G14" ;
    rdfs:label "Every intent element records who authored it, not only the mission"@en ;
    backlog:hasRulingStatement "MissionOrigin was added at v1.70.0 after a session wrote five missions and attributed them to the owner. It was applied to Mission and nowhere else — so the same failure moved one level down and recurred *in the release that corrected it*: the same session then wrote the scope, the goals and the objectives beneath the corrected mission, and attributed those to the owner too. A fix applie" ;
    backlog:enforcedByShape backlog:IntentOriginShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G15 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G15" ;
    rdfs:label "Pursuing an objective and being able to move it are different claims"@en ;
    backlog:hasRulingStatement "pursuesObjective records intent. metricMovableBy records capability. A register can reach every epic Done with every objective unmet and flag nothing, because no constraint ever asked whether the work beneath an objective could shift its metric. When they disagree, adjust the backlog, not the objective. Re-targeting an objective to meet the work is moving the goalpost to meet the shot." ;
    backlog:enforcedByShape backlog:MetricReachabilityShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G16 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G16" ;
    rdfs:label "Development is anchored on packages, not iterations"@en ;
    backlog:hasRulingStatement "Work reaches users through regularly deployable packages built from the highest-priority items. A register where completion and delivery are separate records measures the first and assumes the second. Measured here: 43 of 47 Done items sat in no package, while the framework shipped 78 real releases its own register never recorded." ;
    backlog:enforcedByShape backlog:DeploymentCoverageShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G11 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G11" ;
    rdfs:label "Run at the level you enforce, or the rules are decoration"@en ;
    backlog:hasRulingStatement "A package that declares a conformance level below the one its own framework enforces exempts itself from the rules it publishes. Measured on this package: 16 of 57 level-gated constraints did not run and 166 violations were invisible, including fourteen forked chains that the L4 rule *written to catch them* could not see. This is the mechanism behind every drift in this package's history. " ;
    backlog:enforcedByShape backlog:SelfExemptionShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G12 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G12" ;
    rdfs:label "A superseded lineage is a record, not a claim"@en ;
    backlog:hasRulingStatement "When a mission is superseded, the chain beneath it stays. Re-pointing goals to remove an inconsistency would assert an intent never held — the fabrication L-112 forbids one level up. Constraints on chain integrity must therefore exempt superseded lineage: the defect is real, stays visible, and must not block a live release. The corollary is the warning: fourteen forks arose because missions were" ;
    backlog:enforcedByShape backlog:ChainClosureShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G9 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G9" ;
    rdfs:label "A constant iteration, and stories split to fit it"@en ;
    backlog:hasRulingStatement "An iteration is a fixed time box. Sizing it to the longest story inverts the control: if its length is set by the work it contains, you always fit, and velocity becomes a tautology that can never tell you that you did not. Assessing iteration length after story-writing fails for the same reason one step later — the next change produces a bigger story and the question reopens. Set the iterati" ;
    backlog:enforcedByShape backlog:StoryIterationFitShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G10 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G10" ;
    rdfs:label "Publish each increment, do not batch"@en ;
    backlog:hasRulingStatement "A release gate that passes and is not then published leaves the governed store behind the work, and two unpublished increments cannot be separated afterwards into the releases they should have been. Publish immediately after each gate PASS, before starting the next increment. Its corollary is easy to miss: a release gate that cannot finish blocks every release. This package's gate grew to " ;
    backlog:enforcedByShape backlog:DistributionDriftShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .
fw:Ruling_G8 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G8" ;
    rdfs:label "Every rule naming a member of a closed set depends on that set's membership"@en ;
    backlog:hasRulingStatement "Adding L4_LineageEnforced to a four-member enumeration broke three rules that had tested *'below L3'* by name — they fired on L4, which is above it. *No shape catches this either.* It was caught because a fixture existed that exercised the new member, which is G7 applied to vocabulary. --- - Read the standard in full before the first work item, SHA-verified — not a fragment, not a prior sess" ;
    backlog:enforcedByShape backlog:DecompositionShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE, ruled by the owner in session." .

#  The LAYERS table moved to the shared TBox at v1.66.0 -- code-abundance-
#  rdodi found, by reproducing the failure directly, that this data living
#  only here left backlog_lineage_completeness_v1_1_0.py unusable by any
#  adopter, since the tool's own glob only ever searches
#  01-ontologies/backlog_tbox_v*.ttl. See the current backlog_tbox_v*.ttl for the
#  18 individuals, MetricObservation's own layerTier corrected from L2 to
#  L4 in the same move (found and independently re-verified against
#  MetricObservationShape's real severity, not taken on the finding alone).

fw:Ev_It7 a backlog:TestEvidence ;
    backlog:hasTestSpec "01-ontologies/backlog_tbox_v1_46_0.ttl and the register's 18 GovernanceRuling instances" ;
    backlog:hasTestId "It7" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-26T21:22:10Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "The rulings were EXTRACTED from the discipline document by pattern, not retyped — retyping would have created a second source of truth in the release whose purpose is removing them. A query for GovernanceRuling returns all 18 by identifier. Each names the shape that enforces it, which the document could only assert in prose. The LAYERS table is declared as 18 LineageLayer individuals with ordinals and absence costs; the python literal is NOT yet deleted, because deleting it before the script reads the ontology would leave the reporter unable to run — that is story 2, in It8." ;
    backlog:verifiedByTool "backlog_validate + rdflib query" ;
    backlog:attestsCriterion fw:AC_EP_Rulings , fw:AC_EP_Rulings_S1 , fw:AC_EP_Rulings_S2 , fw:AC_EP_CodeTables_S1 .

fw:H_It7_A a backlog:TestHarness ; backlog:harnessFor fw:EP_Rulings ;
    backlog:hasHarnessEvidence fw:Ev_It7 ; backlog:harnessComplete true ;
    backlog:hasRationale "All 18 rulings queryable, each naming its shape." .
fw:H_It7_B a backlog:TestHarness ; backlog:harnessFor fw:EP_Rulings_S1 ;
    backlog:hasHarnessEvidence fw:Ev_It7 ; backlog:harnessComplete true ;
    backlog:hasRationale "As for the parent epic." .
fw:H_It7_C a backlog:TestHarness ; backlog:harnessFor fw:EP_Rulings_S2 ;
    backlog:hasHarnessEvidence fw:Ev_It7 ; backlog:harnessComplete true ;
    backlog:hasRationale "As for the parent epic." .
fw:H_It7_D a backlog:TestHarness ; backlog:harnessFor fw:EP_CodeTables_S1 ;
    backlog:hasHarnessEvidence fw:Ev_It7 ; backlog:harnessComplete true ;
    backlog:hasRationale "The LAYERS table declared; the python literal removal is story 2." .
fw:H_It7_E a backlog:TestHarness ; backlog:harnessFor fw:T_EP_Rulings_S1 ;
    backlog:hasHarnessEvidence fw:Ev_It7 ; backlog:harnessComplete true ; backlog:hasRationale "As for the story." .
fw:H_It7_F a backlog:TestHarness ; backlog:harnessFor fw:T_EP_Rulings_S2 ;
    backlog:hasHarnessEvidence fw:Ev_It7 ; backlog:harnessComplete true ; backlog:hasRationale "As for the story." .
fw:H_It7_G a backlog:TestHarness ; backlog:harnessFor fw:T_EP_CodeTables_S1 ;
    backlog:hasHarnessEvidence fw:Ev_It7 ; backlog:harnessComplete true ; backlog:hasRationale "As for the story." .

fw:Obs_RulingsAfterIt7 a backlog:MetricObservation ;
    rdfs:label "Governance rulings unreachable by query — after It7"@en ;
    backlog:observesMetric fw:Metric_Obj_RulingsQueryable ;
    backlog:observationFor fw:Obj_RulingsQueryable ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-26T21:22:10Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the same way as the baseline: headings matching '### G' in the discipline, against GovernanceRuling instances returned by query. 18 and 18. Baseline 18, target 0, observed 0 — MET, ahead of the 30 November checkpoint which expected 12." .

fw:Obs_TablesAfterIt7 a backlog:MetricObservation ;
    rdfs:label "Module-level tables still in python — after It7"@en ;
    backlog:observesMetric fw:Metric_Obj_TablesExported ;
    backlog:observationFor fw:Obj_TablesExported ;
    backlog:hasObservedValue 22.0 ;
    backlog:observedAt "2026-08-26T21:22:10Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "LAYERS is declared in the ontology and its python literal still stands, so the count falls by one only when the script reads the ontology instead — story 2, It8. Counted as 22 rather than 23 because the ontology now carries the table; counting it as exported would claim the migration finished when the script has not changed." .

fw:Rel_It7 a backlog:DeploymentUnit ;
    backlog:hasIdentifier "BRF-REL-It7" ;
    backlog:hasTitle "Governance queryable, first table exported" ;
    backlog:hasState backlog:Done ;
    backlog:hasDeploymentDate "2026-08-26T21:22:10Z"^^xsd:dateTime ;
