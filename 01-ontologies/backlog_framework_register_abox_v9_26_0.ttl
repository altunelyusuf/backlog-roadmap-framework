#################################################################
#  It12 WITHDRAWN. The last six tables were never in scope.
#
#  Reading the six remaining tables before exporting them: every
#  one is operational. PATTERNS and SCAN are regex and glob lists,
#  PLACEHOLDERS validates a template, PUBLIC_ONLY and VOLATILE name
#  files, SPEC is a completed script's own work list.
#
#  The v1.117.0 split sorted by NAME rather than by content —
#  SCAN and PATTERNS sound like classifications and are not. That
#  misclassification would have exported six regex lists into an
#  ontology about backlogs, adding classes the exported material
#  does not require, which is what Obj_NoNewClasses exists to stop.
#
#  Withdrawn rather than deleted: the stories were real, they were
#  planned and groomed, and the reason they will not be built is a
#  finding worth keeping.
#################################################################

fw:Obs_TablesFinal a backlog:MetricObservation ;
    rdfs:label "Classification tables remaining — final"@en ;
    backlog:observesMetric fw:Metric_Obj_TablesExported ;
    backlog:observationFor fw:Obj_TablesExported ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-27T07:55:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Zero classification tables remain in python. Eight moved: LAYERS, the quality metrics, STAGE_TYPES, ORDER, CONTAINER_TYPES, SECTIONS, KINDS, FOREIGN, SUITES, DECLARED_PROPOSALS. Eighteen were ruled operational and stay — twelve at v1.117.0 and six more here, reclassified after reading their contents rather than their names. The original baseline of 23 counted every capitalised assignment; the honest denominator was eight. Both readings are recorded, because a target reached by narrowing the population is not the same as a target reached by doing the work, and only the first sentence of this method distinguishes them." .

#  EP_TablesBatch lost its state to a regex that matched more than
#  it should have. Restored to Done: both its live stories are
#  Done, its other two are Withdrawn, and the epic has nothing
#  outstanding.
fw:EP_TablesBatch backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-27T06:30:00Z"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-27T07:55:00Z"^^xsd:dateTime ;
    backlog:hasActualEffort 12.0 ;
    backlog:hasEvidence fw:Ev_It11 ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:lastAuditedAt "2026-08-27T07:55:00Z"^^xsd:dateTime .
fw:H_EP_TablesBatch a backlog:TestHarness ; backlog:harnessFor fw:EP_TablesBatch ;
    backlog:hasHarnessEvidence fw:Ev_It11 ; backlog:harnessComplete true ;
    backlog:hasRationale "Four batch stories Done, two Withdrawn as out of scope, zero classification tables remaining." .

#  Cancellation rationales. The two stories were real, planned and
#  groomed; what changed is that reading their content showed the
#  tables were operational.
fw:S_Tables_B5 backlog:hasRationale "Cancelled at v1.118.0 after reading its four tables rather than their names. PATTERNS and SCAN are regex and glob lists; PLACEHOLDERS validates a template. None names a class, relationship, property or instance of the backlog domain, so exporting them would add classes the exported material does not require — which Obj_NoNewClasses is held at zero to prevent." .
fw:S_Tables_B6 backlog:hasRationale "Cancelled at v1.118.0 for the same reason: PUBLIC_ONLY and VOLATILE name files, SPEC is a completed script's own work list." .

#  The epic was groomed once at the batch level; the concern it
#  declares is addressed by that refinement.
fw:R_EP_TablesBatch a backlog:RefinementEvent ;
    backlog:refines fw:EP_TablesBatch ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:groomsForIteration fw:It10 ;
    backlog:refinedAt "2026-08-27T06:30:00Z"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "Batched at four. The decisive analysis came during execution rather than before it: reading each table showed that only eight of the twenty-three were classification, and the other fifteen state how the tooling runs. Recorded here rather than backdated to the original grooming, which did not know it." .

#################################################################
#  Container states derived, not asserted by preference.
#
#  R1a says a container is Done when no member is outside
#  (Done, Cancelled). It12's four members are all Cancelled, so its
#  derived state is Done — the iteration is FINISHED, having
#  delivered nothing, which is a different claim from the iteration
#  being cancelled. The distinction matters: a cancelled iteration
#  never closed; this one closed with all its content withdrawn,
#  and the register should say which happened.
#################################################################

#################################################################
#  It12 REMOVED, not marked Done.
#
#  The L4 clause is right and it caught the easier answer: an
#  iteration that is Done must have shipped something, and It12
#  shipped nothing because all four of its members were cancelled
#  before it ran.
#
#  Marking it Done would have recorded a closed iteration with no
#  deployment — a cadence entry that never happened. An iteration
#  whose entire content was withdrawn before it started was never
#  an iteration, so it is removed and the two cancelled stories
#  sit outside any time box, which is what they are.
#
#  The stories themselves stay Cancelled with their rationale.
#  They were real, planned and groomed; what changed is that
#  reading their tables showed the work was out of scope.
#################################################################

#  The two cancelled tasks go with their planning events. A task
#  exists because a planning event produced it; with the event
#  removed the task has no origin, and an orphan task is exactly
#  what the L1 clause objects to.

#  Header words, exported from the row checker.
fw:HW_Term a backlog:TableHeaderWord ; backlog:headerWord "Term" .
fw:HW_Field a backlog:TableHeaderWord ; backlog:headerWord "Field" .
fw:HW_Property a backlog:TableHeaderWord ; backlog:headerWord "Property" .
fw:HW_Class a backlog:TableHeaderWord ; backlog:headerWord "Class" .
fw:HW_Level a backlog:TableHeaderWord ; backlog:headerWord "Level" .
fw:HW_Kind a backlog:TableHeaderWord ; backlog:headerWord "Kind" .
fw:HW_Name a backlog:TableHeaderWord ; backlog:headerWord "Name" .
fw:HW_Value a backlog:TableHeaderWord ; backlog:headerWord "Value" .
fw:HW_Rule a backlog:TableHeaderWord ; backlog:headerWord "Rule" .
fw:HW_Stage a backlog:TableHeaderWord ; backlog:headerWord "Stage" .
fw:HW_Concern a backlog:TableHeaderWord ; backlog:headerWord "Concern" .
fw:HW_Facet a backlog:TableHeaderWord ; backlog:headerWord "Facet" .

#  Documented abbreviations. The row checker read these as absent
#  terms because it resolves identifiers literally.
fw:AB_L1 a backlog:TermAbbreviation ; backlog:abbreviationText "L1" ; backlog:abbreviationOf backlog:L1_Structural .
fw:AB_L2 a backlog:TermAbbreviation ; backlog:abbreviationText "L2" ; backlog:abbreviationOf backlog:L2_EvidenceBound .
fw:AB_L3 a backlog:TermAbbreviation ; backlog:abbreviationText "L3" ; backlog:abbreviationOf backlog:L3_Governed .
fw:AB_L4 a backlog:TermAbbreviation ; backlog:abbreviationText "L4" ; backlog:abbreviationOf backlog:L4_LineageEnforced .

#################################################################
#  The audit caught its own author, and the row checker its own
#  limit.
#################################################################

fw:Ev_It12 a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_script_decision_audit_v1_0_0.py and backlog_standard_row_check_v1_0_0.py" ;
    backlog:hasTestId "post-It11" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T08:20:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "The script-decision audit shipped at It9 reporting zero. It now reports the row checker written in the SAME iteration: a tuple of header words and a bold-text test. An audit that passes once is a measurement; one that keeps passing is a constraint. Header words exported as TableHeaderWord; the bold test is presentation, stays in the script, and is marked audit-exempt in place rather than hidden. Audit back to zero over 21 scripts. Separately the row checker was reading L2, L3 and L4 as absent terms because it resolves identifiers literally and the classes are L2_EvidenceBound and so on — a checker defect, fixed by teaching it the documented abbreviation rather than by rewriting the document or excluding the rows, either of which would make the checker agree with the document by construction. 21 unchecked rows fell to 17." ;
    backlog:verifiedByTool "backlog_script_decision_audit + backlog_standard_row_check" ;
    backlog:attestsCriterion fw:AC_EP_StandardRows_S2 .

fw:Obs_RowsFinal a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_Obj_RowsUnchecked ;
    backlog:observationFor fw:Obj_RowsUnchecked ;
    backlog:hasObservedValue 17.0 ;
    backlog:observedAt "2026-08-27T08:20:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Baseline 186 — every row uncheckable. Now 128 resolve to a TBox term and are checked, 3 are structural, 17 remain. Those 17 are CLAIM rows: their first cell is a finding about the framework — 'Order needs an external witness', 'Digests catch fabrication' — and a finding has no IRI to check against. Three options were weighed. Giving each an IRI would invent individuals so a checker can pass, growing the register to satisfy a measure. Excluding them would make the checker agree with the document by construction. Stating the limit is the third, and it is why this reads 17 rather than 0: the objective will not reach its target, and the reason is a property of prose rather than a shortfall in the work." .

fw:Inv_ClaimRowsUncheckable a backlog:CrossCuttingInvariant ;
    rdfs:label "Claim rows cannot be checked against a TBox"@en ;
    backlog:hasCheckQuery "Manual: read the 17 reported rows and confirm each first cell is a sentence rather than an identifier." ;
    backlog:hasExpectedResult "17, and accepted" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_StandardRows ;
    backlog:hasRationale "Recorded as a manual check because deciding whether a first cell is a claim or a name is a reading, and a SPARQL query claiming to do it would be the same false precision the 17 rows exist to avoid. Obj_RowsUnchecked will not reach 0 and the reason is stated rather than engineered away." .

#################################################################
#  Every criterion of this lineage names the artefact that makes
#  it true. Named per criterion, so one that is false cannot be
#  carried by a claim about its neighbours.
#################################################################
fw:AC_EP_Rulings_S1 backlog:satisfiedByArtifact "backlog:GovernanceRuling" .
fw:AC_EP_Rulings_S2 backlog:satisfiedByArtifact "backlog:enforcedByShape" .
fw:AC_EP_CodeTables_S1 backlog:satisfiedByArtifact "backlog:LineageLayer" .
fw:AC_EP_CodeTables_S2 backlog:satisfiedByArtifact "03-tooling/backlog_lineage_completeness_v*.py#_load_layers" .
fw:AC_EP_RuleExec_S1 backlog:satisfiedByArtifact "backlog:hasExpectedPolarity" .
fw:AC_EP_RuleExec_S2 backlog:satisfiedByArtifact "backlog:ForeignNamespace" .
fw:AC_EP_ScriptDecisions_S1 backlog:satisfiedByArtifact "03-tooling/backlog_script_decision_audit_v*.py#PATTERNS" .
fw:AC_EP_StandardRows_S1 backlog:satisfiedByArtifact "03-tooling/backlog_standard_row_check_v*.py#tbox_terms" .
fw:AC_EP_StandardRows_S2 backlog:satisfiedByArtifact "03-tooling/backlog_standard_row_check_v*.py#ABSENT" .
fw:AC_S_Tables_B1 backlog:satisfiedByArtifact "backlog:stageRequiresType" .
fw:AC_S_Tables_B2 backlog:satisfiedByArtifact "backlog:ReportSection" .
