    dcterms:created "2026-08-06T00:00:00"^^xsd:dateTime ;
    skos:definition "v1.1.0 completes what v1.0.0 called a lineage and was not: scope with five recorded exclusions, a Definition of Done with six executable criteria, and decomposition of the unbuilt epics into stories with acceptance criteria. v1.0.0 shipped as a FIXTURE, in 03-tooling/fixtures, while declaring its own ontology IRI and version — an ontology artifact filed as test data. Promoted here. backlog-roadmap-framework's own maintenance-and-progress work, registered under the framework itself rather than sequenced by opinion. Written because the owner asked for the lineage approach instead of an ad hoc ordering, which is what the previous turn's numbered list actually was. The ordering below is COMPUTED from declared score components, not asserted; where it disagrees with intuition the register wins or the components must be argued with."@en .

#################################################################
#  ADOPTION PROFILE — owner-decided, reasoned, dated, directional
#################################################################

fw:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "backlog-roadmap-framework's own development register" ;
    backlog:governsBacklog fw:Register ;
    backlog:hasConformanceLevel backlog:L4_LineageEnforced ;
    backlog:hasTargetConformanceLevel backlog:L4_LineageEnforced ;
    backlog:hasLevelReviewDate "2026-11-06T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "L2 now, not L3: L3 requires verified evidence and a complete test harness on every Done item, and nothing here is Done yet, so declaring L3 today would claim a discipline no completed work has yet been held to. L3 is the target and the review date is the honest interval." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet , backlog:PrioritizationFacet ,
                        backlog:RoadmapFacet , backlog:InvariantFacet , backlog:AuditFacet .

fw:Register a backlog:Backlog ;
    backlog:hasIdentifier "BRF-REG" ;
    backlog:hasTitle "backlog-roadmap-framework development register" ;
    backlog:hasState backlog:Done ;
    backlog:appliesDefinitionOfDone backlog:DoD_Baseline ;
    backlog:hasCommitment fw:Commitment_Dev .

fw:Register backlog:hasScopeStatement fw:Scope .

#################################################################
#  DEFINITION OF DONE — the bar this development is held to
#################################################################

fw:Register backlog:appliesDefinitionOfDone fw:DoD .

#################################################################
#  DECOMPOSITION — what the remaining epics actually consist of.
#  Absent from v1.0.0: four scored epics broken into nothing, which
#  is why a mid-build decision had nowhere to be settled in advance.
#  Each story is scoreable in its own right; per the framework's own
#  rule the parent epics carry scores and these do not, so nothing
#  double-counts. They are notYetScoreable with the reason recorded.
#################################################################

fw:Mission_OntologyDriven a backlog:Mission ;
    backlog:producedByStage fw:Out2_Mission ;
    backlog:hasMissionStatement "The framework is ontology-driven: classes, relationships, properties and instances that today live in prose or in source code are exported to the ontology, the governance model is expressed as ontology rather than as documentation, and rule execution moves from prose and code to the ontology layer. What remains as prose explains; what remains as code executes standard engines. Neither carries meaning that only they define." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-10-26, verbatim: 'a new mission and a new lineage to reduce the dependency on the prose and source code. I want you to convert the current configuration to be ontology driven by analyzing the prose and source code and identify the possible exports from them to the ontology not just the rules but also the clasesses, relationships, properties, objects/instances, and other ontologic concpepts. Additionally, the governance model should be based on the ontologies and execution of the rules be transferred to the ontology levels from the prose and source codes.' Follows the owner's finding at v1.98.0 that prose is the largest and least verified layer: 7197 lines nothing checks against the ontology, and that every drift in this session occurred in prose nothing could contradict." ;
    backlog:decidedBy backlog:Owner .

fw:Out2_Mission a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ;
    backlog:hasStateDigest "a5d24736308c8ad46fdd1b4230b941757cba52738bde4e5582317ad426b126fb" ;
    backlog:closedAtCommit "f2f4e0f" ;
    backlog:hasRationale "Digest and commit backfilled at v1.100.0, once the commit existed. Recorded as pending in the release that created the stage rather than fabricated, then written from the real commit — which is the only honest order available when a stage output must name a commit the publish has not yet made." .


#################################################################
#  v5.1.0 — STAGE 2: THE SCOPE. Deliverables and exclusions only.
#
#  The Mission stage closed at commit f2f4e0f and its digest is
#  backfilled above from the real commit. This commit closes the
#  Scope stage: what the boundary REQUIRES, read clause by clause
#  from the owner's mission, with no goals, no objectives and no
#  backlog. Those close in later commits.
#
#  Five deliverables, each quoting the mission clause it came from
#  — the check added at v1.90.0 after the previous scope was found
#  wider than its mission.
#################################################################
fw:Del_OntGovernance a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "The governance model is expressed as ontology: every governance ruling the framework enforces exists as a machine-checkable statement, not only as a heading in a document." ;
    backlog:derivesFromMissionClause "the governance model is expressed as ontology rather than as documentation" .
fw:Del_OntRuleExec a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "Rule execution happens at the ontology layer: a rule's meaning is carried by the ontology and code only runs a standard engine over it, so no rule can behave differently from what the ontology says." ;
    backlog:derivesFromMissionClause "rule execution moves from prose and code to the ontology layer" .
fw:Del_OntExport a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "Classes, relationships, properties and instances that live in prose or in source code are exported to the ontology, so that meaning is not defined by a table in a document or a map in a script." ;
    backlog:derivesFromMissionClause "classes, relationships, properties and instances that today live in prose or in source code are exported to the ontology" .
fw:Del_ProseExplains a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "What remains as prose explains and does not define. A document may describe what the ontology says; it may not be the only place something is said." ;
    backlog:derivesFromMissionClause "What remains as prose explains" .
fw:Del_CodeExecutes a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "What remains as code executes standard engines and carries no meaning of its own. A script may run a validator; it may not decide what is valid." ;
    backlog:derivesFromMissionClause "what remains as code executes standard engines" .

fw:Scope_Ontology a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Move meaning out of prose and code and into the ontology: governance as machine-checkable statement, rule execution at the ontology layer, and the classes, relationships, properties and instances currently defined by documents or scripts exported to where they can be reasoned over. Prose is left explaining; code is left running engines." ;
    backlog:scopeForMission fw:Mission_OntologyDriven ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Scope ;
    backlog:requiresDeliverable fw:Del_OntGovernance , fw:Del_OntRuleExec , fw:Del_OntExport ,
                                fw:Del_ProseExplains , fw:Del_CodeExecutes ;
    backlog:coversArea fw:Area_Governance , fw:Area_CodeTables , fw:Area_RuleExecution , fw:Area_StandardDoc .




fw:Out2_Scope a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Scope ;
    backlog:consumesOutput fw:Out2_Mission ;
    backlog:hasStateDigest "833c3468bbb084d1ea73823d5a8006551e33a9c770760c07700a6c652e5a2e20" ;
    backlog:closedAtCommit "a52ccfe" ;
    backlog:hasRationale "Backfilled from the real commit in the next release, as the Mission stage output was." .


#################################################################
#  v5.2.0 — STAGE 2 REVISITED. The scope now says WHERE.
#
#  OWNER FINDING: the deliverables written at v1.100.0 were the
#  mission restated — "governance is expressed as ontology" is the
#  mission's own sentence with the subject changed. A scope must
#  say what should be DONE and WHERE, and that one did neither.
#
#  CAUSE: the framework, not only the session. ScopeDeliverable is
#  defined as "a deliverable says WHAT MUST BE TRUE". Applied to a
#  mission already stated as conditions, that definition can only
#  produce restatement. ScopeArea is added to carry the WHERE.
#
#  EXCLUSIONS WITHDRAWN. Ex_NoNarrativeBan, Ex_NoEngineRewrite and
#  Ex_NoReasonerMandate were written before anyone had established
#  what the mission needs — narrowing a boundary before knowing
#  what it must cover. They may all three be right; they were
#  decided in the wrong order, and an exclusion once written reads
#  as settled. They return at the Ruling stage if the coverage
#  analysis still supports them.
#################################################################
fw:Area_Governance a backlog:ScopeArea ;
    backlog:areaLocation "LINEAGE_OPERATING_DISCIPLINE_v24_0_0.md" ;
    backlog:areaMeasure "Governance rulings G1-G53, each a markdown heading with prose. Nothing in the ontology carries them; the lineage-discipline gate checks that claims about ENFORCEMENT match the shapes, and does not check that the rulings themselves exist as anything a query can reach." .
fw:Del_OntGovernance backlog:deliverableForArea fw:Area_Governance .
fw:Area_CodeTables a backlog:ScopeArea ;
    backlog:areaLocation "03-tooling/ — 12 python modules" ;
    backlog:areaMeasure "23 module-level tables holding classification knowledge: LAYERS in the completeness reporter, STAGE_TYPES and ORDER in the pipeline verifier, CONTAINER_TYPES and SECTIONS in the roadmap report, KINDS in the evidence bridge, SUITES and FOREIGN in registration readiness, DROP_DIRS and SUBSTITUTIONS in the public distribution builder, EXEMPT in the manifest builder. Each decides what something IS, in python." .
fw:Del_OntExport backlog:deliverableForArea fw:Area_CodeTables .
fw:Area_RuleExecution a backlog:ScopeArea ;
    backlog:areaLocation "03-tooling/backlog_validate_v*.py and backlog_gate_v*.sh" ;
    backlog:areaMeasure "The gate runs 12 named checks. 9 evaluate SHACL and carry no meaning. 3 decide outcomes in code: fixture polarity is inferred from the FILENAME, manifest exemption from a python list, reachability from a python traversal. Those three are rules executing outside the ontology." .
fw:Del_OntRuleExec backlog:deliverableForArea fw:Area_RuleExecution .
fw:Area_StandardDoc a backlog:ScopeArea ;
    backlog:areaLocation "BACKLOG_ROADMAP_FRAMEWORK_STANDARD_v1_48_0.md" ;
    backlog:areaMeasure "186 table rows describing classes, levels and constraint behaviour. The doc-coverage gate checks every class is NAMED here; nothing checks that what the table SAYS about a class matches the ontology, so a row can contradict the TBox indefinitely." .
fw:Del_ProseExplains backlog:deliverableForArea fw:Area_StandardDoc .

#  Del_CodeExecutes has no area of its own: it is the finish
#  condition for Area_RuleExecution and Area_CodeTables together,
#  and inventing a fifth area to give it one would be padding the
#  scope to make the shape look tidy.
fw:Del_CodeExecutes backlog:deliverableForArea fw:Area_RuleExecution , fw:Area_CodeTables .

fw:Out2_Scope backlog:hasRationale "Revised at v1.101.0 after the owner found the deliverables restated the mission. The stage output is NOT re-issued: the Scope stage closed at commit a52ccfe and this is a correction within it, not a new closing. Re-issuing would claim the boundary was drawn twice." .

#  The L2 clause is right: a boundary with no exclusion refuses
#  nothing. What was wrong at v1.100.0 was WHICH exclusions and in
#  what order — three written before any area was known. One is
#  restored now, because the coverage analysis above establishes it
#  directly rather than assuming it: the four areas name documents
#  and modules, and none of them is "all prose everywhere". The
#  other two return at the Ruling stage or not at all.
fw:Ex_NoNarrativeBan a backlog:ScopeExclusion ;
    backlog:excludesConcern "Removing explanatory prose, or requiring that every document sentence have an ontology counterpart." ;
    backlog:hasExclusionRationale "Established by the area analysis rather than assumed: the four areas are 18 rulings, 23 code tables, 3 code-executed rules and 186 standard rows — all places where prose or code DEFINES. Explanatory prose is not among them, and a framework whose reasoning exists only as triples is unreadable. The test is whether removing a sentence would lose a rule." ;
    backlog:decidedBy backlog:Owner .
fw:Scope_Ontology backlog:hasScopeExclusion fw:Ex_NoNarrativeBan .

#  Scope_Build predates ScopeArea and has none. Its areas are
#  recorded from what its deliverables actually touched, so the new
#  clause is satisfied by history rather than by exempting it.
fw:Out2_Goal a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Goal ;
    backlog:consumesOutput fw:Out2_Scope ;
    backlog:hasStateDigest "e8dc21c28f9643428c862d88e0b58b3422756af478f7f3cf040d9c805c5f9d07" ;
    backlog:closedAtCommit "e6a70d2" ;
    backlog:hasRationale "Backfilled from the real commit in the next release, as the Mission and Scope outputs were." .

#  The previous lineage's goals, given facings retroactively. Both
#  are mission-facing: they state conditions about the framework,
#  not about areas — which is itself the finding, since that lineage
#  had no scope-facing or containment-facing goal at all and could
#  not have reported either failure.
fw:Goal_BRSFConformance a backlog:Goal ;
    rdfs:label "This package's own real record honestly conforms to the framework it publishes"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCoversArea fw:Area_Governance ;
    backlog:isConformanceGoal true ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "The default pattern this package itself now recommends to every adopting lineage, applied reflexively to its own register: adopted from another registrant's own real fix to itself (07-handover-inbox/accepted, owner's direct suggestion it become standard). Genuinely Mission-facing, not scope-facing: every claim this package's own mission makes about being machine-confirmable through ontologies depends on this register carrying that claim being itself honestly conformant -- a register that fails its own suite cannot be trusted to check anyone else's. Distinct from Goal_GovernanceInOntology and Goal_RuleExecInOntology, both about the PRODUCT (governance expressed as ontology, rules executed by it); this goal is about the REGISTER'S OWN real state against the shapes it ships." .

fw:Obj_BRSFConformanceHeld a backlog:Objective ;
    rdfs:label "Real SHACL violations against this package's own register, held at zero"@en ;
    backlog:contributesToGoal fw:Goal_BRSFConformance ;
    backlog:fillsScope fw:Scope_Ontology ;
    backlog:hasSuccessMetric fw:Metric_BRSFViolationCount ;
    backlog:hasBaselineValue "0.0"^^xsd:decimal ;
    backlog:hasTargetValue "0.0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "Baseline and target both zero, honestly: unlike another registrant's own real gap-closure objective (which counted 22 real categories down from a genuine backlog), this package's own register has held zero real violations across the whole of this session's work, itself the direct product of never publishing a release without re-running the six-checker suite first. The objective is not to CLOSE a gap that does not exist, but to keep proving, on a real cadence, that it continues not to -- Dir_Hold, not Dir_Increase, because the honest target here is that the count never moves." ;
    backlog:producedByStage fw:Out2_Goal .

fw:Metric_BRSFViolationCount a <http://example.org/core#Metric> ;
    rdfs:label "Real SHACL violations against this package's own register"@en .

fw:CP_BRSFConformanceHeld a backlog:ObjectiveCheckpoint ;
    backlog:checkpointDate "2026-12-01T00:00:00Z"^^xsd:dateTime ;
    backlog:expectedValue "0.0"^^xsd:decimal .
fw:Obj_BRSFConformanceHeld backlog:hasCheckpoint fw:CP_BRSFConformanceHeld .

fw:Obs_BRSFConformanceHeld_v1 a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_BRSFViolationCount ; backlog:hasObservedValue "0.0"^^xsd:decimal ;
    backlog:observedAt "2026-09-02T00:00:00Z"^^xsd:dateTime ; backlog:observationFor fw:Obj_BRSFConformanceHeld ;
    backlog:hasObservationMethod "Direct read of backlog_validate_v1_5_0.py's own results line against this package's own register at the moment this goal was added: 0 Violation, confirmed identically both before and after this shape's own addition to the suite that checks it." .

fw:Goal_GovernanceInOntology a backlog:Goal ;
    rdfs:label "Every governance ruling the framework enforces is a machine-checkable statement"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCoversArea fw:Area_Governance ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "From the mission clause: 'the governance model should be based on the ontologies'. MISSION SUBJECT 1. Named from the mission's own clause, not from a property a lineage should have. Test the owner's way: substitute a different mission and this goal becomes meaningless, which is what separates a goal from a meta-goal. The 18 rulings in the lineage discipline are its subject." .
fw:Goal_RuleExecInOntology a backlog:Goal ;
    rdfs:label "A rule's outcome is decided by the ontology, never by the code that runs it"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCoversArea fw:Area_RuleExecution ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "From the mission clause: 'execution of the rules be transferred to the ontology levels from the prose and source codes'. MISSION SUBJECT 2. Distinct from subject 1: a ruling can exist as a shape and still have its OUTCOME decided in python — fixture polarity is inferred from a filename today. Governance being expressed and rules being executed are two conditions, and satisfying one does not satisfy the other." .
fw:Goal_ConceptsExported a backlog:Goal ;
    rdfs:label "The classes, relationships, properties and instances that live in code are in the ontology"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea fw:Area_CodeTables ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "From the mission clause: 'not just the rules but also the clasesses, relationships, properties, objects/instances'. MISSION SUBJECT 3, and scope-facing because it is exhaustive by nature: 23 named tables either move or they do not. This is the goal that catches the easy half being done — the tables are mechanical and the standard rows are not." .
fw:Goal_ProseExplainsOnly a backlog:Goal ;
    rdfs:label "No sentence in the documentation is the only place something is defined"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:goalCoversArea fw:Area_StandardDoc ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "From the mission clause: 'What remains as prose explains'. MISSION SUBJECT 4, containment-facing: it states what must NOT be true. The 186 standard rows are checked for NAMING every class and never for AGREEING with the TBox, so a row can contradict the ontology indefinitely. A goal about absence needs a containment measure because no count of what was required can see it." .
fw:Goal_CodeExecutesOnly a backlog:Goal ;
    rdfs:label "No script decides what is valid; scripts run engines over what the ontology says"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:goalCoversArea fw:Area_CodeTables ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "From the mission clause: 'what remains as code executes standard engines'. MISSION SUBJECT 5. Also containment-facing and deliberately not merged with subject 3: exporting a table to the ontology does not stop the code deciding — a script can read the ontology and still apply its own logic. Three of the twelve gate checks decide outcomes in code today." .

#  The two withdrawn meta-goals, recorded as what they actually are.
fw:Area_Governance    backlog:hasScopeLayer backlog:Layer_Work .
fw:Area_CodeTables    backlog:hasScopeLayer backlog:Layer_Work .
fw:Area_RuleExecution backlog:hasScopeLayer backlog:Layer_Work .
fw:Area_StandardDoc   backlog:hasScopeLayer backlog:Layer_Work .

#  The product-layer area the audit found missing: what the
#  framework will DO differently once the work is done.
fw:Area_QueryableGovernance a backlog:ScopeArea ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:areaLocation "The published TBox and shapes, as consumed by an adopter." ;
    backlog:areaMeasure "Today an adopter can query 137 classes and 0 governance rulings: the rulings exist only in a document they must read. The product-layer change is that a ruling becomes answerable by query." .
fw:Scope_Ontology backlog:coversArea fw:Area_QueryableGovernance .

fw:Del_OntGovernance  backlog:hasScopeLayer backlog:Layer_Product .
fw:Del_OntRuleExec    backlog:hasScopeLayer backlog:Layer_Product .
fw:Del_OntExport      backlog:hasScopeLayer backlog:Layer_Work .
fw:Del_ProseExplains  backlog:hasScopeLayer backlog:Layer_Work .

#  ProductScopeKind test-drive (proposed by code-abundance-rdodi, adopted
#  v1.63.0): the framework's own two Layer_Product deliverables, classified
#  on their existing text, not reworded to fit. Del_OntGovernance claims a
#  capability the ontology has (machine-checkable rulings exist); Del_OntRuleExec
#  claims a reliability guarantee about how rule execution behaves once it does
#  — a quality, not a new capability. A real mixed result, matching the
#  proposal's own verification method.
fw:Del_OntGovernance  backlog:hasProductScopeKind backlog:Kind_Functional .
fw:Del_OntRuleExec    backlog:hasProductScopeKind backlog:Kind_NonFunctional .
fw:Del_CodeExecutes   backlog:hasScopeLayer backlog:Layer_Work .
fw:Ex_NoNarrativeBan  backlog:hasScopeLayer backlog:Layer_Work .

#  Exclusions in BOTH layers, so the scope can refuse a capability
#  as well as a piece of work.
fw:Ex_NoNewCapability a backlog:ScopeExclusion ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:excludesConcern "Adding any capability the framework does not already have. This lineage MOVES meaning; it does not extend what the framework can express." ;
    backlog:hasExclusionRationale "Product-layer refusal, and the one this session most needs. Measured precedent at v1.95.0: a reachability gate was built and shipped while the owner's mission waited — a new capability, defensible, and outside the boundary. Without a product-layer exclusion the register could not refuse it, because every work-layer area was still being served." ;
    backlog:decidedBy backlog:Owner .
fw:Scope_Ontology backlog:hasScopeExclusion fw:Ex_NoNewCapability .

#  Inverse goals: one per exclusion, measurable by absence.
fw:Goal_NoCapabilityCreep a backlog:Goal ;
    rdfs:label "No capability is added that the framework did not already have"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion fw:Ex_NoNewCapability ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "INVERSE GOAL, product layer. Met by absence: every class or property added during this lineage must be one the exported material needs, not one that extends what the framework can express. Measurable, which is the point — PMBOK treats exclusions as the safeguard against scope creep, and an exclusion nothing measures is a sentence." .

fw:Goal_NoProseStripping a backlog:Goal ;
    rdfs:label "No explanatory prose is removed in the name of the mission"@en ;
    backlog:contributesToMission fw:Mission_OntologyDriven ;
    backlog:derivesFromScope fw:Scope_Ontology ;
    backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion fw:Ex_NoNarrativeBan ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage fw:Out2_Goal ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasRationale "INVERSE GOAL, work layer. The failure it guards is specific and likely: moving definitions into the ontology makes deleting the surrounding explanation feel like progress. A framework whose reasoning exists only as triples is unreadable, and unreadable governance is ignored governance." .

