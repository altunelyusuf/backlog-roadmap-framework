fw:AC_EP_RuleExec backlog:satisfiedByArtifact "03-tooling/backlog_lineage_completeness_v1_1_0.py" .
fw:AC_EP_ScriptDecisions backlog:satisfiedByArtifact "03-tooling/backlog_script_decision_audit_v1_0_0.py" .
fw:AC_EP_StandardRows backlog:satisfiedByArtifact "03-tooling/backlog_script_decision_audit_v1_0_0.py" .
fw:AC_EP_TablesBatch backlog:satisfiedByArtifact "01-ontologies/backlog_tbox_v1_51_0.ttl" .

#################################################################
#  v7.1.0 — FIT-GAP against field practice. Five gaps.
#
#  MEASURED: 55 Done stories, ONE task each, ONE acceptance
#  criterion each, and 46 of them carrying NO test case.
#  44 of 51 tasks are Task_Implementation.
#
#  RESEARCHED, not assumed. Field practice decomposes a story until
#  each task is a few hours' work; developers carry out story
#  analysis for design while testers perform test analysis and
#  produce the cases, both inside the sprint; and a story carries a
#  FULL SET of acceptance tests before it is planned.
#
#    practice                                as-is
#    several small tasks per story           1 task, all 55        GAP
#    analysis/design distinct from build     44/51 implementation  GAP
#    test analysis inside the sprint         46/55 no test case    GAP
#    full set of acceptance tests            1 criterion, all 55   GAP
#    scenarios per criterion                 1 case where present  GAP
#    task type taxonomy                      ISO 12207, 14 values  FIT
#    design concerns drive grooming          5 concerns            FIT
#    Definition of Done at epic level        every epic            FIT
#
#  ROOT CAUSE: the framework could express all five throughout.
#  TaskType shipped with fourteen values and forty-four tasks chose
#  Implementation. TestCase and TestData shipped at v1.97.0 and
#  forty-six stories never used them.
#
#  Nothing REQUIRED the decomposition, so the cheapest shape won
#  every time. A capability that is available and not obligatory is
#  one that gets skipped under time pressure, and this session was
#  always under time pressure — which is the general finding, not
#  an excuse for this instance of it.
#################################################################

fw:Adapt_StoryShape a backlog:LineageAdaptation ;
    rdfs:label "Fit-gap: story decomposition against field practice"@en ;
    backlog:adaptsScope fw:Scope_Ontology ;
    backlog:hasAdaptationStage backlog:Stage_Ruling ;
    backlog:hasAdaptationOutcome backlog:Adapt_BoundaryHolds .

fw:Gate_SS_Assess a backlog:AdaptationGate ;
    rdfs:label "How does this register decompose a story?"@en ;
    backlog:gateFor fw:Adapt_StoryShape ; backlog:gatesStage backlog:Stage_Assess ;
    backlog:hasCheckQuery "SELECT ?s (COUNT(?t) AS ?tasks) WHERE { ?pe backlog:plansItem ?s ; backlog:producesTask ?t } GROUP BY ?s" ;
    backlog:hasExpectedResult "measured" ; backlog:hasGateResult "measured" ;
    backlog:gatePassed true ;
    backlog:hasTransitionNote "55 stories, 1 task each, 1 criterion each, 46 with no test case." .

fw:Gate_SS_FitGap a backlog:AdaptationGate ;
    rdfs:label "Which practices does the register not follow?"@en ;
    backlog:gateFor fw:Adapt_StoryShape ; backlog:gatesStage backlog:Stage_FitGap ;
    backlog:hasCheckQuery "Compare against researched practice: task decomposition, analysis and test tasks, test analysis in sprint, full acceptance test set, scenarios per criterion." ;
    backlog:hasExpectedResult "enumerated" ; backlog:hasGateResult "enumerated" ;
    backlog:gatePassed true ;
    backlog:hasRationale "Five gaps, three fits. Every gap is expressible in the framework today, which is what makes it a discipline failure rather than a capability failure — and a discipline failure is fixed by making the capability obligatory rather than by adding another one." .

fw:Gate_SS_Ruling a backlog:AdaptationGate ;
    rdfs:label "Require, or record?"@en ;
    backlog:gateFor fw:Adapt_StoryShape ; backlog:gatesStage backlog:Stage_Ruling ;
    backlog:hasCheckQuery "ASK { ?s a backlog:Story ; backlog:hasState backlog:Done FILTER NOT EXISTS { ?ac backlog:coveredByCase ?c . ?s backlog:hasAcceptanceCriterion ?ac } }" ;
    backlog:hasExpectedResult "ruling recorded" ; backlog:hasGateResult "ruling recorded" ;
    backlog:gatePassed true ;
    backlog:hasRationale "ADVISORY, not violation, and the reason is measured: making these L3 would fail 55 stories already Done and closed, which turns a finding into a wall. Advisories that report on every release are how the previous drift patterns were actually corrected — deployment coverage, self-exemption, grooming depth. A rule that fires 55 times on its first run gets suppressed; one that reports 55 times gets worked down." .

fw:Inv_StoryDecomposition a backlog:CrossCuttingInvariant ;
    rdfs:label "A story decomposes into more than one kind of work"@en ;
    backlog:hasCheckQuery "SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE { ?pe backlog:plansItem ?s ; backlog:producesTask ?t . FILTER NOT EXISTS { ?pe2 backlog:plansItem ?s ; backlog:producesTask ?t2 . ?t2 backlog:hasTaskType ?tt FILTER (?tt != backlog:Task_Implementation) } }" ;
    backlog:hasExpectedResult "0" ;
    backlog:hasInvariantStatus backlog:Violated ;
    backlog:tracksItem fw:EP_RuleExec ;
    backlog:hasRationale "Violated, and recorded as such rather than deferred. 55 stories carry one implementation task apiece. The remedy is not retroactive: backfilling analysis and test tasks onto closed stories would record work that was never planned, which is the defect one level along from closing a story whose work was undone. It applies to the next story planned." .

#################################################################
#  v7.2.0 — the closed stories re-verified, and the owner was right
#  to insist.
#
#  I ruled at v1.120.0 that the remedy was not retroactive, on the
#  grounds that backfilling tasks onto closed stories records work
#  that was never planned. That reasoning was sound and the
#  conclusion was wrong, because it answered a question nobody
#  asked: VERIFYING closed work is not backfilling it.
#
#  MEASURED, and it is the risk the owner named. Of 276 level-gated
#  clauses in the suite, 96 have NEVER been made to fire by any
#  fixture. And of the six clauses THIS lineage's stories built,
#  SIX OF SIX were unproven.
#
#  A clause nothing fires has never been shown to work. It may be
#  correct; it may be malformed SPARQL returning nothing. Both look
#  identical from a green gate, and this package has produced two:
#  a triple pattern inside FILTER at v1.105.0, reporting 0
#  violations AND 0 warnings; a dateTime subtraction at v1.110.0,
#  reporting zero on a 34-day gap. Both were caught by accident.
#
#  fixture_ontologydriven_negative proves five of the six on
#  purpose. The sixth case was written knowing it might be silent —
#  and it was. CodeTable had hasTableKind and NOTHING required it,
#  while the entire table migration turned on that distinction:
#  eighteen tables stayed in python because they were operational.
#  A negative fixture that passes is either a missing clause or a
#  broken one, and only looking tells you which.
#################################################################

fw:Ev_ReVerify a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_ontologydriven_negative_v1_0_0.ttl" ;
    backlog:hasTestId "re-verification" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T09:30:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Six cases, each naming one clause this lineage built. Five fire and are now proven: a ruling enforced by nothing, a layer with no ordinal, two layers at one position, a scenario with no kind, an area with no location. The sixth was silent and exposed a missing clause — CodeTableShape now requires hasTableKind and the case fires. Verified individually rather than as a set, because a fixture reporting eighteen violations proves nothing about which case caused which." ;
    backlog:verifiedByTool "backlog_validate + backlog_clause_proof" ;
    backlog:attestsCriterion fw:AC_EP_Rulings_S2 , fw:AC_EP_CodeTables_S1 , fw:AC_S_Tables_B1 .

fw:Inv_ClauseProven a backlog:CrossCuttingInvariant ;
    rdfs:label "Every level-gated clause has a fixture that fires it"@en ;
    backlog:hasCheckQuery "Run 03-tooling/backlog_clause_proof_v1_0_0.py" ;
    backlog:hasExpectedResult "0 unproven" ;
    backlog:hasInvariantStatus backlog:Violated ;
    backlog:tracksItem fw:EP_RuleExec ;
    backlog:hasRationale "96 of 276 clauses unproven at the time of writing, down from 96 with six newly proven — the count moves as fixtures are written, and it is reported rather than enforced because a gate failing on 96 gets suppressed while a report on 96 gets worked down. Recorded Violated so the number is visible on every release rather than sitting in a script nobody runs." .

#################################################################
#  v7.3.0 — the floor was not a floor.
#
#  I claimed TWICE that reachability could not move to the
#  ontology: that it is a query over the TBox, and a register
#  cannot hold a rule about classes that do not exist yet. I
#  recorded 1 as a structural floor and used it to argue that no
#  further progress was possible.
#
#  I argued it and did not test it. Test-driven now:
#
#    1. Read what the python gate decides — skip enumerations,
#       skip classes with subclasses, skip classes named as a
#       range, report the rest that also have no instance.
#    2. Write it as SPARQL over TBox plus register: 25 classes.
#    3. Write it as a SHACL shape and compare focus nodes against
#       the query: 25 and 25, EXACT agreement.
#
#  The premise was wrong in a specific way. The rule is not about
#  classes that DO NOT exist; it is about classes that DO exist and
#  are unreachable, and every one is already a subject in the
#  shipped graphs. Nothing had to be invented. The graphs carried
#  what the shape needed the whole time, and I reasoned about the
#  problem instead of running it.
#
#  A floor asserted is not a floor measured. This is the second
#  time this session an unmet objective was defended as structural
#  and turned out to be unfinished work.
#################################################################

fw:Ev_ReachInOntology a backlog:TestEvidence ;
    backlog:hasTestSpec "02-shacl-safeguards ClassReachabilityShape" ;
    backlog:hasTestId "reachability" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T10:10:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Three experiments. The python gate's logic was read rather than remembered. The same decision as SPARQL over TBox plus register returns 25 classes. The same decision as a SHACL shape produces 25 focus nodes, and the two sets are identical — compared element-wise, not by count, because two wrong answers of the same size would agree on a count. The shape ships and fires 25 times through the suite." ;
    backlog:verifiedByTool "pyshacl + rdflib, compared element-wise" ;
    backlog:attestsCriterion fw:AC_EP_RuleExec_S2 .

fw:Obs_RulesZero a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_Obj_RulesDecidedInCode ;
    backlog:observationFor fw:Obj_RulesDecidedInCode ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-27T10:10:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Baseline 3. Manifest exemption moved at It8, fixture polarity at v1.119.0, and reachability here. Zero gate checks now decide an outcome in code. The previous observation of 1 was recorded as a structural floor on an argument rather than a measurement, and the measurement disagreed." .

fw:Inv_FloorMeasured a backlog:CrossCuttingInvariant ;
    rdfs:label "A floor is measured, not argued"@en ;
    backlog:hasCheckQuery "Manual: for each objective declared to have reached a structural floor, name the experiment that established it." ;
    backlog:hasExpectedResult "an experiment per floor" ;

    backlog:tracksItem fw:EP_RuleExec ;
    backlog:hasRationale "Violated: one floor remains asserted rather than tested. Obj_RowsUnchecked sits at 17 on the argument that a claim row has no IRI to check against. That argument has not been run as an experiment, and the last two floors defended this way — Obj_RulesDecidedInCode at 1, and the belief that packages could not exist before delivery — both dissolved when tested. Recorded Violated so the remaining one is visible rather than trusted." .

#################################################################
#  The last floor, tested. Partly asserted again.
#
#  Seventeen rows were said to be CLAIM rows, uncheckable because a
#  finding has no IRI. Reading them rather than asserting: three
#  are DISPLAY FORMS of real terms. "Scope-facing" is Facing_Scope
#  written for a reader; "Containment-facing" is Facing_Containment.
#
#  The abbreviation mechanism added at v1.118.0 handles exactly
#  this case and was populated with L1 through L4 and nothing else
#  — the mechanism was built for one instance of a general problem
#  and never asked what else it covered.
#################################################################

fw:AB_ScopeFacing a backlog:TermAbbreviation ;
    backlog:abbreviationText "Scope-facing" ; backlog:abbreviationOf backlog:Facing_Scope .
fw:AB_ContainFacing a backlog:TermAbbreviation ;
    backlog:abbreviationText "Containment-facing" ; backlog:abbreviationOf backlog:Facing_Containment .
fw:AB_MissionFacing a backlog:TermAbbreviation ;
    backlog:abbreviationText "Mission-facing" ; backlog:abbreviationOf backlog:Facing_Mission .
fw:AB_ExclFacing a backlog:TermAbbreviation ;
    backlog:abbreviationText "Exclusion-facing" ; backlog:abbreviationOf backlog:Facing_Exclusion .

fw:Obs_RowsTested a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_Obj_RowsUnchecked ;
    backlog:observationFor fw:Obj_RowsUnchecked ;
    backlog:hasObservedValue 15.0 ;
    backlog:observedAt "2026-08-27T10:40:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "The floor was TESTED rather than asserted, and it moved. Of the seventeen rows called uncheckable, three were display forms of real terms — Scope-facing is Facing_Scope written for a reader — and the abbreviation mechanism built at v1.118.0 covered exactly that case while being populated with L1 through L4 and nothing else. The matcher also could not reach them: it matched identifier-shaped substrings and an abbreviation may contain a hyphen. Both fixed, 17 to 15. The remaining fifteen were each read: six are findings, three are file categories, three are rules written as sentences, three are gate claims. None names a class. Fifteen is now a measured floor." .

fw:Inv_FloorMeasured backlog:hasInvariantStatus backlog:Holds ;
    backlog:hasRationale "Both floors are now tested. Obj_RulesDecidedInCode dissolved entirely when run — the reachability decision moved to a shape. Obj_RowsUnchecked moved 17 to 15 and the remaining fifteen were read one by one. The pattern this invariant exists for: THREE times this session an objective was defended as having reached a structural limit, and every time the limit was smaller than claimed. Twice it vanished. A floor asserted is a floor untested." .

#################################################################
#  v7.5.0 — A4 built, and it found something on its first run.
#
#  The reachability gate reported PASS when run with no arguments.
#  It parsed nothing, counted zero classes, found zero unreachable,
#  and returned green. The release gate happens to pass paths, so
#  it never fired here — but the script SHIPS, and an adopter
#  running it bare would be told their vocabulary is clean when it
#  was never read.
#
#  A checker that passes on an empty graph is worse than no checker:
#  it produces the appearance of verification. This is the same
#  shape as the malformed FILTER that reported zero violations and
#  zero warnings, and the same shape as evidence attesting five
#  criteria while one was false — a green result whose greenness
#  came from nothing having been examined.
#
#  Found by writing the self-application step rather than by anyone
#  looking, which is the argument A4 was scoped on: every previous
#  self-application finding in this package was noticed BY ACCIDENT.
#################################################################

fw:Ev_SelfApplication a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_self_application_v1_0_0.py" ;
    backlog:hasTestId "A4" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T11:10:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Four input-taking checkers run with no arguments. Before this release the reachability gate returned PASS on an empty graph; it now exits FATAL and states why. All four refuse. Verified both directions: with arguments the gate still reports the 25 unreachable classes it should, so the fix refuses blindness without changing the verdict." ;
    backlog:verifiedByTool "backlog_self_application" ;
    backlog:attestsCriterion fw:AC_EP_ScriptDecisions_S1 .

fw:Inv_NoBlindVerdict a backlog:CrossCuttingInvariant ;
    rdfs:label "No checker returns a verdict about a graph it never read"@en ;
    backlog:hasCheckQuery "Run 03-tooling/backlog_self_application_v1_0_0.py --strict" ;
    backlog:hasExpectedResult "0 blind checkers" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_ScriptDecisions ;
    backlog:hasRationale "Four of four refuse. Recorded because the failure it prevents is invisible by construction — a tool passing on nothing looks exactly like a tool passing on something, and this package has now produced three variants of that: a clause returning no rows, evidence covering a criterion it never checked, and a checker reading no file." .

#################################################################
#  v7.6.0 — A2 built. A shape may name the fixture that proves it.
#
#  G22 recurs because a clause and its proof are separate files
#  with nothing joining them. The clause-proof checker inferred the
#  link by MATCHING MESSAGE TEXT — fragile by construction: reword
#  a message and a clause silently becomes unproven, or matches a
#  different clause and reports proven.
#
#  provenByFixture and fixtureCaseName are declared on the shape,
#  and the checker VERIFIES them: it runs the named fixture and
#  looks for the named case. That is the difference between a link
#  and a claim.
#
#  FIVE shapes carry a declared proof. NOT 222. Annotating all of
#  them would assert 217 links nobody checked, which is exactly the
#  defect G21 names — evidence covering criteria it never examined.
#  The honest state is five declared and the rest inferred, and the
#  checker reports the two counts separately so the difference
#  stays visible rather than averaging into one reassuring number.
#################################################################

fw:Ev_A2 a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_clause_proof_v1_0_0.py declared-proof verification" ;
    backlog:hasTestId "A2" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T11:40:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Five shapes declare a fixture and a case; the checker runs each fixture and confirms the named case appears. All five verify. Tested in the failing direction too, which is the part that matters: one declaration was altered to name a case that does not exist, and the checker reported DECLARED CASE DID NOT FIRE and dropped to four verified. A check that only ever passes proves nothing about its own discrimination." ;
    backlog:verifiedByTool "backlog_clause_proof" ;
    backlog:attestsCriterion fw:AC_EP_ScriptDecisions_S1 .

fw:Inv_DeclaredProofVerified a backlog:CrossCuttingInvariant ;
    rdfs:label "A declared proof is run, not trusted"@en ;
    backlog:hasCheckQuery "Run 03-tooling/backlog_clause_proof_v1_0_0.py and read the declaration counts" ;
    backlog:hasExpectedResult "0 failed declarations" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_ScriptDecisions ;
    backlog:hasRationale "Five declared, five verified, zero failed. Holds on a small population deliberately: the alternative was 222 declarations of which 217 would be assertions, and an invariant that holds over unverified claims is the shape of every defect this session found." .

#################################################################
#  v7.7.0 — A1 built, and my own ruling was wrong six times.
#
#  Eighteen classes shipped with nothing requiring their use.
#  Package was among them — the class that sat unused for 91
#  releases while every check passed.
#
#  Ruling on each rather than labelling in bulk, I marked six as
#  ALREADY obliged. Checking rather than trusting that ruling: NONE
#  of the six had a shape targeting it. Package's apparent hit was
#  PackageShape targeting RegisterPackage — a DIFFERENT class whose
#  name contains the first, a substring match reading as a real
#  obligation.
#
#  Six asserted, zero real. That is G19 at the level of a single
#  ruling: I reasoned about which classes were covered instead of
#  looking, and was wrong six times out of six. The shapes were
#  built rather than the ruling softened, because the ruling was
#  right about what SHOULD be obliged and wrong only about what
#  already was.
#
#  Result: 99 obliged, 12 optional with a stated reason, 0 orphans.
#  The twelve reasons differ in kind — two abstract parents, five
#  adopter-facing vocabularies, two documentation conveniences,
#  three ISO 12207 terms an adopter may fold into ordinary work
#  items — which is why blanket-labelling would have hidden the six.
#################################################################

fw:Ev_A1 a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_adoption_check_v1_0_0.py" ;
    backlog:hasTestId "A1" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T12:20:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "111 classes examined. Before: 93 obliged, 18 orphans. Each orphan read individually rather than labelled in bulk. Twelve are optional for reasons that differ in kind and are stated per class. Six were ruled obliged and the ruling was CHECKED against the shapes file — none had one, so six shapes were built. After: 99 obliged, 12 optional, 0 orphans, and the register still validates at 0 violations, which means the six new obligations are satisfied by the existing data rather than requiring it to change." ;
    backlog:verifiedByTool "backlog_adoption_check + backlog_validate" ;
    backlog:attestsCriterion fw:AC_EP_ScriptDecisions_S1 .

fw:Inv_NoUnadoptedCapability a backlog:CrossCuttingInvariant ;
    rdfs:label "No class is optional by omission"@en ;
    backlog:hasCheckQuery "Run 03-tooling/backlog_adoption_check_v1_0_0.py --strict" ;
    backlog:hasExpectedResult "0 orphans" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_ScriptDecisions ;
    backlog:hasRationale "Zero orphans. Holds because optional-by-decision is now distinguishable from optional-by-omission, which was the whole gap: Package was the second kind for 91 releases and nothing could tell." .

#################################################################
#  v7.8.0 — A3 built. Every number says where it came from.
#
#  Thirty-six numeric properties, none declaring its provenance.
#  MeasurementKind did this for Objective and for nothing else.
#
#  Classified one by one — the last bulk ruling in this package was
#  wrong six times out of six — by asking what would have to be
#  true to recompute each:
#
#    3 DERIVED, each shipping its query. hasCommittedEffort is the
#      one that caused G24. hasScoreValue is WSJF arithmetic this
#      session got wrong by hand five times in one release.
#    5 MEASURED: from a clock, a commit, a count outside the
#      register, and re-takeable by anyone with the same source.
#   28 ASSERTED, and saying so. Not a failing — a capacity IS a
#      judgement — but a judgement compared against a judgement
#      proves nothing, and the framework could not tell a reader
#      which comparisons those were.
#
#  THE FINDING: eight clauses in the shipped suite compare two
#  ASSERTED properties to each other. hasCapacity against
#  hasEffortEstimate, hasBaselineValue against hasTargetValue,
#  hasJobSize against hasTimeCriticality. Each looks like a check
#  and establishes only that someone wrote both numbers.
#
#  Reported rather than failed: several are legitimate — comparing
#  a baseline to a target is how a direction is checked, and both
#  SHOULD be judgements. What was missing is that a reader could
#  not tell those from the one that let an iteration hold fifteen
#  points while declaring nine.
#################################################################

fw:Ev_A3 a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_number_origin_v1_0_0.py" ;
    backlog:hasTestId "A3" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-27T13:00:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "36 numeric properties, 0 undeclared, 0 derived without a query. Eight clauses found comparing two asserted properties — the G24 shape, previously invisible. The checker refuses to run without a TBox and shapes, verified by the self-application step, so it cannot report zero undeclared numbers for files it never opened." ;
    backlog:verifiedByTool "backlog_number_origin + backlog_self_application" ;
    backlog:attestsCriterion fw:AC_EP_ScriptDecisions_S1 .

fw:Inv_NumberOriginDeclared a backlog:CrossCuttingInvariant ;
    rdfs:label "Every numeric property states its origin"@en ;
    backlog:hasCheckQuery "Run 03-tooling/backlog_number_origin_v1_0_0.py --strict" ;
    backlog:hasExpectedResult "0 undeclared, 0 derived without a query" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_ScriptDecisions ;
    backlog:hasRationale "36 of 36 declared. The eight assertion-versus-assertion comparisons are reported and not counted as failures: several are legitimate, and the framework's job here is to make the distinction visible rather than to rule on each. A reader can now find them; before, nobody could." .

#################################################################
#  v7.9.0 — the finished lineage set down, in the owner's order.
#
#  THE RULE: a lineage with an unreached goal is not retired. The
#  goal's status changes first, if it is no longer needed.
#
#  Goal_BuildContained is unreached and cannot be reached. Its
#  objective counts work done outside scope during a FINISHED
#  development — the count is fixed at 1 forever and no future work
#  can reduce it, because the event already happened. That is not a
#  goal, which steers; it is a record. It was added retroactively
#  at v1.102.0 and said so at the time.
#
#  Ach_Retrospective, and NOT Ach_Withdrawn. Withdrawn would say
#  the measure was wrong. It was right: the reachability gate WAS
#  built while the owner's mission waited, and that finding is the
#  most useful thing that lineage produced about how this session
#  behaves. Retrospective keeps the number at 1 permanently rather
#  than adjusting it to let a mission read Achieved.
#
#  Only then is the mission set down.
#################################################################

fw:Obs_GateCost a backlog:MetricObservation ;
    rdfs:label "Gate cost, measured by component"@en ;
    backlog:observesMetric fw:Metric_Obj_CodeDecisions ;
    backlog:observationFor fw:Obj_CodeDecisions ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-08-27T14:30:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Measured, not estimated. Full suite over the full graph 145s; the same graph with half the shapes 93s; the full suite with the retired lineage removed 122s. Clause count dominates: 299 SPARQL constraints each carrying a NOT EXISTS nested scan, against 170 property shapes that are indexed and nearly free. The seven checkers added this session cost 0 to 2 seconds each. The register-archiving I proposed would have bought 16 percent for substantial work; removing three duplicate validator invocations from the gate costs nothing and removes the same step run twice. Obj_CodeDecisions is unaffected and stays at 0 — this observation is recorded against it because the finding is about how the tooling runs, and no metric for gate cost exists." .

fw:Inv_GateInvokedOnce a backlog:CrossCuttingInvariant ;
    rdfs:label "The gate runs each check once"@en ;
    backlog:hasCheckQuery "Count python3 \"$VALIDATE\" invocations in the gate script" ;
    backlog:hasExpectedResult "one per check" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_ScriptDecisions ;
    backlog:hasRationale "Eleven invocations reduced to eight. The pattern was run-to-display then run-again-to-test, which doubles the most expensive step in the package and is invisible in a script that reads correctly line by line. Recorded because it will recur: adding a gate step with visible output invites exactly this shape." .

#################################################################
#  v7.11.0 — the It11 export was claimed and never written.
#
#  Found by two checkers disagreeing about the same 25 classes. The
#  reachability gate reported ForeignNamespace and ShapeSuite as
#  unreachable; A1 reported zero orphans. Both were right about
#  different questions, and reconciling them exposed a third thing:
#  THE INDIVIDUALS DO NOT EXIST.
#
#  Ev_It11 states that FOREIGN and SUITES moved to the ontology.
#  The TBox carries the classes. The register carries no instance
#  of either — the export was written into a working copy that a
#  later ceremony overwrote from GitHub, and the evidence survived
#  because evidence is prose about work rather than the work.
#
#  This is exactly the defect satisfiedByArtifact was built to
#  catch at v1.119.0, and it did not, because AC_S_Tables_B3 names
#  "backlog:bridgeCoversEvidence" — a PROPERTY that does exist —
#  while the individuals it was supposed to carry do not. The
#  artefact resolved and the work was still missing.
#################################################################

fw:FN_core a backlog:ForeignNamespace ;
    backlog:namespaceIRI "http://example.org/core#" ; backlog:namespaceOwner "core" .
fw:FN_testing a backlog:ForeignNamespace ;
    backlog:namespaceIRI "http://example.org/testing#" ; backlog:namespaceOwner "testing" .
fw:FN_risk a backlog:ForeignNamespace ;
    backlog:namespaceIRI "http://example.org/risk#" ; backlog:namespaceOwner "risk" .
fw:FN_relhist a backlog:ForeignNamespace ;
    backlog:namespaceIRI "http://example.org/oepack-release-history#" ; backlog:namespaceOwner "release-history" .

fw:SS_core a backlog:ShapeSuite ; backlog:suiteName "core" ; backlog:suitePattern "core_shacl_v*.ttl" .
fw:SS_kb a backlog:ShapeSuite ; backlog:suiteName "knowledge_base" ; backlog:suitePattern "knowledge_base_shacl_v*.ttl" .
fw:SS_relhist a backlog:ShapeSuite ; backlog:suiteName "release_history" ; backlog:suitePattern "oepack_release_history_shacl_v*.ttl" .
fw:SS_testing a backlog:ShapeSuite ; backlog:suiteName "testing" ; backlog:suitePattern "testing_shacl_v*.ttl" .
fw:SS_config a backlog:ShapeSuite ; backlog:suiteName "configuration" ; backlog:suitePattern "configuration_shacl_v*.ttl" .
fw:SS_quality a backlog:ShapeSuite ; backlog:suiteName "quality" ; backlog:suitePattern "quality_shacl_v*.ttl" .

fw:Profile backlog:bridgeCoversEvidence backlog:TestEvidence , backlog:ReleaseEvidence ,
    backlog:ArtifactEvidence , backlog:ReviewEvidence .

fw:Inv_ArtefactNotProperty a backlog:CrossCuttingInvariant ;
    rdfs:label "A criterion naming a property is not proof the data exists"@en ;
    backlog:hasCheckQuery "Manual: for each satisfiedByArtifact naming a property rather than a class, confirm the individuals it was meant to carry exist." ;
    backlog:hasExpectedResult "every named property has the instances its story promised" ;
    backlog:hasInvariantStatus backlog:Holds ;
    backlog:tracksItem fw:EP_ScriptDecisions .

#################################################################
#  v8.0.0 — MAJOR. A lineage becomes a thing.
#
#  Seven lineages ran in one register file and every one was
#  validated on every release. They are near-disjoint — 22
#  cross-lineage references, all memberOfContainer into a shared
#  container — yet none could be set aside, because A LINEAGE WAS
#  A PATTERN OF LINKS AND NOT AN OBJECT.
#
#  Partitioning by inferring the closure broke 297 constraints:
#  harnesses, refinements and planning events had no lineage of
#  their own and stayed behind while the items they pointed at
#  moved. That is the modelling gap, and belongsToLineage closes
#  it by being carried by EVERY individual rather than only by
#  work items.
#
#  Computed, not guessed: 1137 individuals assigned by walking out
#  from each mission and following both directions of every
#  structural edge. 114 are FRAMEWORK-WIDE — code tables,
#  governance rulings, lineage layers, quality metrics — because
#  they describe the framework itself and belong to no single run.
#  Ten stage outputs and plan artefacts of the first lineage were
#  assigned by reading them.
#################################################################
fw:L_Plan a backlog:Lineage ;
    rdfs:label "Lineage 1"@en ;
    backlog:lineageForMission fw:Mission_Plan ;
    backlog:lineageOrdinal 1 ;
    backlog:lineageArchived true ;
    backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_0_0.ttl" .
fw:L_OrderRepair a backlog:Lineage ;
    rdfs:label "Lineage 2"@en ;
    backlog:lineageForMission fw:Mission_OrderRepair ;
    backlog:lineageOrdinal 2 ;
    backlog:lineageArchived true ;
    backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_0_0.ttl" .
fw:L_Executable a backlog:Lineage ;
    rdfs:label "Lineage 3"@en ;
    backlog:lineageForMission fw:Mission_Executable ;
    backlog:lineageOrdinal 3 ;
    backlog:lineageArchived true ;
    backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_0_0.ttl" .
fw:L_Ops a backlog:Lineage ;
    rdfs:label "Lineage 4"@en ;
    backlog:lineageForMission fw:Mission_Ops ;
    backlog:lineageOrdinal 4 ;
    backlog:lineageArchived true ;
    backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_0_0.ttl" .
fw:L_Dev a backlog:Lineage ;
    rdfs:label "Lineage 5"@en ;
    backlog:lineageForMission fw:Mission_Dev ;
    backlog:lineageOrdinal 5 ;
    backlog:lineageArchived true ;
    backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_0_0.ttl" .
fw:L_Build a backlog:Lineage ;
    rdfs:label "Lineage 6"@en ;
    backlog:lineageForMission fw:Mission_BuildSoftware_v2 ;
    backlog:lineageOrdinal 6 ;
    backlog:lineageArchived true ;
    backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_0_0.ttl" .
fw:L_OntologyDriven a backlog:Lineage ;
    rdfs:label "Lineage 7"@en ;
    backlog:lineageForMission fw:Mission_OntologyDriven ;
    backlog:lineageOrdinal 7 ;
    backlog:lineageArchived false .

#  Lineage membership, one line per individual.
fw:AC_EP_CodeTables backlog:belongsToLineage fw:L_OntologyDriven .
