fw:Gap_TaskTypeObligation_SuspensionException a backlog:BlueprintGap ; backlog:gapForEntity fw:Entity_TaskTypeObligation ; backlog:gapForStage backlog:Stage_SuspensionException ;
    backlog:hasGapReason "an obligation waived for a stage is an exception this lineage must decide how to record" ; backlog:belongsToLineage fw:L_SDLCObligations .
fw:Gap_TaskTypeObligation_Termination a backlog:BlueprintGap ; backlog:gapForEntity fw:Entity_TaskTypeObligation ; backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "retiring an obligation is a scope change of the framework, out of this lineage's scope" ; backlog:belongsToLineage fw:L_SDLCObligations .

fw:Out_Scope_SDLC a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Scope ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:consumesOutput fw:Out_Mission_SDLC ;
    backlog:hasStateDigest "a8ad46c68bcdd9d37289f1df8070323c10111887127bbaaf2be715054434e70b" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.245.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Scope stage of lineage 9: four deliverables, two exclusions, four areas -- and, as this stage will owe from now on, the five domain entities and the blueprint of the stage-obligation domain, with every entity's four lifecycle stages accounted for as gaps the later stages must close. Produced before this output, in this commit." .

#################################################################
#  v9.74.0 (2026-09-09, brsf-session) -- LINEAGE 9, Goal stage.
#  Consumes Out_Scope_SDLC (f586f36). Status moves to LS_Goaled.
#
#  WHAT THIS STAGE OWES, AND WHY IT IS NOT HERE. Under the obligation
#  this lineage is building, the Goal stage owes the USE CASES with
#  their main and alternative SCENARIOS -- the owner's own words. An
#  obligation names an artifact KIND by IRI, and this framework's scope
#  excludes minting kinds (Ex_SDLC_NoNewKinds, L-64). another registrant defines
#  five ArtifactKindSpecs today, all document kinds; none is a use
#  case, a scenario set, a behaviour diagram or a domain model. Four
#  were requested from another registrant in the previous commit (1b65620, their
#  inbox). Until they exist, the use cases cannot be typed, and a
#  use case written with no kind to point at is exactly the artifact
#  nobody can check -- the thing this lineage exists to end.
#  So: the goals are recorded now, the obligation is recorded as an
#  impediment, and the Goal stage's OWED ARTIFACTS are the first
#  work of the Objective and Backlog stages once the kinds exist.
#  Stated, not hidden (G7): this stage closes owing.
#################################################################
fw:Goal_SDLC_MissionHeld a backlog:Goal ;
    rdfs:label "The chain cannot close on words alone: every stage's engineering artifacts exist before its output"@en ;
    backlog:contributesToMission fw:Mission_SDLCObligations ;
    backlog:derivesFromScope fw:Scope_SDLCObligations ;
    backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:decidedBy backlog:Owner ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Goal_SDLC_AreasDone a backlog:Goal ;
    rdfs:label "Every area the scope names is finished: vocabulary, shapes, witness and fixtures"@en ;
    backlog:contributesToMission fw:Mission_SDLCObligations ;
    backlog:derivesFromScope fw:Scope_SDLCObligations ;
    backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea fw:Area_SDLC_Vocabulary , fw:Area_SDLC_Shapes , fw:Area_SDLC_Witness , fw:Area_SDLC_Fixtures ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:decidedBy backlog:Owner ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Goal_SDLC_NoOutOfScope a backlog:Goal ;
    rdfs:label "No artifact kind is minted here, and no closed lineage is retrofitted"@en ;
    backlog:contributesToMission fw:Mission_SDLCObligations ;
    backlog:derivesFromScope fw:Scope_SDLCObligations ;
    backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:decidedBy backlog:Owner ;
    backlog:belongsToLineage fw:L_SDLCObligations .

fw:ExtDep_RDODI_Kinds a backlog:ExternalDependency ;
    backlog:hasExternalDependencyType backlog:Ext_UpstreamComponent ;
    backlog:hasExternalParty "The session governing rdodi-ecosystem/01-profiles (rdodi_profiles_abox)." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:EnhProp_SDLCArtifactKinds a backlog:EnhancementProposal ;
    backlog:proposalFor fw:ExtDep_RDODI_Kinds ;
    backlog:hasRequestedChange "Add four doc:ArtifactKindSpec individuals -- prof:UseCaseSpecKind, prof:ScenarioSetKind, prof:BehaviourDiagramKind, prof:DomainModelKind -- so that a governed lineage's stage obligations can name the engineering artifacts each stage owes by IRI." ;
    backlog:submittedTo "rdodi-ecosystem/07-handover-inbox/pending/PROPOSAL_backlog-roadmap-framework_to_RDODI_sdlc-artifact-kinds_v1_0_0.md (delivered 2026-09-09, commit 1b65620)" ;
    backlog:proposalRaisedAt "2026-09-09T12:00:00Z"^^xsd:dateTime ;
    backlog:hasProposalStatus backlog:Prop_Submitted ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Imp_SDLCArtifactKinds a backlog:Impediment ;
    backlog:impedes fw:Register ;
    backlog:hasImpedimentStatement "The Goal stage of lineage 9 owes use cases with main and alternative scenarios; an obligation names an artifact kind by IRI, and no kind exists for a use case, a scenario set, a behaviour diagram or a domain model. Four are requested from another registrant (EnhProp_SDLCArtifactKinds). Until they are ratified, the owed artifacts of the Goal, Objective and Backlog stages cannot be typed, and this lineage's Objective stage cannot state the obligations it is building. The goals themselves are not blocked and are recorded." ;
    backlog:hasImpedimentOwner backlog:Owner ;
    backlog:raisedAt "2026-09-09T12:05:00Z"^^xsd:dateTime ;
    backlog:belongsToLineage fw:L_SDLCObligations .

fw:Out_Goal_SDLC a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Goal ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:consumesOutput fw:Out_Scope_SDLC ;
    backlog:hasStateDigest "29f238be11bfdf323b27fb2952df22ce98cb8414656faa0ac8c865849960c2bb" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.246.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Goal stage of lineage 9: three goals, one per facing, derived from the scope. CLOSED OWING its use-case and scenario artifacts, because the artifact kinds they must be typed with do not exist and are not this framework's to mint; requested from another registrant at 1b65620 and recorded as Imp_SDLCArtifactKinds. The obligation this lineage is building will, once shipped, refuse exactly this closure -- the first thing it will catch is its own Goal stage, and that is the honest order: the rule is built, then applied, and the debt is on the record until it is paid." .

#################################################################
#  v9.75.0 (2026-09-09, brsf-session) -- THE OBLIGATIONS DO NOT BIND
#  THE LINEAGE THAT BUILDS THEM. Owner's rule, this day: "apply the
#  rulings only after the completion of the work and the lineage is
#  closed. You should never try to apply a new ruling when the
#  development is in progress."
#
#  The first draft of shapes v1.111.0 bound every lineage. Its first
#  run refused fw:Out_Goal_SDLC (published 629b62f) and four fixture
#  lineages and every toy of the exercise register -- work already
#  finished or in flight under rules that did not exist when it was
#  done. That is the same failure the owner named in an earlier
#  session, and the session repeated it. Corrected before release:
#  an obligation binds only a lineage that ADOPTED its set at the
#  moment it opened (adoptsObligationSet + adoptionRecordedAtOpen,
#  in the Mission stage's own commit), and ObligationAdoptionShape
#  refuses adoption by a lineage past LS_Opened. Lineage 9 is past
#  LS_Goaled; it therefore does not adopt and owes nothing new. The
#  first lineage OPENED after these obligations ship will be the
#  first to owe them.
#
#  Imp_SDLCArtifactKinds is RESOLVED BY FINDING: the four artifact
#  kinds requested from another registrant (1b65620) already existed in this
#  framework's own TBox -- ModelKind's fourteen UML 2.5 kinds,
#  Specification/InteractionStep/hasStepActor, TestScenario's four
#  ScenarioKinds, DomainEntity, Blueprint. Withdrawn the same day
#  (3c3dc13); analysis in 04-documentation/DECISION_ANALYSIS_sdlc_
#  vocabulary_placement_v1_0_0.md.
#################################################################
fw:EnhProp_SDLCArtifactKinds backlog:hasProposalStatus backlog:Prop_Withdrawn ;
    backlog:hasRationale "Withdrawn 2026-09-09 (3c3dc13), the day it was filed: the four kinds already existed in this framework's own TBox. another registrant spent no time on it." .
fw:Imp_SDLCArtifactKinds backlog:resolvedAt "2026-09-09T14:00:00Z"^^xsd:dateTime ;
    backlog:hasImpedimentStatement "2026-09-09 resolution BY FINDING: nothing was blocked. ModelKind (14 UML 2.5 kinds incl. Kind_UseCaseDiagram, Kind_ActivityDiagram, Kind_SequenceDiagram, Kind_ClassDiagram), Specification with InteractionStep and hasStepActor, TestScenario with four ScenarioKinds, DesignConcern (5), TaskType (14), DomainEntity and Blueprint were all already defined here and already shape-checked. The obligation vocabulary (TBox v1.90.0) names them; nothing was minted." .
fw:Out_Goal_SDLC backlog:hasRationale "Addendum 2026-09-09: this output's original rationale said the obligations, once shipped, would refuse this closure. They do not, and must not: they bind only lineages that adopt them at open (owner's rule -- no ruling applied to work in progress). The use cases and scenarios this lineage owes are its own work items, produced by its own stages, not enforced retroactively against a stage that closed before the rule existed." .

#################################################################
#  v9.76.0 (2026-09-10, brsf-session) -- LINEAGE 9, Objective stage.
#  Consumes Out_Goal_SDLC (629b62f). Status moves to LS_Objectived.
#
#  Five objectives, each measuring one of the three goals with a
#  number taken BEFORE the work (G33: a baseline measured after the
#  work is not a baseline). Every baseline below was counted on the
#  register and the shapes file as they stand at v1.249.0, and the
#  count is stated with the objective so a reader can re-take it.
#
#  The obligations this lineage is building already exist as
#  vocabulary and shapes (TBox v1.90.0, shapes v1.111.0+); what does
#  NOT yet exist is a lineage that owes them -- OS_SDLC_v1 is adopted
#  by no one, because a ruling binds only work that declared it at
#  open (G89, G91). So the measure of this lineage's success is not
#  "the obligations exist" but "a lineage opened under them produces
#  what they demand, and one that does not is refused".
#################################################################
fw:Metric_SDLC_ObligationsEnforced a core:Metric ;
    rdfs:label "Stage obligations of OS_SDLC_v1 that no shape enforces"@en .
fw:Metric_SDLC_AdoptingLineages a core:Metric ;
    rdfs:label "Lineages that opened under OS_SDLC_v1 and closed a stage owing nothing"@en .
fw:Metric_SDLC_UnprovenShapes a core:Metric ;
    rdfs:label "Obligation shapes shipping without a fixture that proves them both ways"@en .
fw:Metric_SDLC_RetroBinding a core:Metric ;
    rdfs:label "Lineages or fixtures refused by an obligation they never adopted"@en .
fw:Metric_SDLC_UnmintedKinds a core:Metric ;
    rdfs:label "Artifact kinds minted in this package rather than referenced"@en .

fw:Obj_SDLC_Enforced a backlog:Objective ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    rdfs:label "Every obligation in the set is enforced by a shape, not merely declared"@en ;
    backlog:contributesToGoal fw:Goal_SDLC_MissionHeld ;
    backlog:fillsScope fw:Scope_SDLCObligations ;
    backlog:hasSuccessMetric fw:Metric_SDLC_ObligationsEnforced ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasBaselineValue "13"^^xsd:decimal ; backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:hasCheckpoint fw:CP_SDLC_Enforced ;
    backlog:hasRationale "Counted 2026-09-10 on backlog_abox_v1_4_0: thirteen StageObligation individuals in OS_SDLC_v1. StageOutputOwesShape and TaskTypeObligationShape read owesClass, owesKind and owesScenarioKind generically, so all thirteen are covered in principle -- the baseline is 13 because none has yet been SEEN to refuse a real stage output, and an obligation never observed refusing anything is a declaration (G7)." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obj_SDLC_Adopted a backlog:Objective ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    rdfs:label "At least one lineage opens under the obligations and closes its stages owing nothing"@en ;
    backlog:contributesToGoal fw:Goal_SDLC_MissionHeld ;
    backlog:fillsScope fw:Scope_SDLCObligations ;
    backlog:hasSuccessMetric fw:Metric_SDLC_AdoptingLineages ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasBaselineValue "0"^^xsd:decimal ; backlog:hasTargetValue "1"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasCheckpoint fw:CP_SDLC_Adopted ;
    backlog:hasRationale "Counted 2026-09-10: no lineage in either register declares adoptsObligationSet. The obligations are real only when a lineage opened under them produces domain entities and a blueprint at Scope, a specification and nominal and rejection scenarios at Goal, activity and sequence diagrams at Objective, and a class model and criteria at Backlog. One such lineage is the whole test." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obj_SDLC_Proven a backlog:Objective ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    rdfs:label "Every obligation shape is proven both ways by a fixture"@en ;
    backlog:contributesToGoal fw:Goal_SDLC_AreasDone ;
    backlog:fillsScope fw:Scope_SDLCObligations ;
    backlog:hasSuccessMetric fw:Metric_SDLC_UnprovenShapes ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasBaselineValue "0"^^xsd:decimal ; backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasCheckpoint fw:CP_SDLC_Proven ;
    backlog:hasRationale "Counted 2026-09-10 on backlog_shacl_v1_114_0: the six obligation shapes all carry provenByFixture, and fixture_sdlc_obligations / _negative validate 0 and fire every clause. The baseline is already at target, so this objective HOLDS rather than improves: the risk it guards is a later obligation shipped without its fixture, which is how a suite stops being able to fail (G7, L-95)." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obj_SDLC_NoRetroBinding a backlog:Objective ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    rdfs:label "No obligation ever refuses work that did not adopt it"@en ;
    backlog:contributesToGoal fw:Goal_SDLC_NoOutOfScope ;
    backlog:fillsScope fw:Scope_SDLCObligations ;
    backlog:hasSuccessMetric fw:Metric_SDLC_RetroBinding ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasBaselineValue "0"^^xsd:decimal ; backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasCheckpoint fw:CP_SDLC_NoRetroBinding ;
    backlog:hasRationale "Counted 2026-09-10: 0 -- every positive fixture, both registers and all live lineages validate clean, and neither rule set is adopted. The count was 14 when the obligations were first written ungated and 15 positive fixtures failed at once (G89, G91); it is held at 0 by the adoption gate, not by vigilance. This objective exists because the session broke this rule three times in one week." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obj_SDLC_NoMinting a backlog:Objective ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    rdfs:label "No artifact kind is minted here that another subject owns"@en ;
    backlog:contributesToGoal fw:Goal_SDLC_NoOutOfScope ;
    backlog:fillsScope fw:Scope_SDLCObligations ;
    backlog:hasSuccessMetric fw:Metric_SDLC_UnmintedKinds ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasBaselineValue "0"^^xsd:decimal ; backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasCheckpoint fw:CP_SDLC_NoMinting ;
    backlog:hasRationale "Counted 2026-09-10: 0. The obligations name this framework's own ModelKind (14 UML 2.5 kinds), Specification/InteractionStep, TestScenario/ScenarioKind (4), DomainEntity, Blueprint, AcceptanceCriterion and TaskType -- all present since long before this lineage. The session did ask another registrant for four kinds that already existed here and withdrew the proposal the same day; that near-miss is why the count is watched rather than assumed." ;
    backlog:belongsToLineage fw:L_SDLCObligations .


# The baseline readings themselves, as MetricObservations taken today on the register and the shapes
# file at v1.249.0 -- an objective with a target and no reading is a target nobody has taken (L4).
fw:Obs_SDLC_Enforced_Baseline a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_SDLC_ObligationsEnforced ;
    backlog:observationFor fw:Obj_SDLC_Enforced ;
    backlog:hasObservedValue 13.0 ;
    backlog:observedAt "2026-09-10T09:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Thirteen StageObligation individuals in backlog_abox_v1_4_0; none has yet been observed refusing a real stage output. Counted by reading the files at package v1.249.0." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obs_SDLC_Adopted_Baseline a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_SDLC_AdoptingLineages ;
    backlog:observationFor fw:Obj_SDLC_Adopted ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-09-10T09:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "No lineage in either register declares adoptsObligationSet. Counted by reading the files at package v1.249.0." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obs_SDLC_Proven_Baseline a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_SDLC_UnprovenShapes ;
    backlog:observationFor fw:Obj_SDLC_Proven ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-09-10T09:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "All six obligation shapes in backlog_shacl_v1_114_0 carry provenByFixture; fixture_sdlc_obligations validates 0 and its negative fires every clause. Counted by reading the files at package v1.249.0." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obs_SDLC_NoRetroBinding_Baseline a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_SDLC_RetroBinding ;
    backlog:observationFor fw:Obj_SDLC_NoRetroBinding ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-09-10T09:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Every positive fixture, both registers and all live lineages validate clean; neither rule set is adopted. Counted by reading the files at package v1.249.0." ;
    backlog:belongsToLineage fw:L_SDLCObligations .
fw:Obs_SDLC_NoMinting_Baseline a backlog:MetricObservation ;
    backlog:observesMetric fw:Metric_SDLC_UnmintedKinds ;
    backlog:observationFor fw:Obj_SDLC_NoMinting ;
    backlog:hasObservedValue 0.0 ;
    backlog:observedAt "2026-09-10T09:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Every class and kind the obligations name predates this lineage; the four kinds asked of another registrant were withdrawn the day they were asked for. Counted by reading the files at package v1.249.0." ;
    backlog:belongsToLineage fw:L_SDLCObligations .

fw:CP_SDLC_Enforced a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-10-01T00:00:00Z"^^xsd:dateTime .
fw:CP_SDLC_Adopted a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-10-01T00:00:00Z"^^xsd:dateTime .
fw:CP_SDLC_Proven a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-10-01T00:00:00Z"^^xsd:dateTime .
fw:CP_SDLC_NoRetroBinding a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-10-01T00:00:00Z"^^xsd:dateTime .
fw:CP_SDLC_NoMinting a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-10-01T00:00:00Z"^^xsd:dateTime .

fw:Out_Objective_SDLC a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Objective ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:consumesOutput fw:Out_Goal_SDLC ;
    backlog:hasStateDigest "7b9c7ce29c02299c939ac7ee1b40db6818c48170aa95695acadff9a49b79402d" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.250.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Objective stage of lineage 9: five objectives across the three goals, every baseline counted on the register and shapes as they stand at v1.249.0 and stated so a reader can re-take it. Two objectives HOLD at zero rather than improve -- proven-by-fixture and no-retroactive-binding -- because both are already true and the risk is losing them; the discipline's own reverse-direction rule (G61) says an objective may guard as well as advance. This stage does NOT owe activity and sequence diagrams: lineage 9 adopted no obligation set, having opened before one existed (G91)." .

#################################################################
#  v9.77.0 (2026-09-10, brsf-session) -- THE REGISTER ROOT RESTORED,
#  and the archival corrected (G92). backlog_lineage_archive v1.0.0
#  partitioned by reachability with two hand-picked exceptions; the
#  register ROOT belongs to no lineage, so the closure took it, and
#  the live register has had no container since v1.243.0. Measured
#  when lineage 9's first stories failed with "memberOfContainer must
#  point to a real container". Restored here verbatim from the
#  archive -- the ROOT STATEMENT ONLY: fw:Scope, fw:DoD and fw:Commitment_Dev were checked at tag
#  v1.242.0 and had no statements in the live register even then, having been archive material since
#  lineages 1-6 were retired by hand; they stay archived, and the root's references into the archive
#  are references, not dangling edges. Marked
#  isRegisterRoot so no archival can take it again. Nothing else of
#  the archive is disturbed.
#################################################################
fw:Register a backlog:Backlog ;
    backlog:hasSovereignPathPrefix "backlog-roadmap-framework/" ;
    backlog:hasIdentifier "BRF-REG" ;
    backlog:hasTitle "backlog-roadmap-framework development register" ;
    backlog:hasState backlog:Done ;
    backlog:appliesDefinitionOfDone backlog:DoD_Baseline ;
    backlog:hasCommitment fw:Commitment_Dev .
fw:Register backlog:hasScopeStatement fw:Scope .
fw:Register backlog:appliesDefinitionOfDone fw:DoD .
fw:Register backlog:isRegisterRoot true .

#################################################################
#  v9.77.0 (2026-09-10, brsf-session) -- LINEAGE 9, Backlog stage.
#  Consumes Out_Objective_SDLC (276ab48). Status moves to
#  LS_Backlogged. Five stories, one per objective, all Proposed:
#  nothing is planned into an iteration in this commit, because
#  planning is the next act and a story planned in the same breath
#  as it is written has been groomed by nobody.
#
#  What this stage does NOT carry, and why. Under OS_SDLC_v1 a
#  Backlog stage owes a class-diagram ModelArtifact and acceptance
#  criteria. Criteria are here. The class diagram is not: lineage 9
#  adopted no obligation set, having opened before one existed
#  (G91), and adding an artifact because a rule this lineage is
#  BUILDING would demand it -- from a lineage that never declared it
#  -- is precisely the retroactive binding the owner has stopped
#  three times. The first lineage that owes a class diagram is the
#  one story SDLC-S01 opens.
#################################################################
fw:S_SDLC_FirstAdopter a backlog:Story ; backlog:hasIdentifier "SDLC-S01" ;
    backlog:hasTitle "Open a lineage under OS_SDLC_v1 and carry it to a closed Backlog stage" ;
    backlog:asRole "a session running a lineage under this framework" ;
    backlog:wantsCapability "open a lineage under OS_SDLC_v1 and carry it to a closed Backlog stage" ;
    backlog:soThat "the SDLC obligations are enforced on real work rather than declared in a vocabulary" ;
    backlog:hasState backlog:Ready ;   # moved 2026-09-10 by PE_SDLC_S01 (pointer, L-112)
    backlog:memberOfContainer fw:Register ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:pursuesObjective fw:Obj_SDLC_Adopted ;
    backlog:satisfiesDeliverable fw:Del_StageObligations ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at the planning event that takes it into an iteration; this stage writes the backlog, it does not plan it." ;
    backlog:hasAcceptanceCriterion fw:AC_SDLC_S01 ;
    backlog:hasRationale "The obligations are real only when a lineage opened under them produces what they demand. This story opens lineage 10 declaring adoptsObligationSet at its Mission commit, and carries it through Scope (domain entities and blueprint), Goal (specification, nominal and rejection scenarios), Objective (activity and sequence diagrams) and Backlog (class model, criteria) -- each stage refused by StageOutputOwesShape until its artifacts exist." .
fw:AC_SDLC_S01 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a lineage that declared OS_SDLC_v1 at its Mission commit, when its Scope stage output is written before any DomainEntity or Blueprint of that lineage exists, then StageOutputOwesShape refuses the output; and when the entities and blueprint exist first, then the output validates." .
fw:S_SDLC_SeenToRefuse a backlog:Story ; backlog:hasIdentifier "SDLC-S02" ;
    backlog:hasTitle "Observe each of the thirteen obligations refusing a real stage output" ;
    backlog:asRole "a session running a lineage under this framework" ;
    backlog:wantsCapability "observe each of the thirteen obligations refusing a real stage output" ;
    backlog:soThat "the SDLC obligations are enforced on real work rather than declared in a vocabulary" ;
    backlog:hasState backlog:Proposed ; backlog:memberOfContainer fw:Register ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:pursuesObjective fw:Obj_SDLC_Enforced ;
    backlog:satisfiesDeliverable fw:Del_WitnessedClosure ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at the planning event that takes it into an iteration; this stage writes the backlog, it does not plan it." ;
    backlog:hasAcceptanceCriterion fw:AC_SDLC_S02 ;
    backlog:hasRationale "Thirteen obligations are declared and none has been seen to refuse anything outside a fixture. G7: a rule never observed refusing is a declaration. This story records, per obligation, the run in which it refused a real output of the adopting lineage before that stage's artifacts were produced." .
fw:AC_SDLC_S02 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the adopting lineage, when each of the thirteen obligations is unmet in turn at its own stage, then the validator names that obligation in its refusal, and the run is recorded as a MetricObservation moving Metric_SDLC_ObligationsEnforced toward zero." .
fw:S_SDLC_RefinementProducts a backlog:Story ; backlog:hasIdentifier "SDLC-S03" ;
    backlog:hasTitle "Make grooming produce its use case and scenarios in the adopting lineage" ;
    backlog:asRole "a session running a lineage under this framework" ;
    backlog:wantsCapability "make grooming produce its use case and scenarios in the adopting lineage" ;
    backlog:soThat "the SDLC obligations are enforced on real work rather than declared in a vocabulary" ;
    backlog:hasState backlog:Proposed ; backlog:memberOfContainer fw:Register ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:pursuesObjective fw:Obj_SDLC_Enforced ;
    backlog:satisfiesDeliverable fw:Del_RefinementProduces ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at the planning event that takes it into an iteration; this stage writes the backlog, it does not plan it." ;
    backlog:hasAcceptanceCriterion fw:AC_SDLC_S03 ;
    backlog:hasRationale "RefinementProducesShape reports a planning event that produced nothing. This story exercises the other half: the adopting lineage's planning events carry refinementProduces naming a Specification with interaction steps and actors, and TestScenarios of the nominal and rejection kinds -- the owner's original finding, made concrete in a real register rather than a fixture." .
fw:AC_SDLC_S03 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a planning event on a story of the adopting lineage, when it records no refinementProduces, then the advisory fires; and when it names a Specification with at least one InteractionStep and TestScenarios of Scen_Nominal and Scen_Rejection, then it is silent." .
fw:S_SDLC_DoDJoin a backlog:Story ; backlog:hasIdentifier "SDLC-S04" ;
    backlog:hasTitle "Join the task-type obligations to the effective Definition of Done" ;
    backlog:asRole "a session running a lineage under this framework" ;
    backlog:wantsCapability "join the task-type obligations to the effective Definition of Done" ;
    backlog:soThat "the SDLC obligations are enforced on real work rather than declared in a vocabulary" ;
    backlog:hasState backlog:Proposed ; backlog:memberOfContainer fw:Register ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:pursuesObjective fw:Obj_SDLC_Enforced ;
    backlog:satisfiesDeliverable fw:Del_DoDArtifacts ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at the planning event that takes it into an iteration; this stage writes the backlog, it does not plan it." ;
    backlog:hasAcceptanceCriterion fw:AC_SDLC_S04 ;
    backlog:hasRationale "TaskTypeObligationShape refuses a Done task whose type owes an artifact the lineage lacks, but the owed kinds do not yet appear in the item's effectiveDefinitionOfDone, so a reader checking the DoD alone cannot see them. This story makes the join visible where the DoD is read, without adding a second gate." .
fw:AC_SDLC_S04 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given an execution task of type Task_DesignDefinition in the adopting lineage, when its item's effective Definition of Done is read, then the owed ModelArtifact appears among its conditions; and when the task is Done with no model in its lineage, then TaskTypeObligationShape refuses it." .
fw:S_SDLC_ProofHeld a backlog:Story ; backlog:hasIdentifier "SDLC-S05" ;
    backlog:hasTitle "Prove every obligation shape both ways and keep the proof from rotting" ;
    backlog:asRole "a session running a lineage under this framework" ;
    backlog:wantsCapability "prove every obligation shape both ways and keep the proof from rotting" ;
    backlog:soThat "the SDLC obligations are enforced on real work rather than declared in a vocabulary" ;
    backlog:hasState backlog:Proposed ; backlog:memberOfContainer fw:Register ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:pursuesObjective fw:Obj_SDLC_Proven ;
    backlog:satisfiesDeliverable fw:Del_WitnessedClosure ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at the planning event that takes it into an iteration; this stage writes the backlog, it does not plan it." ;
    backlog:hasAcceptanceCriterion fw:AC_SDLC_S05 ;
    backlog:hasRationale "Six obligation shapes carry provenByFixture today and the count of unproven ones is zero. The risk is a later obligation shipped without its fixture. This story adds the gate step that refuses an obligation shape with no fixture proving it in both directions, so the zero is held by a check rather than by care." .
fw:AC_SDLC_S05 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a new shape whose target is StageObligation or StageOutput and which carries no provenByFixture, when the release gate runs, then it fails and names the shape; and given the current suite, then the step passes." .

# Each story is the live work able to move its objective's metric: metricMovableBy is the objective's
# side of pursuesObjective, and an open objective that blocks its mission's closure must name one
# (L3). Recorded here, in the same commit as the stories, because the link is a fact about the
# backlog just written -- not a later addition.
fw:Obj_SDLC_Adopted backlog:metricMovableBy fw:S_SDLC_FirstAdopter .
fw:Obj_SDLC_Enforced backlog:metricMovableBy fw:S_SDLC_SeenToRefuse , fw:S_SDLC_RefinementProducts , fw:S_SDLC_DoDJoin .
fw:Obj_SDLC_Proven backlog:metricMovableBy fw:S_SDLC_ProofHeld .

fw:Out_Backlog_SDLC a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Backlog ;
    backlog:belongsToLineage fw:L_SDLCObligations ;
    backlog:consumesOutput fw:Out_Objective_SDLC ;
    backlog:hasStateDigest "e86e413dd19d33e01dc33a4c3dd85e4f0144436549347dead939ccaae9f5a775" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.251.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Backlog stage of lineage 9: five Proposed stories, one per objective, each satisfying a scope deliverable and carrying a Given/When/Then criterion that names the shape it will exercise. The chain Mission->Scope->Goal->Objective->Backlog is now closed in five witnessed commits, one per stage -- the first lineage in this framework's history built that way from an empty start. The lineage is LS_Backlogged and not InProgress: no item has left Proposed." .

#################################################################
