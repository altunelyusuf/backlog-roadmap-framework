#################################################################
#  v3.1.0 — BRF-EP13 and BRF-EP14 delivered. The initiative closes.
#################################################################

fw:Ev_Capacity a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/fixtures/fixture_capacity_negative_v1_0_0.ttl" ;
    backlog:hasTestId "BRF-EP13" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-21T11:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Four cases verified individually. An iteration committing 20 against a capacity of 10 is rejected at L3; one committing 8 against 10 is silent; a deployment carrying an item its iteration never planned is rejected at L4; an iteration with no declared capacity raises an advisory. Committed effort is RECORDED rather than derived — derived would be the sum of what is planned in now, which moves as work is added, and a number that moves cannot report an over-commitment." ;
    backlog:verifiedByTool "backlog_validate + pyshacl" ;
    backlog:attestsCriterion fw:AC_IterationCapacity , fw:AC_EP_IterationCapacity_S1 .

fw:Ev_Roles a backlog:TestEvidence ;
    backlog:hasTestSpec "01-ontologies/backlog_tbox_v1_29_0.ttl role individuals" ;
    backlog:hasTestId "BRF-EP14" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-21T11:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Six roles shipped, each naming its source: systems analyst and design authority from Satzinger et al., architect from ISO/IEC/IEEE 42010, HCI researcher from ISO 9241-210, tester and test manager from ISO/IEC/IEEE 29119-3. The tester's name was the open question the proposal declined to settle; the standard's own word is used rather than a house term, because a role named differently in every register cannot be compared across two. ShippedRoleSourceShape checks the framework namespace only — an adopter's own role needs no citation." ;
    backlog:verifiedByTool "backlog_validate + pyshacl" ;
    backlog:attestsCriterion fw:AC_TeamRoles , fw:AC_EP_TeamRoles_S1 .

fw:H_EP_IterationCapacity a backlog:TestHarness ; backlog:harnessFor fw:EP_IterationCapacity ;
    backlog:hasHarnessEvidence fw:Ev_Capacity ; backlog:harnessComplete true ;
    backlog:hasRationale "Attested by a fixture exercising all four cases." .
fw:H_EP_TeamRoles a backlog:TestHarness ; backlog:harnessFor fw:EP_TeamRoles ;
    backlog:hasHarnessEvidence fw:Ev_Roles ; backlog:harnessComplete true ;
    backlog:hasRationale "Attested by each shipped role naming its source." .
fw:H_EP_IterationCapacity_S1 a backlog:TestHarness ; backlog:harnessFor fw:EP_IterationCapacity_S1 ;
