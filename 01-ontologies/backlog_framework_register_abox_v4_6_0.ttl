    backlog:hasInvestmentCategory backlog:Cat_TechnicalDebt ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at epic level." ;
    backlog:hasApplicableConcern backlog:Concern_Data ;
    backlog:hasAcceptanceCriterion fw:AC_S_GroundIteration .
fw:AC_S_GroundIteration a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the story-fits-one-iteration rule, When the framework is read, Then it names an agile source or is declared framework-original with a rationale." .
fw:S_GroundSelection a backlog:Story ;
    backlog:hasIdentifier "BRF-S-GS" ;
    backlog:hasTitle "The deployment selection basis names a source or is declared framework-original" ;
    backlog:hasState backlog:Done ;
    backlog:startedAt "2026-08-24T21:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-24T22:00:00"^^xsd:dateTime ;
