#################################################################
#  v3.4.0 — the Done work is deployed as one package.
#
#  Owner instruction: deploy the done items as a single package.
#  46 items that were finished and never recorded as delivered.
#
#  Stories only: an epic is a theme delivered THROUGH its stories
#  and is not itself deployable, which the L4 clause enforces.
#
#  Sel_Committed, not Sel_HighestScored: this package carries
#  everything already complete rather than a value-selected subset,
#  and claiming otherwise would misreport how its contents were
#  chosen. That is exactly what SelectionBasis exists to prevent.
#
#  Closes Inv_DeploymentAnchored, the last invariant not holding.
#################################################################

fw:Rel_v1_80_0 a backlog:DeploymentUnit ;
    backlog:hasIdentifier "BRF-REL-v1.80.0" ;
    backlog:hasTitle "Consolidated package: all completed work through v1.80.0" ;
    backlog:hasState backlog:Done ;
    backlog:hasDeploymentDate "2026-08-25T09:00:00"^^xsd:dateTime ;
    backlog:deploysFrom fw:It2 ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasSelectionBasis backlog:Sel_Committed ;
    backlog:hasRationale "Consolidates work completed across the whole development and never recorded as delivered. Committed rather than highest-scored because the package carries everything already done, not a value-selected subset — the register must say how contents were chosen, and this was not a prioritisation decision." ;
    backlog:deploysItem   fw:EP_Fit_S1 , fw:EP_Fit_S2 ,  fw:EP_Flow_S1 , fw:EP_Flow_S2 ,  fw:EP_Grooming_S1 , fw:EP_Grooming_S2 ,    fw:EP_IterationCapacity_S1 ,  fw:EP_OrderCorrect_S1 , fw:EP_OrderCorrect_S2 ,  fw:EP_OrderRecord_S1 , fw:EP_OrderRecord_S2 ,  fw:EP_PbiTask_S1 , fw:EP_PbiTask_S2 ,  fw:EP_Progress_S1 , fw:EP_Progress_S2 ,  fw:EP_Schedule_S1 , fw:EP_Schedule_S2 ,  fw:EP_TaskTypes_S1 , fw:EP_TaskTypes_S2 ,  fw:EP_TeamRoles_S1 ,  fw:EP_ValueRelease_S1 , fw:EP_ValueRelease_S2 ,  fw:EP_Views_S1 , fw:EP_Views_S2 , fw:S33 , fw:S41 , fw:S42 , fw:S43 , fw:S_GroundIteration , fw:S_GroundSelection .

