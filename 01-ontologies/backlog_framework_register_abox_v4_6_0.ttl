#################################################################
#  v4.3.0 — the join the plan was missing.
#
#  Asked whether the artefacts exist OR a plan to build them FOR
#  GROOMING, the second half of the question found a gap the first
#  half hid.
#
#  Six stories were planned and every one builds an artefact
#  vocabulary. NOT ONE connects an artefact back to the
#  RefinementEvent that produced it. RefinementEvent carries
#  refines, refinedAt, hasRefinementOutcome, refinedBy and
#  addressesConcern — so after all six ship, a refinement would
#  still record that a concern was ADDRESSED and never what the
#  addressing PRODUCED.
#
#  That is grooming as attendance again, the defect BRF-EP12 was
#  built to remove, returning one level up: the concern is now
#  named, and what it yielded still is not.
#
#  Both existing boxes are full at 9 of 9. Adding a seventh story
#  to either would stretch a box, which G9 forbids, so It5 is
#  opened rather than It3 or It4 widened.
#################################################################

fw:EP_Model_S3 a backlog:Story ;
    backlog:hasIdentifier "BRF-EP_Model_S3" ;
    backlog:hasTitle "A refinement names the artefact it produced" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer fw:Register , fw:It5 , fw:Pkg_Modelling ;
    backlog:pursuesObjective fw:Obj_Modelling ;
    backlog:satisfiesDeliverable fw:Del_Model ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:hasApplicableConcern backlog:Concern_Data ;
    backlog:hasAcceptanceCriterion fw:AC_EP_Model_S3 ;
    backlog:hasEffortEstimate 3.0 ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at epic level; scoring a decomposition child alongside its scored parent double-counts." .
fw:AC_EP_Model_S3 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a story groomed for a design concern, When the refinement addressing that concern is read, Then the model artefact it produced is named, and a refinement claiming a concern while producing nothing is reported." .
fw:EP_Model backlog:decomposesInto fw:EP_Model_S3 .

fw:It5 a backlog:Iteration ;
    backlog:hasIdentifier "It5" ;
    backlog:hasState backlog:Proposed ;
    backlog:iterationStart "2026-09-29T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2026-10-12T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 9.0 ;
    backlog:hasCommittedEffort 8.0 ;
    backlog:memberOfContainer fw:Register .

fw:Plan_EP_Model_S3 a backlog:PlanningEvent ;
    backlog:plansItem fw:EP_Model_S3 ; backlog:plannedInto fw:It5 ;
    backlog:plannedAt "2026-09-29T09:00:00"^^xsd:dateTime ;
    backlog:plannedBy backlog:Builder ;
    backlog:producesTask fw:T_EP_Model_S3 .
fw:T_EP_Model_S3 a backlog:ExecutionTask ;
    backlog:hasIdentifier "BRF-T-EP_Model_S3" ;
    backlog:hasTitle "Join RefinementEvent to the artefact it produced" ;
    backlog:hasState backlog:Proposed ;
    backlog:hasTaskType backlog:Task_DesignDefinition ;
    backlog:memberOfContainer fw:Register , fw:It5 .

fw:Pkg_Modelling backlog:targetsIteration fw:It5 .

fw:Inv_GroomingProducesArtefact a backlog:CrossCuttingInvariant ;
    rdfs:label "A refinement names what it produced"@en ;
    backlog:hasCheckQuery "ASK { ?r a backlog:RefinementEvent ; backlog:addressesConcern ?c . FILTER NOT EXISTS { ?r backlog:producesArtifact ?a } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasInvariantStatus backlog:NotYetEnforceable ;
    backlog:tracksItem fw:EP_Model_S3 ;
    backlog:hasRationale "NotYetEnforceable because producesArtifact does not exist yet — BRF-EP_Model_S3 builds it. Recorded now so the gap is visible before the work rather than discovered after: six stories were planned to build artefact vocabulary and none of them connected an artefact to the grooming that produced it." .


#################################################################
#  v4.4.0 — ANALYSIS AND DESIGN AT GROOMING LEVEL.
#
#  As-is: all seven stories declared a concern and NONE carried a
#  refinement. Concerns named, no analysis performed — the exact
#  state BRF-EP12 was built to make visible, and it was visible.
#
#  Below is the analysis. Each refinement records what was decided
#  and why, and the decisions changed the stories: EP_Spec_S1 gains
#  a second concern, EP_TestSpec_S1 gains one, and Diagram is
#  dropped as a class.
#################################################################
fw:R_EP_Model_S1_Data a backlog:RefinementEvent ;
    backlog:refines fw:EP_Model_S1 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "ModelArtifact carries a name, a kind and the item it describes. Kind is a CLOSED enumeration of the UML 2.5 diagram taxonomy: 7 structure kinds and 7 behaviour kinds, plus the two-way split as a separate property so a query can ask for all behaviour artefacts without listing seven. Diagram is NOT a separate class — a diagram is a ModelArtifact whose kind is a diagram kind, and adding a class would force every query to union two." .
fw:R_EP_Model_S1_Architecture a backlog:RefinementEvent ;
    backlog:refines fw:EP_Model_S1 ;
    backlog:addressesConcern backlog:Concern_Architecture ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "ModelArtifact hangs off ExecutionTask, not off Story: the task is what performs the technical process, and hanging artefacts on stories would make a story with three design tasks unable to say which produced what. Depends on nothing outside the backlog namespace." .
fw:R_EP_Model_S2_Data a backlog:RefinementEvent ;
    backlog:refines fw:EP_Model_S2 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "No new stored structure. The constraint reads existing triples: a task whose hasTaskType is Task_DesignDefinition or Task_ArchitectureDefinition with no ModelArtifact. Severity is ADVISORY not violation, because a design task may legitimately conclude that no artefact is needed and must be able to say so." .
fw:R_EP_Model_S3_Data a backlog:RefinementEvent ;
    backlog:refines fw:EP_Model_S3 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "producesArtifact goes from RefinementEvent to ModelArtifact, later-to-earlier like every other link. Not functional: one refinement may produce a class diagram and a sequence diagram together. The advisory fires when a refinement addresses a concern and names no artefact." .
fw:R_EP_Spec_S1_Interaction a backlog:RefinementEvent ;
    backlog:refines fw:EP_Spec_S1 ;
    backlog:addressesConcern backlog:Concern_Interaction ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "InteractionStep carries an ordinal, an actor and what the actor does. Ordinal rather than a linked list: a list makes insertion cheap and querying expensive, and the common question is what step 3 is. Belongs to a Story because a step is user-visible behaviour, unlike a ModelArtifact which belongs to the task that made it." .
fw:R_EP_Spec_S1_Data a backlog:RefinementEvent ;
    backlog:refines fw:EP_Spec_S1 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "Ordinals must be unique within a story or two steps claim the same position; that is an L1 check, not L3, because it is a contradiction rather than an omission." .
fw:R_EP_Spec_S2_Data a backlog:RefinementEvent ;
    backlog:refines fw:EP_Spec_S2 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "StateChange names fromState, toState and the trigger. States are free text, NOT an enumeration: the framework governs registers for any domain and cannot know a domain state machine. Constraint is that from and to differ — a change to the same state is not a change." .
fw:R_EP_TestSpec_S1_Data a backlog:RefinementEvent ;
    backlog:refines fw:EP_TestSpec_S1 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "TestCase attaches to AcceptanceCriterion via a new exercisesCriterion, and TestEvidence gains attestsViaCase so evidence points at a case rather than only at a criterion. Without the second link the existing attestsCriterion stays the only path and the case is decorative." .
fw:R_EP_TestSpec_S1_Security a backlog:RefinementEvent ;
    backlog:refines fw:EP_TestSpec_S1 ;
    backlog:addressesConcern backlog:Concern_Security ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "No authorisation surface: test cases describe checks, not access. Recorded as considered-and-not-applicable rather than left silent, because a story that never mentions security and one where security was examined and dismissed look identical otherwise." .
fw:R_EP_TestSpec_S2_Data a backlog:RefinementEvent ;
    backlog:refines fw:EP_TestSpec_S2 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-25T16:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "TestData attaches to TestCase, carries a name and a description of the fixture state it establishes. It does not carry the data itself: a register holding test payloads becomes a data store, and the framework governs records about work, not the work products." .

#  Concerns the analysis found applicable that grooming had missed.
fw:EP_Spec_S1 backlog:hasApplicableConcern backlog:Concern_Data .
fw:EP_TestSpec_S1 backlog:hasApplicableConcern backlog:Concern_Security .

#################################################################
#  REPACK. The analysis changed the work, so the plan changes too.
#
#  EP_Model_S1 was groomed against Architecture as well as Data —
#  the artefact hangs off ExecutionTask, which is a structural
#  decision. EP_Spec_S1 and EP_TestSpec_S1 likewise gained a second
#  concern. Three stories doubled their analysed surface and none
#  had been re-estimated: a story analysed against two concerns is
#  not the story that was estimated against one.
#
#  Re-estimated 3 -> 5 for those three. It3 then holds 5+3+5 = 13
#  against a capacity of 9, which G9 forbids resolving by widening
#  the box.
#
#  Repacked: EP_Spec_S1 moves out of It3. It4 is full, so it goes
#  to It5 alongside EP_Model_S3 — and that moves it into a
#  DIFFERENT PACKAGE'S iteration, which is fine because a package
#  is a capability and an iteration is a time box. Pkg_StoryDetail
#  now targets It3, It4 and It5.
#################################################################

fw:EP_Model_S1 backlog:hasApplicableConcern backlog:Concern_Architecture .

fw:It6 a backlog:Iteration ;
    backlog:hasIdentifier "It6" ;
    backlog:hasState backlog:Proposed ;
    backlog:iterationStart "2026-10-13T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2026-10-26T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 9.0 ;
    backlog:hasCommittedEffort 5.0 ;
    backlog:memberOfContainer fw:Register .

fw:Pkg_StoryDetail backlog:targetsIteration fw:It5 , fw:It6 .
fw:Pkg_Modelling backlog:targetsIteration fw:It5 .

#################################################################
#  FIT-GAP: the framework against the lineage.
#################################################################

fw:Adapt_FrameworkFit a backlog:LineageAdaptation ;
    rdfs:label "Fit-gap of the framework against its own lineage"@en ;
    backlog:adaptsScope fw:Scope_Build ;
    backlog:hasAdaptationStage backlog:Stage_Ruling ;
    backlog:hasAdaptationOutcome backlog:Adapt_BoundaryHolds .

fw:Gate_FF_Assess a backlog:AdaptationGate ;
    rdfs:label "Does the framework carry what the lineage needs?"@en ;
    backlog:gateFor fw:Adapt_FrameworkFit ; backlog:gatesStage backlog:Stage_Assess ;
    backlog:hasCheckQuery "SELECT ?c WHERE { ?c a owl:Class . FILTER NOT EXISTS { ?p rdfs:range ?c } FILTER NOT EXISTS { ?i a ?c } }" ;
    backlog:hasExpectedResult "enumerated" ;
    backlog:hasGateResult "enumerated" ;
    backlog:gatePassed true ;
    backlog:hasTransitionNote "23 classes have no property pointing at them and no instances." .

fw:Gate_FF_FitGap a backlog:AdaptationGate ;
    rdfs:label "Which gaps are real?"@en ;
    backlog:gateFor fw:Adapt_FrameworkFit ; backlog:gatesStage backlog:Stage_FitGap ;
    backlog:hasCheckQuery "ASK { fw:Scope_Build backlog:requiresDeliverable ?d FILTER NOT EXISTS { ?w backlog:satisfiesDeliverable ?d ; backlog:hasState backlog:Done } }" ;
    backlog:hasExpectedResult "enumerated" ;
    backlog:hasGateResult "enumerated" ;
    backlog:gatePassed true ;
    backlog:hasRationale "Three deliverables unsatisfied by Done work is the planned modelling work and not a defect — it is a boundary widened before its backlog was built, which is the order the discipline asks for. The real finding is the 23 unreachable classes." .

fw:Inv_UnreachableClasses a backlog:CrossCuttingInvariant ;
    rdfs:label "No class the vocabulary cannot point at"@en ;
    backlog:hasCheckQuery "SELECT (COUNT(?c) AS ?n) WHERE { ?c a owl:Class . FILTER STRSTARTS(STR(?c), 'http://example.org/backlog#') FILTER NOT EXISTS { ?p rdfs:range ?c } FILTER NOT EXISTS { ?i a ?c } FILTER NOT EXISTS { ?c owl:oneOf ?l } FILTER NOT EXISTS { ?s rdfs:subClassOf ?c } }" ;
    backlog:hasExpectedResult "0" ;
    backlog:hasInvariantStatus backlog:Violated ;
    backlog:tracksItem fw:EP_Model_S3 ;
    backlog:hasRationale "23 classes: ArtifactEvidence, Blueprint, BlueprintGap, Budget, Defect, DimensionalCost, Enabler, EnhancementProposal, Feature, Impediment, ImplementationProject, Opportunity, PortfolioPolicy, RICEScore, RegisterPackage, RegisterSession, ReleaseEvidence, ReleaseGate, ReviewEvidence, Spike, TransitionEvent, WipLimit, Workflow. This is the Package defect generalised. Package sat unused for 91 releases because no property had it as a range, and the cost was a wrong conclusion drawn in good faith — packages were believed impossible before delivery when the concept existed all along. Each of these 23 is the same trap waiting. REMEDY, not built here: an L3 shape rejecting a class the vocabulary cannot reach, run against the TBox rather than the register, plus a decision per class — give it a referring property or retire it. Recorded as Violated rather than deferred silently." .

#################################################################
#  v4.5.0 — RULING on the fit-gap, decided by experiment.
#
#  EXPERIMENT 1. Do the 23 unreachable classes block the current
#  lineage? The seven planned stories CREATE seven new classes and
#  depend on none of the 23. Overlap: zero. They cannot block it.
#
#  EXPERIMENT 2. The decisive one. Simulating the seven stories
#  with the properties this session's grooming refinements decided
#  on, THREE of the seven classes they create are born
#  unreachable: UseCase, Specification and TestCase. The grooming
#  gave TestCase a DOMAIN property, exercisesCriterion, and no
#  RANGE property — which is exactly how Package was lost.
#
#  So the current lineage would REPRODUCE the defect the fit-gap
#  just found, in the very release meant to add modelling.
#
#  EXPERIMENT 3. A reachability gate over TBox plus register runs
#  in under a second on 4338 triples. It separates two signals:
#  45 classes have no range property and are still reachable by
#  rdf:type (AdoptionProfile among them, reported not failed); 23
#  have neither a range property nor an instance, and those fail.
#
#  RULING — split, and the split is what the evidence supports:
#
#  COVER NOW: the MECHANISM. The gate ships in this release and
#  runs before the modelling work, so the three new classes cannot
#  be born unreachable. Cost is one second and it prevents the
#  defect rather than recording it.
#
#  PARK: the 23 EXISTING classes. They block nothing, each needs a
#  separate decision — give it a referring property or retire it —
#  and 23 judgements taken to clear a gate would be 23 decisions
#  made for the gate rather than for the framework. Parked with the
#  gate reporting them every run, so parking cannot become
#  forgetting.
#################################################################

fw:Gate_FF_Ruling a backlog:AdaptationGate ;
    rdfs:label "Cover in this lineage, or park?"@en ;
    backlog:gateFor fw:Adapt_FrameworkFit ; backlog:gatesStage backlog:Stage_Ruling ;
    backlog:hasCheckQuery "SELECT ?c WHERE { ?c a owl:Class FILTER NOT EXISTS { ?p rdfs:range ?c } FILTER NOT EXISTS { ?i a ?c } }" ;
    backlog:hasExpectedResult "ruling recorded" ;
    backlog:hasGateResult "ruling recorded" ;
    backlog:gatePassed true ;
    backlog:hasRationale "Split ruling. The mechanism is covered now because experiment 2 showed the current lineage would create three more unreachable classes without it; the 23 existing ones are parked because they block nothing and each needs a judgement of its own. Deciding 23 cases to clear a gate would be deciding them for the gate." .

fw:EP_Reach a backlog:Epic ;
    backlog:hasIdentifier "BRF-EP20" ;
    backlog:hasTitle "A class the vocabulary cannot reach is caught before it ships" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer fw:Register ;
    backlog:pursuesObjective fw:Obj_Grounded ;
    backlog:satisfiesDeliverable fw:Del_Checkable ;
    backlog:hasInvestmentCategory backlog:Cat_TechnicalDebt ;
    backlog:hasAcceptanceCriterion fw:AC_Reach ;
    backlog:hasPriorityScore fw:S_Reach ;
    backlog:hasCostEstimate fw:E_Reach ;
    backlog:rankedOnRoadmap fw:Roadmap ;
    backlog:scheduledInHorizon backlog:Now ;
    backlog:startedAt "2026-08-25T17:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-25T17:40:00"^^xsd:dateTime ;
    backlog:hasActualEffort 2.0 ;
    backlog:hasEvidence fw:Ev_Reach ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:lastAuditedAt "2026-08-25T17:40:00"^^xsd:dateTime ;
    backlog:hasRationale "Built now rather than parked because experiment 2 measured that the current lineage would otherwise create three more instances of the defect." .
fw:AC_Reach a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the TBox and the register, When the reachability gate runs, Then a class with no property naming it as a range AND no instance is reported and the gate fails, while a class reachable by rdf:type alone is reported without failing." .
fw:S_Reach a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 8.0 ;
    backlog:hasUserBusinessValue 8.0 ; backlog:hasTimeCriticality 9.0 ;
    backlog:hasRiskReductionValue 7.0 ; backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-25T17:00:00"^^xsd:dateTime ;
    backlog:hasScoreRationale "Highest time criticality in the register: it must land BEFORE the modelling work or three more unreachable classes ship and the count grows from 23 to 26. Value and risk reduction both high because the failure is silent — a class nobody can reference produces no error, only a wrong conclusion years later." ;
    backlog:hasBasisKind backlog:Basis_Measured ;
    backlog:basisObservation fw:Obs_Reach .
fw:E_Reach a backlog:CostEstimate ;
    backlog:hasEffortEstimate 2.0 ; backlog:hasCostBasis "One script over TBox plus register; measured at under one second on 4338 triples" ;
    backlog:estimatedAt "2026-08-25T17:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Measured ;
    backlog:basisObservation fw:Obs_Reach .
fw:Ev_Reach a backlog:TestEvidence ;
    backlog:hasTestSpec "03-tooling/backlog_reachability_gate_v1_0_0.py" ;
    backlog:hasTestId "BRF-EP20" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-08-25T17:40:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Run against the shipped TBox and register: 45 classes reported as having no range property and not failed, 23 reported as having neither a range property nor an instance and the gate fails. Both numbers were derived independently before the gate was written and the gate reproduces them. Simulated against the seven classes the current lineage will create: UseCase, Specification and TestCase are flagged, which is the case the gate exists for." ;
    backlog:verifiedByTool "backlog_reachability_gate + rdflib" ;
    backlog:attestsCriterion fw:AC_Reach .
fw:H_EP_Reach a backlog:TestHarness ; backlog:harnessFor fw:EP_Reach ;
    backlog:hasHarnessEvidence fw:Ev_Reach ; backlog:harnessComplete true ;
    backlog:hasRationale "The gate reproduces two independently derived counts and flags the three classes the next release would otherwise lose." .

fw:Inv_UnreachableClasses backlog:hasInvariantStatus backlog:Violated ;
    backlog:hasRationale "PARKED at v1.95.0 with the gate reporting all 23 every run. They block nothing — the current lineage depends on none of them — and each needs a decision of its own: give it a referring property or retire it. Taking 23 judgements to clear a gate would be taking them for the gate. Parked, not forgotten: the gate names them on every release." .

fw:EP_Reach backlog:decomposesInto fw:EP_Reach_S1 .
