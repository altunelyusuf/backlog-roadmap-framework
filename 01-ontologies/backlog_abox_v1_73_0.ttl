fw:Ruling_G31 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G31" ;
    rdfs:label "\"When to measure\" is a condition, not a fabricated date, unless the timing is genuinely calendar-bound"@en ;
    backlog:hasRulingStatement "\"When to measure\" is a condition, not a fabricated date, unless the timing is genuinely calendar-bound" ;
    backlog:enforcedByShape backlog:CheckpointConditionAnchorShape , backlog:ObjectiveCheckpointTimingShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G31; shapes linked in G164." .

fw:Ruling_G33 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G33" ;
    rdfs:label "State is grounded in re-checked evidence, never in whether a ceremony happened"@en ;
    backlog:hasRulingStatement "State is grounded in re-checked evidence, never in whether a ceremony happened" ;
