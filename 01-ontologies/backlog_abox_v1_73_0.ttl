fw:Lesson_CriterionCoverageShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of CriterionCoverageShape"@en ;
    backlog:lessonOfShape backlog:CriterionCoverageShape ;
    backlog:hasExperienceStatement "A criterion tested only on the nominal path looked fully covered though refusal and empty cases were never tried; a broken filter once reported zero everything."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_ControlMonitoring ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High .
