#################################################################
#  v1.437.0 (G165) -- the lesson vocabulary and the 245 lessons read from the safeguards.
#################################################################

backlog:LessonFamily_1 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "Proof and measurement are real"@en ; skos:definition "A lesson that a claim of achievement, quality or readiness must rest on a real, checkable measurement or test, not on a form that merely looks complete."@en .
backlog:LessonFamily_2 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "State is derived and agrees with the facts"@en ; skos:definition "A lesson that a recorded state or status must follow from the recorded facts and never contradict them."@en .
backlog:LessonFamily_3 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "One thing has one identity and one value"@en ; skos:definition "A lesson that each thing is named once, carries one value, and is not duplicated or left ambiguous."@en .
backlog:LessonFamily_4 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "Order and time are explicit and witnessed"@en ; skos:definition "A lesson that sequence, dates and ordering are recorded explicitly and attested, not assumed or left to be inferred."@en .
backlog:LessonFamily_5 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "The chain from intent to work stays connected"@en ; skos:definition "A lesson that the chain from mission to work stays linked end to end, so no work or goal stands apart from its intent."@en .
backlog:LessonFamily_6 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "Decisions and accountability are named"@en ; skos:definition "A lesson that every decision, approval and responsibility names who made it and on what basis."@en .
backlog:LessonFamily_7 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "Experience is carried forward"@en ; skos:definition "A lesson that what was learned, changed or retired is kept and handed on rather than lost or silently overwritten."@en .
backlog:LessonFamily_8 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "Capacity, cost and dependencies are accounted"@en ; skos:definition "A lesson that capacity, cost, effort and dependencies are counted so that plans stay feasible."@en .
backlog:LessonFamily_9 a owl:NamedIndividual , backlog:LessonFamily ; rdfs:label "Closing and cancelling are done on record"@en ; skos:definition "A lesson that closing or cancelling a lineage or item is done on record, with its reason, its assessment and its outcome."@en .
backlog:Segment_Mission a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Mission"@en ; skos:definition "The place in the lineage that is the mission stage."@en .
backlog:Segment_Scope a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Scope"@en ; skos:definition "The place in the lineage that is the scope stage."@en .
backlog:Segment_Goal a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Goal"@en ; skos:definition "The place in the lineage that is the goal stage."@en .
backlog:Segment_Objective a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Objective"@en ; skos:definition "The place in the lineage that is the objective stage."@en .
backlog:Segment_Backlog a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Backlog"@en ; skos:definition "The place in the lineage that is the backlog stage."@en .
backlog:Segment_Plan a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Plan"@en ; skos:definition "The place in the lineage that is the plan (roadmap) step."@en .
backlog:Segment_Execution a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Execution"@en ; skos:definition "The place in the lineage that is the execution of the work."@en .
backlog:Segment_ControlMonitoring a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Control and monitoring"@en ; skos:definition "The place in the lineage that is control and monitoring of the running lineage."@en .
backlog:Segment_Reporting a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Reporting"@en ; skos:definition "The place in the lineage that is reporting on the running lineage."@en .
backlog:Segment_Closure a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Closure"@en ; skos:definition "The place in the lineage that is closing the lineage."@en .
backlog:Segment_WholeLineage a owl:NamedIndividual , backlog:LineageSegment ; rdfs:label "Whole lineage"@en ; skos:definition "The place in the lineage that is every part of the lineage at once."@en .
backlog:Scope_Shared a owl:NamedIndividual , backlog:LessonProfileScope ; rdfs:label "Shared by every profile"@en ; skos:definition "The lesson applies under every opening profile."@en .
backlog:Scope_AgenticOnly a owl:NamedIndividual , backlog:LessonProfileScope ; rdfs:label "Agentic profile only"@en ; skos:definition "The lesson applies only under the agentic opening profile."@en .
backlog:Scope_LevelSpecific a owl:NamedIndividual , backlog:LessonProfileScope ; rdfs:label "Conformance level specific"@en ; skos:definition "The lesson applies from a given conformance level on, not by profile."@en .
backlog:Confidence_High a owl:NamedIndividual , backlog:LessonConfidence ; rdfs:label "High"@en ; skos:definition "The safeguard and its own text plainly show the experience."@en .
backlog:Confidence_Medium a owl:NamedIndividual , backlog:LessonConfidence ; rdfs:label "Medium"@en ; skos:definition "The experience is inferred from what the safeguard checks."@en .
backlog:Confidence_Low a owl:NamedIndividual , backlog:LessonConfidence ; rdfs:label "Low"@en ; skos:definition "The experience is a guess from the safeguard's form."@en .

backlog:Segment_Mission backlog:segmentIsStage backlog:Stage_Mission .
backlog:Segment_Scope backlog:segmentIsStage backlog:Stage_Scope .
backlog:Segment_Goal backlog:segmentIsStage backlog:Stage_Goal .
backlog:Segment_Objective backlog:segmentIsStage backlog:Stage_Objective .
backlog:Segment_Backlog backlog:segmentIsStage backlog:Stage_Backlog .

fw:Lesson_AcceptanceCriterionQualityShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of AcceptanceCriterionQualityShape"@en ;
    backlog:lessonOfShape backlog:AcceptanceCriterionQualityShape ;
    backlog:hasExperienceStatement "Gherkin criteria were written with empty Given/When/Then, satisfying form while being untestable."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_Backlog ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High .
