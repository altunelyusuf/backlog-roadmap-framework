    backlog:excludesConcern "Any change to which profile a new lineage is offered first." ;
    backlog:hasExclusionRationale "The Owner decides that only after the live proof." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_AdaptiveCeremonies .
