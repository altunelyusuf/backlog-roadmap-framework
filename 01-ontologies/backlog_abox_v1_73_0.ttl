    rdfs:label "Lesson of UnaddressedRefinementShape"@en ;
    backlog:lessonOfShape backlog:UnaddressedRefinementShape ;
    backlog:hasExperienceStatement "A refinement recorded that a story was looked at but not which concern, so it could not count toward readiness and the story failed the gate with no clue why."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_Backlog ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_Medium .
fw:Lesson_IncrementCommitmentShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of IncrementCommitmentShape"@en ;
    backlog:lessonOfShape backlog:IncrementCommitmentShape ;
    backlog:hasExperienceStatement "An increment was called releasable without any Definition of Done to judge it against, making releasability an opinion."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_Closure ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_Medium ;
    backlog:hasLessonNote "Same lesson as the item-level DoD clause, applied to increments."@en .
fw:Lesson_L4DeploymentVerifiedShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of L4DeploymentVerifiedShape"@en ;
    backlog:lessonOfShape backlog:L4DeploymentVerifiedShape ;
    backlog:hasExperienceStatement "A release carried an item that was not Done (or had no releaser), making the claim 'reached users' false for part of it with no accountable person."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_Closure ;
    backlog:hasProfileScope backlog:Scope_LevelSpecific ;
    backlog:hasLessonConfidence backlog:Confidence_High .
fw:Lesson_ReleaseGateShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of ReleaseGateShape"@en ;
    backlog:lessonOfShape backlog:ReleaseGateShape ;
    backlog:hasExperienceStatement "Release gates existed as intentions with no executable command or position in sequence, so release checks were skipped or run in the wrong order."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_Closure ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High .
fw:Lesson_AdaptationGateShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of AdaptationGateShape"@en ;
    backlog:lessonOfShape backlog:AdaptationGateShape ;
    backlog:hasExperienceStatement "An adaptation gate was marked passed with no executable check, no expected result, or an observed result differing from expectation, so the gate only recorded that someone looked."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_ControlMonitoring ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High .
fw:Lesson_BatchedEvidenceShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of BatchedEvidenceShape"@en ;
    backlog:lessonOfShape backlog:BatchedEvidenceShape ;
    backlog:hasExperienceStatement "One evidence record attested five criteria across three stories and hid an unfinished story; half the register's evidence attested multiple criteria."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_ControlMonitoring ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High ;
    backlog:hasLessonNote "Advisory only; batching is sometimes legitimate."@en .
fw:Lesson_CeremonyLinkAdvisoryShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of CeremonyLinkAdvisoryShape"@en ;
    backlog:lessonOfShape backlog:CeremonyLinkAdvisoryShape ;
    backlog:hasExperienceStatement "Metric readings taken after a review landed at plausible but wrong moments in a real another registrant incident because nothing recorded which ceremony a reading belonged to."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
