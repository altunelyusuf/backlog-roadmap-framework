#################################################################
#  v1.438.0 (G166) -- the adaptive lineage profile, beside the standard and agentic profiles (which stay as they are).
#################################################################

backlog:RS_ObligationsFollowStatus a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_4 ;
    rdfs:label "A register-level obligation is owed from the status that creates it"@en ;
    skos:definition "Within the adopter: the checks that a register holds a goal for the mission, an objective, a scope statement, a blueprint, a definition of done, a commitment of the register and a member item for every container are owed from the lineage status at which that element is made (a goal from Goaled, an objective from Objectived, a scope statement and blueprint from Scoped, the rest from Backlogged), not from the first commit. A lineage that starts from an immature mission matures stage by stage; no obligation is removed, each is asked at the status that creates it and for ever after. The Owner's rule of 2026-10-27 (G166): simplify how a lineage is operated, never the obligations it owes. A coarse epic with no children is likewise owed its decomposition only once it is Ready."@en .

backlog:RS_ChainBothWays a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_4 ;
    rdfs:label "The chain from mission to backlog reads the same from both ends"@en ;
    skos:definition "Within the adopter: an item that is started or Done may satisfy only a deliverable that a scope statement of the lineage requires, so a chain element discovered from the bottom (a story found while working) is joined to the top before it counts; and re-pointing a chain element (a mission, goal, objective, scope statement or work item) is recorded as a ChainRevision with its reason, the objective it serves, the role that decided it and the box boundary it follows. Elements may be created in any order; the chain is read from both ends at every box boundary. The Owner's rule of 2026-10-27 (G166): the connection is conserved, the creation order is not one-directional."@en .

backlog:Pr_4 a owl:NamedIndividual , backlog:ProfileRevision ; rdfs:label "Profile revision 4"@en ; backlog:revisionNumber 4 ; skos:definition "Release 1.438.0 (G166) adds the adaptive profile: obligations that follow the lineage status and a chain that is read from both ends."@en .

backlog:Profile_Adaptive a owl:NamedIndividual , backlog:OpeningProfile ;
    rdfs:label "Adaptive lineage profile"@en ;
    skos:definition "The standard profile for a lineage that starts from an immature mission and matures it through time-boxed boxes: every obligation of the standard profile is kept, each register-level check is asked from the status that creates the element it checks, a coarse epic is decomposed by the time it is Ready, and the chain from mission to backlog is read from both ends with every re-pointing recorded. Built beside the standard and agentic profiles, which stay as they are; it becomes a default only on the Owner's confirmation after a live proof."@en ;
    backlog:profileIncludes backlog:RS_ConcurrentLineages , backlog:RS_PlanBeforeStart , backlog:RS_CancellationAssessed , backlog:RS_ChangeSupportsMission , backlog:RS_StatusHistoryRecorded , backlog:RS_FlowPointsRecorded , backlog:RS_RepairReprioritises , backlog:RS_ImpedimentNamesWhatItBlocks , backlog:RS_DecompositionStateAgrees , backlog:RS_ObligationsFollowStatus , backlog:RS_ChainBothWays .

fw:Ruling_G166 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G166" ;
    rdfs:label "The adaptive profile asks each obligation at the status that creates it and reads the chain from both ends"@en ;
    backlog:hasRulingStatement "The adaptive profile asks each obligation at the status that creates it and reads the chain from both ends" ;
    backlog:enforcedByShape backlog:DeliverableRequiredByScopeShape , backlog:ChainRevisionShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v128.0.0, section G166." .
fw:Ruling_G166 backlog:rulingDecides backlog:Pr_4 , backlog:RS_ObligationsFollowStatus , backlog:RS_ChainBothWays .

#################################################################
#  v1.439.0 -- LINEAGE 20, Mission stage: the agile ceremonies of the adaptive profile (increment B).
#  The first lineage opened under Profile_Adaptive. The mission is immature on purpose; it matures stage by stage and box by box.
#  Stage 1 of 5, one release.
#################################################################

fw:L_AdaptiveCeremonies a backlog:Lineage ; rdfs:label "Lineage 20: Agile ceremonies for the adaptive profile"@en ;
    backlog:lineageOrdinal 20 ;
    backlog:lineageArchived false ;
    backlog:lineageForMission fw:Mission_AdaptiveCeremonies ;
    backlog:hasLineageStatus backlog:LS_InProgress ;
    backlog:hasLineageDepthLevel backlog:Depth_StoryDirect ;
    backlog:hasLineageArtifactDomain backlog:Domain_Infrastructure ;
    backlog:memberOfContainer fw:Register .
fw:L_AdaptiveCeremonies backlog:openedWithProfile backlog:Profile_Adaptive ;
    backlog:openedUnderRevision backlog:Pr_4 ;
    backlog:adoptionRecordedAtOpen true ;
    backlog:adoptsRuleSet
        backlog:RS_CancellationAssessed ,
        backlog:RS_ChainBothWays ,
        backlog:RS_ChangeSupportsMission ,
        backlog:RS_ConcurrentLineages ,
        backlog:RS_DecompositionStateAgrees ,
        backlog:RS_FlowPointsRecorded ,
        backlog:RS_ImpedimentNamesWhatItBlocks ,
        backlog:RS_ObligationsFollowStatus ,
        backlog:RS_PlanBeforeStart ,
        backlog:RS_RepairReprioritises ,
        backlog:RS_StatusHistoryRecorded .
fw:Mission_AdaptiveCeremonies a backlog:Mission ; rdfs:label "Mission: the agile ceremonies of a box are recorded and checked"@en ;
    backlog:hasMissionStatement "A lineage run under the adaptive profile records and checks the agile ceremonies of each box (planning, grooming against a definition of ready, the daily checkpoint, the demo and the deployment plan), each tied to the kind of work it serves, and a review is blocked when a planned control was not performed." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-10-27 16:22 and 16:32: the adaptive profile must carry the agile artefacts and ceremonies, each related to the kind of work it serves (the daily to monitoring); 2026-10-28 01:10: increment B as the live proof, 'Proceed'." ;
    backlog:hasMissionOutcome backlog:Out_InFlight ;
    backlog:producedByStage fw:Out_Mission_AdaptiveCeremonies ;
    backlog:decidedBy backlog:Owner .
fw:Out_Mission_AdaptiveCeremonies a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_AdaptiveCeremonies ;
    backlog:hasStateDigest "3b8d4ed4319fa6d6edfd85bd76c47ee1f95a63eac7ccd4b8a1b9ada1f5b9d30e" ;
    backlog:closedAtCommit "backlog-roadmap-framework-v1.439.0 (tag; witnessed by git, not asserted)" ;
    backlog:hasRationale "Mission stage of Lineage 20, the first lineage opened under the adaptive profile. Stage 1 of 5, one release each." .

#################################################################
#  v1.440.0 -- LINEAGE 20, Scope stage: five areas, seven deliverables, six exclusions. Stage 2 of 5.
#################################################################

fw:Scope_AdaptiveCeremonies a backlog:ScopeStatement ; rdfs:label "Scope: the agile ceremonies of the adaptive profile"@en ;
    backlog:hasScopeStatementText "Add to the package the records and the one rule the mission names and no more: a kind of work on every ceremony record, a readiness check, a planned control activity and its run, a daily checkpoint, a demo run, a deployment plan, and the refusal of a review while a planned control has no run; reuse the planning, review, retrospective, refinement, impediment and deployment-unit records that exist; leave the standard and agentic profiles, the default, the step tool and the roadmap view as they are." ;
    backlog:scopeForMission fw:Mission_AdaptiveCeremonies ;
    backlog:producedByStage fw:Out_Scope_AdaptiveCeremonies ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_AC_KindOfWork , fw:Del_AC_Readiness , fw:Del_AC_PlannedControl , fw:Del_AC_Checkpoint , fw:Del_AC_Demo , fw:Del_AC_DeployPlan , fw:Del_AC_ReviewBlocked ;
    backlog:coversArea fw:Area_AC_Preparation , fw:Area_AC_Planning , fw:Area_AC_Monitoring , fw:Area_AC_Control , fw:Area_AC_Kinds ;
    backlog:hasScopeExclusion fw:Ex_AC_StandardUntouched , fw:Ex_AC_NoDefault , fw:Ex_AC_NoStepTool , fw:Ex_AC_ExistingCeremonies , fw:Ex_AC_RoadmapView , fw:Ex_AC_NoTeams ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Area_AC_Preparation a backlog:ScopeArea ; rdfs:label "Area: Preparation: grooming against a definition of ready"@en ;
    backlog:areaMeasure "Counted 2026-10-28 in the T-Box and the shapes of v1.439.0: The package has refinement events (an item is refused Ready with none on record) and no record of which readiness criteria were checked; 0 readiness checks exist today." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Area_AC_Planning a backlog:ScopeArea ; rdfs:label "Area: Planning: the box plan, the deployment plan and the planned control activities"@en ;
    backlog:areaMeasure "Counted 2026-10-28 in the T-Box and the shapes of v1.439.0: The package has a planning ceremony and per-item planning events; it has no deployment plan made before a box starts and no planned control, monitoring, reporting or measurement activity as planned work (accepted OE handover of 2026-10-26, findings P3 and P5)." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Area_AC_Monitoring a backlog:ScopeArea ; rdfs:label "Area: Monitoring: the daily checkpoint"@en ;
    backlog:areaMeasure "Counted 2026-10-28 in the T-Box and the shapes of v1.439.0: The package has impediments and objective checkpoints; it has no record of a checkpoint inside a box with its counts and blockers; 0 exist today." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Area_AC_Control a backlog:ScopeArea ; rdfs:label "Area: Control: the demo and the review"@en ;
    backlog:areaMeasure "Counted 2026-10-28 in the T-Box and the shapes of v1.439.0: The package has a review ceremony recording that a decision was taken; it has no demo run against a criterion and no rule that a review waits for a planned control that was not performed." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Area_AC_Kinds a backlog:ScopeArea ; rdfs:label "Area: Kinds of work: what each ceremony serves"@en ;
    backlog:areaMeasure "Counted 2026-10-28 in the T-Box and the shapes of v1.439.0: The ceremonies of the package carry no statement of the kind of work they serve (preparation, planning, execution, monitoring, control, reporting, closure, change management); 0 of 3 ceremony classes carry one." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Del_AC_KindOfWork a backlog:ScopeDeliverable ; rdfs:label "Every ceremony record carries the one kind of work it serves, from a closed set"@en ;
    backlog:deliverableForArea fw:Area_AC_Kinds ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "each tied to the kind of work it serves" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Del_AC_Readiness a backlog:ScopeDeliverable ; rdfs:label "A groomed item has a readiness check that records which criteria of the definition of ready were met"@en ;
    backlog:deliverableForArea fw:Area_AC_Preparation ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "grooming against a definition of ready" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Del_AC_PlannedControl a backlog:ScopeDeliverable ; rdfs:label "A planned control, monitoring, reporting or measurement activity is planned work with a kind, and its run is recorded"@en ;
    backlog:deliverableForArea fw:Area_AC_Planning ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "a review is blocked when a planned control was not performed" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Del_AC_Checkpoint a backlog:ScopeDeliverable ; rdfs:label "A daily checkpoint inside a box records the counts of the box and every blocker with an owner"@en ;
    backlog:deliverableForArea fw:Area_AC_Monitoring ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "the daily checkpoint" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Del_AC_Demo a backlog:ScopeDeliverable ; rdfs:label "A demo run shows a finished item against its criterion and records what was shown and the result"@en ;
    backlog:deliverableForArea fw:Area_AC_Control ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "the demo" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Del_AC_DeployPlan a backlog:ScopeDeliverable ; rdfs:label "A deployment plan names, before the box starts, the deployment unit that is to ship from it"@en ;
    backlog:deliverableForArea fw:Area_AC_Planning ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "the deployment plan" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:Del_AC_ReviewBlocked a backlog:ScopeDeliverable ; rdfs:label "A review is refused while a planned control of the box has no recorded run"@en ;
    backlog:deliverableForArea fw:Area_AC_Control ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "a review is blocked when a planned control was not performed" ;
    backlog:belongsToLineage fw:L_AdaptiveCeremonies .
