    backlog:attestsCriterion fw:AC_AC_Readiness ;
    backlog:hasVerificationMethod "The probe ran against the shipped files and planted registers: a Ready item with a check whose criteria are all met is accepted; one with no check, one with an unmet criterion and one with an unanswered criterion are refused; a bare check is refused; a lineage that did not adopt the rule set is not judged; exit 0." ;
    backlog:verifiedAt "2026-10-28T02:15:38Z"^^xsd:dateTime ;
