    rdfs:label "Lesson of StoryFormAdvisoryShape"@en ;
    backlog:lessonOfShape backlog:StoryFormAdvisoryShape ;
    backlog:hasExperienceStatement "Stories were written as bare feature requests with a role but no 'so that' benefit, so the claimed value could not be assessed."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_Backlog ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_Medium ;
    backlog:hasLessonNote "Advisory only; style-level."@en .
