    backlog:enforcedByShape backlog:ClassReachabilityShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G21; shapes linked in G164." .

fw:Ruling_G22 a backlog:GovernanceRuling ;
