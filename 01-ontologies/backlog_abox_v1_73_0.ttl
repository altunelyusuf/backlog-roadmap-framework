    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_Medium ;
    backlog:hasLessonNote "Overlaps loosely with autonomy evidence on the proof theme"@en .
fw:Lesson_InvariantShape a backlog:ShapeLesson ;
