    rdfs:label "Lesson of DeliverableIntentionShape"@en ;
    backlog:lessonOfShape backlog:DeliverableIntentionShape ;
    backlog:hasExperienceStatement "A deliverable counted as satisfied because planned work claims it, though nothing is Done; measured: ten of ten read satisfied while seven were delivered, so coverage moved when epics were planned."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_ControlMonitoring ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High ;
    backlog:hasLessonNote "Real measured incident."@en .
fw:Lesson_DoDCriterionShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of DoDCriterionShape"@en ;
    backlog:lessonOfShape backlog:DoDCriterionShape ;
    backlog:hasExperienceStatement "Definition-of-Done criteria were written as prose with no check or expected result and a vague status, so they could never fail and Done meant nothing."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_ControlMonitoring ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High .
fw:Lesson_HarnessCoverageAdvisoryShape a backlog:ShapeLesson ;
    rdfs:label "Lesson of HarnessCoverageAdvisoryShape"@en ;
    backlog:lessonOfShape backlog:HarnessCoverageAdvisoryShape ;
