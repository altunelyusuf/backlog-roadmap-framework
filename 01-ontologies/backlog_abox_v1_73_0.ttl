# ---- Lineage 20, box 1: closed ----
fw:Review_AC_1 a backlog:SprintReviewCeremony ; backlog:hasWorkKind backlog:WorkKind_Closure ;
    backlog:ceremonyFor fw:It_AC_1 ; backlog:heldAt "2026-10-28T02:19:11Z"^^xsd:dateTime ; backlog:reviewsCeremony fw:Ceremony_AC_Planning1 ;
    backlog:closesIteration fw:It_AC_1 ; backlog:closesStory fw:ST_AC_KindOfWork , fw:ST_AC_Readiness .
fw:Retro_AC_1 a backlog:SprintRetrospective ; backlog:hasWorkKind backlog:WorkKind_Closure ;
    backlog:followsReview fw:Review_AC_1 ; backlog:heldAt "2026-10-28T02:20:11Z"^^xsd:dateTime ;
    backlog:producesFinding fw:Find_AC_PlanStepNamespace , fw:Find_AC_CopiedFromArchive , fw:Find_AC_LateAdoption .
fw:Find_AC_PlanStepNamespace a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:relatesToWorkItem fw:ST_AC_KindOfWork ;
    backlog:hasRootCause "The plan step recorded the roadmap report under the report tool's own namespace; the validator treats everything outside the register's namespace as reference data, so the gate's positive fixture inherited the report and was refused. Found by the first release after the plan step, which cost one gate run." ;
    backlog:hasRemedy "The step tool of increment C mints the report in the register's namespace; until then the report is renamed by hand after the plan step." .
fw:Find_AC_CopiedFromArchive a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:relatesToWorkItem fw:ST_AC_Readiness ;
    backlog:hasRootCause "A done-chain written from an archived example used a property the T-Box does not declare, and a label that matched text elsewhere; the link-control probe caught both before the gate, so the cost was one local run." ;
    backlog:hasRemedy "Run the link-control probe and the validator on the done-chain before the release preflight, not after." .
fw:Rel_AC_1 a backlog:DeploymentUnit ;
    backlog:hasIdentifier "AC-REL-1" ; backlog:hasTitle "Shipped from box 1 of Lineage 20" ;
    backlog:hasState backlog:Done ;
    backlog:hasDeploymentDate "2026-10-28T02:19:11Z"^^xsd:dateTime ;
    backlog:deploysFrom fw:It_AC_1 ; backlog:deploysItem fw:ST_AC_KindOfWork , fw:ST_AC_Readiness ;
    backlog:decidedBy backlog:Builder ; backlog:hasSelectionBasis backlog:Sel_Committed ; backlog:belongsToLineage fw:L_AdaptiveCeremonies .
fw:ST_AC_KindOfWork backlog:memberOfContainer fw:Rel_AC_1 .
fw:ST_AC_Readiness backlog:memberOfContainer fw:Rel_AC_1 .
fw:Find_AC_LateAdoption a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_Methodology ;
    backlog:relatesToWorkItem fw:ST_AC_KindOfWork ;
    backlog:hasRootCause "A running lineage cannot adopt a rule set that its own box delivers: the lineage records its adoptions at the commit of its Mission output and the order gate refuses a later one. Lineage 20 adopted the first new rule set one release after it was built and the gate refused the second release; the adoption was withdrawn. The new rule sets therefore bind lineages opened under the later profile revisions, and the lineage that built them is held by their probes and fixture cases instead." ;
    backlog:hasRemedy "The step tool of increment C records a later adoption as a decided change of the running lineage, witnessed at its own commit, so that a lineage can take up what its boxes deliver." .
