    backlog:lessonOfShape backlog:InvariantShape ;
    backlog:hasExperienceStatement "Cross-cutting invariants were declared as sentences with no runnable check, or marked not-yet-enforceable with no item that would make them enforceable, so they asserted themselves forever."@en ;
    backlog:inLessonFamily backlog:LessonFamily_1 ;
    backlog:learnedInSegment backlog:Segment_ControlMonitoring ;
    backlog:hasProfileScope backlog:Scope_Shared ;
    backlog:hasLessonConfidence backlog:Confidence_High .
