#################################################################
#  v1.123.0 (owner-directed, Executor/responsible/competency work) --
#  the closed CompetencyCategory and Competency vocabulary. Six
#  categories, forty-six leaves (twenty-three finer skills below six of them since v1.125.0, v1.126.0 and v1.391.0), each leaf skos:broader to exactly
#  one category. Closed like Role; see TBox v1.123.0 for why.
#################################################################

backlog:Comp_Analysis a owl:NamedIndividual , backlog:CompetencyCategory ;
    rdfs:label "Analysis"@en ;
    skos:definition "Understanding and bounding what a development must do before it is built: eliciting requirements, modelling the data conceptually, assessing impact, defining scope."@en .

backlog:Comp_Design a owl:NamedIndividual , backlog:CompetencyCategory ;
    rdfs:label "Design"@en ;
    skos:definition "Deciding the shape of a solution before it is built: software architecture, ontology modelling, API design, UX design."@en .

backlog:Comp_Implementation a owl:NamedIndividual , backlog:CompetencyCategory ;
    rdfs:label "Implementation"@en ;
    skos:definition "Building the thing: coding, tool scripting, data migration, integration build."@en .

backlog:Comp_Verification a owl:NamedIndividual , backlog:CompetencyCategory ;
    rdfs:label "Verification"@en ;
    skos:definition "Checking that what was built is right: SHACL authoring, test design, clause proof, quality review."@en .

backlog:Comp_Governance a owl:NamedIndividual , backlog:CompetencyCategory ;
    rdfs:label "Governance"@en ;
    skos:definition "Deciding and maintaining how the development is run: backlog stewardship, ranking decisions, governance rulings, lineage discipline."@en .

backlog:Comp_Operations a owl:NamedIndividual , backlog:CompetencyCategory ;
    rdfs:label "Operations"@en ;
    skos:definition "Keeping a released development running and improving: release management, tool-run operation, incident response, retrospective facilitation."@en .

backlog:Comp_RequirementsElicitation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Requirements elicitation"@en ;
    skos:definition "Drawing out what stakeholders actually need, as distinct from what they first say."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_ConceptualDataModeling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Conceptual data modelling"@en ;
    skos:definition "Modelling the entities and relations a domain involves, independent of any storage technology."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_ImpactAssessment a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Impact assessment"@en ;
    skos:definition "Working out what a proposed change touches and what it breaks before it is made."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_ScopeDefinition a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Scope definition"@en ;
    skos:definition "Stating what a piece of work does and does not cover, with content specific enough to be checked against later."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_SoftwareArchitecture a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Software architecture"@en ;
    skos:definition "Deciding the major structural parts of a system and how they relate."@en ;
    skos:broader backlog:Comp_Design .

backlog:Comp_OntologyModeling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Ontology modelling"@en ;
    skos:definition "Designing classes, properties and closed or open vocabularies that state what a domain's terms actually mean."@en ;
    skos:broader backlog:Comp_Design .

backlog:Comp_APIDesign a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "API design"@en ;
    skos:definition "Designing the interface a piece of software exposes to its callers."@en ;
    skos:broader backlog:Comp_Design .

backlog:Comp_UXDesign a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "UX design"@en ;
    skos:definition "Designing how a person experiences and operates a piece of software."@en ;
    skos:broader backlog:Comp_Design .

backlog:Comp_Coding a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Coding"@en ;
    skos:definition "Writing the source code that implements a designed solution."@en ;
    skos:broader backlog:Comp_Implementation .

backlog:Comp_ToolScripting a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Tool scripting"@en ;
    skos:definition "Writing the scripts and small tools a development runs on itself, as distinct from the product it ships."@en ;
    skos:broader backlog:Comp_Implementation .

backlog:Comp_DataMigration a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Data migration"@en ;
    skos:definition "Moving data from one representation or store to another without losing or corrupting it."@en ;
    skos:broader backlog:Comp_Implementation .

backlog:Comp_IntegrationBuild a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Integration build"@en ;
    skos:definition "Connecting separately-built components or systems so they work together."@en ;
    skos:broader backlog:Comp_Implementation .

backlog:Comp_ShaclAuthoring a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "SHACL authoring"@en ;
    skos:definition "Writing SHACL shapes that check a graph against a stated rule, in this framework's own house style."@en ;
    skos:broader backlog:Comp_Verification .

backlog:Comp_TestDesign a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Test design"@en ;
    skos:definition "Designing a test, or a test case, that actually exercises the behaviour it claims to check."@en ;
    skos:broader backlog:Comp_Verification .

backlog:Comp_ClauseProof a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Clause proof"@en ;
    skos:definition "Writing the positive and negative fixtures that prove a constraint actually fires and actually stays silent on a correct twin."@en ;
    skos:broader backlog:Comp_Verification .

backlog:Comp_QualityReview a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Quality review"@en ;
    skos:definition "Reviewing a finished piece of work against a stated quality bar before it is accepted."@en ;
    skos:broader backlog:Comp_Verification .

backlog:Comp_BacklogStewardship a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Backlog stewardship"@en ;
    skos:definition "Keeping a backlog's own register accurate, groomed and consistent with what is actually true."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_RankingDecision a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Ranking decision"@en ;
    skos:definition "Making or arbitrating a multi-factor priority judgement with a written rationale."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_GovernanceRuling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Governance ruling"@en ;
    skos:definition "Deciding a policy question for a framework or register and recording it as a checkable GovernanceRuling."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_LineageDiscipline a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Lineage discipline"@en ;
    skos:definition "Building and maintaining a lineage's Mission-to-Backlog chain in the order and ceremony this framework requires."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_ReleaseManagement a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Release management"@en ;
    skos:definition "Taking a change through its gate, manifest, publish and tag steps to a real, verified release."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_ToolRunOperation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Tool-run operation"@en ;
    skos:definition "Running this framework's own tooling correctly and reading what it reports."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_IncidentResponse a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Incident response"@en ;
    skos:definition "Diagnosing and resolving a live problem once a development is in production."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_RetrospectiveFacilitation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Retrospective facilitation"@en ;
    skos:definition "Running a retrospective that produces a real RetrospectiveFinding with a root cause, not a formality."@en ;
    skos:broader backlog:Comp_Operations .

# ---- v1.125.0 (G109): System modelling and the six finer skills under it, the first third level of the closed competency set.
# The finer skills are listed in the T-Box's owl:oneOf for Competency, so the set stays closed. A profile that lists a finer skill covers a
# requirement of System modelling; a profile that lists only System modelling does not cover a requirement of a finer skill.
backlog:Comp_SystemModelling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "System modelling"@en ;
    skos:definition "Building and keeping models of a system for a stated purpose: choosing what to leave out, the level of abstraction and the viewpoints, so that the model answers the questions it was made for. A requirement of this skill is met by any of the finer modelling skills below it."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concept 25.8.1 (Model), 25.8.2 to 25.8.4: the corpus defines the concept for practice; this entry names the skill of working with it."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_StructuralModelling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Structural modelling"@en ;
    skos:definition "Depicting the parts of a system and how they are related."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concept 25.8.7 (Structural view): the corpus defines the concept for practice; this entry names the skill of working with it."@en ;
    skos:broader backlog:Comp_SystemModelling .

backlog:Comp_BehaviouralModelling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Behavioural modelling"@en ;
    skos:definition "Depicting how a system acts over time or in response to stimuli."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concept 25.8.8 (Behavioural view): the corpus defines the concept for practice; this entry names the skill of working with it."@en ;
    skos:broader backlog:Comp_SystemModelling .

backlog:Comp_ModelConsistencyChecking a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Model consistency checking"@en ;
    skos:definition "Finding contradictions between the parts or views of a model, or between a model and the things it refers to."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concept 25.8.5 (Model consistency): the corpus defines the concept for practice; this entry names the skill of working with it."@en ;
    skos:broader backlog:Comp_SystemModelling .

backlog:Comp_ModelValidation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Model validation"@en ;
    skos:definition "Judging whether a model gives answers that hold for the real situation it stands for."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concept 25.8.6 (Model validity): the corpus defines the concept for practice; this entry names the skill of working with it."@en ;
    skos:broader backlog:Comp_SystemModelling .

backlog:Comp_Simulation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Simulation"@en ;
    skos:definition "Running a model with prepared data and a prepared environment to observe behaviour that cannot be reached by inspection, and judging the results against what is expected."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concept 25.8.14 (Simulation): the corpus defines the concept for practice; this entry names the skill of working with it."@en ;
    skos:broader backlog:Comp_SystemModelling .

backlog:Comp_ModelChangeControl a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Model change control"@en ;
    skos:definition "Treating a change to a model like a change to any other controlled item: identified, assessed, approved and recorded against the version it alters."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concept 25.8.19 (Model change control): the corpus defines the concept for practice; this entry names the skill of working with it."@en ;
    skos:broader backlog:Comp_SystemModelling .

# ---- v1.126.0 (G110): eighteen skills supplied and sourced by the agentic-sdlc project: eight new skills, ten finer skills (seven under skills held before, two under Retirement management, one under Product derivation).

backlog:Comp_CommonalityVariabilityAnalysis a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Commonality and variability analysis"@en ;
    skos:definition "Finding what the members of a family of systems share and where they differ, and stating each difference as a variation point with its alternatives."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.3.1, 25.3.4, 25.3.5, 25.3.9: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_DomainModelling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Domain modelling"@en ;
    skos:definition "Describing the concepts, rules and boundary of a field of activity so that systems built for it start from one shared understanding. Distinct from conceptual data modelling, which stops at the entities and relations of one system's data."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.2.1, 25.2.4, 25.2.5, 25.8.10: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_ReusableAssetStewardship a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Reusable asset stewardship"@en ;
    skos:definition "Keeping a set of reusable parts fit for reuse by recording their fitness, evolving them and acting on feedback from those who reuse them."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.4.1, 25.4.2, 25.4.5, 25.4.6, 25.4.7: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_ProductDerivation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Product derivation"@en ;
    skos:definition "Producing one member of a family by selecting variants, adapting assets and checking the result against the family's choice constraints."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.5.1, 25.5.2, 25.5.5, 25.4.3, 25.4.4: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Implementation .

backlog:Comp_ProductSpecificExtension a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Product-specific extension"@en ;
    skos:definition "Building what one customer needs that the shared assets do not cover, and recording the coverage gap it fills."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.5.3, 25.5.4, 25.5.7: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_ProductDerivation .

backlog:Comp_IntegrationStrategy a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Integration strategy"@en ;
    skos:definition "Choosing the order and increments in which parts are combined and the stand-ins used while some parts are missing."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.9.1, 25.9.3, 25.9.12, 25.9.14: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_IntegrationBuild .

backlog:Comp_InterfaceAgreementManagement a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Interface agreement management"@en ;
    skos:definition "Agreeing and recording the interfaces between parts, and resolving the mismatches found when parts meet."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.9.2, 25.9.9, 25.15.5: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_IntegrationBuild .

backlog:Comp_RepeatableBuild a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Repeatable build"@en ;
    skos:definition "Producing the same artifact, with the same identity, from the same source baseline on demand."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.9.4, 25.9.5, 25.9.8, 25.9.11: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_IntegrationBuild .

backlog:Comp_DeliveryPipelineEngineering a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Delivery pipeline engineering"@en ;
    skos:definition "Defining as code the stages and gates through which a change travels from source to a releasable state."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.10.1, 25.10.2, 25.10.3, 25.10.6: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_IntegrationBuild .

backlog:Comp_ReleaseReadinessAssessment a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Release readiness assessment"@en ;
    skos:definition "Judging, against stated acceptance conditions, whether a release candidate may go out."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.11.1, 25.11.2, 25.6.6: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_ReleaseManagement .

backlog:Comp_DeploymentExposureControl a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Deployment and exposure control"@en ;
    skos:definition "Putting a release into a target environment in a controlled way: staged exposure, cutover and a defined way back."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.11.3, 25.11.4, 25.11.5, 25.11.6, 25.11.16: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_ReleaseManagement .

backlog:Comp_OperationalHandover a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Operational handover"@en ;
    skos:definition "Passing a released system to those who run it together with what they need to know and be able to do."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.11.8, 25.11.10: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_ReleaseManagement .

backlog:Comp_RetirementManagement a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Retirement management"@en ;
    skos:definition "Deciding and planning the end of life of a system and seeing its residual obligations through."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.12.1, 25.12.2, 25.12.7: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_DataDisposition a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Data disposition"@en ;
    skos:definition "Choosing and carrying out what happens to the data and information items of a retiring system: keep, transfer, archive or destroy. Distinct from data migration, which moves data into a new system."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.12.3, 25.12.13: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_RetirementManagement .

backlog:Comp_DependencyUnwinding a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Dependency unwinding"@en ;
    skos:definition "Removing what still relies on a retiring system, or moving it to a successor."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.12.4, 25.12.8: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_RetirementManagement .

backlog:Comp_OperationalScenarioDefinition a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Operational scenario definition"@en ;
    skos:definition "Describing how a system will be used, in which modes and within which boundary, so that requirements can be checked against use."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.16.3, 25.16.5, 25.16.6: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_RequirementsQualityAssurance a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Requirements quality assurance"@en ;
    skos:definition "Checking that requirements are well formed, free of conflict and consistent as a set before they are baselined."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.6.3, 25.6.5, 25.15.7, 25.15.8: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Verification .

backlog:Comp_TradeOffAnalysis a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Trade-off analysis"@en ;
    skos:definition "Comparing candidate solutions against the criteria that matter, with the estimates and risks behind the comparison written down."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.7.2, 25.7.4, 25.7.5, 25.7.8: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-13."@en ;
    skos:broader backlog:Comp_Analysis .


#################################################################
#  v1.37.0 (owner follow-up on v1.379.0/v1.380.0, 2026-10-11) --
#  closing two of the four owner-ruled Executor Taxonomy gaps.
#
#  Ruling 3: Outcome, a closed vocabulary, same owl:oneOf pattern
#  as Role (TBox v1.124.0's own Outcome class carries the member
#  list; these three individuals are its members' real declarations,
#  the same split this package already uses for Role/Owner/Builder
#  and for Competency/Comp_*).
#################################################################

backlog:Outcome_Success a owl:NamedIndividual , backlog:Outcome ;
    rdfs:label "Success"@en ;
    skos:definition "The Executor fully achieved what the Competency was exercised for, with nothing left unresolved."@en .

backlog:Outcome_PartialSuccess a owl:NamedIndividual , backlog:Outcome ;
    rdfs:label "Partial success"@en ;
    skos:definition "The Executor achieved some, but not all, of what the Competency was exercised for -- real progress, with a real remainder."@en .

backlog:Outcome_Failure a owl:NamedIndividual , backlog:Outcome ;
    rdfs:label "Failure"@en ;
    skos:definition "The Executor did not achieve what the Competency was exercised for. The negative outcome FailureRecord's own TBox definition names as its defining trait; a FailureRecord's hasOutcome is this individual."@en .

#################################################################
#  Ruling 4 (owner follow-up, 2026-10-11): real Executor individuals
#  the owner named specifically, none yet carrying any WorkItem (none
#  needed one; these just need to exist, correctly typed and
#  conformant). First time this package's own live register carries
#  any Executor individual at all -- until now DefaultExecutor and its
#  CompetencyProfile existed only inside fixture/reference files
#  (16 of them; see backlog_strategy_exercise_abox's own comment and
#  the v1.380.0 changelog entry), because nothing outside fixtures
#  needed a responsible party. Consolidated per L-119 rather than
#  triplicated: DefaultExecutor's own IRI is reused here, unchanged,
#  rather than inventing a second "Claude Code" individual that would
#  denote the exact same real-world party -- this session IS a Claude
#  Code session, and DefaultExecutor's own fixture-carried definition
#  already said as much ("Claude, the AI agent carrying out BRSF's own
#  ontology-engineering sessions"). Its first live-register
#  declaration below makes that identity explicit; the sixteen
#  existing fixture files are left untouched (each is self-contained
#  test input validated on its own, their existing type+label[+
#  definition] triples already agree with this one and needed no
#  edit, and touching sixteen already-versioned fixtures for a prose
#  clarification would be exactly the disproportionate churn L-119
#  warns against when the cheaper path -- documenting the choice once,
#  here -- settles the same question).
#################################################################

<http://example.org/fixture-autofix#DefaultExecutor> a owl:NamedIndividual , backlog:Executor_SingleAgent ;
    rdfs:label "Claude Code — default AI-agent executor"@en ;
    skos:definition "The Claude Code session identity: this package's own default AI-agent Executor, the one this framework currently attributes AI-agent-performed work on BRSF itself to when no more specific identity applies. First planted as a throwaway, untyped stand-in across sixteen fixture/reference files when backlog:responsible became mandatory (v1.123.0); relabelled in place at v1.380.0 once the owner ruled the framework should name its own executing party honestly; given its first live-register declaration here (v1.37.0) once the owner asked to differentiate it from Executor_ClaudeDesktop as a distinct, reusable identity -- same IRI throughout, never duplicated." ;
    backlog:hasCompetencyProfile backlog:CP_DefaultExecutor .

backlog:CP_DefaultExecutor a owl:NamedIndividual , backlog:CompetencyProfile ;
    rdfs:label "Claude Code's competency profile"@en ;
    skos:definition "The capabilities this package's own sessions have actually exercised: conceptual and ontology modelling, requirements reading, SHACL authoring and clause-proving, tool scripting and running, release management and backlog stewardship -- the same nine-leaf subset of the closed 24 that fixture_positive's own ex:Prof_DefaultExecutor already proves this individual against, carried here into the live register for the first time."@en ;
    backlog:hasCapability backlog:Comp_OntologyModeling , backlog:Comp_ConceptualDataModeling ,
        backlog:Comp_RequirementsElicitation , backlog:Comp_ShaclAuthoring , backlog:Comp_ClauseProof ,
        backlog:Comp_ToolScripting , backlog:Comp_ToolRunOperation , backlog:Comp_ReleaseManagement ,
        backlog:Comp_BacklogStewardship .

backlog:Executor_ClaudeDesktop a owl:NamedIndividual , backlog:Executor_SingleAgent ;
    rdfs:label "Claude Desktop — AI assistant session executor"@en ;
    skos:definition "The Claude Desktop session identity, distinct from Claude Code's (DefaultExecutor): a single non-human executing party with no standing team membership, used when the owner works with Claude through the desktop application rather than through this package's own Claude Code sessions. Owner-directed differentiation, 2026-10-11: until this release the framework's one AI-agent identity (DefaultExecutor) stood in for any Claude session; this gives the desktop surface its own reusable identity rather than overloading Claude Code's."@en ;
    backlog:hasCompetencyProfile backlog:CP_ClaudeDesktop .

backlog:CP_ClaudeDesktop a owl:NamedIndividual , backlog:CompetencyProfile ;
    rdfs:label "Claude Desktop's competency profile"@en ;
    skos:definition "Modest and general, not this package's own specialised ontology-engineering set: requirements reading and tool scripting, the kind of drafting and planning assistance a desktop chat session actually performs, without crediting the SHACL-authoring/clause-proof/release-management skills Claude Code's own profile carries from doing that specific work in this specific package."@en ;
    backlog:hasCapability backlog:Comp_RequirementsElicitation , backlog:Comp_ToolScripting .

backlog:Executor_GitHubCopilot a owl:NamedIndividual , backlog:Executor_SingleAgent ;
    rdfs:label "GitHub Copilot — IDE coding assistant"@en ;
    skos:definition "The IDE-integrated coding-assistant identity the owner named specifically: a single non-human executing party, distinct from both Claude identities, for work actually done inline in an editor rather than in a chat or CLI session."@en ;
    backlog:hasCompetencyProfile backlog:CP_GitHubCopilot .

backlog:CP_GitHubCopilot a owl:NamedIndividual , backlog:CompetencyProfile ;
    rdfs:label "GitHub Copilot's competency profile"@en ;
    skos:definition "Coding- and implementation-leaning, per the owner's own characterisation: writing and completing application code, scripting, and integration work, the three leaves this kind of inline IDE assistant actually performs -- no analysis, governance or operations leaves credited, since an IDE assistant does not do that work."@en ;
    backlog:hasCapability backlog:Comp_Coding , backlog:Comp_ToolScripting , backlog:Comp_IntegrationBuild .

backlog:Executor_ReleasePipeline a owl:NamedIndividual , backlog:Executor_SingleAgent ;
    rdfs:label "BRSF release & gate automation — CI/CD pipeline executor"@en ;
    skos:definition "The owner's own named example ('a release pipeline, a test runner') modelled as one pipeline-class identity, grounded in the one concretely in evidence inside this very package: backlog_release_tool and backlog_gate, the automation that actually runs this package's own gate, manifest, publish and tag steps end to end with no person driving each step by hand. One non-human executing party, no standing team membership -- the taxonomy's own Executor_SingleAgent reading of 'a single automated pipeline run', here standing for the whole repeatable run rather than one throwaway invocation."@en ;
    backlog:hasCompetencyProfile backlog:CP_ReleasePipeline .

backlog:CP_ReleasePipeline a owl:NamedIndividual , backlog:CompetencyProfile ;
    rdfs:label "the release pipeline's competency profile"@en ;
    skos:definition "Exactly the two Operations leaves this automation actually performs on every run: taking a change through gate, manifest, publish and tag to a real release, and running this framework's own tooling and reading what it reports. No other leaf credited -- the pipeline does not analyse, design, decide or govern."@en ;
    backlog:hasCapability backlog:Comp_ReleaseManagement , backlog:Comp_ToolRunOperation .

backlog:Executor_YusufAltunel a owl:NamedIndividual , backlog:Executor_IndividualHuman ;
    rdfs:label "Yusuf Altunel"@en ;
    backlog:holdsRole backlog:Owner ;
    skos:definition "The framework's own owner: an IT R&D manager and ontology engineer, PhD in Computer Engineering, who rules every governance question this package records as a GovernanceRuling and has directed this package's own development throughout. No Executor_IndividualHuman individual existed for him under any name before this release (checked directly against the live register before adding one, per L-119)."@en ;
    backlog:hasCompetencyProfile backlog:CP_YusufAltunel .

backlog:CP_YusufAltunel a owl:NamedIndividual , backlog:CompetencyProfile ;
    rdfs:label "Yusuf Altunel's competency profile"@en ;
    skos:definition "Modest and evidence-based, grounded in what this package's own history actually shows him doing, not an IT R&D manager's full possible range: eliciting and stating requirements (every owner-directed feature this changelog records began as his own stated requirement), software architecture, ontology modelling (his own PhD subject and this framework's own method), governance ruling (every GovernanceRuling this package reifies is his), and backlog stewardship (directing this package's own roadmap release after release). Deliberately leaves out leaves this package has no direct evidence for, such as SHACL authoring or tool scripting, which this package's own history credits to Claude Code (DefaultExecutor) doing the work on his instruction, not to him doing it directly."@en ;
    backlog:hasCapability backlog:Comp_RequirementsElicitation , backlog:Comp_SoftwareArchitecture ,
        backlog:Comp_OntologyModeling , backlog:Comp_GovernanceRuling , backlog:Comp_BacklogStewardship .

backlog:Executor_FizyoVibeCoOwner a owl:NamedIndividual , backlog:Executor_IndividualHuman ;
    rdfs:label "an adopting project co-owner (family member)"@en ;
    skos:definition "The owner's co-owner of an adopting project, a physiotherapy and Pilates wellness studio in Ataköy that the owner co-owns alongside him. Named generically per the owner's own instruction -- no name is on record for this person, and none is invented here. Carries no CompetencyProfile: this package holds no direct evidence of this person's own individual competencies (as distinct from the FizyoVibeTeam's collective ones, below), and guessing one would be exactly the unevidenced claim the owner's own instruction warned against; hasCompetencyProfile is optional on every Executor (see its own TBox definition) and an Executor with none simply covers nothing, which is the honest state here."@en .

backlog:Executor_FizyoVibeTeam a owl:NamedIndividual , backlog:Executor_HumanTeam ;
    rdfs:label "an adopting project"@en ;
    skos:definition "The wellness-studio business itself, modelled as the human team its two owners jointly constitute: a named group of people acting as one executing party. hasController names Yusuf Altunel specifically (not the co-owner), consistent with this package's own Team-must-have-a-controller convention from the v1.379.0 Executor-taxonomy work, and with his own role as the framework's owner and the adopting project's primary point of business decision."@en ;
    backlog:hasExecutorMember backlog:Executor_YusufAltunel , backlog:Executor_FizyoVibeCoOwner ;
    backlog:hasController backlog:Executor_YusufAltunel ;
    backlog:hasCompetencyProfile backlog:CP_FizyoVibeTeam .

backlog:CP_FizyoVibeTeam a owl:NamedIndividual , backlog:CompetencyProfile ;
    rdfs:label "the adopting project's competency profile"@en ;
    skos:definition "Minimal and business-appropriate rather than technical, per the owner's own caution against over-claiming: backlog stewardship, the one leaf a wellness-studio business genuinely exercises in keeping its own register of work accurate and groomed. No analysis, design, verification or technical operations leaf is credited -- this package holds no evidence an adopting project itself (as opposed to the framework built for it) performs that kind of work, and none is guessed at to fill the profile out further."@en ;
    backlog:hasCapability backlog:Comp_BacklogStewardship .

#################################################################
#  v1.391.0 (G112) -- the second batch of sourced skills, entered as
#  supplied by the agentic-sdlc project, 2026-10-14.
#################################################################

backlog:Comp_ProductFamilyAdoptionPlanning a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Product family adoption planning"@en ;
    skos:definition "Planning how an organization moves to building products from shared assets: the route taken, the scope covered and the business case that justifies it."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.18.1, 25.18.2, 25.18.3, 25.4.8: the corpus defines each concept for practice; this entry names the skill of working with them. Items rest on a public presentation of the Software Engineering Institute on software product lines. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_AssetGovernance a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Asset governance"@en ;
    skos:definition "Deciding what enters, changes or leaves a set of shared assets, who pays for it and how the demands of several products are settled."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.18.6, 25.18.5, 25.4.5: the corpus defines each concept for practice; this entry names the skill of working with them. Items rest on a public presentation of the Software Engineering Institute on software product lines. Concept 25.18.6 is the supplying project's own judgement and the concept says so. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_DeliveryPerformanceMeasurement a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Delivery performance measurement"@en ;
    skos:definition "Measuring how quickly changes reach production and how often they fail or need urgent repair, and reading the two together."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.1, 25.19.2, 25.10.4: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_EnvironmentProvisioning a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Environment provisioning"@en ;
    skos:definition "Describing machines, networks and settings as versioned files and creating, changing and rebuilding environments from them."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.3, 25.9.10, 25.11.14: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_SecretHandling a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Secret handling"@en ;
    skos:definition "Keeping credentials and keys out of source and artifacts, supplying them only when needed and detecting leaks."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.4: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_PipelineSecurityEngineering a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Pipeline security engineering"@en ;
    skos:definition "Building security checks into the stages of the delivery flow, each with a stated pass criterion, and releasing software whose default settings are safe."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.5, 25.19.6, 25.10.8: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Verification .

backlog:Comp_VulnerabilityResponse a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Vulnerability response"@en ;
    skos:definition "Finding, ranking and fixing weaknesses in released software on an ongoing basis and analysing their causes."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.7: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Operations .

backlog:Comp_BlamelessIncidentReview a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Blameless incident review"@en ;
    skos:definition "Examining an incident for what in the system led to it, on the assumption that people acted in good faith, and agreeing follow-up actions that can be tested."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.8, 25.19.9: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_IncidentResponse .

backlog:Comp_IncidentTrendAnalysis a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Incident trend analysis"@en ;
    skos:definition "Pooling the reviews of many incidents to see recurring causes and recovery times so reliability work goes where it matters."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.10: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_IncidentResponse .

backlog:Comp_RecoveryRehearsal a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Recovery rehearsal"@en ;
    skos:definition "Practising recovery on purpose to check that the planned way back works and that people know it."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.19.11, 25.11.5: the corpus defines each concept for practice; this entry names the skill of working with them. Open works read for the concepts: the DORA research site, the OWASP DevSecOps Guideline, NIST SP 800-218 and the Google SRE book. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_IncidentResponse .

backlog:Comp_CustomerAcceptanceCoordination a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Customer acceptance coordination"@en ;
    skos:definition "Agreeing the acceptance conditions with the customer and obtaining their acceptance of what is delivered."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.11.11, 25.6.6: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_ReleaseManagement .

backlog:Comp_TransitionPlanning a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Transition planning"@en ;
    skos:definition "Choosing how a system goes into use, within the constraints that apply, before the release is made."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.11.13, 25.11.17: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_ReleaseManagement .

backlog:Comp_KnowledgePreservation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Knowledge preservation"@en ;
    skos:definition "Keeping what is known about a retiring system (decisions, design, operating experience) where it can still be found."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.12.5: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_RetirementManagement .

backlog:Comp_EnvironmentDecommissioning a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Environment decommissioning"@en ;
    skos:definition "Shutting down and removing the environments a retired system ran in, in an order that leaves nothing orphaned."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.12.6: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_RetirementManagement .

backlog:Comp_BusinessNeedAnalysis a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Business need analysis"@en ;
    skos:definition "Stating the gap or opportunity that justifies a change, the value expected from it and the context it will happen in."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.1.1, 25.1.2, 25.1.5: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_RequirementRefinementAllocation a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Requirement refinement and allocation"@en ;
    skos:definition "Turning a requirement at one level into requirements at the level below and assigning each to the part of the solution that will satisfy it."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.15.1, 25.15.2, 25.15.3: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Analysis .

backlog:Comp_TraceabilityManagement a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Traceability management"@en ;
    skos:definition "Keeping the links between needs, requirements, design, tests and decisions so that any one can be followed to the others."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.13.4: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_AssuranceArgumentConstruction a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Assurance argument construction"@en ;
    skos:definition "Assembling the evidence for a claim about a product into an argument that a reviewer can follow and challenge."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.13.5, 25.13.1: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Verification .

backlog:Comp_ProcessTailoring a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Process tailoring"@en ;
    skos:definition "Adapting a life cycle model and the work approach to the size, risk and nature of one project, and recording what was changed."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.14.1, 25.14.5: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Governance .

backlog:Comp_ModelBasedVerification a owl:NamedIndividual , backlog:Competency ;
    rdfs:label "Model-based verification"@en ;
    skos:definition "Checking a design or a product against its requirements by means of models, so that the checks can be prepared early and repeated when the design changes."@en ;
    dcterms:source "Own formulation of the practice concept corpus of the Ontology for Software Engineering material (CC BY 4.0), concepts 25.8.16: the corpus defines each concept for practice; this entry names the skill of working with them. Supplied by the agentic-sdlc project, 2026-10-14."@en ;
    skos:broader backlog:Comp_Verification .


#################################################################
#  v1.390.0 (G111) -- the agent role types, as a sourced vocabulary.
#  Roles are relations of an Executor to a WorkItem, not a layer of
#  their own; each concept says which relation realises it.
#################################################################

backlog:AgentRoleScheme a skos:ConceptScheme ;
    rdfs:label "Agent role types"@en ;
    skos:definition "Six roles an executor plays in relation to a work item, each defined from sources and each realised by a relation the framework already has or adds. Specialist is deliberately absent: a specialist is an executor whose competency profile covers a skill, which the competency mechanism already records (G39)."@en .

backlog:AgentRole_Orchestrator a skos:Concept ; skos:inScheme backlog:AgentRoleScheme ;
    rdfs:label "Orchestrator"@en ;
    skos:definition "Plans a piece of work, divides it among other executors, directs them, follows progress, merges their results and corrects course when needed."@en ;
    skos:scopeNote "Realised as the collective responsible Executor of a work item that decomposes into child items, with its team controller. Not the same as Supervisor, which can halt and override rather than divide work."@en ;
    dcterms:source "Magentic-One documentation (lead agent: task decomposition and planning, directs the other agents, tracks progress, corrects course); Anthropic, Building effective agents (orchestrator-workers: a central call breaks tasks down, delegates and synthesizes results)."@en .

backlog:AgentRole_Implementer a skos:Concept ; skos:inScheme backlog:AgentRoleScheme ;
    rdfs:label "Implementer"@en ;
    skos:definition "Produces the work product it is assigned (code, a model, a document) to its specification and checks it with its own tests before handing it on."@en ;
    skos:scopeNote "Realised as the responsible Executor of an atomic work item."@en ;
    dcterms:source "MetaGPT, arXiv 2308.00352 (Engineer role); Magentic-One documentation (Coder agent)."@en .

backlog:AgentRole_Reviewer a skos:Concept ; skos:inScheme backlog:AgentRoleScheme ;
    rdfs:label "Reviewer"@en ;
    skos:definition "Examines a work product against stated criteria and returns findings to its producer, who decides what to change. May belong to the same party as the producer, which separates it from a verifier."@en ;
    skos:scopeNote "Realised by reviewedBy."@en ;
    dcterms:source "Anthropic, Building effective agents (evaluator-optimizer); MetaGPT, arXiv 2308.00352 (QA Engineer)."@en .

backlog:AgentRole_Verifier a skos:Concept ; skos:inScheme backlog:AgentRoleScheme ;
    rdfs:label "Verifier"@en ;
    skos:definition "Checks a result it did not produce, independent of the producer; its attestation is what lets the work count as Done."@en ;
    skos:scopeNote "Realised by verifiedBy. Membership independence is checked everywhere; managerial independence only behind RS_ManagerialIndependence; technical and financial independence are not checked. A tool is not a verifier (G110)."@en ;
    dcterms:source "NASA IV&V Program overview and the JDN description of independence (technical, managerial, financial); agentic-systems v0.34.2 independent attestation."@en .

backlog:AgentRole_Supervisor a skos:Concept ; skos:inScheme backlog:AgentRoleScheme ;
    rdfs:label "Supervisor"@en ;
    skos:definition "A person, or group of people, who understand what an agent can and cannot do, watch its work, read its results correctly, and may refuse its output, override it, or stop it."@en ;
    skos:scopeNote "Realised by overseenBy; behind RS_HumanOversight the overseer must be a person or a human team."@en ;
    dcterms:source "Regulation (EU) 2024/1689 Article 14(4)(a) to (e)."@en .

backlog:AgentRole_Explainer a skos:Concept ; skos:inScheme backlog:AgentRoleScheme ;
    rdfs:label "Explainer"@en ;
    skos:definition "Puts a result that has already been produced and checked into words for a human reader. It decides nothing, and its text counts only after a deterministic check finds every number and name of the text in the record it explains."@en ;
    skos:scopeNote "Needs no relation of its own: it is the responsible Executor of a communication work item. Whether small models explain faithfully is recorded in its source as not yet measured."@en ;
    dcterms:source "agentic-systems ontology, explainer agent (records the owner's direction of 2026-09-30)."@en .

#################################################################
#  Links (v1.53.0, G135)
#################################################################
backlog:Method_BRSF a owl:NamedIndividual , backlog:Methodology ;
    rdfs:label "Backlog & Roadmap Semantic Framework method"@en ;
    skos:definition "The method of this framework: a backlog and roadmap governed by a closed lifecycle, evidence-bound completion, derived container and milestone state, and a release path with fixed gates. Its governing rules are the four R-rules; its gates are the release gates."@en .

backlog:Rule_R1_ContainerStateDerivation backlog:ruleOfMethodology backlog:Method_BRSF .
backlog:Rule_R2_MilestoneStateDerivation backlog:ruleOfMethodology backlog:Method_BRSF .
backlog:Rule_R3_RankingArbitration backlog:ruleOfMethodology backlog:Method_BRSF .
backlog:Rule_R4_ExternalBlockerDerivation backlog:ruleOfMethodology backlog:Method_BRSF .

backlog:FM_ScopeGap backlog:distinguishedFrom backlog:FM_ScopeCreep .
backlog:Executor_ClaudeDesktop backlog:distinguishedFrom <http://example.org/fixture-autofix#DefaultExecutor> .
backlog:Comp_DataDisposition backlog:distinguishedFrom backlog:Comp_DataMigration .
backlog:Comp_DomainModelling backlog:distinguishedFrom backlog:Comp_ConceptualDataModeling .
backlog:Task_ArchitectureDefinition backlog:distinguishedFrom backlog:Task_DesignDefinition .
backlog:Domain_Ontology backlog:distinguishedFrom backlog:Comp_BehaviouralModelling .
backlog:Executor_AgentTeam backlog:distinguishedFrom backlog:Executor_HumanTeam .
backlog:LS_Opened backlog:statusOfStage backlog:Stage_Mission .
backlog:LS_Scoped backlog:statusOfStage backlog:Stage_Scope .
backlog:LS_Goaled backlog:statusOfStage backlog:Stage_Goal .
backlog:LS_Objectived backlog:statusOfStage backlog:Stage_Objective .
backlog:LS_Backlogged backlog:statusOfStage backlog:Stage_Backlog .
backlog:Phase_Live backlog:phaseRankingModel backlog:ThroughputRanking .
backlog:Phase_Sunsetting backlog:phaseGatedCategory backlog:Cat_NewCapability .
backlog:FM_ScopeCreep backlog:safeguardedBy backlog:Facing_Exclusion .
backlog:LaunchScopedRanking backlog:collapsesTo backlog:ThroughputRanking .
backlog:Comp_Coding backlog:competencyDomain backlog:Domain_SourceCode .
backlog:FM_LineageThrash backlog:manifestsAsThrashKind backlog:Thrash_NoNovelty , backlog:Thrash_AdmissionLost , backlog:Thrash_NotDeliberated .
backlog:Method_WSJF dcterms:requires backlog:Method_CostOfDelay .

backlog:RS_ImpedimentNamesWhatItBlocks a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_1 ;
    rdfs:label "A standing impediment names the work it blocks"@en ;
    skos:definition "Within the adopter's scope: an unresolved impediment impedes at least one work item or container. A wait that names no work is a question, and an unrelated question does not hold a lineage (the Owner's rule of 2026-10-24). A RuleSet because it binds only a register or lineage that declared it (G89, G91)."@en .

backlog:RS_DecompositionStateAgrees a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_1 ;
    rdfs:label "A parent whose children are all finished is not left open"@en ;
    skos:definition "Within the adopter's scope: a work item whose children are all Done or Cancelled, with at least one Done, is itself Done or Cancelled. The state the children derive and the state asserted must agree; the rule reports the disagreement as a violation. A RuleSet because it binds only a register or lineage that declared it (G89, G91)."@en .

backlog:RS_RepairReprioritises a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_1 ;
    rdfs:label "A repair re-prioritises the open items it touches"@en ;
    skos:definition "Within the adopter's scope: an open defect either names, through reprioritises, the open work items whose priority it changes, or states through reprioritisesNothingBecause why none; and every open item it names carries a priority score computed after the defect's own. A RuleSet because it binds only a register or lineage that declared it (G89, G91); the owner's rule of 2026-10-23 is that a repair entering the backlog re-ranks the open items rather than merely being added."@en .

backlog:Profile_Standard a owl:NamedIndividual , backlog:OpeningProfile ;
    rdfs:label "Standard lineage profile"@en ;
    skos:definition "The way of working every lineage can adopt at its opening: status moves and flow points are recorded, a repair re-prioritises the items it touches, a standing impediment names the work it blocks, and a parent whose children are finished is not left open."@en ;
    backlog:profileIncludes backlog:RS_ConcurrentLineages , backlog:RS_PlanBeforeStart , backlog:RS_CancellationAssessed , backlog:RS_ChangeSupportsMission , backlog:RS_StatusHistoryRecorded , backlog:RS_FlowPointsRecorded , backlog:RS_RepairReprioritises , backlog:RS_ImpedimentNamesWhatItBlocks , backlog:RS_DecompositionStateAgrees .

backlog:Profile_Agentic a owl:NamedIndividual , backlog:OpeningProfile ;
    rdfs:label "Agentic lineage profile"@en ;
    skos:definition "The standard profile plus accountability for agent work: an agent named for any function of an item is a run of a definition, every status move names who made it, and the parties that do, oversee, verify and approve an item are different."@en ;
    backlog:profileIncludes backlog:RS_ConcurrentLineages , backlog:RS_PlanBeforeStart , backlog:RS_CancellationAssessed , backlog:RS_ChangeSupportsMission , backlog:RS_StatusHistoryRecorded , backlog:RS_FlowPointsRecorded , backlog:RS_RepairReprioritises , backlog:RS_ImpedimentNamesWhatItBlocks , backlog:RS_DecompositionStateAgrees , backlog:RS_AgentAccountability .

backlog:Pr_1 a owl:NamedIndividual , backlog:ProfileRevision ; rdfs:label "Profile revision 1"@en ; backlog:revisionNumber 1 ; skos:definition "The profiles up to release 1.432.0: status history, flow points, repair re-prioritising, impediments that name what they block, decomposition state, and agent accountability."@en .
backlog:Pr_2 a owl:NamedIndividual , backlog:ProfileRevision ; rdfs:label "Profile revision 2"@en ; backlog:revisionNumber 2 ; skos:definition "Release 1.433.0 (G159) adds the one-lineage rule."@en .
backlog:Pr_3 a owl:NamedIndividual , backlog:ProfileRevision ; rdfs:label "Profile revision 3"@en ; backlog:revisionNumber 3 ; skos:definition "Release 1.434.0 (G162) adds the plan step, the assessed cancellation and the supporting change request."@en .

#################################################################
#  v1.436.0 (G164) -- the rulings that a shape enforces are recorded as rulings, with the shapes that enforce them.
#  Nothing is invented: the statement is the ruling's own heading in the lineage discipline; each shape is one the ruling's section
#  names, one that cites the ruling in its own text, or one a reading of the ruling against the shapes found to test it.
#################################################################

fw:Ruling_G19 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G19" ;
    rdfs:label "A floor is measured, not argued"@en ;
    backlog:hasRulingStatement "A floor is measured, not argued" ;
    backlog:enforcedByShape backlog:ClassReachabilityShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G19; shapes linked in G164." .

