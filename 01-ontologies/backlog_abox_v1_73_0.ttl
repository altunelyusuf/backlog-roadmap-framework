#################################################################
#  v1.445.0 -- G167: the kind of work of a ceremony record (story AC-S01 of Lineage 20).
#################################################################

backlog:WorkKind_Preparation a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Preparation"@en ;
    skos:definition "Grooming, refining and readying work before it is committed: the work that makes an item ready to be planned."@en .

backlog:WorkKind_Planning a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Planning"@en ;
    skos:definition "Committing work to a box and breaking it into tasks: the work that decides what is done next."@en .

backlog:WorkKind_Execution a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Execution"@en ;
    skos:definition "Doing the committed work: building, writing, running."@en .

backlog:WorkKind_Monitoring a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Monitoring"@en ;
    skos:definition "Watching the work and its measures as it proceeds, without changing it: the daily checkpoint and the reading of measures."@en .

backlog:WorkKind_Control a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Control"@en ;
    skos:definition "Checking work against what was planned and acting on a difference: tests, inspections, reviews of results."@en .

backlog:WorkKind_Reporting a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Reporting"@en ;
    skos:definition "Telling those who decide what is achieved and what is not."@en .

backlog:WorkKind_Closure a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Closure"@en ;
    skos:definition "Closing a box, an item or a lineage: the review, the retrospective and the closing report."@en .

backlog:WorkKind_ChangeManagement a owl:NamedIndividual , backlog:WorkKind ;
    rdfs:label "Managing change"@en ;
    skos:definition "Deciding and recording a change to the chain or the plan: a change request, an admitted item, a revision."@en .

backlog:Pr_5 a owl:NamedIndividual , backlog:ProfileRevision ; rdfs:label "Profile revision 5"@en ; backlog:revisionNumber 5 ; skos:definition "Release 1.445.0 (G167) adds to the adaptive profile the kind of work of each refinement, planning, review and retrospective record."@en .

backlog:RS_CeremonyKinds a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_5 ;
    rdfs:label "A ceremony record names the one kind of work it serves"@en ;
    skos:definition "Within the adopter: every refinement event, planning ceremony, review ceremony and retrospective names exactly one kind of work, from the closed set of eight."@en .

backlog:Profile_Adaptive backlog:profileIncludes backlog:RS_CeremonyKinds .
fw:Ruling_G167 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G167" ;
    rdfs:label "A ceremony record names the one kind of work it serves"@en ;
    backlog:hasRulingStatement "A ceremony record names the one kind of work it serves" ;
    backlog:enforcedByShape backlog:CeremonyKindShape , backlog:CeremonyKindTwoShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v130.0.0, section G167." .
fw:Ruling_G167 backlog:rulingDecides backlog:Pr_5 , backlog:RS_CeremonyKinds .

