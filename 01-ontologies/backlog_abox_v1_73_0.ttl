    backlog:enforcedByShape backlog:ArchiveConformanceLinksShape , backlog:ArchiveEntryLinksShape , backlog:CodeTableModuleLinkShape , backlog:SupersededMissionInFlightShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G134; shapes linked in G164." .

fw:Ruling_G136 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G136" ;
    rdfs:label "A defect named at closure has an item; a criterion records the tool it is measured with; the sprint goal is fixed at the start; a story has "@en ;
    backlog:hasRulingStatement "A defect named at closure has an item; a criterion records the tool it is measured with; the sprint goal is fixed at the start; a story has its epic; an executor is briefed from the task and criterion" ;
    backlog:enforcedByShape backlog:BriefDerivedShape , backlog:ClosureCaveatTrackedShape , backlog:CodeTableModuleLinkShape , backlog:CriterionCitesGateShape , backlog:CriterionToolVersionShape , backlog:PlanningAfterIterationStartShape , backlog:StartBeforeExecutorShape , backlog:StartedWithoutBriefShape , backlog:StoryEpicOrAloneShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G136; shapes linked in G164." .

fw:Ruling_G137 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G137" ;
    rdfs:label "The corrected handover: the six measures stand, and three gaps its register check found are advised"@en ;
    backlog:hasRulingStatement "The corrected handover: the six measures stand, and three gaps its register check found are advised" ;
    backlog:enforcedByShape backlog:IterationCeremonyShape , backlog:ObservedDuringCeremonyLinkShape , backlog:StartBeforeExecutorShape , backlog:StartInStartedIterationShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G137; shapes linked in G164." .

fw:Ruling_G147 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G147" ;
    rdfs:label "A repair re-prioritises the open items it touches (opt-in rule set)"@en ;
    backlog:hasRulingStatement "A repair re-prioritises the open items it touches (opt-in rule set)" ;
    backlog:enforcedByShape backlog:RepairReprioritisesShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G147; shapes linked in G164." .

fw:Ruling_G148 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G148" ;
    rdfs:label "Four handovers answered: Cancelled items, a parent left open, adoption timing at a restart, a freeze after the restart, a goal across supers"@en ;
    backlog:hasRulingStatement "Four handovers answered: Cancelled items, a parent left open, adoption timing at a restart, a freeze after the restart, a goal across superseded missions" ;
    backlog:enforcedByShape backlog:DecompositionStateAgreesShape , backlog:GoalTriangleShape , backlog:GroomingShape , backlog:L4GroomingShape , backlog:L4IntentChainShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G148; shapes linked in G164." .

fw:Ruling_G149 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G149" ;
    rdfs:label "A lineage does not wait for a question that is not about its work, and a question with a non-human answerer is decided in the lineage (the O"@en ;
    backlog:hasRulingStatement "A lineage does not wait for a question that is not about its work, and a question with a non-human answerer is decided in the lineage (the Owner's rule of 2026-10-24)" ;
    backlog:enforcedByShape backlog:ImpedimentNamesWhatItBlocksShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G149; shapes linked in G164." .

fw:Ruling_G153 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G153" ;
    rdfs:label "A Done epic is delivered through its stories, so it is not asked for a deployment unit"@en ;
    backlog:hasRulingStatement "A Done epic is delivered through its stories, so it is not asked for a deployment unit" ;
    backlog:enforcedByShape backlog:DeploymentCoverageShape , backlog:GroomingShape , backlog:L4GroomingShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G153; shapes linked in G164." .

fw:Ruling_G154 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G154" ;
    rdfs:label "A bypass is answered by a restart or by the Owner's change-management route; the model-artifact digest finding is deferred with a design"@en ;
    backlog:hasRulingStatement "A bypass is answered by a restart or by the Owner's change-management route; the model-artifact digest finding is deferred with a design" ;
    backlog:enforcedByShape backlog:ChangeManagementAnswerShape , backlog:GroomingShape , backlog:L4StoryGranularityShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G154; shapes linked in G164." .

fw:Ruling_G155 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G155" ;
    rdfs:label "A lineage opens under a named profile; agentic work is a profile, not a list to remember"@en ;
    backlog:hasRulingStatement "A lineage opens under a named profile; agentic work is a profile, not a list to remember" ;
    backlog:enforcedByShape backlog:OpeningProfileAdoptedShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G155; shapes linked in G164." .

fw:Ruling_G158 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G158" ;
    rdfs:label "An emergency pauses a lineage; it is not change management and not a worked-around lineage"@en ;
    backlog:hasRulingStatement "An emergency pauses a lineage; it is not change management and not a worked-around lineage" ;
    backlog:enforcedByShape backlog:ImpactAssessmentShape , backlog:OpeningProfileAdoptedShape , backlog:UrgentInterruptionShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G158; shapes linked in G164." .

fw:Ruling_G159 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G159" ;
    rdfs:label "One lineage at a time is the default; parallel lineages need different maintainers; one urgency suspension at a time"@en ;
    backlog:hasRulingStatement "One lineage at a time is the default; parallel lineages need different maintainers; one urgency suspension at a time" ;
    backlog:enforcedByShape backlog:OneLineageRuleAdoptedShape , backlog:UrgentInterruptionShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G159; shapes linked in G164." .

fw:Ruling_G160 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G160" ;
    rdfs:label "Route B owes no act record it cannot honestly have"@en ;
    backlog:hasRulingStatement "Route B owes no act record it cannot honestly have" ;
    backlog:enforcedByShape backlog:GroomingShape , backlog:IterationCapacityShape , backlog:L4StoryGranularityShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G160; shapes linked in G164." .

fw:Ruling_G162 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G162" ;
    rdfs:label "The plan step, the cancelling exit and the adaptation route are required and recorded"@en ;
    backlog:hasRulingStatement "The plan step, the cancelling exit and the adaptation route are required and recorded" ;
    backlog:enforcedByShape backlog:AsIsAssessmentShape , backlog:CancellationAssessedShape , backlog:ChangeSupportsMissionShape , backlog:KickOffReportShape , backlog:OneLineageRuleAdoptedShape , backlog:PlanBeforeStartShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G162; shapes linked in G164." .

fw:Ruling_G163 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G163" ;
    rdfs:label "The opening profile is versioned, so a profile that grows does not judge a lineage opened earlier"@en ;
    backlog:hasRulingStatement "The opening profile is versioned, so a profile that grows does not judge a lineage opened earlier" ;
    backlog:enforcedByShape backlog:ChangeSupportsMissionShape , backlog:OpeningProfileAdoptedShape , backlog:ProfileRevisionShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G163; shapes linked in G164." .

fw:Ruling_G165 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G165" ;
    rdfs:label "A safeguard that no ruling names is recorded by the experience it keeps, read for what it says"@en ;
    backlog:hasRulingStatement "A safeguard that no ruling names is recorded by the experience it keeps, read for what it says" ;
    backlog:enforcedByShape backlog:ShapeLessonShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v127.0.0, section G165." .

