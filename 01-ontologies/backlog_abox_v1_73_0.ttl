    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G22; shapes linked in G164." .

fw:Ruling_G23 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G23" ;
    rdfs:label "Verifying closed work is not backfilling it"@en ;
    backlog:hasRulingStatement "Verifying closed work is not backfilling it" ;
    backlog:enforcedByShape backlog:EvidenceBoundDoneShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G23; shapes linked in G164." .

fw:Ruling_G24 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G24" ;
    rdfs:label "A derived number must answer to what it derives from"@en ;
    backlog:hasRulingStatement "A derived number must answer to what it derives from" ;
    backlog:enforcedByShape backlog:CommittedEffortShape , backlog:ObservedDurationShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G24; shapes linked in G164." .

fw:Ruling_G29 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G29" ;
    rdfs:label "Goal generation is complete by construction once GoalFacing is treated as a closure test"@en ;
    backlog:hasRulingStatement "Goal generation is complete by construction once GoalFacing is treated as a closure test" ;
