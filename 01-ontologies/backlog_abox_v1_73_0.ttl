    prov:wasAttributedTo "Yusuf Altunel" ;
    skos:definition "Framework-level instances only: the prioritisation methods this release ships and the reusable baseline Definition of Done. Contains NO project register data — an adopting development writes its work items, containers and evidence in its own namespace and merges this file for the shared vocabulary."@en ;
    dcterms:source "SAFe 6.0 WSJF; Intercom RICE; MoSCoW (DSDM); Reinertsen cost-of-delay economics; BACKLOG_ROADMAP_STANDARD_v1_0_0 (adopted 2026-07-27) for report sections, release gates and methodology-rule records."@en .

#################################################################
#  v1.8.0 (Lineage 17, OESC-S01): this file now holds, in this order, the controlled individuals that lived in the vocabulary
#  file, the two the rules file held, the reference individuals, the severity audit's record, and the live register (which was
#  backlog_framework_register_abox_v9.107.0). Statements and their dated comments are moved as they were.
#################################################################

# ---- controlled individuals (from the vocabulary file)
backlog:Proposed a owl:NamedIndividual , backlog:LifecycleState ;
    rdfs:label "Proposed"@en ;
    skos:definition "Recorded and prioritisable, but not yet refined to the point where work could start; acceptance criteria may still be absent."@en .

backlog:Refined a owl:NamedIndividual , backlog:LifecycleState ;
    rdfs:label "Refined"@en ;
    skos:definition "Decomposed into real Tasks, a genuine checkpoint reached before the full Ready bar, deliberately not after it. Distinct from Ready: Refined says decomposition happened; Ready additionally requires acceptance criteria and a recorded refinement event, ReadinessGateShape's own existing, unchanged bar. Positioned here rather than between Ready and InProgress precisely because InProgress is reachable only through Ready (T_Start is the sole real transition that targets it) -- placing Refined before Ready means every existing Ready-specific check keeps meaning exactly what it already meant, proven on a real fixture both ways before this was written: an exact-match check on hasState=Ready neither gains a false negative for a Refined item that never claimed to be Ready, nor loses coverage of a Ready item that still owes its real requirements."@en .

backlog:Ready a owl:NamedIndividual , backlog:LifecycleState ;
    rdfs:label "Ready"@en ;
    skos:definition "Refined and unblocked: acceptance criteria exist and every dependency is Done, so work can start without further clarification. The state the next-item selection query draws from."@en .

backlog:InProgress a owl:NamedIndividual , backlog:LifecycleState ;
    rdfs:label "In Progress"@en ;
    skos:definition "Being worked; partial delivery may exist but completion evidence is absent or not yet verified."@en .

backlog:Done a owl:NamedIndividual , backlog:LifecycleState ;
    rdfs:label "Done"@en ;
    skos:definition "Complete AND backed by evidence. Under an evidence-bound profile (L2 or L3) the SHACL suite refuses this state to any item lacking at least one Evidence whose evidenceVerified flag is true, so 'done' can never be a prose claim."@en .

backlog:Cancelled a owl:NamedIndividual , backlog:LifecycleState ;
    rdfs:label "Cancelled"@en ;
    skos:definition "Withdrawn without delivery. A terminal state that carries no evidence obligation but must record a rationale, so abandoned scope stays visible instead of silently disappearing from the register."@en .

backlog:Suspended a owl:NamedIndividual , backlog:LifecycleState , backlog:OptionalLifecycleState ;
    rdfs:label "Suspended"@en ;
    skos:definition "Work that had started and was deliberately paused, to be resumed or withdrawn. Distinct from an impediment (something outside the work stands in the way) and from Ready (work that has not started): a suspended item keeps its start point, and the pause and its end are recorded moves like any other."@en .

backlog:Now a owl:NamedIndividual , backlog:RoadmapHorizon ;
    backlog:horizonExpectsState backlog:Ready , backlog:InProgress ;
    rdfs:label "Now"@en ;
    skos:definition "Committed and actively worked in the current increment; items here are expected to be Ready or InProgress."@en .

backlog:Next a owl:NamedIndividual , backlog:RoadmapHorizon ;
    rdfs:label "Next"@en ;
    skos:definition "Intended for the increment after the current one; refined enough to be estimated but not committed."@en .

backlog:Later a owl:NamedIndividual , backlog:RoadmapHorizon ;
    rdfs:label "Later"@en ;
    skos:definition "Directional intent beyond the next increment; deliberately unrefined, and never to be reported to stakeholders as a schedule."@en .

backlog:Holds a owl:NamedIndividual , backlog:InvariantStatus ;
    rdfs:label "Holds"@en ;
    skos:definition "The check was executed in this pass and returned the expected result."@en .

backlog:Violated a owl:NamedIndividual , backlog:InvariantStatus ;
    rdfs:label "Violated"@en ;
    skos:definition "The check was executed in this pass and returned an unexpected result; the invariant is currently broken."@en .

backlog:NotYetEnforceable a owl:NamedIndividual , backlog:InvariantStatus ;
    rdfs:label "Not Yet Enforceable"@en ;
    skos:definition "The check cannot yet be executed meaningfully because the work item that would enforce the invariant is not Done. Must never be reported as passing."@en .

backlog:L1_Core a owl:NamedIndividual , backlog:ConformanceLevel ;
    rdfs:label "L1 Core"@en ;
    skos:definition "Every work item carries a unique identifier, exactly one lifecycle state, and well-typed container and dependency references. Structural integrity only: nothing is claimed about how completion is proven."@en .

backlog:L2_EvidenceBound a owl:NamedIndividual , backlog:ConformanceLevel ;
    rdfs:label "L2 Evidence-Bound"@en ;
    skos:definition "L1 plus: no item may hold the Done state without at least one Evidence whose evidenceVerified flag is true, every Definition-of-Done criterion carries executable check text, and container state is derived rather than asserted. This is the level at which 'done' stops being prose."@en .

backlog:L3_Governed a owl:NamedIndividual , backlog:ConformanceLevel ;
    rdfs:label "L3 Governed"@en ;
    skos:definition "L2 plus: Done items are anchored to a release carrying a package SHA-256 or to a named passing test (review evidence alone is insufficient), each item records when it was last individually re-verified, cross-cutting invariants are executable with honest statuses, and the reconciliation gate runs as a mandatory release gate rather than as an available script."@en .

backlog:CoreFacet a owl:NamedIndividual , backlog:FrameworkFacet ;
    rdfs:label "Core Facet"@en ;
    skos:definition "Work items, containers and the lifecycle enumeration. Mandatory: every adoption includes it."@en .

backlog:EvidenceFacet a owl:NamedIndividual , backlog:FrameworkFacet ;
    rdfs:label "Evidence Facet"@en ;
    skos:definition "Evidence classes, the verification flag, and the Definition-of-Done criteria. Required at conformance level L2 and above."@en .

backlog:PrioritizationFacet a owl:NamedIndividual , backlog:FrameworkFacet ;
    rdfs:label "Prioritization Facet"@en ;
    skos:definition "Method-parameterised priority scores and the next-item selection rule."@en .

backlog:RoadmapFacet a owl:NamedIndividual , backlog:FrameworkFacet ;
    rdfs:label "Roadmap Facet"@en ;
    skos:definition "Roadmaps, horizons and milestones as projections over the backlog."@en .

backlog:InvariantFacet a owl:NamedIndividual , backlog:FrameworkFacet ;
    rdfs:label "Invariant Facet"@en ;
    skos:definition "Cross-cutting invariants with executable checks and honest statuses. Required at conformance level L3."@en .

backlog:AuditFacet a owl:NamedIndividual , backlog:FrameworkFacet ;
    rdfs:label "Audit Facet"@en ;
    skos:definition "Per-item re-verification timestamps and audit notes, so coverage of a reconciliation pass is recorded item by item rather than implied. Required at conformance level L3."@en .

backlog:Stage_Creation a owl:NamedIndividual , backlog:EntityLifecycleStage ;
    rdfs:label "Creation"@en ;
    skos:definition "The entity comes into existence: registration, intake, provisioning."@en .

backlog:Stage_ActiveUse a owl:NamedIndividual , backlog:EntityLifecycleStage ;
    rdfs:label "Active use"@en ;
    skos:definition "The entity is operated on in the normal course of business."@en .

backlog:Stage_SuspensionException a owl:NamedIndividual , backlog:EntityLifecycleStage ;
    rdfs:label "Suspension / exception"@en ;
    skos:definition "The entity is paused, blocked, cancelled, disputed or otherwise handled outside the happy path. The stage most often absent from a backlog, because titles describe the happy path."@en .

backlog:Stage_Termination a owl:NamedIndividual , backlog:EntityLifecycleStage ;
    rdfs:label "Termination / closure"@en ;
    skos:definition "The entity leaves the system: deletion, archival, closure, settlement."@en .

backlog:Owner a owl:NamedIndividual , backlog:Role ;
    rdfs:label "Owner"@en ;
    skos:definition "Makes the calls that genuinely require business judgement — what is in launch scope, which live defect blocks launch versus can be deferred, single-tenant versus multi-tenant. These are never computed, and silence is never approval of a scope decision that was not actually given."@en .

backlog:Builder a owl:NamedIndividual , backlog:Role ;
    rdfs:label "Builder"@en ;
    skos:definition "Performs the multi-factor scoring judgements with written rationale, maintains the gates and tooling, and surfaces every disclosed dependency and recorded gap for the owner's visibility rather than resolving them quietly."@en .

backlog:ThroughputRanking a owl:NamedIndividual , backlog:RankingModel ;
    rdfs:label "Throughput ranking"@en ;
    skos:definition "Ranks the whole register by score under a named method, answering what the best next increment of capacity is for an already-live product. It divides value by cost, so a large essential capability can and will rank below a small cheap one — correct for this question, wrong for the launch question."@en .

backlog:LaunchScopedRanking a owl:NamedIndividual , backlog:RankingModel ;
    rdfs:label "Launch-scoped ranking"@en ;
    skos:definition "Ranks only within the active launch-priority gate plus cross-cutting prerequisites, answering what must clear before first deployment. It collapses back to throughput ranking automatically once every launch gate is closed, so the scoping is a state of the register rather than a mode someone must remember to switch off."@en .

backlog:Live a owl:NamedIndividual , backlog:DocumentStatus ;
    rdfs:label "Live"@en ;
    skos:definition "Current and safe to act on."@en .

backlog:Superseded a owl:NamedIndividual , backlog:DocumentStatus ;
    rdfs:label "Superseded"@en ;
    skos:definition "Retired but retained in place, carrying a pointer to what replaced it and the reason, so the trail from an old reference to the live source stays walkable."@en .

backlog:Cat_NewCapability a owl:NamedIndividual , backlog:InvestmentCategory ;
    rdfs:label "New capability"@en ;
    skos:definition "Work that adds something the product could not do before. Dominates before first launch and competes for capacity afterwards."@en .

backlog:Cat_Maintenance a owl:NamedIndividual , backlog:InvestmentCategory ;
    rdfs:label "Maintenance"@en ;
    skos:definition "Work that keeps what exists working: defect repair, dependency upkeep, operational support. Structurally disadvantaged by value-over-cost ranking, which is why it needs a policy share rather than a fair fight."@en .

backlog:Cat_TechnicalDebt a owl:NamedIndividual , backlog:InvestmentCategory ;
    rdfs:label "Technical debt"@en ;
    skos:definition "Work that reduces the cost of future work rather than delivering user-visible value now. Its benefit is a change in someone else's job size, which no single item's score can express."@en .

backlog:Cat_Compliance a owl:NamedIndividual , backlog:InvestmentCategory ;
    rdfs:label "Compliance"@en ;
    skos:definition "Work required by an obligation external to the product's own goals. Ranks by deadline and consequence, not by value per unit effort."@en .

backlog:Phase_PreLaunch a owl:NamedIndividual , backlog:ProductLifecyclePhase ;
    rdfs:label "Pre-launch"@en ;
    skos:definition "Nothing has been deployed to real users yet; launch gates govern the order of work."@en .

backlog:Phase_Live a owl:NamedIndividual , backlog:ProductLifecyclePhase ;
    rdfs:label "Live"@en ;
    skos:definition "The product is in real use; ongoing capacity is allocated by throughput ranking within the policy mix, and maintenance is no longer a residual category."@en .

backlog:Phase_Sunsetting a owl:NamedIndividual , backlog:ProductLifecyclePhase ;
    rdfs:label "Sunsetting"@en ;
    skos:definition "The product is being withdrawn; new capability work requires an explicit owner decision, and compliance and migration work dominate."@en .

backlog:Dep_Knowledge a owl:NamedIndividual , backlog:DependencyKind ;
    rdfs:label "Knowledge dependency"@en ;
    skos:definition "Work waits on information someone holds or must produce — a decision, a specification, expertise. Released by a conversation or a spike, not by scheduling."@en .

backlog:Dep_Task a owl:NamedIndividual , backlog:DependencyKind ;
    rdfs:label "Task dependency"@en ;
    skos:definition "Work waits on other work being finished first. The only kind an ordering constraint alone can express, and the kind most tools assume is the only one."@en .

backlog:Dep_Resource a owl:NamedIndividual , backlog:DependencyKind ;
    rdfs:label "Resource dependency"@en ;
    skos:definition "Work waits on a person, environment, licence or component being available. Released by allocation, not by completing anything."@en .

backlog:Dir_Increase a owl:NamedIndividual , backlog:MetricDirection ;
    rdfs:label "Increase"@en ;
    skos:definition "The objective is met when the observed value reaches or exceeds the target."@en .

backlog:Dir_Decrease a owl:NamedIndividual , backlog:MetricDirection ;
    rdfs:label "Decrease"@en ;
    skos:definition "The objective is met when the observed value reaches or falls below the target."@en .

backlog:Ach_Met a owl:NamedIndividual , backlog:AchievementStatus ;
    rdfs:label "Met"@en ;
    skos:definition "An observation exists on or after the deadline showing the target reached in the declared direction."@en .

backlog:Ach_Missed a owl:NamedIndividual , backlog:AchievementStatus ;
    rdfs:label "Missed"@en ;
    skos:definition "The deadline has passed and the latest observation does not reach the target. A first-class outcome, because a framework in which nothing can be recorded as missed measures nothing."@en .

backlog:Ach_Pending a owl:NamedIndividual , backlog:AchievementStatus ;
    rdfs:label "Pending"@en ;
    skos:definition "The deadline has not passed yet."@en .

backlog:Direction_Grow a owl:NamedIndividual , backlog:ChangeDirection ;
    rdfs:label "Grow"@en ;
    skos:definition "The change admits something not previously in scope."@en .

backlog:Direction_Shrink a owl:NamedIndividual , backlog:ChangeDirection ;
    rdfs:label "Shrink"@en ;
    skos:definition "The change removes something previously in scope."@en .

backlog:Disp_Pending a owl:NamedIndividual , backlog:ChangeDisposition ;
    rdfs:label "Pending"@en ; skos:definition "Raised, not yet decided."@en .

backlog:Disp_Accepted a owl:NamedIndividual , backlog:ChangeDisposition ;
    rdfs:label "Accepted"@en ; skos:definition "Decided in favour; a real ScopeChange should follow."@en .

backlog:Disp_Rejected a owl:NamedIndividual , backlog:ChangeDisposition ;
    rdfs:label "Rejected"@en ; skos:definition "Decided against. Retained, not deleted -- a rejected request considered again later without record looks like a new idea rather than a repeat one."@en .

backlog:Disp_Deferred a owl:NamedIndividual , backlog:ChangeDisposition ;
    rdfs:label "Deferred"@en ; skos:definition "Neither accepted nor rejected; revisited at a stated later point or condition."@en .

backlog:Ext_Vendor a owl:NamedIndividual , backlog:ExternalDependencyType ;
    rdfs:label "Vendor"@en ;
    skos:definition "A commercial supplier or hosted service under contract. Changes are negotiated, priced and scheduled by someone else; the realistic lever is the contract, not the backlog."@en .

backlog:Ext_UpstreamComponent a owl:NamedIndividual , backlog:ExternalDependencyType ;
    rdfs:label "Upstream component"@en ;
    skos:definition "A library, framework, dataset, standard or ontology the development consumes but does not own. Changes are proposed to the upstream maintainers; forking is the fallback and is a scope decision in its own right."@en .

backlog:Ext_PeerTeam a owl:NamedIndividual , backlog:ExternalDependencyType ;
    rdfs:label "Peer team"@en ;
    skos:definition "Another team or product inside the same organisation. The most commonly mis-modelled type: organisational proximity tempts teams to write the other team's work into their own backlog, which is exactly the failure the proposal rule prevents."@en .

backlog:Ext_Regulatory a owl:NamedIndividual , backlog:ExternalDependencyType ;
    rdfs:label "Regulatory or standards body"@en ;
    skos:definition "A regulator, certification authority or standards body. Its requirements are inputs, not negotiable scope, and its timelines are almost never responsive to a development's plan."@en .

backlog:Ext_Infrastructure a owl:NamedIndividual , backlog:ExternalDependencyType ;
    rdfs:label "Infrastructure or platform"@en ;
    skos:definition "Hosting, network, identity, build or environment services the development runs on but does not control."@en .

backlog:Ext_Customer a owl:NamedIndividual , backlog:ExternalDependencyType ;
    rdfs:label "Customer or client"@en ;
    skos:definition "Data, decisions, access or acceptance that only the client can supply. Frequently on the critical path and rarely on the plan."@en .

backlog:Prop_Submitted a owl:NamedIndividual , backlog:ProposalStatus ;
    rdfs:label "Submitted"@en ;
    skos:definition "Raised with the owning party, no decision yet. Dependent work stays unstartable."@en .

backlog:Prop_Accepted a owl:NamedIndividual , backlog:ProposalStatus ;
    rdfs:label "Accepted"@en ;
    skos:definition "The owning party has committed to the change. Dependent work becomes startable, and the external delivery becomes a tracked dependency rather than a hope."@en .

backlog:Prop_Rejected a owl:NamedIndividual , backlog:ProposalStatus ;
    rdfs:label "Rejected"@en ;
    skos:definition "The owning party declined. The dependent item must be re-planned, cancelled, or brought into scope through an explicit owner-decided scope change — never left quietly waiting."@en .

backlog:Prop_Withdrawn a owl:NamedIndividual , backlog:ProposalStatus ;
    rdfs:label "Withdrawn"@en ;
    skos:definition "The development withdrew the request, usually because the need disappeared or a workaround was chosen."@en .

backlog:Role_RegisterData a owl:NamedIndividual , backlog:ArtifactRole ;
    rdfs:label "Register data"@en ;
    skos:definition "The backlog, roadmap and blueprint instances — the graph everything else is computed from."@en .

backlog:Role_ProgressReport a owl:NamedIndividual , backlog:ArtifactRole ;
    rdfs:label "Progress report run"@en ;
    skos:definition "A retained roadmap report run, kept as a file rather than a screenful. Progress is a sequence of dated computations, and a package that retains none can show a state but never a trajectory."@en .

backlog:Role_EvidenceIndex a owl:NamedIndividual , backlog:ArtifactRole ;
    rdfs:label "Evidence index"@en ;
    skos:definition "The record of what the execution bridge verified, when, and with which tool."@en .

backlog:Role_Manifest a owl:NamedIndividual , backlog:ArtifactRole ;
    rdfs:label "Manifest"@en ;
    skos:definition "The SHA-256 listing that makes the package verifiable after transport. Exactly one per package."@en .

backlog:Role_ProfileDeclaration a owl:NamedIndividual , backlog:ArtifactRole ;
    rdfs:label "Adoption profile declaration"@en ;
    skos:definition "The file carrying the AdoptionProfile, so a consumer can see which conformance level the package claims before validating it."@en .

backlog:Basis_Measured a owl:NamedIndividual , backlog:EstimationBasisKind ;
    rdfs:label "Measured"@en ;
    skos:definition "Produced by executing something against real artifacts — a trial run, a test drive, a spike, a query over the register itself. Must name the MetricObservation that produced it, so the figure is re-derivable rather than merely asserted to have been measured."@en .

backlog:Basis_Analogous a owl:NamedIndividual , backlog:EstimationBasisKind ;
    rdfs:label "Analogous"@en ;
    skos:definition "Derived from the recorded actuals of comparable completed work. Weaker than measurement because the comparison is a judgement, stronger than pure estimation because the reference figures are real. Should name the items it was drawn from."@en .

backlog:Basis_Judged a owl:NamedIndividual , backlog:EstimationBasisKind ;
    rdfs:label "Judged"@en ;
    skos:definition "Arrived at by expertise and reasoning, with nothing executed. The honest default and the majority case. Recording it as such costs nothing and prevents a judgement being read as a measurement later, when whoever made it is no longer in the room."@en .

backlog:FM_IneffectiveCorrectiveAction a owl:NamedIndividual , backlog:FailureMode ;
    rdfs:label "Ineffective corrective action"@en ;
    backlog:hasModeScope backlog:Scope_Methodology ;
    skos:definition "A work item was asserted via metricMovableBy, reached Done or Cancelled, and the objective's own observation at or after that closure was no better than its observation at or before that item's own start. Checked by comparing two real MetricObservations bracketing the attempt, never by counting how many attempts existed — a single confirmed instance is real evidence regardless of how many other attempts are still open." .

backlog:FM_ScopeCreep a owl:NamedIndividual , backlog:FailureMode ;
    rdfs:label "Scope creep"@en ;
    backlog:hasModeScope backlog:Scope_Methodology ;
    skos:definition "A real work item exists with no path back to the mission's own declared scope — neither through a Goal that derivesFromScope reaching its own pursuesObjective, nor through a real ScopeChange admitting it explicitly. Work a boundary never authorized and nobody recorded admitting." .

backlog:FM_ScopeGap a owl:NamedIndividual , backlog:FailureMode ;
    rdfs:label "Scope gap (a declared deliverable with no work addressing it)"@en ;
    backlog:hasModeScope backlog:Scope_Methodology ;
    skos:definition "The scope names a real deliverable or exclusion boundary and no work item in the register traces back to it at all — the declared boundary is wider than the actual backlog, the reverse failure of scope creep." .

backlog:SM_ConfirmedMovement a owl:NamedIndividual , backlog:SuccessMode ;
    backlog:successMirrorOf backlog:FM_IneffectiveCorrectiveAction ;
    rdfs:label "Confirmed movement"@en ;
    backlog:hasModeScope backlog:Scope_Methodology ;
    skos:definition "The positive mirror of FM_IneffectiveCorrectiveAction: a work item asserted via metricMovableBy reached Done, and the objective's own observation afterward genuinely moved toward target relative to before it started. A real, checkable confirmation that a specific approach worked, worth recording as a pattern rather than only as a passing metric." .

backlog:SM_ExplicitScopeAdmission a owl:NamedIndividual , backlog:SuccessMode ;
    backlog:successMirrorOf backlog:FM_ScopeCreep ;
    rdfs:label "Explicit scope admission"@en ;
    backlog:hasModeScope backlog:Scope_Methodology ;
    skos:definition "New work that fell outside the mission's own original scope was brought in through a real, recorded ScopeChange rather than silently absorbed — the mirror of FM_ScopeCreep, confirming the boundary was kept honest rather than merely not yet violated." .

backlog:Scope_LineageLocal a owl:NamedIndividual , backlog:FindingScope ;
    rdfs:label "Lineage-local"@en ;
    skos:definition "The remedy is a practice this lineage adopts for itself — no shared vocabulary or check is missing, the lineage's own discipline was."@en .

backlog:Scope_Methodology a owl:NamedIndividual , backlog:FindingScope ;
    rdfs:label "Methodology"@en ;
    skos:definition "The remedy is, or should be, a change to the shared framework itself — a missing check, a missing vocabulary term, a real gap every adopting lineage would independently rediscover."@en .

backlog:KickOff_Declared a owl:NamedIndividual , backlog:KickOffMode ;
    rdfs:label "Declared"@en ;
    skos:definition "A person recorded the start. Must name who, through decidedBy."@en .

backlog:KickOff_Triggered a owl:NamedIndividual , backlog:KickOffMode ;
    rdfs:label "Triggered"@en ;
    skos:definition "An automated event recorded the start — a pipeline run, a branch creation, a first commit. Must name the trigger through hasKickOffTrigger so the moment is re-derivable."@en .

backlog:Mode_Human a owl:NamedIndividual , backlog:ExecutionModality ;
    rdfs:label "Human"@en ;
    skos:definition "Carried out by a person. Competes for capacity like any other work, which is the point of recording it: human time is finite and an automated backlog that hides it will over-commit the one resource it cannot scale."@en .

backlog:Mode_Automated a owl:NamedIndividual , backlog:ExecutionModality ;
    rdfs:label "Automated"@en ;
    skos:definition "Carried out by an agent or a pipeline with no person in the execution path. Not a claim that nobody supervised it — supervision is recorded separately as an interaction, precisely so that unsupervised automation is distinguishable from supervised automation."@en .

backlog:Mode_Hybrid a owl:NamedIndividual , backlog:ExecutionModality ;
    rdfs:label "Hybrid"@en ;
    skos:definition "An agent produced the output and a person materially changed it. Distinct from automated-with-review, where the person accepted or rejected but did not author: the two carry different answers to who is responsible for what shipped."@en .

backlog:Sup_InTheLoop a owl:NamedIndividual , backlog:SupervisionMode ;
    rdfs:label "In the loop"@en ;
    skos:definition "The work cannot advance until a person acts. Must be evidenced by a gating interaction recorded before the transition it gates; a claim of in-the-loop supervision with no such interaction is a claim about intentions."@en .

backlog:Sup_OnTheLoop a owl:NamedIndividual , backlog:SupervisionMode ;
    rdfs:label "On the loop"@en ;
    skos:definition "The work advances and a person may intervene afterwards. Weaker than in-the-loop and legitimately so — most automation should be on the loop — but recorded distinctly, because the two are indistinguishable in a register that only says a review happened."@en .

backlog:Sup_None a owl:NamedIndividual , backlog:SupervisionMode ;
    rdfs:label "None"@en ;
    skos:definition "No person supervises this work. The honest option, and the one whose absence from a vocabulary would force unsupervised work to be recorded as though supervised."@en .

backlog:Int_Confirm a owl:NamedIndividual , backlog:InteractionKind ;
    rdfs:label "Confirm"@en ;
    skos:definition "A person permitted the work to proceed. Gating."@en .

backlog:Int_Reject a owl:NamedIndividual , backlog:InteractionKind ;
    rdfs:label "Reject"@en ;
    skos:definition "A person refused the work. Gating, and the one whose complete absence over a long register suggests confirmation is a formality."@en .

backlog:Int_Correct a owl:NamedIndividual , backlog:InteractionKind ;
    rdfs:label "Correct"@en ;
    skos:definition "A person materially changed the output. Implies the item's modality is Hybrid rather than Automated."@en .

backlog:Int_Propose a owl:NamedIndividual , backlog:InteractionKind ;
    rdfs:label "Propose"@en ;
    skos:definition "A person supplied direction the agent did not have."@en .

backlog:Int_Review a owl:NamedIndividual , backlog:InteractionKind ;
    rdfs:label "Review"@en ;
    skos:definition "A person examined the output without deciding or changing it. Not gating; recording it as such is what keeps 'reviewed' from being read as 'approved'."@en .

backlog:Int_Respond a owl:NamedIndividual , backlog:InteractionKind ;
    rdfs:label "Respond"@en ;
    skos:definition "A person answered a question the agent raised."@en .

backlog:L4_LineageEnforced a owl:NamedIndividual , backlog:ConformanceLevel ;
    rdfs:label "L4 Lineage Enforced"@en ;
    skos:definition "L3 plus: the intent chain is complete and connected end to end, every objective carries a measurement rather than an intention, work is groomed to the granularity that can actually be executed, and an iteration connects to what ships. The checks that are advisory at lower levels become violations here. Adopted where a register must PROVE a mission was accomplished rather than report that work was done — the difference being that completion is a fact about effort and accomplishment is a fact about the world, and only the second requires a measurement. Deliberately a separate level and not a promotion inside L3: a level is a claim an adopter makes, and promoting checks inside an existing one would break every adopter who made a different claim."@en .

backlog:Sel_HighestScored a owl:NamedIndividual , backlog:SelectionBasis ;
    dcterms:source "Bagnall, Rayward-Smith & Whittley, The Next Release Problem (2001) — select the subset of highest value subject to constraint"@en ;
    rdfs:label "Highest scored"@en ;
    skos:definition "The highest-scoring deliverable work available at the release boundary. The default a value-driven roadmap should be able to claim, and the only basis under which a passed-over higher score is a defect rather than a choice."@en .

backlog:Sel_Dependency a owl:NamedIndividual , backlog:SelectionBasis ;
    dcterms:source "Carlshamre et al. (2001) and Ngo-The & Ruhe (2008) — value dependencies constrain selection independently of value"@en ;
    rdfs:label "Dependency forced"@en ;
    skos:definition "Lower-scored work taken because higher-scored work depends on it. Value was consulted and overridden by structure, which is legitimate and different from not consulting it."@en .

backlog:Sel_Committed a owl:NamedIndividual , backlog:SelectionBasis ;
    dcterms:source "Release planning practice: a commitment already given is honoured independently of current ranking"@en ;
    rdfs:label "Previously committed"@en ;
    skos:definition "Work carried because it was promised, independently of its current score. Honest, and worth distinguishing: a register where every release reads this way is one where scoring changes nothing."@en .

backlog:Sel_Opportunistic a owl:NamedIndividual , backlog:SelectionBasis ;
    backlog:isFrameworkOriginal "No source found. Release-planning literature names value, dependency and commitment as selection criteria and does NOT name a category for a release that was not a prioritisation decision at all. Declared framework-original rather than attributed to a source it does not have: the category exists because without it such a release must be recorded as though it had been prioritised, and that is the misreport the vocabulary is meant to prevent."@en ;
    rdfs:label "Opportunistic"@en ;
    skos:definition "Whatever happened to be finished. The honest option for a release that was not a prioritisation decision, and the one whose absence from the vocabulary would force such a release to be recorded as though it had been."@en .

backlog:Stage_Assess a owl:NamedIndividual , backlog:AdaptationStage ;
    rdfs:label "Assess"@en ;
    skos:definition "Establish which order the lineage was actually built in, from the link directions rather than from anyone's account of it. A lineage already scope-first needs no adaptation; one asserting both directions must be resolved before anything else, because it currently records no order at all."@en .

backlog:Stage_FitGap a owl:NamedIndividual , backlog:AdaptationStage ;
    rdfs:label "Fit-gap"@en ;
    skos:definition "Compare the standing boundary against the work actually underway and name every item that falls outside it. This is the measurement the ruling depends on, and it is the step a careful reader skips: a boundary drawn around past work usually LOOKS like it still fits, because it was built to."@en .

backlog:Stage_Ruling a owl:NamedIndividual , backlog:AdaptationStage ;
    rdfs:label "Ruling"@en ;
    skos:definition "The owner decides, on the fit-gap evidence, whether the boundary is unchanged or must be rewritten. An owner decision and not a derivation: a gap is a fact, but whether it means the scope was wrong or the work was is a judgement about intent that no query can make."@en .

backlog:Stage_Relink a owl:NamedIndividual , backlog:AdaptationStage ;
    rdfs:label "Re-link"@en ;
    skos:definition "Carry out what the ruling decided, and only then. Under an unchanged boundary the objectives are re-linked forward with fillsScope. Under a rewritten one the new boundary is written first and its goals and objectives are revisited beneath it, because a rewritten scope with the old goals hanging under it is the self-confirming boundary again."@en .

backlog:Adapt_BoundaryHolds a owl:NamedIndividual , backlog:AdaptationOutcome ;
    rdfs:label "Boundary holds"@en ;
    skos:definition "The fit-gap found nothing outside the scope, so the boundary stands and only the link direction changes. Legitimate, and the outcome most likely to be claimed without the measurement: a scope drawn around past work fits that work by construction, so this outcome must rest on a recorded fit-gap and not on inspection."@en .

backlog:Adapt_BoundaryRewritten a owl:NamedIndividual , backlog:AdaptationOutcome ;
    rdfs:label "Boundary rewritten"@en ;
    skos:definition "The fit-gap found work the boundary does not cover, so the scope is rewritten and the lineage beneath it revisited. Requires a ScopeChange recording what was admitted and why."@en .

backlog:Adapt_NotRequired a owl:NamedIndividual , backlog:AdaptationOutcome ;
    rdfs:label "Not required"@en ;
    skos:definition "The lineage was already scope-first. Recorded rather than left silent, so a register can show that adaptation was considered and found unnecessary."@en .

backlog:Kind_InitialDevelopment a owl:NamedIndividual , backlog:InitiativeKind ;
    rdfs:label "Initial development"@en ;
    skos:definition "The first build of a product. Distinguished from every later one because there is no installed base to preserve, no migration to plan and no compatibility to break — the decisions are unconstrained in a way they will never be again. Project scale; produces the first major version."@en ;
    backlog:isFrameworkOriginal "No single converging source found for 'initial development' as a named initiative-kind category, distinct from evolutionary development, at this level of specificity. ISO/IEC/IEEE 14764 and 12207 name maintenance, migration and retirement as distinct processes but do not classify pre-maintenance development into 'initial' versus 'evolutionary' by version-increment size; that split is this framework's own, made to give the version-increment discriminator (major vs minor/patch) something to discriminate between at the initiative level, not only at the task level. Declared framework-original rather than attributed to a source it does not have."@en .

backlog:Kind_EvolutionaryDevelopment a owl:NamedIndividual , backlog:InitiativeKind ;
    rdfs:label "Evolutionary development"@en ;
    skos:definition "A new version built after an earlier one is complete. Still project scale and still a major increment, but constrained where the first build was not: something already exists, is in use, and either has to keep working or has to be migrated deliberately. Calling this maintenance because it touches an existing product is the commonest miscategorisation, and the version increment is what settles it."@en ;
    backlog:isFrameworkOriginal "Same finding as Kind_InitialDevelopment, which this term is the counterpart of: no external source classifies major-version, project-scale work on an existing product as its own initiative kind distinct from maintenance. Declared framework-original rather than attributed to a source it does not have."@en .

backlog:Kind_Migration a owl:NamedIndividual , backlog:InitiativeKind ;
    rdfs:label "Migration"@en ;
    skos:definition "Moving a product to a new environment or platform while preserving its capability. A distinct process in ISO/IEC/IEEE 14764 rather than a maintenance type, and project scale here because it usually forces a major increment: what users can do is unchanged, but what they must do to keep using it is not."@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance, which names migration planning as a distinct maintainer activity outside the four/five maintenance types themselves. Clause number not yet confirmed against the primary paywalled standard text."@en .

backlog:Kind_Retirement a owl:NamedIndividual , backlog:InitiativeKind ;
    rdfs:label "Retirement"@en ;
    skos:definition "Withdrawing a product from service. A 14764 process in its own right, and modelled because a register with no way to say a thing is being switched off records its last release as though it were still alive."@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance, which names retirement planning as a distinct maintainer activity. Clause number not yet confirmed against the primary paywalled standard text."@en .

backlog:Kind_Maintenance a owl:NamedIndividual , backlog:InitiativeKind ;
    rdfs:label "Maintenance"@en ;
    skos:definition "Sustains capability already delivered, per ISO/IEC/IEEE 12207's maintenance process. Smaller in granularity than a project and moves a minor or patch version, never a major — that is the discriminator, and it is a fact about what shipped rather than a judgement about how the work felt. Requires a maintenance category, because 'maintenance' alone conflates fixing what is broken with improving what works."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.13 Maintenance process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Timing_Reactive a owl:NamedIndividual , backlog:MaintenanceTiming ;
    rdfs:label "Reactive"@en ;
    skos:definition "The change answers something that has already occurred — a fault reported, an environment that has already moved."@en .

backlog:Timing_Proactive a owl:NamedIndividual , backlog:MaintenanceTiming ;
    rdfs:label "Proactive"@en ;
    skos:definition "The change anticipates. Nothing has failed and nothing has forced it, which is why proactive work is the first cut when a budget tightens and the reason it must be argued rather than assumed."@en .

backlog:Goal_Correction a owl:NamedIndividual , backlog:MaintenanceGoal ;
    rdfs:label "Correction"@en ;
    skos:definition "Restores behaviour that was already intended. Nothing new is promised."@en .

backlog:Goal_Enhancement a owl:NamedIndividual , backlog:MaintenanceGoal ;
    rdfs:label "Enhancement"@en ;
    skos:definition "Implements a new requirement. 14764: an enhancement is not a software correction — which is why calling an enhancement a fix is the commonest way unbudgeted scope enters a maintenance stream."@en .

backlog:Maint_Corrective a owl:NamedIndividual , backlog:MaintenanceCategory ;
    rdfs:label "Corrective"@en ;
    skos:definition "Reactive correction: modification after delivery to correct discovered problems (14764). Something is broken and has been noticed."@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en .

backlog:Maint_Preventive a owl:NamedIndividual , backlog:MaintenanceCategory ;
    rdfs:label "Preventive"@en ;
    skos:definition "Proactive correction: modification to correct latent faults before they manifest as failures (14764). Nothing has failed yet, which is why this work is chronically deferred."@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en .

backlog:Maint_Adaptive a owl:NamedIndividual , backlog:MaintenanceCategory ;
    rdfs:label "Adaptive"@en ;
    skos:definition "Reactive enhancement: modification to keep the product usable in a changed or changing environment (14764). The world moved; the software has to follow."@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en .

backlog:Maint_Perfective a owl:NamedIndividual , backlog:MaintenanceCategory ;
    rdfs:label "Perfective"@en ;
    skos:definition "Proactive enhancement: modification to provide enhancements for users, or to improve performance, maintainability or other attributes (14764). Nothing forced it."@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance. Clause number not yet confirmed against the primary paywalled standard text; the four classic categories (corrective, adaptive, perfective, preventive) are named at the standard level in every secondary source checked."@en .

backlog:Maint_Additive a owl:NamedIndividual , backlog:MaintenanceCategory ;
    rdfs:label "Additive"@en ;
    skos:definition "14764:2022's optional fifth type: an enhancement that adds function to existing software, distinguished from perfective by changing the existing product rather than improving its qualities. Offered because the standard names it; an adopter using only the classic four is conformant."@en ;
    dcterms:source "ISO/IEC/IEEE 14764:2022, Software engineering — Software life cycle processes — Maintenance, third edition. Additive is specifically the 2022 revision's own addition to the four classic types named in the 1999/2006 editions; confirmed via web search of secondary sources describing the 2022 edition, not against the primary paywalled standard text."@en .

backlog:Ver_Major a owl:NamedIndividual , backlog:VersionIncrement ;
    rdfs:label "Major"@en ;
    skos:definition "Breaking change or a new product generation. Project scale by definition — if a piece of work forces one, calling it maintenance is wrong regardless of how small it looked."@en .

backlog:Ver_Minor a owl:NamedIndividual , backlog:VersionIncrement ;
    rdfs:label "Minor"@en ;
    skos:definition "Backwards-compatible addition. The normal increment for additive and adaptive maintenance."@en .

backlog:Ver_Patch a owl:NamedIndividual , backlog:VersionIncrement ;
    rdfs:label "Patch"@en ;
    skos:definition "Backwards-compatible fix, no vocabulary or interface change. The normal increment for corrective and preventive maintenance."@en .

backlog:Ver_None a owl:NamedIndividual , backlog:VersionIncrement ;
    rdfs:label "None"@en ;
    skos:definition "Ships nothing versioned. The honest answer for an initiative that never reaches users — a spike, an investigation, a retirement of something already dark — and its absence from the vocabulary would force such work to claim an increment it did not produce."@en .

backlog:Origin_OwnerStated a owl:NamedIndividual , backlog:MissionOrigin ;
    rdfs:label "Owner stated"@en ;
    skos:definition "The owner supplied the words. The only origin under which a mission is evidence of intent rather than a record of what was built."@en .

backlog:Origin_SessionDrafted a owl:NamedIndividual , backlog:MissionOrigin ;
    rdfs:label "Session drafted"@en ;
    skos:definition "A session wrote the statement, whoever it was attributed to. Legitimate as a working artifact and dangerous as a source: a session drafting a mission after the work exists writes a summary of that work, and a summary cannot contradict its source."@en .

backlog:Origin_Derived a owl:NamedIndividual , backlog:MissionOrigin ;
    rdfs:label "Derived"@en ;
    skos:definition "Restated from a document outside the register — a charter, a contract, a standard. Traceable to something, which is what separates it from a session draft."@en .

backlog:Concern_Data a owl:NamedIndividual , backlog:DesignConcern ;
    rdfs:label "Data"@en ;
    skos:definition "What persists, and its structure. Applies wherever a story creates, changes or retires stored state — the concern whose omission is cheapest to skip and most expensive to correct, because a schema in use is difficult to change."@en ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'designing databases' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en .

backlog:Concern_Interface a owl:NamedIndividual , backlog:DesignConcern ;
    rdfs:label "Interface"@en ;
    skos:definition "How the system is reached from outside: an API, a message contract, a file exchange. Applies wherever a story changes what another system may rely on."@en ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'designing system interfaces' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en .

backlog:Concern_Interaction a owl:NamedIndividual , backlog:DesignConcern ;
    rdfs:label "Interaction"@en ;
    skos:definition "How a person uses the capability. Applies wherever a story changes what a user does, as distinct from what the system stores or exposes."@en ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'designing the user interface' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en .

backlog:Concern_Architecture a owl:NamedIndividual , backlog:DesignConcern ;
    rdfs:label "Architecture"@en ;
    skos:definition "Where the capability sits in the system's structure, and what it depends on. Applies wherever a story introduces a component, a dependency or a deployment boundary."@en ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'architectural design' activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en .

backlog:Concern_Security a owl:NamedIndividual , backlog:DesignConcern ;
    rdfs:label "Security"@en ;
    skos:definition "Who may do this, and what it exposes. Applies wherever a story touches identity, authorisation or data a policy governs."@en ;
    backlog:isFrameworkOriginal "The parent class borrows its five-way split from Satzinger et al. ch.6, whose 'controls and security' design activity is the nearest named counterpart. No single converging seminal source was found for this concern at the level defined here: the source describes an activity performed once for a system, not a per-story analysis criterion a backlog item is checked against. Declared framework-original at this level of specificity rather than attributed to a source it does not have."@en .

backlog:Task_MissionAnalysis a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Mission analysis"@en ;
    skos:definition "6.4.1 Business or mission analysis. Establishes what problem is being solved and why, before any solution is described. The process the owner called domain engineering: it defines the problem space, and a task here produces understanding rather than a component."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.1 Business or mission analysis process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_StakeholderNeeds a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Stakeholder needs and requirements"@en ;
    skos:definition "6.4.2. Turns what people need into stated stakeholder requirements. Distinct from the next process because a stakeholder requirement says what someone needs, and a system requirement says what the system must therefore do — conflating them is how solutions get written into problems."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.2 Stakeholder needs and requirements definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_RequirementsDefinition a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "System/software requirements definition"@en ;
    skos:definition "6.4.3. States what the system must do to meet the stakeholder requirements. The owner's business analysis sits across this and the previous process."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.3 System requirements definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_ArchitectureDefinition a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Architecture definition"@en ;
    skos:definition "6.4.4. Establishes the structure: components, their responsibilities, and the boundaries between them. Separate from design definition because architecture fixes what may not change cheaply later."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.4 System architecture definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_DesignDefinition a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Design definition"@en ;
    skos:definition "6.4.5. Provides detail sufficient to implement, within the architecture. Where the five DesignConcerns are analysed."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.5 Design definition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_SystemAnalysis a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "System analysis"@en ;
    skos:definition "6.4.6. Analytical work supporting a decision — trade studies, feasibility, performance modelling. The owner's technical analysis. Named separately because it produces a decision and its rationale, not a component, and is otherwise recorded as design or lost."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.6 System analysis process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_Implementation a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Implementation"@en ;
    skos:definition "6.4.7. Builds the element. The task type most registers record and often the only one, which is why a backlog can look full while every other process is invisible."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.7 Implementation process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_Integration a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Integration"@en ;
    skos:definition "6.4.8. Assembles elements into a working whole. Distinct from implementation: a set of correct parts that do not compose is the failure this process exists to catch."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.8 Integration process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_Verification a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Verification"@en ;
    skos:definition "6.4.9. Confirms the element meets its specified requirements — was it built right. Half of the owner's testing."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.9 Verification process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_Validation a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Validation"@en ;
    skos:definition "6.4.11. Confirms the element serves its intended use in its intended environment — was the right thing built. The other half of testing, and the one skipped when verification passes and nobody asks whether the requirement was correct."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.11 Validation process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_Transition a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Transition"@en ;
    skos:definition "6.4.10. Moves the element into operation: deployment, migration, cutover, training. The owner's deployment."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.10 Transition process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_Operation a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Operation"@en ;
    skos:definition "6.4.12. Runs the system in service."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.12 Operation process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_MaintenanceTask a owl:NamedIndividual , backlog:TaskType ;
    backlog:initiativeLevelCounterpart backlog:Kind_Maintenance ;
    rdfs:label "Maintenance"@en ;
    skos:definition "6.4.13. Sustains the delivered capability. The task-level counterpart of Kind_Maintenance at initiative level."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.13 Maintenance process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Task_Disposal a owl:NamedIndividual , backlog:TaskType ;
    rdfs:label "Disposal"@en ;
    skos:definition "6.4.14. Retires the element and deals with what it leaves behind."@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, clause 6.4.14 Disposal process. Clause number confirmed via web search of secondary sources, not against the primary paywalled standard text; needs final confirmation by a holder of standard's-body access."@en .

backlog:Concern_Data          backlog:coversTaskType backlog:Task_DesignDefinition .

backlog:Concern_Interface     backlog:coversTaskType backlog:Task_DesignDefinition , backlog:Task_Integration .

backlog:Concern_Interaction   backlog:coversTaskType backlog:Task_DesignDefinition , backlog:Task_Validation .

backlog:Concern_Architecture  backlog:coversTaskType backlog:Task_ArchitectureDefinition .

backlog:Concern_Security      backlog:coversTaskType backlog:Task_DesignDefinition , backlog:Task_Verification .

backlog:Role_SystemsAnalyst a owl:NamedIndividual , backlog:TeamRole ;
    rdfs:label "Systems analyst"@en ;
    skos:definition "Elicits and states requirements, and carries the stakeholder-needs and requirements-definition work. Named because a register that records only builders cannot show who established what was to be built."@en ;
    backlog:hasRoleSource "Satzinger, Jackson & Burd, Systems Analysis and Design in a Changing World" .

backlog:Role_DesignAuthority a owl:NamedIndividual , backlog:TeamRole ;
    rdfs:label "Design authority"@en ;
    skos:definition "Holds the design decisions a story must not silently contradict. Distinct from an architect: the authority owns consistency across decisions already taken, not the structure itself."@en ;
    backlog:hasRoleSource "Satzinger, Jackson & Burd, ch.6" .

backlog:Role_Architect a owl:NamedIndividual , backlog:TeamRole ;
    rdfs:label "Architect"@en ;
    skos:definition "Owns the structure and the boundaries that cannot change cheaply later — the architecture-definition process."@en ;
    backlog:hasRoleSource "ISO/IEC/IEEE 42010 architecture description" .

backlog:Role_HCIResearcher a owl:NamedIndividual , backlog:TeamRole ;
    rdfs:label "HCI researcher"@en ;
    skos:definition "Establishes how a person will use the capability, and whether they can. The interaction concern's counterpart in people rather than artefacts."@en ;
    backlog:hasRoleSource "ISO 9241-210 human-centred design for interactive systems" .

backlog:Role_Tester a owl:NamedIndividual , backlog:TeamRole ;
    rdfs:label "Tester"@en ;
    skos:definition "Performs verification and validation. ISO/IEC/IEEE 29119-3 names this role plainly; the framework uses the standard's word rather than a house term, because a role named differently in every register cannot be compared across two."@en ;
    backlog:hasRoleSource "ISO/IEC/IEEE 29119-3 test documentation" .

backlog:Role_TestManager a owl:NamedIndividual , backlog:TeamRole ;
    rdfs:label "Test manager"@en ;
    skos:definition "Owns the test approach and its completion criteria, as distinct from performing tests."@en ;
    backlog:hasRoleSource "ISO/IEC/IEEE 29119-3" .

backlog:IOrigin_OwnerStated a owl:NamedIndividual , backlog:IntentOrigin ;
    rdfs:label "Owner stated"@en ;
    skos:definition "The owner supplied the words. The only origin under which an intent element is evidence of intent rather than a record of what was built."@en .

backlog:IOrigin_SessionDrafted a owl:NamedIndividual , backlog:IntentOrigin ;
    rdfs:label "Session drafted"@en ;
    skos:definition "A session wrote it, whoever it was attributed to. Legitimate as a working artifact and dangerous as a source: a session drafting intent for work it is already doing writes a summary of that work, and a summary cannot contradict its source."@en .

backlog:IOrigin_Derived a owl:NamedIndividual , backlog:IntentOrigin ;
    rdfs:label "Derived"@en ;
    skos:definition "Restated from something outside the register — a charter, a standard, or the element above it in the chain. Traceable, which is what separates it from a session draft."@en .

backlog:Sup_None backlog:requiresIndependentEvidence true .

backlog:Sup_InTheLoop backlog:requiresIndependentEvidence false .

backlog:Sup_OnTheLoop backlog:requiresIndependentEvidence false .

backlog:Stage_Mission a owl:NamedIndividual , backlog:LineageStage ;
    rdfs:label "Mission stage"@en ;
    skos:definition "The mission is stated. Nothing below it exists yet."@en .

backlog:Stage_Scope a owl:NamedIndividual , backlog:LineageStage ;
    rdfs:label "Scope stage"@en ;
    skos:definition "The boundary and its deliverables and exclusions are written, against a mission that already exists and no goal that does not."@en .

backlog:Stage_Goal a owl:NamedIndividual , backlog:LineageStage ;
    rdfs:label "Goal stage"@en ;
    skos:definition "Goals are derived from the scope. Objectives do not exist yet."@en .

backlog:Stage_Objective a owl:NamedIndividual , backlog:LineageStage ;
    rdfs:label "Objective stage"@en ;
    skos:definition "Objectives are set to measure the goals, with baselines taken before any work is chosen."@en .

backlog:Stage_Backlog a owl:NamedIndividual , backlog:LineageStage ;
    rdfs:label "Backlog stage"@en ;
    skos:definition "Work items are chosen against deliverables that already exist."@en .

backlog:Stage_Scope     backlog:stagePredecessor backlog:Stage_Mission .

backlog:Stage_Goal      backlog:stagePredecessor backlog:Stage_Scope .

backlog:Stage_Objective backlog:stagePredecessor backlog:Stage_Goal .

backlog:Stage_Backlog   backlog:stagePredecessor backlog:Stage_Objective .

backlog:Cat_Structure a owl:NamedIndividual , backlog:ModelCategory ;
    rdfs:label "Structure"@en ;
    skos:definition "What the system is: its parts and their arrangement."@en .

backlog:Cat_Behaviour a owl:NamedIndividual , backlog:ModelCategory ;
    rdfs:label "Behaviour"@en ;
    skos:definition "What the system does: its dynamics over time."@en .

backlog:Kind_ClassDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Class diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_ObjectDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Object diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_PackageDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Package diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_CompositeStructure a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Composite structure diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_ComponentDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Component diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_DeploymentDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Deployment diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_ProfileDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Profile diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Structure .

backlog:Kind_UseCaseDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Use case diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_ActivityDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Activity diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_StateMachineDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "State machine diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_SequenceDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Sequence diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_CommunicationDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Communication diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_TimingDiagram a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Timing diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Kind_InteractionOverview a owl:NamedIndividual , backlog:ModelKind ;
    rdfs:label "Interaction overview diagram"@en ;
    backlog:hasModelCategory backlog:Cat_Behaviour .

backlog:Facing_Mission a owl:NamedIndividual , backlog:GoalFacing ;
    rdfs:label "Mission-facing"@en ;
    skos:definition "Holds when the mission's own condition is true, independently of how much of the scope was done. This is the goal that catches an insufficient boundary: if every area finishes and this goal is still unmet, the scope was wrong."@en .

backlog:Facing_Scope a owl:NamedIndividual , backlog:GoalFacing ;
    rdfs:label "Scope-facing"@en ;
    skos:definition "Holds when every area the scope names has reached its finish condition. This is the goal that catches abandonment: a mission-facing goal can read met because the easy half was done."@en .

backlog:Facing_Containment a owl:NamedIndividual , backlog:GoalFacing ;
    rdfs:label "Containment-facing"@en ;
    skos:definition "Holds when no work was done outside the areas the scope names. Without it a lineage can reach its mission and its scope while spending effort nobody asked for, and the register reports success — redundant work is invisible to any measure that only counts what was required."@en .

backlog:Layer_Product a owl:NamedIndividual , backlog:ScopeLayer ;
    rdfs:label "Product layer"@en ;
    skos:definition "What functionality is or is not implemented. Answers: will the delivered thing do this?"@en .

backlog:Layer_Work a owl:NamedIndividual , backlog:ScopeLayer ;
    rdfs:label "Work layer"@en ;
    skos:definition "Which work is or is not done. Answers: will effort go here? A capability may be in the product scope while the work to build it sits outside this project's work scope — bought, inherited, or deferred."@en .

backlog:Kind_Functional a owl:NamedIndividual , backlog:ProductScopeKind ;
    rdfs:label "Functional"@en ;
    skos:definition "The deliverable names a capability the artifact has. Answers: does it do this?"@en .

backlog:Kind_NonFunctional a owl:NamedIndividual , backlog:ProductScopeKind ;
    rdfs:label "Non-functional"@en ;
    skos:definition "The deliverable names a quality the artifact exhibits while it does what it does — how reliably, transparently, or safely, not what. Answers: does it do this well?"@en .

backlog:Facing_Exclusion a owl:NamedIndividual , backlog:GoalFacing ;
    rdfs:label "Exclusion-facing"@en ;
    skos:definition "An INVERSE GOAL: it states what must not happen and is met by absence. Distinct from containment-facing, which asks whether work stayed inside the areas — an inverse goal names a specific thing the scope refused and can be measured against, so a preventive mechanism has something to attach to. PMBOK calls explicit exclusions the principal safeguard against scope creep; an exclusion nothing measures is a sentence rather than a safeguard."@en ;
    dcterms:source "PMBOK: project exclusions as the safeguard against scope creep"@en .

backlog:Meas_Counted a owl:NamedIndividual , backlog:MeasurementKind ;
    rdfs:label "Counted"@en ;
    skos:definition "Obtained by counting artefacts anyone can count: files, triples, rulings. Reproducible without trusting the counter."@en .

backlog:Meas_Derived a owl:NamedIndividual , backlog:MeasurementKind ;
    rdfs:label "Derived"@en ;
    skos:definition "Computed by a named query over the register. Reproducible if the query is shipped, which is why the query must be."@en .

backlog:Meas_Judged a owl:NamedIndividual , backlog:MeasurementKind ;
    rdfs:label "Judged"@en ;
    skos:definition "A person decided. Legitimate, and the weakest of the three: it cannot be reproduced, only agreed with or disputed."@en .

backlog:Dir_Hold a owl:NamedIndividual , backlog:MetricDirection ;
    owl:differentFrom backlog:Dir_Decrease ;
    rdfs:label "Hold"@en ;
    skos:definition "The value must not move from its baseline. Used by an inverse goal, whose objective is a ceiling rather than a trajectory: the count of things that should not happen must stay where it is. Distinct from Dir_Decrease with a target already reached, which claims an improvement that never occurred."@en .

#  The 18 individuals of the LAYERS table itself (v1.66.0, moved here from
#  this package's own internal register). code-abundance-rdodi found, by
#  running backlog_lineage_completeness_v1_1_0.py against its own register
#  and reproducing the failure directly, that these lived only in this
#  package's internal working register -- 01-ontologies/backlog_tbox_v*.ttl
#  is the only path the tool's own glob ever searches, so no adopter's
#  register could ever supply them, and the tool was unusable by anyone but
#  this package itself. Not proposed as a fix by the finding session (B1);
#  the fix is this move, matching where DesignConcern's and TaskType's own
#  enumerated members already live -- shared vocabulary belongs in the
#  shared TBox, not this package's own private data.
#
#  MetricObservation's own layerTier corrected from L2 to L4 in the same
#  move: the same session found this by direct comparison against
#  MetricObservationShape's own real severity in backlog_shacl_v1_72_0.ttl,
#  disclosed as the one tier byte-for-byte re-verified, not all 18 --
#  re-confirmed here against the current shapes file before correcting,
#  not taken on the finding alone. The other 17 tiers are carried over
#  unchanged: a full audit of each against its own real enforcing shape is
#  real, separate work this pass did not do, not a check that quietly
#  passed.
backlog:Layer_Mission a backlog:LineageLayer ;
    backlog:layerClass backlog:Mission ; backlog:layerOrdinal 1 ;
    backlog:layerAbsenceCost "No stated purpose; every goal below is asserted rather than argued." ;
    backlog:layerLabel "Mission" ; backlog:layerTier "L2" .

backlog:Layer_ScopeStatement a backlog:LineageLayer ;
    backlog:layerClass backlog:ScopeStatement ; backlog:layerOrdinal 2 ;
    backlog:layerAbsenceCost "No boundary; the backlog defines what was wanted." ;
    backlog:layerLabel "ScopeStatement" ; backlog:layerTier "L2" .

backlog:Layer_ScopeExclusion a backlog:LineageLayer ;
    backlog:layerClass backlog:ScopeExclusion ; backlog:layerOrdinal 3 ;
    backlog:layerAbsenceCost "Nothing refused; the boundary admits whatever is proposed." ;
    backlog:layerLabel "ScopeExclusion" ; backlog:layerTier "L2" .

backlog:Layer_ScopeDeliverable a backlog:LineageLayer ;
    backlog:layerClass backlog:ScopeDeliverable ; backlog:layerOrdinal 4 ;
    backlog:layerAbsenceCost "No content; coverage is computed over the work that exists." ;
    backlog:layerLabel "ScopeDeliverable" ; backlog:layerTier "L3" .

backlog:Layer_Goal a backlog:LineageLayer ;
    backlog:layerClass backlog:Goal ; backlog:layerOrdinal 5 ;
    backlog:layerAbsenceCost "Nothing derives the objectives; they measure whatever was convenient." ;
    backlog:layerLabel "Goal" ; backlog:layerTier "L2" .

backlog:Layer_Objective a backlog:LineageLayer ;
    backlog:layerClass backlog:Objective ; backlog:layerOrdinal 6 ;
    backlog:layerAbsenceCost "No measure; completion rests on judgement." ;
    backlog:layerLabel "Objective" ; backlog:layerTier "L2" .

backlog:Layer_MetricObservation a backlog:LineageLayer ;
    backlog:layerClass backlog:MetricObservation ; backlog:layerOrdinal 7 ;
    backlog:layerAbsenceCost "No reading; the objective can only be asserted met." ;
    backlog:layerLabel "MetricObservation" ; backlog:layerTier "L4" .

backlog:Layer_DefinitionOfDone a backlog:LineageLayer ;
    backlog:layerClass backlog:DefinitionOfDone ; backlog:layerOrdinal 8 ;
    backlog:layerAbsenceCost "No completion standard; Done means whoever said so." ;
    backlog:layerLabel "DefinitionOfDone" ; backlog:layerTier "L2" .

backlog:Layer_Epic a backlog:LineageLayer ;
    backlog:layerClass backlog:Epic ; backlog:layerOrdinal 9 ;
    backlog:layerAbsenceCost "No theme; stories answer to nothing above them." ;
    backlog:layerLabel "Epic/Feature" ; backlog:layerTier "L2" .

backlog:Layer_Story a backlog:LineageLayer ;
    backlog:layerClass backlog:Story ; backlog:layerOrdinal 10 ;
    backlog:layerAbsenceCost "No user-facing slice; work is tasks with no stated value." ;
    backlog:layerLabel "Story" ; backlog:layerTier "L2" .

backlog:Layer_ExecutionTask a backlog:LineageLayer ;
    backlog:layerClass backlog:ExecutionTask ; backlog:layerOrdinal 11 ;
    backlog:layerAbsenceCost "No executable step; a story is a wish." ;
    backlog:layerLabel "ExecutionTask" ; backlog:layerTier "L2" .

backlog:Layer_PlanningEvent a backlog:LineageLayer ;
    backlog:layerClass backlog:PlanningEvent ; backlog:layerOrdinal 12 ;
    backlog:layerAbsenceCost "No record of commitment; work appears in an iteration unexplained." ;
    backlog:layerLabel "PlanningEvent" ; backlog:layerTier "L3" .

backlog:Layer_Iteration a backlog:LineageLayer ;
    backlog:layerClass backlog:Iteration ; backlog:layerOrdinal 13 ;
    backlog:layerAbsenceCost "No time box; cadence is unmeasurable." ;
    backlog:layerLabel "Iteration" ; backlog:layerTier "L2" .

backlog:Layer_Milestone a backlog:LineageLayer ;
    backlog:layerClass backlog:Milestone ; backlog:layerOrdinal 14 ;
    backlog:layerAbsenceCost "No external commitment; slippage is invisible to anyone outside." ;
    backlog:layerLabel "Milestone" ; backlog:layerTier "L3" .

backlog:Layer_CrossCuttingInvariant a backlog:LineageLayer ;
    backlog:layerClass backlog:CrossCuttingInvariant ; backlog:layerOrdinal 15 ;
    backlog:layerAbsenceCost "No standing condition; each release re-argues the same rules." ;
    backlog:layerLabel "CrossCuttingInvariant" ; backlog:layerTier "L3" .

backlog:Layer_CostEstimate a backlog:LineageLayer ;
    backlog:layerClass backlog:CostEstimate ; backlog:layerOrdinal 16 ;
    backlog:layerAbsenceCost "No effort claim; capacity cannot be checked." ;
    backlog:layerLabel "CostEstimate" ; backlog:layerTier "L3" .

backlog:Layer_Evidence a backlog:LineageLayer ;
    backlog:layerClass backlog:Evidence ; backlog:layerOrdinal 17 ;
    backlog:layerAbsenceCost "No proof; Done is a claim." ;
    backlog:layerLabel "Evidence" ; backlog:layerTier "L2" .

backlog:Layer_Forecast a backlog:LineageLayer ;
    backlog:layerClass backlog:Forecast ; backlog:layerOrdinal 18 ;
    backlog:layerAbsenceCost "No projection; the future is unstated." ;
    backlog:layerLabel "Forecast" ; backlog:layerTier "L3" .

backlog:Table_Classification a owl:NamedIndividual , backlog:TableKind ;
    rdfs:label "Classification"@en ;
    skos:definition "States what something IS — which task types exist, which metrics respond to population, which stages a pipeline has. Belongs in the ontology: an adopter cannot extend it by editing a script they do not ship."@en .

backlog:Table_Operational a owl:NamedIndividual , backlog:TableKind ;
    rdfs:label "Operational"@en ;
    skos:definition "States how the tooling runs — paths, globs, file extensions, which directories a build drops. Belongs in the script: it describes the script's own behaviour, and moving it to the ontology would make the ontology answer questions about builds rather than about work."@en .

#  Stage content, exported from the pipeline verifier.
backlog:Stage_Mission backlog:stageRequiresType backlog:Mission .

backlog:Stage_Scope backlog:stageRequiresType backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable .

backlog:Stage_Goal backlog:stageRequiresType backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal .

backlog:Stage_Objective backlog:stageRequiresType backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective .

backlog:Stage_Backlog backlog:stageRequiresType backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective , backlog:Initiative , backlog:Epic , backlog:Story , backlog:ExecutionTask .

backlog:Polarity_Positive a owl:NamedIndividual , backlog:FixturePolarity ;
    rdfs:label "Positive"@en ;
    skos:definition "The fixture is expected to validate with no violation. A positive fixture that fails is a regression."@en .

backlog:Polarity_Negative a owl:NamedIndividual , backlog:FixturePolarity ;
    rdfs:label "Negative"@en ;
    skos:definition "The fixture is expected to be rejected. A negative fixture that PASSES is the more dangerous failure: it means the clause it was built to prove no longer fires."@en .

backlog:Scen_Nominal a owl:NamedIndividual , backlog:ScenarioKind ;
    rdfs:label "Nominal"@en ;
    skos:definition "The expected path with expected input. Proves the feature works and nothing else."@en .

backlog:Scen_Boundary a owl:NamedIndividual , backlog:ScenarioKind ;
    rdfs:label "Boundary"@en ;
    skos:definition "The edge of the allowed range. Proves the feature stops where it should."@en .

backlog:Scen_Rejection a owl:NamedIndividual , backlog:ScenarioKind ;
    rdfs:label "Rejection"@en ;
    skos:definition "Input the feature must refuse. Proves a constraint fires — the case a negative fixture exists for."@en .

backlog:Scen_Absent a owl:NamedIndividual , backlog:ScenarioKind ;
    rdfs:label "Absent"@en ;
    skos:definition "Nothing to work with: an empty set, a missing file, an unpopulated graph. Proves the feature fails loudly rather than silently returning nothing — the case that caught a malformed FILTER reporting zero violations and zero warnings."@en .

backlog:Num_Derived a owl:NamedIndividual , backlog:NumberOrigin ;
    rdfs:label "Derived"@en ;
    skos:definition "Computable from other data in the register. Must ship its query, or it is an assertion wearing a derivation's clothes."@en .

backlog:Num_Asserted a owl:NamedIndividual , backlog:NumberOrigin ;
    rdfs:label "Asserted"@en ;
    skos:definition "A judgement someone recorded. Legitimate and the weakest: it cannot be recomputed, only disputed. Two asserted numbers agreeing with each other is the defect that let an iteration hold fifteen points while declaring nine."@en .

backlog:Num_Measured a owl:NamedIndividual , backlog:NumberOrigin ;
    rdfs:label "Measured"@en ;
    skos:definition "Taken from outside the register — a commit timestamp, a file count, a clock. Re-takeable by anyone with the same source, which is what distinguishes it from an assertion."@en .

backlog:Ach_Withdrawn a owl:NamedIndividual , backlog:AchievementStatus ;
    rdfs:label "Withdrawn"@en ;
    skos:definition "The objective was retired because it measured the wrong thing — normally a superseded mission's progress. Used in this register since v1.82.0 and never declared until v1.128.0, which is a term in use sitting outside its own closed enumeration."@en .

backlog:Ach_Retrospective a owl:NamedIndividual , backlog:AchievementStatus ;
    rdfs:label "Retrospective"@en ;
    skos:definition "The objective measures a fact about finished work and cannot move: the event it counts already happened. Distinct from Withdrawn, which says the measure was wrong — retrospective says it was right and can now only report. A retrospective objective must never read Met by having its number adjusted; it reads what it read, permanently."@en .

backlog:Out_InFlight a owl:NamedIndividual , backlog:MissionOutcome ;
    rdfs:label "In flight"@en ;
    skos:definition "Work continues. The default, and the only state in which a mission belongs in the live register."@en .

backlog:Out_Achieved a owl:NamedIndividual , backlog:MissionOutcome ;
    rdfs:label "Achieved"@en ;
    skos:definition "Every goal is reached or has a status saying why it no longer steers. A mission may only reach this state when NO goal is left unreached and unexplained — a lineage carrying a live unmet goal is not finished, it is stalled, and retiring it would bury the reason."@en .

backlog:Out_Abandoned a owl:NamedIndividual , backlog:MissionOutcome ;
    rdfs:label "Abandoned"@en ; skos:altLabel "Cancelled"@en ;
    skos:definition "Work stopped without the goals being reached, and the reason is recorded. Named so that abandonment is a decision with an author rather than a lineage that quietly stopped being mentioned."@en .

backlog:Aud_Public a owl:NamedIndividual , backlog:ModuleAudience ;
    rdfs:label "Public"@en ;
    skos:definition "The module may be published: a public copy of the package keeps it."@en .
backlog:Aud_Private a owl:NamedIndividual , backlog:ModuleAudience ;
    rdfs:label "Private"@en ;
    skos:definition "The module is correspondence, an adopter's own material or a retired record: a public copy of the package leaves it out."@en .

backlog:CScope_Lineage a owl:NamedIndividual , backlog:ContainerScope ;
    rdfs:label "Lineage-scoped"@en ;
    skos:definition "Serves one lineage and archives with it."@en .

backlog:CScope_Framework a owl:NamedIndividual , backlog:ContainerScope ;
    rdfs:label "Framework-scoped"@en ;
    skos:definition "Serves the framework across lineages and stays live. The Register is the case that forces this to exist: a register that archives with its contents cannot be read."@en .

backlog:Snapshot_Current a owl:NamedIndividual , backlog:ShapeSnapshot ;
    rdfs:label "Current"@en ; skos:definition "The shapes file currently shipping, being checked."@en .

backlog:Snapshot_Baseline a owl:NamedIndividual , backlog:ShapeSnapshot ;
    rdfs:label "Baseline"@en ; skos:definition "The last genuinely published shapes file, compared against."@en .

backlog:FM_LineageBypass a owl:NamedIndividual , backlog:FailureMode ;
    backlog:concernsStage backlog:Stage_Backlog ;
    rdfs:label "Lineage bypass"@en ;
    backlog:hasModeScope backlog:Scope_Methodology ;
    skos:definition "Work items of a lineage first appear in the governed repository before the lineage's own Stage_Backlog output does (or stage outputs appear out of pipeline order), so the chain that claims to have produced the work was written after it. Confirmed by git first-appearance commits, never by the register's own dates, which the author controls. Distinct from the single-commit case, where order is merely unwitnessed."@en .

backlog:Scale_Isolated a owl:NamedIndividual , backlog:FindingScale ; rdfs:label "Isolated"@en ;
    skos:definition "One small defect; a maintenance task or a change request under a live lineage is enough. The closed lineage is not reopened."@en .

backlog:Scale_Bounded a owl:NamedIndividual , backlog:FindingScale ; rdfs:label "Bounded"@en ;
    skos:definition "A substantial but contained piece; descoped from the closed lineage into a successor by the division ceremony."@en .

backlog:Scale_Systemic a owl:NamedIndividual , backlog:FindingScale ; rdfs:label "Systemic"@en ;
    skos:definition "Wide non-conformance across the lineage's work; the only scale that justifies reactivation, after which the lineage is bound by current rules."@en .

backlog:Reason_ImproperProcessing a owl:NamedIndividual , backlog:ReactivationReason ; rdfs:label "Improper processing result"@en .

backlog:Reason_UnfinishedWork a owl:NamedIndividual , backlog:ReactivationReason ; rdfs:label "Unfinished work"@en .

backlog:Reason_NonConformantResult a owl:NamedIndividual , backlog:ReactivationReason ; rdfs:label "Non-conformant result"@en .

backlog:FM_LineageThrash a owl:NamedIndividual , backlog:FailureMode ;
    rdfs:label "Lineage thrash"@en ;
    backlog:hasModeScope backlog:Scope_Methodology ;
    skos:definition "Successive bypass/restart trials on one lineage are not converging: a new bypass names no item an earlier one did not, or a rebuild's admissions are undone by the next trial, or a restart was not deliberated in a separate commit. Decided from the record of the trials, never from how many there were."@en .

backlog:Thrash_NoNovelty a owl:NamedIndividual , backlog:ThrashKind ;
    rdfs:label "No novelty"@en ;
    skos:definition "Every item the new bypass names was already named by an earlier bypass on the same lineage: the same finding again."@en .

backlog:Thrash_AdmissionLost a owl:NamedIndividual , backlog:ThrashKind ;
    rdfs:label "Admission lost"@en ;
    skos:definition "An item a rebuild admitted is bypassed again, or the output that admitted it is retracted with no re-admission: work lost in the loop."@en .

backlog:Thrash_NotDeliberated a owl:NamedIndividual , backlog:ThrashKind ;
    rdfs:label "Not deliberated"@en ;
    skos:definition "The restart, or the rebuilt Mission output, first appears in git in the same commit as the finding it answers: no separate act of deciding is witnessed."@en .

backlog:Strat_DecreaseByOne a owl:NamedIndividual , backlog:RecoveryStrategy ;
    rdfs:label "Decrease by one"@en ;
    skos:definition "Each trial admits at least one item the previous trial left unadmitted, and its bypass names at least one item no earlier bypass named. The default; tested by RestartRequiresNoveltyShape and RestartKeepsAdmissionsShape."@en .

backlog:Strat_DecreaseByFactor a owl:NamedIndividual , backlog:RecoveryStrategy ;
    rdfs:label "Decrease by a constant factor"@en ;
    skos:definition "Each trial admits at least half of what the previous trial left unadmitted (reductionObserved >= 0.5, computed by the order check from the register, never hand-written). Converges in logarithmically many trials."@en .

backlog:Strat_VariableDecrease a owl:NamedIndividual , backlog:RecoveryStrategy ;
    rdfs:label "Variable-size decrease"@en ;
    skos:definition "Each trial records the fraction it reduced (reductionObserved); the trial after it must reduce by no less. The reduction is the lineage's own measurement, and a shrinking reduction is the stop -- the same rule IneffectiveCorrectiveAttemptAdvisoryShape applies to objectives."@en .

backlog:Strat_DivideAndConquer a owl:NamedIndividual , backlog:RecoveryStrategy ;
    backlog:concernsStage backlog:Stage_Backlog ;
    rdfs:label "Divide and conquer"@en ;
    skos:definition "The bypassed lineage is partitioned into part lineages (parentLineage), one per scope deliverable its items satisfy; each part is rebuilt and converges on its own, a thrash freezes only its part, and the parent's rebuilt Stage_Backlog output combines (combinesOutput) every part's active Stage_Backlog output. Right for a lineage too large to restart as one."@en .

backlog:Strat_TransformSimplify a owl:NamedIndividual , backlog:RecoveryStrategy ;
    rdfs:label "Transform: instance simplification"@en ;
    skos:definition "Before the restart, a ScopeChange (simplifiedBy) removes the deliverables the work never served, so the chain to rebuild is smaller than the chain that failed. The ScopeChange must first appear in git before the restart."@en .

backlog:Strat_TransformRepresent a owl:NamedIndividual , backlog:RecoveryStrategy ;
    rdfs:label "Transform: representation change"@en ;
    skos:definition "Before the restart, every bypassed Epic is decomposed (decomposesInto) so that admission is decided per Story, not per Epic (G1 granularity)."@en .

backlog:Strat_TransformReduce a owl:NamedIndividual , backlog:RecoveryStrategy ;
    rdfs:label "Transform: problem reduction"@en ;
    skos:definition "The restart adopts another lineage's converged chain as its template (templateLineage): a lineage the order check reads as ORDERED, not this one. Rebuilding from nothing is reduced to instantiating a known-good structure."@en .

backlog:LS_Opened a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "Opened"@en ; backlog:statusRank 1 ; skos:definition "The Mission stage output is active; nothing downstream."@en .

backlog:LS_Scoped a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "Scoped"@en ; backlog:statusRank 2 ; skos:definition "The Scope stage output is active."@en .

backlog:LS_Goaled a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "Goaled"@en ; backlog:statusRank 3 ; skos:definition "The Goal stage output is active."@en .

backlog:LS_Objectived a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "Objectived"@en ; backlog:statusRank 4 ; skos:definition "The Objective stage output is active."@en .

backlog:LS_Backlogged a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "Backlogged"@en ; backlog:statusRank 5 ; skos:definition "The Backlog stage output is active: the chain is closed and work is planned, none of it started."@en .

backlog:LS_InProgress a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "In progress"@en ; backlog:statusRank 6 ; skos:definition "The chain is closed and development is ongoing: at least one work item of the lineage has left Proposed/Ready, and the mission outcome is not yet settled. The status the owner asked for by name."@en .

backlog:LS_Achieved a owl:NamedIndividual , backlog:LineageStatus ; backlog:statusForOutcome backlog:Out_Achieved ; rdfs:label "Achieved"@en ; backlog:statusRank 7 ; skos:definition "The mission outcome is Out_Achieved and a closure report closes it. Found in this status and not archived, the lineage triggers the archival activity."@en .

backlog:LS_Abandoned a owl:NamedIndividual , backlog:LineageStatus ; backlog:statusForOutcome backlog:Out_Abandoned ; rdfs:label "Abandoned"@en ; skos:altLabel "Cancelled"@en ; backlog:statusRank 7 ; skos:definition "The mission outcome is Out_Abandoned. Archivable like Achieved."@en .

backlog:LS_Archived a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "Archived"@en ; backlog:statusRank 8 ; skos:definition "Set down into the archive ABox by backlog_lineage_archive; out of every processing path until consciously revived."@en .

backlog:LS_Revived a owl:NamedIndividual , backlog:LineageStatus ; rdfs:label "Revived"@en ; backlog:statusRank 6 ; skos:definition "An archived lineage consciously brought back by the owner (lineageRevivedAt, decidedBy Owner); processed again as in progress."@en .

backlog:Oblig_Required a owl:NamedIndividual , backlog:ObligationSeverity ; rdfs:label "Required"@en ;
    skos:definition "The stage output cannot close without it (Violation)."@en .

backlog:Oblig_Advisory a owl:NamedIndividual , backlog:ObligationSeverity ; rdfs:label "Advisory"@en ;
    skos:definition "Reported, not refused -- for an obligation whose absence can be legitimate and must then be explained (G46 test drive: severity is earned by watching a rule fire, not assumed). v1.115.0: the explanation is obligationWaivedBy naming the obligation with an obligationWaiverReason; for an advisory obligation that is an explanation, not a debt."@en .

backlog:OS_SDLC_v1 a owl:NamedIndividual , backlog:ObligationSet ;
    rdfs:label "SDLC stage obligations, set 1"@en ;
    skos:definition "The standing obligations shipped at package v1.247.0 from the owner's finding of 2026-09-09: domain entities and blueprint at Scope; specification with interaction steps, and nominal and rejection scenarios, at Goal; activity and sequence diagrams at Objective; class diagram and acceptance criteria at Backlog; models for design and architecture tasks and a test case for verification tasks at execution."@en .

backlog:Disp_Nonconformity a owl:NamedIndividual , backlog:FindingDisposition ;
    rdfs:label "Nonconformity"@en ;
    dcterms:source "ISO 19011:2018, 3.21 (nonconformity: non-fulfilment of a requirement)" ;
    skos:definition "A requirement is not fulfilled and must be. The default disposition of every violation: it needs no declaration, it needs fixing. A finding with no declared disposition is this one."@en .

backlog:Disp_KnownError a owl:NamedIndividual , backlog:FindingDisposition ;
    rdfs:label "Known error"@en ;
    dcterms:source "ITIL 4 / ISO/IEC 20000-1:2018 (known error: a problem with a documented root cause, not remediated, managed and monitored)" ;
    skos:definition "The rule is broken, the cause is documented, and it is deliberately NOT remediated -- typically because the work has moved on and the past state cannot be reinvented, or because the remedy costs more than the fault. It must name its root cause, the decision to accept it, its owner, and how it is monitored. It is not an excuse: the finding keeps firing, and the record says why it is left standing."@en .

backlog:Disp_RiskAccepted a owl:NamedIndividual , backlog:FindingDisposition ;
    rdfs:label "Risk accepted"@en ;
    dcterms:source "ISO 31000:2018, 6.5.3 (risk retention as a treatment option); risk:RiskRetention" ;
    skos:definition "The condition is real, the consequence is uncertain, and the owner has retained the risk rather than treating it. Must name a risk:Risk, its treatment decision and its monitoring; residual risk is risk:ResidualRisk."@en .

backlog:Disp_Observation a owl:NamedIndividual , backlog:FindingDisposition ;
    rdfs:label "Observation"@en ;
    dcterms:source "ISO 19011:2018, 6.4.8 (observations recorded without a nonconformity being raised)" ;
    skos:definition "Recorded because it may matter later; nothing is required of anyone. Reserved for findings whose rule is not yet written -- the case where a condition is certainly true and no obligation exists to breach."@en .

backlog:RS_SeverityAudit_20260909 a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Severity audit of 2026-09-09"@en ;
    skos:definition "The audit recorded in 04-documentation/SEVERITY_AUDIT_2026_09_09_v1_2_0.md (amended 2026-09-24, and 2026-09-28 to grade an unmet advisory obligation apart from a waived required one, under the owner's criterion -- non-compliance is a Violation, a probability is a Warning -- so that its table and the applied overlay agree): the advisories that state a broken lineage rule become sh:Violation, the opportunities sh:Info, and the risks remain sh:Warning. Shipped as the highest 02-shacl-safeguards/backlog_shacl_promoted_v*.ttl, regenerated from the base shapes by 03-tooling/backlog_make_promoted_shapes and refused by the release gate when stale. NOT adopted by this register at v1.248.0: lineage 9 is in progress."@en .

backlog:RS_DigestTable_v2 a owl:NamedIndividual , backlog:RuleSet ;
    backlog:concernsStage backlog:Stage_Backlog ;
    rdfs:label "Stage digest table v2 (item granularities complete)"@en ;
    skos:definition "Adds Feature, Defect, Enabler, Spike and Task to Stage_Backlog's stageRequiresType. SCAMPS measured the consequence of their absence: a register whose 25 items are all Features had a Backlog-stage digest identical to its Objective-stage digest, so an item added to a closed Backlog stage could not be detected -- the only thing the pipeline verifier exists for. Shipped as a RULE SET and not applied on adoption day, because changing the table changes every recorded digest: a register adopts it and re-records its stage digests as a stated migration, never silently (G91)."@en .

backlog:Stage_Backlog backlog:stageRequiresTypeV2
    backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable ,
    backlog:Goal , backlog:Objective , backlog:Initiative , backlog:Epic , backlog:Story ,
    backlog:Feature , backlog:Defect , backlog:Enabler , backlog:Spike , backlog:Task , backlog:ExecutionTask .

backlog:Stage_Mission backlog:stageRequiresTypeV2 backlog:Mission .

backlog:Stage_Scope backlog:stageRequiresTypeV2 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable .

backlog:Stage_Goal backlog:stageRequiresTypeV2 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal .

backlog:Stage_Objective backlog:stageRequiresTypeV2 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective .

backlog:RS_LabelConvention a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Label before identifier"@en ;
    skos:definition "Every mission, scope statement, area, deliverable, exclusion, goal, objective and lineage carries a one-sentence human label, and reports and discussion use that sentence rather than the identifier. Owner's instruction of 2026-09-10, after a session's answers became unreadable. A RuleSet because it binds every element a register carries: a register adopts it and labels its elements, rather than every fixture and every closed graph being refused the day the rule ships."@en .

backlog:Mk_Individual a owl:NamedIndividual , backlog:MaintainerKind ; rdfs:label "Individual"@en ; skos:definition "A single person maintains the lineage."@en .
backlog:Mk_Project a owl:NamedIndividual , backlog:MaintainerKind ; rdfs:label "Project"@en ; skos:definition "A project maintains the lineage."@en .
backlog:Mk_Program a owl:NamedIndividual , backlog:MaintainerKind ; rdfs:label "Program"@en ; skos:definition "A program of related projects maintains the lineage."@en .
backlog:Mk_Portfolio a owl:NamedIndividual , backlog:MaintainerKind ; rdfs:label "Portfolio"@en ; skos:definition "A portfolio of programs and projects maintains the lineage."@en .

backlog:Cm_Cancelled a owl:NamedIndividual , backlog:ClosureMark ; rdfs:label "Cancelled"@en ; skos:definition "The mission was stopped by decision before it was accomplished."@en .
backlog:Cm_Failed a owl:NamedIndividual , backlog:ClosureMark ; rdfs:label "Failed"@en ; skos:definition "The mission could not be accomplished."@en .

backlog:RS_PlanBeforeStart a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_3 ;
    rdfs:label "Work starts only after the plan step"@en ;
    skos:definition "A lineage's work may start only after a kick-off for the lineage that activates a roadmap report computed from the register no later than the kick-off. The plan step sits between the Backlog stage and the first start; urgent work and items a restart or the change-management route admits are not asked for it. The Owner's rule of 2026-10-26 (G162). Every lineage opened with a profile adopts it; lineages that never adopted it are untouched (G89, G91)."@en .

backlog:RS_CancellationAssessed a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_3 ;
    rdfs:label "A lineage is set down only after an as-is assessment"@en ;
    skos:definition "An Abandoned lineage (cancelled or failed) has an as-is assessment that sorts every work item as accomplished, failed, in progress or due and every objective as fitted or gapped, states the fit-gap and the impact, and a closure report marked cancelled or failed that cites it. The Owner's rule of 2026-10-26 (G162); Abandoned is the framework's one exit for it, labelled Cancelled as well."@en .

backlog:RS_ChangeSupportsMission a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_3 ;
    rdfs:label "Every change request supports an objective of the mission"@en ;
    skos:definition "A change request names, by supportsObjective, the objective of the running mission it serves. Change management adapts the running lineage for missing, incorrect or unmatching items; a request that supports no objective is another mission. The Owner's rule of 2026-10-26 (G162)."@en .

backlog:RS_ConcurrentLineages a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_2 ;
    rdfs:label "At most one active lineage unless they are connected"@en ;
    skos:definition "Two lineages may be active at once (status Scoped to InProgress, or Revived) only when each is maintained by a different party (maintainedBy: an individual, project, program or portfolio, G159) or when connected: a divide-and-conquer part and its parent (parentLineage), or a work item of one that dependsOn a work item of the other, followed transitively. Otherwise one runs and the other waits as a lineage at LS_Opened, the native queue, and advances only after the running lineage is Achieved. The owner's rules of 2026-10-12 (G104) and 2026-10-26 (G159). Every lineage opened with a profile adopts it (both profiles include it), so a new lineage is single by default; registers, fixtures and closed graphs that never adopted it are untouched (G89, G91)."@en .

backlog:RS_StateReflectsEvidence a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "A work item's state reflects the evidence it carries"@en ;
    skos:definition "A work item that still reads Proposed, Ready or Refined may not carry evidence the bridge has verified (a test that passed, a hash that matched, an artifact that exists): the work is there and the register says it has not started. A RuleSet because it binds only registers that declared it, so a register whose items were never moved is not judged retroactively (G89, G91). This package's own register does not adopt it."@en .

backlog:RS_IndependentVerification a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Done work is verified by a party other than its executor"@en ;
    skos:definition "Every work item that reads Done names, through verifiedBy, an Executor that is independent of the one that produced it (not the responsible Executor, not a member of it, not a collective that contains it). A register or one lineage may adopt it; a lineage adoption binds only that lineage's work and the items its output admitted, and a register adoption may state ruleSetAdoptedAt, before which finished items are exempt (G112). The adopter may state a verificationThreshold, and then only Done items whose integrityLevel reaches it need a verifier (an unclassified Done item is refused, UnclassifiedDoneShape). A RuleSet because it binds only what declared it, so closed work outside the scope is not judged retroactively (G89, G91). The independence of a verifier that is named is checked everywhere, adopted or not (VerifierIndependenceShape). This package's own register does not adopt it."@en .

backlog:RS_HumanOversight a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Oversight of agent work is held by people"@en ;
    skos:definition "Every Executor named through overseenBy is an individual human or a human team. A RuleSet because it binds only registers that declared it, so a register whose overseers were named before the rule is not judged retroactively (G89, G91). This package's own register does not adopt it."@en .

backlog:RS_ClosureCommitAnchor a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "A closure report records the commit it was made at"@en ;
    skos:definition "Within the adopter's scope, every closure report records closureCommittedAt, the commit it was itself committed at. A report generated at a timestamp is computable after the fact; a commit is the one anchor its author does not control (G95, G96). A RuleSet because the anchor cannot be supplied for a report made before the field existed, and a value computed afterwards is exactly what the field exists to refuse: a register adopts it for the reports made from then on and may state ruleSetAdoptedAt, before which reports generated are exempt; a lineage that adopts it binds the reports of its own mission (G89, G91, G112). This package's own register does not adopt it."@en .

backlog:RS_MissionHistory a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Every mission belongs to a lineage, and a replaced mission is not in flight"@en ;
    skos:definition "Within the adopting register: a mission is pursued by a lineage, or is a statement that a mission a lineage pursues replaced, directly or through a chain of replacements (supersedesMission); a mission that was replaced does not state that it is still in flight. A mission amended mid-flight is the same lineage under a better statement (G104), so the earlier statements are that lineage's mission history and need no lineage of their own. A RuleSet because a register whose missions were stated before lineages existed is not judged retroactively (G89, G91). This package's own register does not adopt it."@en .

backlog:RS_AgentAccountability a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_1 ;
    rdfs:label "Agent work is accounted for"@en ;
    skos:definition "Within the adopter's scope: an agent named for any function of a work item is a run (ExecutorInstance) of a definition, not the definition; every status move names who made it (transitionedByExecutor); the parties that do, oversee, verify and approve one item are four different parties, and agent runs of one definition count as one party; a Done item is overseen, verified and approved; an item at or above the adopter's humanApprovalLevel is approved by a person or a human team; an agent team or federation named for an item was assembled by a recorded act with its seats held by runs; a delegated lineage is spawned by the executor responsible for the item that delegated it. A RuleSet because it binds only an adopter (G89, G91). This package's own register does not adopt it."@en .

backlog:Seat_Does a owl:NamedIndividual , backlog:SeatFunction ;
    rdfs:label "Does the work"@en ; skos:definition "The seat of the party responsible for the item."@en .
backlog:Seat_Reviews a owl:NamedIndividual , backlog:SeatFunction ;
    rdfs:label "Reviews the work"@en ; skos:definition "The seat of a party that examines the result and returns findings to its producer."@en .
backlog:Seat_Verifies a owl:NamedIndividual , backlog:SeatFunction ;
    rdfs:label "Verifies the work (control)"@en ; skos:definition "The seat of a party that checks the result against its criteria and did not produce it."@en .
backlog:Seat_Oversees a owl:NamedIndividual , backlog:SeatFunction ;
    rdfs:label "Oversees the work"@en ; skos:definition "The seat of a party that watches the execution and may refuse, override or stop it."@en .
backlog:Seat_Approves a owl:NamedIndividual , backlog:SeatFunction ;
    rdfs:label "Approves the work"@en ; skos:definition "The seat of a party that accepts the verified result."@en .

backlog:RS_ManagerialIndependence a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "A verifier answers to a different controller"@en ;
    skos:definition "The verifier of a work item does not share a controlling party with its responsible Executor: the controller of one (or the Executor itself when it has none) is neither the controller of the other nor the other Executor. Adds managerial independence to the membership independence that VerifierIndependenceShape checks everywhere. A RuleSet because it binds only registers that declared it (G89, G91). Technical and financial independence are not modelled. This package's own register does not adopt it."@en ;
    dcterms:source "Independent verification and validation as described by NASA: independence is technical, managerial and financial (NASA IV&V Program overview); here only the managerial part, decidable from the controller link."@en .

backlog:RS_FlowPointsRecorded a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_1 ;
    rdfs:label "Done work records when it started and finished, and how exactly"@en ;
    skos:definition "Every Done item in scope carries startedAt and finishedAt, or says through flowPointAbsenceReason why it does not; a flow point written as midnight states flowPointPrecision Date; a Proposed item carries no startedAt and only a Done or Cancelled one carries a finishedAt (G115); startedAt and finishedAt each have one value (a correction replaces, never adds); and a start equal to the finish, or closer than the adopter's shortSpanThreshold, carries a shortSpanExplanation (an equal pair is the signature of an item registered after the work). Adopted by a register or by one lineage (G112); a lineage adoption binds only that lineage's work and the items it admitted, so it can start at a stated moment without judging earlier work. A RuleSet because it binds only what declared it (G89, G91). This package's own lineages adopt it themselves; the shipped data file does not adopt it for a register (G116)."@en ;
    dcterms:source "Kanban flow measures need a well-defined start and finish point (The Kanban Pocket Guide, ch. 6); ISO/IEC/IEEE 12207:2026 measurement process: a measure is to be verifiable, meaningful, actionable, timely and cost-effective. The detail standard ISO/IEC/IEEE 15939 was not read."@en .

backlog:Precision_Instant a owl:NamedIndividual , backlog:FlowPointPrecision ;
    rdfs:label "Instant"@en ;
    skos:definition "The flow point is a moment taken from a clock when the event happened."@en .

backlog:Precision_Date a owl:NamedIndividual , backlog:FlowPointPrecision ;
    rdfs:label "Date"@en ;
    skos:definition "The flow point is only a day, written as midnight; a duration computed from it is exact to the day at best."@en .

backlog:RS_StatusHistoryRecorded a owl:NamedIndividual , backlog:RuleSet ;
    backlog:introducedInRevision backlog:Pr_1 ;
    rdfs:label "Every status change is recorded, with its moment"@en ;
    skos:definition "An item that has left Proposed has a recorded move into its current state, and the earliest recorded move leaves Proposed (G115: a history that begins at Ready or In Progress has skipped the states before it); one that has started has a recorded move into In Progress; the recorded moves of an item chain without a gap (each move leaves the state the previous one entered); every move is stamped with an instant, not a date written as midnight; and startedAt and finishedAt, when the item is In Progress or Done, equal the moment of the first move into In Progress and of the last move into Done. Suspension and resumption are moves like any other. Adopted by a register or by one lineage (G112 scoping); an item that moved before the adoption says so through statusHistoryAbsenceReason, and nothing excuses a move after it. A RuleSet because it binds only what declared it (G89, G91)."@en ;
    dcterms:source "Kanban flow measures need a well-defined start and finish point (The Kanban Pocket Guide, ch. 6); the framework's own TransitionEvent, whose definition says a state with no history cannot be audited."@en .

backlog:RS_LineageStatus a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "A lineage states where it stands"@en ;
    skos:definition "Every lineage carries exactly one status, the status matches the stage outputs the register actually holds, a claim that work is under way requires work that has started, and a live lineage may not reuse a retired lineage's name. A RuleSet because it binds every lineage a register carries: a register adopts it, and minimal test graphs that model one narrow question -- an item tie, a scoring disagreement -- are not obliged to build a whole pipeline to answer it."@en .

backlog:Level_Analysis a owl:NamedIndividual , backlog:ModelLevel ; rdfs:label "Analysis level"@en ;
    skos:definition "Describes the problem domain as it is, independent of any solution: domain classes as the business names them, the system seen from outside as a black box, business events, the workflow as people perform it."@en .

backlog:Level_Design a owl:NamedIndividual , backlog:ModelLevel ; rdfs:label "Design level"@en ;
    skos:definition "Describes the solution as it will be built: software classes with methods, objects exchanging messages inside the system, states the implementation holds, components, packages and schemas."@en .

backlog:Depth_Brief a owl:NamedIndividual , backlog:SpecificationDepth ; rdfs:label "Brief"@en ;
    skos:definition "A few sentences: who, what and why, enough to size and prioritise. Appropriate during analysis, when the set of use cases is still moving."@en .

backlog:Depth_FullyDeveloped a owl:NamedIndividual , backlog:SpecificationDepth ; rdfs:label "Fully developed"@en ;
    skos:definition "Actor, goal, preconditions, trigger, the numbered main flow with its actors, the alternative and exception flows, and postconditions. Appropriate before implementation, because it is what someone builds from."@en .

backlog:Concern_Interface_UI a owl:NamedIndividual , backlog:DesignConcern ;
    rdfs:label "User interface"@en ;
    skos:definition "How a person sees and drives the system: the screens, their flow, and the dialogue between user and system. Named as a sixth concern because the corpus treats interface design as first-class -- storyboard, mockup, prototype, design model, dialogue -- and the five existing concerns cover none of it."@en ;
    backlog:coversTaskType backlog:Task_DesignDefinition , backlog:Task_Validation .

backlog:Depth_Discovery a owl:NamedIndividual , backlog:LineageDepthLevel ; rdfs:label "Discovery"@en ;
    skos:definition "The request cannot honestly support a Mission statement yet -- what exists is a wish or an expectation, not yet a stated intent. Real comprehensive elicitation work is owed before Mission-writing, not a shortcut through it. Named from the owner's own description, 2026-09-17: cases where 'even the epics cannot be written.'"@en .

backlog:Depth_MicroTask a owl:NamedIndividual , backlog:LineageDepthLevel ; rdfs:label "Micro-task"@en ;
    skos:definition "A single, well-defined, testable task or story -- real work, but bounded enough that a Mission/Scope/Goal/Objective/Epic chain around it would outweigh the work itself. Named from the owner's own example, 2026-09-17: an in-line coding request such as listing every rule in a corpus, a limited number of source lines, well-defined and properly tested, not a comprehensive lineage."@en .

backlog:Depth_StoryDirect a owl:NamedIndividual , backlog:LineageDepthLevel ; rdfs:label "Story-direct"@en ;
    skos:definition "The work is already known at story granularity -- an Epic-to-Story conversion step would be stale, since the decomposition it exists to produce is already the starting point. Named from the owner's own observation, 2026-09-17: 'if the stories are already available, possibly the epic-story conversion will be stale.'"@en .

backlog:Depth_FullChain a owl:NamedIndividual , backlog:LineageDepthLevel ; rdfs:label "Full chain"@en ;
    skos:definition "The standard Mission then Scope then Goal then Objective then Backlog then Epic then Story then Task chain, as this package's own Lineage 9 actually used it -- appropriate when the work is itself a rule other lineages will depend on, or genuinely novel enough that the chain's own drift-catching (retrospective findings, scope amendments) is real, needed value rather than ceremony."@en .

backlog:Domain_SourceCode a owl:NamedIndividual , backlog:LineageArtifactDomain ; rdfs:label "Source code"@en ;
    skos:definition "Structural and behavioral modelling: domain entities, interfaces, behaviour specifications -- what this package's own full SDLC obligation set (obligation set 2, the fourteen-process, six-concern expansion) was actually built for. Aligns with pib-hub's pib:CoreSoftwareDevelopment."@en .

backlog:Domain_Ontology a owl:NamedIndividual , backlog:LineageArtifactDomain ; rdfs:label "Ontology"@en ;
    skos:definition "TBox, ABox and SHACL discipline -- a different rigor entirely from source-code structural/behavioural modelling. What backlog-roadmap-framework and the wider OE discipline use on themselves. Aligns with pib-hub's pib:OntologyBasedSystem and pib:OntologyDeliverable."@en .

backlog:Domain_ContentTransformation a owl:NamedIndividual , backlog:LineageArtifactDomain ; rdfs:label "Content transformation"@en ;
    skos:definition "Turning existing content into a different real form -- the owner's own example, a corpus converted into an interactive HTML page -- distinct even from authoring new content, and with no existing pib:ArtifactCategory match at the time this was named (2026-09-17); disclosed as a real gap rather than forced into GamificationProject or CapstoneReport."@en .

backlog:Domain_Infrastructure a owl:NamedIndividual , backlog:LineageArtifactDomain ; rdfs:label "Infrastructure"@en ;
    skos:definition "Tooling, gate and pipeline work on the framework's own mechanisms -- real, necessary, and typically moving zero backlog items, the 'off-backlog, declared' case this same session's own real releases (the order-check rewrite, the archive-conformance seeding, the memoization default) demonstrated directly."@en .

backlog:Domain_CrossPackage a owl:NamedIndividual , backlog:LineageArtifactDomain ; rdfs:label "Cross-package"@en ;
    skos:definition "Work whose real completion is jointly owned by two or more packages, checkable from neither alone -- named from a real, disclosed case (a deferred handover, 2026-09-16): a deliverable's satisfying artifact moved to a different package with no scope-change recorded on the losing side."@en .

backlog:Profile_FullChain_Ontology a backlog:LineageProfile ;
    rdfs:label "Full chain, ontology work"@en ;
    backlog:forDepthLevel backlog:Depth_FullChain ; backlog:forArtifactDomain backlog:Domain_Ontology ;
    backlog:requiresEpicDecomposition false ; backlog:requiresObligationSetAdoption false ;
    skos:definition "The first real profile, named from a complete, closed, checked case rather than a guessed template: Lineage 9 (L_SDLCObligations), backlog-roadmap-framework's own SDLC-obligations lineage. Verified directly against its real, sealed archive before writing any requirement here: full five-stage Mission-through-Backlog chain, one commit per stage; a real RICE-scored backlog; Story decomposed directly to ExecutionTask with no Epic layer at any point (0 Epics belonging to the lineage); no adoptsObligationSet ever declared on the lineage itself. Register-level RuleSets (RS_LabelConvention, RS_LineageStatus) applied throughout, but those bind the whole register, not this profile specifically, and are not claimed as part of it."@en .

backlog:Profile_StoryDirect_Infrastructure a backlog:LineageProfile ;
    rdfs:label "Story-direct, infrastructure work"@en ;
    backlog:forDepthLevel backlog:Depth_StoryDirect ; backlog:forArtifactDomain backlog:Domain_Infrastructure ;
    backlog:requiresEpicDecomposition false ; backlog:requiresObligationSetAdoption false ;
    skos:definition "The second real profile, minted the same way as the first, and late: Lineage 15 (L_GovernanceContinuation) ran as its declared first instance from the moment its Mission was opened, but the profile individual itself was never actually built -- only discussed in commentary. Corrected here, verified directly against the lineage's own real, sealed archive rather than trusted from memory: full five-stage Mission-through-Backlog chain; a real, RICE-scored backlog of three Stories, one Cancelled honestly once its own acceptance criterion turned out already satisfied by a sibling story's work, decomposed directly to ExecutionTask with no Epic layer at any point (0 Epics belonging to the lineage); no adoptsObligationSet ever declared on the lineage itself. Fits a small, real, infrastructure-facing mission whose own scope is exhausted by a handful of stories -- a hard-blocking release gate, a tooling fix, a mechanism -- not a large content-production or cross-package effort. Available now for the next lineage of this same shape to declare directly, rather than reinvent." .

backlog:AC_PendingConfirmation a owl:NamedIndividual , backlog:ArchivalConfirmationStatus ;
    rdfs:label "Pending confirmation"@en ;
    skos:definition "Archived, but not yet checked against the shapes current at confirmation time -- honest, not wrong: the lineage's own content may well hold, this status only says nobody has checked yet."@en .

backlog:AC_Confirmed a owl:NamedIndividual , backlog:ArchivalConfirmationStatus ;
    rdfs:label "Confirmed"@en ;
    skos:definition "Checked once, against the shapes current at confirmation time, and found to hold its own era's standards. Once set, this lineage is permanently exempt from re-validation against any later rule -- the same principle as G89/G91's ruling that a rule change binds only work that declared it, applied per lineage rather than per file."@en .

#################################################################
#  v1.113.0 -- digest table v3: the artifacts a stage OWES are part of what it closes on (an adopting project handover,
#  successor-scope-stage-premature-rules-shared-entities-owed-artifacts). A stage output could close owing its
#  domain entities or blueprint and have the debt paid later with no trace, because the digest covered only the
#  intent chain. v3 = v2 plus, cumulatively from the stage that owes them: DomainEntity and Blueprint (Scope),
#  Specification and TestScenario (Goal), ModelArtifact (Objective), AcceptanceCriterion (Backlog) -- the classes
#  the stage obligations name. Adopted like v2: a register declares adoptsRuleSet RS_DigestTable_v3, because
#  changing the table changes every recorded digest (G91).
#################################################################
backlog:RS_DigestTable_v3 a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Stage digest table v3 (owed artifacts witnessed)"@en ;
    skos:definition "Adds to the v2 digest table, cumulatively from the stage that owes them, the classes the stage obligations require: DomainEntity and Blueprint at Scope, Specification and TestScenario at Goal, ModelArtifact at Objective, AcceptanceCriterion at Backlog. A stage output then witnesses what it owed as well as what it stated, so a debt paid after closure changes a recorded digest and is caught."@en .

backlog:Stage_Mission backlog:stageRequiresTypeV3 backlog:Mission .

backlog:Stage_Scope backlog:stageRequiresTypeV3 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:DomainEntity , backlog:Blueprint .

backlog:Stage_Goal backlog:stageRequiresTypeV3 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:DomainEntity , backlog:Blueprint , backlog:Specification , backlog:TestScenario .

backlog:Stage_Objective backlog:stageRequiresTypeV3 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective , backlog:DomainEntity , backlog:Blueprint , backlog:Specification , backlog:TestScenario , backlog:ModelArtifact .

backlog:Stage_Backlog backlog:stageRequiresTypeV3 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective , backlog:Initiative , backlog:Epic , backlog:Story , backlog:Feature , backlog:Defect , backlog:Enabler , backlog:Spike , backlog:Task , backlog:ExecutionTask , backlog:DomainEntity , backlog:Blueprint , backlog:Specification , backlog:TestScenario , backlog:ModelArtifact , backlog:AcceptanceCriterion .

#################################################################
#  v1.132.0 -- digest table v4: planning after a Backlog stage closed is not an addition to it (sen0401 handover,
#  planning-after-the-backlog-stage-closed). A task is created when an item the stage already admitted is taken into an
#  iteration; counting it made every planning event after the close break the recorded Backlog digest, while a story or
#  epic added to the closed stage still has to. v4 = v3 without ExecutionTask, and under v4 the Backlog digest also
#  covers the pre-lineage items the lineage's own Backlog output admitted. Adopted like v2 and v3 (G91).
#################################################################
backlog:RS_DigestTable_v4 a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Stage digest table v4 (planning after the close is not stage content)"@en ;
    skos:definition "The v3 digest table without ExecutionTask; the Backlog digest also covers the pre-lineage items the lineage's own Backlog output admitted. A register adopts it and re-records its stage digests as a stated migration, never silently (G91). A re-recorded digest witnesses the state at the re-recording, not the state at the original close; the migration is disclosed as such."@en .

backlog:Stage_Mission backlog:stageRequiresTypeV4 backlog:Mission .

backlog:Stage_Scope backlog:stageRequiresTypeV4 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:DomainEntity , backlog:Blueprint .

backlog:Stage_Goal backlog:stageRequiresTypeV4 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:DomainEntity , backlog:Blueprint , backlog:Specification , backlog:TestScenario .

backlog:Stage_Objective backlog:stageRequiresTypeV4 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective , backlog:DomainEntity , backlog:Blueprint , backlog:Specification , backlog:TestScenario , backlog:ModelArtifact .

backlog:Stage_Backlog backlog:stageRequiresTypeV4 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective , backlog:Initiative , backlog:Epic , backlog:Story , backlog:Feature , backlog:Defect , backlog:Enabler , backlog:Spike , backlog:Task , backlog:DomainEntity , backlog:Blueprint , backlog:Specification , backlog:TestScenario , backlog:ModelArtifact , backlog:AcceptanceCriterion .


#################################################################
#  v1.430.0 (G156) -- digest table v5: the chain content only. A test drive (orders-drive, 2026-10-25) found that table v4
#  freezes Specification, TestScenario, ModelArtifact and AcceptanceCriterion in the Goal, Objective and Backlog digests
#  while OS_SDLC_v2 obliges those artifacts of task types that exist only after the Backlog stage closed, so a lineage that
#  honoured the obligation set broke its own recorded digests. Their existence is witnessed by the stage-owed shapes and by
#  backlog_sdlc_artifact_order_check, which read git order.
#################################################################
backlog:RS_DigestTable_v5 a owl:NamedIndividual , backlog:RuleSet ;
    rdfs:label "Stage digest table v5 (obligation artifacts are not stage content)"@en ;
    skos:definition "The v4 digest table without Specification, TestScenario, ModelArtifact and AcceptanceCriterion. Under v5 an item that a ScopeChange admits is also not part of the Backlog digest (G157): the owner-decided change record is the visibility, and a change-managed addition after the close would otherwise leave the digest failing for good. A register adopts it and re-records its stage digests as a stated migration, never silently (G91); a re-recorded digest witnesses the state at the re-recording, not the state at the original close, and the migration is disclosed as such."@en .

backlog:Stage_Mission backlog:stageRequiresTypeV5 backlog:Mission .

backlog:Stage_Scope backlog:stageRequiresTypeV5 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:DomainEntity , backlog:Blueprint .

backlog:Stage_Goal backlog:stageRequiresTypeV5 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:DomainEntity , backlog:Blueprint .

backlog:Stage_Objective backlog:stageRequiresTypeV5 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective , backlog:DomainEntity , backlog:Blueprint .

backlog:Stage_Backlog backlog:stageRequiresTypeV5 backlog:Mission , backlog:ScopeStatement , backlog:ScopeExclusion , backlog:ScopeDeliverable , backlog:Goal , backlog:Objective , backlog:Initiative , backlog:Epic , backlog:Story , backlog:Feature , backlog:Defect , backlog:Enabler , backlog:Spike , backlog:Task , backlog:DomainEntity , backlog:Blueprint .


backlog:GoalOrigin_Carried a owl:NamedIndividual , backlog:GoalOrigin ;
    rdfs:label "Carried"@en ;
    skos:definition "Continues work the predecessor out-scoped before it closed. Names the out-scoping declaration it continues (goalAnswersGap)."@en .

backlog:GoalOrigin_Repair a owl:NamedIndividual , backlog:GoalOrigin ;
    rdfs:label "Repair"@en ;
    skos:definition "Repairs work the predecessor closed as done and was later found defective. Names the post-closure finding it answers (goalAnswersGap)."@en .

backlog:GoalOrigin_New a owl:NamedIndividual , backlog:GoalOrigin ;
    rdfs:label "New"@en ;
    skos:definition "Covers something the predecessor never had in scope -- mentioned before, perhaps, but never part of its work. Names no gap."@en .

# ---- individuals from the rules file
backlog:NextItemSelection a skos:Concept ;
    rdfs:label "next-item selection query"@en ;
    skos:definition "The authoritative definition of what to work on next: the highest-scoring Ready item, under one named prioritisation method, whose every declared dependency is Done. Derived on demand rather than hand-listed, so a 'what's next' section cannot drift from the register that decides it."@en ;
    skos:example """SELECT ?item ?id ?value WHERE {
  ?item backlog:hasState backlog:Ready ;
        backlog:hasIdentifier ?id ;
        backlog:hasPriorityScore ?sc .
  ?sc backlog:scoredByMethod ?method ; backlog:hasScoreValue ?value .
  FILTER NOT EXISTS { ?item backlog:dependsOn ?d . ?d backlog:hasState ?ds . FILTER(?ds != backlog:Done) }
} ORDER BY DESC(?value) LIMIT 1""" ;
    rdfs:comment "Expected result: exactly one row, or zero rows when nothing is startable. Carried as an annotation rather than via backlog:hasExpectedResult, whose domain would otherwise type this concept as a criterion or invariant."@en .

backlog:RankingArbitration a skos:Concept ;
    rdfs:label "R3 ranking arbitration"@en ;
    skos:definition "The authoritative account of how the throughput and launch-scoped answers relate: they are computed independently over different candidate sets and reported side by side, so the register never silently picks one question's answer to a different question."@en ;
    skos:example """SELECT ?id ?value WHERE {
  ?gate a backlog:WorkItemContainer ; backlog:isLaunchGate true ; backlog:hasLaunchPriority ?lp .
  FILTER NOT EXISTS { ?gate backlog:derivedState backlog:Done }
  ?item backlog:memberOfContainer ?gate ; backlog:hasState backlog:Ready ;
        backlog:hasIdentifier ?id ; backlog:hasPriorityScore ?sc .
  ?sc backlog:scoredByMethod ?method ; backlog:hasScoreValue ?value .
  FILTER NOT EXISTS { ?item backlog:dependsOn ?d . ?d backlog:hasState ?ds . FILTER(?ds != backlog:Done) }
} ORDER BY ?lp DESC(?value) LIMIT 1""" ;
    rdfs:comment "Cross-cutting prerequisites are added to the candidate set by the report tool: items outside the active gate that an item inside it depends on."@en .

# ---- reference individuals (from backlog_abox)


#################################################################
#  Prioritisation methods
#################################################################

backlog:Method_WSJF a owl:NamedIndividual , backlog:PrioritizationMethod ;
    rdfs:label "WSJF"@en ;
    skos:definition "Weighted Shortest Job First: cost of delay divided by job size, where cost of delay sums user-business value, time criticality and risk-reduction/opportunity-enablement. Ranks by economic urgency per unit of effort."@en ;
    dcterms:source "SAFe 6.0 WSJF; Reinertsen, The Principles of Product Development Flow."@en .

backlog:Method_RICE a owl:NamedIndividual , backlog:PrioritizationMethod ;
    rdfs:label "RICE"@en ;
    skos:definition "Reach times impact times confidence, divided by effort. Differs from WSJF in making estimate quality (confidence) an explicit factor rather than an unstated caveat."@en ;
    dcterms:source "Intercom RICE scoring model."@en .

backlog:Method_RICE_DepFactor a owl:NamedIndividual , backlog:PrioritizationMethod ;
    rdfs:label "RICE + DepFactor"@en ;
    skos:definition "RICE multiplied by a dependency factor below one for items whose prerequisites are not yet Done, so blocked work is demoted rather than competing on nominal value with work that could start today."@en .

backlog:Method_MoSCoW a owl:NamedIndividual , backlog:PrioritizationMethod ;
    rdfs:label "MoSCoW"@en ;
    skos:definition "Ordinal classification into must-have, should-have, could-have and will-not-have-this-time. Coarser than the numeric methods and non-comparable across bands, so the framework treats it as a band label rather than a ranking number."@en ;
    dcterms:source "DSDM MoSCoW prioritisation."@en .

backlog:Method_CostOfDelay a owl:NamedIndividual , backlog:PrioritizationMethod ;
    rdfs:label "Cost of Delay"@en ;
    skos:definition "The economic loss per unit time of not having the item, used without the job-size divisor where effort is roughly uniform across candidates."@en .

backlog:Method_ValueEffort a owl:NamedIndividual , backlog:PrioritizationMethod ;
    rdfs:label "Value / Effort"@en ;
    skos:definition "The simplest ratio method: estimated value divided by estimated effort. Shipped because a lightweight adopter with no comparative economics is better served by an honest crude method than by a precise-looking one it cannot populate."@en .

#################################################################
#  Baseline Definition of Done (reusable template)
#################################################################

backlog:DoD_Baseline a owl:NamedIndividual , backlog:DefinitionOfDone ;
    rdfs:label "Baseline Definition of Done"@en ;
    skos:definition "The framework's reusable minimum: four falsifiable criteria every adopting development can run unchanged, extended rather than replaced by project-specific criteria."@en ;
    backlog:hasDoDCriterion backlog:DoD_C1_EvidenceExists ,
                            backlog:DoD_C2_EvidenceVerified ,
                            backlog:DoD_C3_AcceptanceCriteriaPresent ,
                            backlog:DoD_C4_DependenciesDone .

backlog:DoD_C1_EvidenceExists a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every Done item carries at least one Evidence"@en ;
    skos:definition "No item may hold the Done state on prose alone; at least one Evidence artifact must be attached."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState backlog:Done . FILTER NOT EXISTS { ?i backlog:hasEvidence ?e } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_C2_EvidenceVerified a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every Done item carries at least one bridge-verified Evidence"@en ;
    skos:definition "Attached evidence is not enough: at least one attached artifact must have been confirmed to exist, and for a test to pass, outside the graph."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState backlog:Done . FILTER NOT EXISTS { ?i backlog:hasEvidence ?e . ?e backlog:evidenceVerified true } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_C3_AcceptanceCriteriaPresent a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every Done item states what it was accepted against"@en ;
    skos:definition "An item completed without recorded acceptance criteria cannot be re-tested later, so the criterion requires at least one acceptance criterion on any Done item."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState backlog:Done . FILTER NOT EXISTS { ?i backlog:hasAcceptanceCriterion ?a } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_C4_DependenciesDone a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "No Done item depends on unfinished work"@en ;
    skos:definition "An item cannot be complete while something it declares a dependency on is not; such a pair signals either a false Done or a wrong dependency, and both need resolving."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState backlog:Done ; backlog:dependsOn ?d . ?d backlog:hasState ?s . FILTER(?s != backlog:Done) }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

#################################################################
#  Report sections required of a compliant roadmap report (v1.1.0)
#################################################################

backlog:Section_NextThroughput a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "NEXT under the throughput model"@en ;
    skos:definition "The highest-scoring startable item across the whole register under a named method."@en .

backlog:Section_NextLaunchScoped a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "NEXT under the launch-scoped model"@en ;
    skos:definition "The highest-scoring startable item within the active launch gate plus cross-cutting prerequisites. Printed alongside the throughput answer, never instead of it, so a disagreement between the two stays visible."@en .

backlog:Section_RankedBacklog a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "Full ranked backlog"@en ;
    skos:definition "Every scored item in rank order, so the two NEXT answers can be checked against the ordering that produced them."@en .

backlog:Section_FlaggedItems a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "Flagged items"@en ;
    skos:definition "Items explicitly declared not yet scoreable, with the reason recorded for each."@en .

backlog:Section_SilentGapCheck a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "Silent-gap check"@en ;
    skos:definition "The count of open items that are neither scored nor flagged. Must read zero; any other number is a defect in the register, not a note."@en .

backlog:Section_LaunchReadiness a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "Launch readiness by package"@en ;
    skos:definition "Each launch-gated container with its blocking items and its disclosed external dependency risk."@en .

backlog:Section_PackageRanking a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "Package-level multi-factor ranking"@en ;
    skos:definition "Containers ranked by their own judged scores, excluding those tagged as not business capabilities."@en .

backlog:Section_OrphanCoverageCheck a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "Orphan and package-coverage check"@en ;
    skos:definition "Items belonging to no container, and containers with no members, so nothing falls out of both the ranking and the roll-up unnoticed."@en .

#################################################################
#  Release gates (v1.1.0)
#################################################################

backlog:Gate0_ManifestSelfVerify a owl:NamedIndividual , backlog:ReleaseGate ;
    rdfs:label "Gate 0 — manifest self-verify"@en ;
    skos:definition "Every shipped file hashes as recorded in the manifest. Guards the inputs every later gate assumes."@en ;
    backlog:hasGateCommand "the gate script (step: manifest self-verify)" ;
    backlog:hasGateOrder 0 .

backlog:GateP_TurtleParse a owl:NamedIndividual , backlog:ReleaseGate ;
    rdfs:label "Gate P — Turtle parse"@en ;
    skos:definition "Every shipped Turtle file parses. A file that does not parse cannot be validated, and a validator that silently skips it reports a pass it did not measure."@en ;
    backlog:hasGateCommand "the gate script (step: parse)" ;
    backlog:hasGateOrder 1 .

backlog:GateK_VersionIdentity a owl:NamedIndividual , backlog:ReleaseGate ;
    rdfs:label "Gate K — version identity"@en ;
    skos:definition "For every ontology file, versionInfo equals the versionIRI token equals the filename token. Caught mechanically rather than by inspection, because the mismatch is invisible to a reader who trusts the filename."@en ;
    backlog:hasGateCommand "the validate tool with --gate-k" ;
    backlog:hasGateOrder 2 .

backlog:GateR_ShaclReconcile a owl:NamedIndividual , backlog:ReleaseGate ;
    rdfs:label "Gate R — SHACL reconcile"@en ;
    skos:definition "The register conforms: no item is Done without verified evidence, and no structural constraint is violated. Conformance is zero results at Violation severity, not an empty report."@en ;
    backlog:hasGateCommand "the validate tool on the register" ;
    backlog:hasGateOrder 3 .

#################################################################
#  Methodology rules, with the incident each closes (v1.1.0)
#################################################################

backlog:Rule_R1_ContainerStateDerivation a owl:NamedIndividual , backlog:MethodologyRule ;
    rdfs:label "R1 — container state is derived from member states"@en ;
    backlog:hasRuleLogic "A container is Done when every member is Done or Cancelled and at least one member exists; InProgress when at least one member is InProgress or Done while another is not yet terminal; Proposed when members exist and none has started. An asserted state that disagrees with the derived state is a violation." ;
    backlog:closesDisagreement "Whether a container's reported completeness may be typed by hand alongside the members it summarises." ;
    backlog:hasMotivatingIncident "A roll-up table marked superseded went 95 versions without mentioning three registered epics; it was not wrong when written, it went stale because nothing forced it to stay in sync with the register underneath. The fix had to be structural, not procedural." .

backlog:Rule_R2_MilestoneStateDerivation a owl:NamedIndividual , backlog:MethodologyRule ;
    rdfs:label "R2 — milestone state is derived from contributing items"@en ;
    backlog:hasRuleLogic "A milestone is Done when every contributing item is Done, InProgress while any contributing item is not, and carries its own derived property rather than the container one because a milestone is a roadmap element, not a container." ;
    backlog:closesDisagreement "Whether a milestone may be reported achieved on the strength of membership or intent rather than completed contributing work." ;
    backlog:hasMotivatingIncident "Milestone reporting inherited from grouping rather than from contribution, allowing a date to read green while the work behind it was open." .

backlog:Rule_R3_RankingArbitration a owl:NamedIndividual , backlog:MethodologyRule ;
    rdfs:label "R3 — arbitration between the throughput and launch-readiness models"@en ;
    backlog:hasRuleLogic "While any launch-gate container remains open, ranking is scoped to the active launch-priority container plus cross-cutting prerequisites; when every launch gate has cleared, the scoping collapses automatically to plain throughput ranking. Both the whole-register answer and the scoped answer are always printed together, and a disagreement between them is displayed rather than resolved." ;
    backlog:closesDisagreement "Which of two prioritisation models answers 'what is next' when they point at different work — a recurring dispute that was re-litigated three separate times before being written down as a rule." ;
    backlog:hasMotivatingIncident "A throughput-driven next pointed at a package the owner had not confirmed was in scope, while the owner's own declared launch priority pointed elsewhere; the owner raised the same disagreement twice before it was closed structurally." .

backlog:Rule_R4_ExternalBlockerDerivation a owl:NamedIndividual , backlog:MethodologyRule ;
    rdfs:label "R4 — full member completion is not deployability"@en ;
    backlog:hasRuleLogic "For each container, derive an external blocker for every not-Done item outside the container that a member depends on. A container whose derived state is Done while an external blocker exists is a violation." ;
    backlog:closesDisagreement "Whether a container reported 100% member-complete may be called ready to deploy." ;
    backlog:hasMotivatingIncident "Two items recorded as Done formally depended on a still-open validation story, invisible until checked; a grouping of thirteen unrelated point fixes was simultaneously ranked as a complete, ready-to-deploy capability alongside real ones." .

#################################################################
#  Baseline Definition of Done — v1.1.0 additions
#################################################################

backlog:DoD_Baseline backlog:hasDoDCriterion backlog:DoD_C5_NoSilentGaps , backlog:DoD_C6_LaunchGatesOwnerDecided .

backlog:DoD_C5_NoSilentGaps a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "No open item is both unscored and unflagged"@en ;
    skos:definition "Gap discipline is binary: every open item is either scored or explicitly flagged not-yet-scoreable with a reason. The count of silent gaps must read zero."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState ?s . FILTER(?s IN (backlog:Proposed, backlog:Ready)) FILTER NOT EXISTS { ?i backlog:hasPriorityScore ?p } FILTER NOT EXISTS { ?i backlog:notYetScoreable true } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_C6_LaunchGatesOwnerDecided a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every launch gate is an owner decision with a written rationale"@en ;
    skos:definition "Launch scope is a business call, never a value derived from a score, so each launch gate must name the Owner as its decider and carry the reasoning."@en ;
    backlog:hasCheckQuery "ASK { ?x backlog:isLaunchGate true . FILTER NOT EXISTS { ?x backlog:decidedBy backlog:Owner . ?x backlog:hasDecisionRationale ?r } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

#################################################################
#  Project-level Definition of Done (v1.2.0)
#  Item-level criteria judge an item; these judge the effort.
#################################################################

backlog:DoD_ProjectBaseline a owl:NamedIndividual , backlog:DefinitionOfDone ;
    rdfs:label "Baseline project Definition of Done"@en ;
    skos:definition "The reusable minimum an implementation project must satisfy before it may be called finished. Every criterion is an executable query with a stated expected result, so 'the project is done' is a claim a gate can refuse."@en ;
    backlog:hasDoDCriterion backlog:DoD_P1_LaunchGatesCleared , backlog:DoD_P2_NoSilentGaps ,
                            backlog:DoD_P3_BlueprintSweepComplete , backlog:DoD_P4_DoneItemsEvidenced ,
                            backlog:DoD_P5_ObjectivesMeasurable , backlog:DoD_P6_BenefitClaimsEvidenced ,
                            backlog:DoD_P7_RisksTreatedOrAccepted , backlog:DoD_P8_CapacityPolicyComplete .

backlog:DoD_P1_LaunchGatesCleared a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every launch gate has cleared"@en ;
    skos:definition "No container declared a launch gate still has incomplete members."@en ;
    backlog:hasCheckQuery "ASK { ?c backlog:isLaunchGate true . ?m backlog:memberOfContainer ?c ; backlog:hasState ?s . FILTER(?s NOT IN (backlog:Done, backlog:Cancelled)) }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_P2_NoSilentGaps a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "The silent-gap count is zero"@en ;
    skos:definition "Every open item is either scored or explicitly flagged not-yet-scoreable with a reason."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState ?s . FILTER(?s IN (backlog:Proposed, backlog:Ready)) FILTER NOT EXISTS { ?i backlog:hasPriorityScore ?p } FILTER NOT EXISTS { ?i backlog:notYetScoreable true } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_P3_BlueprintSweepComplete a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every entity life-cycle stage is covered or explicitly gapped"@en ;
    skos:definition "No domain entity has a stage with neither backlog coverage nor a recorded blueprint gap."@en ;
    backlog:hasCheckQuery "ASK { ?e a backlog:DomainEntity . ?st a backlog:EntityLifecycleStage . FILTER NOT EXISTS { ?i backlog:coversEntity ?e ; backlog:coversStage ?st } FILTER NOT EXISTS { ?g backlog:gapForEntity ?e ; backlog:gapForStage ?st } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_P4_DoneItemsEvidenced a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every Done item carries bridge-verified evidence"@en ;
    skos:definition "No item holds the Done state on unverified or absent evidence."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState backlog:Done . FILTER NOT EXISTS { ?i backlog:hasEvidence ?e . ?e backlog:evidenceVerified true } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_P5_ObjectivesMeasurable a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every objective carries a metric, a baseline and a target"@en ;
    skos:definition "No objective can be declared met or missed on opinion."@en ;
    backlog:hasCheckQuery "ASK { ?o a backlog:Objective . FILTER NOT EXISTS { ?o backlog:hasSuccessMetric ?m . ?o backlog:hasBaselineValue ?b . ?o backlog:hasTargetValue ?t } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_P6_BenefitClaimsEvidenced a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every realised-benefit claim points at verified evidence"@en ;
    skos:definition "A benefit is realised when it has been observed, not when the work shipped."@en ;
    backlog:hasCheckQuery "ASK { ?b backlog:benefitRealized true . FILTER NOT EXISTS { ?b backlog:benefitRealizedBy ?e . ?e backlog:evidenceVerified true } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_P7_RisksTreatedOrAccepted a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every attached risk is mitigated or explicitly accepted"@en ;
    skos:definition "No risk sits on the register untreated and unacknowledged."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasRisk ?r . FILTER NOT EXISTS { ?r backlog:hasMitigation ?m } FILTER NOT EXISTS { ?r backlog:riskAcceptedBy ?role } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

backlog:DoD_P8_CapacityPolicyComplete a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Where a capacity policy exists, its shares account for all capacity"@en ;
    skos:definition "Declared investment shares sum to one, so no capacity is allocated by default."@en ;
    backlog:hasCheckQuery "ASK { SELECT ?p (SUM(?s) AS ?total) WHERE { ?p a backlog:PortfolioPolicy ; backlog:hasAllocation ?a . ?a backlog:hasTargetShare ?s } GROUP BY ?p HAVING (ABS(?total - 1.0) > 0.001) }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

#################################################################
#  Default lifecycle workflow (v1.3.0)
#  Eight transitions covering every state in the enumeration.
#  Guards are executable text, because a precondition nobody can run
#  is a precondition nobody enforces.
#################################################################

backlog:Workflow_Default a owl:NamedIndividual , backlog:Workflow ;
    rdfs:label "Default work-item workflow"@en ;
    skos:definition "The reusable baseline lifecycle: refine, start, complete, and withdraw, plus the two backward moves real delivery needs, plus the two 2026-09-17 moves through Refined -- decompose (Proposed to Refined) and confirm-ready (Refined to Ready, unconditional at this level; ReadinessGateShape independently guards Ready's own real bar). Every state in the closed enumeration is reachable and both terminal states are entered only through a guarded transition."@en ;
    backlog:hasTransition backlog:T_Refine , backlog:T_Start , backlog:T_Complete , backlog:T_Return ,
                          backlog:T_Defer , backlog:T_WithdrawProposed , backlog:T_WithdrawReady , backlog:T_WithdrawInProgress ,
                          backlog:T_Decompose , backlog:T_RefinedToReady , backlog:T_Suspend , backlog:T_Resume , backlog:T_WithdrawSuspended .

backlog:T_Refine a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Refine: Proposed to Ready"@en ;
    backlog:fromState backlog:Proposed ; backlog:toState backlog:Ready ;
    backlog:hasTransitionName "refine" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:hasAcceptanceCriterion ?a . ?r backlog:refines ?i } # must return true for the item" .

backlog:T_Decompose a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Decompose: Proposed to Refined"@en ;
    backlog:fromState backlog:Proposed ; backlog:toState backlog:Refined ;
    backlog:hasTransitionName "decompose" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:decomposesInto ?t . ?t a backlog:ExecutionTask } # at least one real ExecutionTask decomposed from the item must exist" .

backlog:T_RefinedToReady a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Refined to Ready, unconditional at the transition level"@en ;
    backlog:fromState backlog:Refined ; backlog:toState backlog:Ready ;
    backlog:hasTransitionName "confirm-ready" ;
    backlog:hasTransitionGuard "ASK { true } # unconditional here on purpose: ReadinessGateShape, a separate, already-active SHACL mechanism, independently enforces the real bar (acceptance criteria, a recorded refinement event) the moment hasState:Ready is asserted, regardless of which state preceded it -- no substance moved, only which mechanism checks it" .

backlog:T_Start a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Start: Ready to In Progress"@en ;
    backlog:fromState backlog:Ready ; backlog:toState backlog:InProgress ;
    backlog:hasTransitionName "start" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:dependsOn ?d . ?d backlog:hasState ?s . FILTER(?s != backlog:Done) } # must return false for the item" .

backlog:T_Complete a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Complete: In Progress to Done"@en ;
    backlog:fromState backlog:InProgress ; backlog:toState backlog:Done ;
    backlog:hasTransitionName "complete" ;
    backlog:hasTransitionGuard "ASK { ?h backlog:harnessFor ?i ; backlog:harnessComplete true . ?i backlog:hasEvidence ?e . ?e backlog:evidenceVerified true } # must return true for the item" .

backlog:T_Return a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Return: In Progress to Ready"@en ;
    backlog:fromState backlog:InProgress ; backlog:toState backlog:Ready ;
    backlog:hasTransitionName "return" ;
    backlog:hasTransitionGuard "ASK { } # unguarded: work may always be put back down, and pretending otherwise hides paused work as in-progress" .

backlog:T_Defer a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Defer: Ready to Proposed"@en ;
    backlog:fromState backlog:Ready ; backlog:toState backlog:Proposed ;
    backlog:hasTransitionName "defer" ;
    backlog:hasTransitionGuard "ASK { } # unguarded: readiness decays when the item's assumptions change" .

backlog:T_WithdrawProposed a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Withdraw: Proposed to Cancelled"@en ;
    backlog:fromState backlog:Proposed ; backlog:toState backlog:Cancelled ;
    backlog:hasTransitionName "withdraw" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:hasRationale ?r } # must return true for the item" .

backlog:T_WithdrawReady a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Withdraw: Ready to Cancelled"@en ;
    backlog:fromState backlog:Ready ; backlog:toState backlog:Cancelled ;
    backlog:hasTransitionName "withdraw" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:hasRationale ?r } # must return true for the item" .

backlog:T_WithdrawInProgress a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Withdraw: In Progress to Cancelled"@en ;
    backlog:fromState backlog:InProgress ; backlog:toState backlog:Cancelled ;
    backlog:hasTransitionName "withdraw" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:hasRationale ?r } # must return true for the item" .

backlog:T_Suspend a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Suspend: In Progress to Suspended"@en ;
    backlog:fromState backlog:InProgress ; backlog:toState backlog:Suspended ;
    backlog:hasTransitionName "suspend" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:hasRationale ?r } # must return true for the item: a pause says why" .

backlog:T_Resume a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Resume: Suspended to In Progress"@en ;
    backlog:fromState backlog:Suspended ; backlog:toState backlog:InProgress ;
    backlog:hasTransitionName "resume" ;
    backlog:hasTransitionGuard "ASK { true } # unconditional on purpose: the pause already said why; resuming needs only to be recorded" .

backlog:T_WithdrawSuspended a owl:NamedIndividual , backlog:StateTransition ;
    rdfs:label "Withdraw: Suspended to Cancelled"@en ;
    backlog:fromState backlog:Suspended ; backlog:toState backlog:Cancelled ;
    backlog:hasTransitionName "withdraw" ;
    backlog:hasTransitionGuard "ASK { ?i backlog:hasRationale ?r } # must return true for the item" .

#################################################################
#  Ninth required report section (v1.3.0)
#################################################################

backlog:Section_LifecycleWorkflow a owl:NamedIndividual , backlog:ReportSection ;
    rdfs:label "Lifecycle and workflow"@en ;
    skos:definition "Current state counts across the register, the permitted transitions of the governing workflow, and any item whose state is not explained by its recorded transition history."@en .

#################################################################
#  Item-level Definition of Done — v1.3.0 addition
#################################################################

backlog:DoD_Baseline backlog:hasDoDCriterion backlog:DoD_C7_HarnessProvesCriteria .

backlog:DoD_C7_HarnessProvesCriteria a owl:NamedIndividual , backlog:DoDCriterion ;
    rdfs:label "Every acceptance criterion of a Done item is attested by verified evidence"@en ;
    skos:definition "Completion is proved criterion by criterion, not suite by suite: a green test run that never touched the criterion everyone cared about does not close it."@en ;
    backlog:hasCheckQuery "ASK { ?i backlog:hasState backlog:Done ; backlog:hasAcceptanceCriterion ?ac . FILTER NOT EXISTS { ?e backlog:attestsCriterion ?ac ; backlog:evidenceVerified true } }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasCriterionStatus backlog:Holds .

#################################################################
#  v1.4.0 (2026-09-09) -- THE STANDING STAGE OBLIGATIONS. What each
#  pipeline stage owes before its output may close, and what each
#  ISO/IEC 12207 task type owes before its task is Done. Every owed
#  class and kind is this framework's own vocabulary (TBox v1.90.0
#  and earlier); nothing is minted here.
#
#  These bind ONLY a lineage that ADOPTED OS_SDLC_v1 at the moment it
#  opened. Owner's rule, 2026-09-09: a ruling is never applied to work
#  in progress. Lineage 9 is mid-flight and does NOT adopt them; it
#  builds them, and the first lineage opened after they ship will be
#  the first to owe them.
#################################################################
backlog:Ob_Scope_DomainEntity a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Scope ; backlog:owesClass backlog:DomainEntity ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "What things exist in this domain? A scope that names areas and deliverables without naming the entities the work is about cannot be checked for coverage: the blueprint gap analysis, the epic-covers-entity rule and the launch readiness report all read from DomainEntity. The owner's finding of 2026-09-09 named this absence first: 'a Mission, Scope, Goals and Objectives -- but no Blueprint and no DomainEntity individuals'." .
backlog:Ob_Scope_Blueprint a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Scope ; backlog:owesClass backlog:Blueprint ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Which lifecycle stages of those entities does this scope intend to cover? Without a blueprint, 'the scope is complete' is an opinion; with one, the uncovered stages are BlueprintGap individuals a reader can count." .
backlog:Ob_Goal_Specification a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Goal ; backlog:owesClass backlog:Specification ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Who does what, and in what order? A goal states an intention; a Specification with InteractionSteps and their actors states what the system will DO to satisfy it -- the use case, in this framework's own vocabulary. The owner's finding: 'grooming doesn't have any enforcement to define the use cases'." .
backlog:Ob_Goal_ScenarioNominal a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Goal ; backlog:owesClass backlog:TestScenario ;
    backlog:owesScenarioKind backlog:Scen_Nominal ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "What happens when everything goes right? The main scenario. A specification with no nominal scenario has never been walked through once." .
backlog:Ob_Goal_ScenarioRejection a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Goal ; backlog:owesClass backlog:TestScenario ;
    backlog:owesScenarioKind backlog:Scen_Rejection ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "What happens when it must refuse? The alternative scenario the owner asked for, in the kind that fails differently from a boundary or an absent case. Nominal-only coverage reads as fully covered and is not." .
backlog:Ob_Goal_UseCaseDiagram a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Analysis ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Goal ; backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_UseCaseDiagram ; backlog:obligationSeverity backlog:Oblig_Advisory ;
    backlog:obligationRationale "Who are the actors and which use cases do they reach? Advisory, not required: a lineage with one actor and one use case can state that in the Specification and be understood, and a diagram demanded for its own sake is the decorative artifact this framework refuses elsewhere (G7)." .
backlog:Ob_Objective_ActivityDiagram a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Analysis ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Objective ; backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_ActivityDiagram ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "In what order does the work happen, and where does it branch? An objective is measured against a flow; the activity diagram is that flow. The owner's finding: 'drawing activity diagrams'." .
backlog:Ob_Objective_SequenceDiagram a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Analysis ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Objective ; backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_SequenceDiagram ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Between which participants, in what order, with what messages? The interaction the activity diagram leaves implicit. The owner's finding: 'sequence diagrams'." .
backlog:Ob_Backlog_ClassDiagram a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Analysis ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Backlog ; backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_ClassDiagram ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "What are the domain classes, their attributes and their associations? The DomainEntity individuals of the Scope stage are the governed index; the class model is the thing indexed. The owner's finding: 'discover the domain classes'." .
backlog:Ob_Backlog_Criterion a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfStage backlog:Stage_Backlog ; backlog:owesClass backlog:AcceptanceCriterion ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "How will anyone know the work is done? A backlog of items with no acceptance criteria can be signed off without anyone able to say what was signed off (the Specification class definition says the same of specifications)." .
backlog:Ob_Task_Design_Model a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfTaskType backlog:Task_DesignDefinition ; backlog:owesClass backlog:ModelArtifact ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "A design-definition task that is Done and produced no model has designed nothing that anyone else can read. This joins the item's effective Definition of Done rather than adding a second gate." .
backlog:Ob_Task_Architecture_Model a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfTaskType backlog:Task_ArchitectureDefinition ; backlog:owesClass backlog:ModelArtifact ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "As above, for architecture definition: the structure decided must exist as an artifact, not only in the decider's head." .
backlog:Ob_Task_Verification_TestCase a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v1 ;
    backlog:obligationOfTaskType backlog:Task_Verification ; backlog:owesClass backlog:TestCase ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "A verification task that is Done and names no test case has verified nothing a reader can disagree with (the TestCase definition's own point)." .

#################################################################
#  v1.5.0 (2026-09-11) -- OBLIGATION SET 2: EVERY PROCESS OWES WHAT
#  ITS OWN DEFINITION SAYS IT PRODUCES.
#
#  The first set (OS_SDLC_v1) covered three of the corpus's fourteen
#  ISO/IEC 12207 task types, four of its fourteen UML model kinds and
#  none of its five design concerns. It was built from the owner's
#  ILLUSTRATION of the problem -- "use cases, main and alternative
#  scenarios, activity diagrams, sequence diagrams, domain classes" --
#  and treated that sentence as the specification instead of reading
#  the corpus. The owner's correction, 2026-09-11: "Our SDLC corpus is
#  quite much more than this and it has been already a part of the
#  methodology. What we need is to enforce the application of them
#  properly."
#
#  So each obligation below is DERIVED, not chosen: the artifact is
#  what the task type's own definition in this TBox says the process
#  produces, and the definition is quoted in the rationale so a reader
#  can check the derivation rather than trust it. Fourteen processes,
#  all covered; the five design concerns obliged through the
#  coversTaskType links the corpus already carried and nothing used.
#
#  Shipped as a SET a lineage adopts at its opening (G91). OS_SDLC_v1
#  is not deleted: a lineage that adopted it keeps what it adopted.
#################################################################
backlog:OS_SDLC_v2 a owl:NamedIndividual , backlog:ObligationSet ;
    rdfs:label "Every engineering process owes its own work product"@en ;
    skos:definition "The complete set: all fourteen ISO/IEC 12207 task types of this corpus owe the artifact their own definition names, the five design concerns oblige the model that records what was analysed, and the pipeline stages keep the obligations of OS_SDLC_v1. Supersedes OS_SDLC_v1 for lineages opened after it ships; a lineage that adopted v1 keeps v1."@en .

backlog:Ob2_MissionAnalysis a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_MissionAnalysis ;
    backlog:owesClass backlog:Specification ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.1 establishes what problem is being solved and why, BEFORE any solution is described. A mission-analysis task that is Done and states no problem has described nothing anyone can disagree with; the Specification is where the problem statement and its interaction steps live." .
backlog:Ob2_StakeholderNeeds a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_StakeholderNeeds ;
    backlog:owesClass backlog:AcceptanceCriterion ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.2 turns what people need into STATED stakeholder requirements. A stated requirement that cannot be checked is a wish; in this corpus the checkable form of a stated requirement is an AcceptanceCriterion with its Given/When/Then." .
backlog:Ob2_RequirementsDefinition a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_RequirementsDefinition ;
    backlog:owesClass backlog:Specification ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.3 states what the system must do to meet the stakeholder requirements. The Specification with its InteractionSteps and their actors IS that statement in this corpus." .
backlog:Ob2_ArchitectureDefinition a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_ArchitectureDefinition ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_ComponentDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.4 establishes the structure: components, their responsibilities and the boundaries between them. Components and boundaries are what a component diagram shows; the earlier obligation asked only for 'a model', which any diagram satisfied." .
backlog:Ob2_ArchitectureDeployment a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_ArchitectureDefinition ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_DeploymentDiagram ;
    backlog:obligationSeverity backlog:Oblig_Advisory ;
    backlog:obligationRationale "6.4.4 again: where the components run is part of the structure when the element is deployed at all. Advisory because a library has no deployment topology, and a diagram demanded for its own sake is the decorative artifact this framework refuses (G7)." .
backlog:Ob2_DesignDefinition a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_DesignDefinition ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_ClassDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.5 provides detail sufficient to implement, within the architecture. Detail sufficient to implement means the classes, their attributes and their associations." .
backlog:Ob2_DesignBehaviour a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_DesignDefinition ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_SequenceDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.5 is also where the five DesignConcerns are analysed, and Concern_Interaction is one of them: the order of messages between participants is not derivable from a class model." .
backlog:Ob2_SystemAnalysis a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_SystemAnalysis ;
    backlog:owesClass backlog:Evidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.6 is analytical work SUPPORTING A DECISION -- trade studies, feasibility, performance modelling. An analysis task that is Done and leaves no evidence has supported a decision nobody can re-examine." .
backlog:Ob2_Implementation a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Implementation ;
    backlog:owesClass backlog:Evidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.7 builds the element. Its definition also names the failure this obligation guards: it is 'the task type most registers record and often the only one, which is why a backlog can look full while every other process is empty'. Implementation owes evidence that what was built exists." .
backlog:Ob2_Integration a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Integration ;
    backlog:owesClass backlog:TestEvidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.8 assembles elements into a working whole, and its definition names the failure exactly: 'a set of correct parts that do not compose'. Only evidence from an actual assembly shows composition; unit-level evidence cannot." .
backlog:Ob2_Verification a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Verification ;
    backlog:owesClass backlog:TestCase ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.9 confirms the element meets its SPECIFIED REQUIREMENTS -- was it built right. A verification task that names no test case has verified nothing a reader can disagree with." .
backlog:Ob2_VerificationEvidence a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Verification ;
    backlog:owesClass backlog:TestEvidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.9 again: a test case that was never run is a plan. The evidence is what distinguishes a run from an intention." .
backlog:Ob2_Validation a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Validation ;
    backlog:owesClass backlog:TestScenario ;
    backlog:owesScenarioKind backlog:Scen_Nominal ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.11 confirms the element serves its INTENDED USE in its intended environment -- was the right thing built, 'the other half of testing, and the one skipped'. Intended use is a scenario walked through, not a requirement checked." .
backlog:Ob2_ValidationEvidence a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Validation ;
    backlog:owesClass backlog:TestEvidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.11: as with verification, the evidence separates a validation that happened from one that was planned." .
backlog:Ob2_Transition a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Transition ;
    backlog:owesClass backlog:DeploymentUnit ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.10 moves the element into operation: deployment, migration, cutover, training. A transition task that is Done and names no deployment unit has moved nothing that can be pointed at." .
backlog:Ob2_Operation a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Operation ;
    backlog:owesClass backlog:Evidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.12 runs the system in service. An operation task owes the record of the running, or the service it claims to provide is unobservable." .
backlog:Ob2_Maintenance a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_MaintenanceTask ;
    backlog:owesClass backlog:Evidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.13 sustains the delivered capability. What was sustained, and against what, is evidence or it is unrecorded." .
backlog:Ob2_Disposal a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Disposal ;
    backlog:owesClass backlog:Evidence ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "6.4.14 retires the element and deals with WHAT IT LEAVES BEHIND. The leavings are the point: a disposal with no record of them is the case this obligation exists for." .
backlog:Ob2_ConcernData a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfConcern backlog:Concern_Data ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_ClassDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "The corpus already links Concern_Data to Task_DesignDefinition. Analysing for data and producing no data model leaves the analysis unrecorded." .
backlog:Ob2_ConcernInterface a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfConcern backlog:Concern_Interface ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_ComponentDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Concern_Interface is linked to design definition and integration; the boundaries analysed are what a component diagram carries." .
backlog:Ob2_ConcernInteraction a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfConcern backlog:Concern_Interaction ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_SequenceDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Concern_Interaction is linked to design definition and validation; the order of messages is what was analysed." .
backlog:Ob2_ConcernArchitecture a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfConcern backlog:Concern_Architecture ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_ComponentDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Concern_Architecture is linked to architecture definition; the structure analysed is the structure drawn." .
backlog:Ob2_ConcernSecurity a backlog:StageObligation ;
    backlog:owesLevel backlog:Level_Design ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfConcern backlog:Concern_Security ;
    backlog:owesClass backlog:ModelArtifact ;
    backlog:owesKind backlog:Kind_StateMachineDiagram ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Concern_Security is linked to design definition and verification; what a system permits and refuses in each state is a state machine, and 'we considered security' without one is the empty claim this obligation guards." .
# the five pipeline-stage obligations of OS_SDLC_v1 hold in v2 unchanged
backlog:Ob_Scope_DomainEntity backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Scope_Blueprint backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Goal_Specification backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Goal_ScenarioNominal backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Goal_ScenarioRejection backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Goal_UseCaseDiagram backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Objective_ActivityDiagram backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Objective_SequenceDiagram backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Backlog_ClassDiagram backlog:inObligationSet backlog:OS_SDLC_v2 .
backlog:Ob_Backlog_Criterion backlog:inObligationSet backlog:OS_SDLC_v2 .

#################################################################
#  v1.6.0 (2026-09-11) -- THE LEVELS SEPARATED, AND THE ANALYSIS WORK
#  THE FIRST SET NEVER ASKED FOR. Each row below is the analysis-level
#  counterpart the corpus names beside a design-level artifact the set
#  already required, or the interface work it ignored entirely.
#################################################################
backlog:Ob2_DomainModel a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_SystemAnalysis ;
    backlog:owesClass backlog:ModelArtifact ; backlog:owesKind backlog:Kind_ClassDiagram ;
    backlog:owesLevel backlog:Level_Analysis ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "The corpus names Domain Model Class Diagram and Design Class Diagram as different artifacts. The domain model states the classes as the business names them, before any solution; without this obligation the design class diagram satisfied both and the domain was never analysed on its own terms." .
backlog:Ob2_SystemSequence a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_RequirementsDefinition ;
    backlog:owesClass backlog:ModelArtifact ; backlog:owesKind backlog:Kind_SequenceDiagram ;
    backlog:owesLevel backlog:Level_Analysis ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "System Sequence Diagram in the corpus: the actor and the system as a black box, which is what a requirement describes. Distinct from the design-level sequence diagram, where objects exchange messages inside the system." .
backlog:Ob2_EventTable a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_SystemAnalysis ;
    backlog:owesClass backlog:Evidence ; backlog:obligationSeverity backlog:Oblig_Advisory ;
    backlog:obligationRationale "Event Table in the corpus: the business events the system must respond to, listed before any state machine is drawn. Advisory because a system with one trigger can say so in its specification, and a table demanded for its own sake is decoration (G7)." .
backlog:Ob2_SpecBrief a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_StakeholderNeeds ;
    backlog:owesClass backlog:Specification ; backlog:owesDepth backlog:Depth_Brief ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Brief Use Case Description in the corpus: a few sentences, enough to size and prioritise, appropriate while the set of use cases is still moving." .
backlog:Ob2_SpecFullyDeveloped a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_Implementation ;
    backlog:owesClass backlog:Specification ; backlog:owesDepth backlog:Depth_FullyDeveloped ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Fully Developed Use Case Description in the corpus: preconditions, trigger, numbered main flow with actors, alternative and exception flows, postconditions. It is what someone builds from, so implementation is where it is owed -- and why a brief must not discharge it." .
backlog:Ob2_DataModelAnalysis a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfTaskType backlog:Task_SystemAnalysis ;
    backlog:owesClass backlog:DomainEntity ; backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "Entity-Relationship Diagram in the corpus sits at analysis, against Relational Table and Database Schema at design. The register's own DomainEntity individuals are the governed index into the analysis-level data model." .
backlog:Ob2_ConcernUI a backlog:StageObligation ;
    backlog:inObligationSet backlog:OS_SDLC_v2 ;
    backlog:obligationOfConcern backlog:Concern_Interface_UI ;
    backlog:owesClass backlog:ModelArtifact ; backlog:owesLevel backlog:Level_Design ;
    backlog:obligationSeverity backlog:Oblig_Required ;
    backlog:obligationRationale "The corpus treats interface design as first-class -- UI Storyboard, UI Mockup, UI Prototype, UI Design Model, User Interface Dialog -- and the five existing concerns cover none of it. Declaring that the interface was designed and producing nothing that shows the screens and their flow is the empty claim this obligation guards." .


# ---- the severity audit of 2026-09-09, one record per audited shape (from the severity-promotion overlay's G90 lines)
backlog:SeverityPromotion_HorizonCoherenceAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: HorizonCoherenceAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:HorizonCoherenceAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 issue (2026-09-09): a Now-horizon item that is not Ready makes the horizon claim false now." .
backlog:SeverityPromotion_StaleVerificationAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: StaleVerificationAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:StaleVerificationAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): Evidence marked verified with no date and no method breaks the evidence rule: a claim of checking that cannot" .
backlog:SeverityPromotion_IntentTraceabilityAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: IntentTraceabilityAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:IntentTraceabilityAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): An item advancing no recorded objective breaks the traceability the ceremony requires: intent -> objective ->" .
backlog:SeverityPromotion_UndeclaredContainerDependencyAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: UndeclaredContainerDependencyAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:UndeclaredContainerDependencyAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): A cross-container dependency not declared at container level breaks the dependency-declaration rule." .
backlog:SeverityPromotion_WipBreachAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: WipBreachAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:WipBreachAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 issue (2026-09-09): a DECLARED limit is already exceeded; the limit describes the overrun instead of constraining it." .
backlog:SeverityPromotion_StoryFormAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: StoryFormAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:StoryFormAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): A story without its benefit clause is not a story in this framework's own definition (asRole/wantsCapability/s" .
backlog:SeverityPromotion_StaleForecastAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: StaleForecastAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:StaleForecastAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 issue (2026-09-09): the forecast date has passed with work still open -- the forecast HAS been missed, not risks being." .
backlog:SeverityPromotion_LineageDepthAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: LineageDepthAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:LineageDepthAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): A register of epics with nothing beneath them schedules nothing; the ceremony requires decomposition." .
backlog:SeverityPromotion_OpenIterationBaselineAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: OpenIterationBaselineAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:OpenIterationBaselineAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): An open iteration with a planned window and no PlanBaseline breaks the baseline rule; later change becomes unm" .
backlog:SeverityPromotion_StoryReadyToCloseShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: StoryReadyToCloseShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:StoryReadyToCloseShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): Every task Done and the story not moved is a state the register must not hold; the item-level state rule is br" .
backlog:SeverityPromotion_IterationEndedIncompleteShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: IterationEndedIncompleteShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:IterationEndedIncompleteShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): A story left unfinished in an ended iteration must be carried forward or recovered; leaving it is the rule bro" .
backlog:SeverityPromotion_BatchCompleteButNotDoneShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: BatchCompleteButNotDoneShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:BatchCompleteButNotDoneShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): hasBatchCompleted equal to hasBatchSize with hasState not Done is a contradiction between two asserted facts." .
backlog:SeverityPromotion_BatchStartedStateStaleShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: BatchStartedStateStaleShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:BatchStartedStateStaleShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): Verified work recorded against an item still Proposed/Ready is the same contradiction one step earlier." .
backlog:SeverityPromotion_HarnessCoverageAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: HarnessCoverageAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:HarnessCoverageAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): A harness that leaves a criterion unattested breaks the attestation rule the harness exists to satisfy." .
backlog:SeverityPromotion_LegacyOrderAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: LegacyOrderAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:LegacyOrderAdvisoryShape ;
    backlog:promotedSeverity sh:Warning ; backlog:promotionRationale "G90 risk (2026-09-24, owner criterion applied): the shape's own message states a scope written after its objectives is a real record and not an error (scope-last is a recognised lineage adaptation); no rule is broken, the risk is a boundary that never refuses anything. First-pass promotion reverted." .
backlog:SeverityPromotion_PbiKindAdvisoryShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: PbiKindAdvisoryShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:PbiKindAdvisoryShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 issue (2026-09-09): an epic carrying an initiative kind is already mis-typed." .
backlog:SeverityPromotion_MissionReachShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: MissionReachShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:MissionReachShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): A mission no goal contributes to breaks the chain: the ceremony requires goals derived from the mission's scop" .
backlog:SeverityPromotion_RoadmapIntentShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: RoadmapIntentShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:RoadmapIntentShape ;
    backlog:promotedSeverity sh:Violation ; backlog:promotionRationale "G90 rule (2026-09-09): A roadmap realising no objective breaks the roadmap-to-intent rule." .
backlog:SeverityPromotion_UnaddressedRefinementShape a backlog:SeverityPromotion ; rdfs:label "Severity promotion: UnaddressedRefinementShape"@en ;
    backlog:promotionInRuleSet backlog:RS_SeverityAudit_20260909 ; backlog:promotesShape backlog:UnaddressedRefinementShape ;
