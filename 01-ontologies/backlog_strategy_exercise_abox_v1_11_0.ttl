    backlog:restartedAtCommit "backlog-roadmap-framework-v1.223.0 (tag; witnessed by git, not asserted)" ;
    backlog:decidedBy backlog:Owner ; backlog:belongsToLineage ex:TS_Lin ;
    backlog:hasRationale "Transform, instance simplification: TS_SC (previous commit, 4f97e0a) narrowed the scope to TS_D1 before this restart; the git witness must read the ScopeChange strictly before the restart." .
ex:TS_S_PL backlog:preLineageItem true .
ex:TS_EP backlog:preLineageItem true .
