#################################################################
#  v1.2.0 (2026-09-07, brsf-session) -- FIVE RESTARTS, one strategy each,
#  in their own commit after the findings (4f97e0a). Every item of
#  every toy lineage flagged pre-lineage (RestartFlagsEveryItemShape).
#################################################################
ex:Restart_TF a backlog:LineageRestart ; backlog:restartsLineage ex:TF_Lin ; backlog:answersBypass ex:Bypass_TF_Lin_20260907 ;
    backlog:hasRecoveryStrategy backlog:Strat_DecreaseByFactor ;
    backlog:restartedAtCommit "backlog-roadmap-framework-v1.223.0 (tag; witnessed by git, not asserted)" ;
    backlog:decidedBy backlog:Owner ; backlog:belongsToLineage ex:TF_Lin ;
    backlog:hasRationale "Decrease by a constant factor: the first rebuild will deliberately admit only ONE of the two items (TF_S_PL), so that the second trial's reductionObserved sits exactly at the 0.5 boundary the strategy requires -- exercising the boundary, not avoiding it." .
ex:TF_S_PL backlog:preLineageItem true .
ex:TF_EP backlog:preLineageItem true .
ex:Restart_TV a backlog:LineageRestart ; backlog:restartsLineage ex:TV_Lin ; backlog:answersBypass ex:Bypass_TV_Lin_20260907 ;
    backlog:hasRecoveryStrategy backlog:Strat_VariableDecrease ;
    backlog:restartedAtCommit "backlog-roadmap-framework-v1.223.0 (tag; witnessed by git, not asserted)" ;
    backlog:decidedBy backlog:Owner ; backlog:belongsToLineage ex:TV_Lin ;
    backlog:hasRationale "Variable-size decrease: the first rebuild admits both items; the comparison this strategy tests (reduction not smaller than the previous restart's) needs a third trial, which will be disclosed as the limit reached if the exercise stops at two." .
ex:TV_S_PL backlog:preLineageItem true .
ex:TV_EP backlog:preLineageItem true .
