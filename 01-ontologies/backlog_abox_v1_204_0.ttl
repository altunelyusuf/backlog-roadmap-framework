    backlog:areaMeasure "Read 2026-11-05 from two handovers of another package, not reproduced here: the validator reports a complete scope as having no derived outcome when the container is Done and not when it is in progress." ;
    backlog:hasScopeLayer backlog:Layer_Product ; backlog:areaLocation "03-tooling/, 02-shacl-safeguards/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Area_IK_Tools a backlog:ScopeArea ; rdfs:label "Area: Tools for other registers: the date planner and the box tool work on the register of any package and the planner has a first pace of its own"@en ;
    backlog:areaMeasure "Counted 2026-11-05: the framework's own prefix is written literally 6 times in the date planner and 132 times in the box tool; the planner stops when a register has no pair of consecutive boxes with effort." ;
    backlog:hasScopeLayer backlog:Layer_Product ; backlog:areaLocation "03-tooling/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Area_IK_MissionChange a backlog:ScopeArea ; rdfs:label "Area: Mission replacement: the mission of a running lineage can be replaced by a recorded route that keeps the stage digests"@en ;
    backlog:areaMeasure "Counted 2026-11-05: 0 recorded routes; the vocabulary declares no property for replacing a mission, and the scope change admits growth only." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "01-ontologies/, 04-documentation/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
