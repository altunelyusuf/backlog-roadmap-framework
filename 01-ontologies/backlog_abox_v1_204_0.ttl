    backlog:enforcedByShape backlog:FlowPointPrecisionShape , backlog:FlowPointsMatchHistoryShape , backlog:StartNotRecordedShape , backlog:StateHistoryShape , backlog:StatusGapShape , backlog:StatusMomentShape , backlog:StatusUnrecordedShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G113; shapes linked in G164." .

fw:Ruling_G114 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G114" ;
    rdfs:label "A shape does not judge order from the text of two commit names"@en ;
    backlog:hasRulingStatement "A shape does not judge order from the text of two commit names" ;
    backlog:enforcedByShape backlog:StageOrderWitnessShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G114; shapes linked in G164." .

fw:Ruling_G115 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G115" ;
    rdfs:label "The routes a typed history can still take are closed, and recording is part of whether work may start"@en ;
    backlog:hasRulingStatement "The routes a typed history can still take are closed, and recording is part of whether work may start" ;
    backlog:enforcedByShape backlog:EqualSpanShape , backlog:FirstMoveLeavesProposedShape , backlog:FlowPointsMatchHistoryShape , backlog:FlowPointsOnlyWhenStartedShape , backlog:SingleValuedFlowPointShape , backlog:StateHistoryShape , backlog:StatusUnrecordedShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v125.0.0, section G115; shapes linked in G164." .

fw:Ruling_G116 a backlog:GovernanceRuling ;
