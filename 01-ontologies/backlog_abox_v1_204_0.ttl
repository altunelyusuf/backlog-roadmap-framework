fw:Ruling_G183 a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "G183" ;
    rdfs:label "The agentic adaptive profile is the default, after a live run under it"@en ;
    backlog:hasRulingStatement "The agentic adaptive profile (AAL) is marked as the default profile: a lineage opened with no named profile opens with it. The mark follows a live run: a lineage was opened, run in boxes and closed under AAL, every box closed by the step tool with a verifying agent that did not do the work, and the register holds no violation. The standard, agentic and non-agentic adaptive profiles are unchanged." ;
    backlog:enforcedByShape backlog:DefaultProfileShape ;
    backlog:rulingSource "LINEAGE_OPERATING_DISCIPLINE v147.0.0, section G183." .
