    rdfs:label "The shipped data file binds nobody who did not adopt; an organisation is a human team; a person holds a role"@en ;
    backlog:hasRulingStatement "The shipped data file binds nobody who did not adopt; an organisation is a human team; a person holds a role" ;
    backlog:enforcedByShape backlog:EqualSpanShape , backlog:OrganisationIsTeamShape , backlog:TeamShape ;
