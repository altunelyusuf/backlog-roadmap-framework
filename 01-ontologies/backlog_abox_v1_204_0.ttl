    backlog:hasBaselineValue "2"^^xsd:decimal ; backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Decrease ; backlog:hasCheckpoint fw:CP_IK_Duality ;
