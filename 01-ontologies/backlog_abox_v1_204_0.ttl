    rdfs:label "Objective (sixth chain): Checks of live lineages that fail after the seven archivable lineages are set down"@en ;
    backlog:contributesToGoal fw:Goal_IK_GvKeep6 ; backlog:fillsScope fw:Scope4_ImpedimentsKnown ;
    backlog:hasSuccessMetric fw:Metric_IK_GvKeep6 ; backlog:hasMeasurementKind backlog:Meas_Counted ;
