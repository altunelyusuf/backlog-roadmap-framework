fw:Ev_IK_FixKinds a backlog:TestEvidence ; rdfs:label "The check for story FixKinds"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "FixKinds" ;
    backlog:hasTestSpec "03-tooling/backlog_finding_kind_probe_v1_0_0.py" ;
    backlog:attestsCriterion fw:AC_IK_FixKinds ;
    backlog:hasVerificationMethod "Each of the 105 findings recorded before Lineage 29 closed was read for the kind of obstacle that is its root cause: 76 that had none were given one, three whose recorded kind was wrong are read as another kind through a new link (readAsKind) beside the recorded one, which stays because a committed record is never edited. A second reader classified all 105 without seeing the first reading; 77 agreed, and 15 of the first reading's kinds were changed after the comparison. The probe counts findings with no kind, a kind outside the seven and the readings, and runs four mutants." ;
    backlog:verifiedAt "2026-11-04T13:03:46Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_finding_kind_probe v1.0.0, vocabulary 1.168.0" ;
