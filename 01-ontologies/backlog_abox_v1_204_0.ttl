    backlog:areaMeasure "Counted 2026-11-02: no tool raises, advises on or clears an impediment; the agent monitor reports an item stalled after 24 hours while a box of agents lasts minutes; no blocked state exists." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_ImpedimentsKnown .
