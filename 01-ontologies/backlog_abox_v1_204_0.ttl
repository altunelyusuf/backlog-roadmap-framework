# ---- Change request of Lineage 32 (box 2): packages are scoped from selected backlog items; routed by the Owner's instruction of 2026-11-07 19:57 Istanbul ----
fw:CR_RNP_Selection a backlog:ChangeRequest ; rdfs:label "Grow the scope of Lineage 32: packages are scoped from selected backlog items, the whole backlog is covered, and sprints consume a package's scope"@en ;
    backlog:requestsChangeTo fw:Scope_RoadmapNeedsPackages ;
    backlog:hasChangeDirection backlog:Direction_Grow ;
    backlog:hasChangeRequestRationale "The Owner instructed on 2026-11-07 at 19:57 Istanbul that packages are scoped with selected backlog items, sprints are planned to consume package scope so that finishing a package's sprints leaves the whole package ready, the whole backlog is implemented by packages, and the choice of items rests on priority, cohesion, technical requirements and business value, ontology-native. Release 5.5.2 requires only that deliverables sit in packages; it does not cover backlog items, record the values a package is chosen by, order packages by dependency, derive readiness or tie a sprint to one package. A survey of release-planning practice (Scrum, SAFe, story mapping, PMI, WSJF, MoSCoW, Kano) gave the criteria; its sources were not opened and are to be checked." ;
    backlog:supportsObjective fw:Obj_RNP_Mission ;
    backlog:belongsToLineage fw:L_RoadmapNeedsPackages ;
    backlog:hasDisposition backlog:Disp_Accepted .
fw:IA_RNP_Selection a backlog:ImpactAssessment ; rdfs:label "Impact of growing the scope of Lineage 32 by the package-scoping rules"@en ;
    backlog:analyzesRequest fw:CR_RNP_Selection ;
    backlog:affectsGoal fw:Goal_RNP_Count , fw:Goal_RNP_Roadmap , fw:Goal_RNP_Sprint ;
    backlog:hasImpactStatement "Measured on 2026-11-07: the register holds 55 stories (all lineages) and 3 packages, all of this lineage; the count tool groups deliverables, not items. The scope gains four deliverables under three existing areas (no area is added), three goals and three objectives; the eight objectives and five stories already there are not changed. Paid for by time only: no item is removed. Release 5.5.3 follows." ;
    backlog:callsForItem fw:ST_RNP_Coverage ;
    backlog:callsForItem fw:ST_RNP_Selection ;
    backlog:callsForItem fw:ST_RNP_Forward ;
    backlog:callsForItem fw:ST_RNP_SprintScope .

# deliverables

fw:Del_RNP_D6 a backlog:ScopeDeliverable ; rdfs:label "A shape refuses a backlog item of an adopting lineage that is in no package or in two, and a probe holds it"@en ;
    backlog:deliverableForArea fw:Area_RNP_Count ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "Every item of the backlog is implemented through a package" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D7 a backlog:ScopeDeliverable ; rdfs:label "Each backlog item records priority tier, business value, cohesion group and technical prerequisite as values, and a shape refuses one without them"@en ;
    backlog:deliverableForArea fw:Area_RNP_Count ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "The number of packages is measured from its scope, goals, objectives and backlog" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D8 a backlog:ScopeDeliverable ; rdfs:label "A shape refuses an item that depends on an item of a later package, and a package's readiness is derived from its items, never set by hand"@en ;
    backlog:deliverableForArea fw:Area_RNP_Roadmap ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "A roadmap is built from packages" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D9 a backlog:ScopeDeliverable ; rdfs:label "A shape refuses an iteration that plans items of more than one package, and a package is ready when the iterations that consume it are done"@en ;
    backlog:deliverableForArea fw:Area_RNP_Sprint ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "Sprints are planned to match those packages" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Goal_RNP_Coverage a backlog:Goal ; rdfs:label "A planner is told at once when a backlog item of an adopting lineage belongs to no package or to two"@en ;
    backlog:contributesToMission fw:Mission_RoadmapNeedsPackages ; backlog:derivesFromScope fw:Scope_RoadmapNeedsPackages ; backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea fw:Area_RNP_Count ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages ; backlog:decidedBy backlog:Owner .
fw:Goal_RNP_Selection a backlog:Goal ; rdfs:label "A planner can see why each item sits in its package: its priority tier, business value, cohesion group and technical prerequisite"@en ;
    backlog:contributesToMission fw:Mission_RoadmapNeedsPackages ; backlog:derivesFromScope fw:Scope_RoadmapNeedsPackages ; backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea fw:Area_RNP_Count ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages ; backlog:decidedBy backlog:Owner .
fw:Goal_RNP_Readiness a backlog:Goal ; rdfs:label "A package is ready exactly when its items are Done, in an order that never leans on a later package, and its sprints take their items from it alone"@en ;
    backlog:contributesToMission fw:Mission_RoadmapNeedsPackages ; backlog:derivesFromScope fw:Scope_RoadmapNeedsPackages ; backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea fw:Area_RNP_Roadmap ; backlog:goalCoversArea fw:Area_RNP_Sprint ;
