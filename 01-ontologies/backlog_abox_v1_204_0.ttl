    backlog:contributesToMission fw:Mission_ImpedimentsKnown ; backlog:derivesFromScope fw:Scope4_ImpedimentsKnown ; backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea fw:Area_IK_MissionChange ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:producedByStage fw:Out_Goal4_ImpedimentsKnown ; backlog:belongsToLineage fw:L_ImpedimentsKnown ; backlog:decidedBy backlog:Owner .
