# ---- Lineage 32: Mission stage ----
fw:Mission_RoadmapNeedsPackages a backlog:Mission ; rdfs:label "Mission: a roadmap is built from packages"@en ;
    backlog:hasMissionOutcome backlog:Out_Achieved ;
    backlog:hasMissionStatement "A roadmap is built from packages: it must name what is deployed when and with which items, and sprints are planned to match those packages. Even the simplest lineage has at least one package, and the number of packages is measured from its scope, goals, objectives and backlog." ;
    backlog:missionFor fw:Register ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-11-07 14:13, 14:33 and 15:23, on the finding of the 2SISA session: a roadmap that names no package validates clean. A package is a planning subject, not only a deployment one; without the packages that say what is deployed when and with which items, sprints cannot be rationally defined, and without packages no roadmap is possible. At least one rule is for the simplest form of a lineage; the number of packages is measured from the scope, goals, objectives and backlog. Gap verified 2026-11-07: the roadmap shape asks only for a backlog, no shape asks a roadmap to name a package, and the 2SISA roadmap validates clean with none." ;
    backlog:producedByStage fw:Out_Mission_RoadmapNeedsPackages ;
    backlog:decidedBy backlog:Owner .

fw:Out_Mission_RoadmapNeedsPackages a backlog:StageOutput ;
    backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages ;
    backlog:hasStateDigest "2820d78a662bd76fcc5279f1050dcce6dfc91fbbaf6b55af4ee70fbbeb9e66f2" ;
    backlog:closedAtCommit "35167883615ca9c938b9ce479ecdd1989893fb29" ;
    backlog:hasRationale "Mission stage of Lineage 32, an urgent lineage opened by the pause of Lineage 29. Stage 1 of 5, one commit on the work branch each." .

# ---- Lineage 32: Scope stage ----
fw:Scope_RoadmapNeedsPackages a backlog:ScopeStatement ; rdfs:label "Scope: a roadmap is built from packages"@en ;
    backlog:hasScopeStatementText "Make the packages of a roadmap a thing the framework requires and measures, and nothing else: (1) a roadmap names at least one package and the simplest lineage has exactly one; (2) the number of packages is computed from the scope, goals, objectives and backlog of the lineage, and every scope deliverable is delivered by a package; (3) an iteration is planned to match a package, so the items it plans trace to one." ;
    backlog:scopeForMission fw:Mission_RoadmapNeedsPackages ;
    backlog:producedByStage fw:Out_Scope2_RoadmapNeedsPackages ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_RNP_D1 , fw:Del_RNP_D2 , fw:Del_RNP_D3 , fw:Del_RNP_D4 , fw:Del_RNP_D5 ;
    backlog:coversArea fw:Area_RNP_Roadmap , fw:Area_RNP_Count , fw:Area_RNP_Sprint ;
    backlog:hasScopeExclusion fw:Ex_RNP_Others , fw:Ex_RNP_Planning , fw:Ex_RNP_Deploying ;
    backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Area_RNP_Roadmap a backlog:ScopeArea ; rdfs:label "Area: Roadmap: a roadmap names the packages it groups the work into, down to the simplest lineage"@en ;
    backlog:areaMeasure "Counted 2026-11-07: 0 shapes require a package of a roadmap; the one roadmap handed over by the 2SISA session names no package and validates clean." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/fixtures/" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Area_RNP_Count a backlog:ScopeArea ; rdfs:label "Area: Count: the number of packages is measured from the chain and every deliverable is in a package"@en ;
    backlog:areaMeasure "Counted 2026-11-07: 0 measures of the package count exist; the register holds scope deliverables that no package delivers." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "02-shacl-safeguards/, 03-tooling/, 04-documentation/" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Area_RNP_Sprint a backlog:ScopeArea ; rdfs:label "Area: Sprint: an iteration is planned to match a package"@en ;
    backlog:areaMeasure "Counted 2026-11-07: 0 shapes tie the items an iteration plans to a package." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "02-shacl-safeguards/, 03-tooling/fixtures/" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D1 a backlog:ScopeDeliverable ; rdfs:label "A shape refuses a roadmap that names no package of its lineage, and a probe holds it"@en ;
    backlog:deliverableForArea fw:Area_RNP_Roadmap ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "A roadmap is built from packages" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D2 a backlog:ScopeDeliverable ; rdfs:label "A shape refuses a lineage with a backlog but no package; the simplest lineage has exactly one package that delivers all its deliverables"@en ;
    backlog:deliverableForArea fw:Area_RNP_Roadmap ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "Even the simplest lineage has at least one package" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D3 a backlog:ScopeDeliverable ; rdfs:label "The number of packages of a lineage is computed from its scope, goals, objectives and backlog, shown in the roadmap report, and a shape refuses a package that traces to none of them"@en ;
    backlog:deliverableForArea fw:Area_RNP_Count ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "The number of packages is measured from its scope, goals, objectives and backlog" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D4 a backlog:ScopeDeliverable ; rdfs:label "A shape refuses a scope deliverable that no package delivers, once the lineage has a backlog"@en ;
    backlog:deliverableForArea fw:Area_RNP_Count ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "It must name what is deployed when and with which items" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Del_RNP_D5 a backlog:ScopeDeliverable ; rdfs:label "A shape refuses an iteration whose planned items trace to no package of the roadmap"@en ;
    backlog:deliverableForArea fw:Area_RNP_Sprint ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "Sprints are planned to match those packages" ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Ex_RNP_Others a backlog:ScopeExclusion ; rdfs:label "Exclusion: Roadmaps of other packages"@en ;
    backlog:excludesConcern "Rebuilding the roadmaps that other packages already hold." ;
    backlog:hasExclusionRationale "Each package rebuilds its own roadmap after the release, by its own session." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Ex_RNP_Planning a backlog:ScopeExclusion ; rdfs:label "Exclusion: Other planning branches"@en ;
    backlog:excludesConcern "Cost, risk, benefit and capacity planning of a roadmap." ;
    backlog:hasExclusionRationale "They are other branches of the governance of lineages and enter by change management of that lineage." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .
fw:Ex_RNP_Deploying a backlog:ScopeExclusion ; rdfs:label "Exclusion: Deploying"@en ;
    backlog:excludesConcern "Carrying out a deployment of a package." ;
    backlog:hasExclusionRationale "A package is a planning subject here; no deployment is performed by this lineage." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Work ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages .

