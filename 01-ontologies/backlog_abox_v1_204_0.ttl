    backlog:areaMeasure "Counted 2026-11-05: 63 corrections of committed records are held only as an appended comment; the vocabulary declares no withdrawal property (retraction exists for stage outputs only)." ;
    backlog:hasScopeLayer backlog:Layer_Product ; backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
