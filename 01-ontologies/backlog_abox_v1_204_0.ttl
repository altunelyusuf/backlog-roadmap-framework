    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:producedByStage fw:Out_Goal3_RoadmapNeedsPackages ; backlog:belongsToLineage fw:L_RoadmapNeedsPackages ; backlog:decidedBy backlog:Owner .

