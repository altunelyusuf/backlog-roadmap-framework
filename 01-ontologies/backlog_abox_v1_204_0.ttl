fw:Find_IK_KindsAreReadings a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:relatesToWorkItem fw:ST_IK_FixKinds ;
    backlog:hasRootCause "The kind of a finding is a reading of text: a second reader agreed with the first on 77 of 105, and 15 kinds were changed after the comparison; three findings name no obstacle at all and carry the nearest kind." ;
    backlog:hasRemedy "Stated in the narrative; the kinds can be read again by appending a reading." .
