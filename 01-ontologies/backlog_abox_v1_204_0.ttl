    backlog:analyzesRequest fw:CR_C29_ScopeGrows ;
    backlog:hasImpactStatement "Computed from the register on 2026-11-04: 15 verified findings (13 of Lineage 29, 2 of Lineage 28) lie outside the scope of four areas and five exclusions. The grown scope has eight areas (four kept, four new), eleven deliverables (seven new) and the five exclusions kept. The Scope, Goal, Objective and Backlog outputs are replaced by a stage revision from the Scope stage; the Mission and the four satisfied deliverables stand. No other lineage is touched: Lineages 30 and 31 are finished and none is active." .
fw:SRev2_ImpedimentsKnown a backlog:StageRevision ; rdfs:label "Second stage revision of Lineage 29: the chain is rebuilt from the Scope stage, derived from the scope taxonomy"@en ;
    backlog:revisesLineage fw:L_ImpedimentsKnown ;
    backlog:revisesFromStage backlog:Stage_Scope ;
    backlog:revisionReason "The scope grows by the verified gaps against the mission, which the first revision derived from a list of gaps and not from the scope taxonomy (the Owner, 2026-11-03: every scope item answered by its own goal, the metrics derived from the goals). The Mission stands. The Scope, Goal, Objective and Backlog are rebuilt, one commit per stage." ;
    backlog:retractsOutput fw:Out_Scope_ImpedimentsKnown , fw:Out_Goal_ImpedimentsKnown ;
    backlog:decidedBy backlog:Owner .
fw:Out_Scope_ImpedimentsKnown backlog:outputRetracted true .
fw:Out_Goal_ImpedimentsKnown backlog:outputRetracted true .

# ---- Lineage 29: Scope stage, rebuilt from the scope taxonomy ----
fw:Scope2_ImpedimentsKnown a backlog:ScopeStatement ; rdfs:label "Scope: the obstacles and the ways to clear them, and the gaps verified against the mission"@en ;
    backlog:hasScopeStatementText "Name the obstacles and the ways to clear them and show it in use: the kinds and ways of the first scope are corrected and completed; an obstacle is recorded when it is met and attached to its box; a blocked agent is shown raising, advising on and clearing a real obstacle in a box; the rules about obstacles and about the scope taxonomy are checked; the forecast discussion is recorded and the dates report does not stop; the grantor of the reviewers' access is reconciled. Nothing else." ;
    backlog:scopeForMission fw:Mission_ImpedimentsKnown ; backlog:producedByStage fw:Out_Scope2_ImpedimentsKnown ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:requiresDeliverable fw:Del_IK_D1 , fw:Del_IK_D2 , fw:Del_IK_D3 , fw:Del_IK_D4 , fw:Del_IK_D5 , fw:Del_IK_D6 , fw:Del_IK_D7 , fw:Del_IK_D8 , fw:Del_IK_D9 , fw:Del_IK_D10 , fw:Del_IK_D11 ;
    backlog:coversArea fw:Area_IK_Kind , fw:Area_IK_Method , fw:Area_IK_Record , fw:Area_IK_Kept , fw:Area_IK_Live , fw:Area_IK_Enforce , fw:Area_IK_Reports , fw:Area_IK_Account ;
    backlog:hasScopeExclusion fw:Ex_IK_Others , fw:Ex_IK_Packages , fw:Ex_IK_Past , fw:Ex_IK_Risks , fw:Ex_IK_People ;
    backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Area_IK_Live a backlog:ScopeArea ; rdfs:label "Area: Live use: a blocked agent raises an obstacle, chooses a way and is unblocked in a box"@en ;
    backlog:areaMeasure "Counted 2026-11-04: 0 obstacles raised, advised on and cleared live in a box; all five objectives of Lineage 29 were read from counts of its own work (achievement status Retrospective)." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Area_IK_Enforce a backlog:ScopeArea ; rdfs:label "Area: Enforcement: the rules about obstacles and about the scope taxonomy are checked"@en ;
    backlog:areaMeasure "Counted 2026-11-04: 4 open: the shapes that refuse an obstacle with no kind have never fired on real data; the release preflight does not run the vocabulary probe; the scope taxonomy has no parent-child link; nothing checks that every scope item is answered by a goal." ;
    backlog:hasScopeLayer backlog:Layer_Product ; backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Area_IK_Reports a backlog:ScopeArea ; rdfs:label "Area: Reports: the forecast discussion and the dates report"@en ;
    backlog:areaMeasure "Counted 2026-11-04: 2 open: nothing records that the forecast of a lineage was discussed before its dates were final; the dates report stops with an error on malformed input." ;
    backlog:hasScopeLayer backlog:Layer_Product ; backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Area_IK_Account a backlog:ScopeArea ; rdfs:label "Area: Accountability: who grants the reviewers their access"@en ;
    backlog:areaMeasure "Counted 2026-11-04: 1 open: the agent is recorded as grantor of the reviewers' access (3 grants), the Owner ruled it stays, and whether this agrees with the Agentic-Systems rule has not been analysed." ;
    backlog:hasScopeLayer backlog:Layer_Work ; backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/, 06-package-provenance/" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Del_IK_D5 a backlog:ScopeDeliverable ; rdfs:label "5.1 A blocked agent raises an obstacle in a box, is advised of a way for its kind, clears it with that way and is unblocked while working, all recorded when it happens"@en ;
