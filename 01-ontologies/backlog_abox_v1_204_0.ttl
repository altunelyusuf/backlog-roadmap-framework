    backlog:areaMeasure "The standard, agentic and non-agentic adaptive profiles and every closed lineage are as they were." ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "01-ontologies/, 02-shacl-safeguards/, 03-tooling/, 04-documentation/" ;
    backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Del_IK_D1 a backlog:ScopeDeliverable ; rdfs:label "A closed set of kinds of obstacle, drawn from the obstacles met in Lineages 21 to 28 and in the sessions of this package, each defined with an example; an impediment names one kind and a shape refuses one that names none in a lineage that adopts the rule set; every one of the 30 findings fits a kind, held by a classification file and a probe"@en ;
    backlog:deliverableForArea fw:Area_IK_Kind ; backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:derivesFromMissionClause "An obstacle has a kind from a known set" ;
    backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Del_IK_D2 a backlog:ScopeDeliverable ; rdfs:label "For each kind the resolution methods known for it, each defined and none a bypass of a rule; a cleared impediment names the method used; a shape refuses a cleared impediment that names none; a probe holds it"@en ;
