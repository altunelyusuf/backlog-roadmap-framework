fw:Ev_IK_GovernorLink a backlog:TestEvidence ; rdfs:label "The check for story GovernorLink"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "GovernorLink" ;
    backlog:hasTestSpec "02-shacl-safeguards/backlog_shacl_v1_217_0.ttl" ;
    backlog:attestsCriterion fw:AC_IK_GovernorLink ;
    backlog:hasVerificationMethod "A lineage now has a role, governance or production, and a governance lineage governs a production lineage by one typed link. The vocabulary has the role, the role statement and the governing link; a new rule set RS_GovernanceRequired, in a new profile revision of the agentic adaptive profile, binds lineages opened under it. Seven checks refuse: no role stated, a link between the wrong roles or a lineage to itself, two governors, two roles, a production lineage without a governor, a governance lineage that governs nothing, and a governance lineage opened under revision 17 or later (or stating no revision) that does not adopt the rule set; one warning covers a governance lineage opened earlier. The two existing lineages state their roles and the Governance lineage governs the roadmap lineage." ;
    backlog:verifiedAt "2026-11-09T10:09:12Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_validate v1.19.0 with the new shapes (vocabulary v1.176.0, fixture v1.75.0)" ;
    backlog:satisfiedByArtifact "02-shacl-safeguards/backlog_shacl_v1_217_0.ttl" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:AC_IK_GovernorLink backlog:satisfiedByArtifact "02-shacl-safeguards/backlog_shacl_v1_217_0.ttl" .
