fw:Ev_IK_EpicGroomed a backlog:TestEvidence ; rdfs:label "The check for story EpicGroomed"@en ;
    backlog:evidenceVerified true ; backlog:hasTestId "EpicGroomed" ;
    backlog:hasTestSpec "02-shacl-safeguards/backlog_shacl_v1_218_0.ttl" ;
    backlog:attestsCriterion fw:AC_IK_EpicGroomed ;
    backlog:hasVerificationMethod "An epic is treated as a backlog item that is groomed into stories. In a lineage that adopts the package rules it is no longer asked for a package, a priority score or an impact, and the rule that closes a parent whose children are finished no longer binds it; a new check, EPIC_IN_PACKAGE, refuses an epic that is a member of a package, so its stories are packaged instead. Not changed: the parent-score rule, the refusal of an ungroomed epic, of an epic in an iteration or a deployment unit, and the Definition of Done before decomposing. Two vocabulary errors are corrected: reach, impact, confidence and effort may stand on a work item, and the text of a checkpoint no longer says that a condition and a date exclude each other when the date is a forecast." ;
    backlog:verifiedAt "2026-11-09T13:29:28Z"^^xsd:dateTime ; backlog:verifiedByTool "backlog_validate v1.19.0 with the changed shapes (vocabulary v1.177.0, fixture v1.76.0)" ;
    backlog:satisfiedByArtifact "02-shacl-safeguards/backlog_shacl_v1_218_0.ttl" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:AC_IK_EpicGroomed backlog:satisfiedByArtifact "02-shacl-safeguards/backlog_shacl_v1_218_0.ttl" .
fw:H_IK_EpicGroomed a backlog:TestHarness ; rdfs:label "Harness for story EpicGroomed"@en ;
    backlog:harnessFor fw:ST_IK_EpicGroomed ; backlog:hasHarnessEvidence fw:Ev_IK_EpicGroomed ; backlog:harnessComplete true ;
