    backlog:deliverableForArea fw:Area_IK_Taxonomy ; backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:derivesFromMissionClause "each production lineage adapts this general mission to its mission" ; backlog:belongsToLineage fw:L_ImpedimentsKnown .
fw:Scope4_ImpedimentsKnown backlog:requiresDeliverable fw:Del_IK_D52 .
