fw:Exec_Builder a backlog:Executor_SingleAgent ; rdfs:label "The builder agent: the session that does the work of a box"@en .
fw:Exec_Overseer a backlog:Executor_SingleAgent ; rdfs:label "The overseeing agent: the agent monitor, which reads the register and reports what needs attention"@en .
fw:Exec_Verifier a backlog:Executor_SingleAgent ; rdfs:label "The verifying agent: an agent that did not do the work and judges it against the evidence"@en .
fw:Exec_Approver a backlog:Executor_SingleAgent ; rdfs:label "The approving agent: the register validator, which accepts the box only if the register holds no new violation"@en .


