    owl:priorVersion <http://example.org/backlog-shapes/1.59.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.58.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.57.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.56.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.55.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.54.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.53.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.52.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.51.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.50.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.49.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.48.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.47.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.46.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.45.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.44.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.43.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.42.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.41.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.40.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.39.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.38.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.37.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.36.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.35.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.34.0> ;
