    owl:priorVersion <http://example.org/backlog-shapes/1.69.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.68.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.67.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.66.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.65.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.64.0> ;
