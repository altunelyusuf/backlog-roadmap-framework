    rdfs:label "Backlog & Roadmap Framework — SHACL Safeguards"@en ;
    owl:versionIRI <http://example.org/backlog-shapes/1.86.0> ;
    owl:versionInfo "1.86.0" ;
    owl:priorVersion <http://example.org/backlog-shapes/1.85.0> ;
