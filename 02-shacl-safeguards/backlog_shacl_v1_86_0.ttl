    owl:priorVersion <http://example.org/backlog-shapes/1.32.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.31.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.30.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.29.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.28.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.27.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.26.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.25.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.24.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.23.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.22.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.21.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.20.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.19.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.18.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.17.0> ,
                     <http://example.org/backlog-shapes/1.16.0> ,
                     <http://example.org/backlog-shapes/1.15.1> ,
                     <http://example.org/backlog-shapes/1.15.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.14.0> ,
                     <http://example.org/backlog-shapes/1.13.0> ,
                     <http://example.org/backlog-shapes/1.12.0> ,
                     <http://example.org/backlog-shapes/1.11.0> ,
                     <http://example.org/backlog-shapes/1.10.0> ,
                     <http://example.org/backlog-shapes/1.9.0> ,
                     <http://example.org/backlog-shapes/1.8.0> ,
                     <http://example.org/backlog-shapes/1.7.0> ,
                     <http://example.org/backlog-shapes/1.6.0> ,
                     <http://example.org/backlog-shapes/1.5.0> ,
                     <http://example.org/backlog-shapes/1.4.0> ,
                     <http://example.org/backlog-shapes/1.3.0> ,
                     <http://example.org/backlog-shapes/1.2.0> ,
                     <http://example.org/backlog-shapes/1.1.0> ,
                     <http://example.org/backlog-shapes/1.0.0> ;
    owl:imports <http://example.org/backlog> ;
    dcterms:identifier "backlog-shapes" ;
    dcterms:created "2026-07-27T00:00:00"^^xsd:dateTime ;
    dcterms:modified "2026-07-27T00:00:00"^^xsd:dateTime ;
    dcterms:creator "Yusuf Altunel" ;
    dcterms:publisher "İstanbul Kültür Üniversitesi, Department of Computer Engineering" ;
    dcterms:rightsHolder "İstanbul Kültür Üniversitesi, Department of Computer Engineering" ;
    dcterms:rights "Copyright (c) 2025-2026 İstanbul Kültür Üniversitesi & Yusuf Altunel. Licensed under CC BY 4.0."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    prov:wasAttributedTo "Yusuf Altunel" ;
    skos:definition "Behavioural enforcement for the framework, tiered by the conformance level the adoption profile in the data graph claims. L1 shapes always fire; L2 and L3 shapes fire only when a profile claims that level, so one shapes file serves adopters of different maturity without forking. Advisory checks are separated into their own node shapes carrying node-level sh:severity, because pyshacl ignores severity declared inside sh:sparql blank nodes. Conformance against this suite means zero results at sh:Violation severity, not an empty report."@en .

#################################################################
#  L1 — structural integrity (always in force)
#################################################################

backlog:WorkItemShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Work item core integrity (L1)"@en ;

    sh:property [ sh:path backlog:hasIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "L1: a work item must have exactly one string identifier." ] ;
    sh:property [ sh:path backlog:hasState ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:LifecycleState ;
                  sh:message "L1: a work item must have exactly one lifecycle state drawn from the closed enumeration." ] ;
    sh:property [ sh:path backlog:dependsOn ; sh:class backlog:WorkItem ;
                  sh:message "L1: dependsOn must point to a real work item." ] ;
    sh:property [ sh:path backlog:memberOfContainer ; sh:class backlog:WorkItemContainer ;
                  sh:message "L1: memberOfContainer must point to a real container." ] ;
    sh:property [ sh:path backlog:hasEvidence ; sh:class backlog:Evidence ;
                  sh:message "L1: hasEvidence must point to a real Evidence artifact." ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: work item identifier must be unique across the register." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasIdentifier ?id .
            ?other backlog:hasIdentifier ?id .
            FILTER (?other != $this)
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: dependency cycle — this item transitively depends on itself." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:dependsOn+ $this .
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a cancelled item must record a rationale for withdrawal." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Cancelled .
            FILTER NOT EXISTS { $this backlog:hasRationale ?r }
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: an item may not carry two live priority scores produced by the same method." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasPriorityScore ?s1 , ?s2 .
            ?s1 backlog:scoredByMethod ?m .
            ?s2 backlog:scoredByMethod ?m .
            FILTER (?s1 != ?s2)
        }""" ] .

backlog:ContainerShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItemContainer ;
    sh:severity sh:Violation ;
    rdfs:label "Container integrity (L1)"@en ;
    sh:property [ sh:path backlog:hasIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "L1: a container must have exactly one string identifier." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a container must have at least one member item, otherwise it reports on nothing." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?m backlog:memberOfContainer $this }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a container's asserted state disagrees with the state derived from its members." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?asserted .
            $this backlog:derivedState ?derived .
            FILTER (?asserted != ?derived)
        }""" ] .

backlog:PriorityScoreShape a sh:NodeShape ;
    sh:targetClass backlog:PriorityScore ;
    sh:severity sh:Violation ;
    rdfs:label "Priority score integrity (L1)"@en ;
    sh:property [ sh:path backlog:scoredByMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:PrioritizationMethod ;
                  sh:message "L1: every priority score must name exactly one prioritisation method." ] ;
    sh:property [ sh:path backlog:hasScoreValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "L1: every priority score must carry exactly one decimal value." ] .

backlog:MilestoneShape a sh:NodeShape ;
    sh:targetClass backlog:Milestone ;
    sh:severity sh:Violation ;
    rdfs:label "Milestone integrity (L1)"@en ;
    sh:property [ sh:path backlog:hasIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "L1: a milestone must have exactly one string identifier." ] ;
    sh:property [ sh:path backlog:hasTargetDate ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: a milestone must carry the date it is aimed at." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a milestone must have at least one contributing work item; a milestone with no work behind it is a claim, not a plan." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?i backlog:contributesToMilestone $this }
        }""" ] .

backlog:RoadmapProjectionShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Roadmap is a projection of the backlog (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: an item placed on the roadmap (horizon or milestone) must be a member of a Backlog register; the roadmap may not introduce scope of its own." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { $this backlog:scheduledInHorizon ?h } UNION { $this backlog:contributesToMilestone ?m }
            FILTER NOT EXISTS { $this backlog:memberOfContainer ?b . ?b a backlog:Backlog }
        }""" ] .

backlog:RoadmapShape a sh:NodeShape ;
    sh:targetClass backlog:Roadmap ;
    sh:severity sh:Violation ;
    rdfs:label "Roadmap integrity (L1)"@en ;
    sh:property [ sh:path backlog:roadmapOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:Backlog ;
                  sh:message "L1: a roadmap must project exactly one backlog." ] .

backlog:AdoptionProfileShape a sh:NodeShape ;
    sh:targetClass backlog:AdoptionProfile ;
    sh:severity sh:Violation ;
    rdfs:label "Adoption profile integrity"@en ;
    sh:property [ sh:path backlog:governsBacklog ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:Backlog ;
                  sh:message "An adoption profile must name the backlog it governs." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Every adoption profile must adopt the Core facet." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:adoptsFacet backlog:CoreFacet }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Every adoption profile must adopt the Evidence facet." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:adoptsFacet backlog:EvidenceFacet }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Every adoption profile must adopt the Invariant facet." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:adoptsFacet backlog:InvariantFacet }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Every adoption profile must adopt the Audit facet." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:adoptsFacet backlog:AuditFacet }
        }""" ] .

backlog:AdoptionConformanceGoalShape a sh:NodeShape ;
    sh:targetClass backlog:AdoptionProfile ;
    sh:severity sh:Violation ;
    rdfs:label "Every lineage carries a real goal for its own BRSF conformance"@en ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_conformance_goal_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "P_NoConformanceGoal" ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This lineage carries no conformance goal. Per the default pattern this framework recommends for every adopting lineage (07-handover-inbox/accepted, originally another registrant's own real fix to itself): a Goal with isConformanceGoal true, genuinely Mission-facing, because every claim a mission makes depends on the register carrying that claim being itself honestly conformant to the framework governing it. Never a forced fit onto an existing product goal — that is exactly the dishonest fit this framework's own checks exist to catch elsewhere." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?g a backlog:Goal ; backlog:isConformanceGoal true }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This lineage's conformance goal has no real objective beneath it. A goal with nothing measuring it is the unfalsifiable-plan failure in its plainest form, here applied reflexively to the register's own trustworthiness rather than the product." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?g a backlog:Goal ; backlog:isConformanceGoal true .
            FILTER NOT EXISTS { ?o backlog:contributesToGoal ?g }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This lineage's conformance objective names no success metric. Conformance that cannot be counted cannot be missed, and an objective that cannot be missed constrains no decision." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?g a backlog:Goal ; backlog:isConformanceGoal true .
            ?o backlog:contributesToGoal ?g .
            FILTER NOT EXISTS { ?o backlog:hasSuccessMetric ?m }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This lineage's conformance objective names no checkpoint — no time or condition by which it must be measured again. A metric with nothing to measure it by is a number nobody is committed to revisiting." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?g a backlog:Goal ; backlog:isConformanceGoal true .
            ?o backlog:contributesToGoal ?g .
            FILTER NOT EXISTS { ?o backlog:hasCheckpoint ?cp }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This lineage's conformance objective has never actually been measured. A checkpoint with no observation against it is a commitment to measure that was never kept — the same gap SelfExemptionShape's own incident named for a declared level nobody test-drove." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?g a backlog:Goal ; backlog:isConformanceGoal true .
            ?o backlog:contributesToGoal ?g .
            FILTER NOT EXISTS { ?obs a backlog:MetricObservation ; backlog:observationFor ?o }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "More than one Goal in this lineage carries isConformanceGoal true. Conformance is one fact about the register, not a family of them — a second conformance goal is either a duplicate this lineage should retire, or a sign the first one was scoped wrong." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { SELECT $this (COUNT(?g) AS ?n) WHERE {
                $this a backlog:AdoptionProfile .
                ?g a backlog:Goal ; backlog:isConformanceGoal true .
              } GROUP BY $this
            }
            FILTER (?n > 1)
        }""" ] .

#################################################################
#  Evidence & Definition of Done — authoring integrity
#################################################################

backlog:TestEvidenceShape a sh:NodeShape ;
    sh:targetClass backlog:TestEvidence ;
    sh:severity sh:Violation ;
    rdfs:label "Test evidence integrity"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Test evidence must record a test spec path or a test identifier, or the bridge cannot check it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasTestSpec ?s }
            FILTER NOT EXISTS { $this backlog:hasTestId ?i }
        }""" ] .

backlog:ReleaseEvidenceShape a sh:NodeShape ;
    sh:targetClass backlog:ReleaseEvidence ;
    sh:severity sh:Violation ;
    rdfs:label "Release evidence integrity"@en ;
    sh:property [ sh:path backlog:hasReleaseVersion ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "Release evidence must record the delivered version." ] ;
    sh:property [ sh:path backlog:hasPackageSHA256 ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[0-9a-f]{64}$" ;
                  sh:message "Release evidence must record a well-formed lowercase SHA-256 package hash." ] .

backlog:ArtifactEvidenceShape a sh:NodeShape ;
    sh:targetClass backlog:ArtifactEvidence ;
    sh:severity sh:Violation ;
    rdfs:label "Artifact evidence integrity"@en ;
    sh:property [ sh:path backlog:hasArtifactPath ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "Artifact evidence must record the delivered file path." ] ;
    sh:property [ sh:path backlog:hasArtifactSHA256 ; sh:pattern "^[0-9a-f]{64}$" ;
                  sh:message "Artifact evidence hash must be a well-formed lowercase SHA-256 digest." ] .

backlog:ReviewEvidenceShape a sh:NodeShape ;
    sh:targetClass backlog:ReviewEvidence ;
    sh:severity sh:Violation ;
    rdfs:label "Review evidence integrity"@en ;
    sh:property [ sh:path backlog:hasReviewer ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "Review evidence must name who judged." ] ;
    sh:property [ sh:path backlog:hasReviewRecordRef ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "Review evidence must point at a retrievable record, not a remembered conversation." ] .

backlog:DoDCriterionShape a sh:NodeShape ;
    sh:targetClass backlog:DoDCriterion ;
    sh:severity sh:Violation ;
    rdfs:label "Definition-of-Done criterion is falsifiable"@en ;
    sh:property [ sh:path backlog:hasCheckQuery ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A Definition-of-Done criterion without executable check text is decorative." ] ;
    sh:property [ sh:path backlog:hasExpectedResult ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A check with no stated expected result cannot fail." ] ;
    sh:property [ sh:path backlog:hasCriterionStatus ; sh:minCount 1 ; sh:class backlog:InvariantStatus ;
                  sh:message "A criterion must report an honest status from the three-value enumeration." ] .

backlog:InvariantShape a sh:NodeShape ;
    sh:targetClass backlog:CrossCuttingInvariant ;
    sh:severity sh:Violation ;
    rdfs:label "Cross-cutting invariant is executable"@en ;
    sh:property [ sh:path backlog:hasCheckQuery ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "An invariant without executable check text is prose asserting itself." ] ;
    sh:property [ sh:path backlog:hasInvariantStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:InvariantStatus ;
                  sh:message "An invariant must report exactly one honest status." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "An invariant reported as not-yet-enforceable must name the work item whose completion would make it enforceable." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInvariantStatus backlog:NotYetEnforceable .
            FILTER NOT EXISTS { $this backlog:tracksItem ?i }
        }""" ] .

#################################################################
#  L2 — evidence-bound (fires only when a profile claims L2 or L3)
#################################################################

backlog:EvidenceBoundDoneShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Done implies verified evidence (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: a Done item must carry at least one Evidence artifact." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this backlog:hasEvidence ?e }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: a Done item must carry at least one bridge-verified Evidence artifact (evidenceVerified true)." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this backlog:hasEvidence ?e . ?e backlog:evidenceVerified true }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: a Done item may not depend on work that is not Done." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done ; backlog:dependsOn ?d .
            ?d backlog:hasState ?ds .
            FILTER (?ds != backlog:Done)
        }""" ] .

#################################################################
#  L3 — governed (fires only when a profile claims L3)
#################################################################

backlog:GovernedDoneShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Governed completion (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: a Done item must be anchored by verified test or release evidence; review evidence alone is insufficient. An ExecutionTask may inherit this from the real, PlanningEvent-linked parent it was produced from, if that parent is itself compliant; it may never be waived unconditionally." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS {
                $this backlog:hasEvidence ?e .
                ?e backlog:evidenceVerified true .
                { ?e a backlog:TestEvidence } UNION { ?e a backlog:ReleaseEvidence }
            }
            FILTER NOT EXISTS {
                $this a backlog:ExecutionTask .
                ?pe backlog:producesTask $this ; backlog:plansItem ?parent .
                ?parent backlog:hasEvidence ?e2 . ?e2 backlog:evidenceVerified true .
                { ?e2 a backlog:TestEvidence } UNION { ?e2 a backlog:ReleaseEvidence }
            }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: a Done item must record when it was last individually re-verified (lastAuditedAt); absence means unchecked, not fine. An ExecutionTask may inherit this from a real, compliant PlanningEvent-linked parent; it may never be waived unconditionally." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this backlog:lastAuditedAt ?t }
            FILTER NOT EXISTS {
                $this a backlog:ExecutionTask .
                ?pe backlog:producesTask $this ; backlog:plansItem ?parent .
                ?parent backlog:lastAuditedAt ?t2 .
            }
        }""" ] .

#################################################################
#  Advisory tier — node-level severity (L-36: severity must not sit
#  inside an sh:sparql blank node, where pyshacl ignores it)
#
#  UnscoredItemAdvisoryShape retired at v1.156.0, found while applying
#  G43's own severity taxonomy to this framework's single existing
#  sh:Info shape: its condition (unscored, unflagged, Proposed/Ready)
#  is identical to SilentGapShape's own real sh:Violation, a few lines
#  below. Not a genuine opportunity at all -- something IS already
#  wrong here, and SilentGapShape already says so. Relabelling this as
#  "Opportunity" per G43 would have been the dishonest fit G43 itself
#  exists to prevent; retiring it, not relabelling it, is the correct
#  application of the same ruling that named it. The incident above is
#  left as written.
#################################################################

backlog:HorizonCoherenceAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: roadmap horizon disagrees with lifecycle state"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this item is advertised in the Now horizon but is neither Ready nor InProgress." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:scheduledInHorizon backlog:Now ; backlog:hasState ?s .
            FILTER (?s NOT IN (backlog:Ready, backlog:InProgress, backlog:Done))
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this item is Ready but its declared dependencies are not all Done, so it is not actually startable." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Ready ; backlog:dependsOn ?d .
            ?d backlog:hasState ?ds .
            FILTER (?ds != backlog:Done)
        }""" ] .

backlog:StaleVerificationAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Evidence ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: evidence verified without a recorded method or time"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this evidence is marked verified but records neither when nor how it was checked." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:evidenceVerified true .
            FILTER NOT EXISTS { $this backlog:verifiedAt ?t }
            FILTER NOT EXISTS { $this backlog:hasVerificationMethod ?m }
        }""" ] .

#################################################################
#  v1.1.0 — scoreability and gap discipline
#################################################################

backlog:ScoreabilityShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Scoreability flag integrity (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: an item flagged not-yet-scoreable must record the reason; the flag without a reason is a silent gap wearing a label." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:notYetScoreable true .
            FILTER NOT EXISTS { $this backlog:hasScoreabilityReason ?r }
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: an item cannot be both scored and declared not-yet-scoreable." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:notYetScoreable true ; backlog:hasPriorityScore ?p .
        }""" ] .

backlog:SilentGapShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Silent-gap discipline (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: silent gap — this open item is neither scored nor flagged not-yet-scoreable. Gap discipline is binary and enforced here, not left to judgement." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?s .
            FILTER (?s IN (backlog:Proposed, backlog:Ready))
            FILTER NOT EXISTS { $this backlog:hasPriorityScore ?sc }
            FILTER NOT EXISTS { $this backlog:notYetScoreable true }
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
        }""" ] .

backlog:SessionDecisionScoringShape a sh:NodeShape ;
    sh:targetClass backlog:RegisterSession ;
    sh:severity sh:Violation ;
    rdfs:label "A multi-candidate session decision is backed by a real score (BP-D10)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This session recorded three or more genuine candidate next-actions and names no PriorityScore that justified the one it chose. SilentGapShape already closes this gap at the individual work-item level; this closes the same gap one level up, at the session's own decision of what to work on next. A session that weighs 3+ real options and picks one from narrative preference alone is the vibes-based prioritization this framework's own scoring discipline exists to replace." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:consideredOptionCount ?n .
            FILTER (?n >= 3)
            FILTER NOT EXISTS { $this backlog:decisionBackedByScore ?sc }
        }""" ] .

#################################################################
#  v1.1.0 — launch-readiness model, roles, capability tagging
#################################################################

backlog:LaunchGateShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItemContainer ;
    sh:severity sh:Violation ;
    rdfs:label "Launch gates are owner decisions (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a launch gate must carry an owner-declared launch priority — it is a business decision, never a value computed from a score." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:isLaunchGate true .
            FILTER NOT EXISTS { $this backlog:hasLaunchPriority ?p }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a launch gate must name the Owner as its decider and carry a written rationale." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:isLaunchGate true .
            FILTER NOT EXISTS { $this backlog:decidedBy backlog:Owner }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a launch priority may only exist on a container declared a launch gate. Launch priority is the order in which launch gates clear; on anything that is not a gate it orders nothing." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasLaunchPriority ?p .
            FILTER NOT EXISTS { $this backlog:isLaunchGate true }
        }""" ] .

# Superseded at shapes 1.8.0: a constraint reading "a container tagged as not a
# business capability may not carry a launch priority". It was jointly
# unsatisfiable with the first constraint above for any container that is both a
# launch gate and not a business capability — a combination an adopting project
# reported from real data (cross-cutting platform and continuity packages that the
# owner named launch-blocking but that are not independently shippable
# capabilities). Neither flag was wrong; the shape was.
#
# The diagnosis is narrower than "two rules never reconciled". The superseded
# constraint's own message described protecting CAPABILITY-LEVEL RANKING, but it
# constrained backlog:hasLaunchPriority, which the TBox defines as an owner-declared
# launch ordinal that is never a computed ranking value. Capability-level ranking
# runs on backlog:hasPriorityScore, and the report tool already excludes
# non-capability containers from it. So the constraint guarded the wrong predicate.
#
# The replacement states the coherent rule — a launch priority only means something
# on a launch gate — and is strictly stronger: it still catches the case the old
# constraint caught (a non-capability, non-gate container carrying a priority) and
# additionally catches one nothing caught before (a BUSINESS-CAPABILITY container
# carrying a launch priority without being declared a gate).

backlog:ContainerScoreShape a sh:NodeShape ;
    sh:targetClass backlog:PriorityScore ;
    sh:severity sh:Violation ;
    rdfs:label "Container scores are judged, not averaged (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a container-level score may not be an average of member scores — averaging re-uses numbers computed for unrelated reasons on unrelated items." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:isAveragedFromMembers true }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a container-level score must be a Builder judgement carrying a written rationale." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?c a backlog:WorkItemContainer ; backlog:hasPriorityScore $this .
            FILTER NOT EXISTS { $this backlog:hasScoreRationale ?r }
        }""" ] .

#################################################################
#  v1.1.0 — dependency disclosure and deployability
#################################################################

backlog:DependencyDisclosureShape a sh:NodeShape ;
    sh:targetClass backlog:DependencyDisclosure ;
    sh:severity sh:Violation ;
    rdfs:label "A disclosed dependency must become an edge"@en ;
    sh:property [ sh:path backlog:hasDisclosureSource ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A disclosure must record where the dependency was stated." ] ;
    sh:property [ sh:path backlog:disclosesDependencyOn ; sh:minCount 1 ;
                  sh:message "A disclosure must name what is depended upon." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A dependency stated in prose or judgement must exist as an edge — dependsOn between items, containerDependsOn between containers. An undisclosed-but-real dependency is worse than none, because the register looks resolved." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?subject backlog:hasDependencyDisclosure $this .
            $this backlog:disclosesDependencyOn ?dep .
            FILTER NOT EXISTS { ?subject backlog:dependsOn ?dep }
            FILTER NOT EXISTS { ?subject backlog:containerDependsOn ?dep }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A disclosure must name a work item or a container, not something else." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:disclosesDependencyOn ?dep .
            FILTER NOT EXISTS { ?dep a ?ci . ?ci rdfs:subClassOf* backlog:WorkItem }
            FILTER NOT EXISTS { ?dep a ?cc . ?cc rdfs:subClassOf* backlog:WorkItemContainer }
        }""" ] .

backlog:DeployabilityShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItemContainer ;
    sh:severity sh:Violation ;
    rdfs:label "Member completion is not deployability"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A fully member-complete container with an unresolved external blocker is not deployable; completeness is one input to job size, not a substitute for checking real dependency edges." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:derivedState backlog:Done ; backlog:hasExternalBlocker ?b .
        }""" ] .

#################################################################
#  v1.1.0 — blueprint coverage
#################################################################

backlog:BlueprintGapShape a sh:NodeShape ;
    sh:targetClass backlog:BlueprintGap ;
    sh:severity sh:Violation ;
    rdfs:label "A recorded gap must be triageable"@en ;
    sh:property [ sh:path backlog:hasGapReason ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A blueprint gap must record why the coverage is absent." ] ;
    sh:property [ sh:path backlog:gapForEntity ; sh:minCount 1 ; sh:class backlog:DomainEntity ;
                  sh:message "A blueprint gap must name the entity whose coverage is missing." ] .

backlog:CodeVerificationShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A code-verification claim carries its method"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "An item claiming verification against running code must record what the check found; titles lie by omission and so does an unexplained tick." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:verifiedAgainstCode true .
            FILTER NOT EXISTS { $this backlog:hasCodeVerificationNote ?n }
        }""" ] .

backlog:BlueprintSweepShape a sh:NodeShape ;
    sh:targetClass backlog:DomainEntity ;
    sh:severity sh:Violation ;
    rdfs:label "Full life-cycle sweep per entity (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this entity has a life-cycle stage with neither backlog coverage nor a recorded blueprint gap. A gap is a defect to be written down, never a silence." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?stage a backlog:EntityLifecycleStage .
            FILTER NOT EXISTS { ?i backlog:coversEntity $this ; backlog:coversStage ?stage }
            FILTER NOT EXISTS { ?g backlog:gapForEntity $this ; backlog:gapForStage ?stage }
        }""" ] .

#################################################################
#  v1.1.0 — governed documents, reports, rules, gates
#################################################################

backlog:GovernedDocumentShape a sh:NodeShape ;
    sh:targetClass backlog:GovernedDocument ;
    sh:severity sh:Violation ;
    rdfs:label "Supersession is marked in place"@en ;
    sh:property [ sh:path backlog:hasDocumentStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:DocumentStatus ;
                  sh:message "A governed document must carry exactly one currency status." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A superseded document must point at what replaced it and say why; a retirement marker without a forward pointer sends the reader nowhere." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasDocumentStatus backlog:Superseded .
            FILTER NOT EXISTS { $this backlog:supersededBy ?d . $this backlog:hasSupersessionReason ?r }
        }""" ] .

backlog:RoadmapReportShape a sh:NodeShape ;
    sh:targetClass backlog:RoadmapReport ;
    sh:severity sh:Violation ;
    rdfs:label "A report is a run, and a complete one"@en ;
    sh:property [ sh:path backlog:hasRunTimestamp ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "A report must record when it was computed; a recalled report is a memory, not a measurement." ] ;
    sh:property [ sh:path backlog:reportOf ; sh:minCount 1 ; sh:class backlog:Backlog ;
                  sh:message "A report must name the register it was computed from." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A compliant report must contain all eight required sections; a section quietly dropped is an omission, not a shorter report." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?section a backlog:ReportSection .
            FILTER NOT EXISTS { $this backlog:hasSection ?section }
        }""" ] .

backlog:NextRecommendationShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A next-recommendation names its run and its model"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "An item recommended as next must name the ranking model that produced the recommendation, so the two models' answers stay distinguishable." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:derivedInReport ?r .
            FILTER NOT EXISTS { $this backlog:underRankingModel ?m }
        }""" ] .

backlog:MethodologyRuleShape a sh:NodeShape ;
    sh:targetClass backlog:MethodologyRule ;
    sh:severity sh:Violation ;
    rdfs:label "A rule keeps its reasoning"@en ;
    sh:property [ sh:path backlog:hasRuleLogic ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A methodology rule must state its exact logic." ] ;
    sh:property [ sh:path backlog:closesDisagreement ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A methodology rule must state the disagreement or defect it closes." ] ;
    sh:property [ sh:path backlog:hasMotivatingIncident ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A methodology rule must name the concrete incident that produced it; without one it is theoretical best practice." ] .

backlog:ReleaseGateShape a sh:NodeShape ;
    sh:targetClass backlog:ReleaseGate ;
    sh:severity sh:Violation ;
    rdfs:label "A gate is executable and ordered"@en ;
    sh:property [ sh:path backlog:hasGateCommand ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A release gate must carry the command that executes it." ] ;
    sh:property [ sh:path backlog:hasGateOrder ; sh:minCount 1 ; sh:datatype xsd:integer ;
                  sh:message "A release gate must state where it sits in the sequence." ] .

#################################################################
#  v1.2.0 — intent layer integrity
#################################################################

backlog:ObjectiveShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "An objective is measurable or it is not an objective (L1)"@en ;
    sh:property [ sh:path backlog:contributesToGoal ; sh:minCount 1 ; sh:class backlog:Goal ;
                  sh:message "An objective must advance a stated goal." ] ;
    sh:property [ sh:path backlog:hasSuccessMetric ; sh:minCount 1 ;
                  sh:message "An objective must name at least one success metric; an objective that cannot be measured cannot be missed." ] ;
    sh:property [ sh:path backlog:hasBaselineValue ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "An objective must record where the metric started." ] ;
    sh:property [ sh:path backlog:hasTargetValue ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "An objective must record where the metric must reach." ] .

backlog:BenefitShape a sh:NodeShape ;
    sh:targetClass backlog:Benefit ;
    sh:severity sh:Violation ;
    rdfs:label "A benefit is owned, attached and evidenced (L1)"@en ;
    sh:property [ sh:path backlog:benefitFor ; sh:minCount 1 ; sh:class backlog:Objective ;
                  sh:message "A benefit must advance an objective; otherwise it is a preference." ] ;
    sh:property [ sh:path backlog:hasBenefitOwner ; sh:minCount 1 ;
                  sh:message "A benefit must name the stakeholder accountable for it arriving." ] ;
    sh:property [ sh:path backlog:hasBenefitStatement ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A benefit must state what improves, for whom, and how it will be observed." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A benefit claimed realized must point at verified Evidence — shipping the work is an input to a benefit, never the benefit itself." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:benefitRealized true .
            FILTER NOT EXISTS { $this backlog:benefitRealizedBy ?e . ?e backlog:evidenceVerified true }
        }""" ] .

backlog:OpportunityShape a sh:NodeShape ;
    sh:targetClass backlog:Opportunity ;
    sh:severity sh:Violation ;
    rdfs:label "An opportunity is stated and aimed (L1)"@en ;
    sh:property [ sh:path backlog:opportunityFor ; sh:minCount 1 ;
                  sh:message "An opportunity must name the goal or objective it would advance." ] ;
    sh:property [ sh:path backlog:hasOpportunityStatement ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "An opportunity must state the upside and what it would cost to find out." ] .

backlog:GoalShape a sh:NodeShape ;
    sh:targetClass backlog:Goal ;
    sh:severity sh:Violation ;
    rdfs:label "A goal is named and owned (L1)"@en ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ;
                  sh:message "A goal must be stated." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A goal is an owner decision and must name the Owner as its decider." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this backlog:decidedBy backlog:Owner } }""" ] .

#################################################################
#  v1.2.0 — scope, refinement, cost
#################################################################

backlog:ScopeExclusionShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeExclusion ;
    sh:severity sh:Violation ;
    rdfs:label "An exclusion is explicit, reasoned and owner-decided (L1)"@en ;
    sh:property [ sh:path backlog:excludesConcern ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "An exclusion must name what is excluded, precisely enough to test a later request against it." ] ;
    sh:property [ sh:path backlog:hasExclusionRationale ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "An exclusion must record why; an unreasoned exclusion can only be reversed by whoever argues hardest." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Scope exclusion is an owner decision and must name the Owner as its decider." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this backlog:decidedBy backlog:Owner } }""" ] .

backlog:RefinementEventShape a sh:NodeShape ;
    sh:targetClass backlog:RefinementEvent ;
    sh:severity sh:Violation ;
    rdfs:label "A refinement records what it changed (L1)"@en ;
    sh:property [ sh:path backlog:refines ; sh:minCount 1 ; sh:class backlog:WorkItem ;
                  sh:message "A refinement must name the item it acted on." ] ;
    sh:property [ sh:path backlog:refinedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "A refinement must record when it happened." ] ;
    sh:property [ sh:path backlog:hasRefinementOutcome ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A refinement with no recorded outcome was a meeting, not a refinement." ] .

backlog:ReadinessGateShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Ready is earned, not assumed (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: an item in Ready must carry at least one acceptance criterion; readiness without stated acceptance is an estimate of someone's memory." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Ready .
            FILTER NOT EXISTS { $this backlog:hasAcceptanceCriterion ?a }
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: an item in Ready must have a recorded refinement event; readiness is something done to an item, not a state it drifts into." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Ready .
            FILTER NOT EXISTS { ?r backlog:refines $this }
        }""" ] .

backlog:CostEstimateShape a sh:NodeShape ;
    sh:targetClass backlog:CostEstimate ;
    sh:severity sh:Violation ;
    rdfs:label "An estimate discloses its basis (L1)"@en ;
    sh:property [ sh:path backlog:hasEffortEstimate ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "A cost estimate must carry a quantity." ] ;
    sh:property [ sh:path backlog:hasCostBasis ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A cost estimate must state how it was derived and in what unit; an undisclosed basis cannot be challenged or reused." ] .

#################################################################
#  v1.2.0 — risk treatment, investment mix, project gates
#################################################################

backlog:RiskTreatmentShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A referenced risk is treated or explicitly accepted (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A risk attached to work must either carry a mitigation or name the role that accepted it; silent acceptance is the failure this prevents." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasRisk ?r .
            FILTER NOT EXISTS { ?r backlog:hasMitigation ?m }
            FILTER NOT EXISTS { ?r backlog:riskAcceptedBy ?role }
        }""" ] .

backlog:PortfolioPolicyShape a sh:NodeShape ;
    sh:targetClass backlog:PortfolioPolicy ;
    sh:severity sh:Violation ;
    rdfs:label "A policy accounts for all capacity (L1)"@en ;
    sh:property [ sh:path backlog:policyFor ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A portfolio policy must name the register it governs." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Declared capacity shares must sum to 1; a policy that leaves capacity unaccounted for leaves it to whoever shouts." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { SELECT $this (SUM(?s) AS ?total) WHERE {
                $this backlog:hasAllocation ?a . ?a backlog:hasTargetShare ?s .
            } GROUP BY $this }
            FILTER (ABS(?total - 1.0) > 0.001)
        }""" ] .

backlog:CapacityAllocationShape a sh:NodeShape ;
    sh:targetClass backlog:CapacityAllocation ;
    sh:severity sh:Violation ;
    rdfs:label "An allocation names a category and a share (L1)"@en ;
    sh:property [ sh:path backlog:allocatesToCategory ; sh:minCount 1 ; sh:class backlog:InvestmentCategory ;
                  sh:message "An allocation must name its investment category." ] ;
    sh:property [ sh:path backlog:hasTargetShare ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "An allocation must state its share." ] .

backlog:ImplementationProjectShape a sh:NodeShape ;
    sh:targetClass backlog:ImplementationProject ;
    sh:severity sh:Violation ;
    rdfs:label "A project declares scope, phase, intent and its Definition of Done (L1)"@en ;
    sh:property [ sh:path backlog:hasScopeStatement ; sh:minCount 1 ; sh:class backlog:ScopeStatement ;
                  sh:message "A project must declare its scope boundary." ] ;
    sh:property [ sh:path backlog:hasLifecyclePhase ; sh:minCount 1 ; sh:class backlog:ProductLifecyclePhase ;
                  sh:message "A project must declare its lifecycle phase; the phase decides which prioritisation question governs." ] ;
    sh:property [ sh:path backlog:pursuesObjective ; sh:minCount 1 ; sh:class backlog:Objective ;
                  sh:message "A project must pursue at least one stated objective." ] ;
    sh:property [ sh:path backlog:appliesDefinitionOfDone ; sh:minCount 1 ; sh:class backlog:DefinitionOfDone ;
                  sh:message "A project must declare the Definition of Done it will be judged against." ] .

backlog:InvestmentCategoryShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Every item declares what kind of investment it is (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this item declares no investment category, so the register's build-versus-maintain mix cannot be computed and a starved category cannot be detected." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasInvestmentCategory ?c }
            FILTER NOT EXISTS { $this backlog:hasState backlog:Cancelled }
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
        }""" ] .

backlog:IntentTraceabilityAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: item pursues no stated objective"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this item advances no recorded objective, so its value claim reaches no MEASURABLE target. It may still be traced to intent — a container carrying hasCommitment/commitsToGoal reaches a Goal — and this advisory deliberately does not accept that, because a Goal states what matters while an Objective states what would settle it. Raised by an adopting session that read the old wording, which said the claim could not be traced to anything at all, as a false positive; the old wording overstated, the check did not." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER EXISTS { ?o a backlog:Objective }
            FILTER NOT EXISTS { $this backlog:pursuesObjective ?obj }
            FILTER NOT EXISTS { $this backlog:memberOfContainer ?c . ?c backlog:pursuesObjective ?obj2 }
            FILTER NOT EXISTS { $this backlog:hasState backlog:Cancelled }
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
        }""" ] .

#################################################################
#  v1.3.0 — container linkage: dependency, roadmap placement, rank
#################################################################

backlog:ContainerLinkageShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItemContainer ;
    sh:severity sh:Violation ;
    rdfs:label "Container dependency and roadmap placement (L1)"@en ;
    rdfs:comment "SEE ALSO backlog:WorkItemRoadmapRankShape, which governs the same two properties on backlog:WorkItem — a DIFFERENT target class with the OPPOSITE default for absence. There, an unranked item is no violation at all; here, a launch-gated container without a rank IS one at L2. Do not infer either shape's behaviour from the other's message. An adopting session read the item-level rule's philosophy, applied it to eight launch-gated containers, and left eight real L2 violations standing for a full register pass."@en ;
    sh:property [ sh:path backlog:containerDependsOn ; sh:class backlog:WorkItemContainer ;
                  sh:message "L1: containerDependsOn must point at a real container." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: container dependency cycle — this container transitively depends on itself." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:containerDependsOn+ $this }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a container carrying a roadmap rank must say which roadmap it is ranked on." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasRoadmapRank ?r .
            FILTER NOT EXISTS { $this backlog:rankedOnRoadmap ?rm }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: two containers hold the same rank on one roadmap; a rank that does not order is not a rank." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:rankedOnRoadmap ?rm ; backlog:hasRoadmapRank ?r .
            ?other backlog:rankedOnRoadmap ?rm ; backlog:hasRoadmapRank ?r .
            FILTER (?other != $this)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: a launch-gated container must be placed on a roadmap with a rank; work that blocks launch cannot be absent from the plan." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:isLaunchGate true .
            FILTER NOT EXISTS { $this backlog:rankedOnRoadmap ?rm . $this backlog:hasRoadmapRank ?r }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this container declares a dependency with no member-level basis and no disclosure explaining it — either an item edge is missing or the dependency is a phantom." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:containerDependsOn ?other .
            FILTER NOT EXISTS { $this backlog:derivedContainerDependency ?other }
            FILTER NOT EXISTS { $this backlog:hasDependencyDisclosure ?disc . ?disc backlog:disclosesDependencyOn ?other }
        }""" ] .

backlog:UndeclaredContainerDependencyAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItemContainer ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: member-level dependency not declared at container level"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: a member of this container depends on unfinished work in another container, but no container-level dependency is declared; the constraint is real and invisible on the plan." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:derivedContainerDependency ?other .
            FILTER NOT EXISTS { $this backlog:containerDependsOn ?other }
        }""" ] .

#################################################################
#  v1.3.0 — every item carries criteria, a Definition of Done, and
#  a harness that proves both before it may be called complete
#################################################################

backlog:ItemCompletenessLinkageShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Criteria, Definition of Done and harness (L2/L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: an item that has left Proposed must carry at least one acceptance criterion." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?s .
            FILTER (?s IN (backlog:Ready, backlog:InProgress, backlog:Done))
            FILTER NOT EXISTS { $this backlog:hasAcceptanceCriterion ?a }
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: no Definition of Done governs this item — none declared on it and none inherited from any container it belongs to." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?s .
            FILTER (?s != backlog:Cancelled)
            FILTER NOT EXISTS { $this backlog:effectiveDefinitionOfDone ?d }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: a Done item must have a test harness whose completeness was derived, not asserted. An ExecutionTask may inherit this from a real, compliant PlanningEvent-linked parent; it may never be waived unconditionally." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { ?h backlog:harnessFor $this ; backlog:harnessComplete true }
            FILTER NOT EXISTS {
                $this a backlog:ExecutionTask .
                ?pe backlog:producesTask $this ; backlog:plansItem ?parent .
                ?h2 backlog:harnessFor ?parent ; backlog:harnessComplete true .
            }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: an acceptance criterion of this Done item is attested by no bridge-verified evidence; a green suite that never touched the criterion does not close it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done ; backlog:hasAcceptanceCriterion ?ac .
            FILTER NOT EXISTS { ?e backlog:attestsCriterion ?ac ; backlog:evidenceVerified true }
        }""" ] .

backlog:TestHarnessShape a sh:NodeShape ;
    sh:targetClass backlog:TestHarness ;
    sh:severity sh:Violation ;
    rdfs:label "A harness names its item and its checks (L1)"@en ;
    sh:property [ sh:path backlog:harnessFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:WorkItem ;
                  sh:message "A harness must prove exactly one item." ] ;
    sh:property [ sh:path backlog:hasHarnessEvidence ; sh:minCount 1 ; sh:class backlog:Evidence ;
                  sh:message "A harness with no evidence proves nothing." ] .

#################################################################
#  v1.3.0 — lifecycle workflow
#################################################################

backlog:StateTransitionShape a sh:NodeShape ;
    sh:targetClass backlog:StateTransition ;
    sh:severity sh:Violation ;
    rdfs:label "A transition is typed, named and guarded (L1)"@en ;
    sh:property [ sh:path backlog:fromState ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:LifecycleState ;
                  sh:message "A transition must name the state it leaves." ] ;
    sh:property [ sh:path backlog:toState ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:LifecycleState ;
                  sh:message "A transition must name the state it enters." ] ;
    sh:property [ sh:path backlog:hasTransitionGuard ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A transition must carry an executable guard; an unguarded move into Done is how completion claims escape." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A transition may not leave and enter the same state." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:fromState ?s ; backlog:toState ?s }""" ] .

backlog:WorkflowShape a sh:NodeShape ;
    sh:targetClass backlog:Workflow ;
    sh:severity sh:Violation ;
    rdfs:label "A workflow reaches every state it governs (L1)"@en ;
    sh:property [ sh:path backlog:hasTransition ; sh:minCount 1 ; sh:class backlog:StateTransition ;
                  sh:message "A workflow must permit at least one transition." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This workflow leaves a lifecycle state unreachable and unleavable: no transition enters or exits it, so the enumeration and the process disagree." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?state a backlog:LifecycleState .
            FILTER NOT EXISTS { $this backlog:hasTransition ?t . ?t backlog:toState ?state }
            FILTER NOT EXISTS { $this backlog:hasTransition ?t2 . ?t2 backlog:fromState ?state }
        }""" ] .

backlog:TransitionEventShape a sh:NodeShape ;
    sh:targetClass backlog:TransitionEvent ;
    sh:severity sh:Violation ;
    rdfs:label "A recorded move used a permitted transition (L1)"@en ;
    sh:property [ sh:path backlog:transitionedItem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:WorkItem ;
                  sh:message "A transition event must name the item that moved." ] ;
    sh:property [ sh:path backlog:viaTransition ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:StateTransition ;
                  sh:message "A transition event must name the transition it used." ] ;
    sh:property [ sh:path backlog:transitionedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "A transition event must record when the move happened." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This move used a transition that belongs to no workflow: a state change outside the process, not an exception to it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:viaTransition ?t .
            FILTER NOT EXISTS { ?w a backlog:Workflow ; backlog:hasTransition ?t }
        }""" ] .

backlog:StateHistoryShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Current state is explained by the last recorded move (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this item's current state is not the destination of its most recent recorded transition; either a move went unrecorded or the state was edited directly." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?ev backlog:transitionedItem $this ; backlog:transitionedAt ?t ; backlog:viaTransition ?tr .
            FILTER NOT EXISTS { ?ev2 backlog:transitionedItem $this ; backlog:transitionedAt ?t2 . FILTER (?t2 > ?t) }
            ?tr backlog:toState ?dest .
            $this backlog:hasState ?actual .
            FILTER (?actual != ?dest)
        }""" ] .

#################################################################
#  v1.4.0 — decomposition, commitments, typed dependencies,
#  impediments, flow policy, team, story form
#################################################################

backlog:DecompositionShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Decomposition is acyclic and honest (L1/L2)"@en ;
    sh:property [ sh:path backlog:decomposesInto ; sh:class backlog:WorkItem ;
                  sh:message "L1: decomposesInto must point at a real work item." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: decomposition cycle — this item is transitively part of itself." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:decomposesInto+ $this }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: an item may not both decompose into another and depend on it; decomposition says the child is part of the parent, dependency says they are separate work." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:decomposesInto ?c . $this backlog:dependsOn ?c }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this item is Done while a child of its decomposition is not; a parent cannot be complete while part of it is outstanding." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done ; backlog:decomposesInto ?child .
            ?child backlog:hasState ?cs .
            FILTER (?cs NOT IN (backlog:Done, backlog:Cancelled))
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this decomposed item carries its own priority score as well as scored children; a parent's score computed alongside its children's double-counts the same value." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:decomposesInto ?child ; backlog:hasPriorityScore ?ps .
            ?child backlog:hasPriorityScore ?cs .
        }""" ] .

backlog:CommitmentShape a sh:NodeShape ;
    sh:targetClass backlog:Commitment ;
    sh:severity sh:Violation ;
    rdfs:label "A commitment names exactly what is committed to (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A commitment must name a goal, an objective or a Definition of Done — a commitment to nothing is a label." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:commitsToGoal ?g }
            FILTER NOT EXISTS { $this backlog:commitsToObjective ?o }
            FILTER NOT EXISTS { $this backlog:commitsToDefinitionOfDone ?d }
        }""" ] .

backlog:ArtifactCommitmentShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Violation ;
    rdfs:label "A register commits to a goal (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this register carries no commitment to a goal; a backlog without a goal is a list, and a list cannot be behind — only long." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasCommitment ?c . ?c backlog:commitsToGoal ?g }
        }""" ] .

backlog:IncrementCommitmentShape a sh:NodeShape ;
    sh:targetClass backlog:Increment ;
    sh:severity sh:Violation ;
    rdfs:label "An increment commits to a Definition of Done (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this increment names no Definition of Done, so 'releasable' is an opinion about it rather than a property of it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasCommitment ?c . ?c backlog:commitsToDefinitionOfDone ?d }
            FILTER NOT EXISTS { $this backlog:appliesDefinitionOfDone ?d2 }
        }""" ] .

backlog:DependencyRecordShape a sh:NodeShape ;
    sh:targetClass backlog:Dependency ;
    sh:severity sh:Violation ;
    rdfs:label "A dependency record names its kind and its target (L1)"@en ;
    sh:property [ sh:path backlog:dependencyOn ; sh:minCount 1 ;
                  sh:message "A dependency record must name what is depended on." ] ;
    sh:property [ sh:path backlog:hasDependencyKind ; sh:minCount 1 ; sh:class backlog:DependencyKind ;
                  sh:message "A dependency record must state its kind: knowledge, task or resource decide what would release it." ] .

backlog:ImpedimentShape a sh:NodeShape ;
    sh:targetClass backlog:Impediment ;
    sh:severity sh:Violation ;
    rdfs:label "An unresolved impediment is owned and stated (L1)"@en ;
    sh:property [ sh:path backlog:impedes ; sh:minCount 1 ;
                  sh:message "An impediment must name the work it blocks." ] ;
    sh:property [ sh:path backlog:hasImpedimentStatement ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "An impediment must state what is blocked, by what, and what would clear it." ] ;
    sh:property [ sh:path backlog:raisedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "An impediment must record when it was raised; its age is the measure that matters." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "An unresolved impediment must name the role accountable for clearing it; an unowned impediment is a complaint." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:resolvedAt ?r }
            FILTER NOT EXISTS { $this backlog:hasImpedimentOwner ?o }
        }""" ] .

backlog:FlowShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Flow points are well defined (L2/L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item records a finish point but no start point, so its cycle time cannot be computed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:finishedAt ?f .
            FILTER NOT EXISTS { $this backlog:startedAt ?s }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item finished before it started." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:startedAt ?s ; backlog:finishedAt ?f .
            FILTER (?f < ?s)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this Done item records no finish point, so throughput and cycle time cannot be measured for it. An ExecutionTask may inherit this from a real, compliant PlanningEvent-linked parent; it may never be waived unconditionally." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this backlog:finishedAt ?f }
            FILTER NOT EXISTS {
                $this a backlog:ExecutionTask .
                ?pe backlog:producesTask $this ; backlog:plansItem ?parent .
                ?parent backlog:finishedAt ?f2 .
            }
        }""" ] .

backlog:WipLimitShape a sh:NodeShape ;
    sh:targetClass backlog:WipLimit ;
    sh:severity sh:Violation ;
    rdfs:label "A WIP limit is a policy with a target and a value (L1)"@en ;
    sh:property [ sh:path backlog:wipLimitFor ; sh:minCount 1 ; sh:class backlog:WorkItemContainer ;
                  sh:message "A WIP limit must name what it constrains." ] ;
    sh:property [ sh:path backlog:hasWipLimitValue ; sh:minCount 1 ; sh:datatype xsd:integer ;
                  sh:message "A WIP limit must state its value." ] .

backlog:WipBreachAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:WipLimit ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: work in progress exceeds the declared limit"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: more items are in progress in this container than the declared WIP limit permits; the limit is describing the overrun rather than constraining it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { SELECT $this ?limit (COUNT(?i) AS ?wip) WHERE {
                $this backlog:wipLimitFor ?c ; backlog:hasWipLimitValue ?limit .
                ?i backlog:memberOfContainer ?c ; backlog:hasState backlog:InProgress .
            } GROUP BY $this ?limit }
            FILTER (?wip > ?limit)
        }""" ] .

backlog:TeamShape a sh:NodeShape ;
    sh:targetClass backlog:Team ;
    sh:severity sh:Violation ;
    rdfs:label "A team delivers from something (L1)"@en ;
    sh:property [ sh:path backlog:teamFor ; sh:minCount 1 ; sh:class backlog:WorkItemContainer ;
                  sh:message "A team must name the register or project it delivers from." ] .

backlog:StoryFormAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: story states no beneficiary or no reason"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this story records no 'so that' clause, so it states a feature request and nothing about the benefit it claims." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER EXISTS { $this backlog:asRole ?r }
            FILTER NOT EXISTS { $this backlog:soThat ?s }
        }""" ] .

#################################################################
#  v1.5.0 — falsifiability pack
#  Each shape below closes one route by which the adversarial
#  register passed: arbitrary numbers, unobserved targets,
#  self-asserted verification, vacuous criteria, stale scores.
#################################################################

backlog:ScoreArithmeticShape a sh:NodeShape ;
    sh:targetClass backlog:WSJFScore ;
    sh:severity sh:Violation ;
    rdfs:label "A WSJF score equals its own components (L1)"@en ;
    sh:property [ sh:path backlog:hasJobSize ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "A WSJF score must record its job size." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this WSJF value does not equal (user-business value + time criticality + risk reduction) / job size computed from its own components; the number is unrelated to its inputs and cannot be checked or challenged." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasScoreValue ?v ;
                  backlog:hasUserBusinessValue ?ubv ; backlog:hasTimeCriticality ?tc ;
                  backlog:hasRiskReductionValue ?rr ; backlog:hasJobSize ?js .
            FILTER (?js > 0)
            BIND ((?ubv + ?tc + ?rr) / ?js AS ?computed)
            FILTER (ABS(?v - ?computed) > 0.05)
        }""" ] .

backlog:RiceArithmeticShape a sh:NodeShape ;
    sh:targetClass backlog:RICEScore ;
    sh:severity sh:Violation ;
    rdfs:label "A RICE score equals its own components (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this RICE value does not equal reach x impact x confidence / effort computed from its own components." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasScoreValue ?v ;
                  backlog:hasReach ?r ; backlog:hasImpact ?i ; backlog:hasConfidence ?c ; backlog:hasEffort ?e .
            FILTER (?e > 0)
            BIND ((?r * ?i * ?c) / ?e AS ?computed)
            FILTER (ABS(?v - ?computed) > 0.05)
        }""" ] .

backlog:ScoreAccountabilityShape a sh:NodeShape ;
    sh:targetClass backlog:PriorityScore ;
    sh:severity sh:Violation ;
    rdfs:label "A number carries components or a rationale (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this score carries neither the components it was computed from nor a written rationale, so it is an unattributable number driving an ordering." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasScoreRationale ?r }
            FILTER NOT EXISTS { $this backlog:hasJobSize ?js }
            FILTER NOT EXISTS { $this backlog:hasEffort ?e }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this score predates the most recent completion in the register and was never re-run; a ranking is a snapshot of value per cost at one moment, not a committed order (BP-D11)." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?item backlog:hasPriorityScore $this ; backlog:hasState ?st .
            FILTER (?st NOT IN (backlog:Done, backlog:Cancelled))
            $this backlog:scoredAt ?sa .
            ?other backlog:finishedAt ?f .
            FILTER (?f > ?sa)
        }""" ] .

backlog:ObjectiveFalsifiabilityShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "An objective can be missed (L1/L3)"@en ;
    sh:property [ sh:path backlog:hasTargetDirection ; sh:minCount 1 ; sh:class backlog:MetricDirection ;
                  sh:message "L1: an objective must state which way the metric has to move; a baseline and a target with no direction cannot be contradicted by any observation." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this objective's target equals its baseline, so it is met on the day it is written." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBaselineValue ?b ; backlog:hasTargetValue ?t .
            FILTER (?b = ?t)
            # An inverse goal's objective is a CEILING: the count must not
            # exceed its baseline. Dir_Hold says so explicitly rather than
            # bending the baseline to satisfy a clause written for
            # trajectories.
            FILTER NOT EXISTS { $this backlog:hasTargetDirection backlog:Dir_Hold }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this objective's deadline has passed with no observation of its metric and no recorded re-baseline; the target can therefore never be shown to have been missed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasObjectiveDeadline ?d .
            FILTER (STR(?d) < SUBSTR(STR(NOW()), 1, 19))
            FILTER NOT EXISTS { ?o backlog:observationFor $this }
            FILTER NOT EXISTS { ?rb backlog:rebaselines $this }
        }""" ] .

backlog:MetricObservationShape a sh:NodeShape ;
    sh:targetClass backlog:MetricObservation ;
    sh:severity sh:Violation ;
    rdfs:label "An observation is reproducible (L1)"@en ;
    sh:property [ sh:path backlog:observesMetric ; sh:minCount 1 ;
                  sh:message "An observation must name the metric it read." ] ;
    sh:property [ sh:path backlog:hasObservedValue ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "An observation must carry the value read." ] ;
    sh:property [ sh:path backlog:observedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "An observation must record when it was read." ] ;
    sh:property [ sh:path backlog:hasObservationMethod ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "An observation must record how the value was obtained, or it is a number someone remembered." ] .

backlog:MilestoneOutcomeShape a sh:NodeShape ;
    sh:targetClass backlog:Milestone ;
    sh:severity sh:Violation ;
    rdfs:label "A slipped date is visible (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this milestone's target date has passed with no achievement recorded and no re-baseline; a date that quietly stops applying cannot be missed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasTargetDate ?d .
            FILTER (STR(?d) < SUBSTR(STR(NOW()), 1, 19))
            FILTER NOT EXISTS { $this backlog:achievedAt ?a }
            FILTER NOT EXISTS { ?rb backlog:rebaselines $this }
        }""" ] .

backlog:RebaselineShape a sh:NodeShape ;
    sh:targetClass backlog:Rebaseline ;
    sh:severity sh:Violation ;
    rdfs:label "Moving a goalpost is owned and reasoned (L1)"@en ;
    sh:property [ sh:path backlog:rebaselines ; sh:minCount 1 ;
                  sh:message "A re-baseline must name what it moved." ] ;
    sh:property [ sh:path backlog:hasPreviousTarget ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A re-baseline must retain the previous target, or the size of the move is invisible." ] ;
    sh:property [ sh:path backlog:hasNewTarget ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A re-baseline must state the new target." ] ;
    sh:property [ sh:path backlog:hasRebaselineRationale ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A re-baseline must record why; without a reason it is indistinguishable from erasing a failure." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Re-baselining is an owner decision and must name the Owner as its decider." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this backlog:decidedBy backlog:Owner } }""" ] .

backlog:VerificationIntegrityShape a sh:NodeShape ;
    sh:targetClass backlog:Evidence ;
    sh:severity sh:Violation ;
    rdfs:label "Verification names something that could have failed (L2/L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this evidence is marked verified but its method is a bare assertion; verification must name a check that could have failed, not a statement that it did not." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:evidenceVerified true ; backlog:hasVerificationMethod ?m .
            FILTER (REGEX(?m, "^(asserted|assumed|manual|by inspection|n/?a|trusted|ok|done|fixture)", "i")
                    || STRLEN(?m) < 20)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this verified evidence names no tool that performed the check." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:evidenceVerified true .
            FILTER NOT EXISTS { $this backlog:verifiedByTool ?t }
        }""" ] .

backlog:AcceptanceCriterionQualityShape a sh:NodeShape ;
    sh:targetClass backlog:AcceptanceCriterion ;
    sh:severity sh:Violation ;
    rdfs:label "An acceptance criterion says something (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this acceptance criterion is Gherkin-shaped but empty — each of Given, When and Then must carry substantive text, or the criterion cannot be tested and cannot fail." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasGherkinText ?t .
            FILTER (!REGEX(?t, "Given\\\\s+\\\\S+.{8,}When\\\\s+\\\\S+.{8,}Then\\\\s+\\\\S+.{8,}", "is"))
        }""" ] .

backlog:EstimateAccountabilityShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Estimates are compared with actuals (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this completed item carries a cost estimate but no actual effort, so the estimate can never be shown to have been wrong." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done ; backlog:hasCostEstimate ?e .
            FILTER NOT EXISTS { $this backlog:hasActualEffort ?a }
        }""" ] .

backlog:IntentTraceabilityShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Every item traces to a stated objective (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this item advances no recorded objective, directly or through a container; its value claim is unfalsifiable because it refers to nothing the product is trying to achieve." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?s .
            FILTER (?s != backlog:Cancelled)
            FILTER NOT EXISTS { $this backlog:pursuesObjective ?o }
            FILTER NOT EXISTS { $this backlog:memberOfContainer ?c . ?c backlog:pursuesObjective ?o2 }
            FILTER NOT EXISTS { ?parent backlog:decomposesInto $this ; backlog:pursuesObjective ?o3 }
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
        }""" ] .

backlog:RoadmapOverrideShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItemContainer ;
    sh:severity sh:Violation ;
    rdfs:label "A rank that contradicts the scores is a declared override (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this container is ranked ahead of one with a higher score and records no rationale; a roadmap order that departs from the scores without saying why is indistinguishable from an arbitrary one." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:rankedOnRoadmap ?rm ; backlog:hasRoadmapRank ?r1 ; backlog:hasPriorityScore ?s1 .
            ?other backlog:rankedOnRoadmap ?rm ; backlog:hasRoadmapRank ?r2 ; backlog:hasPriorityScore ?s2 .
            ?s1 backlog:hasScoreValue ?v1 . ?s2 backlog:hasScoreValue ?v2 .
            FILTER (?r1 < ?r2 && ?v1 < ?v2)
            FILTER NOT EXISTS { $this backlog:hasDecisionRationale ?rat }
        }""" ] .

#################################################################
#  v1.6.0 — intent chain, scope boundary, external dependencies
#################################################################

backlog:MissionShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Violation ;
    rdfs:label "A mission is stated, owned and served by goals (L1/L2)"@en ;
    sh:property [ sh:path backlog:hasMissionStatement ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "L1: a mission must be stated." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a mission is an owner declaration and must name the Owner as its decider." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this backlog:decidedBy backlog:Owner } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: no goal advances this mission, so nothing in the register is accountable to it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?g backlog:contributesToMission $this }
            FILTER NOT EXISTS { $this backlog:belongsToLineage ?l . ?l backlog:lineageArchived true }
            # A mission whose lineage has not yet reached the Goal stage
            # SHOULD have no goals. Found the first time the v5.0.0 staged
            # ceremony was actually followed: it says the Mission stage closes
            # in its own commit, and this clause demanded a goal in that same
            # commit. Two of this package's own rules made the standard
            # ceremony impossible to follow — the ceremony was published three
            # releases before anyone tried to obey it.
            FILTER NOT EXISTS { $this backlog:producedByStage ?mout }
            # A superseded mission SHOULD have no goals: they were re-pointed to
            # the mission that replaced it. Requiring one would force a goal to
            # serve two missions at once, which the forked-chain rule rejects —
            # two of this package's own rules pulling opposite ways, found when
            # a mission was amended for the first time.
            FILTER NOT EXISTS { ?s backlog:supersedesMission $this }
        }""" ] .

backlog:GoalMeasurabilityShape a sh:NodeShape ;
    sh:targetClass backlog:Goal ;
    sh:severity sh:Violation ;
    rdfs:label "Every goal is measurable through an objective (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this goal carries no objective, so it states an intention nothing can measure and no observation can contradict." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?o backlog:contributesToGoal $this }
            # A goal whose lineage has not yet reached the Objective stage
            # SHOULD have no objective. THIRD instance of the same conflict:
            # Mission at v1.99.0, Scope at v1.100.0, Goal here. Every clause
            # written for a finished lineage assumes completeness, and the
            # staged ceremony makes every intermediate state legal. Three
            # found by walking the stages; the Objective stage will find the
            # fourth if there is one.
            FILTER NOT EXISTS { $this backlog:producedByStage ?gout }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this goal advances no mission; the intent chain does not reach a stated purpose." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER EXISTS { ?m a backlog:Mission }
            FILTER NOT EXISTS { $this backlog:contributesToMission ?m2 }
        }""" ] .

backlog:ScopeMeasurabilityShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Violation ;
    rdfs:label "Scope names what it is for and what it is not (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this scope realises no objective, so completing it proves nothing and its success cannot be evaluated." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:scopeRealizesObjective ?o }
            FILTER NOT EXISTS { ?o2 backlog:fillsScope $this }
            # A scope whose lineage has not yet reached the Objective stage
            # SHOULD have no objective. Second instance of the same conflict
            # the Mission stage hit one release ago: a clause written for a
            # finished lineage, applied to one under construction. The staged
            # ceremony makes every intermediate state legal, and every clause
            # that assumed completeness now has to say so.
            FILTER NOT EXISTS { $this backlog:producedByStage ?sout }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this scope states no exclusion; a boundary with only an inside has not been drawn." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasScopeExclusion ?e }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this scope's work is complete but its outcome has not been derived; completion was reported without asking whether it worked." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:scopeCompletionState backlog:Done .
            FILTER NOT EXISTS { $this backlog:scopeOutcome ?o }
        }""" ] .

backlog:ScopeChangeShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeChange ;
    sh:severity sh:Violation ;
    rdfs:label "Scope may grow, but never invisibly (L1)"@en ;
    sh:property [ sh:path backlog:changesScope ; sh:minCount 1 ; sh:class backlog:ScopeStatement ;
                  sh:message "A scope change must name the scope it changes." ] ;
    sh:property [ sh:path backlog:admitsItem ; sh:minCount 1 ; sh:class backlog:WorkItem ;
                  sh:message "A scope change must name what it admits." ] ;
    sh:property [ sh:path backlog:hasScopeChangeRationale ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A scope change must state why the boundary moved and what was traded to pay for it." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Scope change is an owner decision and must name the Owner as its decider." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this backlog:decidedBy backlog:Owner } }""" ] .

backlog:ExternalDependencyShape a sh:NodeShape ;
    sh:targetClass backlog:ExternalDependency ;
    sh:severity sh:Violation ;
    rdfs:label "An external dependency names a type and a party (L1)"@en ;
    sh:property [ sh:path backlog:hasExternalDependencyType ; sh:minCount 1 ; sh:class backlog:ExternalDependencyType ;
                  sh:message "An external dependency must state its type; the type decides the escalation path." ] ;
    sh:property [ sh:path backlog:hasExternalParty ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "An external dependency must name who owns it; an unnamed one cannot be chased and becomes a permanent excuse." ] .

backlog:ExternalEnhancementShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "External change is proposed, never scheduled here (L1/L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item needs an external party to change something, but no enhancement proposal exists for that dependency. The change belongs to whoever owns it: raise a proposal, do not schedule their work in this register." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:requiresExternalEnhancement ?ext .
            FILTER NOT EXISTS { ?prop backlog:proposalFor ?ext ; backlog:unblocksItem $this }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this item depends on an external enhancement whose proposal has not been accepted, yet it is Ready or In Progress. Work that only another party can unblock is not startable, and treating it as startable is how a plan absorbs someone else's backlog." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:requiresExternalEnhancement ?ext ; backlog:hasState ?s .
            FILTER (?s IN (backlog:Ready, backlog:InProgress))
            ?prop backlog:proposalFor ?ext ; backlog:unblocksItem $this ; backlog:hasProposalStatus ?ps .
            FILTER (?ps != backlog:Prop_Accepted)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: the proposal this item waits on was rejected, and the item is still open with no scope change admitting the work locally. A refusal must be re-planned, cancelled, or brought into scope explicitly — never left as indefinite waiting." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:requiresExternalEnhancement ?ext ; backlog:hasState ?s .
            FILTER (?s != backlog:Cancelled)
            ?prop backlog:proposalFor ?ext ; backlog:unblocksItem $this ;
                  backlog:hasProposalStatus backlog:Prop_Rejected .
            FILTER NOT EXISTS { ?sc backlog:admitsItem $this }
        }""" ] .

backlog:EnhancementProposalShape a sh:NodeShape ;
    sh:targetClass backlog:EnhancementProposal ;
    sh:severity sh:Violation ;
    rdfs:label "A proposal is specific, addressed and dated (L1)"@en ;
    sh:property [ sh:path backlog:proposalFor ; sh:minCount 1 ; sh:class backlog:ExternalDependency ;
                  sh:message "A proposal must name the external dependency it asks to change." ] ;
    sh:property [ sh:path backlog:hasRequestedChange ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A proposal must state what is being asked for, specifically enough to be accepted or refused." ] ;
    sh:property [ sh:path backlog:submittedTo ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A proposal must record where it was sent, so 'we asked' is checkable." ] ;
    sh:property [ sh:path backlog:proposalRaisedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "A proposal must record when it was raised; its age measures how long this development has been blocked by someone else." ] ;
    sh:property [ sh:path backlog:hasProposalStatus ; sh:minCount 1 ; sh:class backlog:ProposalStatus ;
                  sh:message "A proposal must carry a status." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "An enhancement proposal may not also be a work item: a work item is something this development can decide to do, and this is not." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this a ?c . ?c rdfs:subClassOf* backlog:WorkItem }""" ] .

backlog:RegisterSessionShape a sh:NodeShape ;
    sh:targetClass backlog:RegisterSession ;
    sh:severity sh:Violation ;
    rdfs:label "A session that changed the register verified it first (L1/L2)"@en ;
    sh:property [ sh:path backlog:sessionStartedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "A session must record when it started." ] ;
    sh:property [ sh:path backlog:hasSessionScopeNote ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "A session must state what it set out to do and what it deliberately left alone; the unstated boundary is how a one-item fix becomes a reorganisation." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this session changed items without verifying the register's state first, so it cannot tell the defects it inherited from the ones it introduced." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:changedItem ?i .
            FILTER NOT EXISTS { $this backlog:stateVerifiedAtStart true }
        }""" ] .

#################################################################
#  v1.7.0 — register packaging: what an adopter must ship
#################################################################

backlog:RegisterPackageShape a sh:NodeShape ;
    sh:targetClass backlog:RegisterPackage ;
    sh:severity sh:Violation ;
    rdfs:label "A package is versioned, manifested and complete (L1/L2/L3)"@en ;
    sh:property [ sh:path backlog:packageFor ; sh:minCount 1 ; sh:class backlog:WorkItemContainer ;
                  sh:message "L1: a register package must name the register it ships." ] ;
    sh:property [ sh:path backlog:hasPackageVersion ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[0-9]+[.][0-9]+[.][0-9]+$" ;
                  sh:message "L1: a register package must carry a three-part version; a changed register that reuses its version is the same defect as a changed ontology that reuses its version." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a register package must ship exactly one manifest artifact — the thing that makes everything else verifiable after transport." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { SELECT $this (COUNT(?a) AS ?n) WHERE {
                $this backlog:hasPackageArtifact ?a . ?a backlog:hasArtifactRole backlog:Role_Manifest .
            } GROUP BY $this }
            FILTER (?n != 1)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a register package must ship the register data itself." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasPackageArtifact ?a . ?a backlog:hasArtifactRole backlog:Role_RegisterData }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: a register package must ship its adoption profile declaration, so a consumer can see which conformance level is claimed before validating anything." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasPackageArtifact ?a . ?a backlog:hasArtifactRole backlog:Role_ProfileDeclaration }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: a register package must retain at least one roadmap report run as a file; a package that retains none can show a state but never a trajectory." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasPackageArtifact ?a . ?a backlog:hasArtifactRole backlog:Role_ProgressReport }
        }""" ] .

backlog:RegisterArtifactShape a sh:NodeShape ;
    sh:targetClass backlog:RegisterArtifact ;
    sh:severity sh:Violation ;
    rdfs:label "Every shipped file declares its role, name and convention (L1)"@en ;
    sh:property [ sh:path backlog:hasArtifactRole ; sh:minCount 1 ; sh:class backlog:ArtifactRole ;
                  sh:message "L1: a shipped file must declare its role; a role inferred from a filename is a role nobody checked." ] ;
    sh:property [ sh:path backlog:hasArtifactFileName ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "L1: a shipped file must record the name it ships under." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a shipped file other than the manifest must name the configuration-subject naming convention it follows, so its filename can be checked against the pattern that already governs that artifact type." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasArtifactRole backlog:Role_Manifest }
            FILTER NOT EXISTS { $this backlog:conformsToNamingConvention ?c }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: the manifest artifact must carry its own SHA-256, so the thing that verifies everything else is verifiable in turn." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasArtifactRole backlog:Role_Manifest .
            FILTER NOT EXISTS { $this backlog:hasManifestSHA256 ?h }
        }""" ] .

backlog:ProgressFreshnessShape a sh:NodeShape ;
    sh:targetClass backlog:RoadmapReport ;
    sh:severity sh:Violation ;
    rdfs:label "Retained progress is current with the register (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this retained report run predates the register's most recent recorded transition, so the shipped progress evidence describes a state the register has already left." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:reportRunRetainedAs ?file ; backlog:hasRunTimestamp ?run .
            ?ev backlog:transitionedAt ?t .
            FILTER (?t > ?run)
            FILTER NOT EXISTS {
                ?other backlog:reportRunRetainedAs ?f2 ; backlog:hasRunTimestamp ?r2 .
                FILTER (?r2 >= ?t)
            }
        }""" ] .

#################################################################
#  v1.9.0 — a recorded ranking-fork resolution is an owner decision
#################################################################

backlog:RankingForkResolutionShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Violation ;
    rdfs:label "A resolved ranking fork carries its decider and its reasoning (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a register that records which model resolves the ranking fork must name the Owner as its decider. Choosing between two legitimate answers is a business judgement, not a computation." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasRankingForkResolution ?m .
            FILTER NOT EXISTS { $this backlog:decidedBy backlog:Owner }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a recorded ranking-fork resolution must carry a written rationale; a standing answer with no reasoning cannot be reviewed when the situation changes." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasRankingForkResolution ?m .
            FILTER NOT EXISTS { $this backlog:hasDecisionRationale ?r }
        }""" ] .

#################################################################
#  v1.10.0 — acceptance criteria that describe the change rather
#  than the behaviour. ADVISORY by construction: no regex can
#  decide whether prose describes behaviour, and a heuristic that
#  blocked a release would be a gate making a judgement it cannot
#  support. The advisory digest makes it legible without that claim.
#################################################################

backlog:ArtifactEnumerationAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a user-facing item's criteria may describe the change, not the behaviour"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every acceptance criterion on this user-facing story reads as an enumeration of files, fields, tables or endpoints. That describes the change, not the behaviour: could someone who never sees the diff tell from this text whether the item works — what a user does, what they then see, and what happens when it goes wrong?" ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAcceptanceCriterion ?any .
            FILTER NOT EXISTS {
                $this backlog:hasAcceptanceCriterion ?ac .
                ?ac backlog:hasGherkinText ?t .
                FILTER (!REGEX(?t, "(\\\\.ttl|\\\\.py|\\\\.js|\\\\.ts|\\\\.sql|\\\\bfile|\\\\bfield|\\\\bcolumn|\\\\btable|\\\\bschema|\\\\bendpoint|\\\\bmodule)", "i"))
            }
        }""" ] .

#################################################################
#  v1.11.0 — fixing a disclosed-broken mechanism
#
#  Raised by an adopting project at L1 Core from four incidents in
#  its own history, the last found the same day: a Story that fixed
#  a mechanism previously disclosed as broken reached Done with the
#  fix verified only in a throwaway directory. Nothing committed
#  would have caught it silently regressing.
#
#  The proposal asked for a conformance-level-independent rule and
#  offered a self-declared boolean flag as the trigger. Neither is
#  adopted as offered, for two reasons.
#
#  First, no new vocabulary is minted (L-110, single-producer
#  evidence). The relation already exists: a CrossCuttingInvariant
#  whose status is NotYetEnforceable and whose tracksItem points at
#  a work item IS, by its own shipped definition, "a mechanism
#  disclosed broken, pointing at the work that would fix it". The
#  trigger is therefore DERIVED from data the project already
#  maintains rather than declared.
#
#  Second, a self-declared flag that creates an obligation is opt-in
#  rigor: setting it costs an evidence requirement, so the projects
#  that set it honestly are the ones already disclosing in prose —
#  the ones that least need catching. The reporting project's own
#  fourth incident proves the point: that Story's registration DID
#  disclose the gap in prose and still reached Done.
#
#  These fire at L1 because they are ordinary well-formedness — "you
#  asserted X, therefore carry Y" — the same shape as cancellation
#  requiring a rationale or a launch gate requiring an owner. The
#  proposal's ask for level-independence is granted without breaking
#  the L1/L2 tiering principle, because it was never a coverage
#  requirement to begin with.
#################################################################

backlog:DisclosedBrokenMechanismFixShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A fix to a disclosed-broken mechanism carries durable proof (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item is Done and is the tracked fix for an invariant still reported NotYetEnforceable, yet it carries no Evidence. Fixing a mechanism's internal correctness is not the same claim as proving it stays correct — without a durable artifact, a silent regression is indistinguishable from the original undetected breakage." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            ?inv backlog:tracksItem $this ; backlog:hasInvariantStatus backlog:NotYetEnforceable .
            FILTER NOT EXISTS { $this backlog:hasEvidence ?ev }
        }""" ] .

backlog:StaleInvariantStatusShape a sh:NodeShape ;
    sh:targetClass backlog:CrossCuttingInvariant ;
    sh:severity sh:Violation ;
    rdfs:label "An invariant is re-checked once its enabling work is Done (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: every work item this invariant tracks is Done, yet it is still reported NotYetEnforceable. The status is stale: the work that would make the check runnable has shipped, so the check must be run and the outcome recorded as Holds or Violated. An invariant left NotYetEnforceable after its enabling work completes is the reporting failure this status exists to prevent, arriving one step later." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInvariantStatus backlog:NotYetEnforceable .
            FILTER EXISTS { $this backlog:tracksItem ?any }
            FILTER NOT EXISTS {
                $this backlog:tracksItem ?i .
                ?i backlog:hasState ?s .
                FILTER (?s != backlog:Done)
            }
        }""" ] .

#################################################################
#  v1.12.0 — the conformance declaration is itself governed
#
#  These fire ALWAYS. They are deliberately not gated on the level,
#  because a constraint on the level declaration that the level
#  declaration could switch off would be the defect it exists to
#  prevent, one turn later.
#
#  ConformanceDeclarationShape, built here, retired at v1.152.0
#  when conformance-level gating itself was removed: there is no
#  longer a level declaration to require an owner and rationale
#  for. The incident above is left as written.
#################################################################

#################################################################
#  v1.13.0 — rank uniqueness reaches ranked WORK ITEMS
#
#  The existing uniqueness check lives on ContainerLinkageShape and
#  targets WorkItemContainer, so a register that ranks epics — which
#  are WorkItems — was never checked at all. An adopting session did
#  exactly that, saw zero violations, and reported the tie as a
#  deliberate framework behaviour. It was a gap, not a feature.
#
#  Launch priority may tie, and deliberately: co-equal preconditions
#  that must ALL clear are a real situation. A roadmap rank may not,
#  and the difference is not arbitrary — a launch priority orders
#  gates that all have to be passed, while a roadmap rank answers
#  "what next". Two things at rank 6 is exactly the unanswered
#  question the rank exists to answer.
#################################################################

backlog:WorkItemRoadmapRankShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A ranked work item is ranked uniquely, and is on a roadmap (L1)"@en ;
    rdfs:comment "SEE ALSO the roadmap-placement clause in backlog:ContainerLinkageShape, roughly a thousand lines above and targeting backlog:WorkItemContainer. This shape never objects to an item having no rank; that one requires a rank on any launch-gated container at L2. Same vocabulary, different target class, opposite default for absence."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: two ranked entries hold the same rank on one roadmap; a rank that does not order is not a rank. Launch priority may tie because co-equal preconditions must all clear; a roadmap rank answers what to do next, and a tie there is the question the rank exists to answer, left unanswered." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:rankedOnRoadmap ?rm ; backlog:hasRoadmapRank ?r .
            ?other backlog:rankedOnRoadmap ?rm ; backlog:hasRoadmapRank ?r .
            FILTER (?other != $this)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this work item carries a roadmap rank without naming the roadmap it is ranked on. A rank is meaningless outside the ordering it belongs to." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasRoadmapRank ?r .
            FILTER NOT EXISTS { $this backlog:rankedOnRoadmap ?rm }
        }""" ] .

backlog:DisjointDomainMisuseShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A work item does not carry container-only properties (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this work item carries a property whose rdfs:domain is WorkItemContainer, and the two classes are declared disjoint. SHACL alone will not notice — an rdfs:domain is an inference rule, not a constraint — but an OWL 2 DL reasoner would infer this item to be a container as well, making the register logically inconsistent while every SHACL gate still reports clean. This check exists because that is precisely what happened to an adopting register, and because this package carries no reasoner attestation." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { $this backlog:containerDependsOn ?x } UNION { $this backlog:hasMember ?x }
            UNION { $this backlog:hasScopeStatement ?x } UNION { $this backlog:isBusinessCapability ?x }
            UNION { $this backlog:hasCommitment ?x } UNION { $this backlog:hasLifecyclePhase ?x }
            UNION { $this backlog:hasExternalBlocker ?x } UNION { $this backlog:derivedState ?x }
        }""" ] .

#################################################################
#  v1.15.0 — a measured claim names what measured it
#################################################################

backlog:EstimationBasisShape a sh:NodeShape ;
    sh:targetClass backlog:CostEstimate ;
    sh:severity sh:Violation ;
    rdfs:label "A measured estimate is re-derivable (L1/L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this estimate declares its basis Measured but names no observation. Claiming a figure was measured without naming what produced it is the same defect as evidence marked verified with the method 'asserted' — the stronger word without the stronger evidence behind it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBasisKind backlog:Basis_Measured .
            FILTER NOT EXISTS { $this backlog:basisObservation ?o }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this estimate declares its basis Analogous but names no completed item it was drawn from. An analogy nobody can inspect cannot be checked for fairness, and a systematically bad one stays invisible." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBasisKind backlog:Basis_Analogous .
            FILTER NOT EXISTS { $this backlog:analogousTo ?i }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this estimate declares no basis kind, so a reader cannot tell whether the figure was executed, drawn from a comparable, or reasoned. hasCostBasis records what it was based on; this records whether that basis was RUN." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasBasisKind ?k }
        }""" ] .

backlog:ScoreBasisShape a sh:NodeShape ;
    sh:targetClass backlog:PriorityScore ;
    sh:severity sh:Violation ;
    rdfs:label "A measured score names what measured it (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this score declares its basis Measured but names no observation. A ranking whose inputs are claimed to be measured carries more authority than one whose inputs were argued, and it must earn that by naming what produced them." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBasisKind backlog:Basis_Measured .
            FILTER NOT EXISTS { $this backlog:basisObservation ?o }
        }""" ] .

backlog:MeasuredBasisAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a launch-blocking item resting on a judged estimate"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this item is inside a declared launch gate and its cost estimate is a judgement with nothing executed behind it. Where a figure can be test-driven — a spike, a trial run, a query over the register itself — measuring it costs less than being wrong about it on the critical path. Judgement is a legitimate basis and this is not a violation; it is the place where measuring pays best." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:memberOfContainer ?c ; backlog:hasCostEstimate ?e .
            ?c backlog:isLaunchGate true .
            $this backlog:hasState ?s .
            FILTER (?s NOT IN (backlog:Done, backlog:Cancelled))
            ?e backlog:hasBasisKind backlog:Basis_Judged .
        }""" ] .

#################################################################
#  v1.16.0 — BRF-EP1: execution tasks are subordinate
#
#  Each clause below enforces one phrase of the acceptance criterion
#  the framework's own register set for this work.
#################################################################

backlog:ExecutionTaskShape a sh:NodeShape ;
    sh:targetClass backlog:ExecutionTask ;
    sh:severity sh:Violation ;
    rdfs:label "An execution task is subordinate and carries no independent value (L1/L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this execution task carries a priority score. Its value is its parent's, so scoring it separately double-counts — the same error the framework already refuses when a decomposed parent and its children are both scored. If it deserves an independent score it is a product backlog item, not an execution task." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:hasPriorityScore ?s }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this execution task is ranked on a roadmap. A roadmap orders what a product will deliver; execution steps are how one item gets delivered, and placing them there compares work of different kinds on one axis." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:rankedOnRoadmap ?r }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this execution task is not part of any product backlog item. A task exists only as a step of the item it came from; one belonging to nothing has no value to inherit and no completion that means anything." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?p backlog:decomposesInto $this . ?p a/rdfs:subClassOf* backlog:ProductBacklogItem }
            FILTER NOT EXISTS { ?e backlog:producesTask $this }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this execution task traces to no planning event, so the register cannot say who committed to it, when, or into which iteration. Tasks that appear without a planning event are work nobody is recorded as having planned." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?e backlog:producesTask $this }
        }""" ] .

backlog:PlanningEventShape a sh:NodeShape ;
    sh:targetClass backlog:PlanningEvent ;
    sh:severity sh:Violation ;
    rdfs:label "A planning event records a real conversion (L1)"@en ;
    sh:property [ sh:path backlog:plansItem ; sh:minCount 1 ; sh:class backlog:ProductBacklogItem ;
                  sh:message "L1: a planning event must name the backlog item it planned." ] ;
    sh:property [ sh:path backlog:plannedInto ; sh:minCount 1 ; sh:class backlog:Iteration ;
                  sh:message "L1: a planning event must name the iteration the item was committed to." ] ;
    sh:property [ sh:path backlog:plannedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: a planning event must record when it happened." ] ;
    sh:property [ sh:path backlog:producesTask ; sh:minCount 1 ; sh:class backlog:ExecutionTask ;
                  sh:message "L1: a planning event must produce at least one execution task; a commitment with no plan behind it records only the intention to have planned." ] .

backlog:PbiCompletionShape a sh:NodeShape ;
    sh:targetClass backlog:ProductBacklogItem ;
    sh:severity sh:Violation ;
    rdfs:label "A backlog item is not Done while its execution tasks are open (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this backlog item is Done while an execution task planned from it is still open. The item's completion is the completion of its steps; declaring it Done first makes the remaining work invisible under an item nobody is looking at any more." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            ?e backlog:plansItem $this ; backlog:producesTask ?t .
            ?t backlog:hasState ?ts .
            FILTER (?ts NOT IN (backlog:Done, backlog:Cancelled))
        }""" ] .

#################################################################
#  v1.17.0 — BRF-EP2: a forecast states what would make it wrong
#################################################################

backlog:ForecastShape a sh:NodeShape ;
    sh:targetClass backlog:Forecast ;
    sh:severity sh:Violation ;
    rdfs:label "A forecast carries its assumptions and its arithmetic (L1)"@en ;
    sh:property [ sh:path backlog:forecastFor ; sh:minCount 1 ; sh:class backlog:WorkItemContainer ;
                  sh:message "L1: a forecast must name the register or project whose work it covers." ] ;
    sh:property [ sh:path backlog:forecastMadeAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: a forecast must record when it was made; one re-dated after the fact cannot be assessed against what was known at the time." ] ;
    sh:property [ sh:path backlog:forecastCompletion ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: a forecast must state the date it expects completion; a forecast with no date cannot be missed." ] ;
    sh:property [ sh:path backlog:forecastAssumption ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "L1: a forecast must state at least one assumption. Presented without assumptions it asks to be believed rather than checked, and when it misses there is nothing to point at as the thing that failed." ] ;
    sh:property [ sh:path backlog:forecastObservedVelocity ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "L1: a forecast must record the velocity it was computed from, so the arithmetic can be checked." ] ;
    sh:property [ sh:path backlog:forecastIterationsObserved ; sh:minCount 1 ; sh:datatype xsd:integer ;
                  sh:message "L1: a forecast must record how many closed iterations its velocity averaged over. Forecasting from one is permitted; hiding that it was one is not." ] .

backlog:IterationPeriodShape a sh:NodeShape ;
    sh:targetClass backlog:Iteration ;
    sh:severity sh:Violation ;
    rdfs:label "An iteration period is well formed (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this iteration ends before it starts." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:iterationStart ?s ; backlog:iterationEnd ?e .
            FILTER (STR(?e) < STR(?s))
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this iteration records an end but no start, so its period is open and velocity cannot be attributed to it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:iterationEnd ?e .
            FILTER NOT EXISTS { $this backlog:iterationStart ?s }
        }""" ] .

backlog:StaleForecastAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Forecast ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a forecast whose date has passed with work still open"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this forecast's completion date has passed and the register still holds open work. The forecast was missed. Which assumption failed is written on the forecast itself; that is what the assumptions are for." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:forecastCompletion ?d ; backlog:forecastFor ?c .
            FILTER (STR(?d) < SUBSTR(STR(NOW()), 1, 19))
            ?i backlog:memberOfContainer ?c ; backlog:hasState ?st .
            FILTER (?st NOT IN (backlog:Done, backlog:Cancelled))
        }""" ] .

#################################################################
#  v1.18.0 — LINEAGE COMPLETENESS
#
#  Why this shape exists, and why it targets the register:
#
#  sh:targetClass CANNOT SEE ABSENCE. A shape guarding ScopeStatement
#  has no target in a register with zero ScopeStatements, so a
#  register that omits an entire layer produces no violation from
#  the very constraints written to govern that layer. Measured on
#  this suite: 1 shape guards ScopeStatement, 2 guard Objective, 2
#  guard Goal, 1 guards Mission — all unreachable by omission.
#
#  This is not a slip; it is a structural property of SHACL, and it
#  is how a register can declare L2 conformance, report zero
#  violations, and contain no scope, no exclusions, no decomposition
#  and no Definition of Done. That happened to this framework's own
#  development register and, on the owner's report, to parallel
#  sessions using the same approach.
#
#  The remedy is presence checked from a node that is ALWAYS there.
#  The register itself is the only such node, so completeness is
#  asserted here rather than distributed across the concepts whose
#  absence is the failure.
#################################################################

backlog:LineageCompletenessShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Violation ;
    rdfs:label "A register claiming L2 or above carries a complete lineage (L2/L3)"@en ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this register declares no Mission. The intent chain has no root, so no goal in it can be said to advance anything. A shape guarding Mission cannot catch this — with zero Missions it has no target — which is why the check lives on the register." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?m a backlog:Mission ; backlog:missionFor $this }
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this register declares no Objective. Every goal it holds is unmeasurable and no observation can contradict any of it, which is the unfalsifiable-plan failure in its plainest form." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?o a backlog:Objective }
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this register declares no ScopeStatement anywhere. Nothing states what the development is for or what it will not attempt, so scope completion cannot be derived and scope growth cannot be detected — there is no boundary for a ScopeChange to change." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?s a backlog:ScopeStatement }
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this register declares no Blueprint. Mission, Objective and ScopeStatement are already register-level required here; a domain model is not, despite being the one intent-chain-adjacent element that establishes what the work is ABOUT rather than what it is FOR. An epic can decompose into fully evidenced, test-harnessed stories with no domain entity ever named, and every other shape in this suite reports clean the whole way." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?b a backlog:Blueprint ; backlog:blueprintFor $this }
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this register names no Definition of Done. Completion is then whatever each claim says it is, and every Done in the register rests on an unstated bar." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:appliesDefinitionOfDone ?d }
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this register holds scored Epics that decompose into nothing. An epic is by definition a large body of work delivered across multiple features or stories; one with no children is an estimate with no plan behind it, and its completion can only ever be asserted." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?e a backlog:Epic ; backlog:memberOfContainer $this ; backlog:hasPriorityScore ?sc .
            FILTER NOT EXISTS { ?e backlog:decomposesInto ?child }
        }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this register carries edit history (real Blueprint, Mission, Objective or ScopeStatement individuals exist) and names no RegisterSession. Someone changed this backlog; a register with real content and zero recorded sessions cannot say who, or whether its state was verified before they did, which is the unattributable-edit failure this class exists to prevent." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { ?m a backlog:Mission ; backlog:missionFor $this } UNION { ?b a backlog:Blueprint ; backlog:blueprintFor $this }
            FILTER NOT EXISTS { ?rs a backlog:RegisterSession ; backlog:sessionFor $this }
        }""" ] .

backlog:RegisterSessionIntegrityShape a sh:NodeShape ;
    sh:targetClass backlog:RegisterSession ;
    sh:severity sh:Violation ;
    rdfs:label "A recorded session states when it started and whether it verified first (L1)"@en ;
    sh:property [ sh:path backlog:sessionStartedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "A session must record when it started." ] ;
    sh:property [ sh:path backlog:stateVerifiedAtStart ; sh:minCount 1 ; sh:datatype xsd:boolean ;
                  sh:message "A session that changed items must state whether it verified the register first; the check exists precisely so this cannot be left unanswered." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this session changed items without verifying the register's state first, so it cannot tell the defects it inherited from the ones it introduced." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:changedItem ?i ; backlog:stateVerifiedAtStart false .
        }""" ] .

backlog:LineageDepthAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a register with no work beneath its epics"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this register holds Epics but no Story, Feature or ExecutionTask anywhere. A plan one level deep states intentions and schedules nothing; nothing in it can be picked up, and its Definition of Done has nothing concrete to be applied to." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?e a backlog:Epic ; backlog:memberOfContainer $this .
            FILTER NOT EXISTS { ?s a backlog:Story }
            FILTER NOT EXISTS { ?f a backlog:Feature }
            FILTER NOT EXISTS { ?t a backlog:ExecutionTask }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this register declares a ScopeStatement with no ScopeExclusion. A boundary with only an inside has not been drawn, and the questions that will later be argued about are exactly the ones an exclusion would have settled." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?s a backlog:ScopeStatement .
            FILTER NOT EXISTS { ?x a backlog:ScopeExclusion }
        }""" ] .

#################################################################
#  v1.19.0 — a plan anchored to a real moment, and honestly moved
#################################################################

backlog:KickOffShape a sh:NodeShape ;
    sh:targetClass backlog:KickOff ;
    sh:severity sh:Violation ;
    rdfs:label "A kick-off says when, for what, and on whose word (L1)"@en ;
    sh:property [ sh:path backlog:kickOffFor ; sh:minCount 1 ; sh:class backlog:WorkItemContainer ;
                  sh:message "L1: a kick-off must name what it activates." ] ;
    sh:property [ sh:path backlog:kickedOffAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: a kick-off must record the moment. Without it there is no day zero and every planned date anchors to nothing." ] ;
    sh:property [ sh:path backlog:hasKickOffMode ; sh:minCount 1 ; sh:class backlog:KickOffMode ;
                  sh:message "L1: a kick-off must say whether it was declared by a person or emitted by a trigger; a slip measured from a claim inherits that claim's reliability." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a declared kick-off must name who declared it. A start date on nobody's word cannot be questioned later." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasKickOffMode backlog:KickOff_Declared .
            FILTER NOT EXISTS { $this backlog:decidedBy ?w }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a triggered kick-off must name the trigger, so the moment is re-derivable rather than asserted." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasKickOffMode backlog:KickOff_Triggered .
            FILTER NOT EXISTS { $this backlog:hasKickOffTrigger ?t }
        }""" ] .

backlog:PlannedDateShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Planned dates are well formed and anchored (L1/L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item is planned to finish before it starts." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:plannedStart ?s ; backlog:plannedFinish ?f .
            FILTER (STR(?f) < STR(?s))
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item carries a planned finish but no planned start, so it has a deadline and no bar — schedule variance is computable at one end only." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:plannedFinish ?f .
            FILTER NOT EXISTS { $this backlog:plannedStart ?s }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this item carries planned dates but its register records no KickOff, so the baseline anchors to nothing and no schedule variance is computable. Record a KickOff, declared or triggered, before treating these dates as a plan." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:plannedStart ?s .
            FILTER NOT EXISTS { ?k a backlog:KickOff }
        }""" ] .

backlog:PlanBaselineShape a sh:NodeShape ;
    sh:targetClass backlog:PlanBaseline ;
    sh:severity sh:Violation ;
    rdfs:label "Exactly one current baseline, and superseded ones are kept (L1)"@en ;
    sh:property [ sh:path backlog:baselineFor ; sh:minCount 1 ; sh:class backlog:WorkItemContainer ;
                  sh:message "L1: a baseline must name what it baselines." ] ;
    sh:property [ sh:path backlog:baselinedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: a baseline must record when it was set." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: two baselines for the same container both claim to be current. Performance would be reported against whichever the reader picked, which is not a measurement." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:baselineFor ?c ; backlog:isCurrentBaseline true .
            ?other backlog:baselineFor ?c ; backlog:isCurrentBaseline true .
            FILTER (?other != $this)
        }""" ] .

#################################################################
#  v1.20.0 — BRF-EP3: dimensional cost is summable or it is nothing
#################################################################

backlog:CostDimensionShape a sh:NodeShape ;
    sh:targetClass backlog:CostDimension ;
    sh:severity sh:Violation ;
    rdfs:label "A dimension carries a unit, and a rate carries a currency (L1)"@en ;
    sh:property [ sh:path backlog:hasDimensionUnit ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "L1: a cost dimension must name its unit. A quantity without a unit cannot be summed, compared or budgeted against, and two dimensions in different units must never be added." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this dimension carries a rate with no currency. Summing amounts in unstated currencies produces a number with no meaning." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasDimensionRate ?r .
            FILTER NOT EXISTS { $this backlog:hasRateCurrency ?c }
        }""" ] .

backlog:DimensionalCostShape a sh:NodeShape ;
    sh:targetClass backlog:DimensionalCost ;
    sh:severity sh:Violation ;
    rdfs:label "A recorded cost names its item, its dimension and its amount (L1/L3)"@en ;
    sh:property [ sh:path backlog:alongDimension ; sh:minCount 1 ; sh:class backlog:CostDimension ;
                  sh:message "L1: a recorded cost must name the dimension it is measured along; a bare number is not a cost." ] ;
    sh:property [ sh:path backlog:hasQuantity ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "L1: a recorded cost must carry a quantity." ] ;
    sh:property [ sh:path backlog:costOfItem ; sh:minCount 1 ;
                  sh:message "L1: a recorded cost must name what it is a cost of." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this cost quantity is negative. Consumption is not negative; a correction is a new record, not a sign." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:hasQuantity ?q . FILTER (?q < 0) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this cost does not say whether its quantity was estimated or observed. A projected token spend and a metered one are different evidence, and a total mixing them without saying so reads as measurement." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:isEstimatedCost ?e }
        }""" ] .

backlog:DimensionalRollUpShape a sh:NodeShape ;
    sh:targetClass backlog:DimensionalCost ;
    sh:severity sh:Violation ;
    rdfs:label "Cost is recorded where it is incurred, never on both a parent and its child (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this cost is recorded on an item whose decomposition child also records a cost along the same dimension. Roll-up is DERIVED by summing children, never asserted on the parent — recording both double-counts, which is the error the framework already refuses for priority scores." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:costOfItem ?parent ; backlog:alongDimension ?d .
            ?parent backlog:decomposesInto ?child .
            ?other backlog:costOfItem ?child ; backlog:alongDimension ?d .
        }""" ] .

backlog:BudgetShape a sh:NodeShape ;
    sh:targetClass backlog:Budget ;
    sh:severity sh:Violation ;
    rdfs:label "A budget names its container, its dimension and its ceiling (L1)"@en ;
    sh:property [ sh:path backlog:budgetFor ; sh:minCount 1 ; sh:class backlog:WorkItemContainer ;
                  sh:message "L1: a budget must name what it constrains." ] ;
    sh:property [ sh:path backlog:budgetDimension ; sh:minCount 1 ; sh:class backlog:CostDimension ;
                  sh:message "L1: a budget must name the dimension it caps. A budget that only exists in aggregate cannot say which thing overran." ] ;
    sh:property [ sh:path backlog:hasBudgetCeiling ; sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "L1: a budget must state its ceiling." ] .

#################################################################
#  v1.21.0 — BRF-EP4: supervision claims are checkable
#################################################################

backlog:HumanInteractionShape a sh:NodeShape ;
    sh:targetClass backlog:HumanInteraction ;
    sh:severity sh:Violation ;
    rdfs:label "An interaction names what, who, when and whether it gated (L1)"@en ;
    sh:property [ sh:path backlog:interactsWith ; sh:minCount 1 ; sh:class backlog:WorkItem ;
                  sh:message "L1: an interaction must name the work item it acted on." ] ;
    sh:property [ sh:path backlog:hasInteractionKind ; sh:minCount 1 ; sh:class backlog:InteractionKind ;
                  sh:message "L1: an interaction must say what was done. A vocabulary that records only that someone looked cannot distinguish approval from inspection." ] ;
    sh:property [ sh:path backlog:interactedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: an interaction must record when it happened; in-the-loop supervision is a claim about ORDER and needs times on both sides." ] ;
    sh:property [ sh:path backlog:interactedBy ; sh:minCount 1 ; sh:class backlog:Role ;
                  sh:message "L1: an interaction must name the role that acted. One attributable to nobody cannot be audited, which is the reason for recording it." ] .

backlog:SupervisionClaimShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A supervision claim is backed by a gating interaction (L1/L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item claims in-the-loop supervision but no interaction on it gates a transition. In-the-loop means the work COULD NOT advance until a person acted; with nothing recorded as gating, the claim describes an intention rather than a mechanism, and is indistinguishable from on-the-loop." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasSupervisionMode backlog:Sup_InTheLoop .
            FILTER NOT EXISTS { ?i backlog:interactsWith $this ; backlog:gatesTransition true }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item claims no supervision yet records a gating interaction. Either a person did gate it, in which case the mode is In the loop, or the interaction did not gate anything and is mislabelled." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasSupervisionMode backlog:Sup_None .
            ?i backlog:interactsWith $this ; backlog:gatesTransition true .
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a person corrected this item's output, so an agent did not produce what shipped unaided; its modality says Automated. Correction implies Hybrid — the distinction records who is answerable for what was released." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasExecutionModality backlog:Mode_Automated .
            ?i backlog:interactsWith $this ; backlog:hasInteractionKind backlog:Int_Correct .
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this item is Done and states no execution modality, so the register cannot say whether a person or an agent produced it. A development that cannot answer 'who did this' afterwards is not auditable." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
            FILTER NOT EXISTS { $this backlog:hasExecutionModality ?m }
        }""" ] .

backlog:RubberStampAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: gating that has never refused anything"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this register records gating confirmations and not one rejection. A gate that has never refused may be doing its job on genuinely good work, or may be a formality — the register cannot tell you which, and neither can this advisory. It is raised because the same reasoning the framework applies to its own gates applies to human ones: a check never observed to fail has not been shown to be a check." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?i backlog:hasInteractionKind backlog:Int_Confirm ; backlog:gatesTransition true .
            FILTER NOT EXISTS { ?j backlog:hasInteractionKind backlog:Int_Reject }
        }""" ] .

############################################################

#################################################################
#  v1.22.0 — planning an epic into an iteration
#
#  The type system permits it: Epic is a ProductBacklogItem and
#  plansItem ranges on ProductBacklogItem. The DEFINITIONS forbid
#  it. An Epic is "a large body of work decomposed into, or
#  delivered across, MULTIPLE features or stories, its completion
#  typically DERIVED from the completion of its constituent work";
#  a Story is "small enough to be completed within ONE iteration";
#  an Iteration is a fixed-length time box. An epic committed to a
#  time box it is defined not to fit, with no children whose
#  completion could derive its own, is a commitment nothing can
#  discharge.
#
#  Added because this session read the class hierarchy, concluded
#  the arrangement was permitted, and told an adopting session so.
#  A subclass relation says what may be ASSERTED; the definition
#  says what the term MEANS, and the two answer different
#  questions. That is BP-D4 in its plainest form.
#################################################################

backlog:EpicPlanningShape a sh:NodeShape ;
    sh:targetClass backlog:PlanningEvent ;
    sh:severity sh:Violation ;
    rdfs:label "An epic is decomposed before it is planned into an iteration (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this planning event commits an Epic to an Iteration while that Epic decomposes into nothing. An epic is defined as work delivered across multiple features or stories whose completion is DERIVED from its constituent work, and an iteration is a fixed time box; an epic with no children committed to one time box can neither fit it nor derive a completion from anything. Decompose first, then plan the parts. The type system permits this arrangement — Epic is a ProductBacklogItem — which is exactly why a constraint is needed: what may be asserted and what the terms mean are different questions." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:plansItem ?e ; backlog:plannedInto ?it .
            ?e a backlog:Epic .
            FILTER NOT EXISTS { ?e backlog:decomposesInto ?child }
        }""" ] .

#################################################################
#  v1.23.0 — L4_LineageEnforced
#
#  Everything below fires ONLY when a register declares L4. Lower
#  levels are byte-identical to v1.22.0; a level is a claim an
#  adopter makes, and promoting checks inside an existing level
#  would break every adopter who made a different one.
#
#  What L4 asserts, in one sentence: completion is a fact about
#  effort and accomplishment is a fact about the world, and only
#  the second requires a measurement.
#################################################################

backlog:L4IntentChainShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "L4: every item traces to a measured objective"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this item advances no recorded objective, directly or through its container or parent. At L4 the intent chain is enforced rather than advised: an item nothing can measure the value of is work whose accomplishment cannot be shown, only whose completion can." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this a backlog:ExecutionTask }
            FILTER NOT EXISTS { $this backlog:pursuesObjective ?o }
            FILTER NOT EXISTS { $this backlog:memberOfContainer ?c . ?c backlog:pursuesObjective ?o2 }
            FILTER NOT EXISTS { ?par backlog:decomposesInto $this . ?par backlog:pursuesObjective ?o3 }
        }""" ] .

backlog:L4MeasuredObjectiveShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "L4: an objective carries a measurement, not an intention"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this objective has no MetricObservation against it. A target with no reading is an intention; the mission cannot be shown accomplished from intentions, however many of them are Done. At L4 an objective must have been measured at least once, whatever the reading said." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?obs backlog:observationFor $this }
        }""" ] .

backlog:L4GroomingShape a sh:NodeShape ;
    sh:targetClass backlog:Epic ;
    sh:severity sh:Violation ;
    rdfs:label "L4: epics are groomed, and are not deployment subjects"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this epic decomposes into nothing. An epic is a theme delivered across multiple features or stories; ungroomed it schedules nothing, can be picked up by no one, and its completion can only ever be asserted." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:decomposesInto ?child }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this epic is a member of an Iteration. An iteration is a time box and an epic is defined as work delivered ACROSS multiple stories; putting a theme in a sprint is the commonest drift this framework has observed, because it looks like planning and commits nothing anyone can finish. Plan its stories." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:memberOfContainer ?it .
            ?it a backlog:Iteration .
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this epic is carried by a DeploymentUnit. A deployment answers what users received; an epic answers why work was done. Deploy the stories it decomposed into." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?d a backlog:DeploymentUnit ; backlog:deploysItem $this .
        }""" ] .

backlog:L4StoryGranularityShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Violation ;
    rdfs:label "L4: a story reaching execution has been planned and broken down"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this story is InProgress or Done but no PlanningEvent ever took it into an iteration. Work that reached execution without passing through planning has no recorded commitment behind it: nobody is on record as having chosen it, and no iteration owns it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?st .
            FILTER (?st IN (backlog:InProgress, backlog:Done))
            FILTER NOT EXISTS { ?e a backlog:PlanningEvent ; backlog:plansItem $this }
        }""" ] .

backlog:StoryReadyToCloseShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_v1_0_0.ttl" ;
    backlog:fixtureCaseName "S_ReadyToClose" ;
    rdfs:label "Advisory: this story's tasks are all Done but the story itself is not"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every ExecutionTask this story's own PlanningEvent produced is Done, but the story itself has not been moved. The DoD check that refuses an incorrect Done claim is a validator, not an actor — nothing else proposes closing a story once the work under it genuinely finishes, so the decision is only made when someone happens to look." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT DISTINCT $this WHERE {
            $this a backlog:Story .
            FILTER NOT EXISTS { $this backlog:hasState backlog:Done }
            ?pe backlog:plansItem $this ; backlog:producesTask ?t .
            FILTER NOT EXISTS { ?pe backlog:producesTask ?t2 . FILTER NOT EXISTS { ?t2 backlog:hasState backlog:Done } }
        }""" ] .

backlog:IterationEndedIncompleteShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_v1_0_0.ttl" ;
    backlog:fixtureCaseName "S_Spillover" ;
    rdfs:label "Advisory: this story's iteration has ended and the story is not Done"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: the iteration this story was planned into has already ended, and the story is not Done. Recovering or carrying forward unfinished work is achievable today with an ordinary PlanningEvent into a new iteration, but nothing flags that this specific item needs that decision — it is reported here so a real spillover is a visible choice, not a silent one." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT DISTINCT $this WHERE {
            $this a backlog:Story .
            FILTER NOT EXISTS { $this backlog:hasState backlog:Done }
            ?pe backlog:plansItem $this ; backlog:plannedInto ?it .
            ?it backlog:iterationEnd ?end .
            FILTER (?end < NOW())
        }""" ] .

backlog:BatchCompleteButNotDoneShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_v1_0_0.ttl" ;
    backlog:fixtureCaseName "WI_BatchDoneNotClosed" ;
    rdfs:label "Advisory: every batch unit is complete but the item itself is not Done"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: hasBatchCompleted equals hasBatchSize, but hasState is not Done. A batch reaching its own declared total is exactly the moment the item-level state should be revisited — found real in a lineage that reached this state and left it unrevisited for a full turn, caught only when the terminal Done claim was finally made." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBatchSize ?sz ; backlog:hasBatchCompleted ?comp .
            FILTER (?comp = ?sz)
            FILTER NOT EXISTS { $this backlog:hasState backlog:Done }
        }""" ] .

backlog:BatchStartedStateStaleShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_v1_0_0.ttl" ;
    backlog:fixtureCaseName "WI_BatchStartedStale" ;
    rdfs:label "Advisory: real batch progress recorded but the item's own state is still its initial value"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: hasBatchCompleted is greater than zero, but hasState is still Ready or Proposed — real, verified work has happened and the item-level state was never moved to reflect it. Found real in a lineage where a batch-tracked item sat at Ready with real partial progress underneath it, corrected only on direct sweep." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBatchCompleted ?comp . FILTER (?comp > 0)
            $this backlog:hasState ?st . FILTER (?st IN (backlog:Ready, backlog:Proposed))
        }""" ] .

backlog:L4DeploymentShape a sh:NodeShape ;
    sh:targetClass backlog:Iteration ;
    sh:severity sh:Violation ;
    rdfs:label "L4: a closed iteration connects to what shipped"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this iteration is Done but no DeploymentUnit deploys from it. Cadence and release must be one story: without the link, an iteration closing and a release shipping are unrelated events in the register, and a slipped iteration cannot be connected to a delayed release." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { ?d a backlog:DeploymentUnit ; backlog:deploysFrom $this }
        }""" ] .

backlog:L4DeploymentUnitShape a sh:NodeShape ;
    sh:targetClass backlog:DeploymentUnit ;
    sh:severity sh:Violation ;
    rdfs:label "A deployment unit says what shipped and when (L1)"@en ;
    sh:property [ sh:path backlog:hasDeploymentDate ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "L1: a deployment unit must record when it shipped." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this deployment unit carries no item. A release that names nothing it delivered cannot be traced to any work, and no item can be shown to have reached users through it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this backlog:deploysItem ?i } }""" ] .

backlog:L4DriftShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Violation ;
    rdfs:label "L4: no work sits outside the declared scope"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this register holds work items whose objectives are not among those its scope statement says it realises. That is scope drift in its literal form: effort is going somewhere the declared boundary does not cover. Either the scope changed, in which case record a ScopeChange, or the work should not be here." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasScopeStatement ?sc .
            ?i backlog:memberOfContainer $this ; backlog:pursuesObjective ?o .
            # Against EVERY declared boundary, not just one. A register may hold
            # several scopes — one per mission — and comparing an item to a single
            # one reports work correctly governed by another as drift. Found by
            # running the fit-gap on this package's own register, where it flagged
            # two epics that were exactly where they belonged.
            FILTER NOT EXISTS { ?any backlog:scopeRealizesObjective ?o }
            FILTER NOT EXISTS { ?o backlog:fillsScope ?any2 }
        }""" ] .

#####
#  v1.24.0 — a deployment carries only verified work
#
#  Measured before writing: a DeploymentUnit could ship a story
#  that was InProgress, carried no Evidence, and whose acceptance
#  criterion nothing attested — 0 violations at L4. Every existing
#  deployment clause checked the SHAPE of the release (a date, at
#  least one item, no epic, an iteration link) and none checked
#  whether what it carried had been proven.
#
#  No coverage vocabulary is minted. TestHarness already carries
#  the notion: harnessComplete is derived true only when every
#  acceptance criterion of the item is attested by a bridge-verified
#  evidence artifact. That IS test coverage for an item, and it was
#  simply never consulted at release time.
#################################################################

backlog:L4DeploymentVerifiedShape a sh:NodeShape ;
    sh:targetClass backlog:DeploymentUnit ;
    sh:severity sh:Violation ;
    rdfs:label "L4: a deployment carries only proven work, and someone released it"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this deployment carries an item that is not Done. A release is the claim that work reached users; carrying unfinished work makes the claim false for part of what shipped, and nothing downstream can tell which part." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:deploysItem ?i .
            ?i backlog:hasState ?st .
            FILTER (?st != backlog:Done)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this deployment carries an item with no bridge-verified Evidence. 'The tests pass' is the claim most often made and least often traced; at release time it must be traceable to an artifact that was confirmed to exist and to have run." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:deploysItem ?i .
            FILTER NOT EXISTS { ?i backlog:hasEvidence ?e . ?e backlog:evidenceVerified true }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this deployment carries an item with an acceptance criterion that no verified evidence attests. That is a coverage hole at release time: the suite can be green while the criterion everyone cared about is untested, which is exactly what attestsCriterion exists to make visible." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:deploysItem ?i .
            ?i backlog:hasAcceptanceCriterion ?c .
            FILTER NOT EXISTS {
                ?ev backlog:attestsCriterion ?c ; backlog:evidenceVerified true .
            }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this deployment records no releasing decision. Shipping is an act someone performed; a release nobody is recorded as having authorised cannot be questioned afterwards, and the framework already requires this of every smaller irreversible choice it governs." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:decidedBy ?w }
        }""" ] .

backlog:HarnessCoverageAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:TestHarness ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a harness declared but not complete"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this harness exists but harnessComplete is not derived true, so at least one acceptance criterion of the item it proves is unattested. The harness is a statement of intent to prove; completeness is the proof." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:harnessComplete true }
        }""" ] .

#################################################################
#  v1.26.0 — BRF-EP8: a story is consumed whole within one iteration
#
#  G9 turned into a constraint. The owner examined and rejected the
#  alternative — size the iteration to the longest story — because
#  a box sized by what it contains always fits, and velocity then
#  becomes a tautology that can never report a miss.
#
#  No vocabulary is minted. Splitting IS decomposition: the term
#  already reads "a feature into stories", and a story split into
#  smaller stories is the same relation. The remedy each message
#  names is therefore expressible the moment the message is read.
#################################################################

backlog:StoryIterationFitShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Violation ;
    rdfs:label "L4: a story fits the iteration it was committed to"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this story is planned into more than one iteration. A story is defined as small enough to be completed within ONE iteration; one spanning two was either too large when it was committed or was never finished and got recommitted, and both read the same afterwards. Split it into stories that each fit, using decomposesInto — do not widen the iteration, because an iteration sized to its contents always fits and its velocity can then never report a miss." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?e1 backlog:plansItem $this ; backlog:plannedInto ?i1 .
            ?e2 backlog:plansItem $this ; backlog:plannedInto ?i2 .
            FILTER (?i1 != ?i2)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this story was committed to an iteration that has since closed, and it is still open. The iteration measured something it did not deliver, so its velocity overstates what the team can finish and the forecast built on that velocity inherits the error. Split the remainder into a story that fits the next iteration; carrying it forward whole hides the miss in both iterations at once." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?e backlog:plansItem $this ; backlog:plannedInto ?it .
            ?it backlog:iterationEnd ?end .
            FILTER (STR(?end) < SUBSTR(STR(NOW()), 1, 19))
            $this backlog:hasState ?st .
            FILTER (?st NOT IN (backlog:Done, backlog:Cancelled))
        }""" ] .

backlog:OversizedStoryAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a story estimated beyond its iteration's capacity"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this story's effort estimate exceeds the capacity of the iteration it was planned into. It has not failed yet and may still land, but a single story consuming more than a whole iteration's capacity cannot be completed within one by arithmetic. This is the point at which splitting is cheap; after the iteration closes it is a recorded miss." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?e backlog:plansItem $this ; backlog:plannedInto ?it .
            ?it backlog:hasCapacity ?cap .
            $this backlog:hasCostEstimate ?est .
            ?est backlog:hasEffortEstimate ?eff .
            FILTER (?eff > ?cap)
        }""" ] .

#################################################################
#  v1.27.0 — BRF-EP9: a deployment says how it chose
#
#  NOT a rule that a release must always take the top score. An
#  ordering is a model and is sometimes wrong, and a rule with no
#  exception path is bypassed the first time it is. What is
#  enforced is that the departure is VISIBLE.
#################################################################

backlog:DeploymentSelectionShape a sh:NodeShape ;
    sh:targetClass backlog:DeploymentUnit ;
    sh:severity sh:Violation ;
    rdfs:label "L4: a deployment records how its contents were chosen"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this deployment does not say on what basis its contents were chosen. A release grouped by theme and a release of the most valuable available work are otherwise indistinguishable in the register, and only one of them is a prioritisation decision. Opportunistic is a legitimate answer; not answering is not." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasSelectionBasis ?b }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this deployment claims its contents were the highest scored, but a Done backlog item with a higher score was available and is neither carried nor named as passed over. Either it should have shipped, or the basis is not Highest scored, or it belongs in passedOver with a rationale. All three are honest; the current state claims something the scores contradict." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasSelectionBasis backlog:Sel_HighestScored .
            $this backlog:deploysItem ?carried .
            ?carried backlog:hasPriorityScore ?cs . ?cs backlog:hasScoreValue ?cv .
            ?other backlog:hasPriorityScore ?os . ?os backlog:hasScoreValue ?ov .
            ?other backlog:hasState backlog:Done .
            FILTER (?ov > ?cv)
            FILTER NOT EXISTS { $this backlog:deploysItem ?other }
            FILTER NOT EXISTS { $this backlog:passedOver ?other }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this deployment names work it passed over but gives no rationale. Naming what was skipped without saying why records the fact and loses the reason, which is the half that would let anyone disagree with it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:passedOver ?o .
            FILTER NOT EXISTS { $this backlog:hasSelectionRationale ?r }
        }""" ] .

backlog:ScoringIgnoredAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: scoring that never changes a release"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every deployment in this register was selected on a basis other than score. Scoring may still be informing planning upstream, but no release has yet been decided by it, and a register where that stays true indefinitely is one where prioritisation is recorded and not used." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?d a backlog:DeploymentUnit ; backlog:hasSelectionBasis ?b .
            FILTER NOT EXISTS {
                ?d2 a backlog:DeploymentUnit ; backlog:hasSelectionBasis backlog:Sel_HighestScored .
            }
        }""" ] .

#################################################################
#  v1.28.0 — the chain declares which order it was built in
#################################################################

backlog:ScopeFirstOrderShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "L4: an objective names the scope it fills"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this objective names no scope it fills. An objective cannot reference a boundary that does not yet exist, so asserting fillsScope is only possible where the scope was fixed first — which is why the link, and not a date, is what records the order. A lineage built the other way round should say so by keeping scopeRealizesObjective and declaring a lower level, not by leaving the question open." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:fillsScope ?sc }
        }""" ] .

backlog:MixedOrderShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Violation ;
    rdfs:label "A lineage is built in one order or the other, not both (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this scope and one of its objectives point at each other — the scope realises the objective AND the objective fills the scope. Only one can be true of how the lineage was built: either the boundary existed and the objective was written to fill it, or the objectives existed and the boundary was drawn round them. Asserting both records no order at all, which is worse than recording the old one honestly." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:scopeRealizesObjective ?o .
            ?o backlog:fillsScope $this .
        }""" ] .

backlog:LegacyOrderAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a lineage built scope-last"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this scope points at its objectives, so it was written after them and its boundary was drawn around work already decided. That is a real record of how this lineage was built and is not an error. It is reported because such a boundary has never refused anything: to change that, fix a scope for the NEXT increment before its goals and link it with fillsScope. Do not re-point the existing links — a boundary re-derived from objectives that already exist is exactly the self-confirming one this reports." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:scopeRealizesObjective ?o .
            FILTER NOT EXISTS { ?o2 backlog:fillsScope $this }
        }""" ] .

#################################################################
#  v1.29.0 — the adaptation's control points are gates, not notes
#################################################################

backlog:AdaptationGateShape a sh:NodeShape ;
    sh:targetClass backlog:AdaptationGate ;
    sh:severity sh:Violation ;
    rdfs:label "A gate carries a check that could have failed (L1)"@en ;
    sh:property [ sh:path backlog:gateFor ; sh:minCount 1 ; sh:class backlog:LineageAdaptation ;
                  sh:message "L1: a gate must name the adaptation it controls." ] ;
    sh:property [ sh:path backlog:gatesStage ; sh:minCount 1 ; sh:class backlog:AdaptationStage ;
                  sh:message "L1: a gate must name the stage it controls." ] ;
    sh:property [ sh:path backlog:hasCheckQuery ; sh:minCount 1 ;
                  sh:message "L1: a gate must carry an executable check. A control point declared passed without something that could have failed verifies nothing — it records that someone looked." ] ;
    sh:property [ sh:path backlog:hasExpectedResult ; sh:minCount 1 ;
                  sh:message "L1: a gate must state what its check should return. Without an expectation any result can be read as success afterwards." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this gate is marked passed but its observed result differs from what it expected. A gate whose verdict disagrees with its own measurement is reporting the verdict someone wanted." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:gatePassed true ;
                  backlog:hasExpectedResult ?exp ;
                  backlog:hasGateResult ?got .
            FILTER (STR(?exp) != STR(?got))
        }""" ] .

backlog:AdaptationStageOrderShape a sh:NodeShape ;
    sh:targetClass backlog:LineageAdaptation ;
    sh:severity sh:Violation ;
    rdfs:label "Stages are reached in order, each through a passed gate (L1)"@en ;
    sh:property [ sh:path backlog:adaptsScope ; sh:minCount 1 ; sh:class backlog:ScopeStatement ;
                  sh:message "L1: an adaptation must name the boundary it converts." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this adaptation has reached Fit-gap without a passed Assess gate. A fit-gap measured before the current order is established compares the work against a baseline nobody has checked." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAdaptationStage ?st .
            FILTER (?st IN (backlog:Stage_FitGap, backlog:Stage_Ruling, backlog:Stage_Relink))
            FILTER NOT EXISTS { ?g backlog:gateFor $this ; backlog:gatesStage backlog:Stage_Assess ; backlog:gatePassed true }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this adaptation has reached Ruling or Re-link without a passed Fit-gap gate. The ruling is a decision on evidence; taken without the measurement it is the inspection that always finds a boundary drawn around past work still fits." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAdaptationStage ?st .
            FILTER (?st IN (backlog:Stage_Ruling, backlog:Stage_Relink))
            FILTER NOT EXISTS { ?g backlog:gateFor $this ; backlog:gatesStage backlog:Stage_FitGap ; backlog:gatePassed true }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this adaptation has reached Re-link with no recorded outcome. Re-linking before the ruling IS the in-place conversion the procedure exists to prevent: the links would assert an order nobody decided on." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAdaptationStage backlog:Stage_Relink .
            FILTER NOT EXISTS { $this backlog:hasAdaptationOutcome ?o }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this adaptation concluded the boundary holds, but a fit-gap finding names work outside it. The outcome contradicts the evidence the ruling was supposed to rest on; either the finding is wrong and should be withdrawn, or the boundary must be rewritten." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAdaptationOutcome backlog:Adapt_BoundaryHolds .
            ?f backlog:findingOf $this .
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this adaptation rewrote the boundary but names no new ScopeStatement, or reuses the old one. The old boundary records what was believed at the time; editing it in place erases the reason the adaptation was needed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAdaptationOutcome backlog:Adapt_BoundaryRewritten .
            OPTIONAL { $this backlog:rewritesScopeAs ?new }
            OPTIONAL { $this backlog:adaptsScope ?old }
            FILTER (!BOUND(?new) || ?new = ?old)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this adaptation rewrote the boundary but records no ScopeChange saying what was admitted and why. A rewritten scope with no change record is a boundary that moved with nobody accountable for moving it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAdaptationOutcome backlog:Adapt_BoundaryRewritten ; backlog:adaptsScope ?old .
            FILTER NOT EXISTS { ?c a backlog:ScopeChange ; backlog:changesScope ?old }
        }""" ] .

backlog:FitGapFindingShape a sh:NodeShape ;
    sh:targetClass backlog:FitGapFinding ;
    sh:severity sh:Violation ;
    rdfs:label "A finding names the work and why it falls outside (L1)"@en ;
    sh:property [ sh:path backlog:findingOf ; sh:minCount 1 ; sh:class backlog:LineageAdaptation ;
                  sh:message "L1: a finding must name the adaptation it belongs to." ] ;
    sh:property [ sh:path backlog:findingItem ; sh:minCount 1 ; sh:class backlog:WorkItem ;
                  sh:message "L1: a finding must name the work item it found outside the boundary. A count says a scope needs rewriting; a list says what it must now cover." ] ;
    sh:property [ sh:path backlog:hasRationale ; sh:minCount 1 ;
                  sh:message "L1: a finding must say why the boundary does not cover this item, or the rewritten scope has nothing to answer." ] .

#################################################################
#  v1.30.0 — the 14764 grid checks itself
#################################################################

backlog:MaintenanceClassificationShape a sh:NodeShape ;
    sh:targetClass backlog:Initiative ;
    sh:severity sh:Violation ;
    rdfs:label "A maintenance category agrees with its own axes (L1/L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item is classified Corrective but its axes do not say reactive correction. ISO/IEC/IEEE 14764 derives the four categories from timing and goal; a name that disagrees with the axes it is derived from records a label somebody preferred over the classification the evidence supports." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMaintenanceCategory backlog:Maint_Corrective .
            OPTIONAL { $this backlog:hasMaintenanceTiming ?t }
            OPTIONAL { $this backlog:hasMaintenanceGoal ?g }
            FILTER (!BOUND(?t) || !BOUND(?g) || ?t != backlog:Timing_Reactive || ?g != backlog:Goal_Correction)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item is classified Preventive but its axes do not say proactive correction." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMaintenanceCategory backlog:Maint_Preventive .
            OPTIONAL { $this backlog:hasMaintenanceTiming ?t }
            OPTIONAL { $this backlog:hasMaintenanceGoal ?g }
            FILTER (!BOUND(?t) || !BOUND(?g) || ?t != backlog:Timing_Proactive || ?g != backlog:Goal_Correction)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item is classified Adaptive but its axes do not say reactive enhancement. Adaptive work answers an environment that has already moved; if nothing moved, the honest category is perfective." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMaintenanceCategory backlog:Maint_Adaptive .
            OPTIONAL { $this backlog:hasMaintenanceTiming ?t }
            OPTIONAL { $this backlog:hasMaintenanceGoal ?g }
            FILTER (!BOUND(?t) || !BOUND(?g) || ?t != backlog:Timing_Reactive || ?g != backlog:Goal_Enhancement)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item is classified Perfective or Additive but its axes do not say proactive enhancement." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMaintenanceCategory ?c .
            FILTER (?c IN (backlog:Maint_Perfective, backlog:Maint_Additive))
            OPTIONAL { $this backlog:hasMaintenanceTiming ?t }
            OPTIONAL { $this backlog:hasMaintenanceGoal ?g }
            FILTER (!BOUND(?t) || !BOUND(?g) || ?t != backlog:Timing_Proactive || ?g != backlog:Goal_Enhancement)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item is classified as Development yet carries a maintenance category. Development creates capability that did not exist; maintenance sustains what was delivered. An initiative doing both is two initiatives." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInitiativeKind backlog:Kind_Development ;
                  backlog:hasMaintenanceCategory ?c .
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this item is classified as Maintenance but states no category. 'Maintenance' alone conflates fixing what is broken with improving what works, and the two are budgeted, scheduled and argued about differently." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInitiativeKind backlog:Kind_Maintenance .
            FILTER NOT EXISTS { $this backlog:hasMaintenanceCategory ?c }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this reactive maintenance names no modification request. Reactive work answers something that arrived; with nothing recorded, nobody can say who asked or what they asked for, and the scope of the work has no source." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMaintenanceTiming backlog:Timing_Reactive .
            FILTER NOT EXISTS { $this backlog:triggeredBy ?mr }
        }""" ] .

backlog:DeclaredCategoryShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A declared category is one the vocabulary declares (L1)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this item names an investment category that the vocabulary does not declare. owl:oneOf closes the enumeration for a reasoner but is not a SHACL check, so an invented IRI passes silently — which is how an undeclared category reached this package's own register and survived several releases." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInvestmentCategory ?c .
            FILTER NOT EXISTS { ?c a backlog:InvestmentCategory }
        }""" ] .

#################################################################
#  v1.31.0 — the version increment is the discriminator, enforced
#################################################################

backlog:InitiativeScaleShape a sh:NodeShape ;
    sh:targetClass backlog:Initiative ;
    sh:severity sh:Violation ;
    rdfs:label "The version increment decides project from maintenance (L1/L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this initiative claims Maintenance but produces a MAJOR version increment. Maintenance is smaller in granularity than a project and moves a minor or patch, never a major. A major means either a breaking change or a new product generation, and both are project scale — so this is an evolutionary development that was described as maintenance. The increment is a fact about what shipped; the label is a claim about how the work felt." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInitiativeKind backlog:Kind_Maintenance ;
                  backlog:producesIncrement backlog:Ver_Major .
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this initiative is initial or evolutionary development but produces no major increment. Both are project scale and both start a product generation; work that only moves a minor or patch is maintenance, whatever it was scoped as. If the increment is right, the kind is wrong." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInitiativeKind ?k ; backlog:producesIncrement ?v .
            FILTER (?k IN (backlog:Kind_InitialDevelopment, backlog:Kind_EvolutionaryDevelopment))
            FILTER (?v != backlog:Ver_Major)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this initiative is a Retirement producing a versioned increment. Retirement withdraws a product from service; it ends a version line rather than advancing it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasInitiativeKind backlog:Kind_Retirement ; backlog:producesIncrement ?v .
            FILTER (?v != backlog:Ver_None)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this initiative states no version increment, so nothing can check whether its declared kind is the one the work actually was. The increment is the only objective test this framework has for project versus maintenance." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:producesIncrement ?v }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this initiative states no kind. Initiatives are the level at which project and maintenance are distinguished; leaving it open means a portfolio cannot say how much of its effort is building versus sustaining." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasInitiativeKind ?k }
        }""" ] .

backlog:PbiKindAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Epic ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an epic carrying an initiative kind"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this epic carries an initiative kind. Kind belongs to the Initiative it serves, not to a product backlog item — an epic is a theme within an initiative and inherits its classification. This package made exactly this error and withdrew it; the advisory exists so the next register does not repeat it silently." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:hasInitiativeKind ?k }""" ] .

#################################################################
#  v1.32.0 — the mission stops being the one unchecked claim
#################################################################

backlog:MissionProvenanceShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Violation ;
    rdfs:label "A mission says where its words came from (L2/L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this mission does not say where its words came from. decidedBy records who is accountable, not who authored — and the two diverge silently when a session drafts a statement and attributes it to the owner. A mission is the root of the intent chain and the only node nothing else checks; without an origin, a register cannot distinguish an owner's intent from a summary of work already done." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasMissionOrigin ?o }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this mission claims an owner-stated or derived origin but names no source. 'The owner said so' with no pointer to a dated instruction or a document is indistinguishable from a session's paraphrase of what it believed the owner meant." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMissionOrigin ?o .
            FILTER (?o IN (backlog:Origin_OwnerStated, backlog:Origin_Derived))
            FILTER NOT EXISTS { $this backlog:missionSource ?src }
        }""" ] .

backlog:SessionDraftedMissionAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a mission a session wrote for itself"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this mission was drafted by a session rather than stated by the owner. That is a legitimate working artifact and not an error. It is reported because a session drafting a mission for work it is already doing writes a SUMMARY of that work, and a summary cannot contradict its source — so the mission stops being able to refuse anything, which is the same failure a scope written after its goals has. Have the owner state it, or record what document it was derived from." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMissionOrigin backlog:Origin_SessionDrafted .
            FILTER NOT EXISTS { $this backlog:belongsToLineage ?lin . ?lin backlog:lineageArchived true }
        }""" ] .

backlog:MissionReachShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a mission nothing advances"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: no goal contributes to this mission, so nothing in the register works toward it and no observation can ever bear on it. A mission with no goals beneath it is a statement of intent the development is not acting on — which may be honest, and is worth seeing." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?g backlog:contributesToMission $this }
            FILTER NOT EXISTS { $this backlog:belongsToLineage ?lin . ?lin backlog:lineageArchived true }
        }""" ] .

#################################################################
#  v1.33.0 — the chain closes, and objectives become processable
#################################################################

backlog:ChainClosureShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Violation ;
    rdfs:label "A scope names the mission it serves (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this scope names no mission. The ceremony order is Mission then Scope then Goal then Objective, and this is the one step the vocabulary did not record — a scope hangs off its container and so does the mission, so the two meet only through a join on the container they share. With more than one mission on a container, which scope serves which becomes unanswerable, and no rule can then check that work sits inside the right boundary." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:scopeForMission ?m }
        }""" ] .

backlog:ObjectiveChainShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "An objective reaches its mission through the whole chain (L3/L4)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this objective does not reach a Mission through Goal. An objective that advances no goal measures something the development has no stated reason to want — the chain is what makes an objective's value arguable rather than asserted." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:contributesToGoal ?g . ?g backlog:contributesToMission ?m }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this objective fills a scope drawn for one mission while its goal advances another. The chain forks: the boundary that admitted the work and the purpose the work serves disagree, and every downstream figure — scope completion, mission progress — is then computed over two different intents." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:fillsScope ?sc ; backlog:contributesToGoal ?g .
            ?sc backlog:scopeForMission ?m1 .
            ?g backlog:contributesToMission ?m2 .
            FILTER (?m1 != ?m2)
            # A superseded mission's chain is a historical record. Re-pointing
            # it to remove a fork would assert an intent never held, which is
            # the fabrication L-112 forbids. The fork is REAL and stays visible
            # in the register; what it must not do is block a live release.
            FILTER NOT EXISTS { ?sup backlog:supersedesMission ?m1 }
            FILTER NOT EXISTS { ?sup2 backlog:supersedesMission ?m2 }
        }""" ] .

backlog:RoadmapIntentShape a sh:NodeShape ;
    sh:targetClass backlog:Roadmap ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a roadmap outside the intent chain"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this roadmap names no objective it realises, so it connects to its backlog and to nothing above it. The ordering can be read; what the ordering is FOR cannot. A roadmap ranking work that advances objectives it does not name is ordering by something other than the intent it claims to serve." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:roadmapRealises ?o }
        }""" ] .

#################################################################
#  v1.34.0 — BRF-EP12: grooming is analysis, not attendance
#################################################################

backlog:GroomingShape a sh:NodeShape ;
    sh:targetClass backlog:Story , backlog:Epic , backlog:Initiative ;
    sh:severity sh:Violation ;
    rdfs:label "A story reaching Ready was analysed against the concerns that apply (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this story has left Proposed but declares neither an applicable design concern nor a statement that none applies. Silence and 'nothing applies' are the same in the data, and the first is the common case — so the framework requires the claim to be made. Declaring the concerns is what makes grooming checkable at all: no query can decide whether a story touches persistent state." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?st .
            FILTER (?st != backlog:Proposed)
            FILTER NOT EXISTS { $this backlog:hasApplicableConcern ?c }
            FILTER NOT EXISTS { $this backlog:hasNoApplicableConcern ?r }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this story declares a design concern that no refinement event addressed. One refinement of any kind used to satisfy Ready, so a story with five applicable concerns and a single meeting was indistinguishable from one fully analysed. A concern named and not addressed is the analysis the story was known to need and did not get." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState ?st .
            FILTER (?st NOT IN (backlog:Proposed, backlog:Cancelled))
            $this backlog:hasApplicableConcern ?c .
            FILTER NOT EXISTS { ?r backlog:refines $this ; backlog:addressesConcern ?c }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this story both declares applicable concerns and states that none applies. The two claims contradict; one of them is wrong and the register cannot say which." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasApplicableConcern ?c ; backlog:hasNoApplicableConcern ?r .
        }""" ] .

backlog:UnaddressedRefinementShape a sh:NodeShape ;
    sh:targetClass backlog:RefinementEvent ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a refinement that names no concern"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this refinement records that someone looked at a story but not what they looked at. It still counts as a refinement; it cannot count toward any concern, so a story relying on it will fail the grooming check. Naming the concern costs one triple." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:addressesConcern ?c }
        }""" ] .

#################################################################
#  v1.35.0 — task types, and the join from grooming to execution
#################################################################

backlog:TaskTypeShape a sh:NodeShape ;
    sh:targetClass backlog:ExecutionTask ;
    sh:severity sh:Violation ;
    rdfs:label "A task says what kind of work it is (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this task states no task type. ExecutionTask carried no properties of its own, so a task could say what it was called and not what kind of work it was — and a register in which every task is implicitly implementation cannot show that it has no validation, no integration and no mission analysis. The type is what makes those absences visible." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasTaskType ?tt }
        }""" ] .

backlog:GroomingToExecutionShape a sh:NodeShape ;
    sh:targetClass backlog:Story , backlog:Epic ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a concern analysed and then not acted on"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this story was groomed for a design concern, but none of the tasks planned from it performs the kind of work that concern implies. The analysis happened and nothing downstream reflects it — which is the state in which grooming becomes a ceremony rather than a step. Either a task of that type is missing, or the concern did not really apply and the grooming record overstates what was needed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasApplicableConcern ?c .
            ?c backlog:coversTaskType ?tt .
            FILTER EXISTS { ?pe backlog:plansItem $this ; backlog:producesTask ?any }
            FILTER NOT EXISTS {
                ?pe2 backlog:plansItem $this ; backlog:producesTask ?task .
                ?task backlog:hasTaskType ?tt2 .
                ?c backlog:coversTaskType ?tt2 .
            }
        }""" ] .

backlog:ProcessCoverageAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Backlog ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a register that only builds"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this register records implementation tasks and no verification or validation task anywhere. A backlog can look full while every process other than building is invisible, and the two the standard separates — was it built right, and was the right thing built — are the ones most often assumed rather than recorded." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?t a backlog:ExecutionTask ; backlog:hasTaskType backlog:Task_Implementation ;
               backlog:memberOfContainer $this .
            FILTER NOT EXISTS { ?v a backlog:ExecutionTask ; backlog:memberOfContainer $this ;
                                   backlog:hasTaskType backlog:Task_Verification }
            FILTER NOT EXISTS { ?w a backlog:ExecutionTask ; backlog:memberOfContainer $this ;
                                   backlog:hasTaskType backlog:Task_Validation }
        }""" ] .

#################################################################
#  v1.36.0 — the root cause: a package exempting itself
#
#  Measured on this package's own register: it declares
#  L2_EvidenceBound while the framework it publishes enforces at
#  L3 and L4. Sixteen of fifty-seven constraints did not run, and
#  166 violations were invisible — including fourteen forked
#  chains that the L4 rule written to catch them could not see.
#
#  That is the mechanism behind every drift in this package's
#  history. Rules were built at L3 and L4 to prevent a class of
#  error, and then never ran against the register that contained
#  it. A gate reports green, a level is declared honestly, and the
#  suppression count is printed and read past.
#
#  SelfExemptionShape, built here in response, retired at v1.152.0
#  when conformance-level gating itself was removed: a profile can
#  no longer run below its own target, because there is no longer
#  a target level to run below. The incident above is left as
#  written -- a rule keeps its incident even after the mechanism
#  built for it is retired.
#################################################################

#################################################################
#  v1.37.0 — BRF-EP13 iteration capacity, BRF-EP14 role sources
#################################################################

backlog:IterationCapacityShape a sh:NodeShape ;
    sh:targetClass backlog:Iteration ;
    sh:severity sh:Violation ;
    rdfs:label "An iteration is planned to finish its content (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this iteration committed more effort than its declared capacity. An iteration is a fixed time box; committing beyond capacity means the box was sized by the work rather than the work by the box, and its velocity then measures something that did not finish. Split the excess into a story that fits the next iteration — do not widen this one." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasCapacity ?cap ; backlog:hasCommittedEffort ?com .
            FILTER (?com > ?cap)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this iteration's deployment carries an item the iteration never planned. A package shipped from an iteration is what that iteration committed to and finished; carrying work that entered by another route makes the iteration's record of itself untrue, and cadence stops being measurable." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?d backlog:deploysFrom $this ; backlog:deploysItem ?i .
            FILTER NOT EXISTS { ?pe backlog:plansItem ?i ; backlog:plannedInto $this }
            FILTER NOT EXISTS { ?i backlog:memberOfContainer $this }
        }""" ] .

backlog:CapacityDeclaredShape a sh:NodeShape ;
    sh:targetClass backlog:Iteration ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an iteration with no capacity"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this iteration declares no capacity, so nothing can check that it was planned to finish what it committed to. Capacity is the only number against which over-commitment is visible before the iteration closes — afterwards it is a recorded miss." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this backlog:hasCapacity ?c } }""" ] .

backlog:ShippedRoleSourceShape a sh:NodeShape ;
    sh:targetClass backlog:TeamRole ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a framework-shipped role with no source"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this role is defined in the framework namespace but names no source. Ex_InventedPractice applies to the framework's own vocabulary: a role it ships must be defensible from a standard or a named work. A role an ADOPTER adds needs no citation, which is why this is scoped to the framework namespace and is an advisory rather than a violation." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER (STRSTARTS(STR($this), "http://example.org/backlog#"))
            FILTER NOT EXISTS { $this backlog:hasRoleSource ?s }
        }""" ] .

#################################################################
#  v1.38.0 — the four drift mechanisms, enforced
#################################################################

backlog:IntentOriginShape a sh:NodeShape ;
    sh:severity sh:Violation ;
    rdfs:label "RC1: every intent element says who authored it (L2)"@en ;
    sh:targetClass backlog:ScopeStatement , backlog:Goal , backlog:Objective ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this intent element does not say where its words came from. decidedBy records who is ACCOUNTABLE; nothing recorded who AUTHORED, and the two diverge silently when a session drafts an element and attributes it to the owner. Recorded for Mission at v1.70.0 and nowhere else — so the same failure moved one level down and recurred in the release that corrected it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasIntentOrigin ?o }
        }""" ] .

backlog:SessionDraftedIntentAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement , backlog:Goal , backlog:Objective ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: intent a session wrote for itself"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this intent element was drafted by a session rather than stated by the owner or derived from something outside the register. Legitimate as a working artifact, and reported because a session drafting intent for work it is already doing writes a summary of that work — and a summary cannot contradict its source, so the element stops being able to refuse anything." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted }""" ] .

backlog:GoalDerivationShape a sh:NodeShape ;
    sh:targetClass backlog:Goal ;
    sh:severity sh:Violation ;
    rdfs:label "RC2: a goal is derived from a scope, not attached to a mission (L2/L4)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this goal names no scope it derives from. The chain is Mission then Scope then Goals then Objectives: goals are derived from the boundary precisely so the boundary's fit to the mission is what gets tested. A goal reaching the mission without passing through a scope tests nothing." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:derivesFromScope ?sc }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this goal serves a mission its scope was not drawn for. The two directions of the chain disagree: read downward the mission admits one boundary, read upward the goal claims another purpose. The owner's rule is that both directions must give the same answer." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:derivesFromScope ?sc ; backlog:contributesToMission ?m1 .
            ?sc backlog:scopeForMission ?m2 .
            FILTER (?m1 != ?m2)
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m1 }
        }""" ] .

backlog:MetricReachabilityShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "RC3: an objective's metric is movable by the work beneath it (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: work pursues this objective but nothing is recorded as able to MOVE its metric. Pursuing an objective is a claim about intent; moving its metric is a claim about capability, and the two are not the same. An epic can pursue an objective and be incapable of shifting it by construction — which is how a register reaches every epic Done with its objectives untouched and nothing flagged." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?i backlog:pursuesObjective $this .
            FILTER NOT EXISTS { $this backlog:metricMovableBy ?any }
        }""" ] .

backlog:ObjectiveStalledShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: every mover is Done and the metric has not moved"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every work item recorded as able to move this objective's metric is Done, and the LATEST observation still sits at the baseline. Either the movability claim was wrong, or the work did not do what it was scoped to do. Flagged by an external OEE governance session on 2026-08-25 (found only now, investigating a handover): the clause matched ANY recorded observation equalling the baseline, not the latest one. Confirmed misfiring on this register directly: 7 of 7 objectives, including ones already Met and Achieved." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:metricMovableBy ?i ; backlog:hasBaselineValue ?base .
            FILTER NOT EXISTS { $this backlog:metricMovableBy ?j . ?j backlog:hasState ?st .
                                FILTER (?st NOT IN (backlog:Done, backlog:Cancelled)) }
            ?obs backlog:observationFor $this ; backlog:hasObservedValue ?v ; backlog:observedAt ?at .
            FILTER NOT EXISTS { ?obs2 backlog:observationFor $this ; backlog:observedAt ?at2 . FILTER (?at2 > ?at) }
            FILTER (?v = ?base)
            FILTER NOT EXISTS { $this backlog:hasTargetDirection backlog:Dir_Hold }
        }""" ] .

backlog:DeploymentCoverageShape a sh:NodeShape ;
    sh:targetClass backlog:ProductBacklogItem ;
    sh:severity sh:Warning ;
    rdfs:label "RC4: Done work reaches users through a package"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this item is Done and sits in no DeploymentUnit, so the register can say it was finished and not that it was delivered. Development is meant to be anchored on regularly deployable packages built from the highest-priority items; a register where completion and delivery are separate records measures the first and assumes the second." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { ?d a backlog:DeploymentUnit ; backlog:deploysItem $this }
            FILTER NOT EXISTS { $this a backlog:Initiative }
        }""" ] .

#################################################################
#  v1.39.0 — Ex_InventedPractice becomes a check, not a promise
#################################################################

backlog:PracticeGroundingShape a sh:NodeShape ;
    sh:targetClass backlog:SelectionBasis , backlog:DesignConcern , backlog:TaskType ,
                   backlog:MaintenanceCategory , backlog:InitiativeKind ;
    sh:severity sh:Warning ;
    rdfs:label "Ex_InventedPractice, checkable"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this framework-shipped term names neither an external source nor a framework-original declaration. The scope exclusion Ex_InventedPractice already forbids requiring a practice with no named source; nothing checked it, so two ungrounded practices sat in the framework for twenty releases while the objective measuring them never moved. Either cite the source or declare it original with a reason — a term that is silent about its provenance is indistinguishable from one nobody sourced." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ;
                      sh:declare [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER (STRSTARTS(STR($this), "http://example.org/backlog#"))
            FILTER NOT EXISTS { $this dcterms:source ?s }
            FILTER NOT EXISTS { $this backlog:isFrameworkOriginal ?f }
        }""" ] .

#################################################################
#  v1.40.0 — evidence proportionate to autonomy (ISO/IEC 42001)
#################################################################

backlog:AutonomyEvidenceShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "Unsupervised work carries independent evidence (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this item was produced with no human in or on the loop and carries no verified evidence attesting an acceptance criterion. ISO/IEC 42001 requires oversight proportionate to autonomy: where nobody supervised, the check that would have caught an error did not happen, so the proof must come from something that could have failed rather than from an assertion. Supervised work is held to a lower bar because the supervision IS the oversight." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done ; backlog:hasSupervisionMode ?sm .
            ?sm backlog:requiresIndependentEvidence true .
            FILTER NOT EXISTS {
                $this backlog:hasAcceptanceCriterion ?ac .
                ?ev backlog:attestsCriterion ?ac ; backlog:evidenceVerified true .
            }
        }""" ] .

#################################################################
#  v1.41.0 — the scope has content of its own
#################################################################

backlog:ScopeContentShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Violation ;
    rdfs:label "A scope enumerates what it requires (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this scope enumerates no deliverable, so coverage can only be measured against the work that happens to exist. Both sides of any coverage figure are then the backlog, and the number reads complete whether the scope was satisfied or merely emptied. A boundary with no content of its own cannot refuse anything — the epics become the definition of what the scope wanted." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:requiresDeliverable ?d }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . $this backlog:scopeForMission ?m }
        }""" ] .

backlog:DeliverableCoverageShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeDeliverable ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a deliverable nothing satisfies"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: no work item satisfies this deliverable. The scope requires it and nothing in the backlog makes it true — which is the gap a scope with content can state and a scope of prose cannot." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { ?i backlog:satisfiesDeliverable $this } }""" ] .

backlog:UnrequestedWorkShape a sh:NodeShape ;
    sh:targetClass backlog:Epic ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an epic the scope never asked for"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this epic satisfies no scope deliverable. It may still be right, and it is reported because an epic that answers to nothing in the scope is how a backlog quietly becomes the definition of what the development wanted — the epic-driven lineage rather than the mission-driven one." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:pursuesObjective ?o . ?o backlog:fillsScope ?sc .
            FILTER EXISTS { ?sc backlog:requiresDeliverable ?any }
            FILTER NOT EXISTS { $this backlog:satisfiesDeliverable ?d }
        }""" ] .

#################################################################
#  v1.42.0 — the SIGNATURE of a backwards-built lineage
#
#  Experiment: a lineage built entirely backwards — epic first,
#  objective invented to justify it, goal, scope drawn round the
#  goal, mission summarising the lot — produced six violations and
#  NOT ONE named the order. All six were missing DoD or category.
#
#  A pure order gate is impossible. Nothing records WHEN an element
#  was written; the chain records order by link direction, and a
#  backwards lineage has every link pointing correctly because the
#  author asserted them all at the end. Requiring dates was already
#  rejected: a date nobody can verify produces backfilled
#  timestamps asserting an order never followed.
#
#  What CAN be checked is the SHAPE of the result. A boundary
#  written to fit work already chosen has a signature: it requires
#  exactly what the work delivers and nothing more. A boundary
#  written first almost never does — it names things the work has
#  not reached yet, which is why coverage below 100% is the normal
#  healthy state and 100% at every point in time is the anomaly.
#################################################################

backlog:MirroredScopeShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a boundary that exactly mirrors its work"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every deliverable this scope requires is satisfied, and every item under it satisfies one — the boundary and the backlog mirror each other exactly. That is the expected END state of a completed scope and also the signature of one written round work already chosen. Which it is cannot be decided from the graph: check whether any deliverable was ever unsatisfied. A scope whose coverage was never below 100 percent at any point was not constraining anything." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:requiresDeliverable ?d .
            FILTER NOT EXISTS { $this backlog:requiresDeliverable ?d2 .
                                FILTER NOT EXISTS { ?w backlog:satisfiesDeliverable ?d2 } }
            FILTER NOT EXISTS { ?i backlog:pursuesObjective ?o . ?o backlog:fillsScope $this .
                                FILTER NOT EXISTS { ?i backlog:satisfiesDeliverable ?any } }
        }""" ] .

backlog:SingletonDeliverableShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Violation ;
    rdfs:label "A scope requiring one deliverable is a restated backlog (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this scope requires exactly one deliverable satisfied by exactly one item. A boundary with a single requirement met by a single piece of work is not a boundary — it is that work restated as intent, which is what a scope written round an already-chosen epic looks like. A scope that admits one thing should say what it EXCLUDES instead, or be merged into the item it describes." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:requiresDeliverable ?d .
            FILTER NOT EXISTS { $this backlog:requiresDeliverable ?d2 . FILTER (?d2 != ?d) }
            ?w backlog:satisfiesDeliverable ?d .
            FILTER NOT EXISTS { ?w2 backlog:satisfiesDeliverable ?d . FILTER (?w2 != ?w) }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . $this backlog:scopeForMission ?m }
        }""" ] .

backlog:IntentEchoShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an objective that measures its own work"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every item that can move this objective's metric also pursues it, and no other work does. The objective and the work are the same set, so the measurement cannot fail while the work is done — it counts the backlog and calls the result an outcome. An objective written before the work usually measures something the work AFFECTS rather than something the work IS." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:metricMovableBy ?w .
            FILTER NOT EXISTS { $this backlog:metricMovableBy ?w2 .
                                FILTER NOT EXISTS { ?w2 backlog:pursuesObjective $this } }
            FILTER NOT EXISTS { ?other backlog:pursuesObjective $this .
                                FILTER NOT EXISTS { $this backlog:metricMovableBy ?other } }
        }""" ] .

#################################################################
#  v1.43.0 — the pipeline, and what it can honestly enforce
#################################################################

backlog:StageOutputShape a sh:NodeShape ;
    sh:targetClass backlog:StageOutput ;
    sh:severity sh:Violation ;
    rdfs:label "A stage output names its stage, its digest and its commit (L2)"@en ;
    sh:property [ sh:path backlog:outputOfStage ; sh:minCount 1 ; sh:class backlog:LineageStage ;
        sh:message "L2: a stage output must name the stage it closed." ] ;
    sh:property [ sh:path backlog:hasStateDigest ; sh:minCount 1 ;
        sh:message "L2: a stage output must carry a digest of the state it closed on, so the claim can be recomputed rather than believed." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this stage output records no commit. A digest over the register is computable from the final state and therefore proves nothing about ORDER — established by experiment, where an author building backwards and computing each digest from the finished graph passed every digest check. A commit is the only anchor the author does not control." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:closedAtCommit ?c }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this stage output does not consume the output of the stage that precedes it. The pipeline must be a line: each stage consumes what the previous produced, which is what makes the dependency an artifact rather than a claim." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:outputOfStage ?st . ?st backlog:stagePredecessor ?pred .
            FILTER NOT EXISTS { $this backlog:consumesOutput ?prev . ?prev backlog:outputOfStage ?pred }
        }""" ] .

backlog:StagedElementShape a sh:NodeShape ;
    sh:targetClass backlog:Goal , backlog:Objective ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an intent element outside the pipeline"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this element names no stage output, so it sits outside the pipeline and its position in the order rests on nothing. Advisory rather than a violation because a register may legitimately not use staged construction — but one that does not cannot claim its lineage was built in order." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER EXISTS { ?any a backlog:StageOutput }
            FILTER NOT EXISTS { $this backlog:producedByStage ?o }
        }""" ] .

backlog:SingleCommitLineageShape a sh:NodeShape ;
    sh:targetClass backlog:StageOutput ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: stages sharing one commit"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this stage closed at the same commit as another stage. Git witnesses order BETWEEN commits and says nothing about order WITHIN one, so these stages are unordered evidence however they were actually built. This is the measured limit of the pipeline, reported rather than hidden: to make the order witnessed, close each stage in its own commit." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:closedAtCommit ?c ; backlog:outputOfStage ?s1 .
            ?other backlog:closedAtCommit ?c ; backlog:outputOfStage ?s2 .
            FILTER (?s1 != ?s2)
        }""" ] .

#################################################################
#  v1.44.0 — a stage that closed after the one it feeds
#################################################################

backlog:StageOrderWitnessShape a sh:NodeShape ;
    sh:targetClass backlog:StageOutput ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a stage closed at a different commit than its successor implies"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this stage and the one that consumes it record the same commit, or this stage's commit cannot be shown to precede it. The consuming stage was built from an output that was not yet closed, which means the dependency is nominal — the artifact existed as an IRI before it existed as a completed state. Close each stage in its own commit to make the sequence witnessed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?next backlog:consumesOutput $this ; backlog:closedAtCommit ?cn .
            $this backlog:closedAtCommit ?cp .
            FILTER (?cp = ?cn)
        }""" ] .

backlog:ScopeContentLateShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a boundary whose content arrived after the work"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: the scope stage records a later commit than the backlog stage. The boundary's TEXT may have been written early, but its DELIVERABLES — the content that lets it refuse anything — arrived after the work they were meant to constrain. This is the G17 defect with a commit attached: a scope whose content post-dates its backlog was, in the only witnessed sense, drawn around what already existed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?so backlog:outputOfStage backlog:Stage_Scope ; backlog:closedAtCommit ?cs .
            ?bo backlog:outputOfStage backlog:Stage_Backlog ; backlog:closedAtCommit ?cb .
            FILTER (?cs != ?cb)
            FILTER EXISTS { $this backlog:requiresDeliverable ?d }
        }""" ] .

#################################################################
#  v1.45.0 — a deliverable is met by delivery, not by intention
#################################################################

backlog:DeliverableIntentionShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeDeliverable ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a deliverable claimed only by unfinished work"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every work item satisfying this deliverable is still open, so the boundary is met by INTENTION rather than by delivery. Found by measurement on this register: ten of ten deliverables read satisfied while only seven were satisfied by Done work — planning three epics moved a coverage figure that should only move when something ships. Coverage counted over claimed satisfaction is the backlog measuring itself again, one level along from where that was last corrected." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?w backlog:satisfiesDeliverable $this .
            FILTER NOT EXISTS { ?w2 backlog:satisfiesDeliverable $this ; backlog:hasState backlog:Done }
        }""" ] .

#################################################################
#  v1.46.0 — a scope wider than its mission
#################################################################

backlog:DeliverableProvenanceShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeDeliverable ;
    sh:severity sh:Violation ;
    rdfs:label "A deliverable quotes the mission clause it came from (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this deliverable quotes no mission clause, so the scope requires something the mission does not say. The boundary is WIDER than the intent it serves, and nothing downstream can notice: work satisfying it will trace cleanly to a scope, a goal and a mission while answering to none of them. This is the mirror of a scope with no content — a boundary fails in both directions, and only one direction was ever checked. Either quote the clause, or amend the mission and record the owner's words as its source." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:derivesFromMissionClause ?c }
        }""" ] .

#################################################################
#  v1.47.0 — BRF-EP17: a design task says what it produced
#################################################################

backlog:ModelArtifactShape a sh:NodeShape ;
    sh:targetClass backlog:ModelArtifact ;
    sh:severity sh:Violation ;
    rdfs:label "A model artefact names its kind and what it describes (L2)"@en ;
    sh:property [ sh:path backlog:hasModelKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class backlog:ModelKind ;
        sh:message "L2: a model artefact must name its kind. An artefact recorded without one says something was produced and not what, which is the same gap as a refinement that records attendance." ] ;
    sh:property [ sh:path backlog:describesItem ; sh:minCount 1 ;
        sh:message "L2: a model artefact must name the work item it describes. An artefact describing nothing cannot be found by anyone working on the item it was made for." ] .

backlog:DesignTaskProducesShape a sh:NodeShape ;
    sh:targetClass backlog:ExecutionTask ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a design task that produced no model"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this task performed architecture or design definition and records no model artefact. It may be correct — a design task can legitimately conclude that no model is needed — which is why this is an advisory and not a violation. What it must not do is leave the question unanswered: a task that produced nothing and a task nobody recorded are otherwise identical." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasTaskType ?tt .
            FILTER (?tt IN (backlog:Task_DesignDefinition, backlog:Task_ArchitectureDefinition))
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this backlog:producesModelArtifact ?a }
        }""" ] .

backlog:ArtifactCategoryShape a sh:NodeShape ;
    sh:targetClass backlog:ModelKind ;
    sh:severity sh:Violation ;
    rdfs:label "Every model kind is structure or behaviour (L1)"@en ;
    sh:property [ sh:path backlog:hasModelCategory ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a model kind must be structure or behaviour. The split is UML's own and is carried as a property so that asking for every behaviour artefact does not mean listing seven kinds and missing one when an eighth appears." ] .

#################################################################
#  v1.48.0 — what a story carries, checked
#################################################################

backlog:InteractionStepShape a sh:NodeShape ;
    sh:targetClass backlog:InteractionStep ;
    sh:severity sh:Violation ;
    rdfs:label "A step is ordered, acted and described (L2)"@en ;
    sh:property [ sh:path backlog:hasStepOrdinal ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:message "L2: an interaction step must carry its position. A specification whose steps have no order is a set of actions, not a sequence, and cannot be walked through." ] ;
    sh:property [ sh:path backlog:hasStepAction ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: an interaction step must say what is done." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: two steps of the same specification claim the same position. This is a contradiction rather than an omission — the register cannot say which comes first, and no reader can resolve it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?spec backlog:hasInteractionStep $this , ?other .
            $this backlog:hasStepOrdinal ?o . ?other backlog:hasStepOrdinal ?o .
            FILTER ($this != ?other)
        }""" ] .

backlog:StateChangeShape a sh:NodeShape ;
    sh:targetClass backlog:StateChange ;
    sh:severity sh:Violation ;
    rdfs:label "A state change changes something (L1/L2)"@en ;
    sh:property [ sh:path backlog:hasFromState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a state change must name the state it starts from." ] ;
    sh:property [ sh:path backlog:hasToState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a state change must name the state it ends in." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this state change begins and ends in the same state. A change to the same state is not a change; either the states are wrong or the item is describing something else." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasFromState ?f ; backlog:hasToState ?t . FILTER (?f = ?t)
        }""" ] .

backlog:TestCaseShape a sh:NodeShape ;
    sh:targetClass backlog:TestCase ;
    sh:severity sh:Violation ;
    rdfs:label "A test case exercises a criterion and names its data (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this test case exercises no acceptance criterion. A check that answers to no criterion tests something nobody asked for, and cannot be counted toward any item being Done." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:exercisesCriterion ?ac }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this test case names no test data. A case with no stated starting state cannot be re-run by anyone who did not write it, which makes its result a claim rather than a check." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:runsOnData ?d }
        }""" ] .

backlog:SpecificationAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a story groomed for interaction with no specification"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this story was analysed for the Interaction concern and carries no specification. The analysis established that a person's actions change, and nothing records what those actions are — grooming that produced a finding the story does not carry." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasApplicableConcern backlog:Concern_Interaction .
            FILTER NOT EXISTS { $this backlog:hasSpecification ?s }
        }""" ] .

#################################################################
#  v1.49.0 — states are declared by analysis, and grooming
#  applies at every PBI level
#
#  GroomingShape and GroomingToExecutionShape targeted Story ALONE,
#  so an Epic or Initiative could reach Done with no analysis at
#  all — the level where a boundary decision is most consequential
#  was the level nothing checked. Both now target the whole PBI
#  hierarchy.
#################################################################

backlog:StateProvenanceShape a sh:NodeShape ;
    sh:targetClass backlog:StateChange ;
    sh:severity sh:Violation ;
    rdfs:label "A state change names the analysis that declared its states (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this state change names no artefact declaring its states. A state name with no source is floating text — two stories can name the same state meaning different things and nothing notices. The states belong to the domain, and the lineage already carries where domain knowledge enters: mission analysis and requirements definition, recorded as a model artefact. Point at the artefact; the framework does not need to know what the states mean." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:declaredByArtifact ?a }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: this state change uses a state the declaring artefact does not list. The artefact establishes the state space and this change moves outside it, which means either the analysis is incomplete or the story invented a state — and the register cannot tell which, only that they disagree." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:declaredByArtifact ?a ; backlog:hasFromState ?f .
            FILTER EXISTS { ?a backlog:declaresState ?any }
            FILTER NOT EXISTS { ?a backlog:declaresState ?f }
        }""" ] .

backlog:AnalysisArtifactShape a sh:NodeShape ;
    sh:targetClass backlog:ModelArtifact ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a state machine declaring no states"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this is a state machine artefact and it lists no states. It can therefore be pointed at by a state change without constraining it, which makes the reference decorative — the L4 clause that checks a change stays inside the declared space cannot fire against an empty space." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasModelKind backlog:Kind_StateMachineDiagram .
            FILTER NOT EXISTS { $this backlog:declaresState ?s }
        }""" ] .

#################################################################
#  v1.50.0 — a mission may be alone while its lineage is being
#  built, and must not stay alone once it is finished
#################################################################

backlog:UnfinishedLineageShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a mission whose lineage stopped part-way"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this mission has no goal and no Goal-stage output exists, so its lineage is mid-construction. That is legitimate under the staged ceremony and it is reported, because a lineage abandoned after the Mission stage looks exactly the same as one still being built — the difference is whether the next commit comes." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?g backlog:contributesToMission $this }
            FILTER NOT EXISTS { ?s backlog:supersedesMission $this }
            FILTER NOT EXISTS { $this backlog:belongsToLineage ?lin . ?lin backlog:lineageArchived true }
        }""" ] .

#################################################################
#  v1.52.0 — a scope names where, and exclusions come last
#################################################################

backlog:ScopeAreaShape a sh:NodeShape ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_ontologydriven_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "AREA_NOLOC" ;
    sh:targetClass backlog:ScopeArea ;
    sh:severity sh:Violation ;
    rdfs:label "An area names a location and a measure (L2)"@en ;
    sh:property [ sh:path backlog:areaLocation ; sh:minCount 1 ;
        sh:message "L2: a scope area must name where it is, precisely enough to open. An area nobody can locate is a topic, not a place." ] ;
    sh:property [ sh:path backlog:areaMeasure ; sh:minCount 1 ;
        sh:message "L2: a scope area must state what is in it, counted. A measure rather than an adjective, so the work can be sized and so anyone can check later whether the area shrank." ] .

backlog:ScopeWhereShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Violation ;
    rdfs:label "A scope says where the work is, not only what must be true (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this scope enumerates deliverables and names no area. A scope of conditions alone restates its mission — 'governance is expressed as ontology' is the mission's sentence with the subject changed — and nobody can act on it because it names no place. Coverage will still fall and every deliverable will still be the mission said twice." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:requiresDeliverable ?d .
            FILTER NOT EXISTS { $this backlog:coversArea ?a }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . $this backlog:scopeForMission ?m }
        }""" ] .

backlog:PrematureExclusionShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: exclusions written before coverage was shown"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this scope carries exclusions and names no area, so what is being excluded was decided before anyone established what the mission needs. Narrowing a boundary before knowing what it must cover removes work nobody has yet shown to be unnecessary — and an exclusion, once written, reads as settled." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasScopeExclusion ?e .
            FILTER NOT EXISTS { $this backlog:coversArea ?a }
        }""" ] .

#################################################################
#  v1.53.0 — a goal set that binds mission to scope both ways
#################################################################

backlog:GoalFacingShape a sh:NodeShape ;
    sh:targetClass backlog:Goal ;
    sh:severity sh:Violation ;
    rdfs:label "A goal says which obligation it carries (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this goal does not say whether it faces the mission, the scope, or containment. The three are not interchangeable — a mission-facing goal can be met with the scope half-untouched, a scope-facing goal with the mission unreached — and a goal that does not declare which it is cannot be counted toward either." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasGoalFacing ?f }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . $this backlog:contributesToMission ?m }
        }""" ] .

backlog:GoalSufficiencyShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Violation ;
    rdfs:label "A live scope carries all three goal facings (L4)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L4: the goals derived from this scope do not cover all three facings. What is missing decides how the lineage fails: with no mission-facing goal, every area can finish while the mission stays unreached and nothing reports it, because the boundary was insufficient and the boundary is what was being measured. With no scope-facing goal, the mission's condition can hold while half the areas are untouched. With no containment-facing goal, both can hold while effort went somewhere the scope never named — and no measure that counts only what was required can see redundant work." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:coversArea ?anyarea .
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . $this backlog:scopeForMission ?m }
            FILTER (
              NOT EXISTS { ?g1 backlog:derivesFromScope $this ; backlog:hasGoalFacing backlog:Facing_Mission } ||
              NOT EXISTS { ?g2 backlog:derivesFromScope $this ; backlog:hasGoalFacing backlog:Facing_Scope } ||
              NOT EXISTS { ?g3 backlog:derivesFromScope $this ; backlog:hasGoalFacing backlog:Facing_Containment }
            )
        }""" ] .

backlog:AreaWithoutGoalShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeArea ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an area no goal is answerable for"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: no scope-facing goal names this area. An area nothing is answerable for will be done last or not at all, and the scope-facing goal will still read met because it was never asked about this one." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?sc backlog:coversArea $this .
            FILTER EXISTS { ?g backlog:derivesFromScope ?sc ; backlog:hasGoalFacing backlog:Facing_Scope }
            FILTER NOT EXISTS { ?g2 backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea $this }
            # A product view is the same subject as its work-layer area and
            # is measured by that area's objective. Reporting it would ask
            # for a second objective over one event.
            FILTER NOT EXISTS { $this backlog:productViewOf ?src }
        }""" ] .

#################################################################
#  v1.54.0 — both layers, and an inverse goal per exclusion
#################################################################

backlog:ScopeLayerShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeArea , backlog:ScopeDeliverable , backlog:ScopeExclusion ;
    sh:severity sh:Violation ;
    rdfs:label "A boundary statement says which layer it is about (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this boundary statement does not say whether it is about the product or the work. PMBOK separates the two because they fail differently — a product-layer error ships the wrong capability, a work-layer error spends effort in the wrong place — and a statement that does not declare which cannot be used to refuse either." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasScopeLayer ?l }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . ?sc backlog:scopeForMission ?m .
                                { ?sc backlog:requiresDeliverable $this } UNION { ?sc backlog:hasScopeExclusion $this } UNION { ?sc backlog:coversArea $this } }
        }""" ] .

backlog:UnguardedExclusionShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeExclusion ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an exclusion no inverse goal guards"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: no exclusion-facing goal guards this exclusion, so nothing measures whether it held. PMBOK treats explicit exclusions as the principal safeguard against scope creep — but an exclusion nothing checks is a sentence, and the register cannot say whether the refusal was kept or quietly abandoned." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { ?g backlog:hasGoalFacing backlog:Facing_Exclusion ; backlog:guardsExclusion $this }
        }""" ] .

backlog:InverseGoalShape a sh:NodeShape ;
    sh:targetClass backlog:Goal ;
    sh:severity sh:Violation ;
    rdfs:label "An inverse goal names the exclusion it keeps (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this goal is exclusion-facing and names no exclusion. An inverse goal is met by absence, so without naming what is absent it cannot be measured — and a goal that cannot fail is not a goal." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasGoalFacing backlog:Facing_Exclusion .
            FILTER NOT EXISTS { $this backlog:guardsExclusion ?e }
        }""" ] .

backlog:BothLayersShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a scope stated in one layer only"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every area and deliverable of this scope sits in one layer. That may be right — some boundaries genuinely concern only what is built or only where effort goes — and it is reported because the commoner cause is that the other layer was never considered, leaving the register unable to say whether a capability is out of scope or merely out of THIS project's work." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:coversArea ?a . ?a backlog:hasScopeLayer ?l .
            FILTER NOT EXISTS { $this backlog:coversArea ?a2 . ?a2 backlog:hasScopeLayer ?l2 . FILTER (?l2 != ?l) }
        }""" ] .

backlog:ProductScopeKindShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeStatement ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_productscopekind_v1_0_0.ttl" ;
    backlog:fixtureCaseName "SCOPE_ONEKIND" ;
    rdfs:label "Advisory: a scope's product deliverables are all one kind"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every product-scope deliverable of this scope names the same ProductScopeKind — all functional or all non-functional. That may be right for a narrowly-scoped increment, and it is reported for the same reason BothLayersShape reports a single-layer scope: the commoner cause is that the other kind of failure was never considered, and a scope silent about reliability, transparency or safety cannot later say those were out of scope rather than simply unexamined." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:requiresDeliverable ?d . ?d backlog:hasScopeLayer backlog:Layer_Product ; backlog:hasProductScopeKind ?k .
            FILTER NOT EXISTS { $this backlog:requiresDeliverable ?d2 . ?d2 backlog:hasScopeLayer backlog:Layer_Product ; backlog:hasProductScopeKind ?k2 . FILTER (?k2 != ?k) }
        }""" ] .

#################################################################
#  v1.55.0 — objectives that can be monitored
#################################################################

backlog:ObjectiveMonitorShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "An objective can be monitored before its deadline (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this objective has no checkpoint, so it can only be judged at its deadline. Progress is computable from observations, but nothing states what value was EXPECTED by a date — so no observation can be early or late, and the register cannot warn that a rate will not reach the target. That is the difference between a measure and a monitor." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasCheckpoint ?c }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . $this backlog:contributesToGoal ?g . ?g backlog:contributesToMission ?m }
        }""" ] .

backlog:MeasurementKindShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "An objective says how its value is obtained (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this objective does not say whether its value is counted, derived or judged. The three carry different weight — a count anyone can reproduce, a derivation that depends on a query being right, a judgement that can only be agreed with — and a reader cannot weigh a number without knowing which it is." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasMeasurementKind ?k }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . $this backlog:contributesToGoal ?g . ?g backlog:contributesToMission ?m }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this objective is derived and ships no query. A derived figure whose query is not shipped cannot be re-derived — it is a judged figure wearing better clothes, and the reader has no way to find that out." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMeasurementKind backlog:Meas_Derived .
            FILTER NOT EXISTS { $this backlog:hasMeasurementQuery ?q }
        }""" ] .

backlog:ObjectiveCheckpointTimingShape a sh:NodeShape ;
    sh:targetClass backlog:ObjectiveCheckpoint ;
    sh:severity sh:Violation ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_checkpoint_condition_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "CP_NoTiming" ;
    rdfs:label "L1: a checkpoint states when it applies, by date or by condition"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this checkpoint states neither a checkpointDate nor a checkpointCondition. A checkpoint that says nothing about when it applies cannot be reported ahead, on track, or behind anything." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this a backlog:ObjectiveCheckpoint .
            FILTER NOT EXISTS { $this backlog:checkpointDate ?d }
            FILTER NOT EXISTS { $this backlog:checkpointCondition ?c }
        }""" ] .

backlog:CeremonyLinkAdvisoryShape a sh:NodeShape ;
    sh:targetClass backlog:MetricObservation ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_ceremony_link_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "MO_NoLink" ;
    rdfs:label "Advisory: a reading that could be tied to the review that produced it, isn't"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this observation was taken at or after the review that closed metric-moving work for the same objective, but does not say observedDuringCeremony. Not a claim the reading was taken at the wrong moment -- only that the structural link this framework's own recommended pattern uses to say so is missing. another registrant's own real incident (07-handover-inbox/accepted) found readings landing at plausible-looking but wrong moments precisely because nothing recorded which ceremony, if any, a reading belonged to." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT DISTINCT $this WHERE {
            ?rev a backlog:SprintReviewCeremony ; backlog:closesStory ?story ; backlog:heldAt ?ht .
            ?obj backlog:metricMovableBy ?story .
            $this a backlog:MetricObservation ; backlog:observationFor ?obj ; backlog:observedAt ?od .
            FILTER (?od >= ?ht)
            FILTER NOT EXISTS { $this backlog:observedDuringCeremony ?rev }
        }""" ] .

backlog:MeasurementDueAfterReviewShape a sh:NodeShape ;
    sh:targetClass backlog:SprintReviewCeremony ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_measurement_due_v1_0_0.ttl" ;
    backlog:fixtureCaseName "Review_NoReading" ;
    rdfs:label "Advisory: this review closed metric-moving work with no reading since"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this review closed a story that metricMovableBy names as actually capable of shifting an objective's measured value, but no MetricObservation for that objective was taken at or after this review. Closing metric-moving work is exactly the moment a reading is cheap and meaningful — proposed here, the same way a retrospective is proposed after a review, not forced: the ontology cannot take a measurement any more than it can hold a meeting. Deliberately anchored to metricMovableBy, not the weaker pursuesObjective — a register can reach every epic Done with every objective unmet and flag nothing, which is the exact gap metricMovableBy exists to close, and this shape would reopen it by anchoring to intent instead of capability." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT DISTINCT $this WHERE {
            $this a backlog:SprintReviewCeremony ; backlog:closesStory ?story ; backlog:heldAt ?ht .
            ?obj backlog:metricMovableBy ?story .
            FILTER NOT EXISTS {
                ?mo a backlog:MetricObservation ; backlog:observationFor ?obj ; backlog:observedAt ?od .
                FILTER (?od >= ?ht)
            }
        }""" ] .

backlog:CheckpointBreachShape a sh:NodeShape ;
    sh:targetClass backlog:ObjectiveCheckpoint ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an objective behind its checkpoint"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: an observation taken on or after this checkpoint's date has not reached the expected value. The objective is behind its own plan, reported now rather than at the deadline — which is the only point at which the information can still change the outcome." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?o backlog:hasCheckpoint $this ; backlog:hasTargetDirection ?dir .
            $this backlog:checkpointDate ?cd ; backlog:expectedValue ?ev .
            ?obs backlog:observationFor ?o ; backlog:observedAt ?od ; backlog:hasObservedValue ?v .
            FILTER (?od >= ?cd)
            FILTER ((?dir = backlog:Dir_Decrease && ?v > ?ev) || (?dir = backlog:Dir_Increase && ?v < ?ev))
        }""" ] .

#################################################################
#  v1.56.0 — an area measured by nothing
#################################################################

backlog:AreaUnmeasuredShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeArea ;
    sh:severity sh:Violation ;
    rdfs:label "Every area is measured by an objective (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: no objective measures this area, and it is not the product view of one that is. An area with a location and a measure but no objective states where work must go and gives no way to know when it got there — the scope can then be declared complete on judgement. Established by test drive: four of this register's five areas have an objective whose baseline equals the area's measure exactly, and the fifth turned out to be the same subject seen from the other layer." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?sc backlog:coversArea $this .
            FILTER NOT EXISTS { $this backlog:productViewOf ?src }
            FILTER NOT EXISTS { ?g backlog:goalCoversArea $this . ?o backlog:contributesToGoal ?g }
            FILTER NOT EXISTS { ?s backlog:supersedesMission ?m . ?sc backlog:scopeForMission ?m }
        }""" ] .

#################################################################
#  v1.57.0 — the owner's grooming model, made checkable
#################################################################

backlog:EpicSpecifiedShape a sh:NodeShape ;
    sh:targetClass backlog:Epic ;
    sh:severity sh:Violation ;
    rdfs:label "An epic is specified before it decomposes (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this epic decomposes into stories and carries no Definition of Done. The stories are then written to satisfy nothing stated at their own level — each has its own criteria and no one can say whether the set of them finishes the epic. An epic is specified first and converted second, or the conversion has no target." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:decomposesInto ?s .
            FILTER NOT EXISTS { $this backlog:appliesDefinitionOfDone ?d }
            FILTER NOT EXISTS { $this backlog:commitsToDefinitionOfDone ?d2 }
            FILTER NOT EXISTS { ?sup backlog:supersedesMission ?m . $this backlog:pursuesObjective ?o .
                                ?o backlog:contributesToGoal ?g . ?g backlog:contributesToMission ?m }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this epic decomposes into stories and no test case exercises its acceptance criteria. The owner's model puts test cases on the EPIC — they are what the stories are converted to satisfy. Without them the stories inherit no target and the epic's completion rests on the stories all being individually done, which is a different claim." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:decomposesInto ?s ; backlog:hasAcceptanceCriterion ?ac .
            FILTER NOT EXISTS { ?ac backlog:coveredByCase ?tc }
            FILTER NOT EXISTS { ?sup backlog:supersedesMission ?m . $this backlog:pursuesObjective ?o .
                                ?o backlog:contributesToGoal ?g . ?g backlog:contributesToMission ?m }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this epic decomposes into stories and covers no domain entity. Analysis is meant to precede design the same way specification precedes conversion — the two other clauses of this shape already enforce that order for Definition of Done and test coverage. An epic can build real capability against entities never named in any domain model, and nothing upstream of this clause would notice." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:decomposesInto ?s .
            FILTER NOT EXISTS { $this backlog:coversEntity ?e }
            FILTER NOT EXISTS { ?sup backlog:supersedesMission ?m . $this backlog:pursuesObjective ?o .
                                ?o backlog:contributesToGoal ?g . ?g backlog:contributesToMission ?m }
        }""" ] .

backlog:JustInTimeGroomingShape a sh:NodeShape ;
    sh:targetClass backlog:RefinementEvent ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a refinement that names no iteration"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this refinement does not say which iteration it was preparing an item for. Grooming can then be performed just in time or three sprints ahead and the register cannot tell the two apart — and detail written far ahead of the work goes stale before anyone builds against it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:refines ?i . ?i a backlog:Story .
            FILTER NOT EXISTS { $this backlog:groomsForIteration ?it }
        }""" ] .

backlog:GroomedAheadShape a sh:NodeShape ;
    sh:targetClass backlog:RefinementEvent ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a story groomed more than one iteration ahead"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this refinement grooms for an iteration that starts more than 28 days after the grooming. Detail written that far ahead of the work is written against assumptions the work has not tested yet — and it will be rewritten or, worse, followed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:groomsForIteration ?it ; backlog:refinedAt ?ra .
            ?it backlog:iterationStart ?is .
            # Addition, not subtraction. Subtracting two xsd:dateTime values
            # and comparing the result against a duration literal returns
            # NOTHING in this engine — the clause looked correct and reported
            # zero on a 34-day gap. Tested both forms against the register
            # before choosing: subtraction 0, addition 3.
            FILTER (?is > (?ra + "P28D"^^xsd:dayTimeDuration))
        }""" ] .

#################################################################
#  v1.58.0 — It7: rulings and layers carry weight
#################################################################

backlog:GovernanceRulingShape a sh:NodeShape ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_ontologydriven_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "RUL_NOSHAPE" ;
    sh:targetClass backlog:GovernanceRuling ;
    sh:severity sh:Violation ;
    rdfs:label "A ruling is identified, stated and enforced (L2)"@en ;
    sh:property [ sh:path backlog:hasRulingIdentifier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a governance ruling must carry its identifier. G-numbers are how the discipline refers to itself; a ruling without one cannot be cited." ] ;
    sh:property [ sh:path backlog:hasRulingStatement ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a governance ruling must state what it decides, in one sentence, separately from why. The decision has to be checkable against a shape and the reasoning must not be." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this ruling names no shape that enforces it. Previously a reader compared a heading against a suite by hand and nothing objected when a ruling lost its shape — a decision nothing carries out is a decision in name only." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:enforcedByShape ?sh }
        }""" ] .

backlog:LineageLayerShape a sh:NodeShape ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_ontologydriven_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "LAY_NOORD" ;
    sh:targetClass backlog:LineageLayer ;
    sh:severity sh:Violation ;
    rdfs:label "A layer names its class, position and cost (L2)"@en ;
    sh:property [ sh:path backlog:layerClass ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a lineage layer must name the class it counts." ] ;
    sh:property [ sh:path backlog:layerOrdinal ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:message "L2: a lineage layer must state its position. An integer rather than list position, so the order survives being queried in any sequence." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: two layers claim the same position. The chain cannot say which comes first, and a reporter reading them will order by whichever the store returns." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:layerOrdinal ?o . ?other a backlog:LineageLayer ; backlog:layerOrdinal ?o .
            FILTER ($this != ?other)
        }""" ] .

#################################################################
#  v1.59.0 — a batch reports partial progress
#################################################################

backlog:BatchShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Violation ;
    rdfs:label "A batched story reports how much of it is done (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this story declares a batch size and no completed count. A story is Done or not while an objective counts units, so without a completed count a batch of eight with one unit blocked reports ZERO progress where one-per-story would have reported seven. The batch decouples the measure from the increment, and the register cannot tell a stalled story from an unstarted one." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBatchSize ?b .
            FILTER NOT EXISTS { $this backlog:hasBatchCompleted ?c }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this story reports more of its batch complete than the batch holds. The count is wrong in a way that inflates the objective it feeds." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasBatchSize ?b ; backlog:hasBatchCompleted ?c . FILTER (?c > ?b)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this story is Done with part of its batch unfinished. Done means the whole batch; a partial batch is an in-progress story, and marking it Done reports units as delivered that were not." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done ; backlog:hasBatchSize ?b ; backlog:hasBatchCompleted ?c .
            FILTER (?c < ?b)
        }""" ] .

backlog:BatchConcealmentShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a batch large enough to hide a stall"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this story batches more than five units under one acceptance criterion. One criterion then verifies many changes, and a single blocked unit stalls all of them. Measured on this package's own table migration: a blocked story hides 5 percent of the work at batch 1, 18 percent at 4, 36 percent at 8. Batching is legitimate and the concealment grows linearly with it." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE { $this backlog:hasBatchSize ?b . FILTER (?b > 5) }""" ] .

#################################################################
#  v1.60.0 — committed effort must match what the box holds
#
#  Found by the re-plan overfilling It9 in silence. The existing
#  capacity clause compares hasCommittedEffort against hasCapacity
#  and BOTH ARE ASSERTED — adding stories to an iteration does not
#  change the committed figure, so a box can hold 15 points while
#  declaring 9 and every check passes.
#
#  This is the same defect as an ungrounded practice one level
#  along: a number stated rather than derived, agreeing with
#  another stated number, and nothing comparing either to the work.
#  It10 was caught last release only because the DECLARED figure
#  was raised; It9 was not, because it was not.
#################################################################

backlog:CommittedEffortShape a sh:NodeShape ;
    sh:targetClass backlog:Iteration ;
    sh:severity sh:Violation ;
    rdfs:label "Committed effort matches what the iteration holds (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this iteration's declared commitment does not equal the effort of the items it holds. Both the commitment and the capacity are asserted, so comparing them to each other proves nothing — a box can hold fifteen points while declaring nine and every capacity check passes. The declared figure has to answer to the contents or it is a number agreeing with another number." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasCommittedEffort ?declared .
            { SELECT $this (SUM(?e) AS ?actual) WHERE {
                ?item backlog:memberOfContainer $this ; backlog:hasEffortEstimate ?e .
              } GROUP BY $this }
            FILTER (?declared != ?actual)
        }""" ] .

#################################################################
#  v1.61.0 — a closed iteration reports how long it took
#################################################################

backlog:ObservedDurationShape a sh:NodeShape ;
    sh:targetClass backlog:Iteration ;
    sh:severity sh:Violation ;
    rdfs:label "A closed iteration reports its measured duration (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this iteration is Done and reports no measured duration. Its declared start and end are assertions that nothing compares to the work, so the next iteration is planned from a number nobody checked. Measured here: two nine-point iterations took 32 and 28 minutes against a declared fourteen days, an overstatement of 667 times, and no clause noticed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this backlog:hasObservedDuration ?d }
            FILTER NOT EXISTS { ?sup backlog:supersedesMission ?m . ?g backlog:contributesToMission ?m .
                                $this backlog:memberOfContainer ?c }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this iteration reports a duration and does not say where it was read from. A duration that cannot be re-derived is an assertion wearing a measurement's clothes, which is the thing it exists to replace." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasObservedDuration ?d .
            FILTER NOT EXISTS { $this backlog:hasDurationSource ?s }
        }""" ] .

backlog:PlannedFromEvidenceShape a sh:NodeShape ;
    sh:targetClass backlog:Iteration ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a planned span far from measured experience"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this open iteration declares a span more than ten times the longest duration any closed iteration actually recorded. Planning far above measured experience is how a schedule becomes decorative — the dates stop describing the work and start describing a cadence borrowed from somewhere else." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:iterationStart ?s ; backlog:iterationEnd ?e .
            FILTER NOT EXISTS { $this backlog:hasState backlog:Done }
            { SELECT (MAX(?d) AS ?worst) WHERE { ?it backlog:hasObservedDuration ?d } }
            BIND (((?e - ?s) / "PT1M"^^xsd:dayTimeDuration) AS ?planned)
            FILTER (?planned > (?worst * 10))
        }""" ] .

#################################################################
#  v1.62.0 — a criterion names what satisfies it
#################################################################

backlog:CriterionArtifactShape a sh:NodeShape ;
    sh:targetClass backlog:AcceptanceCriterion ;
    sh:severity sh:Violation ;
    rdfs:label "A criterion on Done work names its artefact (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this criterion belongs to Done work and names no artefact whose existence makes it true. A story was closed under exactly this gap: its specification promised a property, the property was never created, and the criterion passed because one evidence record covered five criteria across three stories and described the iteration as a whole. Every other clause was satisfied — evidence present, verified, attested, harnessed — and none asked whether the thing existed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?item backlog:hasAcceptanceCriterion $this ; backlog:hasState backlog:Done .
            FILTER NOT EXISTS { $this backlog:satisfiedByArtifact ?a }
            FILTER NOT EXISTS { ?sup backlog:supersedesMission ?m . ?item backlog:pursuesObjective ?o .
                                ?o backlog:contributesToGoal ?g . ?g backlog:contributesToMission ?m }
        }""" ] .

backlog:UnresolvedArtifactShape a sh:NodeShape ;
    sh:targetClass backlog:CriterionSatisfaction ;
    sh:severity sh:Violation ;
    rdfs:label "A criterion whose artefact was not found (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this satisfaction record says the named artefact was NOT found, and the criterion it belongs to is on Done work. The story is closed and the thing it promised does not exist. Recording the false is the point — a criterion looked for and not found was previously unsayable." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:artifactResolved false ; backlog:satisfiesCriterion ?ac .
            ?item backlog:hasAcceptanceCriterion ?ac ; backlog:hasState backlog:Done .
        }""" ] .

backlog:BatchedEvidenceShape a sh:NodeShape ;
    sh:targetClass backlog:TestEvidence ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: one evidence record attesting many criteria"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this evidence attests more than three criteria, so its verification method describes an iteration rather than a check. Measured on this register when the pattern was found: 24 of 49 evidence records attested more than one criterion, and the one that hid an unfinished story attested five across three stories. Batching evidence is legitimate and it is how a criterion comes to be carried by a claim about its neighbours." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            { SELECT $this (COUNT(?c) AS ?n) WHERE { $this backlog:attestsCriterion ?c } GROUP BY $this }
            FILTER (?n > 3)
        }""" ] .

#################################################################
#  v1.63.0 — a story decomposes, and a criterion is tested
#  in more than one situation
#################################################################

backlog:StoryTaskSpreadShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a story whose whole life is one implementation task"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: every task planned from this story is implementation. Field practice decomposes a story until each task is a few hours' work, with story analysis for design and test analysis for cases happening inside the same sprint. A single implementation task records that something was built and nothing about what was analysed, designed or tested to get there. Measured when this clause was written: 44 of 51 tasks in this register were Task_Implementation and 55 of 55 stories had exactly one task." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            ?pe backlog:plansItem $this ; backlog:producesTask ?t .
            FILTER NOT EXISTS {
                ?pe2 backlog:plansItem $this ; backlog:producesTask ?t2 .
                ?t2 backlog:hasTaskType ?tt .
                FILTER (?tt != backlog:Task_Implementation)
            }
        }""" ] .

backlog:CriterionCoverageShape a sh:NodeShape ;
    sh:targetClass backlog:AcceptanceCriterion ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a criterion tested in one situation"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this criterion is covered by test cases reaching fewer than two scenario kinds. A criterion proven only on the nominal path has been shown to work and not shown to stop, refuse, or survive having nothing to work with — and it reads as fully covered. The absent case is not academic here: a malformed FILTER once reported zero violations AND zero warnings, and only the second number gave it away." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:coveredByCase ?c .
            { SELECT $this (COUNT(DISTINCT ?k) AS ?kinds) WHERE {
                $this backlog:coveredByCase ?cc . ?cc backlog:coversScenario ?sc .
                ?sc backlog:scenarioKind ?k .
              } GROUP BY $this }
            FILTER (?kinds < 2)
        }""" ] .

backlog:ScenarioShape a sh:NodeShape ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_ontologydriven_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "SCEN_NOKIND" ;
    sh:targetClass backlog:TestScenario ;
    sh:severity sh:Violation ;
    rdfs:label "A scenario names its criterion and its kind (L2)"@en ;
    sh:property [ sh:path backlog:scenarioOf ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a test scenario must name the criterion it is a situation of. A scenario belonging to nothing cannot be counted toward any criterion's coverage." ] ;
    sh:property [ sh:path backlog:scenarioKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a test scenario must say what kind of situation it is. The four kinds fail differently, and a set of scenarios that does not distinguish them cannot show whether a criterion was tested broadly or four times on the nominal path." ] .

backlog:StoryTestAnalysisShape a sh:NodeShape ;
    sh:targetClass backlog:Story ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a Done story with no test case"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this story is Done and no test case exercises any of its criteria. Test analysis belongs inside the sprint alongside story analysis, and a story closed without it rests on evidence that testing happened somewhere rather than on a case anyone can re-run. Measured when this clause was written: 46 of 55 Done stories carried no test case." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Done ; backlog:hasAcceptanceCriterion ?ac .
            FILTER NOT EXISTS { ?ac2 backlog:coveredByCase ?c . $this backlog:hasAcceptanceCriterion ?ac2 }
        }""" ] .

#################################################################
#  v1.64.0 — the clause the re-verification exposed
#
#  CodeTable was added at v1.117.0 with hasTableKind, and NOTHING
#  required it. The whole migration turned on that distinction:
#  eighteen tables were ruled operational and stayed in python
#  because of it, and a table could be registered with no kind at
#  all and pass every check.
#
#  Found by writing a fixture for a clause that did not exist —
#  which is why the case was written knowing it might be silent.
#  A negative fixture that passes is either a missing clause or a
#  broken one, and the only way to tell is to look.
#################################################################

backlog:CodeTableShape a sh:NodeShape ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_ontologydriven_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "CT_NOKIND" ;
    sh:targetClass backlog:CodeTable ;
    sh:severity sh:Violation ;
    rdfs:label "A code table says which kind it is (L2)"@en ;
    sh:property [ sh:path backlog:tableInModule ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a code table must name the module it lives in, or nobody can find the thing being counted." ] ;
    sh:property [ sh:path backlog:hasTableKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a code table must say whether it holds classification or operational knowledge. The whole migration turned on that distinction — eighteen tables stayed in python because they were operational — and a table with no kind is counted by whichever query happens to reach it." ] .

#################################################################
#  v1.65.0 — reachability moves to the ontology
#
#  I claimed twice that this decision COULD NOT move: that
#  reachability is a query over the TBox, and a register cannot
#  hold a rule about classes that do not exist yet. I argued it and
#  did not test it, and recorded 1 as a structural floor.
#
#  Test drive, three experiments:
#    1. Read what the python gate decides: skip enumerations, skip
#       classes with subclasses, skip classes named as a range,
#       report the rest that also have no instance.
#    2. Write it as SPARQL over TBox plus register: 25 classes.
#    3. Write it as a SHACL shape and compare focus nodes against
#       the query: 25 and 25, exact agreement.
#
#  The premise was wrong in a specific way. The rule is not ABOUT
#  classes that do not exist; it is about classes that DO exist and
#  are unreachable, and every one of them is a subject in the
#  shipped graphs. Nothing had to be invented — the graphs already
#  carried what the shape needed, and I had reasoned about the
#  problem instead of running it.
#################################################################

backlog:ClassReachabilityShape a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a class the vocabulary cannot reach"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: no property names this class as a range and no individual is of this type, so nothing in the vocabulary can point at it and nothing uses it. Package sat unused for 91 releases in exactly this state, and the cost was a wrong conclusion drawn in good faith — packages were believed impossible before delivery when the concept had existed all along. Advisory rather than violation because 25 such classes exist today and a rule that fires 25 times on its first run gets suppressed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER STRSTARTS(STR($this), "http://example.org/backlog#")
            FILTER NOT EXISTS { $this owl:oneOf ?l }
            FILTER NOT EXISTS { ?s rdfs:subClassOf $this }
            FILTER NOT EXISTS { ?p rdfs:range $this }
            FILTER NOT EXISTS { ?i a $this }
        }""" ] .

#################################################################
#  v1.66.0 — A2: a shape may name its proof
#
#  provenByFixture is declared on the FIVE shapes this session's
#  fixture verifiably fires, each with the individual that triggers
#  it. Not on the other 217.
#
#  Annotating all 222 would assert 217 links nobody checked, which
#  is precisely the defect G21 names — evidence covering criteria
#  it never examined. The honest state is that five clauses have a
#  declared proof and the rest have an inferred one, and the
#  checker reports both counts separately so the difference stays
#  visible.
#################################################################

#################################################################
#  v1.67.0 — the six obligations I asserted and had not built
#
#  Ruling on the eighteen orphans, I marked six as already obliged.
#  Checking rather than trusting that ruling: NONE of the six had a
#  shape targeting it. Package's apparent hit was PackageShape
#  targeting RegisterPackage, a DIFFERENT class whose name contains
#  the first — a substring match reading as a real obligation.
#
#  Six asserted obligations, zero real. This is G19 at the level of
#  a single ruling: I reasoned about which classes were covered
#  instead of grepping for their shapes, and was wrong six times
#  out of six.
#
#  The shapes are built here rather than the ruling softened,
#  because the ruling was right about what SHOULD be obliged and
#  wrong only about what already was.
#################################################################

backlog:SprintPlanningCeremonyShape a sh:NodeShape ;
    sh:targetClass backlog:SprintPlanningCeremony ;
    sh:severity sh:Violation ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "PLAN_NoEvent" ;
    rdfs:label "L1: a planning ceremony names its iteration, when it happened, and what it planned"@en ;
    sh:property [ sh:path backlog:ceremonyFor ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a sprint planning ceremony must name exactly one iteration. A planning record naming no iteration cannot say which sprint's scope it decided." ] ;
    sh:property [ sh:path backlog:heldAt ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a sprint planning ceremony must record when it happened." ] ;
    sh:property [ sh:path backlog:includesPlanningEvent ; sh:minCount 1 ;
        sh:message "L1: a sprint planning ceremony must include at least one planning event. A ceremony that planned nothing recorded a meeting, not a plan." ] .

backlog:SprintReviewCeremonyShape a sh:NodeShape ;
    sh:targetClass backlog:SprintReviewCeremony ;
    sh:severity sh:Violation ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "REVIEW_NoDecision" ;
    rdfs:label "L1: a review ceremony names its iteration, when it happened, what it reviewed, and made a decision"@en ;
    sh:property [ sh:path backlog:ceremonyFor ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a sprint review ceremony must name exactly one iteration." ] ;
    sh:property [ sh:path backlog:heldAt ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a sprint review ceremony must record when it happened." ] ;
    sh:property [ sh:path backlog:reviewsCeremony ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a sprint review ceremony must name the planning ceremony it reviews. A review's real job is to review what was planned; one that names no plan is checking nothing in particular." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: a sprint review ceremony must close at least one story or flag at least one for carry-over. A review that decided nothing is not distinguishable from a review that did not happen." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this a backlog:SprintReviewCeremony .
            FILTER NOT EXISTS { $this backlog:closesStory ?s }
            FILTER NOT EXISTS { $this backlog:flagsForCarryOver ?f }
        }""" ] .

backlog:ReviewsPlanConsistencyShape a sh:NodeShape ;
    sh:targetClass backlog:SprintReviewCeremony ;
    sh:severity sh:Violation ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "REVIEW_WrongPlan" ;
    rdfs:label "L1: a review's own iteration must agree with the plan it reviews"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this review ceremony's own ceremonyFor names a different iteration than the planning ceremony it reviews. A review naming one sprint while reviewing another's plan is reviewing the wrong sprint." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this a backlog:SprintReviewCeremony ; backlog:ceremonyFor ?it1 ; backlog:reviewsCeremony ?plan .
            ?plan backlog:ceremonyFor ?it2 .
            FILTER (?it1 != ?it2)
        }""" ] .

backlog:IterationNotCleanedShape a sh:NodeShape ;
    sh:targetClass backlog:SprintReviewCeremony ;
    sh:severity sh:Violation ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "REVIEW_DirtyClose" ;
    rdfs:label "L1: closing an iteration requires a disposition for every story in it"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L1: this review closed its iteration, but at least one story still a member of it is neither Done nor named in this review's own flagsForCarryOver. Closing a sprint means every item in it has a real disposition — finished, or seen and carried forward on purpose — not that some were simply left behind." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT DISTINCT $this WHERE {
            $this a backlog:SprintReviewCeremony ; backlog:closesIteration ?it .
            ?story a backlog:Story ; backlog:memberOfContainer ?it .
            FILTER NOT EXISTS { ?story backlog:hasState backlog:Done }
            FILTER NOT EXISTS { $this backlog:flagsForCarryOver ?story }
        }""" ] .

backlog:RetrospectiveNotStartedShape a sh:NodeShape ;
    sh:targetClass backlog:SprintReviewCeremony ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_v1_0_0.ttl" ;
    backlog:fixtureCaseName "REVIEW_NoRetro" ;
    rdfs:label "Advisory: this review made a real decision but no retrospective has started following it"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this review ceremony closed or carried over at least one story, but no SprintRetrospective's followsReview names it yet. The ontology cannot make a meeting happen — this proposes the retrospective the same way StoryReadyToCloseShape proposes closing a story, it does not create one." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT DISTINCT $this WHERE {
            $this a backlog:SprintReviewCeremony .
            { $this backlog:closesStory ?s } UNION { $this backlog:flagsForCarryOver ?s }
            FILTER NOT EXISTS { ?r backlog:followsReview $this }
        }""" ] .

backlog:SprintRetrospectiveShape a sh:NodeShape ;
    sh:targetClass backlog:SprintRetrospective ;
    sh:severity sh:Violation ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "RETRO_NoFinding" ;
    rdfs:label "L1: a retrospective records when it happened and produced at least one finding"@en ;
    sh:property [ sh:path backlog:heldAt ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a sprint retrospective must record when it happened." ] ;
    sh:property [ sh:path backlog:producesFinding ; sh:minCount 1 ;
        sh:message "L1: a sprint retrospective must produce at least one finding, per the class's own definition — a retrospective producing none is indistinguishable from one that did not happen. Deliberately does not require ceremonyFor: a real retrospective's own findings, test-driven against this package's own recent process, span a release's whole engineering process rather than one time-boxed iteration." ] .

backlog:RetrospectiveFindingShape a sh:NodeShape ;
    sh:targetClass backlog:RetrospectiveFinding ;
    sh:severity sh:Violation ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_sprint_ceremonies_negative_v1_0_0.ttl" ;
    backlog:fixtureCaseName "FIND_NoRootCause" ;
    rdfs:label "L1: a retrospective finding names its root cause and its scope"@en ;
    sh:property [ sh:path backlog:hasFindingScope ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a retrospective finding must state whether its remedy is this lineage's own practice or a methodology-level gap. A finding whose scope was never decided is one nobody judged worth reusing anywhere." ] ;
    sh:property [ sh:path backlog:hasRootCause ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a retrospective finding must state its root cause. hasRemedy stays optional — naming a fix before one is genuinely known is worse than leaving it open — but a finding with no stated cause at all is not yet a finding." ] .

backlog:PackageContentShape a sh:NodeShape ;
    sh:targetClass backlog:Package ;
    sh:severity sh:Violation ;
    rdfs:label "A package names its version and its target (L2)"@en ;
    sh:property [ sh:path backlog:hasPackageVersion ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a package must carry the version it will release under, recorded at identification so the increment is a decision taken with the content in view rather than a label applied afterwards." ] ;
    sh:property [ sh:path backlog:targetsIteration ; sh:minCount 1 ;
        sh:message "L2: a package must target at least one iteration. A package targeting nothing is a grouping with no plan to deliver it — which is how this class sat unused for 91 releases while every check passed." ] .

backlog:PackageRegularityShape a sh:NodeShape ;
    sh:targetClass backlog:Package ;
    sh:severity sh:Warning ;
    backlog:provenByFixture "03-tooling/fixtures/fixture_package_regularity_v1_0_0.ttl" ;
    backlog:fixtureCaseName "Pkg_Odd" ;
    rdfs:label "Advisory: a package's sprint count diverges sharply from its siblings"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this package's sprint count diverges sharply from its siblings in the same lineage, with no rationale recorded. A roadmap of wildly uneven releases is either an unexamined sizing decision or a real, named constraint — a rationale is what distinguishes them. Comparison excludes siblings that already carry their own rationale: a real exception should not count toward making its own baseline look like the outlier, a failure mode found and corrected against a real four-package case where the baseline (2 of 4, both unexcused) was outnumbered by two individually-excused exceptions (1 of 4 each). Scoped to sprint count only: total committed size would need summing hasJobSize across members, and hasJobSize exists only on a WSJF score, not on every scoring method a member might carry — a signal this framework cannot yet compute for every package, and one this shape does not assert." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:belongsToLineage ?ln .
            { SELECT $this (COUNT(DISTINCT ?it) AS ?n) WHERE { $this backlog:targetsIteration ?it } GROUP BY $this }
            ?tot a backlog:Package ; backlog:belongsToLineage ?ln . FILTER (?tot != $this)
            FILTER NOT EXISTS { ?tot backlog:hasDecisionRationale ?trat }
            OPTIONAL {
                ?tot backlog:targetsIteration ?anyit .
                { SELECT ?tot (COUNT(DISTINCT ?it2) AS ?n2) WHERE { ?tot backlog:targetsIteration ?it2 } GROUP BY ?tot }
                FILTER (?n >= 2*?n2 || ?n2 >= 2*?n)
                BIND(?tot AS ?farSib)
            }
            FILTER NOT EXISTS { $this backlog:hasDecisionRationale ?rat }
        }
        GROUP BY $this ?n
        HAVING (COUNT(DISTINCT ?tot) > 0 && COUNT(DISTINCT ?farSib) * 2 > COUNT(DISTINCT ?tot))""" ] .

backlog:TestDataShape a sh:NodeShape ;
    sh:targetClass backlog:TestData ;
    sh:severity sh:Violation ;
    rdfs:label "Test data states the fixture state it establishes (L2)"@en ;
    sh:property [ sh:path backlog:hasFixtureState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: test data must describe the starting state it establishes. Data that says nothing about the state cannot be re-created by anyone who did not write it, which makes the case that runs on it a claim rather than a check." ] .

backlog:ContainerRoleShape a sh:NodeShape ;
    sh:targetClass backlog:ContainerRole ;
    sh:severity sh:Violation ;
    rdfs:label "A container role names its class (L2)"@en ;
    sh:property [ sh:path backlog:containerClass ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a container role must name the class the reports treat as a container. A role naming nothing is counted by no query and excluded from none." ] .

backlog:ForeignNamespaceShape a sh:NodeShape ;
    sh:targetClass backlog:ForeignNamespace ;
    sh:severity sh:Violation ;
    rdfs:label "A foreign namespace names its IRI and owner (L2)"@en ;
    sh:property [ sh:path backlog:namespaceIRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a foreign namespace must state its IRI, or nobody can tell which terms it covers." ] ;
    sh:property [ sh:path backlog:namespaceOwner ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a foreign namespace must name its owner. The point of recording it is that an adopter must not assume a term from it is theirs to change, and that is unanswerable without an owner." ] .

backlog:QualityMetricShape a sh:NodeShape ;
    sh:targetClass backlog:QualityMetric ;
    sh:severity sh:Violation ;
    rdfs:label "A quality metric names itself and its population sensitivity (L2)"@en ;
    sh:property [ sh:path backlog:hasMetricName ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a quality metric must carry the name the assessor reports it under, or the ontology and the report cannot be matched." ] ;
    sh:property [ sh:path backlog:isPopulationSensitive ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "L2: a quality metric must say whether it responds to population. Population-sensitive metrics understate by design and are read twice; a metric that does not declare this is read once and reported as if complete." ] .

backlog:ShapeSuiteShape a sh:NodeShape ;
    sh:targetClass backlog:ShapeSuite ;
    sh:severity sh:Violation ;
    rdfs:label "A shape suite names itself and where it is found (L2)"@en ;
    sh:property [ sh:path backlog:suiteName ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a shape suite must carry its name." ] ;
    sh:property [ sh:path backlog:suitePattern ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a shape suite must carry the glob that locates it, or the ontology names a suite nothing can find." ] .

#################################################################
#  v1.68.0 — a lineage is set down only when nothing is
#  left unexplained
#################################################################

backlog:MissionOutcomeShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Violation ;
    rdfs:label "A mission states its outcome, and Achieved is earned (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this mission does not say where it stands. A mission that is achieved and one still in flight are otherwise indistinguishable, which is how a finished lineage stays in scope of every query forever — 294 clauses were running against 55 closed stories because nothing could say the work was done." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:hasMissionOutcome ?o }
            FILTER NOT EXISTS { ?s backlog:supersedesMission $this }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this mission is Achieved or Abandoned and gives no rationale. Setting a lineage down is an act with a reason, not a status someone changed — and the reason is the only thing a later reader has when the register no longer carries the work." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMissionOutcome ?o .
            FILTER (?o IN (backlog:Out_Achieved, backlog:Out_Abandoned))
            FILTER NOT EXISTS { $this backlog:outcomeRationale ?r }
        }""" ] .

backlog:AchievedOnlyWhenClearShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Violation ;
    rdfs:label "A mission is not Achieved while a goal is unreached and unexplained (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this mission is marked Achieved while one of its goals carries an objective that is neither met nor given a status explaining why it no longer steers. A lineage with a live unreached goal is not finished, it is stalled, and retiring it would bury the reason it stalled. Change the goal's status first, with a rationale, or leave the mission in flight." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasMissionOutcome backlog:Out_Achieved .
            ?g backlog:contributesToMission $this .
            ?o backlog:contributesToGoal ?g ; backlog:hasTargetValue ?t ; backlog:hasTargetDirection ?d .
            # The LATEST observation, not any observation. Written first as
            # "any", which fired on every baseline reading forever: an
            # objective that started at 3 and reached 0 still had a 3 on
            # record, so a mission could never be Achieved once its own
            # progress was written down. An objective is judged by where it
            # ENDED, and the history is what shows it moved.
            ?obs backlog:observationFor ?o ; backlog:hasObservedValue ?v ;
                 backlog:observedAt ?at .
            FILTER NOT EXISTS {
                ?later backlog:observationFor ?o ; backlog:observedAt ?lat .
                FILTER (?lat > ?at)
            }
            FILTER NOT EXISTS { ?o backlog:hasAchievementStatus ?st }
            FILTER ((?d = backlog:Dir_Decrease && ?v > ?t) ||
                    (?d = backlog:Dir_Increase && ?v < ?t) ||
                    (?d = backlog:Dir_Hold && ?v != ?t))
        }""" ] .

backlog:RetrospectiveObjectiveShape a sh:NodeShape ;
    sh:targetClass backlog:Objective ;
    sh:severity sh:Violation ;
    rdfs:label "A retrospective objective explains why it can only report (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this objective is marked Retrospective or Withdrawn and gives no rationale. The two states mean different things — withdrawn says the measure was wrong, retrospective says it was right and the event it counts already happened — and a reader cannot tell which without being told." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:hasAchievementStatus ?st .
            FILTER (?st IN (backlog:Ach_Retrospective, backlog:Ach_Withdrawn))
            FILTER NOT EXISTS { $this backlog:hasRationale ?r }
        }""" ] .

backlog:UndeclaredIndividualShape a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: an individual outside its class's own closed enumeration"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: some individual is typed as this class and is not a member of its own owl:oneOf list. A closed enumeration with individuals outside it is a contradiction the ontology states and nothing evaluates — Ach_Withdrawn sat in exactly this state from v1.82.0 to v1.128.0, used twice and declared nowhere; GoalFacing's Facing_Exclusion sat in the identical state, found by generalizing this check rather than trusting the narrow, single-class version that fixed only the first instance." ;
        sh:prefixes [ sh:declare [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this owl:oneOf ?list .
            ?member a $this .
            FILTER NOT EXISTS { ?list rdf:rest*/rdf:first ?member }
        }""" ] .

#################################################################
#  v1.69.0 — every work item names its lineage
#################################################################

backlog:LineageMembershipShape a sh:NodeShape ;
    sh:targetClass backlog:WorkItem ;
    sh:severity sh:Violation ;
    rdfs:label "A work item names the lineage it was created in (L2)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this work item belongs to no lineage, so nothing can say which archive it goes to when its lineage finishes. Partitioning this register by inferring the closure broke 297 constraints for exactly this reason — harnesses, refinements and planning events stayed behind while the items they pointed at moved." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this backlog:belongsToLineage ?l }
        }""" ] .

backlog:LineageShape a sh:NodeShape ;
    sh:targetClass backlog:Lineage ;
    sh:severity sh:Violation ;
    rdfs:label "A lineage names its mission and its place (L2)"@en ;
    sh:property [ sh:path backlog:lineageForMission ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a lineage must name the mission it pursues, or it is a bag of work with no stated intent." ] ;
    sh:property [ sh:path backlog:lineageOrdinal ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a lineage must state where it falls in the sequence of runs, so history has an order independent of dates — which this framework has already found unreliable." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L2: this lineage is marked archived and names no archive file. The saving comes from the file NOT BEING LOADED, so a reader who cannot find it has lost the work rather than set it aside." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:lineageArchived true .
            FILTER NOT EXISTS { $this backlog:archiveFile ?f }
        }""" ] .

backlog:ArchiveOnlyWhenAchievedShape a sh:NodeShape ;
    sh:targetClass backlog:Lineage ;
    sh:severity sh:Violation ;
    rdfs:label "A lineage is archived only when its mission is settled (L3)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "L3: this lineage is archived while its mission is still in flight. Archiving removes the work from every future check, so doing it to a running lineage silently stops governing it — the opposite of what the archive exists for." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:lineageArchived true ; backlog:lineageForMission ?m .
            ?m backlog:hasMissionOutcome backlog:Out_InFlight .
        }""" ] .

#################################################################
#  v1.70.0 — a functional property carries one value
#
#  Three times this session a functional property has held two
#  values: hasInvariantStatus twice, owl:priorVersion once, and
#  lineageArchived once with true AND false at the same time — so
#  six archived lineages reported themselves as not archived.
#
#  owl:FunctionalProperty is a statement an OWL REASONER enforces.
#  This suite is SHACL, and SHACL does not read it. The ontology
#  declared the constraint and nothing evaluated it — the same
#  shape as a closed owl:oneOf with individuals outside it, found
#  earlier in this lineage.
#
#  The pattern is always an APPEND THAT SHOULD HAVE BEEN A
#  REPLACE, which is why a generic check is worth more than fixing
#  each instance.
#################################################################

backlog:FunctionalOnceShape a sh:NodeShape ;
    sh:targetClass backlog:Lineage ;
    sh:severity sh:Violation ;
    rdfs:label "A lineage reports one archive state (L1)"@en ;
    sh:property [ sh:path backlog:lineageArchived ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L1: a lineage must report exactly one archive state. This carried true and false at once, so a query taking the first value was told the archive had not happened while the archive file existed. owl:FunctionalProperty says one value and only an OWL reasoner enforces it; this suite is SHACL and must say so itself." ] ;
    sh:property [ sh:path backlog:lineageForMission ; sh:maxCount 1 ;
        sh:message "L1: a lineage pursues exactly one mission." ] ;
    sh:property [ sh:path backlog:lineageOrdinal ; sh:maxCount 1 ;
        sh:message "L1: a lineage has exactly one place in the sequence." ] ;
    sh:property [ sh:path backlog:archiveFile ; sh:maxCount 1 ;
        sh:message "L1: a lineage names at most one archive file, or a reader cannot tell which holds its contents." ] .

backlog:MissionOnceShape a sh:NodeShape ;
    sh:targetClass backlog:Mission ;
    sh:severity sh:Violation ;
    rdfs:label "A mission reports one outcome (L1)"@en ;
    sh:property [ sh:path backlog:hasMissionOutcome ; sh:maxCount 1 ;
        sh:message "L1: a mission must report at most one outcome. Achieved and in-flight at once is the defect that let six archived lineages report themselves as not archived, one level along." ] .

#################################################################
#  v1.71.0 — #6 of the mitigation plan: A1 applied to
#  ToolScript, the class that fixed the filename-decision defect
#  and was itself unobliged, caught by the adoption checker on its
#  first re-run.
#################################################################

backlog:ToolScriptShape a sh:NodeShape ;
    sh:targetClass backlog:ToolScript ;
    sh:severity sh:Violation ;
    rdfs:label "A tool script names its file and whether it accepts a graph (L2)"@en ;
    sh:property [ sh:path backlog:scriptFileName ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "L2: a tool script must name the file it describes, or it cannot be matched against anything real." ] ;
    sh:property [ sh:path backlog:acceptsGraphPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "L2: a tool script must state whether it accepts a graph path. This is the exact fact three wrong guesses tried to derive without declaring it; the class that fixed that was itself unobliged until this shape." ] .

#################################################################
#  v1.72.0 — Candidate G-item 1, adapted from a handover
#  and independently reproduced in this framework's own data.
#
#  A parallel adoption (another registrant) reported that mission-clause citations
#  went unverified after a mission was amended: 6 of 9 citations
#  quoted text that no longer existed verbatim. Rather than trust
#  the report, this was tested against OUR OWN register directly.
#
#  3 of our own 5 derivesFromMissionClause citations were already
#  stale: Del_OntGovernance, Del_OntRuleExec and Del_OntExport
#  quoted an early, informal rendering of the mission's intent —
#  never re-checked once the mission crystallized into its current
#  wording. The underlying claims remain true; only the citation
#  had gone stale.
#
#  derivesFromMissionClause's own definition already states the
#  intent — "a citation can point at a mission that has since
#  changed, while a quotation can be compared against the current
#  text" — and nothing had ever compared it.
#################################################################

backlog:MissionClauseCitationShape a sh:NodeShape ;
    sh:targetClass backlog:ScopeDeliverable ;
    sh:severity sh:Warning ;
    rdfs:label "Advisory: a mission-clause citation is not a literal substring of any current mission"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Advisory: this deliverable's derivesFromMissionClause quote does not appear verbatim in any Mission's current hasMissionStatement. A citation was written to be checkable, not merely traceable — if the mission has been amended since, the underlying claim may still be true while the citation has gone stale. Found in this register's own data: 3 of 5 citations quoted an early rendering of the mission superseded by its crystallized wording, none re-checked when it changed." ;
        sh:prefixes [ sh:declare [ sh:prefix "backlog" ; sh:namespace "http://example.org/backlog#"^^xsd:anyURI ] ] ;
        sh:select """SELECT $this WHERE {
            $this backlog:derivesFromMissionClause ?q .
            FILTER NOT EXISTS { ?m backlog:hasMissionStatement ?s . FILTER CONTAINS(?s, ?q) }
        }""" ] .
