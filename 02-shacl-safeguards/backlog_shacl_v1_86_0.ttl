    owl:priorVersion <http://example.org/backlog-shapes/1.80.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.79.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.78.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.77.0> ;
    owl:priorVersion <http://example.org/backlog-shapes/1.76.0> ;
