# Failure-mode/success-mode taxonomy shapes — test drive, not a construction.
#
# Proves discrimination for the elegant replacement of G61's own original
# fixed-count threshold, plus the two new scope-conformance shapes the same
# taxonomy names (FM_ScopeCreep, FM_ScopeGap).
#
# IneffectiveCorrectiveAttemptAdvisoryShape (targets WorkItem):
#   W_Ineffective: closed, before/after observations bracket it, metric did
#     NOT improve -> fires.
#   W_Effective: closed, before/after observations bracket it, metric DID
#     improve -> silent.
#   W_NoObservations: closed, no observations at all -> silent (cannot judge
#     without data; never a false positive from missing evidence).
#
# ScopeCreepAdvisoryShape (targets Epic):
#   Epic_Creep: pursues an objective whose goal derives from no scope, and
#     no ScopeChange admits it -> fires.
#   Epic_InScope: goal derives from a real scope -> silent.
#   Epic_AdmittedByChange: goal derives from no scope, but a real ScopeChange
#     admits it explicitly -> silent (the honest G54 pattern).
#
# ScopeGapAdvisoryShape (targets ScopeStatement):
#   Scope_Gap: no goal derives from it -> fires.
#   Scope_Covered: a goal derives from it -> silent.

@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/taxonomytest#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

ex:Obj_A a backlog:Objective ; backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy ex:W_Ineffective .
ex:W_Ineffective a backlog:Story ; backlog:hasState backlog:Done ;
    backlog:startedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ; backlog:finishedAt "2026-01-10T00:00:00Z"^^xsd:dateTime .
ex:Obs_A_Before a backlog:MetricObservation ; backlog:observationFor ex:Obj_A ;
    backlog:hasObservedValue "10"^^xsd:decimal ; backlog:observedAt "2025-12-30T00:00:00Z"^^xsd:dateTime .
ex:Obs_A_After a backlog:MetricObservation ; backlog:observationFor ex:Obj_A ;
    backlog:hasObservedValue "10"^^xsd:decimal ; backlog:observedAt "2026-01-15T00:00:00Z"^^xsd:dateTime .

ex:Obj_B a backlog:Objective ; backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy ex:W_Effective .
ex:W_Effective a backlog:Story ; backlog:hasState backlog:Done ;
    backlog:startedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ; backlog:finishedAt "2026-01-10T00:00:00Z"^^xsd:dateTime .
ex:Obs_B_Before a backlog:MetricObservation ; backlog:observationFor ex:Obj_B ;
    backlog:hasObservedValue "10"^^xsd:decimal ; backlog:observedAt "2025-12-30T00:00:00Z"^^xsd:dateTime .
ex:Obs_B_After a backlog:MetricObservation ; backlog:observationFor ex:Obj_B ;
    backlog:hasObservedValue "2"^^xsd:decimal ; backlog:observedAt "2026-01-15T00:00:00Z"^^xsd:dateTime .

ex:Obj_C a backlog:Objective ; backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy ex:W_NoObservations .
ex:W_NoObservations a backlog:Story ; backlog:hasState backlog:Cancelled ;
    backlog:startedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ; backlog:finishedAt "2026-01-10T00:00:00Z"^^xsd:dateTime .

ex:Scope_A a backlog:ScopeStatement .
ex:Goal_InScope a backlog:Goal ; backlog:derivesFromScope ex:Scope_A .
ex:Obj_InScope a backlog:Objective ; backlog:contributesToGoal ex:Goal_InScope .
ex:Epic_InScope a backlog:Epic ; backlog:pursuesObjective ex:Obj_InScope .

ex:Goal_NoScope a backlog:Goal .
ex:Obj_Creep a backlog:Objective ; backlog:contributesToGoal ex:Goal_NoScope .
ex:Epic_Creep a backlog:Epic ; backlog:pursuesObjective ex:Obj_Creep .

ex:Goal_NoScope2 a backlog:Goal .
ex:Obj_Admitted a backlog:Objective ; backlog:contributesToGoal ex:Goal_NoScope2 .
ex:Epic_AdmittedByChange a backlog:Epic ; backlog:pursuesObjective ex:Obj_Admitted .
ex:SC_Real a backlog:ScopeChange ; backlog:admitsItem ex:Epic_AdmittedByChange .

ex:Scope_Gap a backlog:ScopeStatement .
ex:Scope_Covered a backlog:ScopeStatement .
ex:Goal_Covers a backlog:Goal ; backlog:derivesFromScope ex:Scope_Covered .
