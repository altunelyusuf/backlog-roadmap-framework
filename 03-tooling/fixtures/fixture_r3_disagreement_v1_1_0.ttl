@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/fixture-r3#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# R3 fixture: the two prioritisation models must DISAGREE here, and the report
# must print both answers rather than reconciling them. A rule whose disagreement
# branch has never been observed firing is a branch nobody has tested.
#
# Container states are asserted as Proposed, not InProgress: under rule R1 a
# Ready member is refined but not started, so a container of Ready items derives
# Proposed. Asserting otherwise is caught by the derived-vs-asserted constraint.
#
# ex:Fast scores higher and wins the throughput question; it sits outside the
# open launch gate. ex:Gated scores lower but is inside the gate the owner
# declared launch-blocking, so it wins the launch-scoped question.

ex:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "R3 disagreement fixture" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:hasLevelReviewDate "2027-01-01T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Fixture profile: core structural checks are what this fixture exercises; the R3 disagreement it demonstrates does not depend on evidence binding." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:PrioritizationFacet , backlog:EvidenceFacet , backlog:InvariantFacet , backlog:AuditFacet .

ex:Backlog a backlog:Backlog ;
    backlog:hasIdentifier "BL-R3" ;
    backlog:hasState backlog:Proposed ;
    backlog:appliesDefinitionOfDone ex:DoD_R3 ; backlog:hasCommitment ex:Commit_R3 .
ex:DoD_R3 a backlog:DefinitionOfDone ; rdfs:label "Fixture DoD"@en .
ex:Commit_R3 a backlog:Commitment ; backlog:commitsToGoal ex:CGoal .

ex:RM_R3 a backlog:Roadmap ; backlog:roadmapOf ex:Backlog .
ex:PkgLaunch backlog:rankedOnRoadmap ex:RM_R3 ; backlog:hasRoadmapRank 1 .

ex:PkgLaunch a backlog:Package ;
    backlog:hasIdentifier "PKG-LAUNCH" ;
    backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability true ;
    backlog:isLaunchGate true ;
    backlog:hasLaunchPriority 1 ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Owner call: nothing ships before the booking core is complete." .

ex:PkgLater a backlog:Package ;
    backlog:hasIdentifier "PKG-LATER" ;
    backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability true .

ex:Gated a backlog:Story ;
    backlog:hasNoApplicableConcern "Fixture story: no stored state, interface, interaction, structure or authorisation is touched." ;
    backlog:hasIdentifier "US-GATED" ;
    backlog:hasTitle "Booking conflict detection" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog , ex:PkgLaunch ;
    backlog:hasPriorityScore ex:Gated_Score ;
    backlog:hasAcceptanceCriterion ex:Gated_AC1 ;
    backlog:appliesDefinitionOfDone ex:DoD_R3 ;
    backlog:belongsToLineage ex:Lin_R3 ;
    backlog:pursuesObjective ex:CObjScope ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability .
ex:Gated_AC1 a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given two overlapping bookings, When conflict detection runs, Then the second is refused." ;
    backlog:satisfiedByArtifact "backlog:AcceptanceCriterion" .
ex:Ref_Gated a backlog:RefinementEvent ; backlog:refines ex:Gated ; backlog:refinedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ; backlog:hasRefinementOutcome "Split criteria agreed, ready for sprint." .
ex:Lin_R3 a backlog:Lineage ; backlog:lineageArchived false ; backlog:lineageForMission ex:CMission ; backlog:lineageOrdinal 1 .

ex:Gated_Score a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 4.0 ;
    backlog:hasUserBusinessValue 6.0 ; backlog:hasTimeCriticality 4.0 ;
    backlog:hasRiskReductionValue 2.0 ; backlog:hasJobSize 3.0 .

ex:Fast a backlog:Task ;
    backlog:hasIdentifier "US-FAST" ;
    backlog:hasTitle "Cheap high-value tweak outside the launch gate" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog , ex:PkgLater ;
    backlog:hasPriorityScore ex:Fast_Score ;
    backlog:hasAcceptanceCriterion ex:Fast_AC1 ;
    backlog:appliesDefinitionOfDone ex:DoD_R3 ;
    backlog:belongsToLineage ex:Lin_R3 ;
    backlog:pursuesObjective ex:CObjContain ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability .
ex:Fast_AC1 a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given the tweak is applied, When the page loads, Then the change is visible." ;
    backlog:satisfiedByArtifact "backlog:AcceptanceCriterion" .
ex:Ref_Fast a backlog:RefinementEvent ; backlog:refines ex:Fast ; backlog:refinedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ; backlog:hasRefinementOutcome "Split criteria agreed, ready for sprint." .

ex:Fast_Score a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 9.5 ;
    backlog:hasUserBusinessValue 8.0 ; backlog:hasTimeCriticality 9.0 ;
    backlog:hasRiskReductionValue 2.0 ; backlog:hasJobSize 2.0 .

<http://example.org/fixture-r3#Profile> backlog:hasExpectedPolarity backlog:Polarity_Positive .

ex:PkgLaunch backlog:hasPackageVersion "1.0.0" ; backlog:targetsIteration ex:It_Pkg .

ex:PkgLater backlog:hasPackageVersion "1.0.0" ; backlog:targetsIteration ex:It_Pkg .

ex:It_Pkg a backlog:Iteration ; backlog:hasIdentifier "IT-PKG" ;
    backlog:hasState backlog:Proposed ;
    backlog:iterationStart "2026-08-01T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2026-08-14T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 9.0 ; backlog:hasCommittedEffort 0.0 .

# The iteration needs a member: an empty container is rejected, and
# inventing one to satisfy a package obligation would be the shape of
# defect this release exists to expose.
ex:Gated backlog:memberOfContainer ex:It_Pkg .
# Conformance-goal pattern (G42/AdoptionConformanceGoalShape), self-contained,
# using this package's own already-proven Goal_BRSFConformance/Obj_BRSFConformanceHeld
# structure as the exact template rather than re-deriving requirements by trial.
ex:CMission a backlog:Mission ;
    backlog:hasMissionStatement "Fixture conformance-goal test mission." ;
    backlog:missionFor ex:Backlog ; backlog:hasMissionOrigin backlog:IOrigin_OwnerStated ;
    backlog:hasMissionOutcome backlog:Out_InFlight ; backlog:decidedBy backlog:Owner .
ex:CDel a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Fixture deliverable." ;
    backlog:derivesFromMissionClause "Fixture conformance-goal test mission." ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CScope a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Fixture conformance-goal test scope." ;
    backlog:scopeForMission ex:CMission ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:requiresDeliverable ex:CDel ; backlog:hasScopeExclusion ex:CExcl ;
    backlog:coversArea ex:CArea .
ex:CExcl a backlog:ScopeExclusion ; backlog:excludesConcern "Fixture-only exclusion." ;
    backlog:hasExclusionRationale "Fixture-only, not a real design decision." ; backlog:decidedBy backlog:Owner ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CArea a backlog:ScopeArea ; backlog:areaLocation "Fixture-only area, no real location." ;
    backlog:areaMeasure "0 real measure; fixture-only." ; backlog:hasScopeLayer backlog:Layer_Product .
ex:CGoal a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture conformance goal" ;
    backlog:isConformanceGoal true ; backlog:contributesToMission ex:CMission ;
    backlog:derivesFromScope ex:CScope ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCoversArea ex:CArea ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:decidedBy backlog:Owner .
ex:CGoalScope a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture scope-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CGoalContain a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture containment-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Containment ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CObjScope a backlog:Objective ; backlog:contributesToGoal ex:CGoalScope ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricScope ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricScope a ex:CLocalMetric .
ex:CObjContain a backlog:Objective ; backlog:contributesToGoal ex:CGoalContain ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricContain ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricContain a ex:CLocalMetric .
ex:CCPScope a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjScope backlog:hasCheckpoint ex:CCPScope ; backlog:metricMovableBy ex:Gated .
ex:CObsScope a backlog:MetricObservation ; backlog:observesMetric ex:CMetricScope ; backlog:observationFor ex:CObjScope ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CCPContain a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjContain backlog:hasCheckpoint ex:CCPContain ; backlog:metricMovableBy ex:Fast .
ex:CObsContain a backlog:MetricObservation ; backlog:observesMetric ex:CMetricContain ; backlog:observationFor ex:CObjContain ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CObj a backlog:Objective ;
    backlog:contributesToGoal ex:CGoal ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetric ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetric a ex:CLocalMetric .
ex:CCP a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObj backlog:hasCheckpoint ex:CCP .
ex:CObs a backlog:MetricObservation ; backlog:observesMetric ex:CMetric ; backlog:observationFor ex:CObj ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .

# Blueprint (G45/domain-modeling handover): register-level completeness only,
# no epic in this fixture decomposes, so no entity coverage needed.
ex:CBP a backlog:Blueprint ; backlog:blueprintFor ex:Backlog .
