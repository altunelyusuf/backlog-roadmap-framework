# backlog_lineage_compass_v1_0_0.py -- test drive, not a construction.
#
# A minimal graph proving the tool's own [5] EXHAUSTED ATTEMPTS section and
# --propose-retrospective logic, not a SHACL-conformant register (deliberately
# thin, the same convention as fixture_lineage_compass_eligible_v1_0_0.ttl).
# Not run through backlog_validate_v1_5_0.py; it is not meant to.
#
# Two closed corrective attempts (Done, Cancelled), objective still open ->
# the tool's own reverse-compass section flags it and --propose-retrospective
# writes a real RetrospectiveFinding + a PROPOSED Out_Abandoned transition,
# clearly labelled, never applied.

@prefix backlog: <http://example.org/backlog#> .
@prefix ex: <http://example.org/exhaustedlin#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Lin a backlog:Lineage ; backlog:lineageForMission ex:Mis ; backlog:lineageOrdinal 99 ; backlog:lineageArchived false .
ex:Mis a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_InFlight .
ex:Goal a backlog:Goal ; backlog:contributesToMission ex:Mis .
ex:Obj a backlog:Objective ; backlog:contributesToGoal ex:Goal ;
    backlog:hasBaselineValue "10"^^xsd:decimal ; backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy ex:Attempt1 , ex:Attempt2 .
ex:Attempt1 a backlog:Story ; backlog:hasState backlog:Done .
ex:Attempt2 a backlog:Story ; backlog:hasState backlog:Cancelled .
ex:Obs a backlog:MetricObservation ; backlog:observationFor ex:Obj ;
    backlog:hasObservedValue "8"^^xsd:decimal ; backlog:observedAt "2026-09-04T00:00:00Z"^^xsd:dateTime .
