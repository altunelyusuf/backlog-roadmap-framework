# Blueprint (G45/domain-modeling handover): register-level completeness plus
# the epic's own domain-entity coverage, swept across all 4 lifecycle stages
# (1 real coverage from the epic itself, 3 gaps -- matching the framework's
# own real usage in fixture_positive_v1_7_0, not invented for this fixture).
pipelinedigest:CBP a backlog:Blueprint ; backlog:blueprintFor pipelinedigest:BL .
pipelinedigest:CEntity a backlog:DomainEntity .
pipelinedigest:EP backlog:coversEntity pipelinedigest:CEntity ; backlog:coversStage backlog:Stage_ActiveUse .
pipelinedigest:CGap1 a backlog:BlueprintGap ; backlog:gapForEntity pipelinedigest:CEntity ; backlog:gapForStage backlog:Stage_Creation ;
    backlog:hasGapReason "Fixture-only: creation stage not modeled." .
pipelinedigest:CGap2 a backlog:BlueprintGap ; backlog:gapForEntity pipelinedigest:CEntity ; backlog:gapForStage backlog:Stage_SuspensionException ;
    backlog:hasGapReason "Fixture-only: suspension/exception stage not modeled." .
pipelinedigest:CGap3 a backlog:BlueprintGap ; backlog:gapForEntity pipelinedigest:CEntity ; backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "Fixture-only: termination stage not modeled." .

# --- merged from fixture_productscopekind_v1_1_0.ttl (productscopeki) ---
# fixture_productscopekind_v1_0_0.ttl — proves ProductScopeKindShape.
#
# A scope whose two Layer_Product deliverables both name the same
# ProductScopeKind (both Kind_Functional here). Mirrors the structure of
# fixture_tasktype_negative and BothLayersShape's own proof: minimal,
# self-contained, one node built to trip exactly one advisory.


productscopeki:SCOPE_ONEKIND a backlog:ScopeStatement ;
    backlog:requiresDeliverable productscopeki:D1 , productscopeki:D2 .

productscopeki:D1 a backlog:ScopeDeliverable ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:hasProductScopeKind backlog:Kind_Functional .

productscopeki:D2 a backlog:ScopeDeliverable ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:hasProductScopeKind backlog:Kind_Functional .

