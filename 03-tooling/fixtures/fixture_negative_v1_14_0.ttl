# --- merged from fixture_ontologydriven_negative_v1_0_0.ttl (ontologydriven) ---
# Re-verification of the ontology-driven lineage's own clauses.
#
# Written after finding that SIX of six clauses this lineage built
# had never been made to fire by any fixture. A clause nothing
# fires has never been shown to work — it may be correct, or it may
# be malformed SPARQL returning nothing, and both look identical
# from a green gate. That is not hypothetical: twice in this
# package a clause looked right and returned no rows, and both were
# caught by accident.
#
#   RUL-NOSHAPE   ruling naming no enforcing shape   -> REJECTED L3
#   LAY-NOORD     layer with no ordinal              -> REJECTED L2
#   LAY-DUP       two layers at the same position    -> REJECTED L1
#   SCEN-NOKIND   scenario with no kind              -> REJECTED L2
#   AREA-NOLOC    scope area with no location        -> REJECTED L2
#   CT-NOKIND     code table with no kind            -> silent (no clause yet)
#
# CT-NOKIND is listed deliberately: writing it and finding it
# silent is how the absence of a clause becomes visible.


ontologydriven:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "ontology-driven clause proof" ;
    backlog:governsBacklog ontologydriven:BL ; backlog:hasConformanceLevel backlog:L3_Governed ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:hasExpectedPolarity backlog:Polarity_Negative ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "L3: the ruling and area clauses are L2/L3." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .
ontologydriven:BL a backlog:Backlog ; backlog:hasIdentifier "BL-OD" ; backlog:hasState backlog:InProgress .
ontologydriven:S a backlog:Story ; backlog:hasIdentifier "S-OD" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer ontologydriven:BL ; backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "fixture" .

# RUL-NOSHAPE: identified and stated, enforced by nothing.
ontologydriven:RUL_NOSHAPE a backlog:GovernanceRuling ;
    backlog:hasRulingIdentifier "GX" ;
    rdfs:label "A ruling nothing carries out"@en ;
    backlog:hasRulingStatement "Every increment is published separately." ;
    backlog:rulingSource "fixture" .

# LAY-NOORD: a layer with no position.
ontologydriven:LAY_NOORD a backlog:LineageLayer ;
    backlog:layerClass backlog:Mission ;
    backlog:layerAbsenceCost "No stated purpose." .

# LAY-DUP: two layers claiming position 1.
ontologydriven:LAY_D1 a backlog:LineageLayer ; backlog:layerClass backlog:Goal ;
    backlog:layerOrdinal 1 ; backlog:layerAbsenceCost "a" .
ontologydriven:LAY_D2 a backlog:LineageLayer ; backlog:layerClass backlog:Objective ;
    backlog:layerOrdinal 1 ; backlog:layerAbsenceCost "b" .

# SCEN-NOKIND: a scenario belonging to a criterion, with no kind.
ontologydriven:AC a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a locked account, When recovery completes, Then it is active." .
ontologydriven:SCEN_NOKIND a backlog:TestScenario ;
    backlog:scenarioOf ontologydriven:AC .

# AREA-NOLOC: an area nobody can open.
ontologydriven:AREA_NOLOC a backlog:ScopeArea ;
    backlog:areaMeasure "Some tables." ;
    backlog:hasScopeLayer backlog:Layer_Work .

# CT-NOKIND: a code table with no kind. No clause requires one.
ontologydriven:CT_NOKIND a backlog:CodeTable ;
    backlog:tableInModule "some_module.py" ;
    backlog:tableExported false .

# --- merged from fixture_package_regularity_v1_1_0.ttl (packageregular) ---
# fixture_package_regularity_v1_0_0.ttl — proves PackageRegularityShape.
#
# Five packages sharing one (deliberately untyped — this shape's own SPARQL
# never requires ?ln to be typed Lineage, and typing it would pull in
# LineageShape's unrelated mission/ordinal/archive requirements this fixture
# has no need of) grouping resource. Pkg_Norm1/2/3 each target 2 iterations —
# the regular case, mirrors this framework's own two real packages. Pkg_Odd
# targets 4 against those three siblings' 2 — a clear majority divergence,
# no rationale, meant to fire. Pkg_Excused also targets 4, same divergence,
# but carries hasDecisionRationale — meant to stay silent, the proposal's
# own disclosed-exception case (a single high-fan-in item that genuinely
# cannot be split or paired). Otherwise structurally complete (identifier,
# package version, one member each) so only the intended advisory fires.


packageregular:Pkg_Norm1 a backlog:Package ; backlog:belongsToLineage packageregular:Ln ;
    backlog:hasIdentifier "PKG-NORM1" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 , packageregular:It2 .
packageregular:Norm1_Member a backlog:Story ; backlog:hasIdentifier "WI-NORM1-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Pkg_Norm1 .

packageregular:Pkg_Norm2 a backlog:Package ; backlog:belongsToLineage packageregular:Ln ;
    backlog:hasIdentifier "PKG-NORM2" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 , packageregular:It2 .
packageregular:Norm2_Member a backlog:Story ; backlog:hasIdentifier "WI-NORM2-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Pkg_Norm2 .

packageregular:Pkg_Norm3 a backlog:Package ; backlog:belongsToLineage packageregular:Ln ;
    backlog:hasIdentifier "PKG-NORM3" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 , packageregular:It2 .
packageregular:Norm3_Member a backlog:Story ; backlog:hasIdentifier "WI-NORM3-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Pkg_Norm3 .

packageregular:Pkg_Odd a backlog:Package ; backlog:belongsToLineage packageregular:Ln ;
    backlog:hasIdentifier "PKG-ODD" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 , packageregular:It2 , packageregular:It3 , packageregular:It4 .
packageregular:Odd_Member a backlog:Story ; backlog:hasIdentifier "WI-ODD-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Pkg_Odd .

packageregular:Pkg_Excused a backlog:Package ; backlog:belongsToLineage packageregular:Ln ;
    backlog:hasIdentifier "PKG-EXCUSED" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 , packageregular:It2 , packageregular:It3 , packageregular:It4 ;
    backlog:hasDecisionRationale "Single item, seven unmet dependencies, the highest fan-in in the backlog — cannot be paired or split regardless of size." .
packageregular:Excused_Member a backlog:Story ; backlog:hasIdentifier "WI-EXCUSED-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Pkg_Excused .

# Regression case (v1.145.0), a real bug another registrant found applying this shape to its
# own register: a second, separate lineage where 2 excused exceptions
# (1 sprint each, individually rationale'd) outnumber the 2-package baseline
# (2 sprints each, unexcused) — 4 packages total, split 2-2 by count. The
# original majority-divergence rule counted the excused packages as "far"
# siblings toward the BASELINE's total, making the real baseline look like
# the outlier. Fixed: a sibling that itself carries a rationale is excluded
# from the comparison pool entirely, not merely self-suppressed. Ln2_Base1
# and Ln2_Base2 must NOT fire.
packageregular:Ln2_Base1 a backlog:Package ; backlog:belongsToLineage packageregular:Ln2 ;
    backlog:hasIdentifier "PKG-LN2-BASE1" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 , packageregular:It2 .
packageregular:Ln2Base1_Member a backlog:Story ; backlog:hasIdentifier "WI-LN2BASE1-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Ln2_Base1 .

packageregular:Ln2_Base2 a backlog:Package ; backlog:belongsToLineage packageregular:Ln2 ;
    backlog:hasIdentifier "PKG-LN2-BASE2" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 , packageregular:It2 .
packageregular:Ln2Base2_Member a backlog:Story ; backlog:hasIdentifier "WI-LN2BASE2-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Ln2_Base2 .

packageregular:Ln2_Excused1 a backlog:Package ; backlog:belongsToLineage packageregular:Ln2 ;
    backlog:hasIdentifier "PKG-LN2-EXC1" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 ;
    backlog:hasDecisionRationale "Real, disclosed exception 1 — matches another registrant's own Package_1 case." .
packageregular:Ln2Exc1_Member a backlog:Story ; backlog:hasIdentifier "WI-LN2EXC1-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Ln2_Excused1 .

packageregular:Ln2_Excused2 a backlog:Package ; backlog:belongsToLineage packageregular:Ln2 ;
    backlog:hasIdentifier "PKG-LN2-EXC2" ; backlog:hasPackageVersion "1.0.0" ;
    backlog:targetsIteration packageregular:It1 ;
    backlog:hasDecisionRationale "Real, disclosed exception 2 — matches another registrant's own Package_4 case." .
packageregular:Ln2Exc2_Member a backlog:Story ; backlog:hasIdentifier "WI-LN2EXC2-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer packageregular:Ln2_Excused2 .

