# --- merged from fixture_pipeline_digestfail_v1_0_0.ttl (pipelinedigest) ---
# Lineage pipeline defeated — EXPERIMENT B.
#
# NOT named negative: it is SHACL-VALID by design. Every shape passes;
# the defect is only visible to recomputation, which is precisely the
# point being made. A fabricated digest is well-formed data — no
# constraint over the graph can catch it, and only re-deriving the
# value can. The gate runs the pipeline verifier over this file and
# requires it to FAIL there.
#
# The same elements as the passing fixture, with fabricated stage
# digests. Every digest fails recomputation.
#
# EXPERIMENT C, the honest limit, is NOT shipped as a fixture because
# it PASSES: an author who builds backwards but computes each digest
# by restricting the FINAL graph per stage satisfies every digest
# check. That is why closedAtCommit exists — a digest over the
# register is computable at the end and proves nothing about order;
# a commit is witnessed by a remote the author does not control.
#

pipelinedigest:BL a backlog:Backlog ; backlog:hasIdentifier "BL-PL" ; backlog:hasState backlog:Proposed ;
    backlog:hasScopeStatement pipelinedigest:Scope .
pipelinedigest:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "pipeline fixture" ;
    backlog:governsBacklog pipelinedigest:BL ; backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasTargetConformanceLevel backlog:L2_EvidenceBound ;
    backlog:hasLevelReviewDate "2027-01-01T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "Core: the pipeline clauses are L1/L2." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet , backlog:InvariantFacet , backlog:AuditFacet .

pipelinedigest:M a backlog:Mission ; backlog:hasMissionStatement "Practitioners recover unaided." ;
    backlog:missionFor pipelinedigest:BL ; backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-08-25" ; backlog:decidedBy backlog:Owner ;
    backlog:hasMissionOutcome backlog:Out_InFlight .
pipelinedigest:Scope a backlog:ScopeStatement ; backlog:hasScopeStatementText "Self-service recovery." ;
    backlog:scopeForMission pipelinedigest:M ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:requiresDeliverable pipelinedigest:D1 , pipelinedigest:D2 ; backlog:hasScopeExclusion pipelinedigest:X ;
    backlog:coversArea pipelinedigest:Area_PL .
pipelinedigest:Area_PL a backlog:ScopeArea ; backlog:areaLocation "Practitioner recovery flow." ;
    backlog:areaMeasure "2 deliverables, counted." ; backlog:hasScopeLayer backlog:Layer_Product .
pipelinedigest:D1 a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Recovery completes unaided." ;
    backlog:hasScopeLayer backlog:Layer_Product ; backlog:derivesFromMissionClause "practitioners recover unaided" .
pipelinedigest:D2 a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Every recovery is auditable." ;
    backlog:hasScopeLayer backlog:Layer_Product ; backlog:derivesFromMissionClause "practitioners recover unaided" .
pipelinedigest:X a backlog:ScopeExclusion ; backlog:excludesConcern "Admin recovery." ;
    backlog:hasExclusionRationale "Different threat model." ; backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Product .
pipelinedigest:G a backlog:Goal ; rdfs:label "Self-service recovery"@en ;
    backlog:contributesToMission pipelinedigest:M ; backlog:derivesFromScope pipelinedigest:Scope ;
    backlog:hasGoalFacing backlog:Facing_Mission ; backlog:goalCoversArea pipelinedigest:Area_PL ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
pipelinedigest:GScope a backlog:Goal ; rdfs:label "Fixture scope-facing goal"@en ;
    backlog:contributesToMission pipelinedigest:M ; backlog:derivesFromScope pipelinedigest:Scope ;
    backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea pipelinedigest:Area_PL ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
pipelinedigest:GContain a backlog:Goal ; rdfs:label "Fixture containment-facing goal"@en ;
    backlog:contributesToMission pipelinedigest:M ; backlog:derivesFromScope pipelinedigest:Scope ;
    backlog:hasGoalFacing backlog:Facing_Containment ; backlog:goalCoversArea pipelinedigest:Area_PL ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
pipelinedigest:OScope a backlog:Objective ; backlog:contributesToGoal pipelinedigest:GScope ; backlog:fillsScope pipelinedigest:Scope ;
    backlog:hasSuccessMetric pipelinedigest:MetScope ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
pipelinedigest:MetScope a core:Metric .
pipelinedigest:CPOScope a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^xsd:dateTime .
pipelinedigest:OScope backlog:hasCheckpoint pipelinedigest:CPOScope .
pipelinedigest:ObsOScope a backlog:MetricObservation ; backlog:observesMetric pipelinedigest:MetScope ; backlog:observationFor pipelinedigest:OScope ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
pipelinedigest:OContain a backlog:Objective ; backlog:contributesToGoal pipelinedigest:GContain ; backlog:fillsScope pipelinedigest:Scope ;
    backlog:hasSuccessMetric pipelinedigest:MetContain ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
