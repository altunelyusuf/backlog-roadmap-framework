# Until now the gate inferred 'expected pass' from this filename and had no way to be right.
<http://example.org/changetest#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_checkpoint_observed_v1_1_0.ttl (checkpointobse) ---
# Checkpoint re-observation — test drive, not a construction.
#
# Proves discrimination for CheckpointObservedShape, closing the autonomous
# re-measurement gap MetricObservation's own real definition names directly:
# "Without observations a register can declare any objective and never be
# shown to have failed one." A live demonstration grounded this shape's own
# real occasion: Obj_RulingsQueryable's last real observation (after It7)
# showed 0, but this session alone added 38 more "### G" headings to the
# discipline document with no re-observation recorded against any of its
# own 14 passed checkpoints.
#
# Obj_Future: checkpoint dated in the future, no observation -> silent
#   (nothing has come due yet).
# Obj_PassedUnobserved: checkpoint passed, no observation at or after it
#   -> fires.
# Obj_PassedObserved: checkpoint passed, a real observation dated after it
#   exists -> silent.


checkpointobse:Obj_Future a backlog:Objective ; backlog:hasCheckpoint checkpointobse:CP_Future .
checkpointobse:CP_Future a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2099-01-01T00:00:00Z"^^xsd:dateTime .

checkpointobse:Obj_PassedUnobserved a backlog:Objective ; backlog:hasCheckpoint checkpointobse:CP_PassedUnobserved .
checkpointobse:CP_PassedUnobserved a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-01-01T00:00:00Z"^^xsd:dateTime .

checkpointobse:Obj_PassedObserved a backlog:Objective ; backlog:hasCheckpoint checkpointobse:CP_PassedObserved .
checkpointobse:CP_PassedObserved a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-01-01T00:00:00Z"^^xsd:dateTime .
checkpointobse:Obs_PassedObserved a backlog:MetricObservation ; backlog:observationFor checkpointobse:Obj_PassedObserved ;
    backlog:observedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ; backlog:hasObservedValue "0"^^xsd:decimal ;
    backlog:hasObservationMethod "Fixture-only: dated after the checkpoint it re-verifies." .

