# --- merged from fixture_measurement_due_v1_1_0.ttl (measurementdue) ---
# fixture_measurement_due_v1_0_0.ttl — proves MeasurementDueAfterReviewShape.
# Three reviews, each closing a story metricMovableBy names for a distinct
# objective: one with no reading at all (fires), one with a fresh reading
# taken after the review (stays silent), one with only a stale reading
# taken before the review (fires — a reading that predates the work it
# was supposed to measure is not evidence the work moved anything).


measurementdue:It_M a backlog:Iteration ; backlog:hasIdentifier "IT-M" ;
    backlog:iterationStart "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    backlog:iterationEnd "2026-06-14T00:00:00Z"^^xsd:dateTime .
measurementdue:ItM_Member a backlog:Story ; backlog:hasIdentifier "WI-ITM-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer measurementdue:It_M .

measurementdue:Plan_M a backlog:SprintPlanningCeremony ; backlog:ceremonyFor measurementdue:It_M ;
    backlog:heldAt "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    backlog:includesPlanningEvent measurementdue:PE_S1 , measurementdue:PE_S2 , measurementdue:PE_S3 .

# --- Case 1: no reading at all -> fires ---
measurementdue:S1 a backlog:Story ; backlog:hasIdentifier "S-M1" ; backlog:hasState backlog:Done ; backlog:pursuesObjective measurementdue:Obj1 .
measurementdue:PE_S1 a backlog:PlanningEvent ; backlog:plansItem measurementdue:S1 ; backlog:plannedInto measurementdue:It_M ;
    backlog:plannedAt "2026-06-01T00:00:00Z"^^xsd:dateTime ; backlog:producesTask measurementdue:T_S1 .
measurementdue:T_S1 a backlog:ExecutionTask ; backlog:hasIdentifier "T-M1" ; backlog:hasState backlog:Done .
measurementdue:Goal_M a backlog:Goal ; rdfs:label "Fixture goal"@en ; backlog:decidedBy backlog:Owner .

measurementdue:Obj1 a backlog:Objective ; backlog:metricMovableBy measurementdue:S1 ;
    backlog:contributesToGoal measurementdue:Goal_M ; backlog:hasSuccessMetric measurementdue:Metric_M1 ;
    backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 10.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase .
measurementdue:Metric_M1 a measurementdue:LocalMetric .
measurementdue:Review_NoReading a backlog:SprintReviewCeremony ; backlog:ceremonyFor measurementdue:It_M ;
    backlog:heldAt "2026-06-14T00:00:00Z"^^xsd:dateTime ; backlog:reviewsCeremony measurementdue:Plan_M ;
    backlog:closesStory measurementdue:S1 .

# --- Case 2: a fresh reading taken after the review -> stays silent ---
measurementdue:S2 a backlog:Story ; backlog:hasIdentifier "S-M2" ; backlog:hasState backlog:Done ; backlog:pursuesObjective measurementdue:Obj2 .
measurementdue:PE_S2 a backlog:PlanningEvent ; backlog:plansItem measurementdue:S2 ; backlog:plannedInto measurementdue:It_M ;
    backlog:plannedAt "2026-06-01T00:00:00Z"^^xsd:dateTime ; backlog:producesTask measurementdue:T_S2 .
measurementdue:T_S2 a backlog:ExecutionTask ; backlog:hasIdentifier "T-M2" ; backlog:hasState backlog:Done .
measurementdue:Obj2 a backlog:Objective ; backlog:metricMovableBy measurementdue:S2 ;
    backlog:contributesToGoal measurementdue:Goal_M ; backlog:hasSuccessMetric measurementdue:Metric_M2 ;
    backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 10.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase .
measurementdue:Metric_M2 a measurementdue:LocalMetric .
measurementdue:Review_FreshReading a backlog:SprintReviewCeremony ; backlog:ceremonyFor measurementdue:It_M ;
    backlog:heldAt "2026-06-14T00:00:00Z"^^xsd:dateTime ; backlog:reviewsCeremony measurementdue:Plan_M ;
    backlog:closesStory measurementdue:S2 .
measurementdue:MO2 a backlog:MetricObservation ; backlog:observationFor measurementdue:Obj2 ;
    backlog:observesMetric measurementdue:Metric_M2 ; backlog:hasObservationMethod "Fixture-stated value, not re-derivable." ;
    backlog:observedAt "2026-06-15T00:00:00Z"^^xsd:dateTime ; backlog:hasObservedValue 5.0 .

# --- Case 3: only a stale reading, taken before the review -> fires ---
measurementdue:S3 a backlog:Story ; backlog:hasIdentifier "S-M3" ; backlog:hasState backlog:Done ; backlog:pursuesObjective measurementdue:Obj3 .
measurementdue:PE_S3 a backlog:PlanningEvent ; backlog:plansItem measurementdue:S3 ; backlog:plannedInto measurementdue:It_M ;
    backlog:plannedAt "2026-06-01T00:00:00Z"^^xsd:dateTime ; backlog:producesTask measurementdue:T_S3 .
measurementdue:T_S3 a backlog:ExecutionTask ; backlog:hasIdentifier "T-M3" ; backlog:hasState backlog:Done .
measurementdue:Obj3 a backlog:Objective ; backlog:metricMovableBy measurementdue:S3 ;
    backlog:contributesToGoal measurementdue:Goal_M ; backlog:hasSuccessMetric measurementdue:Metric_M3 ;
    backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 10.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase .
measurementdue:Metric_M3 a measurementdue:LocalMetric .
measurementdue:Review_StaleReading a backlog:SprintReviewCeremony ; backlog:ceremonyFor measurementdue:It_M ;
    backlog:heldAt "2026-06-14T00:00:00Z"^^xsd:dateTime ; backlog:reviewsCeremony measurementdue:Plan_M ;
    backlog:closesStory measurementdue:S3 .
measurementdue:MO3 a backlog:MetricObservation ; backlog:observationFor measurementdue:Obj3 ;
    backlog:observesMetric measurementdue:Metric_M3 ; backlog:hasObservationMethod "Fixture-stated value, not re-derivable." ;
    backlog:observedAt "2025-01-01T00:00:00Z"^^xsd:dateTime ; backlog:hasObservedValue 1.0 .

