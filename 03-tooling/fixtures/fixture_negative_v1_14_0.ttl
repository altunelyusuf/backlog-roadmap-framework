# --- merged from fixture_l1_structural_batch_negative_v1_0_0.ttl (l1structuralba) ---
# L1 structural-integrity batch — proving clauses nothing had fired.
#
# backlog_clause_proof_v1_0_0 reported 82 of 304 level-gated clauses never
# made to fire by a fixture. This batch targets the 15 cheapest: WorkItem
# core-integrity cardinality/reference checks, adoption-profile cardinality,
# roadmap/container rank-and-reference checks, and the decompose-vs-depend
# mutual-exclusion rule. Each node below exists to trip exactly one named
# clause; nodes are otherwise minimal, not realistic registers.
#
#   l1structuralba:WI_NoId        -> L1 work item must have exactly one string identifier
#   l1structuralba:WI_NoState      -> L1 work item must have exactly one lifecycle state
#   l1structuralba:WI_BadDep        -> L1 dependsOn must point to a real work item
#   l1structuralba:WI_BadContainer  -> L1 memberOfContainer must point to a real container
#   l1structuralba:WI_BadEvidence   -> L1 hasEvidence must point to a real Evidence artifact
#   l1structuralba:PS_NoValue       -> L1 every priority score must carry exactly one decimal value
#   l1structuralba:RM_NoBacklog     -> L1 a roadmap must project exactly one backlog
#   l1structuralba:P_Bad            -> L1 adoption profile: no conformance level, no governed
#                          backlog, no Core facet (three clauses, one node)
#   l1structuralba:CD_BadDep        -> L1 containerDependsOn must point at a real container
#   l1structuralba:CD_Tie1/l1structuralba:CD_Tie2 -> L1 two containers hold the same rank on one roadmap
#   l1structuralba:WI_BadDecomp     -> L1 decomposesInto must point at a real work item
#   l1structuralba:WI_DecompAndDep  -> L1 an item may not both decompose into another and
#                          depend on it (with l1structuralba:WI_Child)
#   l1structuralba:WI_RankNoRoadmap -> L1 work item carries a roadmap rank without naming
#                          the roadmap it is ranked on
#
# All nodes are deliberately malformed; none is meant to also validate
# cleanly against unrelated shapes.


# Governing profile — valid, so unrelated register-level checks stay quiet.
l1structuralba:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "L1 structural batch fixture" ;
    backlog:governsBacklog l1structuralba:BL ; backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "L1: batch fixture, L1 only." ;
    backlog:adoptsFacet backlog:CoreFacet .
l1structuralba:BL a backlog:Backlog ; backlog:hasIdentifier "BL-L1BATCH" ; backlog:hasState backlog:InProgress .

# 1 — missing identifier
l1structuralba:WI_NoId a backlog:Story ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer l1structuralba:BL .

# 2 — missing lifecycle state
l1structuralba:WI_NoState a backlog:Story ; backlog:hasIdentifier "WI-NOSTATE" ;
    backlog:memberOfContainer l1structuralba:BL .

# 3 — dependsOn a non-WorkItem
l1structuralba:NotAWorkItem a backlog:Evidence .
l1structuralba:WI_BadDep a backlog:Story ; backlog:hasIdentifier "WI-BADDEP" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer l1structuralba:BL ; backlog:dependsOn l1structuralba:NotAWorkItem .

# 4 — memberOfContainer a non-container
l1structuralba:NotAContainer a backlog:Evidence .
l1structuralba:WI_BadContainer a backlog:Story ; backlog:hasIdentifier "WI-BADCONTAINER" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:NotAContainer .

# 5 — hasEvidence a non-Evidence
l1structuralba:NotEvidence a backlog:Story ; backlog:hasIdentifier "WI-NOTEVIDENCE-TARGET" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:BL .
l1structuralba:WI_BadEvidence a backlog:Story ; backlog:hasIdentifier "WI-BADEVIDENCE" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:BL ;
    backlog:hasEvidence l1structuralba:NotEvidence .

# 6 — priority score with no decimal value
l1structuralba:M_WSJF a backlog:PrioritizationMethod .
l1structuralba:PS_NoValue a backlog:PriorityScore ; backlog:scoredByMethod l1structuralba:M_WSJF .

# 7 — roadmap with no backlog projected
l1structuralba:RM_NoBacklog a backlog:Roadmap .

# 8, 9, 10 — adoption profile missing conformance level, governed backlog, Core facet
l1structuralba:P_Bad a backlog:AdoptionProfile .

# 11 — containerDependsOn a non-container
l1structuralba:CD_BadDep a backlog:WorkItemContainer ; backlog:hasIdentifier "CD-BADDEP" ;
    backlog:containerDependsOn l1structuralba:NotAContainer .
l1structuralba:CD_BadDep_Member a backlog:Story ; backlog:hasIdentifier "WI-CDBADDEP-MEMBER" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:CD_BadDep .

# 12 — two containers tied on the same roadmap rank
l1structuralba:RM_Tie a backlog:Roadmap ; backlog:roadmapOf l1structuralba:BL .
l1structuralba:CD_Tie1 a backlog:WorkItemContainer ; backlog:hasIdentifier "CD-TIE1" ;
    backlog:rankedOnRoadmap l1structuralba:RM_Tie ; backlog:hasRoadmapRank 1 .
l1structuralba:CD_Tie1_Member a backlog:Story ; backlog:hasIdentifier "WI-CDTIE1-MEMBER" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:CD_Tie1 .
l1structuralba:CD_Tie2 a backlog:WorkItemContainer ; backlog:hasIdentifier "CD-TIE2" ;
    backlog:rankedOnRoadmap l1structuralba:RM_Tie ; backlog:hasRoadmapRank 1 .
l1structuralba:CD_Tie2_Member a backlog:Story ; backlog:hasIdentifier "WI-CDTIE2-MEMBER" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:CD_Tie2 .

# 13 — decomposesInto a non-WorkItem
l1structuralba:WI_BadDecomp a backlog:Story ; backlog:hasIdentifier "WI-BADDECOMP" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:BL ;
    backlog:decomposesInto l1structuralba:NotAWorkItem .

# 14 — an item that both decomposes into and depends on the same child
l1structuralba:WI_Child a backlog:Story ; backlog:hasIdentifier "WI-CHILD" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:BL .
l1structuralba:WI_DecompAndDep a backlog:Story ; backlog:hasIdentifier "WI-DECOMPANDDEP" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:BL ;
    backlog:decomposesInto l1structuralba:WI_Child ; backlog:dependsOn l1structuralba:WI_Child .

# 15 — a roadmap rank with no roadmap named
l1structuralba:WI_RankNoRoadmap a backlog:Story ; backlog:hasIdentifier "WI-RANKNOROADMAP" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer l1structuralba:BL ;
    backlog:hasRoadmapRank 3 .

<http://example.org/l1batch#P> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_lineage_compass_eligible_v1_1_0.ttl (lineagecompass) ---
# backlog_lineage_compass_v1_0_0.py -- test drive, not a construction.
#
# A minimal graph proving the tool's own closure-eligibility and
# --emit-closure logic, not a SHACL-conformant register (deliberately
# thin: no Backlog, no Scope, no full lineage chain -- everything
# backlog_lineage_compass_v1_0_0.py itself actually reads and nothing
# else). Not run through backlog_validate_v1_5_0.py; it is not meant to.
#
# Lin/Mis/Goal/Obj/Obs: one objective, at target, no blockers -> the tool's
# own CLOSURE READINESS section reports ELIGIBLE and --emit-closure writes
# a real, clearly-labelled PROPOSED transition rather than applying it.


lineagecompass:Lin a backlog:Lineage ; backlog:lineageForMission lineagecompass:Mis ; backlog:lineageOrdinal 99 ; backlog:lineageArchived false .
lineagecompass:Mis a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_InFlight .
lineagecompass:Goal a backlog:Goal ; backlog:contributesToMission lineagecompass:Mis .
lineagecompass:Obj a backlog:Objective ; backlog:contributesToGoal lineagecompass:Goal ;
    backlog:hasBaselineValue "10"^^xsd:decimal ; backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasTargetDirection backlog:Dir_Decrease .
lineagecompass:Obs a backlog:MetricObservation ; backlog:observationFor lineagecompass:Obj ;
    backlog:hasObservedValue "0"^^xsd:decimal ; backlog:observedAt "2026-09-04T00:00:00Z"^^xsd:dateTime .

