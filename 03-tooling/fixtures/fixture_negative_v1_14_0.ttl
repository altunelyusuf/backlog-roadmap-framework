# --- merged from fixture_modelartifact_negative_v1_0_0.ttl (modelartifactn) ---
# Model artefacts — BRF-EP17. Source: UML 2.5 (OMG).
#
#   A-OK    class diagram, kind and described item present -> silent
#   A-KIND  no kind                                        -> REJECTED at L2
#   A-DESC  no described item                              -> REJECTED at L2
#   T-BARE  Done design-definition task, no artefact       -> ADVISORY
#
# T-BARE is an advisory and not a violation: a design task may
# legitimately conclude no model is needed. What it must not do is
# leave the question unanswered.


modelartifactn:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "model artefact fixture" ;
    backlog:governsBacklog modelartifactn:BL ; backlog:hasConformanceLevel backlog:L2_EvidenceBound ;
    backlog:hasTargetConformanceLevel backlog:L2_EvidenceBound ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "L2: the artefact clauses are L1/L2." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .
modelartifactn:BL a backlog:Backlog ; backlog:hasIdentifier "BL-MA" ; backlog:hasState backlog:InProgress .
modelartifactn:S a backlog:Story ; backlog:hasIdentifier "S-MODELART-1" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer modelartifactn:BL ; backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "fixture" .

modelartifactn:A_OK a backlog:ModelArtifact ;
    backlog:hasModelKind backlog:Kind_ClassDiagram ;
    backlog:describesItem modelartifactn:S .
modelartifactn:A_KIND a backlog:ModelArtifact ;
    backlog:describesItem modelartifactn:S .
modelartifactn:A_DESC a backlog:ModelArtifact ;
    backlog:hasModelKind backlog:Kind_SequenceDiagram .

modelartifactn:T_OK a backlog:ExecutionTask ; backlog:hasIdentifier "T-OK" ; backlog:hasState backlog:Done ;
    backlog:memberOfContainer modelartifactn:BL ; backlog:hasTaskType backlog:Task_DesignDefinition ;
    backlog:producesModelArtifact modelartifactn:A_OK .
modelartifactn:T_BARE a backlog:ExecutionTask ; backlog:hasIdentifier "T-BARE" ; backlog:hasState backlog:Done ;
    backlog:memberOfContainer modelartifactn:BL ; backlog:hasTaskType backlog:Task_DesignDefinition .

<http://example.org/ma#P> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_new_unproven_shape_v1_1_0.ttl (newunprovensha) ---
# New, unproven shape — test drive, not a construction.
#
# Proves NewUnprovenShapeShape, a shape whose entire decision (is this new,
# is it proven) is computed by SPARQL alone -- no Python set-difference or
# pass/fail logic anywhere. A loader's only real job is asserting
# declaredInSnapshot; this fixture proves the rule reads that data correctly.
#
# Sh_NewNoProof: declared only in Current, no provenByFixture -> fires.
# Sh_NewWithProof: declared only in Current, has provenByFixture -> silent.
# Sh_Existing: declared in both Current and Baseline -> silent, whether or
#   not it has provenByFixture (an already-published shape is grandfathered).


newunprovensha:Sh_NewNoProof a sh:NodeShape ; backlog:declaredInSnapshot backlog:Snapshot_Current .

newunprovensha:Sh_NewWithProof a sh:NodeShape ; backlog:declaredInSnapshot backlog:Snapshot_Current ;
    backlog:provenByFixture "fixture-only: this shape has a real test" .

newunprovensha:Sh_Existing a sh:NodeShape ; backlog:declaredInSnapshot backlog:Snapshot_Current ,
    backlog:Snapshot_Baseline .

