<http://example.org/rsintegrity#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_scope_triangle_negative_v1_0_0.ttl (scopetrianglen) ---
# fixture_scope_triangle_negative v1.0.0 -- NEGATIVE (2026-09-10), from SCAMPS' own known-bad cases.
#  ScopeAreaCoverageShape      Area_Stray belongs to the lineage; no statement covers it.
#  GoalTriangleShape           G_WrongMission derives from Sc1 (mission M1) but contributes to M2;
#                              G_StrayArea covers Area_Stray, which Sc1 does not name.
#  StageRevisionShape          Rev_Bare: no lineage, no stage, no reason, no retraction, no decider;
#                              Rev_FromMission revises from Stage_Mission; Rev_Unmarked retracts an
#                              output not marked outputRetracted.
#  PackageDeliveryIntentShape  Pkg_Claim says it delivers D1; no member satisfies it.
scopetrianglen:L a backlog:Lineage ; backlog:lineageOrdinal 1 ; backlog:lineageArchived false ; backlog:hasLineageStatus backlog:LS_Scoped .
scopetrianglen:M1 a backlog:Mission . scopetrianglen:M2 a backlog:Mission .
scopetrianglen:Sc1 a backlog:ScopeStatement ; backlog:scopeForMission scopetrianglen:M1 ; backlog:belongsToLineage scopetrianglen:L ; backlog:coversArea scopetrianglen:Area_Ok .
scopetrianglen:Area_Ok a backlog:ScopeArea ; backlog:belongsToLineage scopetrianglen:L .
scopetrianglen:Area_Stray a backlog:ScopeArea ; backlog:belongsToLineage scopetrianglen:L .
scopetrianglen:G_WrongMission a backlog:Goal ; backlog:derivesFromScope scopetrianglen:Sc1 ; backlog:contributesToMission scopetrianglen:M2 .
scopetrianglen:G_StrayArea a backlog:Goal ; backlog:derivesFromScope scopetrianglen:Sc1 ; backlog:contributesToMission scopetrianglen:M1 ; backlog:goalCoversArea scopetrianglen:Area_Stray .
scopetrianglen:O1 a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ; backlog:belongsToLineage scopetrianglen:L ; backlog:closedAtCommit "c1" ; backlog:hasStateDigest "x" .
scopetrianglen:Rev_Bare a backlog:StageRevision .
scopetrianglen:Rev_FromMission a backlog:StageRevision ; backlog:revisesLineage scopetrianglen:L ; backlog:revisesFromStage backlog:Stage_Mission ;
    backlog:revisionReason "rewriting everything" ; backlog:retractsOutput scopetrianglen:O1 ; backlog:decidedBy backlog:Owner .
scopetrianglen:Rev_Unmarked a backlog:StageRevision ; backlog:revisesLineage scopetrianglen:L ; backlog:revisesFromStage backlog:Stage_Goal ;
    backlog:revisionReason "the goals were guards, not achievements" ; backlog:retractsOutput scopetrianglen:O1 ; backlog:decidedBy backlog:Owner .
scopetrianglen:D1 a backlog:ScopeDeliverable .
scopetrianglen:Pkg_Claim a backlog:Package ; backlog:hasPackageVersion "1.0.0" ; backlog:deliversDeliverable scopetrianglen:D1 .
<http://example.org/scope-triangle-neg#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_session_decision_scoring_v1_1_0.ttl (sessiondecisio) ---
# Session-decision scoring — test drive, not a construction.
#
# Proves discrimination for SessionDecisionScoringShape, closing the session-
# level half of the gap SilentGapShape already closes at the individual
# work-item level, per BP-D10's own real discipline (RICE+DepFactor,
# extracted from the OE knowledge base, not reconstructed from memory).
#
# RS_NoScore: 3 candidates considered, no score named -> fires.
# RS_TwoOnly: 2 candidates considered, no score named -> silent (below the
#   BP-D10 trigger of 3+; a two-way choice is not the anti-pattern this
#   shape exists to catch).
# RS_Backed: 3 candidates considered, a real RICEScore named -> silent.


sessiondecisio:BL a backlog:Backlog ; backlog:hasIdentifier "BL-SS" ; backlog:hasState backlog:Proposed .

sessiondecisio:RS_NoScore a backlog:RegisterSession ; backlog:sessionFor sessiondecisio:BL ;
    backlog:consideredOptionCount 3 .

sessiondecisio:RS_TwoOnly a backlog:RegisterSession ; backlog:sessionFor sessiondecisio:BL ;
    backlog:consideredOptionCount 2 .

sessiondecisio:RS_Backed a backlog:RegisterSession ; backlog:sessionFor sessiondecisio:BL ;
    backlog:consideredOptionCount 3 ; backlog:decisionBackedByScore sessiondecisio:Score_Backed .
sessiondecisio:Score_Backed a backlog:RICEScore ; backlog:scoredByMethod backlog:Method_RICE ;
    backlog:hasReach 10.0 ; backlog:hasImpact 2.0 ; backlog:hasConfidence 0.8 ; backlog:hasEffort 1.5 ;
    backlog:hasScoreValue 10.667 ; backlog:hasScoreRationale "Fixture-only: matches this session's own real RICEScore-for-RICEScore case." .

