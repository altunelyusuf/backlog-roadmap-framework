# --- merged from fixture_corrective_action_v1_1_0.ttl (correctiveacti) ---
# Corrective action for a blocking objective — test drive, not a construction.
#
# Proves discrimination for ObjectiveHasCorrectiveActionShape. Grounded in a
# real finding: fw:Obj_RulingsQueryable regressed to 38 (target 0) while its
# own metricMovableBy still named fw:EP_Rulings, a real epic that had already
# reached Done -- a corrective action that cannot correct anything, and the
# shape this fixture proves discriminating correctly flags exactly that case.
#
# Obj_NoAction: open, blocking, no metricMovableBy at all -> fires.
# Obj_OnlyClosedAction: open, blocking, metricMovableBy names only a Done
#   item -> fires (the real case this shape exists for).
# Obj_LiveAction: open, blocking, metricMovableBy names a live item -> silent.
# Obj_Explained: open by the numbers, but carries hasAchievementStatus -> silent
#   (the same escape AchievedOnlyWhenClearShape already honors).


correctiveacti:Mis a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_InFlight .
correctiveacti:Goal1 a backlog:Goal ; backlog:contributesToMission correctiveacti:Mis .
correctiveacti:Goal2 a backlog:Goal ; backlog:contributesToMission correctiveacti:Mis .
correctiveacti:Goal3 a backlog:Goal ; backlog:contributesToMission correctiveacti:Mis .
correctiveacti:Goal4 a backlog:Goal ; backlog:contributesToMission correctiveacti:Mis .

correctiveacti:Obj_NoAction a backlog:Objective ; backlog:contributesToGoal correctiveacti:Goal1 ;
    backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease .
correctiveacti:Obs_NoAction a backlog:MetricObservation ; backlog:observationFor correctiveacti:Obj_NoAction ;
    backlog:hasObservedValue "5"^^xsd:decimal ; backlog:observedAt "2026-09-04T00:00:00Z"^^xsd:dateTime .

correctiveacti:Obj_OnlyClosedAction a backlog:Objective ; backlog:contributesToGoal correctiveacti:Goal2 ;
    backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy correctiveacti:Item_Closed .
correctiveacti:Item_Closed a backlog:Epic ; backlog:hasState backlog:Done .
correctiveacti:Obs_OnlyClosedAction a backlog:MetricObservation ; backlog:observationFor correctiveacti:Obj_OnlyClosedAction ;
    backlog:hasObservedValue "5"^^xsd:decimal ; backlog:observedAt "2026-09-04T00:00:00Z"^^xsd:dateTime .

correctiveacti:Obj_LiveAction a backlog:Objective ; backlog:contributesToGoal correctiveacti:Goal3 ;
    backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy correctiveacti:Item_Live .
correctiveacti:Item_Live a backlog:Epic ; backlog:hasState backlog:InProgress .
correctiveacti:Obs_LiveAction a backlog:MetricObservation ; backlog:observationFor correctiveacti:Obj_LiveAction ;
    backlog:hasObservedValue "5"^^xsd:decimal ; backlog:observedAt "2026-09-04T00:00:00Z"^^xsd:dateTime .

correctiveacti:Obj_Explained a backlog:Objective ; backlog:contributesToGoal correctiveacti:Goal4 ;
    backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
