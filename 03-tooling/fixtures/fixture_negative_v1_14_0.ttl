# Until now the gate inferred 'expected pass' from this filename and had no way to be right.
<http://example.org/sessionscore#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_sparse_shapes_negative_v1_0_0.ttl (sparseshapesne) ---
# Proves the sh:property clauses on lightly-used classes that Inv_ClauseProven
# reported unproven at v1.134.0: Budget, WorkItemContainer, DeploymentUnit,
# AdaptationGate, KickOff, Lineage, Milestone, Mission, PlanBaseline,
# FitGapFinding, ModelKind. Each case omits exactly the field its clause
# requires and nothing else, so a fixture reporting many violations still
# proves each independently rather than as a batch.

sparseshapesne:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "sparse-shape clause proof" ;
    backlog:governsBacklog sparseshapesne:BL ; backlog:hasConformanceLevel backlog:L3_Governed ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:hasExpectedPolarity backlog:Polarity_Negative ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "L1: every case below is a required-field clause." ;
    backlog:adoptsFacet backlog:CoreFacet .
sparseshapesne:BL a backlog:Backlog ; backlog:hasIdentifier "BL-SPARSE" ; backlog:hasState backlog:InProgress .

# Budget: missing dimension, missing what it constrains, missing ceiling.
sparseshapesne:BUD_NODIM a backlog:Budget ; backlog:budgetFor sparseshapesne:BL .
sparseshapesne:BUD_NOCAP a backlog:Budget ; backlog:budgetDimension backlog:CDim_Effort .

# WorkItemContainer: missing identifier.
sparseshapesne:CONT_NOID a backlog:WorkItemContainer .

# DeploymentUnit: missing deployment date.
sparseshapesne:DEP_NODATE a backlog:DeploymentUnit ; backlog:hasIdentifier "REL-X" .

# AdaptationGate: missing everything a gate must carry.
sparseshapesne:GATE_BARE a backlog:AdaptationGate .

# KickOff: missing target, timestamp, mode.
sparseshapesne:KO_BARE a backlog:KickOff .

# Lineage: missing mission, ordinal, archived flag; two values where one.
sparseshapesne:LIN_BARE a backlog:Lineage .

# Milestone: missing identifier and target date.
sparseshapesne:MILE_BARE a backlog:Milestone .

# Mission: missing its statement.
sparseshapesne:MISS_BARE a backlog:Mission .

# PlanBaseline: missing what it baselines and when.
sparseshapesne:BASE_BARE a backlog:PlanBaseline .

# FitGapFinding: missing the adaptation and item it names, and its reason.
sparseshapesne:FIND_BARE a backlog:FitGapFinding .

# ModelKind: missing its category.
sparseshapesne:MODEL_BARE a backlog:ModelKind .

# DimensionalCost: missing quantity.
sparseshapesne:COST_NOQTY a backlog:DimensionalCost ; backlog:alongDimension backlog:CDim_Effort .

# Forecast: missing the completion date it exists to state.
sparseshapesne:FCAST_BARE a backlog:Forecast ; backlog:forecastMadeAt "2026-08-27T00:00:00"^^xsd:dateTime .

# PriorityScore: no written rationale, to prove the constraint requires a
# Builder judgement rather than a bare number.
sparseshapesne:SCORE_BAD a backlog:PriorityScore ; backlog:hasScoreValue 3.0 .
sparseshapesne:CONT_SCORED a backlog:WorkItemContainer ; backlog:hasIdentifier "C-SCORED" ;
    backlog:hasPriorityScore sparseshapesne:SCORE_BAD .

# Lineage: TWO archive files, to prove the maxCount clause distinct from
# the minCount clauses already covered by LIN_BARE above.
sparseshapesne:LIN_TWOFILE a backlog:Lineage ;
    backlog:lineageForMission sparseshapesne:MISS_BARE ; backlog:lineageOrdinal 1 ;
    backlog:lineageArchived true ;
    backlog:archiveFile "a.ttl" ; backlog:archiveFile "b.ttl" .

# Lineage: TWO ordinals and TWO missions, to prove those maxCount clauses
# specifically rather than relying on LIN_TWOFILE's archiveFile duplication.
sparseshapesne:LIN_TWOORD a backlog:Lineage ;
    backlog:lineageForMission sparseshapesne:MISS_BARE ; backlog:lineageOrdinal 1 , 2 ;
    backlog:lineageArchived true .
sparseshapesne:LIN_TWOMISS a backlog:Lineage ;
    backlog:lineageForMission sparseshapesne:MISS_BARE , sparseshapesne:MISS_TWOOUT ;
    backlog:lineageOrdinal 1 ; backlog:lineageArchived true .

# Mission: TWO outcomes, to prove a mission reports at most one.
sparseshapesne:MISS_TWOOUT a backlog:Mission ; backlog:hasMissionStatement "x" ;
    backlog:hasMissionOutcome backlog:Out_Achieved , backlog:Out_InFlight .

# --- merged from fixture_storydetail_negative_v1_0_0.ttl (storydetailneg) ---
# What a story carries — steps, state changes, test cases, test data.
#
# Sources: UML 2.5 interaction and state machine diagrams;
# ISO/IEC/IEEE 29119-3 test case and test data specification.
#
#   S-OK    specification with ordered steps and a real state change,
#           test case exercising a criterion with named data  -> silent
#   ST-DUP  two steps claiming position 1                     -> REJECTED at L1
#   SC-SAME state change from Locked to Locked                -> REJECTED at L1
#   TC-BARE test case exercising nothing, no data             -> REJECTED at L3
#   S-NOSPEC groomed for Interaction, no specification        -> ADVISORY
#
# SC-SAME is the one worth having: a change to the same state is
# not a change, and it is a contradiction rather than an omission.


storydetailneg:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "story detail fixture" ;
    backlog:governsBacklog storydetailneg:BL ; backlog:hasConformanceLevel backlog:L3_Governed ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "L3: the test-case clauses are L3." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .
storydetailneg:BL a backlog:Backlog ; backlog:hasIdentifier "BL-SD" ; backlog:hasState backlog:InProgress .

storydetailneg:S_OK a backlog:Story ; backlog:hasIdentifier "S-OK" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer storydetailneg:BL ; backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "fixture" ;
    backlog:hasApplicableConcern backlog:Concern_Interaction ;
    backlog:hasSpecification storydetailneg:Spec ;
    backlog:hasAcceptanceCriterion storydetailneg:AC .
storydetailneg:AC a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a locked account, When recovery completes, Then the account is active." ;
    backlog:coveredByCase storydetailneg:TC_OK .
storydetailneg:R_OK a backlog:RefinementEvent ; backlog:refines storydetailneg:S_OK ;
    backlog:addressesConcern backlog:Concern_Interaction ;
    backlog:refinedAt "2026-09-01T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Recovery flow agreed." ; backlog:refinedBy backlog:Builder .
storydetailneg:Spec a backlog:Specification ;
    backlog:hasInteractionStep storydetailneg:St1 , storydetailneg:St2 ;
    backlog:hasStateChange storydetailneg:SC_OK .
storydetailneg:St1 a backlog:InteractionStep ; backlog:hasStepOrdinal 1 ;
    backlog:hasStepAction "Requests recovery from the sign-in page." .
storydetailneg:St2 a backlog:InteractionStep ; backlog:hasStepOrdinal 2 ;
    backlog:hasStepAction "Confirms identity via the second factor." .
storydetailneg:SC_OK a backlog:StateChange ; backlog:hasFromState "Locked" ; backlog:hasToState "Active" ;
    backlog:hasTrigger "Second factor confirmed" .
storydetailneg:TC_OK a backlog:TestCase ; backlog:exercisesCriterion storydetailneg:AC ; backlog:runsOnData storydetailneg:TD .
storydetailneg:TD a backlog:TestData ; backlog:hasFixtureState "One account in state Locked with a registered second factor." .

# ST-DUP: two steps claiming the same position
storydetailneg:Spec_Dup a backlog:Specification ; backlog:hasInteractionStep storydetailneg:D1 , storydetailneg:D2 .
storydetailneg:D1 a backlog:InteractionStep ; backlog:hasStepOrdinal 1 ; backlog:hasStepAction "Opens the form." .
storydetailneg:D2 a backlog:InteractionStep ; backlog:hasStepOrdinal 1 ; backlog:hasStepAction "Submits the form." .

# SC-SAME: a change that changes nothing
storydetailneg:SC_Same a backlog:StateChange ; backlog:hasFromState "Locked" ; backlog:hasToState "Locked" ;
    backlog:hasTrigger "Nothing happens" .

# TC-BARE: exercises nothing, runs on nothing
storydetailneg:TC_Bare a backlog:TestCase .

# S-NOSPEC: groomed for Interaction, carries no specification
storydetailneg:S_NoSpec a backlog:Story ; backlog:hasIdentifier "S-NOSPEC" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer storydetailneg:BL ; backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "fixture" ;
    backlog:hasApplicableConcern backlog:Concern_Interaction .
storydetailneg:R_NoSpec a backlog:RefinementEvent ; backlog:refines storydetailneg:S_NoSpec ;
    backlog:addressesConcern backlog:Concern_Interaction ;
    backlog:refinedAt "2026-09-01T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Flow discussed." ; backlog:refinedBy backlog:Builder .

<http://example.org/sd#P> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_tasktype_negative_v1_0_0.ttl (tasktypenegati) ---
# Task types and the grooming-to-execution join.
#
# Source: ISO/IEC/IEEE 12207 clause 6.4 technical processes.
#
#   S-OK   groomed for Data and Architecture; tasks of the implied
#          types exist -> silent
#   S-GAP  groomed for Architecture; only an implementation task
#          planned -> ADVISORY: analysed and not acted on
#   T-BARE a task with no type at all -> REJECTED at L3
#   BL     implementation tasks, no verification or validation
#          anywhere -> ADVISORY: a register that only builds
#
# S-GAP is the case the join exists for. Before it, grooming and
# execution were separate records: a story could be analysed for
# architecture and produce nothing but code, and both halves would
# look complete.


tasktypenegati:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "task type fixture" ;
    backlog:governsBacklog tasktypenegati:BL ; backlog:hasConformanceLevel backlog:L3_Governed ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "L3: the task-type clause is L3." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .
tasktypenegati:BL a backlog:Backlog ; backlog:hasIdentifier "BL-TT" ; backlog:hasState backlog:InProgress .
tasktypenegati:It a backlog:Iteration ; backlog:hasIdentifier "IT-1" ; backlog:hasState backlog:InProgress ;
    backlog:iterationStart "2026-08-01T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2027-01-31T23:59:59"^^xsd:dateTime .

tasktypenegati:S_OK a backlog:Story ; backlog:hasIdentifier "S-OK-TT" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer tasktypenegati:BL , tasktypenegati:It ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "fixture" ;
    backlog:hasApplicableConcern backlog:Concern_Data , backlog:Concern_Architecture .
tasktypenegati:R1 a backlog:RefinementEvent ; backlog:refines tasktypenegati:S_OK ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Schema agreed." ; backlog:refinedBy backlog:Builder .
tasktypenegati:R2 a backlog:RefinementEvent ; backlog:refines tasktypenegati:S_OK ;
    backlog:addressesConcern backlog:Concern_Architecture ;
    backlog:refinedAt "2026-08-01T09:30:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Component boundary agreed." ; backlog:refinedBy backlog:Builder .
tasktypenegati:PE1 a backlog:PlanningEvent ; backlog:plansItem tasktypenegati:S_OK ; backlog:plannedInto tasktypenegati:It ;
    backlog:plannedAt "2026-08-01T10:00:00"^^xsd:dateTime ;
    backlog:producesTask tasktypenegati:T_D , tasktypenegati:T_A .
tasktypenegati:T_D a backlog:ExecutionTask ; backlog:hasIdentifier "T-D" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer tasktypenegati:BL , tasktypenegati:It ; backlog:hasTaskType backlog:Task_DesignDefinition .
tasktypenegati:T_A a backlog:ExecutionTask ; backlog:hasIdentifier "T-A" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer tasktypenegati:BL , tasktypenegati:It ; backlog:hasTaskType backlog:Task_ArchitectureDefinition .

tasktypenegati:S_GAP a backlog:Story ; backlog:hasIdentifier "S-GAP" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer tasktypenegati:BL , tasktypenegati:It ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "fixture" ;
    backlog:hasApplicableConcern backlog:Concern_Architecture .
tasktypenegati:R3 a backlog:RefinementEvent ; backlog:refines tasktypenegati:S_GAP ;
    backlog:addressesConcern backlog:Concern_Architecture ;
    backlog:refinedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Boundary discussed." ; backlog:refinedBy backlog:Builder .
tasktypenegati:PE2 a backlog:PlanningEvent ; backlog:plansItem tasktypenegati:S_GAP ; backlog:plannedInto tasktypenegati:It ;
    backlog:plannedAt "2026-08-01T10:00:00"^^xsd:dateTime ;
    backlog:producesTask tasktypenegati:T_I .
tasktypenegati:T_I a backlog:ExecutionTask ; backlog:hasIdentifier "T-I" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer tasktypenegati:BL , tasktypenegati:It ; backlog:hasTaskType backlog:Task_Implementation .

tasktypenegati:T_BARE a backlog:ExecutionTask ; backlog:hasIdentifier "T-BARE-TT" ; backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer tasktypenegati:BL , tasktypenegati:It .

<http://example.org/tt#P> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_taxonomy_negative_v1_0_0.ttl (taxonomynegati) ---
# ISO/IEC/IEEE 14764 classification — every way to mislabel work.
#
#   N1  Corrective, but its axes say proactive enhancement
#   N2  Adaptive, with no environment change: nothing was reactive
#   N3  Development carrying a maintenance category — an initiative
#       doing both is two initiatives
#   N4  Maintenance with no category at all: "maintenance" alone
#       conflates fixing what is broken with improving what works
#   N5  an investment category the vocabulary never declared
#
# N5 is the one that shipped for real. owl:oneOf closes the set for a
# reasoner but is not a SHACL check, so an invented IRI passed
# silently in this package's own register for several releases.


taxonomynegati:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "Taxonomy mislabelling fixture" ;
    backlog:governsBacklog taxonomynegati:Backlog ;
    backlog:hasConformanceLevel backlog:L3_Governed ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Governed: the category-required and request-required clauses are L3." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .

taxonomynegati:Backlog a backlog:Backlog ; backlog:hasIdentifier "BL-TN" ; backlog:hasState backlog:InProgress .

taxonomynegati:N1 a backlog:Epic ; backlog:hasIdentifier "N-T1" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer taxonomynegati:Backlog ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "planted" ;
    backlog:hasInitiativeKind backlog:Kind_Maintenance ;
    backlog:hasMaintenanceTiming backlog:Timing_Proactive ;
    backlog:hasMaintenanceGoal backlog:Goal_Enhancement ;
    backlog:hasMaintenanceCategory backlog:Maint_Corrective .

taxonomynegati:N2 a backlog:Epic ; backlog:hasIdentifier "N-T2" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer taxonomynegati:Backlog ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "planted" ;
    backlog:hasInitiativeKind backlog:Kind_Maintenance ;
    backlog:hasMaintenanceTiming backlog:Timing_Proactive ;
    backlog:hasMaintenanceGoal backlog:Goal_Enhancement ;
    backlog:hasMaintenanceCategory backlog:Maint_Adaptive .

taxonomynegati:N3 a backlog:Epic ; backlog:hasIdentifier "N-T3" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer taxonomynegati:Backlog ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "planted" ;
    backlog:hasInitiativeKind backlog:Kind_Development ;
    backlog:hasMaintenanceCategory backlog:Maint_Perfective .

taxonomynegati:N4 a backlog:Epic ; backlog:hasIdentifier "N-T4" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer taxonomynegati:Backlog ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "planted" ;
    backlog:hasInitiativeKind backlog:Kind_Maintenance ;
    backlog:hasMaintenanceTiming backlog:Timing_Reactive ;
    backlog:hasMaintenanceGoal backlog:Goal_Correction .

taxonomynegati:N5 a backlog:Story ; backlog:hasIdentifier "N-T5" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer taxonomynegati:Backlog ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "planted" ;
    backlog:hasInvestmentCategory backlog:Cat_Invented .

<http://example.org/tax-neg#Profile> backlog:hasExpectedPolarity backlog:Polarity_Negative .


# --- merged from fixture_tool_run_record_v1_1_0.ttl (toolrunrecord) ---
# Tool run record integrity — test drive, not a construction.
#
# Proves SelfComparisonClaimShape catches the exact bug this session found in
# its own tooling: a run claiming a real, distinct baseline while its own
# recorded hashes are identical.
#
# TR_Lying: claims runConcludedDistinctBaseline true with matching hashes ->
#   violation, the exact real bug class.
# TR_Honest: claims true with genuinely different hashes -> silent.
# TR_HonestFalse: claims false (no distinct baseline available), matching
#   hashes -> silent; a tool that honestly reports "could not verify" is not
#   the failure this shape exists to catch.


toolrunrecord:TS_Fixture a backlog:ToolScript ; backlog:scriptFileName "fixture_tool.py" ; backlog:acceptsGraphPath false .

toolrunrecord:TR_Lying a backlog:ToolRunRecord ; backlog:ranTool toolrunrecord:TS_Fixture ;
    backlog:usedBaselineHash "abc123" ; backlog:comparedAgainstHash "abc123" ;
    backlog:runConcludedDistinctBaseline true .

toolrunrecord:TR_Honest a backlog:ToolRunRecord ; backlog:ranTool toolrunrecord:TS_Fixture ;
    backlog:usedBaselineHash "abc123" ; backlog:comparedAgainstHash "def456" ;
    backlog:runConcludedDistinctBaseline true .

toolrunrecord:TR_HonestFalse a backlog:ToolRunRecord ; backlog:ranTool toolrunrecord:TS_Fixture ;
    backlog:usedBaselineHash "abc123" ; backlog:comparedAgainstHash "abc123" ;
    backlog:runConcludedDistinctBaseline false .

# BaselineReferenceShape: BR_Bad missing its rationale -> fires. BR_Good complete -> silent.
toolrunrecord:BR_Bad a backlog:BaselineReference ; backlog:baselineForTool toolrunrecord:TS_Fixture ;
    backlog:hasBaselineLocation "https://example.org/fixture-only" .
toolrunrecord:BR_Good a backlog:BaselineReference ; backlog:baselineForTool toolrunrecord:TS_Fixture ;
    backlog:hasBaselineLocation "https://example.org/fixture-only" ;
    backlog:hasBaselineRationale "Fixture-only: a complete, real baseline reference." .

# v1.1.0 (2026-09-07) -- expected polarity declared on the fixture itself (TBox v1.82.0
# dropped the AdoptionProfile-only domain): Negative, because it exists to make the shape(s) named in its header FIRE; a run of it with no violation would mean that clause no longer fires (Polarity_Negative's own definition).
# Until now the gate inferred 'expected pass' from this filename and had no way to be right.
<http://example.org/toolruntest#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_readiness_and_refined_v1_0_0.ttl (readinessandre) ---
# fixture_readiness_and_refined v1.0.0 -- NEGATIVE. Proves ReadinessGateShape's real, unchanged
# behavior once Refined exists, and that the two shapes which already referenced backlog:Refined
# (dead code before this) now genuinely fire.
#
# S_ReadyBad     claims Ready with neither acceptance criteria nor a refinement event ->
#                ReadinessGateShape must still fire, exactly as before Refined existed.
# S_RefinedOnly  Refined (tasks decomposed), never claimed Ready -> ReadinessGateShape must NOT
#                fire on it; it never made the claim Ready makes.
# S_ReadyGood    genuinely Ready, with both a real acceptance criterion and a real refinement
#                event -> stays silent under ReadinessGateShape, same as always.
# L_Lagging (repurposed context) exercises InProgressNeedsStartedWorkShape's own real use of
#                Refined: an item in that state must now correctly count as "not yet started".


readinessandre:L a backlog:Lineage ; backlog:lineageOrdinal 1 ; backlog:lineageArchived false ;
    backlog:hasLineageStatus backlog:LS_InProgress .

readinessandre:S_ReadyBad a backlog:Story ; backlog:hasIdentifier "S-RDYBAD" ; backlog:hasState backlog:Ready ;
    backlog:belongsToLineage readinessandre:L .

readinessandre:S_RefinedOnly a backlog:Story ; backlog:hasIdentifier "S-REFONLY" ; backlog:hasState backlog:Refined ;
    backlog:belongsToLineage readinessandre:L .
readinessandre:T_RefinedOnly a backlog:ExecutionTask ; backlog:hasIdentifier "T-REFONLY" ; backlog:hasState backlog:Proposed ;
    backlog:belongsToLineage readinessandre:L .
readinessandre:S_RefinedOnly backlog:decomposesInto readinessandre:T_RefinedOnly .

readinessandre:S_ReadyGood a backlog:Story ; backlog:hasIdentifier "S-RDYGOOD" ; backlog:hasState backlog:Ready ;
    backlog:belongsToLineage readinessandre:L ; backlog:hasAcceptanceCriterion readinessandre:AC_Good .
readinessandre:AC_Good a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given/when/then, fixture only." .
readinessandre:RE_Good a backlog:RefinementEvent ; backlog:refines readinessandre:S_ReadyGood ;
    backlog:refinedAt "2026-09-17T00:00:00Z"^^xsd:dateTime ; backlog:hasRefinementOutcome "Fixture-only refinement." .

<http://example.org/readiness-refined#> backlog:hasExpectedPolarity backlog:Polarity_Negative .
readinessandre:Reg a backlog:Backlog ; rdfs:label "fixture register"@en ; backlog:isRegisterRoot true ;
    backlog:adoptsRuleSet backlog:RS_LineageStatus .

# --- merged from fixture_lineage_status_negative_v1_3_0.ttl (lineagestatusn) ---
# fixture_lineage_status_negative v1.0.0 -- NEGATIVE. One case per LineageStatusShape clause and the advisory:
#  L_NoStatus     no hasLineageStatus at all.
#  L_Outrun       claims LS_Goaled with no active Goal output (only a retracted one).
#  L_FalseAchieved claims LS_Achieved; mission not Out_Achieved.
#  L_ArchNoFile   claims LS_Archived; not lineageArchived / no archiveFile.
#  L_Lagging      mission Out_Achieved with closure report, status still LS_InProgress.
#  L_Found        LS_Achieved and not archived -> AchievedLineageNotArchivedAdvisoryShape (Warning).
lineagestatusn:M1 a backlog:Mission . lineagestatusn:M2 a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_InFlight .
lineagestatusn:M3 a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_Achieved . lineagestatusn:CR3 a backlog:ClosureReport ; backlog:closesForMission lineagestatusn:M3 .
lineagestatusn:M4 a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_Achieved . lineagestatusn:CR4 a backlog:ClosureReport ; backlog:closesForMission lineagestatusn:M4 .
lineagestatusn:L_NoStatus a backlog:Lineage ; backlog:lineageOrdinal 1 ; backlog:lineageArchived false ; backlog:lineageForMission lineagestatusn:M1 .
lineagestatusn:L_Outrun a backlog:Lineage ; backlog:lineageOrdinal 2 ; backlog:lineageArchived false ; backlog:lineageForMission lineagestatusn:M1 ; backlog:hasLineageStatus backlog:LS_Goaled .
lineagestatusn:O_G a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ; backlog:belongsToLineage lineagestatusn:L_Outrun ; backlog:closedAtCommit "c1" ; backlog:hasStateDigest "x" ; backlog:outputRetracted true .
lineagestatusn:L_FalseAchieved a backlog:Lineage ; backlog:lineageOrdinal 3 ; backlog:lineageArchived false ; backlog:lineageForMission lineagestatusn:M2 ; backlog:hasLineageStatus backlog:LS_Achieved .
lineagestatusn:L_ArchNoFile a backlog:Lineage ; backlog:lineageOrdinal 4 ; backlog:lineageArchived false ; backlog:lineageForMission lineagestatusn:M1 ; backlog:hasLineageStatus backlog:LS_Archived .
lineagestatusn:L_Lagging a backlog:Lineage ; backlog:lineageOrdinal 5 ; backlog:lineageArchived false ; backlog:lineageForMission lineagestatusn:M3 ; backlog:hasLineageStatus backlog:LS_InProgress .
lineagestatusn:L_Found a backlog:Lineage ; backlog:lineageOrdinal 6 ; backlog:lineageArchived false ; backlog:lineageForMission lineagestatusn:M4 ; backlog:hasLineageStatus backlog:LS_Achieved .
#  LineageStatusSingleShape   L_TwoStatus carries two statuses (the pointer appended, not moved).
#  RetiredNameCollisionShape  L_Reused has the same IRI as a retired lineage an entry records.
lineagestatusn:L_TwoStatus a backlog:Lineage ; backlog:lineageOrdinal 7 ; backlog:lineageArchived false ;
    backlog:lineageForMission lineagestatusn:M1 ; backlog:hasLineageStatus backlog:LS_Scoped , backlog:LS_Goaled .
lineagestatusn:L_Reused a backlog:Lineage ; backlog:lineageOrdinal 8 ; backlog:lineageArchived false ;
    backlog:lineageForMission lineagestatusn:M1 ; backlog:hasLineageStatus backlog:LS_Opened .
lineagestatusn:E_Retired a backlog:LineageArchiveEntry ; backlog:entryForLineage "http://example.org/lineage-status-neg#L_Reused" ;
    backlog:entryForMission "http://example.org/lineage-status-neg#M1" ; backlog:entryOutcome "Out_Achieved" ;
    backlog:entryOrdinal 3 ; backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_2_0.ttl" ;
    backlog:archivedAt "2026-09-01T00:00:00Z"^^xsd:dateTime ; backlog:archivalTrigger "fixture" .

#  RetiredNameCollisionShape (real fix, 2026-09-18) -- L_ArchivedSelf has the same IRI its own
#  entry records too, but it IS the archived original, not a colliding new one -- must stay silent.
lineagestatusn:L_ArchivedSelf a backlog:Lineage ; rdfs:label "Archived self, real exemption test"@en ;
    backlog:lineageOrdinal 9 ; backlog:lineageArchived true ;
    backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_2_0.ttl" ;
    backlog:lineageForMission lineagestatusn:M1 .
lineagestatusn:E_ArchivedSelf a backlog:LineageArchiveEntry ; backlog:entryForLineage "http://example.org/lineage-status-neg#L_ArchivedSelf" ;
    backlog:entryForMission "http://example.org/lineage-status-neg#M1" ; backlog:entryOutcome "Out_Achieved" ;
    backlog:entryOrdinal 4 ; backlog:archiveFile "01-ontologies/backlog_framework_archive_abox_v1_2_0.ttl" ;
    backlog:archivedAt "2026-09-01T00:00:00Z"^^xsd:dateTime ; backlog:archivalTrigger "fixture" .

#  InProgressNeedsStartedWorkShape  L_NotStarted claims InProgress with every item still Proposed.
lineagestatusn:L_NotStarted a backlog:Lineage ; backlog:lineageOrdinal 9 ; backlog:lineageArchived false ;
    backlog:lineageForMission lineagestatusn:M2 ; backlog:hasLineageStatus backlog:LS_InProgress .
lineagestatusn:S_NotStarted a backlog:Story ; backlog:hasIdentifier "S-NS" ; backlog:hasState backlog:Proposed ;
    backlog:belongsToLineage lineagestatusn:L_NotStarted .

#  StatusLagsRealWorkShape (G97)  L_Understated claims Backlogged while a real item has left Proposed.
lineagestatusn:L_Understated a backlog:Lineage ; backlog:lineageOrdinal 10 ; backlog:lineageArchived false ;
    backlog:lineageForMission lineagestatusn:M2 ; backlog:hasLineageStatus backlog:LS_Backlogged .
lineagestatusn:S_Understated a backlog:Story ; backlog:hasIdentifier "S-US" ; backlog:hasState backlog:Done ;
    backlog:belongsToLineage lineagestatusn:L_Understated .

<http://example.org/lineage-status-neg#> backlog:hasExpectedPolarity backlog:Polarity_Negative .
# The negative fixture ADOPTS the status rule set, so the clauses it exists to prove are in force here
# even though minimal fixtures elsewhere are untouched by them (G91: a ruling binds what declared it).
lineagestatusn:Reg a backlog:Backlog ; rdfs:label "fixture register"@en ; backlog:isRegisterRoot true ;
    backlog:adoptsRuleSet backlog:RS_LineageStatus , backlog:RS_LabelConvention .


# --- merged from fixture_sprint_ceremonies_negative_v1_0_0.ttl (sprintceremoni) ---
# fixture_sprint_ceremonies_negative_v1_0_0.ttl — proves the four L1
# structural shapes over the sprint-ceremony hierarchy added in the
# ceremony test-drive (SprintPlanningCeremonyShape, SprintReviewCeremonyShape,
# SprintRetrospectiveShape, RetrospectiveFindingShape). Each violating node
# is minimal, built to trip exactly one shape.


sprintceremoni:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "Sprint ceremonies negative fixture" ;
    backlog:governsBacklog sprintceremoni:BL ; backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "L1: sprint ceremony structural fixture, L1 only." ;
    backlog:adoptsFacet backlog:CoreFacet ;
    backlog:hasExpectedPolarity backlog:Polarity_Negative .
sprintceremoni:BL a backlog:Backlog ; backlog:hasIdentifier "BL-SPRINTCEREMONIESNEG" ; backlog:hasState backlog:InProgress .

# PLAN_NoEvent — a planning ceremony with an iteration and a date but no
# included planning event.
sprintceremoni:PLAN_NoEvent a backlog:SprintPlanningCeremony ;
    backlog:ceremonyFor sprintceremoni:It_X ; backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime .

# REVIEW_NoDecision — a review ceremony that neither closes nor flags
# anything.
sprintceremoni:REVIEW_NoDecision a backlog:SprintReviewCeremony ;
    backlog:ceremonyFor sprintceremoni:It_X ; backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime .

# RETRO_NoFinding — a retrospective that produced nothing.
sprintceremoni:RETRO_NoFinding a backlog:SprintRetrospective ;
    backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime .

# FIND_NoRootCause — a finding stating no root cause.
sprintceremoni:RETRO_WithBadFinding a backlog:SprintRetrospective ;
    backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    backlog:producesFinding sprintceremoni:FIND_NoRootCause .
sprintceremoni:FIND_NoRootCause a backlog:RetrospectiveFinding .

# REVIEW_WrongPlan — reviews a plan for a different iteration than its own
# ceremonyFor names.
sprintceremoni:PLAN_ForItY a backlog:SprintPlanningCeremony ;
    backlog:ceremonyFor sprintceremoni:It_Y ; backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    backlog:includesPlanningEvent sprintceremoni:PE_ForItY .
sprintceremoni:PE_ForItY a backlog:PlanningEvent .
sprintceremoni:REVIEW_WrongPlan a backlog:SprintReviewCeremony ;
    backlog:ceremonyFor sprintceremoni:It_X ; backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    backlog:reviewsCeremony sprintceremoni:PLAN_ForItY ; backlog:closesStory sprintceremoni:S_WrongPlanDummy .
sprintceremoni:S_WrongPlanDummy a backlog:Story .

# REVIEW_DirtyClose — closes an iteration while one of its real member
# stories is neither Done nor flagged for carry-over.
sprintceremoni:It_Dirty a backlog:Iteration .
sprintceremoni:S_Dirty_Left a backlog:Story ; backlog:memberOfContainer sprintceremoni:It_Dirty ; backlog:hasState backlog:InProgress .
sprintceremoni:PLAN_ForItDirty a backlog:SprintPlanningCeremony ;
    backlog:ceremonyFor sprintceremoni:It_Dirty ; backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    backlog:includesPlanningEvent sprintceremoni:PE_ForItDirty .
sprintceremoni:PE_ForItDirty a backlog:PlanningEvent .
sprintceremoni:REVIEW_DirtyClose a backlog:SprintReviewCeremony ;
    backlog:ceremonyFor sprintceremoni:It_Dirty ; backlog:heldAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    backlog:reviewsCeremony sprintceremoni:PLAN_ForItDirty ; backlog:closesIteration sprintceremoni:It_Dirty ;
    backlog:closesStory sprintceremoni:S_DirtyDummy .
sprintceremoni:S_DirtyDummy a backlog:Story .

# --- merged from fixture_sprint_ceremonies_v1_1_0.ttl (sprintceremona) ---
# fixture_sprint_ceremonies_v1_0_0.ttl — proves the four sprint-ceremony
# advisories added under G33-G38 governance (another registrant's ceremony-coverage
# handover): StoryReadyToCloseShape, IterationEndedIncompleteShape,
# BatchCompleteButNotDoneShape, BatchStartedStateStaleShape.
#
# Each case is paired with a negative control that must stay silent, so a
# broken query that always fires is as visible as one that never does.
# Otherwise structurally complete (every PlanningEvent records when it
# happened, what it planned into, and at least one task; every Iteration
# has a start, an end, and a member) so only the four intended advisories
# fire, matching this package's own convention for advisory-proof fixtures.


sprintceremona:It_Neutral a backlog:Iteration ; backlog:hasIdentifier "IT-NEUTRAL" ;
    backlog:iterationStart "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    backlog:iterationEnd "2099-01-01T00:00:00Z"^^xsd:dateTime .
sprintceremona:ItNeutral_Member a backlog:Story ; backlog:hasIdentifier "WI-ITNEUTRAL-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer sprintceremona:It_Neutral .

sprintceremona:It_Ended a backlog:Iteration ; backlog:hasIdentifier "IT-ENDED" ;
    backlog:iterationStart "2019-01-01T00:00:00Z"^^xsd:dateTime ;
    backlog:iterationEnd "2020-01-01T00:00:00Z"^^xsd:dateTime .
sprintceremona:ItEnded_Member a backlog:Story ; backlog:hasIdentifier "WI-ITENDED-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer sprintceremona:It_Ended .

sprintceremona:It_Open a backlog:Iteration ; backlog:hasIdentifier "IT-OPEN" ;
    backlog:iterationStart "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    backlog:iterationEnd "2099-01-01T00:00:00Z"^^xsd:dateTime .
sprintceremona:ItOpen_Member a backlog:Story ; backlog:hasIdentifier "WI-ITOPEN-M" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer sprintceremona:It_Open .

# --- StoryReadyToCloseShape ---
# S_ReadyToClose: all tasks Done, story itself is not -> fires.
sprintceremona:PE_ReadyToClose a backlog:PlanningEvent ; backlog:plansItem sprintceremona:S_ReadyToClose ;
    backlog:plannedInto sprintceremona:It_Neutral ; backlog:plannedAt "2026-01-02T00:00:00Z"^^xsd:dateTime ;
    backlog:producesTask sprintceremona:T_RTC1 , sprintceremona:T_RTC2 .
sprintceremona:T_RTC1 a backlog:ExecutionTask ; backlog:hasIdentifier "T-RTC1" ; backlog:hasState backlog:Done .
sprintceremona:T_RTC2 a backlog:ExecutionTask ; backlog:hasIdentifier "T-RTC2" ; backlog:hasState backlog:Done .
sprintceremona:S_ReadyToClose a backlog:Story ; backlog:hasIdentifier "S-READYTOCLOSE" ; backlog:hasState backlog:InProgress .

# S_StillOpen: one task not Done -> must stay silent.
sprintceremona:PE_StillOpen a backlog:PlanningEvent ; backlog:plansItem sprintceremona:S_StillOpen ;
    backlog:plannedInto sprintceremona:It_Neutral ; backlog:plannedAt "2026-01-02T00:00:00Z"^^xsd:dateTime ;
    backlog:producesTask sprintceremona:T_SO1 , sprintceremona:T_SO2 .
sprintceremona:T_SO1 a backlog:ExecutionTask ; backlog:hasIdentifier "T-SO1" ; backlog:hasState backlog:Done .
sprintceremona:T_SO2 a backlog:ExecutionTask ; backlog:hasIdentifier "T-SO2" ; backlog:hasState backlog:InProgress .
sprintceremona:S_StillOpen a backlog:Story ; backlog:hasIdentifier "S-STILLOPEN" ; backlog:hasState backlog:InProgress .

# --- IterationEndedIncompleteShape ---
# S_Spillover: planned into an already-ended iteration, not Done -> fires.
sprintceremona:PE_Spillover a backlog:PlanningEvent ; backlog:plansItem sprintceremona:S_Spillover ;
    backlog:plannedInto sprintceremona:It_Ended ; backlog:plannedAt "2019-01-02T00:00:00Z"^^xsd:dateTime ;
    backlog:producesTask sprintceremona:T_Spillover .
sprintceremona:T_Spillover a backlog:ExecutionTask ; backlog:hasIdentifier "T-SPILLOVER" ; backlog:hasState backlog:InProgress .
sprintceremona:S_Spillover a backlog:Story ; backlog:hasIdentifier "S-SPILLOVER" ; backlog:hasState backlog:InProgress .

# S_OnTrack: planned into a still-open iteration -> must stay silent.
sprintceremona:PE_OnTrack a backlog:PlanningEvent ; backlog:plansItem sprintceremona:S_OnTrack ;
    backlog:plannedInto sprintceremona:It_Open ; backlog:plannedAt "2026-01-02T00:00:00Z"^^xsd:dateTime ;
    backlog:producesTask sprintceremona:T_OnTrack .
sprintceremona:T_OnTrack a backlog:ExecutionTask ; backlog:hasIdentifier "T-ONTRACK" ; backlog:hasState backlog:InProgress .
sprintceremona:S_OnTrack a backlog:Story ; backlog:hasIdentifier "S-ONTRACK" ; backlog:hasState backlog:InProgress .

# --- BatchCompleteButNotDoneShape ---
# WI_BatchDoneNotClosed: completed == size, state not Done -> fires.
sprintceremona:WI_BatchDoneNotClosed a backlog:Story ; backlog:hasIdentifier "WI-BATCHDONENOTCLOSED" ;
    backlog:hasBatchSize 5 ; backlog:hasBatchCompleted 5 ; backlog:hasState backlog:InProgress .

# WI_BatchDoneAndClosed: completed == size, state Done -> must stay silent.
sprintceremona:WI_BatchDoneAndClosed a backlog:Story ; backlog:hasIdentifier "WI-BATCHDONEANDCLOSED" ;
    backlog:hasBatchSize 5 ; backlog:hasBatchCompleted 5 ; backlog:hasState backlog:Done .

# --- BatchStartedStateStaleShape ---
# WI_BatchStartedStale: completed > 0, state still Ready -> fires.
sprintceremona:WI_BatchStartedStale a backlog:Story ; backlog:hasIdentifier "WI-BATCHSTARTEDSTALE" ;
    backlog:hasBatchSize 44 ; backlog:hasBatchCompleted 5 ; backlog:hasState backlog:Ready .

# WI_BatchNotStarted: completed == 0, state Proposed -> must stay silent
# (nothing has moved yet, so there is nothing stale to flag).
sprintceremona:WI_BatchNotStarted a backlog:Story ; backlog:hasIdentifier "WI-BATCHNOTSTARTED" ;
    backlog:hasBatchSize 10 ; backlog:hasBatchCompleted 0 ; backlog:hasState backlog:Proposed .

# WI_BatchStartedInProgress: completed > 0, state already InProgress ->
# must stay silent (state already reflects the real work under it).
sprintceremona:WI_BatchStartedInProgress a backlog:Story ; backlog:hasIdentifier "WI-BATCHSTARTEDINPROGRESS" ;
    backlog:hasBatchSize 44 ; backlog:hasBatchCompleted 5 ; backlog:hasState backlog:InProgress .

# --- RetrospectiveNotStartedShape ---
sprintceremona:Plan_Neutral a backlog:SprintPlanningCeremony ; backlog:ceremonyFor sprintceremona:It_Neutral ;
    backlog:heldAt "2026-01-02T00:00:00Z"^^xsd:dateTime ;
    backlog:includesPlanningEvent sprintceremona:PE_ReadyToClose , sprintceremona:PE_StillOpen .

# REVIEW_NoRetro: closed a story, no retrospective follows it -> fires.
sprintceremona:REVIEW_NoRetro a backlog:SprintReviewCeremony ; backlog:ceremonyFor sprintceremona:It_Neutral ;
    backlog:heldAt "2026-01-03T00:00:00Z"^^xsd:dateTime ; backlog:reviewsCeremony sprintceremona:Plan_Neutral ;
    backlog:closesStory sprintceremona:S_ReadyToClose .

# REVIEW_WithRetro: closed a story, and a retrospective follows it -> must
# stay silent.
sprintceremona:REVIEW_WithRetro a backlog:SprintReviewCeremony ; backlog:ceremonyFor sprintceremona:It_Neutral ;
    backlog:heldAt "2026-01-03T00:00:00Z"^^xsd:dateTime ; backlog:reviewsCeremony sprintceremona:Plan_Neutral ;
    backlog:closesStory sprintceremona:S_StillOpen .
sprintceremona:Retro_WithRetro a backlog:SprintRetrospective ; backlog:followsReview sprintceremona:REVIEW_WithRetro ;
    backlog:heldAt "2026-01-04T00:00:00Z"^^xsd:dateTime ;
    backlog:producesFinding sprintceremona:Find_WithRetro .
sprintceremona:Find_WithRetro a backlog:RetrospectiveFinding ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "Test-drive fixture case only, not a real finding." .

# v1.1.0 (2026-09-07) -- expected polarity declared on the fixture itself (TBox v1.82.0
# dropped the AdoptionProfile-only domain): Negative, because it exists to make the shape(s) named in its header FIRE; a run of it with no violation would mean that clause no longer fires (Polarity_Negative's own definition).
# Until now the gate inferred 'expected pass' from this filename and had no way to be right.
<http://example.org/sprint-ceremonies-fixture#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_sdlc_obligations_negative_v1_1_0.ttl (sdlcobligation) ---
# fixture_sdlc_obligations_negative v1.0.0 -- NEGATIVE. One case per clause:
#  StageObligationShape      Ob_NoTarget (neither stage nor task type), Ob_NoRationale, Ob_BadKind (owesKind without owesClass ModelArtifact)
#  StageOutputOwesShape      Out_Scope_Bare closes the Scope stage with no DomainEntity and no Blueprint in its lineage
#  StageOutputWaiverShape    Out_Goal_Bare waives an obligation and gives no reason
#  RefinementProducesShape   PE_Bare plans a story and produces nothing (Warning)
#  TaskTypeObligationShape   T_Design is Done, Task_DesignDefinition, no ModelArtifact in its lineage
sdlcobligation:L_Bare a backlog:Lineage ; backlog:lineageOrdinal 1 ; backlog:lineageArchived false ;
    backlog:lineageForMission sdlcobligation:M_Bare ; backlog:hasLineageStatus backlog:LS_Scoped .
sdlcobligation:M_Bare a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_InFlight .
sdlcobligation:Out_Scope_Bare a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Scope ; backlog:belongsToLineage sdlcobligation:L_Bare ;
    backlog:closedAtCommit "c1" ; backlog:hasStateDigest "x" .
sdlcobligation:Out_Goal_Bare a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ; backlog:belongsToLineage sdlcobligation:L_Bare ;
    backlog:closedAtCommit "c2" ; backlog:hasStateDigest "y" ;
    backlog:obligationWaivedBy backlog:Ob_Goal_Specification .
sdlcobligation:S_Bare a backlog:Story ; backlog:hasIdentifier "S-BARE" ; backlog:hasState backlog:Proposed ; backlog:belongsToLineage sdlcobligation:L_Bare .
sdlcobligation:PE_Bare a backlog:PlanningEvent ; backlog:plansItem sdlcobligation:S_Bare ; backlog:plannedAt "2026-09-09T10:00:00Z"^^xsd:dateTime .
sdlcobligation:T_Design a backlog:ExecutionTask ; backlog:hasTaskType backlog:Task_DesignDefinition ; backlog:hasIdentifier "T-D-SDLC" ;
    backlog:hasState backlog:Done ; backlog:belongsToLineage sdlcobligation:L_Bare .
sdlcobligation:Ob_NoTarget a backlog:StageObligation ; backlog:owesClass backlog:ModelArtifact ;
    backlog:obligationRationale "no stage, no task type" ; backlog:obligationSeverity backlog:Oblig_Advisory .
sdlcobligation:Ob_NoRationale a backlog:StageObligation ; backlog:obligationOfStage backlog:Stage_Backlog ;
    backlog:owesClass backlog:TestCase ; backlog:obligationSeverity backlog:Oblig_Advisory .
sdlcobligation:Ob_BadKind a backlog:StageObligation ; backlog:obligationOfStage backlog:Stage_Goal ;
    backlog:owesClass backlog:Specification ; backlog:owesKind backlog:Kind_ClassDiagram ;
    backlog:obligationRationale "a kind qualifies the class it belongs to" ; backlog:obligationSeverity backlog:Oblig_Advisory .
sdlcobligation:L_Bare backlog:adoptsObligationSet backlog:OS_SDLC_v1 .   # adopted at LS_Scoped, no adoptionRecordedAtOpen -> ObligationAdoptionShape fires, and the closure cases stay live
<http://example.org/sdlc-obligations-neg#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# v1.1.0 (2026-09-11) -- level, depth and concern.
#  TaskTypeObligationLevelShape  T_DesignDone is a finished design task whose lineage carries a model,
#                                but at ANALYSIS level, so the design-level obligation is unmet.
#  ConcernObligationShape        S_Concern declares the data concern and its lineage carries no
#                                design-level class model.
#  ModelLevelStatedShape         MA_NoLevel states no level at all in a lineage that adopted the set.
sdlcobligation:L_Lvl a backlog:Lineage ; backlog:lineageOrdinal 10 ; backlog:lineageArchived false ;
    rdfs:label "fixture lineage for level and concern"@en ;
    backlog:lineageForMission sdlcobligation:M_Bare ; backlog:hasLineageStatus backlog:LS_Backlogged ;
    backlog:adoptsObligationSet backlog:OS_SDLC_v2 ; backlog:adoptionRecordedAtOpen true .
sdlcobligation:MA_Analysis a backlog:ModelArtifact ; rdfs:label "domain model, analysis level"@en ;
    backlog:hasModelKind backlog:Kind_ClassDiagram ; backlog:hasModelLevel backlog:Level_Analysis ;
    backlog:describesItem sdlcobligation:S_Concern ; backlog:belongsToLineage sdlcobligation:L_Lvl .
sdlcobligation:MA_NoLevel a backlog:ModelArtifact ; rdfs:label "a model that never says where it stands"@en ;
    backlog:hasModelKind backlog:Kind_ComponentDiagram ;
    backlog:describesItem sdlcobligation:S_Concern ; backlog:belongsToLineage sdlcobligation:L_Lvl .
sdlcobligation:T_DesignDone a backlog:ExecutionTask ; backlog:hasTaskType backlog:Task_DesignDefinition ;
    backlog:hasIdentifier "T-DSG" ; backlog:hasTitle "design task finished with only an analysis model"@en ;
    backlog:hasState backlog:Done ; backlog:belongsToLineage sdlcobligation:L_Lvl .
sdlcobligation:S_Concern a backlog:Story ; backlog:hasIdentifier "S-CON" ; backlog:hasTitle "a story analysed for data"@en ;
    backlog:hasState backlog:Ready ; backlog:hasApplicableConcern backlog:Concern_Data ;
    backlog:belongsToLineage sdlcobligation:L_Lvl .


# --- merged from fixture_l4_negative_v1_0_0.ttl (l4negative) ---
# L4_LineageEnforced, ADVERSARIAL — every L4 clause violated on purpose.
#
# The whole chain, connected and measured: Mission -> Goal -> Objective (with a
# real observation) -> Scope -> Epic -> Story -> PlanningEvent -> Iteration ->
# DeploymentUnit. No epic in a sprint, no epic deployed, no story reaching
# execution without a planning event, no work outside the declared scope.


l4negative:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "L4 conformant reference register" ;
    backlog:governsBacklog l4negative:Backlog ;
    backlog:hasConformanceLevel backlog:L4_LineageEnforced ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Owner call: this register must prove a mission was accomplished, not report that work was done, so the lineage is enforced rather than advised." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet , backlog:PrioritizationFacet ,
                        backlog:RoadmapFacet , backlog:InvariantFacet , backlog:AuditFacet .

l4negative:Backlog a backlog:Backlog ;
    backlog:hasIdentifier "BL-L4" ; backlog:hasTitle "Reference L4 register" ;
    backlog:hasState backlog:InProgress ;
    backlog:appliesDefinitionOfDone backlog:DoD_Baseline ;
    backlog:hasCommitment l4negative:Commit ;
    backlog:hasScopeStatement l4negative:Scope .

l4negative:Commit a backlog:Commitment ; rdfs:label "Delivery commitment"@en ;
    backlog:commitsToGoal l4negative:Goal .

l4negative:Mission a backlog:Mission ; rdfs:label "Mission"@en ;
    backlog:hasMissionStatement "Practitioners recover an account without contacting support." ;
    backlog:missionFor l4negative:Backlog ; backlog:decidedBy backlog:Owner .

l4negative:Goal a backlog:Goal ; rdfs:label "Self-service recovery"@en ;
    backlog:contributesToMission l4negative:Mission ; backlog:decidedBy backlog:Owner .

l4negative:Metric a core:Metric ; rdfs:label "Share of recoveries completed without support"@en .

l4negative:Objective a backlog:Objective ; rdfs:label "Recoveries need no support contact"@en ;
    backlog:contributesToGoal l4negative:Goal ;
    backlog:hasSuccessMetric l4negative:Metric ;
    backlog:hasBaselineValue 12.0 ; backlog:hasTargetValue 80.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasObjectiveDeadline "2027-01-31T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

# a measurement, not an intention — this is what L4 requires
l4negative:Obs a backlog:MetricObservation ; rdfs:label "First reading, attached to nothing"@en ;
    backlog:observesMetric l4negative:Metric ;
    backlog:hasObservedValue 41.0 ;
    backlog:observedAt "2026-08-09T12:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted support tickets tagged account-recovery against completed recovery flows over the two weeks after release 1." .

l4negative:Scope a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Self-service recovery for practitioner accounts: the reset flow and its notifications." ;
    backlog:scopeRealizesObjective l4negative:Objective ;
    backlog:hasScopeExclusion l4negative:Excl .
l4negative:Excl a backlog:ScopeExclusion ;
    backlog:excludesConcern "Recovery for administrator accounts, which carries a different identity check." ;
    backlog:hasExclusionRationale "Different threat model; a separate objective would be needed and none is declared." ;
    backlog:decidedBy backlog:Owner .

# epic: groomed, never in a sprint, never deployed
l4negative:EP a backlog:Epic ;
    backlog:hasIdentifier "EP-1" ; backlog:hasTitle "Account recovery" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer l4negative:Backlog , l4negative:It1 ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at story level; scoring an epic alongside its scored children would double-count." .

l4negative:US1 a backlog:Story ;
    backlog:hasIdentifier "US-1" ; backlog:hasTitle "Request a reset link" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer l4negative:Backlog , l4negative:It1 ;
    backlog:pursuesObjective l4negative:Objective ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "practitioner" ; backlog:wantsCapability "request a reset link" ;
    backlog:soThat "I can get back in without calling the clinic" ;
    backlog:hasAcceptanceCriterion l4negative:AC1 ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:startedAt "2026-07-28T09:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-04T17:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 9.0 ;
    backlog:hasEvidence l4negative:Ev1 ;
    backlog:lastAuditedAt "2026-08-04T17:00:00"^^xsd:dateTime ;
    backlog:hasPriorityScore l4negative:S1 .
l4negative:AC1 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a practitioner who has forgotten their password, When they request a reset, Then a single-use link arrives within two minutes and expires after one hour." .
l4negative:Ev1 a backlog:TestEvidence ;
    backlog:hasTestSpec "e2e/recovery/request-link.spec.js" ; backlog:hasTestId "REC-1" ;
    backlog:evidenceVerified true ; backlog:verifiedAt "2026-08-04T17:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "playwright test --grep REC-1, exit 0, run in CI on the release commit" ;
    backlog:verifiedByTool "playwright 1.45" ;
    backlog:attestsCriterion l4negative:AC1 ;
    backlog:anchoredToRelease "sha256:8c1f0b2d9a" .
l4negative:S1 a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 6.0 ;
    backlog:hasUserBusinessValue 8.0 ; backlog:hasTimeCriticality 6.0 ;
    backlog:hasRiskReductionValue 4.0 ; backlog:hasJobSize 3.0 ;
