# --- merged from fixture_change_discipline_v1_1_0.ttl (changediscipli) ---
# Change-request discipline — test drive, not a construction.
#
# Proves discrimination for ChangeRequestShape, ImpactAssessmentShape,
# DispositionRequiresAssessmentShape, AcceptedRequestNeedsScopeChangeShape,
# and CrossLineageRiskAdvisoryShape.
#
# CR_Bad: missing rationale -> ChangeRequestShape fires.
# CR_NoAssessment: disposed Accepted with no ImpactAssessment naming it ->
#   DispositionRequiresAssessmentShape fires.
# CR_NoScopeChange: Accepted, has an assessment, but no ScopeChange records
#   the admission -> AcceptedRequestNeedsScopeChangeShape fires.
# CR_Complete: Accepted, real assessment, real ScopeChange -> both silent.
# IA_Bad: missing impact statement -> ImpactAssessmentShape fires.
# IA_RiskActive: identifies a real, still-InFlight lineage -> CrossLineageRiskAdvisoryShape fires.
# IA_RiskClosed: identifies an Achieved lineage -> stays silent.


changediscipli:Scope_Test a backlog:ScopeStatement .

changediscipli:CR_Bad a backlog:ChangeRequest ; backlog:requestsChangeTo changediscipli:Scope_Test ;
    backlog:hasChangeDirection backlog:Direction_Grow ; backlog:hasDisposition backlog:Disp_Pending .

changediscipli:CR_NoAssessment a backlog:ChangeRequest ; backlog:requestsChangeTo changediscipli:Scope_Test ;
    backlog:hasChangeDirection backlog:Direction_Grow ;
    backlog:hasChangeRequestRationale "Fixture-only." ; backlog:hasDisposition backlog:Disp_Accepted .

changediscipli:CR_NoScopeChange a backlog:ChangeRequest ; backlog:requestsChangeTo changediscipli:Scope_Test ;
    backlog:hasChangeDirection backlog:Direction_Grow ;
    backlog:hasChangeRequestRationale "Fixture-only." ; backlog:hasDisposition backlog:Disp_Accepted .
changediscipli:IA_NoScopeChange a backlog:ImpactAssessment ; backlog:analyzesRequest changediscipli:CR_NoScopeChange ;
    backlog:hasImpactStatement "Fixture-only: real assessment exists, no ScopeChange follows it." .

changediscipli:CR_Complete a backlog:ChangeRequest ; backlog:requestsChangeTo changediscipli:Scope_Test ;
    backlog:hasChangeDirection backlog:Direction_Grow ;
    backlog:hasChangeRequestRationale "Fixture-only." ; backlog:hasDisposition backlog:Disp_Accepted .
changediscipli:IA_Complete a backlog:ImpactAssessment ; backlog:analyzesRequest changediscipli:CR_Complete ;
    backlog:hasImpactStatement "Fixture-only: complete chain." .
changediscipli:SC_Complete a backlog:ScopeChange ; backlog:changesScope changediscipli:Scope_Test ;
    backlog:fulfillsRequest changediscipli:CR_Complete ;
    backlog:admitsItem changediscipli:W_Complete ; backlog:hasScopeChangeRationale "Fixture-only." ; backlog:decidedBy backlog:Owner .
changediscipli:W_Complete a backlog:Story .

changediscipli:IA_Bad a backlog:ImpactAssessment ; backlog:analyzesRequest changediscipli:CR_Complete .

changediscipli:Mis_Closed a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_Achieved .
changediscipli:L_Closed a backlog:Lineage ; backlog:lineageForMission changediscipli:Mis_Closed .
changediscipli:IA_RiskClosed a backlog:ImpactAssessment ; backlog:analyzesRequest changediscipli:CR_Complete ;
    backlog:hasImpactStatement "Fixture-only." ; backlog:identifiesAffectedLineage changediscipli:L_Closed .

changediscipli:Mis_Active a backlog:Mission ; backlog:hasMissionOutcome backlog:Out_InFlight .
changediscipli:L_Active a backlog:Lineage ; backlog:lineageForMission changediscipli:Mis_Active .
changediscipli:IA_RiskActive a backlog:ImpactAssessment ; backlog:analyzesRequest changediscipli:CR_Complete ;
    backlog:hasImpactStatement "Fixture-only." ; backlog:identifiesAffectedLineage changediscipli:L_Active .

