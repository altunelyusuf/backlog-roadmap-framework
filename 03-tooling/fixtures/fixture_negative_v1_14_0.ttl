<http://example.org/bpgap#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_ceremony_link_negative_v1_1_0.ttl (ceremonylinkne) ---
# fixture_ceremony_link_negative_v1_0_0.ttl — proves CeremonyLinkAdvisoryShape.
# Two reviews, each closing a story metricMovableBy names for a distinct
# objective, each with a fresh reading taken after the review: one names
# observedDuringCeremony (stays silent), one doesn't (fires). Structural
# pattern reused from fixture_measurement_due_v1_0_0.ttl, already proven.


ceremonylinkne:It_C a backlog:Iteration ; backlog:hasIdentifier "IT-C" ;
    backlog:iterationStart "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    backlog:iterationEnd "2026-06-14T00:00:00Z"^^xsd:dateTime .

ceremonylinkne:Plan_C a backlog:SprintPlanningCeremony ; backlog:ceremonyFor ceremonylinkne:It_C ;
    backlog:heldAt "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    backlog:includesPlanningEvent ceremonylinkne:PE_S1 , ceremonylinkne:PE_S2 .

ceremonylinkne:Goal_C a backlog:Goal ; rdfs:label "Fixture goal"@en ; backlog:decidedBy backlog:Owner .

# --- Case 1: reading present, but no observedDuringCeremony -> fires ---
ceremonylinkne:S1 a backlog:Story ; backlog:hasIdentifier "S-C1" ; backlog:hasState backlog:Done ; backlog:pursuesObjective ceremonylinkne:Obj1 .
ceremonylinkne:PE_S1 a backlog:PlanningEvent ; backlog:plansItem ceremonylinkne:S1 ; backlog:plannedInto ceremonylinkne:It_C ;
    backlog:plannedAt "2026-06-01T00:00:00Z"^^xsd:dateTime ; backlog:producesTask ceremonylinkne:T_S1 .
ceremonylinkne:T_S1 a backlog:ExecutionTask ; backlog:hasIdentifier "T-C1" ; backlog:hasState backlog:Done .
ceremonylinkne:Obj1 a backlog:Objective ; backlog:metricMovableBy ceremonylinkne:S1 ;
    backlog:contributesToGoal ceremonylinkne:Goal_C ; backlog:hasSuccessMetric ceremonylinkne:Metric_C1 ;
    backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 10.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase .
ceremonylinkne:Metric_C1 a ceremonylinkne:LocalMetric .
ceremonylinkne:Review_NoLink a backlog:SprintReviewCeremony ; backlog:ceremonyFor ceremonylinkne:It_C ;
    backlog:heldAt "2026-06-14T00:00:00Z"^^xsd:dateTime ; backlog:reviewsCeremony ceremonylinkne:Plan_C ;
    backlog:closesStory ceremonylinkne:S1 .
ceremonylinkne:MO_NoLink a backlog:MetricObservation ; backlog:observationFor ceremonylinkne:Obj1 ;
    backlog:observesMetric ceremonylinkne:Metric_C1 ; backlog:hasObservationMethod "Fixture-stated value, not re-derivable." ;
    backlog:observedAt "2026-06-15T00:00:00Z"^^xsd:dateTime ; backlog:hasObservedValue 5.0 .

# --- Case 2: reading present, observedDuringCeremony correctly links it -> stays silent ---
ceremonylinkne:S2 a backlog:Story ; backlog:hasIdentifier "S-C2" ; backlog:hasState backlog:Done ; backlog:pursuesObjective ceremonylinkne:Obj2 .
ceremonylinkne:PE_S2 a backlog:PlanningEvent ; backlog:plansItem ceremonylinkne:S2 ; backlog:plannedInto ceremonylinkne:It_C ;
    backlog:plannedAt "2026-06-01T00:00:00Z"^^xsd:dateTime ; backlog:producesTask ceremonylinkne:T_S2 .
ceremonylinkne:T_S2 a backlog:ExecutionTask ; backlog:hasIdentifier "T-C2" ; backlog:hasState backlog:Done .
ceremonylinkne:Obj2 a backlog:Objective ; backlog:metricMovableBy ceremonylinkne:S2 ;
    backlog:contributesToGoal ceremonylinkne:Goal_C ; backlog:hasSuccessMetric ceremonylinkne:Metric_C2 ;
    backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 10.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase .
ceremonylinkne:Metric_C2 a ceremonylinkne:LocalMetric .
ceremonylinkne:Review_Linked a backlog:SprintReviewCeremony ; backlog:ceremonyFor ceremonylinkne:It_C ;
    backlog:heldAt "2026-06-14T00:00:00Z"^^xsd:dateTime ; backlog:reviewsCeremony ceremonylinkne:Plan_C ;
    backlog:closesStory ceremonylinkne:S2 .
ceremonylinkne:MO_Linked a backlog:MetricObservation ; backlog:observationFor ceremonylinkne:Obj2 ;
    backlog:observesMetric ceremonylinkne:Metric_C2 ; backlog:hasObservationMethod "Fixture-stated value, not re-derivable." ;
    backlog:observedAt "2026-06-15T00:00:00Z"^^xsd:dateTime ; backlog:hasObservedValue 5.0 ;
    backlog:observedDuringCeremony ceremonylinkne:Review_Linked .

