# --- merged from fixture_finding_disposition_negative_v1_0_0.ttl (findingdisposi) ---
# fixture_finding_disposition_negative v1.0.0 -- NEGATIVE. One case per clause:
#  FR_Bare        no shape, no node, no disposition, no rationale, no decider
#  FR_Nonconf     dispositions a finding as Nonconformity (the default needs no record)
#  FR_KE_Unwatched  known error with no monitoring, no preventive mechanism, no review date
#  FR_Risk_Bare   accepted risk with no risk record, no monitoring, no review date
#  FR_Obs_Vague   observation whose rationale never says which rule is missing
#  FR_Stale       review date in the past
findingdisposi:N a backlog:Story ; backlog:hasIdentifier "S-N" ; backlog:hasState backlog:Done .
findingdisposi:FR_Bare a backlog:FindingRecord .
findingdisposi:FR_Nonconf a backlog:FindingRecord ; backlog:findingFromShape "X" ; backlog:findingOnNode findingdisposi:N ;
    backlog:hasFindingDisposition backlog:Disp_Nonconformity ; backlog:dispositionRationale "we will fix it" ; backlog:decidedBy backlog:Owner .
findingdisposi:FR_KE_Unwatched a backlog:FindingRecord ; backlog:findingFromShape "Y" ; backlog:findingOnNode findingdisposi:N ;
    backlog:hasFindingDisposition backlog:Disp_KnownError ; backlog:dispositionRationale "too late to fix" ; backlog:decidedBy backlog:Owner .
findingdisposi:FR_Risk_Bare a backlog:FindingRecord ; backlog:findingFromShape "Z" ; backlog:findingOnNode findingdisposi:N ;
    backlog:hasFindingDisposition backlog:Disp_RiskAccepted ; backlog:dispositionRationale "acceptable" ; backlog:decidedBy backlog:Owner .
findingdisposi:FR_Obs_Vague a backlog:FindingRecord ; backlog:findingFromShape "W" ; backlog:findingOnNode findingdisposi:N ;
    backlog:hasFindingDisposition backlog:Disp_Observation ; backlog:dispositionRationale "just noting it" ; backlog:decidedBy backlog:Owner ;
    backlog:monitoredBy "nothing" ; backlog:dispositionReviewDue "2027-01-01T00:00:00Z"^^xsd:dateTime .
findingdisposi:FR_Stale a backlog:FindingRecord ; backlog:findingFromShape "V" ; backlog:findingOnNode findingdisposi:N ;
    backlog:hasFindingDisposition backlog:Disp_KnownError ; backlog:dispositionRationale "old" ; backlog:decidedBy backlog:Owner ;
    backlog:monitoredBy "m" ; backlog:preventiveMechanism "p" ; backlog:dispositionReviewDue "2026-01-01T00:00:00Z"^^xsd:dateTime .
<http://example.org/finding-disposition-neg#> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_grooming_negative_v1_0_0.ttl (groomingnegati) ---
# Grooming fixture — a story is analysed against the concerns that apply.
#
# BRF-EP12. Source: Satzinger, Jackson & Burd ch.6 design activities,
# adopted as CONCERNS because the framework governs the register a
# method produces, not whether a team held a meeting.
#
#   A  declares two concerns, both addressed          -> passes
#   B  declares two, one addressed                    -> REJECTED
#   C  silent: neither concerns nor a statement       -> REJECTED
#   D  states that none applies, with a reason        -> passes
#   E  declares concerns AND says none applies        -> REJECTED
#
# C and D are the pair that matters. Before this rule they were
# identical in the data: a story that had never been groomed looked
# exactly like one that genuinely needed no design analysis. Saying
# so costs a sentence and makes the claim arguable.
#
# Adversarial: this fixture is deliberately minimal and fails other
# L3 clauses. It is named negative so the suite expects that; the
# grooming clauses are what it proves, and they fire on B, C and E
# and stay silent on A and D.

groomingnegati:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "grooming probe" ;
    backlog:governsBacklog groomingnegati:BL ; backlog:hasConformanceLevel backlog:L3_Governed ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "probe" ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .
groomingnegati:BL a backlog:Backlog ; backlog:hasIdentifier "BL-GROOM" ; backlog:hasState backlog:InProgress .
# A: declares concerns, all addressed -> must PASS
groomingnegati:A a backlog:Story ; backlog:hasIdentifier "S-A" ; backlog:hasState backlog:Ready ;
    backlog:memberOfContainer groomingnegati:BL ; backlog:notYetScoreable true ; backlog:hasScoreabilityReason "probe" ;
    backlog:hasApplicableConcern backlog:Concern_Data , backlog:Concern_Security .
groomingnegati:RA1 a backlog:RefinementEvent ; backlog:refines groomingnegati:A ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-20T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Schema extension agreed; no migration needed." ; backlog:refinedBy backlog:Builder .
groomingnegati:RA2 a backlog:RefinementEvent ; backlog:refines groomingnegati:A ;
    backlog:addressesConcern backlog:Concern_Security ;
    backlog:refinedAt "2026-08-20T09:30:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Authorisation unchanged; no new exposure." ; backlog:refinedBy backlog:Builder .
# B: declares a concern nobody addressed -> must FAIL
groomingnegati:B a backlog:Story ; backlog:hasIdentifier "S-B" ; backlog:hasState backlog:Ready ;
    backlog:memberOfContainer groomingnegati:BL ; backlog:notYetScoreable true ; backlog:hasScoreabilityReason "probe" ;
    backlog:hasApplicableConcern backlog:Concern_Data , backlog:Concern_Interaction .
groomingnegati:RB1 a backlog:RefinementEvent ; backlog:refines groomingnegati:B ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-20T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Schema agreed." ; backlog:refinedBy backlog:Builder .
# C: silent -> must FAIL
groomingnegati:C a backlog:Story ; backlog:hasIdentifier "S-C" ; backlog:hasState backlog:Ready ;
    backlog:memberOfContainer groomingnegati:BL ; backlog:notYetScoreable true ; backlog:hasScoreabilityReason "probe" .
# D: says none applies, with a reason -> must PASS
groomingnegati:D a backlog:Story ; backlog:hasIdentifier "S-D" ; backlog:hasState backlog:Ready ;
    backlog:memberOfContainer groomingnegati:BL ; backlog:notYetScoreable true ; backlog:hasScoreabilityReason "probe" ;
    backlog:hasNoApplicableConcern "Copy-only change to an existing label; no stored state, interface, interaction, structure or authorisation is touched." .
# E: contradicts itself -> must FAIL
groomingnegati:E a backlog:Story ; backlog:hasIdentifier "S-E" ; backlog:hasState backlog:Ready ;
    backlog:memberOfContainer groomingnegati:BL ; backlog:notYetScoreable true ; backlog:hasScoreabilityReason "probe" ;
    backlog:hasApplicableConcern backlog:Concern_Data ;
    backlog:hasNoApplicableConcern "None applies." .

