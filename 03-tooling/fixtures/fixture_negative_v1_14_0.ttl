# --- merged from fixture_failure_success_taxonomy_v1_1_0.ttl (failuresuccess) ---
# Failure-mode/success-mode taxonomy shapes — test drive, not a construction.
#
# Proves discrimination for the elegant replacement of G61's own original
# fixed-count threshold, plus the two new scope-conformance shapes the same
# taxonomy names (FM_ScopeCreep, FM_ScopeGap).
#
# IneffectiveCorrectiveAttemptAdvisoryShape (targets WorkItem):
#   W_Ineffective: closed, before/after observations bracket it, metric did
#     NOT improve -> fires.
#   W_Effective: closed, before/after observations bracket it, metric DID
#     improve -> silent.
#   W_NoObservations: closed, no observations at all -> silent (cannot judge
#     without data; never a false positive from missing evidence).
#
# ScopeCreepAdvisoryShape (targets Epic):
#   Epic_Creep: pursues an objective whose goal derives from no scope, and
#     no ScopeChange admits it -> fires.
#   Epic_InScope: goal derives from a real scope -> silent.
#   Epic_AdmittedByChange: goal derives from no scope, but a real ScopeChange
#     admits it explicitly -> silent (the honest G54 pattern).
#
# ScopeGapAdvisoryShape (targets ScopeStatement):
#   Scope_Gap: no goal derives from it -> fires.
#   Scope_Covered: a goal derives from it -> silent.


failuresuccess:Obj_A a backlog:Objective ; backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy failuresuccess:W_Ineffective .
failuresuccess:W_Ineffective a backlog:Story ; backlog:hasState backlog:Done ;
    backlog:startedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ; backlog:finishedAt "2026-01-10T00:00:00Z"^^xsd:dateTime .
failuresuccess:Obs_A_Before a backlog:MetricObservation ; backlog:observationFor failuresuccess:Obj_A ;
    backlog:hasObservedValue "10"^^xsd:decimal ; backlog:observedAt "2025-12-30T00:00:00Z"^^xsd:dateTime .
failuresuccess:Obs_A_After a backlog:MetricObservation ; backlog:observationFor failuresuccess:Obj_A ;
    backlog:hasObservedValue "10"^^xsd:decimal ; backlog:observedAt "2026-01-15T00:00:00Z"^^xsd:dateTime .

failuresuccess:Obj_B a backlog:Objective ; backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy failuresuccess:W_Effective .
failuresuccess:W_Effective a backlog:Story ; backlog:hasState backlog:Done ;
    backlog:startedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ; backlog:finishedAt "2026-01-10T00:00:00Z"^^xsd:dateTime .
failuresuccess:Obs_B_Before a backlog:MetricObservation ; backlog:observationFor failuresuccess:Obj_B ;
    backlog:hasObservedValue "10"^^xsd:decimal ; backlog:observedAt "2025-12-30T00:00:00Z"^^xsd:dateTime .
failuresuccess:Obs_B_After a backlog:MetricObservation ; backlog:observationFor failuresuccess:Obj_B ;
    backlog:hasObservedValue "2"^^xsd:decimal ; backlog:observedAt "2026-01-15T00:00:00Z"^^xsd:dateTime .

failuresuccess:Obj_C a backlog:Objective ; backlog:hasTargetValue "0"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:metricMovableBy failuresuccess:W_NoObservations .
failuresuccess:W_NoObservations a backlog:Story ; backlog:hasState backlog:Cancelled ;
    backlog:startedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ; backlog:finishedAt "2026-01-10T00:00:00Z"^^xsd:dateTime .

failuresuccess:Scope_A a backlog:ScopeStatement .
failuresuccess:Goal_InScope a backlog:Goal ; backlog:derivesFromScope failuresuccess:Scope_A .
failuresuccess:Obj_InScope a backlog:Objective ; backlog:contributesToGoal failuresuccess:Goal_InScope .
failuresuccess:Epic_InScope a backlog:Epic ; backlog:pursuesObjective failuresuccess:Obj_InScope .

failuresuccess:Goal_NoScope a backlog:Goal .
failuresuccess:Obj_Creep a backlog:Objective ; backlog:contributesToGoal failuresuccess:Goal_NoScope .
failuresuccess:Epic_Creep a backlog:Epic ; backlog:pursuesObjective failuresuccess:Obj_Creep .

failuresuccess:Goal_NoScope2 a backlog:Goal .
failuresuccess:Obj_Admitted a backlog:Objective ; backlog:contributesToGoal failuresuccess:Goal_NoScope2 .
failuresuccess:Epic_AdmittedByChange a backlog:Epic ; backlog:pursuesObjective failuresuccess:Obj_Admitted .
failuresuccess:SC_Real a backlog:ScopeChange ; backlog:admitsItem failuresuccess:Epic_AdmittedByChange .

failuresuccess:Scope_Gap a backlog:ScopeStatement .
failuresuccess:Scope_Covered a backlog:ScopeStatement .
failuresuccess:Goal_Covers a backlog:Goal ; backlog:derivesFromScope failuresuccess:Scope_Covered .

