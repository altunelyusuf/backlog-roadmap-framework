# DEFECT 20: container score averaged from members, and no rationale
ex:N015_Score a backlog:PriorityScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 4.0 ;
    backlog:isAveragedFromMembers true .

ex:N_Bag backlog:hasPriorityScore ex:N015_Score .

# DEFECT 21: dependency disclosed in prose but never made an edge
ex:N016 a backlog:Story ;
    backlog:hasIdentifier "N-016" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "placeholder" ;
    backlog:hasDependencyDisclosure ex:N_Disc .

ex:N_Disc a backlog:DependencyDisclosure ;
    backlog:disclosesDependencyOn ex:N012 ;
    backlog:hasDisclosureSource "'this only matters once N-012 exists' — said in review, never modelled." .

# DEFECT 22: superseded document with no forward pointer and no reason
ex:N_Doc a backlog:GovernedDocument ;
    rdfs:label "Old plan"@en ;
    backlog:hasDocumentStatus backlog:Superseded .

# DEFECT 23: report with no timestamp, no register, and missing sections
ex:N_Report a backlog:RoadmapReport ;
    backlog:hasSection backlog:Section_RankedBacklog .

# DEFECT 24: blueprint entity with no coverage and no recorded gap
ex:N_Entity a backlog:DomainEntity ;
    rdfs:label "Invoice"@en .

# DEFECT 25: code-verification claim with no note
ex:N017 a backlog:Task ;
    backlog:hasIdentifier "N-017" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "placeholder" ;
    backlog:verifiedAgainstCode true .

# DEFECT 26: blueprint gap with no reason and no entity
ex:N_Gap a backlog:BlueprintGap ;
    rdfs:label "something is missing"@en .

# DEFECT 27: methodology rule with no motivating incident
ex:N_Rule a backlog:MethodologyRule ;
    rdfs:label "Always do the right thing"@en ;
    backlog:hasRuleLogic "Do the right thing." ;
    backlog:closesDisagreement "Whether to do the right thing." .

# DEFECT 28: next-recommendation with no ranking model named
ex:N018 a backlog:Story ;
    backlog:hasIdentifier "N-018" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true ;
