# fixture_blueprint_gap, fixture_ceremony_link_negative, fixture_change_discipline,
# fixture_checkpoint_observed, fixture_closure_report, fixture_corrective_action,
# fixture_corrective_action_measured, fixture_executiontask_inherited,
