<http://example.org/fixture-negative#Profile> backlog:hasExpectedPolarity backlog:Polarity_Negative .
# v1.8.0 (2026-09-09): the manifest artifact still names no digest carrier -- RegisterArtifactShape's v1.109.0 clause must fire here.


# --- merged from fixture_adaptation_negative_v1_0_0.ttl (adaptneg) ---
# Adaptation gates — every control point defeated on purpose.
#
#   A1  reaches Re-link with no gate passed at all and no outcome
#   A2  claims the boundary holds while a finding says otherwise
#   A3  rewrites the boundary but names no new scope and no ScopeChange
#   G1  a gate marked passed whose observed result contradicts its expectation
#
# The last is the one that matters most: a gate reporting the verdict someone
# wanted rather than the one its own measurement supports.


adaptneg:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "Adaptation gate defeat fixture" ;
    backlog:governsBacklog adaptneg:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasTargetConformanceLevel backlog:L2_EvidenceBound ;
    backlog:hasLevelReviewDate "2027-01-01T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Core: this fixture defeats adaptation gates, which are L1 checks." ;
    backlog:adoptsFacet backlog:CoreFacet .

adaptneg:Backlog a backlog:Backlog ; backlog:hasIdentifier "BL-AN" ; backlog:hasState backlog:InProgress .
adaptneg:Scope a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "A boundary." ;
    backlog:scopeRealizesObjective adaptneg:O ;
    backlog:hasScopeExclusion adaptneg:X .
adaptneg:X a backlog:ScopeExclusion ; backlog:excludesConcern "Something." ;
    backlog:hasExclusionRationale "Reason." ; backlog:decidedBy backlog:Owner .
adaptneg:O a backlog:Objective ; rdfs:label "An objective"@en .
adaptneg:W a backlog:Story ; backlog:hasIdentifier "US-AN" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer adaptneg:Backlog ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "planted" .

# A1: straight to Re-link, no gates, no outcome
adaptneg:A1 a backlog:LineageAdaptation ;
    backlog:adaptsScope adaptneg:Scope ;
    backlog:hasAdaptationStage backlog:Stage_Relink .

# A2: claims the boundary holds while a finding contradicts it
adaptneg:A2 a backlog:LineageAdaptation ;
    backlog:adaptsScope adaptneg:Scope ;
    backlog:hasAdaptationStage backlog:Stage_Ruling ;
    backlog:hasAdaptationOutcome backlog:Adapt_BoundaryHolds .
adaptneg:F2 a backlog:FitGapFinding ;
    backlog:findingOf adaptneg:A2 ;
    backlog:findingItem adaptneg:W ;
    backlog:hasRationale "This item falls outside the boundary." .

# A3: rewrote the boundary, named no new scope, recorded no ScopeChange
adaptneg:A3 a backlog:LineageAdaptation ;
    backlog:adaptsScope adaptneg:Scope ;
    backlog:hasAdaptationStage backlog:Stage_Ruling ;
    backlog:hasAdaptationOutcome backlog:Adapt_BoundaryRewritten .

# G1: passed, but the measurement says otherwise
adaptneg:G1 a backlog:AdaptationGate ;
    backlog:gateFor adaptneg:A1 ;
    backlog:gatesStage backlog:Stage_Assess ;
    backlog:hasCheckQuery "ASK { ?s ?p ?o }" ;
    backlog:hasExpectedResult "clean" ;
    backlog:hasGateResult "4 problems found" ;
    backlog:gatePassed true .

<http://example.org/adapt-neg#Profile> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_backwards_lineage_negative_v1_0_0.ttl (bwneg) ---
# EXPERIMENT, shipped as a fixture: a lineage built entirely BACKWARDS.
#
# Epic first. Then an objective invented to justify it, a goal, a
# scope drawn round the goal, and a mission summarising the lot.
# EVERY LINK POINTS THE RIGHT WAY. Nothing is missing. Only the
# order of authorship is inverted.
#
# Before v1.84.0 this produced six violations and NOT ONE named the
# order — all six were missing DoD or investment category. That is
# the honest limit of link-direction: it proves an element could not
# have been written before its target EXISTED, never that the target
# was not invented to receive it.
#
# What the suite can catch is the SIGNATURE. This scope requires one
# deliverable satisfied by one item — a boundary that is its own
# backlog restated as intent. SingletonDeliverableShape rejects it.
#
# Deliberately named negative: it also fails on DoD and category,
# which is what an unplanned register looks like.


bwneg:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "backwards probe" ;
    backlog:governsBacklog bwneg:BL ; backlog:hasConformanceLevel backlog:L4_LineageEnforced ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "probe" ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .
bwneg:BL a backlog:Backlog ; backlog:hasIdentifier "BL-BWNEG" ; backlog:hasState backlog:InProgress ;
    backlog:hasScopeStatement bwneg:Scope .

# written FIFTH — a mission summarising work already chosen
bwneg:M a backlog:Mission ; backlog:hasMissionStatement "Whatever the epic below does." ;
    backlog:missionFor bwneg:BL ; backlog:hasMissionOrigin backlog:Origin_SessionDrafted ;
    backlog:decidedBy backlog:Owner .
# written FOURTH — a boundary drawn round the goal
bwneg:Scope a backlog:ScopeStatement ; backlog:hasScopeStatementText "Exactly what the epic delivers." ;
    backlog:scopeForMission bwneg:M ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:requiresDeliverable bwneg:Del ;
    backlog:hasScopeExclusion bwneg:X .
bwneg:Del a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "The epic below is complete." .
bwneg:X a backlog:ScopeExclusion ; backlog:excludesConcern "Anything else." ;
    backlog:hasExclusionRationale "Not needed." ; backlog:decidedBy backlog:Owner .
# written THIRD
bwneg:G a backlog:Goal ; rdfs:label "Do the epic"@en ;
    backlog:contributesToMission bwneg:M ; backlog:derivesFromScope bwneg:Scope ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ; backlog:decidedBy backlog:Owner .
# written SECOND — an objective invented to justify the epic
bwneg:Met a core:Metric ; rdfs:label "Epics done"@en .
bwneg:O a backlog:Objective ; rdfs:label "The epic is done"@en ;
    backlog:fillsScope bwneg:Scope ; backlog:contributesToGoal bwneg:G ;
    backlog:hasSuccessMetric bwneg:Met ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 1.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasObjectiveDeadline "2027-01-01T00:00:00"^^xsd:dateTime ;
    backlog:metricMovableBy bwneg:EP ; backlog:decidedBy backlog:Owner .
bwneg:Obs a backlog:MetricObservation ; backlog:observesMetric bwneg:Met ;
    backlog:observationFor bwneg:O ; backlog:hasObservedValue 1.0 ;
    backlog:observedAt "2026-08-25T09:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the epic." .
# written FIRST — the actual driver
bwneg:EP a backlog:Epic ; backlog:hasIdentifier "E-BWNEG-1" ; backlog:hasTitle "The thing we wanted to build" ;
    backlog:hasState backlog:Proposed ; backlog:memberOfContainer bwneg:BL ;
    backlog:pursuesObjective bwneg:O ; backlog:satisfiesDeliverable bwneg:Del ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "probe" ;
    backlog:decomposesInto bwneg:S1 .
bwneg:S1 a backlog:Story ; backlog:hasIdentifier "S-BWNEG-1" ; backlog:hasTitle "Do it" ;
    backlog:hasState backlog:Proposed ; backlog:memberOfContainer bwneg:BL ;
    backlog:pursuesObjective bwneg:O ; backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "probe" .

<http://example.org/bw#P> backlog:hasExpectedPolarity backlog:Polarity_Negative .

# --- merged from fixture_capacity_negative_v1_0_0.ttl (capneg) ---
# Iteration capacity and deployment membership — BRF-EP13.
#
#   IT-OVER  committed 20 against a capacity of 10   -> REJECTED at L3
#   IT-OK    committed 8 against 10                  -> silent
#   IT-SMUG  deployment carries an item the iteration
#            never planned                           -> REJECTED at L4
#   IT-BARE  no capacity declared                    -> ADVISORY
#
# IT-SMUG is the one worth having. A package shipped from an
# iteration is what that iteration committed to and finished;
# carrying work that entered by another route makes the iteration's
# record of itself untrue and cadence stops being measurable.


capneg:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "capacity fixture" ;
    backlog:governsBacklog capneg:BL ; backlog:hasConformanceLevel backlog:L4_LineageEnforced ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "L4: the deployment clause is L4." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .
capneg:BL a backlog:Backlog ; backlog:hasIdentifier "BL-CAP" ; backlog:hasState backlog:InProgress .

capneg:It_Over a backlog:Iteration ; backlog:hasIdentifier "IT-OVER" ; backlog:hasState backlog:InProgress ;
    backlog:iterationStart "2026-08-01T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2027-01-31T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 10.0 ; backlog:hasCommittedEffort 20.0 .

capneg:It_Ok a backlog:Iteration ; backlog:hasIdentifier "IT-OK" ; backlog:hasState backlog:InProgress ;
    backlog:iterationStart "2026-08-01T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2027-01-31T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 10.0 ; backlog:hasCommittedEffort 8.0 .

capneg:It_Bare a backlog:Iteration ; backlog:hasIdentifier "IT-BARE" ; backlog:hasState backlog:InProgress ;
    backlog:iterationStart "2026-08-01T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2027-01-31T23:59:59"^^xsd:dateTime .

capneg:It_Smug a backlog:Iteration ; backlog:hasIdentifier "IT-SMUG" ; backlog:hasState backlog:Done ;
    backlog:iterationStart "2026-07-01T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2026-07-14T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 10.0 ; backlog:hasCommittedEffort 8.0 .
capneg:S_Smug a backlog:Story ; backlog:hasIdentifier "S-SMUG" ; backlog:hasState backlog:Done ;
    backlog:memberOfContainer capneg:BL ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "planted" .
capneg:Rel_Smug a backlog:DeploymentUnit ; backlog:hasIdentifier "REL-SMUG" ;
    backlog:hasTitle "Carries what was never planned" ; backlog:hasState backlog:Done ;
    backlog:hasDeploymentDate "2026-07-15T09:00:00"^^xsd:dateTime ;
    backlog:deploysFrom capneg:It_Smug ; backlog:deploysItem capneg:S_Smug ;
    backlog:decidedBy backlog:Owner ; backlog:hasSelectionBasis backlog:Sel_Opportunistic .

<http://example.org/cap#P> backlog:hasExpectedPolarity backlog:Polarity_Negative .


# --- merged from fixture_checkpoint_condition_negative_v1_0_0.ttl (cpcond) ---
# fixture_checkpoint_condition_negative_v1_0_0.ttl — proves
# ObjectiveCheckpointTimingShape and confirms checkpointCondition works as
# a real alternative to checkpointDate, per code-abundance-rdodi's proposal
# (07-handover-inbox/accepted/... — this one is still pending review at
# the time this fixture was built, see the inbox log) grounded in G31: a
# checkpoint's timing is a condition, not a fabricated date, unless it is
# genuinely calendar-bound.


cpcond:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "Checkpoint condition negative fixture" ;
    backlog:governsBacklog cpcond:BL ; backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "L1: checkpoint timing structural fixture, L1 only." ;
    backlog:adoptsFacet backlog:CoreFacet ;
    backlog:hasExpectedPolarity backlog:Polarity_Negative .
cpcond:BL a backlog:Backlog ; backlog:hasIdentifier "BL-CPCONDNEG" ; backlog:hasState backlog:InProgress .

# CP_NoTiming — neither checkpointDate nor checkpointCondition -> fires.
cpcond:CP_NoTiming a backlog:ObjectiveCheckpoint ; backlog:expectedValue 10.0 .

# CP_Dated — a real, calendar-bound checkpoint -> must stay silent.
cpcond:CP_Dated a backlog:ObjectiveCheckpoint ; backlog:expectedValue 10.0 ;
    backlog:checkpointDate "2026-06-01T00:00:00Z"^^xsd:dateTime .

# CP_Conditional — a real, condition-bound checkpoint -> must stay silent,
# proving checkpointCondition genuinely satisfies the requirement, not
# just checkpointDate.
cpcond:WI_Gate a backlog:Story .
cpcond:CP_Conditional a backlog:ObjectiveCheckpoint ; backlog:expectedValue 10.0 ;
    backlog:checkpointCondition cpcond:WI_Gate .

# --- merged from fixture_conformance_goal_negative_v1_0_0.ttl (confgoal) ---
# fixture_conformance_goal_negative_v1_0_0.ttl — proves
# AdoptionConformanceGoalShape. Register-wide by design, matching the
# established pattern for "this register declares no Mission"-style
# checks: a single profile, a single graph, checked incrementally by
# adding exactly what each clause needs and re-testing before moving on
# (verified directly via SPARQL during authoring, not asserted). Kept to
# one profile deliberately -- multiple AdoptionProfiles in one graph
# would make every clause's own $this-independent register-wide check
# fire identically for all of them, which is correct behavior for a
# real, single-profile deployment but a misleading test shape.


confgoal:P_NoConformanceGoal a backlog:AdoptionProfile ; backlog:profileAppliesTo "No conformance goal case" ;
    backlog:governsBacklog confgoal:BL1 ; backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "L1: conformance-goal structural fixture." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet , backlog:InvariantFacet , backlog:AuditFacet ;
    backlog:hasExpectedPolarity backlog:Polarity_Negative .
confgoal:BL1 a backlog:Backlog ; backlog:hasIdentifier "BL-NOGOAL" ; backlog:hasState backlog:InProgress .

# Blueprint (G45/domain-modeling handover): register-level completeness only,
# no epic in this fixture decomposes, so no entity coverage needed.
confgoal:CBP a backlog:Blueprint ; backlog:blueprintFor confgoal:BL1 .
# v1.9.0 (2026-09-21, G99 pilot batch): merged five real, standalone one-off fixtures in --
# fixture_adaptation_negative, fixture_backwards_lineage_negative, fixture_capacity_negative,
# fixture_checkpoint_condition_negative, fixture_conformance_goal_negative -- each with its own
# distinct namespace prefix preserved to avoid any subject collision. Every real case reverified
# firing correctly after the merge; provenByFixture on the two shapes that named a dedicated file
# rewired to this one. One real, pre-existing finding surfaced along the way, not caused by this
# merge: SingletonDeliverableShape, named in the backwards-lineage fixture's own comment, does not
# actually fire on that fixture's content -- confirmed true in the original standalone file too,
# disclosed here rather than silently fixed, since it is a separate concern from consolidation.


# --- merged from fixture_blueprint_gap_v1_1_0.ttl (blueprintgap) ---
# Blueprint/domain-modeling enforcement gap — test drive, not a construction.
#
# Proves discrimination for the two new clauses added to LineageCompletenessShape
# (register declares no Blueprint) and EpicSpecifiedShape (epic decomposes covering
# no domain entity), proposed by the agentic-sdlc handover
# (07-handover-inbox/accepted) and built here at the same severity as the real
# precedent shapes they extend — Violation, matching Mission/Objective/ScopeStatement
# and matching EpicSpecifiedShape's own DoD/test-coverage clauses — not softened for
# convenience.
#
# EP_Neg: no Blueprint anywhere, decomposes with no coversEntity -> both new clauses fire.
# EP_Pos: a real Blueprint exists for the backlog, the epic covers a real entity -> silent.


# --- Negative case: BL_Neg carries no Blueprint; EP_Neg covers no entity ---
blueprintgap:BL_Neg a backlog:Backlog ; backlog:hasIdentifier "BL-NEG" ; backlog:hasState backlog:Proposed .
blueprintgap:EP_Neg a backlog:Epic ; backlog:hasIdentifier "E-NEG" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer blueprintgap:BL_Neg ; backlog:decomposesInto blueprintgap:S_Neg ;
    backlog:appliesDefinitionOfDone blueprintgap:DoD_BG ;
    backlog:hasAcceptanceCriterion blueprintgap:AC_Neg .
blueprintgap:AC_Neg a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given X, When Y, Then Z." ;
    backlog:satisfiedByArtifact "backlog:AcceptanceCriterion" ; backlog:coveredByCase blueprintgap:TC_Neg .
blueprintgap:TC_Neg a backlog:TestCase ; backlog:exercisesCriterion blueprintgap:AC_Neg ; backlog:runsOnData "Fixture-only." .
blueprintgap:S_Neg a backlog:Story ; backlog:hasIdentifier "S-NEG" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer blueprintgap:BL_Neg .
blueprintgap:DoD_BG a backlog:DefinitionOfDone .

# --- Positive case: BL_Pos carries a real Blueprint; EP_Pos covers a real entity ---
blueprintgap:BL_Pos a backlog:Backlog ; backlog:hasIdentifier "BL-POS" ; backlog:hasState backlog:Proposed .
blueprintgap:BP_Pos a backlog:Blueprint ; backlog:blueprintFor blueprintgap:BL_Pos .
blueprintgap:Ent_Client a backlog:DomainEntity .
blueprintgap:EP_Pos a backlog:Epic ; backlog:hasIdentifier "E-POS" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer blueprintgap:BL_Pos ; backlog:decomposesInto blueprintgap:S_Pos ;
    backlog:appliesDefinitionOfDone blueprintgap:DoD_BG ; backlog:coversEntity blueprintgap:Ent_Client ;
    backlog:hasAcceptanceCriterion blueprintgap:AC_Pos .
blueprintgap:AC_Pos a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given X, When Y, Then Z." ;
    backlog:satisfiedByArtifact "backlog:AcceptanceCriterion" ; backlog:coveredByCase blueprintgap:TC_Pos .
blueprintgap:TC_Pos a backlog:TestCase ; backlog:exercisesCriterion blueprintgap:AC_Pos ; backlog:runsOnData "Fixture-only." .
blueprintgap:S_Pos a backlog:Story ; backlog:hasIdentifier "S-POS" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer blueprintgap:BL_Pos .

# v1.1.0 (2026-09-07) -- expected polarity declared on the fixture itself (TBox v1.82.0
