    rdfs:label "The vendor may withdraw the API"@en .

# DEFECT 36: capacity policy whose shares do not sum to 1
ex:N_Policy a backlog:PortfolioPolicy ;
    backlog:policyFor ex:Backlog ;
    backlog:hasAllocation ex:N_Alloc1 , ex:N_Alloc2 .
