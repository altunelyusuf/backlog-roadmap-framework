# v1.11.0 (2026-09-21, G99 batch continued): merged six more -- fixture_l1_structural_batch_negative,
# fixture_lineage_compass_eligible, fixture_lineage_compass_ineffective,
# fixture_measurement_analysis_required, fixture_measurement_due, fixture_iteration_rebaseline --
# then six more -- fixture_modelartifact_negative, fixture_new_unproven_shape,
# fixture_ontologydriven_negative, fixture_package_regularity, fixture_pipeline_digestfail,
# fixture_productscopekind. A real, systemic gap found and fixed: renaming subject IRIs does not
# protect against colliding hasIdentifier STRING VALUES across merged fixtures -- three genuine,
# accidental collisions found (S-1, E-1, BL, each used by two unrelated merges) and fixed with
# distinguishing suffixes; the file's own pre-existing, intentional N-001 collision (DEFECT 6,
# proving the uniqueness shape itself fires) was checked and correctly left untouched.


# --- merged from fixture_registersession_integrity_v1_1_0.ttl (registersessio) ---
# RegisterSession completeness and integrity — test drive, not a construction.
#
# Two clauses proven here: (1) LineageCompletenessShape's new register-level
# clause -- a register with real content (a Mission or Blueprint) and no
# RegisterSession is a violation; (2) RegisterSessionIntegrityShape -- a
# session that changed items while stateVerifiedAtStart is false is a
# violation, closing the same "someone changed the backlog unattributably"
# gap RegisterSession's own real definition names.
#
# BL_Neg: real Mission, no RegisterSession at all -> register-level clause fires.
# BL_Pos: real Mission, a real, complete, verified RegisterSession -> silent.
# RS_Unverified: a session that changed an item with stateVerifiedAtStart false -> fires.


# --- Negative: real Mission, zero RegisterSession individuals ---
registersessio:BL_Neg a backlog:Backlog ; backlog:hasIdentifier "BL-NEG-RSI" ; backlog:hasState backlog:Proposed .
registersessio:M_Neg a backlog:Mission ; backlog:hasMissionStatement "Fixture-only." ; backlog:missionFor registersessio:BL_Neg ;
    backlog:decidedBy backlog:Owner .

# --- Positive: real Mission, a real, complete, verified RegisterSession ---
registersessio:BL_Pos a backlog:Backlog ; backlog:hasIdentifier "BL-POS-RSI" ; backlog:hasState backlog:Proposed .
registersessio:M_Pos a backlog:Mission ; backlog:hasMissionStatement "Fixture-only." ; backlog:missionFor registersessio:BL_Pos ;
    backlog:decidedBy backlog:Owner .
registersessio:S_Item a backlog:Story ; backlog:hasIdentifier "S-1" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer registersessio:BL_Pos .
registersessio:RS_Pos a backlog:RegisterSession ; backlog:sessionFor registersessio:BL_Pos ;
    backlog:sessionStartedAt "2026-09-03T00:00:00Z"^^xsd:dateTime ;
    backlog:stateVerifiedAtStart true ; backlog:changedItem registersessio:S_Item .

# --- Integrity negative: a session changed an item without verifying first ---
registersessio:RS_Unverified a backlog:RegisterSession ; backlog:sessionFor registersessio:BL_Pos ;
    backlog:sessionStartedAt "2026-09-03T00:00:00Z"^^xsd:dateTime ;
    backlog:stateVerifiedAtStart false ; backlog:changedItem registersessio:S_Item .

