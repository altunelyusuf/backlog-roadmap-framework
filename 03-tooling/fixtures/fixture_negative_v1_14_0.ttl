# Negative fixture: every block below plants ONE defect the suite must
# report at sh:Violation severity. The gate fails if any planted defect
# goes uncaught (L-95: a gate must be proven discriminating, and the
# proof is a fixture it fails, not a claim that it would).

ex:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "Negative fixture" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L3_Governed ;
    # DEFECT 1: claims L3 but adopts neither the Invariant nor the Audit facet
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .

ex:Backlog a backlog:Backlog ;
    backlog:hasIdentifier "BL-N" ;
    backlog:hasState backlog:InProgress .

# DEFECT 2: container with no members
ex:EmptyPackage a backlog:Package ;
    backlog:hasIdentifier "PKG-EMPTY" ;
    backlog:hasState backlog:Proposed .

# DEFECT 15: container asserted Done while a member is InProgress. This
# defect is only detectable if the R1 derivation rules actually executed,
# so it doubles as the proof that advanced mode is on (L-97: the
# discrimination mandate applies to the verifier's own checks too).
ex:OptimisticPackage a backlog:Package ;
    backlog:hasIdentifier "PKG-OPT" ;
    backlog:hasState backlog:Done .

ex:N011 a backlog:Task ;
    backlog:hasIdentifier "N-011" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer ex:Backlog , ex:OptimisticPackage .

# DEFECT 3: Done asserted with no evidence at all (L2)
ex:N001 a backlog:Story ;
    backlog:hasIdentifier "N-001" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:lastAuditedAt "2026-07-27T09:00:00"^^xsd:dateTime .

# DEFECT 4: Done with evidence that the bridge has not verified (L2)
ex:N002 a backlog:Story ;
    backlog:hasIdentifier "N-002" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasEvidence ex:N002_Test ;
    backlog:lastAuditedAt "2026-07-27T09:00:00"^^xsd:dateTime .

ex:N002_Test a backlog:TestEvidence ;
    backlog:hasTestSpec "e2e/tests/n002.spec.js" ;
    backlog:hasTestId "N002-001" ;
    backlog:evidenceVerified false .

# DEFECT 5: Done at L3 on review evidence alone
ex:N003 a backlog:Story ;
    backlog:hasIdentifier "N-003" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasEvidence ex:N003_Review ;
    backlog:lastAuditedAt "2026-07-27T09:00:00"^^xsd:dateTime .

ex:N003_Review a backlog:ReviewEvidence ;
    backlog:hasReviewer "product owner" ;
    backlog:hasReviewRecordRef "review-log/2026-07-24#item-N003" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-07-24T00:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "sign-off recorded in the review log" .

# DEFECT 6: identifier collision with N-001
ex:N004 a backlog:Task ;
    backlog:hasIdentifier "N-001" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog .

# DEFECT 7: dependency cycle
ex:N005 a backlog:Task ;
    backlog:hasIdentifier "N-005" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:dependsOn ex:N006 .

ex:N006 a backlog:Task ;
    backlog:hasIdentifier "N-006" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:dependsOn ex:N005 .

# DEFECT 8: on the roadmap but absent from any backlog register
ex:N007 a backlog:Feature ;
    backlog:hasIdentifier "N-007" ;
    backlog:hasState backlog:Proposed ;
    backlog:scheduledInHorizon backlog:Now .

# DEFECT 9: cancelled with no rationale
ex:N008 a backlog:Task ;
    backlog:hasIdentifier "N-008" ;
    backlog:hasState backlog:Cancelled ;
    backlog:memberOfContainer ex:Backlog .

# DEFECT 10: two live scores from the same method
ex:N009 a backlog:Task ;
    backlog:hasIdentifier "N-009" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasPriorityScore ex:N009_S1 , ex:N009_S2 .

ex:N009_S1 a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 3.0 .
ex:N009_S2 a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 9.0 .

# DEFECT 11: Definition-of-Done criterion with no executable check
ex:N_DoD a backlog:DefinitionOfDone ;
    rdfs:label "Local Definition of Done"@en ;
    backlog:hasDoDCriterion ex:N_DoD_C1 .

ex:N_DoD_C1 a backlog:DoDCriterion ;
    rdfs:label "Code is clean and well tested"@en .

# DEFECT 12: milestone with no contributing work and no target date
ex:N_MS a backlog:Milestone ;
    backlog:hasIdentifier "MS-N" ;
    backlog:hasTitle "Launch" .

# DEFECT 13: unenforceable invariant that names no tracking item
ex:N_Inv a backlog:CrossCuttingInvariant ;
    rdfs:label "All endpoints rate-limited"@en ;
    backlog:hasCheckQuery "ASK { ?e ex:rateLimited false }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasInvariantStatus backlog:NotYetEnforceable .

# DEFECT 14: release evidence with a malformed package hash
ex:N010 a backlog:Story ;
    backlog:hasIdentifier "N-010" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasEvidence ex:N010_Rel .

ex:N010_Rel a backlog:ReleaseEvidence ;
    backlog:hasReleaseVersion "0.1.0" ;
    backlog:hasPackageSHA256 "not-a-hash" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-07-27T09:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "asserted" .

