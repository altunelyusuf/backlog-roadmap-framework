@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/fixture-tied#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Tied launch gates plus a recorded fork resolution — the two cases an adopting
# project reported from real data. Three co-equal gates at priority 0: the earlier
# single-gate tie-break picked whichever local name sorted first and under-covered
# the real launch-blocking set. Also carries a recorded owner resolution of the
# throughput/launch-scoped fork, which must print BESIDE the disagreement.

ex:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "Tied-gate fixture" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasTargetConformanceLevel backlog:L2_EvidenceBound ;
    backlog:hasLevelReviewDate "2027-01-01T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Fixture profile: this fixture exercises tied launch gates and the recorded ranking-fork resolution, neither of which depends on evidence binding." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:PrioritizationFacet , backlog:RoadmapFacet , backlog:EvidenceFacet , backlog:InvariantFacet , backlog:AuditFacet .

ex:Backlog a backlog:Backlog ;
    backlog:hasIdentifier "BL-TIED" ; backlog:hasState backlog:Proposed ;
    backlog:hasRankingForkResolution backlog:LaunchScopedRanking ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Owner call: nothing ships before the three foundation gates clear, so launch scope governs pickup until they do." ;
    backlog:appliesDefinitionOfDone ex:DoD_Tied ; backlog:hasCommitment ex:Commit_Tied .
ex:DoD_Tied a backlog:DefinitionOfDone ; rdfs:label "Fixture DoD"@en .
ex:Commit_Tied a backlog:Commitment ; backlog:commitsToGoal ex:CGoal .
ex:Lin_Tied a backlog:Lineage ; backlog:lineageArchived false ; backlog:lineageForMission ex:CMission ; backlog:lineageOrdinal 1 .

ex:Roadmap a backlog:Roadmap ; backlog:roadmapOf ex:Backlog .

ex:GateAlpha a backlog:Package ;
    backlog:hasIdentifier "PKG-ALPHA" ; backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability true ; backlog:isLaunchGate true ;
    backlog:hasLaunchPriority 0 ; backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Co-equal launch precondition; no sequence against the other two." ;
    backlog:rankedOnRoadmap ex:Roadmap ; backlog:hasRoadmapRank 1 .

ex:GateBeta a backlog:Package ;
    backlog:hasIdentifier "PKG-BETA" ; backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability true ; backlog:isLaunchGate true ;
    backlog:hasLaunchPriority 0 ; backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Co-equal launch precondition." ;
    backlog:rankedOnRoadmap ex:Roadmap ; backlog:hasRoadmapRank 2 .

ex:GateZulu a backlog:Package ;
    backlog:hasIdentifier "PKG-ZULU" ; backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability true ; backlog:isLaunchGate true ;
    backlog:hasLaunchPriority 0 ; backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Co-equal launch precondition, alphabetically last — the case the old tie-break lost." ;
    backlog:rankedOnRoadmap ex:Roadmap ; backlog:hasRoadmapRank 3 .

# the highest-scoring startable work sits in the gate that sorts LAST by name
ex:InZulu a backlog:Story ;
    backlog:hasNoApplicableConcern "Fixture story: no stored state, interface, interaction, structure or authorisation is touched." ;
    backlog:hasIdentifier "US-ZULU" ; backlog:hasTitle "Work inside the last-sorting gate" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog , ex:GateZulu ;
    backlog:hasPriorityScore ex:ScoreZulu ;
    backlog:hasAcceptanceCriterion ex:Zulu_AC1 ; backlog:appliesDefinitionOfDone ex:DoD_Tied ;
    backlog:belongsToLineage ex:Lin_Tied ; backlog:pursuesObjective ex:CObjScope ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability .
ex:Zulu_AC1 a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given the last-sorting gate, When work completes, Then it is verified." ;
    backlog:satisfiedByArtifact "backlog:AcceptanceCriterion" .
ex:Ref_Zulu a backlog:RefinementEvent ; backlog:refines ex:InZulu ; backlog:refinedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Split criteria agreed, ready for sprint." .
ex:ScoreZulu a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 9.0 ;
    backlog:hasUserBusinessValue 8.0 ; backlog:hasTimeCriticality 6.0 ;
    backlog:hasRiskReductionValue 4.0 ; backlog:hasJobSize 2.0 .

ex:InAlpha a backlog:Story ;
    backlog:hasNoApplicableConcern "Fixture story: no stored state, interface, interaction, structure or authorisation is touched." ;
    backlog:hasIdentifier "US-ALPHA" ; backlog:hasTitle "Work inside the first-sorting gate" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog , ex:GateAlpha ;
    backlog:hasPriorityScore ex:ScoreAlpha ;
    backlog:hasAcceptanceCriterion ex:Alpha_AC1 ; backlog:appliesDefinitionOfDone ex:DoD_Tied ;
    backlog:belongsToLineage ex:Lin_Tied ; backlog:pursuesObjective ex:CObjContain ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability .
ex:Alpha_AC1 a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given the first-sorting gate, When work completes, Then it is verified." ;
    backlog:satisfiedByArtifact "backlog:AcceptanceCriterion" .
ex:Ref_Alpha a backlog:RefinementEvent ; backlog:refines ex:InAlpha ; backlog:refinedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Split criteria agreed, ready for sprint." .
ex:ScoreAlpha a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 2.0 ;
    backlog:hasUserBusinessValue 2.0 ; backlog:hasTimeCriticality 1.0 ;
    backlog:hasRiskReductionValue 1.0 ; backlog:hasJobSize 2.0 .

ex:InBeta a backlog:Task ;
    backlog:hasIdentifier "US-BETA" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog , ex:GateBeta ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Not yet separated from the surrounding platform work." ;
    backlog:appliesDefinitionOfDone ex:DoD_Tied ; backlog:belongsToLineage ex:Lin_Tied ;
    backlog:pursuesObjective ex:CObj ; backlog:hasInvestmentCategory backlog:Cat_NewCapability .

# work outside every gate, scoring highest overall -> throughput and launch-scoped disagree
ex:Outside a backlog:Story ;
    backlog:hasNoApplicableConcern "Fixture story: no stored state, interface, interaction, structure or authorisation is touched." ;
    backlog:hasIdentifier "US-OUT" ; backlog:hasTitle "Cheap high-value work outside every gate" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog , ex:PkgLater ;
    backlog:hasPriorityScore ex:ScoreOut ;
    backlog:hasAcceptanceCriterion ex:Out_AC1 ; backlog:appliesDefinitionOfDone ex:DoD_Tied ;
    backlog:belongsToLineage ex:Lin_Tied ; backlog:pursuesObjective ex:CObj ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability .
ex:Out_AC1 a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given the outside work, When it completes, Then it is verified." ;
    backlog:satisfiedByArtifact "backlog:AcceptanceCriterion" .
ex:Ref_Out a backlog:RefinementEvent ; backlog:refines ex:Outside ; backlog:refinedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Split criteria agreed, ready for sprint." .
ex:ScoreOut a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 12.0 ;
    backlog:hasUserBusinessValue 9.0 ; backlog:hasTimeCriticality 9.0 ;
    backlog:hasRiskReductionValue 6.0 ; backlog:hasJobSize 2.0 .
ex:PkgLater a backlog:Package ;
    backlog:hasIdentifier "PKG-LATER" ; backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability true .

<http://example.org/fixture-tied#Profile> backlog:hasExpectedPolarity backlog:Polarity_Positive .

ex:GateAlpha backlog:hasPackageVersion "1.0.0" ; backlog:targetsIteration ex:It_Pkg .

ex:GateBeta backlog:hasPackageVersion "1.0.0" ; backlog:targetsIteration ex:It_Pkg .

ex:GateZulu backlog:hasPackageVersion "1.0.0" ; backlog:targetsIteration ex:It_Pkg .

ex:PkgLater backlog:hasPackageVersion "1.0.0" ; backlog:targetsIteration ex:It_Pkg .

ex:It_Pkg a backlog:Iteration ; backlog:hasIdentifier "IT-PKG" ;
    backlog:hasState backlog:Proposed ;
    backlog:iterationStart "2026-08-01T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2026-08-14T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 9.0 ; backlog:hasCommittedEffort 0.0 .

# The iteration needs a member: an empty container is rejected, and
# inventing one to satisfy a package obligation would be the shape of
# defect this release exists to expose.
ex:InZulu backlog:memberOfContainer ex:It_Pkg .
# Conformance-goal pattern (G42/AdoptionConformanceGoalShape), self-contained,
# using this package's own already-proven Goal_BRSFConformance/Obj_BRSFConformanceHeld
# structure as the exact template rather than re-deriving requirements by trial.
ex:CMission a backlog:Mission ;
    backlog:hasMissionStatement "Fixture conformance-goal test mission." ;
    backlog:missionFor ex:Backlog ; backlog:hasMissionOrigin backlog:IOrigin_OwnerStated ;
    backlog:hasMissionOutcome backlog:Out_InFlight ; backlog:decidedBy backlog:Owner .
ex:CDel a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Fixture deliverable." ;
    backlog:derivesFromMissionClause "Fixture conformance-goal test mission." ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CScope a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Fixture conformance-goal test scope." ;
    backlog:scopeForMission ex:CMission ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:requiresDeliverable ex:CDel ; backlog:hasScopeExclusion ex:CExcl ;
    backlog:coversArea ex:CArea .
ex:CExcl a backlog:ScopeExclusion ; backlog:excludesConcern "Fixture-only exclusion." ;
    backlog:hasExclusionRationale "Fixture-only, not a real design decision." ; backlog:decidedBy backlog:Owner ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CArea a backlog:ScopeArea ; backlog:areaLocation "Fixture-only area, no real location." ;
    backlog:areaMeasure "0 real measure; fixture-only." ; backlog:hasScopeLayer backlog:Layer_Product .
ex:CGoal a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture conformance goal" ;
    backlog:isConformanceGoal true ; backlog:contributesToMission ex:CMission ;
    backlog:derivesFromScope ex:CScope ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCoversArea ex:CArea ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:decidedBy backlog:Owner .
ex:CGoalScope a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture scope-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CGoalContain a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture containment-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Containment ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CObjScope a backlog:Objective ; backlog:contributesToGoal ex:CGoalScope ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricScope ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricScope a ex:CLocalMetric .
ex:CObjContain a backlog:Objective ; backlog:contributesToGoal ex:CGoalContain ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricContain ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricContain a ex:CLocalMetric .
ex:CCPScope a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjScope backlog:hasCheckpoint ex:CCPScope ; backlog:metricMovableBy ex:InZulu .
ex:CObsScope a backlog:MetricObservation ; backlog:observesMetric ex:CMetricScope ; backlog:observationFor ex:CObjScope ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CCPContain a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjContain backlog:hasCheckpoint ex:CCPContain ; backlog:metricMovableBy ex:InAlpha .
ex:CObsContain a backlog:MetricObservation ; backlog:observesMetric ex:CMetricContain ; backlog:observationFor ex:CObjContain ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CObj a backlog:Objective ;
    backlog:contributesToGoal ex:CGoal ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetric ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetric a ex:CLocalMetric .
ex:CCP a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObj backlog:hasCheckpoint ex:CCP ; backlog:metricMovableBy ex:InBeta .
ex:CObs a backlog:MetricObservation ; backlog:observesMetric ex:CMetric ; backlog:observationFor ex:CObj ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
