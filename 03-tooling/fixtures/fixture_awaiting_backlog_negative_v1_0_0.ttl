@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/awaiting-backlog-neg#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# fixture_awaiting_backlog_negative v1.0.0 (backlog_lineage_order_check v1.10.0; an adopting project handover,
# lineage2-executed-without-backlog-stage). NEGATIVE. Minimal graph for the order check's witness-map mode (not a
# SHACL-complete register: only the lineage subgraph is built, so every other violation is the noise of a minimal graph).
#
#  Lin_Waiting   Mission..Objective closed in order, no Backlog output, NO item   AWAITING_BACKLOG  (v1.9.0 read it ORDERED and the run PASS)
#  Lin_Ordered   five outputs in order, items first appear after the Backlog output ORDERED (control)
#  Lin_Registered Mission..Objective closed, no Backlog output, an item registered after the fact   BYPASS (control: registering
#                 the executed work flips the same state from "nothing examined" to a recorded bypass)
# The witness map fixture_awaiting_backlog_negative_witness stands in for `git log -S` first-appearance commits.
ex:M a backlog:Mission .
ex:Lin_Waiting a backlog:Lineage ; rdfs:label "Lin_Waiting"@en ; backlog:lineageOrdinal 1 ; backlog:lineageArchived false .
ex:O_Lin_Waiting_Mission a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage ex:Lin_Waiting ; backlog:closedAtCommit "c1" ; backlog:hasStateDigest "dLin_WaitingMission" .
ex:O_Lin_Waiting_Scope a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Scope ; backlog:belongsToLineage ex:Lin_Waiting ; backlog:consumesOutput ex:O_Lin_Waiting_Mission ; backlog:closedAtCommit "c2" ; backlog:hasStateDigest "dLin_WaitingScope" .
ex:O_Lin_Waiting_Goal a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ; backlog:belongsToLineage ex:Lin_Waiting ; backlog:consumesOutput ex:O_Lin_Waiting_Scope ; backlog:closedAtCommit "c3" ; backlog:hasStateDigest "dLin_WaitingGoal" .
ex:O_Lin_Waiting_Objective a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Objective ; backlog:belongsToLineage ex:Lin_Waiting ; backlog:consumesOutput ex:O_Lin_Waiting_Goal ; backlog:closedAtCommit "c4" ; backlog:hasStateDigest "dLin_WaitingObjective" .
ex:Lin_Ordered a backlog:Lineage ; rdfs:label "Lin_Ordered"@en ; backlog:lineageOrdinal 2 ; backlog:lineageArchived false .
ex:O_Lin_Ordered_Mission a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage ex:Lin_Ordered ; backlog:closedAtCommit "c1" ; backlog:hasStateDigest "dLin_OrderedMission" .
ex:O_Lin_Ordered_Scope a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Scope ; backlog:belongsToLineage ex:Lin_Ordered ; backlog:consumesOutput ex:O_Lin_Ordered_Mission ; backlog:closedAtCommit "c2" ; backlog:hasStateDigest "dLin_OrderedScope" .
ex:O_Lin_Ordered_Goal a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ; backlog:belongsToLineage ex:Lin_Ordered ; backlog:consumesOutput ex:O_Lin_Ordered_Scope ; backlog:closedAtCommit "c3" ; backlog:hasStateDigest "dLin_OrderedGoal" .
ex:O_Lin_Ordered_Objective a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Objective ; backlog:belongsToLineage ex:Lin_Ordered ; backlog:consumesOutput ex:O_Lin_Ordered_Goal ; backlog:closedAtCommit "c4" ; backlog:hasStateDigest "dLin_OrderedObjective" .
ex:O_Lin_Ordered_Backlog a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Backlog ; backlog:belongsToLineage ex:Lin_Ordered ; backlog:consumesOutput ex:O_Lin_Ordered_Objective ; backlog:closedAtCommit "c5" ; backlog:hasStateDigest "dLin_OrderedBacklog" .
ex:S_Ord a backlog:Story ; backlog:hasIdentifier "S-ORD" ; backlog:hasState backlog:Ready ; backlog:belongsToLineage ex:Lin_Ordered .
ex:Lin_Registered a backlog:Lineage ; rdfs:label "Lin_Registered"@en ; backlog:lineageOrdinal 3 ; backlog:lineageArchived false .
ex:O_Lin_Registered_Mission a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Mission ; backlog:belongsToLineage ex:Lin_Registered ; backlog:closedAtCommit "c1" ; backlog:hasStateDigest "dLin_RegisteredMission" .
ex:O_Lin_Registered_Scope a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Scope ; backlog:belongsToLineage ex:Lin_Registered ; backlog:consumesOutput ex:O_Lin_Registered_Mission ; backlog:closedAtCommit "c2" ; backlog:hasStateDigest "dLin_RegisteredScope" .
ex:O_Lin_Registered_Goal a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ; backlog:belongsToLineage ex:Lin_Registered ; backlog:consumesOutput ex:O_Lin_Registered_Scope ; backlog:closedAtCommit "c3" ; backlog:hasStateDigest "dLin_RegisteredGoal" .
ex:O_Lin_Registered_Objective a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Objective ; backlog:belongsToLineage ex:Lin_Registered ; backlog:consumesOutput ex:O_Lin_Registered_Goal ; backlog:closedAtCommit "c4" ; backlog:hasStateDigest "dLin_RegisteredObjective" .
ex:S_Late a backlog:Story ; backlog:hasIdentifier "S-LATE" ; backlog:hasState backlog:Done ; backlog:belongsToLineage ex:Lin_Registered .

<http://example.org/awaiting-backlog-neg#> backlog:hasExpectedPolarity backlog:Polarity_Negative .
