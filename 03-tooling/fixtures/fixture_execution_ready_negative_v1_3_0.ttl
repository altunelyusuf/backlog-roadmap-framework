ex:O_Lin_Ready_Objective a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Objective ; backlog:belongsToLineage ex:Lin_Ready ; backlog:consumesOutput ex:O_Lin_Ready_Goal ; backlog:closedAtCommit "c" ; backlog:hasStateDigest "dLin_ReadyObjective" .
ex:O_Lin_Ready_Backlog a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Backlog ; backlog:belongsToLineage ex:Lin_Ready ; backlog:consumesOutput ex:O_Lin_Ready_Objective ; backlog:closedAtCommit "c" ; backlog:hasStateDigest "dLin_ReadyBacklog" .
ex:S_Groomed a backlog:Story ; backlog:hasIdentifier "S_Groomed" ; backlog:hasState backlog:Ready ; backlog:belongsToLineage ex:Lin_Ready ; backlog:hasAcceptanceCriterion ex:AC_S_Groomed ; backlog:hasNoApplicableConcern "None applies: fixture." .
ex:AC_S_Groomed a backlog:AcceptanceCriterion .
ex:PE_S_Groomed a backlog:PlanningEvent ; backlog:plansItem ex:S_Groomed .
ex:S_NoCriterion a backlog:Story ; backlog:hasIdentifier "S_NoCriterion" ; backlog:hasState backlog:Ready ; backlog:belongsToLineage ex:Lin_Ready ; backlog:hasNoApplicableConcern "None applies: fixture." .
