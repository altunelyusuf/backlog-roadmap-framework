# Lineage pipeline — stages built in order, each consuming the last.
#
# Experiment A of the v1.85.0 investigation. Every digest reproduces
# and the chain is a line. Shipped so the passing shape is on record
# alongside the failing one.
#
@prefix backlog: <http://example.org/backlog#> .
@prefix core: <http://example.org/core#> .
@prefix ex: <http://example.org/pl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:BL a backlog:Backlog ; backlog:hasIdentifier "BL-PL" ; backlog:hasState backlog:Proposed ;
    backlog:hasScopeStatement ex:Scope .
ex:P a backlog:AdoptionProfile ; backlog:profileAppliesTo "pipeline fixture" ;
    backlog:governsBacklog ex:BL ; backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasTargetConformanceLevel backlog:L2_EvidenceBound ;
    backlog:hasLevelReviewDate "2027-01-01T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ; backlog:hasDecisionRationale "Core: the pipeline clauses are L1/L2." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet , backlog:InvariantFacet , backlog:AuditFacet .

ex:M a backlog:Mission ; backlog:hasMissionStatement "Practitioners recover unaided." ;
    backlog:missionFor ex:BL ; backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Owner, 2026-08-25" ; backlog:decidedBy backlog:Owner ;
    backlog:hasMissionOutcome backlog:Out_InFlight .
ex:Scope a backlog:ScopeStatement ; backlog:hasScopeStatementText "Self-service recovery." ;
    backlog:scopeForMission ex:M ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:requiresDeliverable ex:D1 , ex:D2 ; backlog:hasScopeExclusion ex:X ;
    backlog:coversArea ex:Area_PL .
ex:Area_PL a backlog:ScopeArea ; backlog:areaLocation "Practitioner recovery flow." ;
    backlog:areaMeasure "2 deliverables, counted." ; backlog:hasScopeLayer backlog:Layer_Product .
ex:D1 a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Recovery completes unaided." ; backlog:hasScopeLayer backlog:Layer_Product .
ex:D2 a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Every recovery is auditable." ; backlog:hasScopeLayer backlog:Layer_Product .
ex:X a backlog:ScopeExclusion ; backlog:excludesConcern "Admin recovery." ;
    backlog:hasExclusionRationale "Different threat model." ; backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Product .
ex:G a backlog:Goal ; rdfs:label "Self-service recovery"@en ;
    backlog:contributesToMission ex:M ; backlog:derivesFromScope ex:Scope ;
    backlog:hasGoalFacing backlog:Facing_Mission ; backlog:goalCoversArea ex:Area_PL ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
ex:GScope a backlog:Goal ; rdfs:label "Fixture scope-facing goal"@en ;
    backlog:contributesToMission ex:M ; backlog:derivesFromScope ex:Scope ;
    backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea ex:Area_PL ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
ex:GContain a backlog:Goal ; rdfs:label "Fixture containment-facing goal"@en ;
    backlog:contributesToMission ex:M ; backlog:derivesFromScope ex:Scope ;
    backlog:hasGoalFacing backlog:Facing_Containment ; backlog:goalCoversArea ex:Area_PL ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
ex:OScope a backlog:Objective ; backlog:contributesToGoal ex:GScope ; backlog:fillsScope ex:Scope ;
    backlog:hasSuccessMetric ex:MetScope ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
ex:MetScope a core:Metric .
ex:CPOScope a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^xsd:dateTime .
ex:OScope backlog:hasCheckpoint ex:CPOScope .
ex:ObsOScope a backlog:MetricObservation ; backlog:observesMetric ex:MetScope ; backlog:observationFor ex:OScope ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:OContain a backlog:Objective ; backlog:contributesToGoal ex:GContain ; backlog:fillsScope ex:Scope ;
    backlog:hasSuccessMetric ex:MetContain ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
ex:MetContain a core:Metric .
ex:CPOContain a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^xsd:dateTime .
ex:OContain backlog:hasCheckpoint ex:CPOContain .
ex:ObsOContain a backlog:MetricObservation ; backlog:observesMetric ex:MetContain ; backlog:observationFor ex:OContain ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:Met a core:Metric ; rdfs:label "Unaided share"@en .
ex:O a backlog:Objective ; rdfs:label "Recoveries need no support"@en ;
    backlog:fillsScope ex:Scope ; backlog:contributesToGoal ex:G ;
    backlog:hasSuccessMetric ex:Met ; backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:hasBaselineValue 12.0 ; backlog:hasTargetValue 80.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:metricMovableBy ex:EP ;
    backlog:hasObjectiveDeadline "2027-01-31T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .
ex:CP_O a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^xsd:dateTime .
ex:O backlog:hasCheckpoint ex:CP_O .
ex:Obs_O a backlog:MetricObservation ; backlog:observesMetric ex:Met ; backlog:observationFor ex:O ;
    backlog:hasObservedValue 12.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^xsd:dateTime ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:EP a backlog:Epic ; backlog:hasIdentifier "E-1" ; backlog:hasTitle "Recovery" ;
    backlog:hasState backlog:Proposed ; backlog:memberOfContainer ex:BL ;
    backlog:pursuesObjective ex:O ; backlog:satisfiesDeliverable ex:D1 ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "probe" ;
    backlog:appliesDefinitionOfDone ex:DoD_PL ; backlog:belongsToLineage ex:Lin_PL ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ; backlog:decomposesInto ex:S_PL .
ex:DoD_PL a backlog:DefinitionOfDone ; rdfs:label "Fixture DoD"@en .
ex:Lin_PL a backlog:Lineage ; backlog:lineageArchived false ; backlog:lineageForMission ex:M ; backlog:lineageOrdinal 1 .
ex:S_PL a backlog:Story ; backlog:hasIdentifier "S-PL" ; backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:BL ; backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at next planning." ;
    backlog:belongsToLineage ex:Lin_PL ; backlog:hasInvestmentCategory backlog:Cat_NewCapability .

ex:BL backlog:appliesDefinitionOfDone ex:DoD_PL ; backlog:hasCommitment ex:Commit_PL .
ex:Commit_PL a backlog:Commitment ; backlog:commitsToGoal ex:G .

ex:Out_Mission a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Mission ;
    backlog:hasStateDigest "0673ef35ece4a94fd7660a3d627ef227dc4ef0265984f26a8e619f9321271b12" ; backlog:closedAtCommit "fixture-only-1" .
ex:Out_Scope a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Scope ;
    backlog:hasStateDigest "4c4aa275c4b9233a1beaec7082590ccee071b0c558a4f7813229897919338aa0" ; backlog:consumesOutput ex:Out_Mission ; backlog:closedAtCommit "fixture-only-2" .
ex:Out_Goal a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ;
    backlog:hasStateDigest "2338e14e2523cbeef7cde24e2231eafead99416d1948cb9065c31693a61addb2" ; backlog:consumesOutput ex:Out_Scope ; backlog:closedAtCommit "fixture-only-3" .
ex:Out_Objective a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Objective ;
    backlog:hasStateDigest "59ab60ab34b41fe7f6f9e4a7a2d64d77b1a8820aa5c3408b2e275728fdde7310" ; backlog:consumesOutput ex:Out_Goal ; backlog:closedAtCommit "fixture-only-4" .
ex:Out_Backlog a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Backlog ;
    backlog:hasStateDigest "86899232373fc5e86f0f00cdb4cd82a36e86e317caa1e076896be8b8a058fd6c" ; backlog:consumesOutput ex:Out_Objective ; backlog:closedAtCommit "fixture-only-5" .

ex:D1 backlog:derivesFromMissionClause "practitioners recover unaided" .

ex:D2 backlog:derivesFromMissionClause "practitioners recover unaided" .

<http://example.org/pl#P> backlog:hasExpectedPolarity backlog:Polarity_Positive .
# Conformance-goal pattern (G42/AdoptionConformanceGoalShape), self-contained,
# using this package's own already-proven Goal_BRSFConformance/Obj_BRSFConformanceHeld
# structure as the exact template rather than re-deriving requirements by trial.
ex:CMission a backlog:Mission ;
    backlog:hasMissionStatement "Fixture conformance-goal test mission." ;
    backlog:missionFor ex:BL ; backlog:hasMissionOrigin backlog:IOrigin_OwnerStated ;
    backlog:hasMissionOutcome backlog:Out_InFlight ; backlog:decidedBy backlog:Owner .
ex:CDel a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Fixture deliverable." ;
    backlog:derivesFromMissionClause "Fixture conformance-goal test mission." ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CScope a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Fixture conformance-goal test scope." ;
    backlog:scopeForMission ex:CMission ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:requiresDeliverable ex:CDel ; backlog:hasScopeExclusion ex:CExcl ;
    backlog:coversArea ex:CArea .
ex:CExcl a backlog:ScopeExclusion ; backlog:excludesConcern "Fixture-only exclusion." ;
    backlog:hasExclusionRationale "Fixture-only, not a real design decision." ; backlog:decidedBy backlog:Owner ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CArea a backlog:ScopeArea ; backlog:areaLocation "Fixture-only area, no real location." ;
    backlog:areaMeasure "0 real measure; fixture-only." ; backlog:hasScopeLayer backlog:Layer_Product .
ex:CGoal a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture conformance goal" ;
    backlog:isConformanceGoal true ; backlog:contributesToMission ex:CMission ;
    backlog:derivesFromScope ex:CScope ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCoversArea ex:CArea ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:decidedBy backlog:Owner .
ex:CGoalScope a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture scope-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CGoalContain a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture containment-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Containment ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CObjScope a backlog:Objective ; backlog:contributesToGoal ex:CGoalScope ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricScope ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricScope a ex:CLocalMetric .
ex:CObjContain a backlog:Objective ; backlog:contributesToGoal ex:CGoalContain ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricContain ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricContain a ex:CLocalMetric .
ex:CCPScope a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjScope backlog:hasCheckpoint ex:CCPScope .
ex:CObsScope a backlog:MetricObservation ; backlog:observesMetric ex:CMetricScope ; backlog:observationFor ex:CObjScope ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CCPContain a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjContain backlog:hasCheckpoint ex:CCPContain .
ex:CObsContain a backlog:MetricObservation ; backlog:observesMetric ex:CMetricContain ; backlog:observationFor ex:CObjContain ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CObj a backlog:Objective ;
    backlog:contributesToGoal ex:CGoal ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetric ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetric a ex:CLocalMetric .
ex:CCP a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObj backlog:hasCheckpoint ex:CCP .
ex:CObs a backlog:MetricObservation ; backlog:observesMetric ex:CMetric ; backlog:observationFor ex:CObj ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .

# Blueprint (G45/domain-modeling handover): register-level completeness plus
# the epic's own domain-entity coverage, swept across all 4 lifecycle stages
# (1 real coverage from the epic itself, 3 gaps -- matching the framework's
# own real usage in fixture_positive_v1_7_0, not invented for this fixture).
ex:CBP a backlog:Blueprint ; backlog:blueprintFor ex:BL .
ex:CEntity a backlog:DomainEntity .
ex:EP backlog:coversEntity ex:CEntity ; backlog:coversStage backlog:Stage_ActiveUse .
ex:CGap1 a backlog:BlueprintGap ; backlog:gapForEntity ex:CEntity ; backlog:gapForStage backlog:Stage_Creation ;
    backlog:hasGapReason "Fixture-only: creation stage not modeled." .
ex:CGap2 a backlog:BlueprintGap ; backlog:gapForEntity ex:CEntity ; backlog:gapForStage backlog:Stage_SuspensionException ;
    backlog:hasGapReason "Fixture-only: suspension/exception stage not modeled." .
ex:CGap3 a backlog:BlueprintGap ; backlog:gapForEntity ex:CEntity ; backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "Fixture-only: termination stage not modeled." .
