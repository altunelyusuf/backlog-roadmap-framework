# fixture_readiness_and_refined v1.0.0 -- NEGATIVE. Proves ReadinessGateShape's real, unchanged
# behavior once Refined exists, and that the two shapes which already referenced backlog:Refined
# (dead code before this) now genuinely fire.
#
# S_ReadyBad     claims Ready with neither acceptance criteria nor a refinement event ->
#                ReadinessGateShape must still fire, exactly as before Refined existed.
# S_RefinedOnly  Refined (tasks decomposed), never claimed Ready -> ReadinessGateShape must NOT
#                fire on it; it never made the claim Ready makes.
# S_ReadyGood    genuinely Ready, with both a real acceptance criterion and a real refinement
#                event -> stays silent under ReadinessGateShape, same as always.
# L_Lagging (repurposed context) exercises InProgressNeedsStartedWorkShape's own real use of
#                Refined: an item in that state must now correctly count as "not yet started".

@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/readiness-refined#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

ex:L a backlog:Lineage ; backlog:lineageOrdinal 1 ; backlog:lineageArchived false ;
    backlog:hasLineageStatus backlog:LS_InProgress .

ex:S_ReadyBad a backlog:Story ; backlog:hasIdentifier "S-RDYBAD" ; backlog:hasState backlog:Ready ;
    backlog:belongsToLineage ex:L .

ex:S_RefinedOnly a backlog:Story ; backlog:hasIdentifier "S-REFONLY" ; backlog:hasState backlog:Refined ;
    backlog:belongsToLineage ex:L .
ex:T_RefinedOnly a backlog:ExecutionTask ; backlog:hasIdentifier "T-REFONLY" ; backlog:hasState backlog:Proposed ;
    backlog:belongsToLineage ex:L .
ex:S_RefinedOnly backlog:decomposesInto ex:T_RefinedOnly .

ex:S_ReadyGood a backlog:Story ; backlog:hasIdentifier "S-RDYGOOD" ; backlog:hasState backlog:Ready ;
    backlog:belongsToLineage ex:L ; backlog:hasAcceptanceCriterion ex:AC_Good .
ex:AC_Good a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given/when/then, fixture only." .
ex:RE_Good a backlog:RefinementEvent ; backlog:refines ex:S_ReadyGood ;
    backlog:refinedAt "2026-09-17T00:00:00Z"^^xsd:dateTime ; backlog:hasRefinementOutcome "Fixture-only refinement." .

<http://example.org/readiness-refined#> backlog:hasExpectedPolarity backlog:Polarity_Negative .
ex:Reg a backlog:Backlog ; rdfs:label "fixture register"@en ; backlog:isRegisterRoot true ;
    backlog:adoptsRuleSet backlog:RS_LineageStatus .
