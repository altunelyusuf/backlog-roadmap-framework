    backlog:hasTransition ex:N_T1 .
ex:N_T1 a backlog:StateTransition ;
    backlog:fromState backlog:Proposed ; backlog:toState backlog:Ready ;
    backlog:hasTransitionGuard "ASK { }" .

# DEFECT 42: transition that leaves and enters the same state, and has no guard
ex:N_T2 a backlog:StateTransition ;
