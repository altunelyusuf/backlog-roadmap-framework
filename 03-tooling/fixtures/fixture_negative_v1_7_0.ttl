ex:N025 a backlog:Story ;
    backlog:hasIdentifier "N-025" ; backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasAcceptanceCriterion ex:N025_AC ;
    backlog:hasEvidence ex:N025_Ev ;
    backlog:lastAuditedAt "2026-07-27T09:00:00"^^xsd:dateTime .
ex:N025_AC a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given something, When something, Then something." .
ex:N025_Ev a backlog:TestEvidence ;
    backlog:hasTestSpec "e2e/n025.spec.js" ; backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-07-27T09:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "asserted for the fixture" .
ex:N025_Move a backlog:TransitionEvent ;
    backlog:transitionedItem ex:N025 ; backlog:viaTransition backlog:T_Refine ;
    backlog:transitionedAt "2026-07-26T09:00:00"^^xsd:dateTime .

