    backlog:hasArtifactRole backlog:Role_Manifest ;
    backlog:hasArtifactFileName "MANIFEST.txt" .
ex:N_PA4 a backlog:RegisterArtifact ;
    backlog:hasArtifactRole backlog:Role_RegisterData ;
    backlog:hasArtifactFileName "data.ttl" .

#################################################################
#  shapes v1.8.0 planted defects (65-66) — launch priority without
#  a launch gate, in both capability polarities
#################################################################

# DEFECT 65: non-capability, NOT a launch gate, carrying a launch priority
ex:N_PkgOrphanPriority a backlog:Package ;
    backlog:hasIdentifier "PKG-ORPH" ; backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability false ;
    backlog:hasLaunchPriority 4 .
ex:N036 a backlog:Task ;
    backlog:hasIdentifier "N-036" ; backlog:hasState backlog:Proposed ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "placeholder" ;
    backlog:memberOfContainer ex:Backlog , ex:N_PkgOrphanPriority .

# DEFECT 66: business capability, NOT a launch gate, carrying a launch priority.
# Nothing in shapes 1.7.0 caught this: the superseded constraint only looked at
# containers tagged NOT a business capability.
ex:N_PkgCapPriority a backlog:Package ;
    backlog:hasIdentifier "PKG-CAPP" ; backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability true ;
    backlog:hasLaunchPriority 5 .
ex:N037 a backlog:Task ;
    backlog:hasIdentifier "N-037" ; backlog:hasState backlog:Proposed ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "placeholder" ;
    backlog:memberOfContainer ex:Backlog , ex:N_PkgCapPriority .

#################################################################
#  shapes v1.11.0 planted defects (67-68) — the adopter's case
#################################################################

# DEFECT 67: Done fix for a still-NotYetEnforceable invariant, no evidence
ex:N_InvBroken a backlog:CrossCuttingInvariant ;
    rdfs:label "Transition dispatcher reaches every handler"@en ;
    backlog:hasCheckQuery "ASK { ?t ex:dispatchedVia ex:Dispatcher }" ;
    backlog:hasExpectedResult "true" ;
    backlog:hasInvariantStatus backlog:NotYetEnforceable ;
    backlog:tracksItem ex:N038 .
ex:N038 a backlog:Story ;
    backlog:hasIdentifier "N-038" ; backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasAcceptanceCriterion ex:N038_AC ;
    backlog:lastAuditedAt "2026-08-04T09:00:00"^^xsd:dateTime .
ex:N038_AC a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a broken dispatcher, When a transition is requested, Then every registered handler receives it." .

# DEFECT 68: enabling work Done, invariant left NotYetEnforceable (stale status)
ex:N_InvStale a backlog:CrossCuttingInvariant ;
    rdfs:label "Token award reaches exactly one implementation"@en ;
    backlog:hasCheckQuery "ASK { ?a ex:awardedBy ?impl }" ;
    backlog:hasExpectedResult "true" ;
    backlog:hasInvariantStatus backlog:NotYetEnforceable ;
    backlog:tracksItem ex:N039 .
ex:N039 a backlog:Task ;
    backlog:hasIdentifier "N-039" ; backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasAcceptanceCriterion ex:N039_AC ;
    backlog:hasEvidence ex:N039_Ev ;
    backlog:lastAuditedAt "2026-08-04T09:00:00"^^xsd:dateTime .
ex:N039_AC a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given three award paths, When a task completes, Then exactly one implementation awards tokens." .
ex:N039_Ev a backlog:TestEvidence ;
    backlog:hasTestSpec "e2e/tests/award-single-path.spec.js" ; backlog:hasTestId "AW-1" ;
    backlog:evidenceVerified true ; backlog:verifiedAt "2026-08-04T09:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "playwright test --grep AW-1, exit 0" ;
    backlog:verifiedByTool "playwright 1.45" .


#################################################################
#  shapes v1.12.0 planted defects (69-71) — misuse of the tier
#################################################################

# DEFECT 69: a low level declared by nobody, for no reason, going nowhere
ex:N_ProfileSheltered a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "sheltered adoption" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:adoptsFacet backlog:CoreFacet .

# DEFECT 70: a "target" that is the current level, and a review date long past
ex:N_ProfileStandstill a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "standstill encoded as ambition" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasTargetConformanceLevel backlog:L1_Core ;
    backlog:hasLevelReviewDate "2026-01-01T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Starting small." ;
    backlog:adoptsFacet backlog:CoreFacet .

# DEFECT 71: a silent downgrade from a previously claimed higher level
ex:N_ProfileDowngraded a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "quietly lowered" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasPriorConformanceLevel backlog:L3_Governed ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:hasLevelReviewDate "2027-01-01T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Starting small." ;
    backlog:adoptsFacet backlog:CoreFacet .

