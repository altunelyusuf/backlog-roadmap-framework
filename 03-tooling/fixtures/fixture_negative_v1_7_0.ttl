@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/fixture-negative#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Negative fixture: every block below plants ONE defect the suite must
# report at sh:Violation severity. The gate fails if any planted defect
# goes uncaught (L-95: a gate must be proven discriminating, and the
# proof is a fixture it fails, not a claim that it would).

ex:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "Negative fixture" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L3_Governed ;
    # DEFECT 1: claims L3 but adopts neither the Invariant nor the Audit facet
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet .

ex:Backlog a backlog:Backlog ;
    backlog:hasIdentifier "BL-N" ;
    backlog:hasState backlog:InProgress .

# DEFECT 2: container with no members
ex:EmptyPackage a backlog:Package ;
    backlog:hasIdentifier "PKG-EMPTY" ;
    backlog:hasState backlog:Proposed .

# DEFECT 15: container asserted Done while a member is InProgress. This
# defect is only detectable if the R1 derivation rules actually executed,
# so it doubles as the proof that advanced mode is on (L-97: the
# discrimination mandate applies to the verifier's own checks too).
ex:OptimisticPackage a backlog:Package ;
    backlog:hasIdentifier "PKG-OPT" ;
    backlog:hasState backlog:Done .

ex:N011 a backlog:Task ;
    backlog:hasIdentifier "N-011" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer ex:Backlog , ex:OptimisticPackage .

# DEFECT 3: Done asserted with no evidence at all (L2)
ex:N001 a backlog:Story ;
    backlog:hasIdentifier "N-001" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:lastAuditedAt "2026-07-27T09:00:00"^^xsd:dateTime .

# DEFECT 4: Done with evidence that the bridge has not verified (L2)
ex:N002 a backlog:Story ;
    backlog:hasIdentifier "N-002" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasEvidence ex:N002_Test ;
    backlog:lastAuditedAt "2026-07-27T09:00:00"^^xsd:dateTime .

ex:N002_Test a backlog:TestEvidence ;
    backlog:hasTestSpec "e2e/tests/n002.spec.js" ;
    backlog:hasTestId "N002-001" ;
    backlog:evidenceVerified false .

# DEFECT 5: Done at L3 on review evidence alone
ex:N003 a backlog:Story ;
    backlog:hasIdentifier "N-003" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasEvidence ex:N003_Review ;
    backlog:lastAuditedAt "2026-07-27T09:00:00"^^xsd:dateTime .

ex:N003_Review a backlog:ReviewEvidence ;
    backlog:hasReviewer "product owner" ;
    backlog:hasReviewRecordRef "review-log/2026-07-24#item-N003" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-07-24T00:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "sign-off recorded in the review log" .

# DEFECT 6: identifier collision with N-001
ex:N004 a backlog:Task ;
    backlog:hasIdentifier "N-001" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog .

# DEFECT 7: dependency cycle
ex:N005 a backlog:Task ;
    backlog:hasIdentifier "N-005" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:dependsOn ex:N006 .

ex:N006 a backlog:Task ;
    backlog:hasIdentifier "N-006" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:dependsOn ex:N005 .

# DEFECT 8: on the roadmap but absent from any backlog register
ex:N007 a backlog:Feature ;
    backlog:hasIdentifier "N-007" ;
    backlog:hasState backlog:Proposed ;
    backlog:scheduledInHorizon backlog:Now .

# DEFECT 9: cancelled with no rationale
ex:N008 a backlog:Task ;
    backlog:hasIdentifier "N-008" ;
    backlog:hasState backlog:Cancelled ;
    backlog:memberOfContainer ex:Backlog .

# DEFECT 10: two live scores from the same method
ex:N009 a backlog:Task ;
    backlog:hasIdentifier "N-009" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasPriorityScore ex:N009_S1 , ex:N009_S2 .

ex:N009_S1 a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 3.0 .
ex:N009_S2 a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 9.0 .

# DEFECT 11: Definition-of-Done criterion with no executable check
ex:N_DoD a backlog:DefinitionOfDone ;
    rdfs:label "Local Definition of Done"@en ;
    backlog:hasDoDCriterion ex:N_DoD_C1 .

ex:N_DoD_C1 a backlog:DoDCriterion ;
    rdfs:label "Code is clean and well tested"@en .

# DEFECT 12: milestone with no contributing work and no target date
ex:N_MS a backlog:Milestone ;
    backlog:hasIdentifier "MS-N" ;
    backlog:hasTitle "Launch" .

# DEFECT 13: unenforceable invariant that names no tracking item
ex:N_Inv a backlog:CrossCuttingInvariant ;
    rdfs:label "All endpoints rate-limited"@en ;
    backlog:hasCheckQuery "ASK { ?e ex:rateLimited false }" ;
    backlog:hasExpectedResult "false" ;
    backlog:hasInvariantStatus backlog:NotYetEnforceable .

# DEFECT 14: release evidence with a malformed package hash
ex:N010 a backlog:Story ;
    backlog:hasIdentifier "N-010" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasEvidence ex:N010_Rel .

ex:N010_Rel a backlog:ReleaseEvidence ;
    backlog:hasReleaseVersion "0.1.0" ;
    backlog:hasPackageSHA256 "not-a-hash" ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-07-27T09:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "asserted" .

#################################################################
#  v1.1.0 planted defects (16-27)
#################################################################

# DEFECT 16: silent gap — open item, no score, no not-yet-scoreable flag
ex:N012 a backlog:Story ;
    backlog:hasIdentifier "N-012" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog .

# DEFECT 17: not-yet-scoreable flag with no reason
ex:N013 a backlog:Story ;
    backlog:hasIdentifier "N-013" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true .

# DEFECT 18: launch gate with no priority, no owner, no rationale
ex:N_Gate a backlog:Package ;
    backlog:hasIdentifier "PKG-GATE" ;
    backlog:hasState backlog:Proposed ;
    backlog:isLaunchGate true .

ex:N014 a backlog:Task ;
    backlog:hasIdentifier "N-014" ;
    backlog:hasState backlog:Proposed ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "placeholder" ;
    backlog:memberOfContainer ex:Backlog , ex:N_Gate .

# DEFECT 19: non-capability grouping carrying a launch priority
ex:N_Bag a backlog:Package ;
    backlog:hasIdentifier "PKG-BAG" ;
    backlog:hasState backlog:Proposed ;
    backlog:isBusinessCapability false ;
    backlog:hasLaunchPriority 2 .

ex:N015 a backlog:Task ;
    backlog:hasIdentifier "N-015" ;
    backlog:hasState backlog:Proposed ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "placeholder" ;
    backlog:memberOfContainer ex:Backlog , ex:N_Bag ;
    backlog:hasPriorityScore ex:N015_Score .

# DEFECT 20: container score averaged from members, and no rationale
ex:N015_Score a backlog:PriorityScore ;
    backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue 4.0 ;
    backlog:isAveragedFromMembers true .

ex:N_Bag backlog:hasPriorityScore ex:N015_Score .

# DEFECT 21: dependency disclosed in prose but never made an edge
ex:N016 a backlog:Story ;
    backlog:hasIdentifier "N-016" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "placeholder" ;
    backlog:hasDependencyDisclosure ex:N_Disc .

ex:N_Disc a backlog:DependencyDisclosure ;
    backlog:disclosesDependencyOn ex:N012 ;
    backlog:hasDisclosureSource "'this only matters once N-012 exists' — said in review, never modelled." .

# DEFECT 22: superseded document with no forward pointer and no reason
ex:N_Doc a backlog:GovernedDocument ;
    rdfs:label "Old plan"@en ;
    backlog:hasDocumentStatus backlog:Superseded .

# DEFECT 23: report with no timestamp, no register, and missing sections
ex:N_Report a backlog:RoadmapReport ;
    backlog:hasSection backlog:Section_RankedBacklog .

# DEFECT 24: blueprint entity with no coverage and no recorded gap
ex:N_Entity a backlog:DomainEntity ;
    rdfs:label "Invoice"@en .

# DEFECT 25: code-verification claim with no note
ex:N017 a backlog:Task ;
    backlog:hasIdentifier "N-017" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "placeholder" ;
    backlog:verifiedAgainstCode true .

# DEFECT 26: blueprint gap with no reason and no entity
ex:N_Gap a backlog:BlueprintGap ;
    rdfs:label "something is missing"@en .

# DEFECT 27: methodology rule with no motivating incident
ex:N_Rule a backlog:MethodologyRule ;
    rdfs:label "Always do the right thing"@en ;
    backlog:hasRuleLogic "Do the right thing." ;
    backlog:closesDisagreement "Whether to do the right thing." .

# DEFECT 28: next-recommendation with no ranking model named
ex:N018 a backlog:Story ;
    backlog:hasIdentifier "N-018" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "placeholder" ;
    backlog:derivedInReport ex:N_Report .

#################################################################
#  v1.2.0 planted defects (29-36)
#################################################################
@prefix core: <http://example.org/core#> .
@prefix risk: <http://example.org/risk#> .

# DEFECT 29: objective with no metric, baseline, target or goal
ex:N_Obj a backlog:Objective ;
    rdfs:label "Make things better"@en .

# DEFECT 30: goal with no owner decision recorded
ex:N_Goal a backlog:Goal ;
    rdfs:label "Grow"@en .

# DEFECT 31: benefit unowned, unattached, and claimed realized without evidence
ex:N_Benefit a backlog:Benefit ;
    rdfs:label "Everyone will be happier"@en ;
    backlog:benefitRealized true .

# DEFECT 32: scope exclusion with no rationale and no owner
ex:N_Excl a backlog:ScopeExclusion ;
    backlog:excludesConcern "Reporting" .

# DEFECT 33: Ready item with no acceptance criterion and no refinement event
ex:N019 a backlog:Story ;
    backlog:hasIdentifier "N-019" ;
    backlog:hasState backlog:Ready ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:hasPriorityScore ex:N019_Score .
ex:N019_Score a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_RICE ; backlog:hasScoreValue 2.0 .

# DEFECT 34: cost estimate with no basis
ex:N020 a backlog:Task ;
    backlog:hasIdentifier "N-020" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "placeholder" ;
    backlog:hasCostEstimate ex:N_Est ;
    backlog:hasRisk ex:N_Risk .
ex:N_Est a backlog:CostEstimate ;
    backlog:hasEffortEstimate 13.0 .

# DEFECT 35: risk neither mitigated nor accepted
ex:N_Risk a risk:Risk ;
    rdfs:label "The vendor may withdraw the API"@en .

# DEFECT 36: capacity policy whose shares do not sum to 1
ex:N_Policy a backlog:PortfolioPolicy ;
    backlog:policyFor ex:Backlog ;
    backlog:hasAllocation ex:N_Alloc1 , ex:N_Alloc2 .
ex:N_Alloc1 a backlog:CapacityAllocation ;
    backlog:allocatesToCategory backlog:Cat_NewCapability ; backlog:hasTargetShare 0.5 .
ex:N_Alloc2 a backlog:CapacityAllocation ;
    backlog:allocatesToCategory backlog:Cat_Maintenance ; backlog:hasTargetShare 0.2 .

# DEFECT 37: project with no scope, phase, objective or Definition of Done
ex:N_Project a backlog:ImplementationProject ;
    backlog:hasIdentifier "PRJ-N" ;
    backlog:hasState backlog:Proposed .
ex:N021 a backlog:Task ;
    backlog:hasIdentifier "N-021" ; backlog:hasState backlog:Proposed ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "placeholder" ;
    backlog:memberOfContainer ex:Backlog , ex:N_Project .

