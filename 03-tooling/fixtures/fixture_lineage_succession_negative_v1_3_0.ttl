@prefix backlog: <http://example.org/backlog#> .
@prefix fwneg: <http://example.org/fixture-succession-negative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Real, negative proof: each real constraint LineageSuccessionShape/PartialScopeDeclarationShape/
# LineageReactivationShape enforces, deliberately broken once, one real case per rule.

# (Case 1 removed in v1.3.0: a declaration filed on a live lineage is now the required practice.)

# 2. Succession where predecessor and successor are the same lineage.
fwneg:L_SelfSucc a backlog:Lineage ; backlog:lineageOrdinal 2 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:Gap_SelfSucc a backlog:PartialScopeDeclaration ;
    backlog:declaresGapFor fwneg:L_SelfSucc ; backlog:describesUncoveredScope "Real gap." .
fwneg:Succ_SelfSucc a backlog:LineageSuccession ;
    backlog:succeedsLineage fwneg:L_SelfSucc ; backlog:successorLineage fwneg:L_SelfSucc ;
    backlog:resolvesGap fwneg:Gap_SelfSucc ; backlog:successionRationale "Bad: succeeds itself." ;
    backlog:decidedBy backlog:Owner .

# 3. Succession where successor's Mission differs from predecessor's.
fwneg:M_One a backlog:Mission ; backlog:missionFor fwneg:Register .
fwneg:M_Two a backlog:Mission ; backlog:missionFor fwneg:Register .
fwneg:L_Pred3 a backlog:Lineage ; backlog:lineageOrdinal 3 ; backlog:lineageForMission fwneg:M_One ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:L_Succ3 a backlog:Lineage ; backlog:lineageOrdinal 4 ; backlog:lineageForMission fwneg:M_Two ;
    backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:Gap_3 a backlog:PartialScopeDeclaration ;
    backlog:declaresGapFor fwneg:L_Pred3 ; backlog:describesUncoveredScope "Real gap." .
fwneg:Succ_3 a backlog:LineageSuccession ;
    backlog:succeedsLineage fwneg:L_Pred3 ; backlog:successorLineage fwneg:L_Succ3 ;
    backlog:resolvesGap fwneg:Gap_3 ; backlog:successionRationale "Bad: different mission." ;
    backlog:decidedBy backlog:Owner .

# 4. Succession where the gap's own declaresGapFor does not match succeedsLineage.
fwneg:L_Pred4a a backlog:Lineage ; backlog:lineageOrdinal 5 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:L_Pred4b a backlog:Lineage ; backlog:lineageOrdinal 6 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:L_Succ4 a backlog:Lineage ; backlog:lineageOrdinal 7 ;
    backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:Gap_4 a backlog:PartialScopeDeclaration ;
    backlog:declaresGapFor fwneg:L_Pred4b ; backlog:describesUncoveredScope "Filed for a different lineage." .
fwneg:Succ_4 a backlog:LineageSuccession ;
    backlog:succeedsLineage fwneg:L_Pred4a ; backlog:successorLineage fwneg:L_Succ4 ;
    backlog:resolvesGap fwneg:Gap_4 ; backlog:successionRationale "Bad: gap filed for the wrong lineage." ;
    backlog:decidedBy backlog:Owner .

# 5. Succession where the successor's own Objective never resolves the gap structurally.
fwneg:L_Pred5 a backlog:Lineage ; backlog:lineageOrdinal 8 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:L_Succ5 a backlog:Lineage ; backlog:lineageOrdinal 9 ;
    backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:Gap_5 a backlog:PartialScopeDeclaration ;
    backlog:declaresGapFor fwneg:L_Pred5 ; backlog:describesUncoveredScope "Real gap, never picked up." .
fwneg:Succ_5 a backlog:LineageSuccession ;
    backlog:succeedsLineage fwneg:L_Pred5 ; backlog:successorLineage fwneg:L_Succ5 ;
    backlog:resolvesGap fwneg:Gap_5 ; backlog:successionRationale "Bad: no Objective picks this up." ;
    backlog:decidedBy backlog:Owner .
# Note: no Objective anywhere declares resolvesPartialScope fwneg:Gap_5 -- the real violation.
# v1.2.0: the successor has reached its Objective stage (an Objective of its own), so the clause binds.
fwneg:Obj_Succ5_Other a backlog:Objective ; backlog:belongsToLineage fwneg:L_Succ5 .

# 6. Reactivation of a lineage that was never actually closed.
fwneg:L_NeverClosed a backlog:Lineage ; backlog:lineageOrdinal 10 ;
    backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:React_Bad a backlog:LineageReactivation ;
    backlog:reactivatesLineage fwneg:L_NeverClosed ;
    backlog:reactivationRationale "Bad: this lineage was never closed." ;
    backlog:decidedBy backlog:Owner .

# 7. The v1.132.0 exemption stays narrow: an LS_Achieved lineage whose Mission is still in
#    flight, and which NO LineageSuccession names, must still be caught by the original rule.
fwneg:M_Open a backlog:Mission ; backlog:missionFor fwneg:Register ; backlog:hasMissionOutcome backlog:Out_InFlight .
fwneg:L_ClaimsDoneAlone a backlog:Lineage ; backlog:lineageOrdinal 11 ; backlog:lineageForMission fwneg:M_Open ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .

# v1.133.0 tiered-response defects, one per rule (cases 8-15).
fwneg:L_Closed8 a backlog:Lineage ; backlog:lineageOrdinal 12 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false ;
    backlog:observationWindowEnds "2026-12-31T00:00:00Z"^^xsd:dateTime .
fwneg:Ev_Neg a backlog:Evidence ; backlog:evidenceVerified true ; backlog:hasVerificationMethod "Fixture-internal." .
# 8. Reactivation with no typed reason and no finding behind it.
fwneg:React_NoReason a backlog:LineageReactivation ; backlog:reactivatesLineage fwneg:L_Closed8 ;
    backlog:reactivationRationale "Bad: no reason, no evidence." ; backlog:decidedBy backlog:Owner .
# 9. Reactivation resting only on an isolated finding (disproportionate).
fwneg:Find_Isolated a backlog:PostClosureFinding ; backlog:declaresGapFor fwneg:L_Closed8 ;
    backlog:describesUncoveredScope "One typo in one report label." ; backlog:hasFindingScale backlog:Scale_Isolated ;
    backlog:findingRaisedAt "2027-01-05T00:00:00Z"^^xsd:dateTime ; backlog:findingEvidence fwneg:Ev_Neg .
fwneg:React_Isolated a backlog:LineageReactivation ; backlog:reactivatesLineage fwneg:L_Closed8 ;
    backlog:reactivationRationale "Bad: reopening for a typo." ; backlog:hasReactivationReason backlog:Reason_ImproperProcessing ;
    backlog:addressesFinding fwneg:Find_Isolated ; backlog:decidedBy backlog:Owner .
# 10. A finding with no evidence behind it.
fwneg:Find_NoEvidence a backlog:PostClosureFinding ; backlog:declaresGapFor fwneg:L_Closed8 ;
    backlog:describesUncoveredScope "Bad: a suspicion only." ; backlog:hasFindingScale backlog:Scale_Bounded ;
    backlog:findingRaisedAt "2027-01-05T00:00:00Z"^^xsd:dateTime .
# 11. A finding raised against a lineage that is still open.
fwneg:L_StillOpen a backlog:Lineage ; backlog:lineageOrdinal 1 ;
    backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:Find_OnOpen a backlog:PostClosureFinding ; backlog:declaresGapFor fwneg:L_StillOpen ;
    backlog:describesUncoveredScope "Bad: the lineage is still open." ; backlog:hasFindingScale backlog:Scale_Bounded ;
    backlog:findingRaisedAt "2027-01-05T00:00:00Z"^^xsd:dateTime ; backlog:findingEvidence fwneg:Ev_Neg .
# 12. An isolated finding answered by a succession (disproportionate).
fwneg:Find_IsolatedDivided a backlog:PostClosureFinding ; backlog:declaresGapFor fwneg:L_Closed8 ;
    backlog:describesUncoveredScope "One broken link." ; backlog:hasFindingScale backlog:Scale_Isolated ;
    backlog:findingRaisedAt "2027-01-05T00:00:00Z"^^xsd:dateTime ; backlog:findingEvidence fwneg:Ev_Neg .
fwneg:L_Succ12 a backlog:Lineage ; backlog:lineageOrdinal 13 ;
    backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:Succ_12 a backlog:LineageSuccession ; backlog:succeedsLineage fwneg:L_Closed8 ; backlog:successorLineage fwneg:L_Succ12 ;
    backlog:resolvesGap fwneg:Find_IsolatedDivided ; backlog:successionRationale "Bad: dividing for one link." ;
    backlog:decidedBy backlog:Owner .
fwneg:Obj_Succ12 a backlog:Objective ; backlog:belongsToLineage fwneg:L_Succ12 ; backlog:resolvesPartialScope fwneg:Find_IsolatedDivided .
# 13. A systemic finding raised inside the observation window, answered by reactivation.
fwneg:Find_InWindow a backlog:PostClosureFinding ; backlog:declaresGapFor fwneg:L_Closed8 ;
    backlog:describesUncoveredScope "Wide failure found during the window." ; backlog:hasFindingScale backlog:Scale_Systemic ;
    backlog:findingRaisedAt "2026-11-01T00:00:00Z"^^xsd:dateTime ; backlog:findingEvidence fwneg:Ev_Neg .
fwneg:React_InWindow a backlog:LineageReactivation ; backlog:reactivatesLineage fwneg:L_Closed8 ;
    backlog:reactivationRationale "Bad: inside the window." ; backlog:hasReactivationReason backlog:Reason_NonConformantResult ;
    backlog:addressesFinding fwneg:Find_InWindow ; backlog:decidedBy backlog:Owner .
# 14. An isolated finding addressed by a work item not in the Maintenance category.
fwneg:Find_IsolatedNonMaint a backlog:PostClosureFinding ; backlog:declaresGapFor fwneg:L_Closed8 ;
    backlog:describesUncoveredScope "One wrong default." ; backlog:hasFindingScale backlog:Scale_Isolated ;
    backlog:findingRaisedAt "2027-01-05T00:00:00Z"^^xsd:dateTime ; backlog:findingEvidence fwneg:Ev_Neg .
fwneg:Task_Fix14 a backlog:WorkItem ; backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:addressesFinding fwneg:Find_IsolatedNonMaint .
# 15. A lineage revived with no reactivation behind it.
fwneg:L_RevivedBare a backlog:Lineage ; backlog:lineageOrdinal 14 ;
    backlog:hasLineageStatus backlog:LS_Revived ; backlog:lineageArchived false ;
    backlog:lineageRevivedAt "2026-09-24T00:00:00Z"^^xsd:dateTime .

# v1.134.0 carried-item defects.
fwneg:L_Pred16 a backlog:Lineage ; backlog:lineageOrdinal 15 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:L_Succ16 a backlog:Lineage ; backlog:lineageOrdinal 16 ;
    backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:Gap_16 a backlog:PartialScopeDeclaration ; backlog:declaresGapFor fwneg:L_Pred16 ; backlog:describesUncoveredScope "Real gap." .
fwneg:Succ_16 a backlog:LineageSuccession ; backlog:succeedsLineage fwneg:L_Pred16 ; backlog:successorLineage fwneg:L_Succ16 ;
    backlog:resolvesGap fwneg:Gap_16 ; backlog:successionRationale "Real rationale." ; backlog:decidedBy backlog:Owner .
fwneg:Obj_Succ16 a backlog:Objective ; backlog:belongsToLineage fwneg:L_Succ16 ; backlog:resolvesPartialScope fwneg:Gap_16 .
fwneg:Out_Obj16 a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Objective ; backlog:belongsToLineage fwneg:L_Succ16 .
fwneg:Out_BL16 a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Backlog ; backlog:belongsToLineage fwneg:L_Succ16 .
# 16. A predecessor item admitted by the successor's Objective-stage output (not a Backlog output).
fwneg:Item_WrongStage a backlog:WorkItem ; backlog:belongsToLineage fwneg:L_Pred16 ; backlog:hasState backlog:Proposed ;
    backlog:preLineageItem true ; backlog:admittedByOutput fwneg:Out_Obj16 .
# 17. An open predecessor item the successor's closed Backlog stage never carried.
fwneg:Item_Dropped a backlog:WorkItem ; backlog:belongsToLineage fwneg:L_Pred16 ; backlog:hasState backlog:Proposed .
# 18. The achieved-not-archived exemption stays narrow: a succeeded predecessor with NO open item is still reported.
fwneg:L_Pred18 a backlog:Lineage ; backlog:lineageOrdinal 17 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:Succ_18 a backlog:LineageSuccession ; backlog:succeedsLineage fwneg:L_Pred18 ; backlog:successorLineage fwneg:L_Succ16 ;
    backlog:resolvesGap fwneg:Gap_16 ; backlog:successionRationale "Real rationale." ; backlog:decidedBy backlog:Owner .

# v1.135.0 out-scoping and closure defects.
fwneg:L_Closed19 a backlog:Lineage ; backlog:lineageOrdinal 18 ;
    backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
# 19. A lineage recorded Achieved with an open item that was never out-scoped.
fwneg:Item19 a backlog:WorkItem ; backlog:belongsToLineage fwneg:L_Closed19 ; backlog:hasState backlog:InProgress .
# 20. A declaration out-scoping another lineage's work.
fwneg:L_Live20 a backlog:Lineage ; backlog:lineageOrdinal 19 ; backlog:hasLineageStatus backlog:LS_InProgress ; backlog:lineageArchived false .
fwneg:Gap_20 a backlog:PartialScopeDeclaration ; backlog:declaresGapFor fwneg:L_Live20 ; backlog:decidedBy backlog:Owner ;
    backlog:describesUncoveredScope "Bad: out-scopes an item of another lineage." ; backlog:outScopes fwneg:Item19 .
# 21. An out-scoping with no owner decision.
fwneg:Gap_21 a backlog:PartialScopeDeclaration ; backlog:declaresGapFor fwneg:L_Live20 ;
    backlog:describesUncoveredScope "Bad: nobody decided this." .
# 22. Out-scoped open work of a closed lineage that no succession takes.
fwneg:L_Closed22 a backlog:Lineage ; backlog:lineageOrdinal 20 ; backlog:hasLineageStatus backlog:LS_Achieved ; backlog:lineageArchived false .
fwneg:Item22 a backlog:WorkItem ; backlog:belongsToLineage fwneg:L_Closed22 ; backlog:hasState backlog:Proposed .
fwneg:Gap_22 a backlog:PartialScopeDeclaration ; backlog:declaresGapFor fwneg:L_Closed22 ; backlog:decidedBy backlog:Owner ;
    backlog:describesUncoveredScope "Out-scoped, then orphaned." ; backlog:outScopes fwneg:Item22 .
# 23. An open container of a succeeded predecessor, neither admitted nor split, after the successor's backlog closed.
fwneg:Pkg23 a backlog:Package ; backlog:belongsToLineage fwneg:L_Pred16 ; backlog:hasState backlog:Proposed .
# 24. A remainder split into a lineage that is not the original's successor.
fwneg:Pkg24_Orig a backlog:Package ; backlog:belongsToLineage fwneg:L_Pred16 ; backlog:hasState backlog:Done .
fwneg:Pkg24_Rem a backlog:Package ; backlog:belongsToLineage fwneg:L_Live20 ; backlog:hasState backlog:Proposed ; backlog:splitFrom fwneg:Pkg24_Orig .
# 25. A container that belongs to no lineage.
fwneg:Pkg25 a backlog:Package ; backlog:hasState backlog:Proposed ; backlog:memberOfContainer fwneg:Pkg24_Orig .

<http://example.org/fixture-succession-negative#> backlog:hasExpectedPolarity backlog:Polarity_Negative .
