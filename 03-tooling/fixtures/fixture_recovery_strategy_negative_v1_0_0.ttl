ex:B0 a backlog:LineageBypass ; backlog:bypassedLineage ex:L0 ; backlog:hasFailureMode backlog:FM_LineageBypass ; backlog:hasFindingScope backlog:Scope_Methodology ; backlog:hasRootCause "fx" ;
    backlog:bypassedItem ex:S0 ; backlog:itemFirstCommit "S0 c1 1000" ; backlog:chainClosedCommit "absent" ; backlog:detectedAt "2026-09-07T09:00:00Z"^^xsd:dateTime ; backlog:detectedBy "fx" .
ex:S0 a backlog:Story ; backlog:hasIdentifier "S0" ; backlog:hasState backlog:Proposed ; backlog:belongsToLineage ex:L0 ; backlog:preLineageItem true .
