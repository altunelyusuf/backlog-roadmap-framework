# L4_LineageEnforced, conformant.
#
# The whole chain, connected and measured: Mission -> Goal -> Objective (with a
# real observation) -> Scope -> Epic -> Story -> PlanningEvent -> Iteration ->
# DeploymentUnit. No epic in a sprint, no epic deployed, no story reaching
# execution without a planning event, no work outside the declared scope.

@prefix backlog: <http://example.org/backlog#> .
@prefix core:    <http://example.org/core#> .
@prefix ex:      <http://example.org/l4#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

ex:Profile a backlog:AdoptionProfile ;
    backlog:profileAppliesTo "L4 conformant reference register" ;
    backlog:governsBacklog ex:Backlog ;
    backlog:hasConformanceLevel backlog:L4_LineageEnforced ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Owner call: this register must prove a mission was accomplished, not report that work was done, so the lineage is enforced rather than advised." ;
    backlog:adoptsFacet backlog:CoreFacet , backlog:EvidenceFacet , backlog:PrioritizationFacet ,
                        backlog:RoadmapFacet , backlog:InvariantFacet , backlog:AuditFacet .

ex:Backlog a backlog:Backlog ;
    backlog:hasIdentifier "BL-L4" ; backlog:hasTitle "Reference L4 register" ;
    backlog:hasState backlog:InProgress ;
    backlog:appliesDefinitionOfDone backlog:DoD_Baseline ;
    backlog:hasCommitment ex:Commit ;
    backlog:hasScopeStatement ex:Scope .

ex:Commit a backlog:Commitment ; rdfs:label "Delivery commitment"@en ;
    backlog:commitsToGoal ex:Goal .

ex:Mission a backlog:Mission ;
    backlog:hasMissionOrigin backlog:Origin_OwnerStated ;
    backlog:missionSource "Fixture: an illustrative mission stated by the fixture's owner. Recorded because a mission with no origin cannot be told apart from a session's summary of work already done." ; rdfs:label "Mission"@en ;
    backlog:hasMissionStatement "Practitioners recover an account without contacting support." ;
    backlog:missionFor ex:Backlog ; backlog:decidedBy backlog:Owner .

ex:Goal a backlog:Goal ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; rdfs:label "Self-service recovery"@en ;
    backlog:contributesToMission ex:Mission ; backlog:decidedBy backlog:Owner .

ex:Metric a core:Metric ; rdfs:label "Share of recoveries completed without support"@en .

ex:Objective a backlog:Objective ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; rdfs:label "Recoveries need no support contact"@en ;
    backlog:fillsScope ex:Scope ;
    backlog:contributesToGoal ex:Goal ;
    backlog:hasSuccessMetric ex:Metric ;
    backlog:hasBaselineValue 12.0 ; backlog:hasTargetValue 80.0 ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasObjectiveDeadline "2027-01-31T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

# a measurement, not an intention — this is what L4 requires
ex:Obs a backlog:MetricObservation ; rdfs:label "First reading after release 1"@en ;
    backlog:observesMetric ex:Metric ; backlog:observationFor ex:Objective ;
    backlog:hasObservedValue 41.0 ;
    backlog:observedAt "2026-08-09T12:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted support tickets tagged account-recovery against completed recovery flows over the two weeks after release 1." .

ex:Scope a backlog:ScopeStatement ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:scopeForMission ex:Mission ;
    backlog:hasScopeStatementText "Self-service recovery for practitioner accounts: the reset flow and its notifications." ;
    backlog:hasScopeExclusion ex:Excl .
ex:Excl a backlog:ScopeExclusion ;
    backlog:excludesConcern "Recovery for administrator accounts, which carries a different identity check." ;
    backlog:hasExclusionRationale "Different threat model; a separate objective would be needed and none is declared." ;
    backlog:decidedBy backlog:Owner .

# epic: groomed, never in a sprint, never deployed
ex:EP a backlog:Epic ;
    backlog:hasIdentifier "EP-1" ; backlog:hasTitle "Account recovery" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:pursuesObjective ex:Objective ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:decomposesInto ex:US1 , ex:US2 ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at story level; scoring an epic alongside its scored children would double-count." ;
    backlog:hasAcceptanceCriterion ex:AC_EP .
ex:AC_EP a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the recovery stories are delivered, When a practitioner is locked out, Then they regain access end to end without contacting support." .

ex:US1 a backlog:Story ;
    backlog:hasApplicableConcern backlog:Concern_Data , backlog:Concern_Security ;
    backlog:hasIdentifier "US-1" ; backlog:hasTitle "Request a reset link" ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer ex:Backlog , ex:It1 ;
    backlog:pursuesObjective ex:Objective ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "practitioner" ; backlog:wantsCapability "request a reset link" ;
    backlog:soThat "I can get back in without calling the clinic" ;
    backlog:hasAcceptanceCriterion ex:AC1 ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:startedAt "2026-07-28T09:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-04T17:00:00"^^xsd:dateTime ;
    backlog:hasActualEffort 9.0 ;
    backlog:hasEvidence ex:Ev1 ;
    backlog:lastAuditedAt "2026-08-04T17:00:00"^^xsd:dateTime ;
    backlog:hasPriorityScore ex:S1 .
ex:AC1 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a practitioner who has forgotten their password, When they request a reset, Then a single-use link arrives within two minutes and expires after one hour." .
ex:Ev1 a backlog:TestEvidence ;
    backlog:hasTestSpec "e2e/recovery/request-link.spec.js" ; backlog:hasTestId "REC-1" ;
    backlog:evidenceVerified true ; backlog:verifiedAt "2026-08-04T17:00:00"^^xsd:dateTime ;
    backlog:hasVerificationMethod "playwright test --grep REC-1, exit 0, run in CI on the release commit" ;
    backlog:verifiedByTool "playwright 1.45" ;
    backlog:attestsCriterion ex:AC1 ;
    backlog:anchoredToRelease "sha256:8c1f0b2d9a" .
ex:S1 a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 6.0 ;
    backlog:hasUserBusinessValue 8.0 ; backlog:hasTimeCriticality 6.0 ;
    backlog:hasRiskReductionValue 4.0 ; backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-05T09:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Judged .

ex:US2 a backlog:Story ;
    backlog:hasApplicableConcern backlog:Concern_Data ;
    backlog:hasIdentifier "US-2" ; backlog:hasTitle "Set a new password from the link" ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer ex:Backlog , ex:It2 ;
    backlog:pursuesObjective ex:Objective ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "practitioner" ; backlog:wantsCapability "set a new password" ;
    backlog:soThat "I regain access without a support call" ;
    backlog:hasAcceptanceCriterion ex:AC2 ;
    backlog:hasExecutionModality backlog:Mode_Hybrid ;
    backlog:hasSupervisionMode backlog:Sup_OnTheLoop ;
    backlog:startedAt "2026-08-05T09:00:00"^^xsd:dateTime ;
    backlog:hasPriorityScore ex:S2 .
ex:AC2 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a valid unexpired reset link, When the practitioner sets a password meeting the policy, Then the old password stops working and the link cannot be reused." .
ex:H_US1 a backlog:TestHarness ; backlog:harnessFor ex:US1 ;
    backlog:hasHarnessEvidence ex:Ev1 ; backlog:harnessComplete true .

ex:S2 a backlog:WSJFScore ;
    backlog:scoredByMethod backlog:Method_WSJF ; backlog:hasScoreValue 4.0 ;
    backlog:hasUserBusinessValue 7.0 ; backlog:hasTimeCriticality 3.0 ;
    backlog:hasRiskReductionValue 2.0 ; backlog:hasJobSize 3.0 ;
    backlog:scoredAt "2026-08-05T09:00:00"^^xsd:dateTime ;
    backlog:hasBasisKind backlog:Basis_Judged .

# planning: stories into the iteration, broken to tasks
ex:It1 a backlog:Iteration ;
    backlog:hasIdentifier "IT-1" ; backlog:hasTitle "Iteration 1" ;
    backlog:hasState backlog:Done ;
    backlog:iterationStart "2026-07-28T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2026-08-08T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 12.0 .

ex:Plan1 a backlog:PlanningEvent ;
    backlog:plansItem ex:US1 ; backlog:plannedInto ex:It1 ;
    backlog:plannedAt "2026-07-27T10:00:00"^^xsd:dateTime ;
    backlog:plannedBy backlog:Builder ;
    backlog:producesTask ex:T1 , ex:T2 .
ex:It2 a backlog:Iteration ;
    backlog:hasIdentifier "IT-2" ; backlog:hasTitle "Iteration 2" ;
    backlog:hasState backlog:InProgress ;
    backlog:iterationStart "2026-08-09T00:00:00"^^xsd:dateTime ;
    backlog:iterationEnd "2027-01-31T23:59:59"^^xsd:dateTime ;
    backlog:hasCapacity 12.0 .

ex:Plan2 a backlog:PlanningEvent ;
    backlog:plansItem ex:US2 ; backlog:plannedInto ex:It2 ;
    backlog:plannedAt "2026-07-27T10:15:00"^^xsd:dateTime ;
    backlog:plannedBy backlog:Builder ;
    backlog:producesTask ex:T3 .

ex:T1 a backlog:ExecutionTask ;
    backlog:hasTaskType backlog:Task_Implementation ; backlog:hasIdentifier "T-1" ;
    backlog:hasTitle "Issue single-use tokens with expiry" ;
    backlog:hasState backlog:Done ; backlog:memberOfContainer ex:Backlog , ex:It1 ;
    backlog:startedAt "2026-07-28T09:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-03T17:00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev1 ; backlog:lastAuditedAt "2026-08-04T17:00:00"^^xsd:dateTime .
ex:H_T1 a backlog:TestHarness ; backlog:harnessFor ex:T1 ;
    backlog:hasHarnessEvidence ex:Ev1 ; backlog:harnessComplete true .
ex:T2 a backlog:ExecutionTask ;
    backlog:hasTaskType backlog:Task_Implementation ; backlog:hasIdentifier "T-2" ;
    backlog:hasTitle "Send the link through the shared dispatcher" ;
    backlog:hasState backlog:Done ; backlog:memberOfContainer ex:Backlog , ex:It1 ;
    backlog:startedAt "2026-07-30T09:00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-08-04T12:00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev1 ; backlog:lastAuditedAt "2026-08-04T17:00:00"^^xsd:dateTime .
ex:H_T2 a backlog:TestHarness ; backlog:harnessFor ex:T2 ;
    backlog:hasHarnessEvidence ex:Ev1 ; backlog:harnessComplete true .
ex:T3 a backlog:ExecutionTask ;
    backlog:hasTaskType backlog:Task_Implementation ; backlog:hasIdentifier "T-3" ;
    backlog:hasTitle "Enforce the password policy on reset" ;
    backlog:hasState backlog:InProgress ; backlog:memberOfContainer ex:Backlog , ex:It2 .

# deployment: what shipped, from which iteration, carrying which stories
ex:Rel1 a backlog:DeploymentUnit ;
    backlog:hasIdentifier "REL-1" ; backlog:hasTitle "Release 1" ;
    backlog:hasState backlog:Done ;
    backlog:hasDeploymentDate "2026-08-09T08:00:00"^^xsd:dateTime ;
    backlog:deploysFrom ex:It1 ;
    backlog:deploysItem ex:US1 ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasSelectionBasis backlog:Sel_HighestScored .
ex:US1 backlog:memberOfContainer ex:Rel1 .

# the harness: which check proves which criterion, and complete only when all are
ex:H1 a backlog:TestHarness ;
    backlog:harnessFor ex:US1 ;
    backlog:hasHarnessEvidence ex:Ev1 ;
    backlog:harnessComplete true .

#################################################################
#  BRF-EP8 — a story too large for one iteration, SPLIT so each
#  part fits. The remedy the fit messages name, shown working:
#  splitting is decomposesInto, which already reads "a feature
#  into stories" — no new relation was needed.
#################################################################

ex:US_Big a backlog:Story ;
    backlog:hasIdentifier "US-BIG" ;
    backlog:hasTitle "Recover an account by any supported factor" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:pursuesObjective ex:Objective ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "practitioner" ; backlog:wantsCapability "recover by any supported factor" ;
    backlog:soThat "I am not locked out when one factor is unavailable" ;
    backlog:hasAcceptanceCriterion ex:AC_Big ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Split before scoring; scoring a parent alongside its scored children would double-count." ;
    backlog:decomposesInto ex:US_Split1 , ex:US_Split2 .
ex:AC_Big a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a practitioner with more than one registered factor, When one is unavailable, Then recovery completes through another without a support contact." .

ex:US_Split1 a backlog:Story ;
    backlog:hasIdentifier "US-3" ;
    backlog:hasTitle "Recover by email factor" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:pursuesObjective ex:Objective ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "practitioner" ; backlog:wantsCapability "recover by email" ;
    backlog:soThat "I regain access using the factor I always have" ;
    backlog:hasAcceptanceCriterion ex:AC_Split1 ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Not yet refined; scored at the next planning." .
ex:AC_Split1 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a practitioner with a verified email, When they request recovery, Then a single-use link arrives and completes recovery within one iteration's work." .

ex:US_Split2 a backlog:Story ;
    backlog:hasIdentifier "US-4" ;
    backlog:hasTitle "Recover by authenticator factor" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer ex:Backlog ;
    backlog:pursuesObjective ex:Objective ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "practitioner" ; backlog:wantsCapability "recover by authenticator" ;
    backlog:soThat "I regain access when email is unavailable" ;
    backlog:hasAcceptanceCriterion ex:AC_Split2 ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Not yet refined; scored at the next planning." .
ex:AC_Split2 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a practitioner with a registered authenticator, When they request recovery, Then a challenge completes recovery within one iteration's work." .

ex:R_US1_Data a backlog:RefinementEvent ; backlog:refines ex:US1 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Analysed for data; approach agreed." ;
    backlog:refinedBy backlog:Builder .

ex:R_US1_Security a backlog:RefinementEvent ; backlog:refines ex:US1 ;
    backlog:addressesConcern backlog:Concern_Security ;
    backlog:refinedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Analysed for security; approach agreed." ;
    backlog:refinedBy backlog:Builder .

ex:R_US2_Data a backlog:RefinementEvent ; backlog:refines ex:US2 ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:hasRefinementOutcome "Analysed for data; approach agreed." ;
    backlog:refinedBy backlog:Builder .

ex:Goal backlog:derivesFromScope ex:Scope .

ex:Objective backlog:metricMovableBy ex:EP , ex:US1 , ex:US2 .

ex:Del_Scope a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "A practitioner locked out of their account regains access without contacting support." .
ex:Scope backlog:requiresDeliverable ex:Del_Scope .
ex:EP backlog:satisfiesDeliverable ex:Del_Scope .

# A scope requiring ONE deliverable met by ONE item is that work
# restated as intent — SingletonDeliverableShape rejects it. A real
# boundary names more than it has reached: the second deliverable
# here is unsatisfied, which is the normal healthy state.
ex:Del2_Scope a backlog:ScopeDeliverable ;
    backlog:hasDeliverableText "A recovery attempt is auditable after the fact." .
ex:Scope backlog:requiresDeliverable ex:Del2_Scope .

ex:Del_Scope backlog:derivesFromMissionClause "practitioners recover unaided" .

ex:Del2_Scope backlog:derivesFromMissionClause "practitioners recover unaided" .

ex:EP backlog:hasApplicableConcern backlog:Concern_Data .
ex:RG_EP a backlog:RefinementEvent ; backlog:refines ex:EP ;
    backlog:addressesConcern backlog:Concern_Data ;
    backlog:refinedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:hasRefinementOutcome "Groomed at container level: what the theme requires, distinct from how each slice is built." .

ex:Area_Scope a backlog:ScopeArea ;
    backlog:areaLocation "The account recovery service and its identity store." ;
    backlog:areaMeasure "One sign-in flow, one credential store, two supported second factors." .
ex:Scope backlog:coversArea ex:Area_Scope .

ex:Goal backlog:hasGoalFacing backlog:Facing_Mission .

ex:G_Areas_Scope a backlog:Goal ;
    rdfs:label "Every area the scope names is finished"@en ; backlog:contributesToMission ex:Mission ;
    backlog:derivesFromScope ex:Scope ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area_Scope ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .
ex:G_Contain_Scope a backlog:Goal ;
    rdfs:label "No work outside the named areas"@en ; backlog:contributesToMission ex:Mission ;
    backlog:derivesFromScope ex:Scope ; backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ; backlog:decidedBy backlog:Owner .

ex:Met_G_Areas_Scope a core:Metric ; rdfs:label "Every area the scope names is finished"@en .
ex:Obj_G_Areas_Scope a backlog:Objective ; rdfs:label "Every area the scope names is finished"@en ;
    backlog:contributesToGoal ex:G_Areas_Scope ;
    backlog:hasSuccessMetric ex:Met_G_Areas_Scope ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:hasBaselineValue 2.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:hasObjectiveDeadline "2027-06-30T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

ex:Met_G_Contain_Scope a core:Metric ; rdfs:label "No work outside the named areas"@en .
ex:Obj_G_Contain_Scope a backlog:Objective ; rdfs:label "No work outside the named areas"@en ;
    backlog:contributesToGoal ex:G_Contain_Scope ;
    backlog:hasSuccessMetric ex:Met_G_Contain_Scope ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:hasBaselineValue 2.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:hasObjectiveDeadline "2027-06-30T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner .

ex:Obj_G_Areas_Scope backlog:fillsScope ex:Scope .
ex:Obs_Obj_G_Areas_Scope a backlog:MetricObservation ;
    backlog:observesMetric ex:Met_G_Areas_Scope ;
    backlog:observationFor ex:Obj_G_Areas_Scope ;
    backlog:hasObservedValue 2.0 ;
    backlog:observedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Baseline taken when the goal was set." .

ex:Obj_G_Contain_Scope backlog:fillsScope ex:Scope .
ex:Obs_Obj_G_Contain_Scope a backlog:MetricObservation ;
    backlog:observesMetric ex:Met_G_Contain_Scope ;
    backlog:observationFor ex:Obj_G_Contain_Scope ;
    backlog:hasObservedValue 2.0 ;
    backlog:observedAt "2026-08-01T09:00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Baseline taken when the goal was set." .

ex:Del_Scope backlog:hasScopeLayer backlog:Layer_Product .

ex:Del2_Scope backlog:hasScopeLayer backlog:Layer_Product .

ex:Area_Scope backlog:hasScopeLayer backlog:Layer_Work .

ex:Excl backlog:hasScopeLayer backlog:Layer_Work .

ex:Objective backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasCheckpoint ex:CP_Objective .
ex:CP_Objective a backlog:ObjectiveCheckpoint ;
    backlog:checkpointDate "2026-12-01T00:00:00"^^xsd:dateTime ;
    backlog:expectedValue 80.0 .

ex:Obj_G_Areas_Scope backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasCheckpoint ex:CP_Obj_G_Areas_Scope .
ex:CP_Obj_G_Areas_Scope a backlog:ObjectiveCheckpoint ;
    backlog:checkpointDate "2026-12-01T00:00:00"^^xsd:dateTime ;
    backlog:expectedValue 0.0 .

ex:Obj_G_Contain_Scope backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasCheckpoint ex:CP_Obj_G_Contain_Scope .
ex:CP_Obj_G_Contain_Scope a backlog:ObjectiveCheckpoint ;
    backlog:checkpointDate "2026-12-01T00:00:00"^^xsd:dateTime ;
    backlog:expectedValue 0.0 .
