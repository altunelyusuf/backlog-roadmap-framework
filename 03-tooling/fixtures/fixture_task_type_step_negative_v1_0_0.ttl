@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/task-type-step-neg#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# fixture_task_type_step_negative v1.0.0 (shapes v1.146.0; rdodi-ecosystem handover,
# federated-agent-execution-concepts, request 2.2). NEGATIVE. The ordered steps of a task type.
#
#  FIRES    TaskTypeStepOrdinalShape        STEP_NoOrdinal   no position
#  FIRES    TaskTypeStepCheckShape          STEP_NoCheck     no checker named
#  FIRES    TaskTypeStepOrdinalUniqueShape  STEP_DupA        two steps of one task type at position 2 (STEP_DupB too)
#  FIRES    TaskTypeStepOwnedShape          STEP_Orphan      the step of no task type
#  SILENT   (controls, asserted by 03-tooling/backlog_task_type_step_probe)
#           STEP_Good1, STEP_Good2   a complete sequence of two steps under Task_Implementation
#           STEP_OtherType           position 1 under another task type: the same position in a different task type is fine
#  Also carries the tool-run record of an automated step (ToolRunRecord broadened to any automated step): silent.
#  performedByActor has no shape of its own: it is an open reference, so there is nothing for it to fire.
ex:Script_Check a backlog:ToolScript ; backlog:scriptFileName "check.py" ; backlog:acceptsGraphPath true .

backlog:Task_Implementation backlog:hasTaskTypeStep ex:STEP_Good1 , ex:STEP_Good2 ,
    ex:STEP_NoOrdinal , ex:STEP_NoCheck , ex:STEP_DupA , ex:STEP_DupB .
backlog:Task_Verification backlog:hasTaskTypeStep ex:STEP_OtherType .

ex:STEP_Good1 a backlog:TaskTypeStep ; backlog:hasTaskTypeStepOrdinal 1 ; backlog:checkedByToolScript ex:Script_Check .
ex:STEP_Good2 a backlog:TaskTypeStep ; backlog:hasTaskTypeStepOrdinal 2 ; backlog:checkedByToolScript ex:Script_Check .
ex:STEP_NoOrdinal a backlog:TaskTypeStep ; backlog:checkedByToolScript ex:Script_Check .
ex:STEP_NoCheck a backlog:TaskTypeStep ; backlog:hasTaskTypeStepOrdinal 3 .
ex:STEP_DupA a backlog:TaskTypeStep ; backlog:hasTaskTypeStepOrdinal 4 ; backlog:checkedByToolScript ex:Script_Check .
ex:STEP_DupB a backlog:TaskTypeStep ; backlog:hasTaskTypeStepOrdinal 4 ; backlog:checkedByToolScript ex:Script_Check .
ex:STEP_OtherType a backlog:TaskTypeStep ; backlog:hasTaskTypeStepOrdinal 1 ; backlog:checkedByToolScript ex:Script_Check .
ex:STEP_Orphan a backlog:TaskTypeStep ; backlog:hasTaskTypeStepOrdinal 1 ; backlog:checkedByToolScript ex:Script_Check .

ex:Run_Step a backlog:ToolRunRecord ; backlog:ranTool ex:Script_Check ;
    backlog:usedBaselineHash "aaaa" ; backlog:comparedAgainstHash "bbbb" ; backlog:runConcludedDistinctBaseline true .

<http://example.org/task-type-step-neg#> backlog:hasExpectedPolarity backlog:Polarity_Negative .
