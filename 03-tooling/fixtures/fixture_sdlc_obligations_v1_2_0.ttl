ex:BL backlog:appliesDefinitionOfDone ex:DoD_PL ; backlog:hasCommitment ex:Commit_PL .
ex:Commit_PL a backlog:Commitment ; backlog:commitsToGoal ex:G .

ex:Out_Mission a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Mission ;
    backlog:hasStateDigest "8c65af94ac3276071bb9b029a4ab139a14fd9eb7729433ca282ef040a706dac1" ; backlog:closedAtCommit "fixture-only-1" .
ex:Out_Scope a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Scope ;
    backlog:hasStateDigest "ed4cf292cc4e1b1ae3ed0565eb70000538772db0bf15bc7aadbb098baccc0f64" ; backlog:consumesOutput ex:Out_Mission ; backlog:closedAtCommit "fixture-only-2" .
ex:Out_Goal a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Goal ;
    backlog:hasStateDigest "3f8c4ef5ba7b3e2d41f0e83e3cdc2df7245edc5c7f4a91afc3f72dd71685eb76" ; backlog:consumesOutput ex:Out_Scope ; backlog:closedAtCommit "fixture-only-3" .
ex:Out_Objective a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Objective ;
    backlog:hasStateDigest "708196fe4b6f59f34a9be5b756cdf2e9b2cae02618dc7014b01ad36bd84f0631" ; backlog:consumesOutput ex:Out_Goal ; backlog:closedAtCommit "fixture-only-4" .
ex:Out_Backlog a backlog:StageOutput ; backlog:outputOfStage backlog:Stage_Backlog ;
    backlog:hasStateDigest "38640a7cf7a6bbd2c5b3495329e9f8da3db2acc9409a23638dc5e83317c34358" ; backlog:consumesOutput ex:Out_Objective ; backlog:closedAtCommit "fixture-only-5" .

ex:D1 backlog:derivesFromMissionClause "practitioners recover unaided" .

ex:D2 backlog:derivesFromMissionClause "practitioners recover unaided" .


# Conformance-goal pattern (G42/AdoptionConformanceGoalShape), self-contained,
# using this package's own already-proven Goal_BRSFConformance/Obj_BRSFConformanceHeld
# structure as the exact template rather than re-deriving requirements by trial.
ex:CMission a backlog:Mission ;
    backlog:hasMissionStatement "Fixture conformance-goal test mission." ;
    backlog:missionFor ex:BL ; backlog:hasMissionOrigin backlog:IOrigin_OwnerStated ;
    backlog:hasMissionOutcome backlog:Out_InFlight ; backlog:decidedBy backlog:Owner .
ex:CDel a backlog:ScopeDeliverable ; backlog:hasDeliverableText "Fixture deliverable." ;
    backlog:derivesFromMissionClause "Fixture conformance-goal test mission." ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CScope a backlog:ScopeStatement ;
    backlog:hasScopeStatementText "Fixture conformance-goal test scope." ;
    backlog:scopeForMission ex:CMission ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:requiresDeliverable ex:CDel ; backlog:hasScopeExclusion ex:CExcl ;
    backlog:coversArea ex:CArea .
ex:CExcl a backlog:ScopeExclusion ; backlog:excludesConcern "Fixture-only exclusion." ;
    backlog:hasExclusionRationale "Fixture-only, not a real design decision." ; backlog:decidedBy backlog:Owner ;
    backlog:hasScopeLayer backlog:Layer_Product .
ex:CArea a backlog:ScopeArea ; backlog:areaLocation "Fixture-only area, no real location." ;
    backlog:areaMeasure "0 real measure; fixture-only." ; backlog:hasScopeLayer backlog:Layer_Product .
ex:CGoal a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture conformance goal" ;
    backlog:isConformanceGoal true ; backlog:contributesToMission ex:CMission ;
    backlog:derivesFromScope ex:CScope ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCoversArea ex:CArea ; backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:decidedBy backlog:Owner .
ex:CGoalScope a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture scope-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Scope ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CGoalContain a backlog:Goal ; <http://www.w3.org/2000/01/rdf-schema#label> "Fixture containment-facing goal" ;
    backlog:contributesToMission ex:CMission ; backlog:derivesFromScope ex:CScope ;
    backlog:hasGoalFacing backlog:Facing_Containment ; backlog:goalCoversArea ex:CArea ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CObjScope a backlog:Objective ; backlog:contributesToGoal ex:CGoalScope ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricScope ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricScope a ex:CLocalMetric .
ex:CObjContain a backlog:Objective ; backlog:contributesToGoal ex:CGoalContain ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetricContain ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetricContain a ex:CLocalMetric .
ex:CCPScope a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjScope backlog:hasCheckpoint ex:CCPScope .
ex:CObsScope a backlog:MetricObservation ; backlog:observesMetric ex:CMetricScope ; backlog:observationFor ex:CObjScope ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CCPContain a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObjContain backlog:hasCheckpoint ex:CCPContain .
ex:CObsContain a backlog:MetricObservation ; backlog:observesMetric ex:CMetricContain ; backlog:observationFor ex:CObjContain ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .
ex:CObj a backlog:Objective ;
    backlog:contributesToGoal ex:CGoal ; backlog:fillsScope ex:CScope ;
    backlog:hasSuccessMetric ex:CMetric ; backlog:hasBaselineValue 0.0 ; backlog:hasTargetValue 0.0 ;
    backlog:hasTargetDirection backlog:Dir_Hold ; backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
ex:CMetric a ex:CLocalMetric .
ex:CCP a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-12-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
ex:CObj backlog:hasCheckpoint ex:CCP .
ex:CObs a backlog:MetricObservation ; backlog:observesMetric ex:CMetric ; backlog:observationFor ex:CObj ;
    backlog:hasObservedValue 0.0 ; backlog:observedAt "2026-09-02T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    backlog:hasObservationMethod "Fixture-stated value, not re-derivable." .

# Blueprint (G45/domain-modeling handover): register-level completeness plus
# the epic's own domain-entity coverage, swept across all 4 lifecycle stages
# (1 real coverage from the epic itself, 3 gaps -- matching the framework's
# own real usage in fixture_positive_v1_7_0, not invented for this fixture).
ex:CBP a backlog:Blueprint ; backlog:blueprintFor ex:BL .
ex:CEntity a backlog:DomainEntity .
ex:EP backlog:coversEntity ex:CEntity ; backlog:coversStage backlog:Stage_ActiveUse .
ex:CGap1 a backlog:BlueprintGap ; backlog:gapForEntity ex:CEntity ; backlog:gapForStage backlog:Stage_Creation ;
    backlog:hasGapReason "Fixture-only: creation stage not modeled." .
ex:CGap2 a backlog:BlueprintGap ; backlog:gapForEntity ex:CEntity ; backlog:gapForStage backlog:Stage_SuspensionException ;
    backlog:hasGapReason "Fixture-only: suspension/exception stage not modeled." .
ex:CGap3 a backlog:BlueprintGap ; backlog:gapForEntity ex:CEntity ; backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "Fixture-only: termination stage not modeled." .

# ---------------------------------------------------------------------------
# fixture_pipeline_v1_1_0.ttl (2026-09-07) -- brought back to conformance with shapes shipped after
# this fixture was last edited: the RegisterSession requirement (v1.169.0, G48).
# This fixture declares Polarity_Positive and was failing on exactly these
# constraints; the gate could not run at the time (validator pinned to a retired
# file), so nothing reported it. A known-good fixture that fails certifies
# nothing (G7). Dates are timezone-less on purpose: shapes v1.100.1 compares
# lexically, so a legal zone-less xsd:dateTime no longer reads as "passed".
# ---------------------------------------------------------------------------
ex:Session_20260907 a backlog:RegisterSession ;
    rdfs:label "Conformance-restoration session, 7 September"@en ;
    backlog:sessionFor ex:BL ;
    backlog:sessionStartedAt "2026-09-07T07:00:00"^^xsd:dateTime ;
    backlog:sessionEndedAt "2026-09-07T07:30:00"^^xsd:dateTime ;
    backlog:stateVerifiedAtStart true ;
    backlog:sessionConductedBy backlog:Builder ;
    backlog:hasSessionScopeNote "In scope: record this fixture's own maintenance so the register names who last changed it. Deliberately untouched: every item, objective and event above." .

# v1.1.0 (2026-09-07) -- stage digests RE-RECORDED, and why that is honest here and
# would not be in a real register. At v1.157.0 a second Mission/Scope/Goal/Objective
# block (the conformance-goal template) was appended to this fixture to satisfy
# AdoptionConformanceGoalShape; those subjects carry stage types, so every stage
# digest recorded for the original single-lineage graph stopped reproducing -- the
# verifier reporting exactly what it exists to report ("elements were added to a
# closed stage"). The gate could not run at the time and nothing noticed for 43
# releases. This fixture is a synthetic register whose purpose is to make the
# verifier PASS on a known-good graph (Experiment A, G18); recomputing its digests
# from its own current content re-runs that experiment on the graph as it now is.
# The same operation on a real register would fabricate a closure that never
# happened (L-112) and is NOT done there: the real register's own five Out2_*
# digests do not reproduce either, for the same structural reason (the digest is
# register-wide, and the register now holds eight lineages), and are left as the
# historical record they are, disclosed in the v1.201.0 changelog.
# v1.2.0 (2026-09-09): lineage status stated (TBox v1.89.0, LineageStatusShape); derived from the fixture's own outputs and item states.
ex:Lin_PL backlog:hasLineageStatus backlog:LS_Backlogged .

#################################################################
#  fixture_sdlc_obligations v1.0.0 -- POSITIVE (2026-09-09). The
#  conformant pipeline lineage, now PRODUCING what each stage owes
#  under the standing obligations (backlog_abox v1.4.0):
#    Scope     -> DomainEntity + Blueprint      (already present: D1, D2 are deliverables; E_PL, BP_PL added)
#    Goal      -> Specification with a step, and TestScenarios of the nominal and rejection kinds
#    Objective -> ModelArtifact of Kind_ActivityDiagram and of Kind_SequenceDiagram
#    Backlog   -> ModelArtifact of Kind_ClassDiagram, and an AcceptanceCriterion
#  Every artifact belongsToLineage Lin_PL, so StageOutputOwesShape finds it.
#  Expected: 0 violations, no waiver advisory.
#################################################################
ex:E_PL a backlog:DomainEntity ; rdfs:label "Recovery plan"@en ; backlog:belongsToLineage ex:Lin_PL .
ex:EP backlog:coversEntity ex:E_PL ; backlog:coversStage backlog:Stage_ActiveUse .
ex:GapE1 a backlog:BlueprintGap ; backlog:gapForEntity ex:E_PL ; backlog:gapForStage backlog:Stage_Creation ; backlog:hasGapReason "Creation is out of this fixture's scope." ; backlog:belongsToLineage ex:Lin_PL .
ex:GapE2 a backlog:BlueprintGap ; backlog:gapForEntity ex:E_PL ; backlog:gapForStage backlog:Stage_SuspensionException ; backlog:hasGapReason "No suspension path in this fixture." ; backlog:belongsToLineage ex:Lin_PL .
ex:GapE3 a backlog:BlueprintGap ; backlog:gapForEntity ex:E_PL ; backlog:gapForStage backlog:Stage_Termination ; backlog:hasGapReason "No termination path in this fixture." ; backlog:belongsToLineage ex:Lin_PL .
ex:BP_PL a backlog:Blueprint ; backlog:blueprintFor ex:BL ; backlog:belongsToLineage ex:Lin_PL .
ex:Spec_PL a backlog:Specification ; backlog:hasInteractionStep ex:Step_PL ; backlog:belongsToLineage ex:Lin_PL .
ex:Step_PL a backlog:InteractionStep ; backlog:hasStepActor backlog:Builder ; backlog:hasStepOrdinal 1 ; backlog:hasStepAction "The practitioner opens the recovery plan and marks the day complete." .
ex:AC_PL a backlog:AcceptanceCriterion ; backlog:hasGherkinText "Given a recovery plan with an incomplete day, when the practitioner marks that day complete, then the plan advances to the next day." ; backlog:belongsToLineage ex:Lin_PL .
ex:Scen_PL_Nom a backlog:TestScenario ; backlog:scenarioOf ex:AC_PL ; backlog:scenarioKind backlog:Scen_Nominal ; backlog:belongsToLineage ex:Lin_PL .
ex:Scen_PL_Rej a backlog:TestScenario ; backlog:scenarioOf ex:AC_PL ; backlog:scenarioKind backlog:Scen_Rejection ; backlog:belongsToLineage ex:Lin_PL .
ex:MA_PL_Act a backlog:ModelArtifact ; backlog:hasModelKind backlog:Kind_ActivityDiagram ; backlog:describesItem ex:S_PL ; backlog:belongsToLineage ex:Lin_PL .
ex:MA_PL_Seq a backlog:ModelArtifact ; backlog:hasModelKind backlog:Kind_SequenceDiagram ; backlog:describesItem ex:S_PL ; backlog:belongsToLineage ex:Lin_PL .
ex:MA_PL_Cls a backlog:ModelArtifact ; backlog:hasModelKind backlog:Kind_ClassDiagram ; backlog:describesItem ex:S_PL ; backlog:belongsToLineage ex:Lin_PL .
ex:BP_PL backlog:hasDomainEntity ex:E_PL .

ex:Lin_PL backlog:adoptsObligationSet backlog:OS_SDLC_v1 ; backlog:adoptionRecordedAtOpen true .
<http://example.org/sdlc-obligations#> backlog:hasExpectedPolarity backlog:Polarity_Positive .
# v1.1.0 (2026-09-10): status corrected LS_InProgress -> LS_Opened, derived from this fixture's own stage
# outputs and item states. The claim was unsupported by the data it sits in; InProgressNeedsStartedWorkShape
# and LineageStatusShape now refuse such a claim.

# v(next) 2026-09-10: the stage outputs were never linked to the lineage they close, so no rule
# could tell which chain they belong to and the status could not be checked against them. Linked here.
ex:Out_Mission backlog:belongsToLineage ex:Lin_PL .
ex:Out_Scope backlog:belongsToLineage ex:Lin_PL .
ex:Out_Goal backlog:belongsToLineage ex:Lin_PL .
ex:Out_Objective backlog:belongsToLineage ex:Lin_PL .
ex:Out_Backlog backlog:belongsToLineage ex:Lin_PL .
